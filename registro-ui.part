/* ===== Registro unificado (1.28.0, P1) =====
   La bitácora única del sistema: conexiones, acciones y fallos
   en lenguaje llano, en orden cronológico, con filtro por RFC y
   por clase y exportación CSV. Es una proyección de solo lectura
   del servidor (los diarios de los cuatro motores, los accesos,
   la actividad, los correos y las acciones del administrador):
   aquí no se escribe nada. Cada fallo trae su motivo y, cuando
   el motor guardó la página del momento, el botón para verla —
   la misma evidencia de los diarios, sin cazarla pantalla a
   pantalla. Vive en una parte diferida: Hoy solo paga una línea. */
/* F9 (1.31.0): el filtro de la pantalla persiste en este
   navegador y se restaura al entrar, como el de Avisos. */
let registroFiltro = (() => {
  try {
    const guardado = JSON.parse(localStorage.getItem('pacosat-filtros-registro') || 'null');
    if (guardado && typeof guardado === 'object')
      return { rfc: String(guardado.rfc || ''), clase: String(guardado.clase || '') };
  } catch { /* Sin almacenamiento local, el filtro dura la sesión. */ }
  return { rfc: '', clase: '' };
})();
function registroGuardarFiltro1310() {
  try { localStorage.setItem('pacosat-filtros-registro', JSON.stringify(registroFiltro)); }
  catch { /* Sin almacenamiento local, el filtro dura la sesión. */ }
}
const REGISTRO_CLASE = { conexion: ['ok', 'Conexión'], accion: ['dim', 'Acción'], fallo: ['bad', 'Fallo'] };
/* Búsqueda de texto (2.0.1 · nº 17; 2.3.0 · pieza 8): el texto
   VIAJA al servidor (texto= en GET /api/registro) y busca en
   TODO el historial, no solo en las 300 entradas cargadas;
   se combina con los filtros de RFC y de clase, que también
   viajan. La tecla espera su debounce (300 ms) antes de
   pedir: teclear no lanza una petición por letra. */
let registroTexto201 = '';
let registroTextoTimer230 = null;
/* Compartir el Registro (1.32.1, A3 — petición de Paco del
   14 nov): copiar lo visible como texto limpio y poder
   limpiarlo sin miedo, con Deshacer. */
let registroUltimoLote = null;
const REGISTRO_ORIGEN = { paco: 'Paco', sistema: 'Sistema', ejecutor: 'Tu equipo' };
function registroLineaTexto(item) {
  const fecha = typeof fmtFechaHora === 'function' ? fmtFechaHora(item.at)
    : localDateTime(item.at);
  return fecha + ' · ' + (REGISTRO_ORIGEN[item.origen] || 'Sistema') + ' · ' + item.texto +
    (item.rfc ? ' · ' + item.rfc : '');
}
async function registroCopiarTexto(texto, mensaje) {
  try {
    if (navigator.clipboard?.writeText) await navigator.clipboard.writeText(texto);
    else {
      const area = document.createElement('textarea');
      area.value = texto; area.style.position = 'fixed'; area.style.opacity = '0';
      document.body.append(area); area.select();
      document.execCommand('copy'); area.remove();
    }
    toast(mensaje, 'ok');
  } catch { toast('No se pudo copiar: el navegador no lo permitió.', 'error'); }
}
function registroScreen() {
  const wrap = n('div');
  if (typeof satToken === 'undefined' || !satToken) {
    wrap.append(panel('Registro', 'El Registro vive en el servidor de tu casa (el NAS): abre PacoSAT desde el servidor para ver qué hizo el sistema, qué intentó y qué no pudo.'));
    return [wrap];
  }
  const head = panel('Registro',
    'Todo lo que el sistema hizo, intentó y no pudo, en una sola lista y en lenguaje llano: conexiones con el SAT, acciones (tuyas y automáticas) y fallos con su motivo. Cuando un motor guardó la página del momento del fallo, el botón «Ver la página del fallo» la abre.');
  const body = n('div');
  head.append(body);
  wrap.append(head);
  let pintarSeq230 = 0;
  const pintar = async () => {
    const seq = ++pintarSeq230;
    body.replaceChildren(n('p', 'Leyendo el registro…', 'muted'));
    let data = null;
    try {
      data = await satApi('registro?limit=300' +
        (registroFiltro.rfc ? '&rfc=' + encodeURIComponent(registroFiltro.rfc) : '') +
        (registroFiltro.clase ? '&clase=' + encodeURIComponent(registroFiltro.clase) : '') +
        (registroTexto201 ? '&texto=' + encodeURIComponent(registroTexto201) : ''));
    } catch (error) { if (seq === pintarSeq230) body.replaceChildren(n('p', error.message, 'error-text')); return; }
    if (!body.isConnected || seq !== pintarSeq230) return;
    body.replaceChildren();
    const filtros = n('div', undefined, 'actions');
    const selRfc = select([['', 'Todos los contribuyentes'], ...people.map(person => [person.id, person.id])],
      registroFiltro.rfc, 'Contribuyente');
    selRfc.onchange = () => { registroFiltro.rfc = selRfc.value; registroGuardarFiltro1310(); pintar(); };
    const selClase = select([['', 'Todo: conexiones, acciones y fallos'], ['conexion', 'Solo conexiones'],
      ['accion', 'Solo acciones'], ['fallo', 'Solo fallos']], registroFiltro.clase, 'Clase');
    selClase.onchange = () => { registroFiltro.clase = selClase.value; registroGuardarFiltro1310(); pintar(); };
    const buscarTexto = input('search', { value: registroTexto201, placeholder: 'Buscar en el texto del registro…' });
    buscarTexto.setAttribute('aria-label', 'Buscar en el Registro');
    buscarTexto.oninput = () => {
      registroTexto201 = buscarTexto.value.trim().toLocaleLowerCase('es-MX');
      /* Debounce de 300 ms (pieza 8): la búsqueda va al
         servidor y teclear no paga una petición por letra.
         Al repintar, el foco vuelve al buscador para seguir
         tecleando sin perder el hilo. */
      clearTimeout(registroTextoTimer230);
      registroTextoTimer230 = setTimeout(() => {
        pintar().then(() => {
          const el = body.querySelector('input[type="search"]');
          if (el) { el.focus(); el.setSelectionRange(el.value.length, el.value.length); }
        });
      }, 300);
    };
    filtros.append(buscarTexto);
    /* Imprimir lo visible (2.0.1 · nº 2): con los filtros en
       curso, en Carta con membrete, como las demás listas. */
    if (typeof imprimirVista201 === 'function') {
      const imprimirBtn = n('button', 'Imprimir', 'soft');
      imprimirBtn.type = 'button';
      imprimirBtn.onclick = () => {
        /* Lo devuelto YA viene filtrado por el servidor
           (RFC, clase y texto): imprimir usa eso mismo. */
        const visiblesImp = data.items;
        imprimirVista201('Registro', 'Lo visible con los filtros en curso: ' + number.format(visiblesImp.length) + ' suceso(s).',
          ['Fecha', 'Clase', 'Suceso', 'RFC'],
          visiblesImp.map(item => [fmtFechaHora(item.at), REGISTRO_CLASE[item.clase]?.[1] || 'Acción', item.texto, item.rfc || '']));
      };
      filtros.append(imprimirBtn);
    }
    /* Sin botón de CSV aquí: la exportación es la acción
       principal de la pantalla (arriba a la derecha), como en
       el resto — el mismo gesto no se pinta dos veces. */
    const copiarTodo = n('button', 'Copiar todo', 'soft');
    copiarTodo.type = 'button';
    copiarTodo.onclick = () => registroCopiarTexto(data.items.map(registroLineaTexto).join('\n'),
      'Registro copiado: ' + data.items.length + ' entrada(s) con el filtro en curso.');
    const borrarVisible = n('button', 'Borrar lo visible', 'soft');
    borrarVisible.type = 'button';
    borrarVisible.onclick = async () => {
      const claves = data.items.map(item => item.clave).filter(Boolean);
      if (!claves.length) { toast('Lo visible no trae claves que borrar.', 'error'); return; }
      if (!confirm('¿Ocultar las ' + claves.length + ' entradas visibles del Registro? No se toca ningún diario de origen y se puede deshacer.')) return;
      borrarVisible.disabled = true;
      try {
        const hecho = await satApi('registro/borrar', { claves });
        registroUltimoLote = { lote: hecho.lote, cuantas: hecho.ocultadas };
        toast('Ocultadas ' + hecho.ocultadas + ' entrada(s). Tienes «Deshacer» arriba del Registro.', 'ok');
        pintar();
      } catch (error) { toast(error.message, 'error'); borrarVisible.disabled = false; }
    };
    filtros.append(copiarTodo, borrarVisible);
    body.append(filtros);
    if (registroUltimoLote) {
      const tira = n('div', undefined, 'cp-row registro-deshacer');
      tira.append(n('span', 'Ocultaste ' + registroUltimoLote.cuantas + ' entrada(s) del Registro en el último borrado.'));
      const deshacer = n('button', 'Deshacer', 'primary');
      deshacer.type = 'button';
      deshacer.onclick = async () => {
        deshacer.disabled = true;
        try {
          const hecho = await satApi('registro/deshacer', { lote: registroUltimoLote.lote });
          registroUltimoLote = null;
          toast('Borrado deshecho: ' + hecho.restauradas + ' entrada(s) de vuelta.', 'ok');
          pintar();
        } catch (error) { toast(error.message, 'error'); deshacer.disabled = false; }
      };
      tira.append(deshacer);
      body.append(tira);
    }
    body.append(n('p', number.format(data.total) + ' suceso(s)' +
      (registroFiltro.rfc ? ' de ' + registroFiltro.rfc : '') +
      (registroFiltro.clase ? ' · ' + (REGISTRO_CLASE[registroFiltro.clase]?.[1] || registroFiltro.clase) : '') +
      (registroTexto201 ? ' · con el texto «' + registroTexto201 + '» en todo el historial' : '') +
      ' · lo más reciente primero.', 'muted'));
    /* La búsqueda ya la hizo el servidor sobre todo el
       historial (pieza 8): lo que llegó ES lo visible. */
    const itemsVisibles201 = data.items;
    if (!itemsVisibles201.length) {
      body.append(empty('Sin sucesos con ese filtro', 'Cambia el contribuyente, la clase o el texto buscado: el registro completo sigue estando, solo está filtrado.'));
      return;
    }
    /* Gramática visual del Registro (1.29.0, peldaño 1):
       línea de tiempo POR DÍA, la fecha en el formato humano
       único de la casa y el fallo con su traza abrible DENTRO
       de la fila — pasos, error literal y la página guardada
       del momento, para corregir desde el propio log. */
    const list = n('div', undefined, 'activity-list reg-timeline');
    let diaActual = '';
    for (const item of itemsVisibles201) {
      const dia = new Date(item.at).toLocaleDateString('es-MX',
        { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' });
      if (dia !== diaActual) {
        diaActual = dia;
        list.append(n('h3', dia, 'reg-dia'));
      }
      const [nivel, etiqueta] = REGISTRO_CLASE[item.clase] || ['dim', 'Acción'];
      const row = n('div', undefined, 'activity-item' + (item.clase === 'fallo' ? ' reg-fallo' : ''));
      const linea = n('div', undefined, 'reg-linea');
      linea.append(statusPill(nivel, etiqueta),
        n('span', typeof fmtFechaHora === 'function' ? fmtFechaHora(item.at) : '', 'sat-step-time'),
        n('span', item.texto +
          (item.rfc ? ' · ' + item.rfc : '') +
          (item.origen === 'paco' ? ' · lo lanzaste tú' : item.origen === 'sistema' ? ' · lo hizo el sistema solo' : '')));
      if (item.evidencia && (item.evidencia.hasShot || item.evidencia.hasHtml ||
          item.detalle?.hasDecisionShot || item.detalle?.hasDecisionHtml)) {
        const evidencia = evidenceButtons(item.evidencia.motor,
          { id: item.evidencia.runId, hasShot: item.evidencia.hasShot, hasHtml: item.evidencia.hasHtml,
            hasDecisionShot: Boolean(item.detalle?.hasDecisionShot),
            hasDecisionHtml: Boolean(item.detalle?.hasDecisionHtml) });
        if (evidencia) linea.append(evidencia);
      }
      row.append(linea);
      if (item.detalle && ((item.detalle.steps || []).length || item.detalle.error)) {
        const det = item.detalle;
        const details = n('details', undefined, 'reg-detalle');
        details.append(n('summary', 'Ver la traza completa del intento'));
        const caja = n('div', undefined, 'reg-traza');
        for (const step of det.steps || [])
          caja.append(n('p', (typeof fmtFechaHora === 'function' ? fmtFechaHora(step.at) : '') + ' · ' +
            (step.paso || '') + (step.detalle ? ' — ' + step.detalle : ''), 'reg-step'));
        if (det.error) caja.append(n('p', 'Error literal: ' + det.error +
          (det.errorKind ? ' (clase: ' + det.errorKind + ')' : ''), 'error-text'));
        if ((det.attempts || 0) > 1) caja.append(n('p', 'Intentos de esta corrida: ' + det.attempts, 'muted'));
        const copiarTraza = n('button', 'Copiar la traza', 'soft');
        copiarTraza.type = 'button';
        copiarTraza.onclick = () => {
          const lineas = [registroLineaTexto(item), ...(det.steps || []).map(step =>
            '  ' + (typeof fmtFechaHora === 'function' ? fmtFechaHora(step.at) : '') + ' · ' +
            (step.paso || '') + (step.detalle ? ' — ' + step.detalle : ''))];
          if (det.error) lineas.push('  Error literal: ' + det.error + (det.errorKind ? ' (clase: ' + det.errorKind + ')' : ''));
          registroCopiarTexto(lineas.join('\n'), 'Traza copiada.');
        };
        caja.append(copiarTraza);
        details.append(caja);
        row.append(details);
      }
      list.append(row);
    }
    body.append(list);
  };
  pintar();
  return [wrap];
}
/* Exportar el CSV con el filtro en curso (la acción principal de
   la pantalla y su botón en los filtros llaman aquí). */
async function downloadRegistroCsv() {
  try {
    const params = [registroFiltro.rfc ? 'rfc=' + encodeURIComponent(registroFiltro.rfc) : '',
      registroFiltro.clase ? 'clase=' + encodeURIComponent(registroFiltro.clase) : '',
      registroTexto201 ? 'texto=' + encodeURIComponent(registroTexto201) : ''].filter(Boolean).join('&');
    download(await satApiBlob('registro/csv' + (params ? '?' + params : '')), 'registro-pacosat.csv');
    toast('Registro exportado en CSV.', 'ok');
  } catch (error) { toast(error.message, 'error'); }
}
