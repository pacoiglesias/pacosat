    ? (meses[mesIni - 1] || parsed.periodo.mesIni) + ' ' + parsed.periodo.ejercicio
    : 'De ' + (meses[mesIni - 1] || parsed.periodo.mesIni) + ' a ' + (meses[mesFin - 1] || parsed.periodo.mesFin) + ' de ' + parsed.periodo.ejercicio;
