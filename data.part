  const uuidMatch = /\b[0-9A-F]{8}(?:\s*-\s*[0-9A-F]{4}){3}\s*-\s*[0-9A-F]{12}\b/i.exec(texto);
  if (uuidMatch) campos.uuid = uuidMatch[0].replace(/\s/g, '').toUpperCase();
