let satToken = document.querySelector('meta[name="pacosat-token"]')?.content ||
  sessionStorage.getItem('pacosat-guest-token') || undefined;
const guestMode = Boolean(document.querySelector('meta[name="pacosat-guest"]')) ||
  Boolean(sessionStorage.getItem('pacosat-guest-token'));
let satData = { profiles: [], jobs: [], inbox: [], mail: {} };
let satError = '', satPolling = false, cloudRevision;
const satStatus = { pending: 'En espera del SAT', finished: 'Paquetes recibidos', expired: 'Vencida', failed: 'Falló', rejected: 'Rechazada' };
const directions = { received: 'Recibidos', issued: 'Emitidos', both: 'Emitidos y recibidos' };
const criteriaNotes = { disponible: 'Criterio sin usar', ultima: 'Criterio ya usado · no se repite', agotado: 'Criterio quemado ante el SAT (5002)', rescatado: 'Criterio rescatado por el portal' };

/* Errores del servidor en lenguaje claro (UX-20): cada mensaje críptico
   conocido se traduce a qué pasó y qué hacer. Los que ya vienen claros
   (la mayoría desde la 1.6.7) pasan tal cual. */
const FRIENDLY_ERRORS = [
  [/sesión local inválida/i, 'El servicio se reinició y la sesión caducó: pulsa «Actualizar estado» o recarga la página para reconectar.'],
  [/^host inválido/i, 'El servicio rechazó la dirección de acceso: entra por la dirección oficial de PacoSAT en tu NAS.'],
  [/^solicitud inválida/i, 'La solicitud no es válida tal como se envió: revisa el RFC y el periodo e inténtalo de nuevo.'],
  [/^cfdi de otro rfc/i, 'Ese CFDI es de otro RFC: cambia el contribuyente seleccionado o registra ese RFC en tu cartera.'],
  [/almacenamiento todavía no está disponible/i, 'El almacenamiento aún se está preparando: espera unos segundos y reintenta; si persiste, cierra las demás pestañas de PacoSAT.'],
  /* §6 (1.11.0): «perfil de PacoSAT» es lenguaje del sistema; en la
     superficie se dice qué falta y cómo se resuelve. */
  [/no es un perfil de PacoSAT|no tiene perfil en PacoSAT/i, 'Primero autoriza la e.firma de este RFC para que PacoSAT pueda trabajar con el SAT.']
];
function friendlyError(message) {
  for (const [pattern, text] of FRIENDLY_ERRORS) if (pattern.test(message)) return text;
  return message;
}
async function satApi(route, data) {
  const headers = { 'X-PacoSAT-Token': satToken };
  if (data !== undefined) headers['Content-Type'] = 'application/json';
  const response = await fetch('/api/' + route, {
    method: data === undefined ? 'GET' : 'POST', headers,
    body: data === undefined ? undefined : JSON.stringify(data)
  });
  if (!response.ok) {
    const failed = await response.json().catch(() => ({}));
    const error = new Error(friendlyError(failed.error || 'El servicio local no respondió.'));
    error.guard = failed.guard || null;
    throw error;
  }
  return response.headers.get('Content-Type') === 'application/zip' ? response.blob() : response.json();
}
/* satApiBlob(): como satApi(), pero la respuesta es siempre un Blob
   (el ZIP del paquete de defensa de Cumplimiento), sin pasar por el
   desvío JSON de satApi ni depender de su Content-Type exacto. Se
   llamaba desde la 1.6.18 y nunca se definió (hotfix 1.7.3). El error
   se traduce igual que en satApi(). */
async function satApiBlob(route, data) {
  const headers = { 'X-PacoSAT-Token': satToken };
  if (data !== undefined) headers['Content-Type'] = 'application/json';
  const response = await fetch('/api/' + route, {
    method: data === undefined ? 'GET' : 'POST', headers,
    body: data === undefined ? undefined : JSON.stringify(data)
  });
  if (!response.ok) {
    const failed = await response.json().catch(() => ({}));
    const error = new Error(friendlyError(failed.error || 'El servicio local no respondió.'));
    error.guard = failed.guard || null;
    throw error;
  }
  return response.blob();
}

function localDateTime(value) {
  if (!value) return 'Al activar';
  return new Intl.DateTimeFormat('es-MX', { dateStyle: 'short', timeStyle: 'short' }).format(value);
}
function selectPerson() {
  check(people.length, 'Agrega un contribuyente antes de configurar el SAT.');
  return select(people.map(person => [person.id, person.name + ' · ' + person.id]), scope || people[0].id);
}
/* Interruptor general de descanso (1.6.10, compartido en 1.6.11): la
   misma pieza vive en el Centro SAT y en la pantalla «Hoy en PacoSAT».
   Un toque para descansar o reactivar; la fecha se pide solo si se
   elige «Descansar hasta…». */
function restSwitch() {
  const wrap = n('div', undefined, 'rest-switch');
  const active = Boolean(satData.rest?.active);
  const label = n('span', undefined, 'rest-label');
  label.append(n('strong', active ? '🌙 Descansando' : '🟢 Vigilando'),
    n('small', active ? 'Sin envíos al SAT ni avisos' + (satData.rest.until && satData.rest.until < Date.UTC(2099, 0, 1) ? ' hasta ' + localDateTime(satData.rest.until) : ' (sin fecha: se reactiva con este interruptor)') :
      'Descarga y avisos automáticos activos'));
  const toggle = n('button', active ? 'Reactivar' : 'Descansar', 'rest-toggle');
  toggle.type = 'button';
  toggle.setAttribute('aria-pressed', String(active));
  toggle.onclick = async () => {
    if (active) {
      satData = await satApi('rest', { until: 0 });
      announce('Descanso general terminado. PacoSAT se pone al día con la ventana pendiente.');
    } else {
      /* Un toque, sin formularios: descanso sin fecha (se reactiva con
         el mismo interruptor). La fecha se elige con «Descansar hasta…». */
      satData = await satApi('rest', { until: Date.UTC(2100, 0, 1) });
      announce('PacoSAT entra en descanso general: sin descargas ni avisos hasta que lo reactives.');
    }
    render();
  };
  wrap.append(label, toggle);
  if (!active) wrap.append(action('Descansar hasta…', restDialog, undefined, 'bell'));
  return wrap;
}
/* Pantalla de descarga de la pestaña SAT (1.11.0): SOLO la descarga.
   Devuelve [guía «Sincronización directa», contenedor #sat-live] y
   fillSat() pinta dentro perfiles/solicitudes y la cola de trabajos
   (más el historial de peticiones, plegado como detalle técnico).
   Las constancias/opinión (satDocsSection) y las declaraciones
   (declaracionesSection) ya NO se pintan aquí: viven en Documentos y
   la cáscara las compone allí. El correo y el silencio tampoco: son
   satMailSection(), en Ajustes › Correo. */
function satDownloadScreen() {
  const guide = n('section', undefined, 'guide');
  const info = n('div');
  info.append(n('h2', 'Sincronización directa con el SAT'),
    n('p', 'Autoriza la e.firma por RFC. PacoSAT solicita CFDI, descarga los paquetes y los incorpora al expediente. El servicio puede seguir abierto aunque cierres la pestaña.'));
  const controls = n('div', undefined, 'actions');
  controls.append(action('Configurar RFC', () => unlockDialog(), 'primary', 'lock'),
    action('Autorizar e.firma', () => efirmaDialog(), undefined, 'key'),
    action('Solicitar un periodo', requestDialog, undefined, 'sync'));
  guide.append(info, controls);
  const restBar = n('div', undefined, 'panel-head');
  restBar.append(cell('Modo descanso general', 'Un toque apaga todas las descargas y los avisos; al reanudar, PacoSAT se pone al día solo.'), restSwitch());
  guide.append(restBar);
  const container = n('div'); container.id = 'sat-live';
  fillSat(container);
  return [guide, container];
}
/* Nombre anterior de la misma pantalla: se conserva como alias de
   transición hasta que la cáscara (ui.part) termine de apuntar a
   satDownloadScreen(); no añade comportamiento. */
function fillSat(target = $('sat-live')) {
  if (!target) return;
  const schedules = panel('Revisión automática por RFC');
  if (satError) schedules.append(empty('No se pudo leer el estado', satError, action('Actualizar', pollSat)));
  else {
    const profiles = satData.profiles.filter(row => !scope || row.rfc === scope);
    if (!profiles.length) schedules.append(empty('Sin RFC configurados', 'Primero autoriza la e.firma de este RFC para que PacoSAT pueda trabajar con el SAT.', action('Autorizar e.firma', () => efirmaDialog(), 'primary', 'key')));
    else schedules.append(grid(['RFC', 'Frecuencia', 'Próxima revisión', 'Estado', 'Acción'], profiles.map(row => {
      const restingProfile = Boolean(row.paused) || (row.pauseUntil || 0) > Date.now();
      const buttons = n('div', undefined, 'actions');
      if (row.unlocked) buttons.append(action('Bloquear', async () => { satData = await satApi('lock', { rfc: row.rfc }); fillSat(); }));
      else buttons.append(action('Desbloquear', () => unlockDialog(row.rfc)));
      if (restingProfile) buttons.append(action('Reanudar', async () => {
        satData = await satApi('pause', { rfc: row.rfc, paused: false });
        fillSat(); announce(row.rfc + ' vuelve a vigilar; se pondrá al día con la ventana pendiente.');
      }, 'primary'));
      else buttons.append(action('Descansar', async () => {
        satData = await satApi('pause', { rfc: row.rfc, paused: true });
        fillSat(); announce(row.rfc + ' entra en descanso: sin descargas ni avisos.');
      }), action('Hasta…', () => pauseUntilDialog(row)));
      if (row.unlocked && !restingProfile) buttons.append(action('Descargar ahora', async () => {
        /* UX-06: fuerza el ciclo de este RFC al momento (el servidor
           aplica los mismos frenos: descanso o bloqueo lo impiden).
           Sin conexión (1.7.0) queda en cola como intención 5002. */
        const data = await requestRunNow(row.rfc);
        if (data) {
          satData = data;
          fillSat(); announce('Revisión inmediata de ' + row.rfc + ' ejecutada: solicitudes programadas y paquetes al día.');
          soundCue('success');
        }
      }, undefined, 'sync'));
      return [
        cell(row.rfc, row.error || (row.unlocked ? 'Activo · ' + directions[row.direction] : 'Primero autoriza la e.firma de este RFC para que PacoSAT pueda trabajar con el SAT.') +
          (row.efirmaStored ? ' · Guardada en el servidor' : '')),
        (row.minutes / 60) + ' h · últimos ' + row.days + ' días',
        row.unlocked ? localDateTime(row.nextRun) : 'En pausa',
        restingProfile ? cell('Descansando', row.pauseUntil ? 'Hasta ' + localDateTime(row.pauseUntil) : 'Hasta que lo reanudes') : cell('Vigilando', 'Descargas y avisos activos'),
        buttons
      ];
    })));
  }
  const queue = panel('Solicitudes recientes');
  const jobs = satData.jobs.filter(row => !scope || row.rfc === scope);
  if (jobs.length) queue.append(grid(['RFC', 'Periodo', 'Estado', 'Acción'], jobs.map(row => [
    cell(row.rfc, directions[row.direction] + (row.kind === 'metadata' ? ' · Metadatos' : '')), dateLabel(row.periodStart) + ' – ' + dateLabel(row.periodEnd),
    cell(satStatus[row.status] || row.status, [row.error || (row.status === 'pending' ? 'Próxima consulta ' + localDateTime(row.due) : ''),
      criteriaNotes[row.criteriaState] || ''].filter(Boolean).join(' · ')),
    row.status === 'pending' ? action('Reintentar consulta', async () => { satData = await satApi('retry', { id: row.id }); fillSat(); announce('Consulta programada para el siguiente ciclo del servicio.'); }) : n('span', 'Creada ' + localDateTime(row.created))
  ])));
  else queue.append(empty('Todavía no hay solicitudes', 'Al activar un RFC, PacoSAT iniciará la revisión en segundo plano.'));
  /* Detalle técnico plegado (1.11.0): el historial de peticiones sale
     de la vista diaria; vive cerrado dentro de la descarga y solo se
     abre si se quiere ver la maquinaria. El correo y el silencio ya
     no se pintan aquí: son satMailSection(), en Ajustes › Correo. */
  target.replaceChildren(schedules, queue, satCriteriaBookDetails());
}
/* Historial de peticiones al SAT: el registro persistente de cada
   petición enviada, por RFC, con su resultado. Es la fuente de verdad
   de la guardia, del planificador y del rescate — y por eso es
   detalle técnico: un <details> cerrado al entrar (patrón
   seal-details de la app), no un panel más de la pila diaria. */
function satCriteriaBookDetails() {
  const details = n('details', undefined, 'seal-details sat-criteria-book');
  details.append(n('summary', 'Historial de peticiones al SAT'));
  details.append(n('p', 'Cada petición que PacoSAT hace al SAT queda registrada para no repetirla nunca: el SAT castiga las peticiones repetidas. Si una petición se agota, PacoSAT busca otra vía solo.'));
  const entries = (satData.criteriaBook || []).filter(row => !scope || row.rfc === scope);
  if (!entries.length) details.append(empty('Sin peticiones todavía', 'Cuando se envíe la primera solicitud al SAT, quedará registrada aquí.'));
  else details.append(grid(['RFC', 'Criterio', 'Envíos', 'Estado', 'Acción'], entries.slice(0, 60).map(entry => {
    const acts = n('div', undefined, 'actions');
    if (entry.state === 'agotado' || entry.state === 'rescatado')
      acts.append(action(entry.state === 'agotado' ? 'Preparar rescate' : 'Ver rescate', () => rescueDialog(entry)));
    if (entry.state !== 'disponible')
      acts.append(action('Pedir con cierre +1 s', () => requestDialog({ rfc: entry.rfc, direction: entry.direction,
        start: entry.startAt.slice(0, 10), end: entry.endAt.slice(0, 10), type: entry.type, shiftEnd: true })));
    return [cell(entry.rfc, (entry.type === 'metadata' ? 'Metadatos' : 'CFDI') + ' · ' + directions[entry.direction]),
      stampLabel(entry.startAt) + ' → ' + stampLabel(entry.endAt),
      entry.sends.length ? entry.sends.length + ' · ' + (entry.presumed ? 'presunto enviado' : localDateTime(entry.lastSentAt)) : 'Sin envíos propios',
      cell(criteriaNotes[entry.state] || entry.state, entry.state === 'rescatado' ? 'Entraron ' + entry.rescuedCount + ' CFDI por la carpeta vigilada' :
        entry.state === 'agotado' ? 'Solo se quemó esta combinación exacta' : ''),
      acts];
  })));
  return details;
}
/* ===== Correo y aviso de silencio (1.11.0) =====
   Salen de la pantalla de descarga: son configuración, no trabajo
   diario. satMailSection() devuelve UN nodo —un div#sat-mail-live
   con los dos paneles ya rellenos desde satData— para que Ajustes ›
   Correo lo incruste tal cual en su lista de paneles.
   fillSatMail() repinta ese nodo tras cada cambio (los diálogos de
   SMTP y de umbral la llaman al guardar, y pollSat la refresca si el
   nodo está en pantalla). Estado y explicación van separados
   (píldora + texto), nunca fundidos en una sola etiqueta. */
function satMailSection() {
  const container = n('div'); container.id = 'sat-mail-live';
  fillSatMail(container);
  return container;
}
function fillSatMail(target = $('sat-mail-live')) {
  if (!target) return;
  target.replaceChildren(satMailPanel(), satSilencePanel());
}
function satMailPanel() {
  const alerts = panel('Avisos por correo');
  const bar = n('div', undefined, 'panel-head');
  const notice = n('div');
  notice.append(satData.mail.enabled ? statusPill('ok', 'Activado') : statusPill('dim', 'Desactivado'),
    n('p', 'Te avisa por correo cuando llega un CFDI recibido nuevo. El correo lleva el conteo, sin adjuntar los XML.' +
      (satData.mail.enabled && satData.mail.recipient ? ' Correo de avisos: ' + satData.mail.recipient + '.' : '')));
  if (satData.mail.error) notice.append(n('p', satData.mail.error, 'error-text'));
  const buttons = n('div', undefined, 'actions');
  buttons.append(action('Configurar SMTP', mailDialog, undefined, 'lock'));
  if (satData.mail.enabled) {
    buttons.append(action('Enviar correo de prueba', async () => {
      /* UX-09: la primera prueba del SMTP no debe ser un aviso real. */
      await satApi('mail/test', {});
      announce('Correo de prueba enviado a ' + satData.mail.recipient + '. Revisa tu bandeja: si llegó, los avisos funcionarán.');
      soundCue('success');
    }, undefined, 'bell'));
    buttons.append(action('Desactivar', async () => { satData = await satApi('mail', { enabled: false }); fillSatMail(); }));
  }
  bar.append(notice, buttons); alerts.append(bar);
  return alerts;
}
function satSilencePanel() {
  const silence = panel('Aviso de silencio');
  const bar = n('div', undefined, 'panel-head');
  const notice = n('div');
  notice.append(satData.silenceDays ? statusPill('ok', 'Activado') : statusPill('dim', 'Desactivado'),
    n('p', satData.silenceDays ?
      'Te avisa por correo cuando llega una factura esperada y no llega: si un RFC lleva ' + satData.silenceDays + ' días sin CFDI recibidos nuevos, PacoSAT avisa una vez por episodio. Tú defines el umbral.' :
      'Te avisa por correo cuando llega una factura esperada y no llega. Define el umbral de días para activarlo.'));
  const buttons = n('div', undefined, 'actions');
  buttons.append(action('Cambiar umbral', silenceDialog, undefined, 'bell'));
  bar.append(notice, buttons); silence.append(bar);
  return silence;
}
function silenceDialog() {
  const days = input('number', { min: 0, max: 365, value: satData.silenceDays || 0, required: true });
  dialog('Aviso de silencio', [
    n('p', 'Si un RFC pasa más días que el umbral sin recibir CFDI nuevos, PacoSAT avisa por correo una vez por episodio. Con 0 queda desactivado.'),
    field('Días sin CFDI nuevos para avisar', days)], async () => {
    satData = await satApi('silence', { days: Number(days.value) });
    fillSatMail(); announce(Number(days.value) ? 'Aviso de silencio activo: ' + days.value + ' días.' : 'Aviso de silencio desactivado.');
  });
}
function restDialog() {
  const until = input('date', { required: true, min: new Intl.DateTimeFormat('en-CA', { timeZone: 'America/Mexico_City' }).format() });
  dialog('Descanso general de PacoSAT', [
    n('p', 'Mientras dure el descanso no se envía ninguna solicitud al SAT (la disciplina 5002 queda intacta) y no se genera ningún aviso. La carpeta vigilada y los respaldos siguen trabajando. Al llegar la fecha, la vigilancia se reanuda sola y se pone al día con la ventana pendiente.'),
    field('Descansar hasta el', until)], async () => {
    const ms = new Date(until.value + 'T08:00:00-06:00').getTime();
    satData = await satApi('rest', { until: ms });
    fillSat(); announce('PacoSAT entra en descanso hasta el ' + until.value + '.');
  });
}
function pauseUntilDialog(row) {
  const until = input('date', { required: true, min: new Intl.DateTimeFormat('en-CA', { timeZone: 'America/Mexico_City' }).format() });
  dialog('Descanso de ' + row.rfc, [
    n('p', 'Este RFC deja de descargar y de generar avisos hasta la fecha indicada; entonces se reanuda solo y se pone al día con la ventana pendiente.'),
    field('Descansando hasta el', until)], async () => {
    const ms = new Date(until.value + 'T08:00:00-06:00').getTime();
    satData = await satApi('pause', { rfc: row.rfc, until: ms });
    fillSat(); announce(row.rfc + ' descansa hasta el ' + until.value + '.');
  });
}
function unlockDialog(rfc) {
  const person = selectPerson();
  if (rfc && people.some(row => row.id === rfc)) person.value = rfc;
  const defaults = satData.profiles.find(row => row.rfc === person.value);
  const interval = select([['60','Cada hora'],['120','Cada 2 horas'],['240','Cada 4 horas'],['360','Cada 6 horas'],['720','Cada 12 horas'],['1440','Cada día']], String(defaults?.minutes || 240));
  const days = input('number', { min: 1, max: 31, value: defaults?.days || 7, required: true });
  const direction = select(Object.entries(directions), defaults?.direction || 'received');
  const certificate = input('file', { required: true, accept: '.cer' });
  const key = input('file', { required: true, accept: '.key' });
  const password = input('password', { required: true, maxLength: 256, autocomplete: 'off' });
  dialog('Autorizar sincronización', [
    n('p', 'Autorización solo para esta sesión del servicio: al reiniciar habrá que autorizar de nuevo. Para que la e.firma quede guardada y se reactive sola, usa «Subir e.firma».'),
    field('Contribuyente', person), field('Qué revisar', direction), field('Frecuencia', interval), field('Días de búsqueda', days),
    field('Certificado .cer', certificate), field('Llave privada .key', key), field('Contraseña de la e.firma', password)
  ], async () => {
    const fileData = async file => {
      check(file && file.size <= 32 * KB, 'Selecciona un archivo de e.firma válido.');
      return encode64(bytes(await file.arrayBuffer()));
    };
    satData = await satApi('unlock', { rfc: person.value, minutes: Number(interval.value), days: Number(days.value),
      direction: direction.value, certificate: await fileData(certificate.files[0]), key: await fileData(key.files[0]), password: password.value });
    password.value = '';
    fillSat(); announce('Sincronización autorizada para ' + person.value + '.');
  }, 'Autorizar');
}
function efirmaDialog(prefillRfc) {
  const person = selectPerson();
  if (prefillRfc && people.some(row => row.id === prefillRfc)) person.value = prefillRfc;
  const defaults = (satData.profiles || []).find(row => row.rfc === person.value) || {};
  const interval = select([['60','Cada hora'],['120','Cada 2 horas'],['240','Cada 4 horas'],['360','Cada 6 horas'],['720','Cada 12 horas'],['1440','Cada día']], String(defaults.minutes || 360));
  const days = input('number', { min: 1, max: 31, value: defaults.days || 7, required: true });
  const direction = select(Object.entries(directions), defaults.direction || 'received');
  const certificate = input('file', { required: true, accept: '.cer' });
  const key = input('file', { required: true, accept: '.key' });
  const password = input('password', { required: true, maxLength: 256, autocomplete: 'off' });
  /* «Probar y guardar» (1.6.12): el servidor comprueba TODO antes de
     guardar — que el certificado sea de este RFC, que no esté caducado
     y que la llave y la contraseña cuadren — y la e.firma queda en la
     carpeta protegida del servidor, activa también tras reiniciar.
     Si algo no cuadra, no se guarda nada y lo anterior no se toca. */
  dialog('Subir e.firma al servidor', [
    n('p', 'La e.firma se guarda solo en la carpeta protegida del servidor: nunca entra en la base de datos ni en los respaldos. Antes de guardar se comprueba que el certificado sea de este RFC, que esté vigente y que la llave y la contraseña cuadren; si algo falla, no se guarda nada.'),
    field('Contribuyente', person), field('Qué revisar', direction), field('Frecuencia', interval), field('Días de búsqueda', days),
    field('Certificado .cer', certificate), field('Llave privada .key', key), field('Contraseña de la e.firma', password)
  ], async () => {
    const fileData = async file => {
      check(file && file.size <= 32 * KB, 'Selecciona un archivo de e.firma válido.');
      return encode64(bytes(await file.arrayBuffer()));
    };
    satData = await satApi('efirma', { rfc: person.value, minutes: Number(interval.value), days: Number(days.value),
      direction: direction.value, certificate: await fileData(certificate.files[0]), key: await fileData(key.files[0]), password: password.value });
    password.value = '';
    fillSat();
    const profile = satData.profiles.find(row => row.rfc === person.value);
    announce('e.firma guardada y activa para ' + person.value +
      (profile?.certExpires ? '. Vigente hasta el ' + localDateTime(profile.certExpires) : '') + '. Se reactivará sola tras cada reinicio.');
    soundCue('success');
  }, 'Probar y guardar');
}
function guardChoice(guard) {
  return new Promise(resolve => {
    const box = n('div');
    const titles = { agotado: 'Criterio quemado ante el SAT (5002)', rescatado: 'Periodo ya rescatado por el portal',
      ultima: 'Este criterio ya se pidió: no se repite' };
    box.append(n('h3', titles[guard.state] || titles.ultima),
      n('p', guard.message),
      /* Fechas siempre en formato humano (UX-25): nada de ISO crudo. */
      n('p', 'Ventana del criterio: ' + stampLabel(guard.startAt) + ' a ' + stampLabel(guard.endAt) +
        '. Cerrando el periodo 1 segundo más tarde (' + stampLabel(guard.shiftedEndAt) + ') el criterio es nuevo ' +
        'ante el SAT y en la práctica no entra ningún CFDI extra.'));
    if (guard.state === 'agotado') box.append(n('p',
      'Lo quemado es solo esta combinación exacta (RFC, sentido, tipo y fechas con segundos): ni el RFC ni la ' +
      'e.firma están quemados. También puedes recuperar el periodo a mano desde el portal del SAT: es un canal ' +
      'aparte (hasta 2.000 XML al día) y PacoSAT prepara la lista exacta de folios. Y si solo necesitas ' +
      'reconciliar el histórico, el mismo periodo como Metadatos es otro criterio, con su propio cupo.'));
    if (guard.state === 'rescatado') box.append(n('p',
      'Los XML de este periodo ya entraron por la carpeta vigilada tras descargarlos del portal: están en el expediente.'));
    const row = n('div', undefined, 'actions');
    row.append(action('Cerrar 1 segundo más tarde y enviar', () => resolve('shift'), 'primary', 'sync'));
    if (guard.state === 'agotado' || guard.state === 'rescatado')
      row.append(action(guard.state === 'agotado' ? 'Preparar el rescate por el portal' : 'Ver el rescate', () => resolve('rescue')));
    row.append(action('No enviar', () => resolve('cancel')));
    box.append(row);
    $('fields').replaceChildren(box);
  });
}
/* Rescate 5002 asistido: el servidor prepara la lista exacta de folios
   pendientes del periodo quemado (de los metadatos guardados, sin los
   ya descargados) y las instrucciones paso a paso para bajarlos del
   portal del SAT. Al dejarlos en la carpeta vigilada, el criterio pasa
   a «rescatado» en el libro. Sin botón de guardado: es una guía. */
async function rescueDialog(source) {
  const plan = await satApi('rescue', { rfc: source.rfc, direction: source.direction, startAt: source.startAt, endAt: source.endAt });
  const box = n('div');
  box.append(n('p', 'Periodo quemado: ' + stampLabel(plan.startAt) + ' a ' + stampLabel(plan.endAt) + ' · ' +
      (plan.direction === 'received' ? 'Recibidos' : 'Emitidos') + ' · ' + plan.rfc),
    n('p', plan.folios.length ? 'Según los metadatos guardados faltan ' + plan.folios.length + ' folios por ' +
      'descargar: son los de esta lista (los que ya están en el expediente no aparecen).' :
      'Todavía no hay metadatos guardados de este periodo: descarga por el periodo completo y deja que la ' +
      'carpeta vigilada descarte sola los duplicados.'));
  if (plan.folios.length) {
    const list = n('ul', undefined, 'rescue-folios');
    for (const folio of plan.folios.slice(0, 200)) list.append(n('li',
      folio.uuid + ' · ' + (folio.issuedAt || '').slice(0, 19) + ' · ' + folio.emitter + ' → ' + folio.receiver +
      ' · ' + (folio.total ? '$' + folio.total : '—')));
    box.append(list);
    if (plan.folios.length > 200) box.append(n('p', '…y ' + (plan.folios.length - 200) + ' folios más en el mismo periodo.'));
  }
  const steps = n('ol', undefined, 'rescue-steps');
  for (const step of plan.instructions) steps.append(n('li', step));
  box.append(steps);
  dialog('Rescate por el portal del SAT', [box]);
}
function requestDialog(preset) {
  const person = selectPerson();
  const today = new Intl.DateTimeFormat('en-CA', { timeZone: 'America/Mexico_City', year: 'numeric', month: '2-digit', day: '2-digit' }).format();
  const start = input('date', { max: today, value: today.slice(0, 8) + '01', required: true });
  const end = input('date', { max: today, value: today, required: true });
  const direction = select([['received', 'Recibidos'], ['issued', 'Emitidos']], 'received');
  /* Preselección (UX-05): desde un hueco de Cobertura el diálogo nace
     con el RFC, el sentido y los extremos exactos del hueco. */
  if (preset) {
    if (preset.rfc) person.value = preset.rfc;
    if (preset.direction) direction.value = preset.direction;
    if (preset.start) start.value = preset.start;
    if (preset.end) end.value = preset.end;
  }
  const type = select([['cfdi', 'CFDI (XML completos)'], ['metadata', 'Metadatos (registros ligeros, para reconciliar)']], 'cfdi');
  if (preset?.type) type.value = preset.type;
  /* Periodos frecuentes en un clic (1.6.10): sin teclear fechas. */
  const quick = n('div', undefined, 'actions');
  const fmt = date => date.toISOString().slice(0, 10);
  const setRange = (from, to) => { start.value = fmt(from); end.value = fmt(to); refreshPlan(); };
  const nowDate = new Date(today + 'T12:00:00');
  quick.append(
    action('Mes pasado', () => setRange(new Date(nowDate.getFullYear(), nowDate.getMonth() - 1, 1), new Date(nowDate.getFullYear(), nowDate.getMonth(), 0))),
    action('Este trimestre', () => setRange(new Date(nowDate.getFullYear(), Math.floor(nowDate.getMonth() / 3) * 3, 1), nowDate)),
    action('Este año', () => setRange(new Date(nowDate.getFullYear(), 0, 1), nowDate)),
    action('Últimos 30 días', () => setRange(new Date(nowDate.getTime() - 29 * 86400000), nowDate)));
  /* Planificador anti-5002: antes de gastar una solicitud, el servidor
     cruza el criterio exacto contra el libro y avisa aquí mismo. Si ya
     se pidió, la vía es la variante de cierre +1 s (nunca el duplicado);
     si el rango CFDI es amplio y nuevo, propone explorar primero con
     Metadatos. Es una lectura: no envía nada por sí solo. */
  const planNote = n('p', 'Revisando el criterio en el libro…', 'plan-note');
  const metaFirst = action('Pedir este rango como Metadatos', () => { type.value = 'metadata'; refreshPlan(); });
  metaFirst.hidden = true;
  const planBox = n('div', undefined, 'plan-box');
  planBox.append(planNote, metaFirst);
  let planSeq = 0;
  async function refreshPlan() {
    const seq = ++planSeq;
    try {
      const plan = await satApi('plan', { rfc: person.value, direction: direction.value, type: type.value, start: start.value, end: end.value });
      if (seq !== planSeq) return;
      planNote.textContent = plan.reason;
      metaFirst.hidden = plan.recommendation !== 'metadata-first';
    } catch {
      if (seq !== planSeq) return;
      planNote.textContent = 'El planificador no pudo revisar el libro; la guardia actuará al enviar, como siempre.';
      metaFirst.hidden = true;
    }
  }
  for (const control of [person, direction, type, start, end]) control.addEventListener('change', refreshPlan);
  refreshPlan();
  dialog('Solicitar un periodo al SAT', [field('Contribuyente', person), field('Comprobantes', direction),
    field('Tipo de solicitud', type), field('Planificador 5002', planBox), field('Periodo frecuente', quick),
    field('Fecha inicial', start), field('Fecha final', end)], async () => {
    const payload = { rfc: person.value, direction: direction.value, start: start.value, end: end.value, type: type.value };
    /* Desde el Libro, «Pedir con cierre +1 s» nace ya con la variante. */
    if (preset?.shiftEnd) payload.shiftEnd = 1;
    for (;;) {
      try { satData = await satApi('request', payload); break; }
      catch (error) {
        if (!error.guard) throw error;
        const choice = await guardChoice(error.guard);
        if (choice === 'cancel') {
          $('dialog').close();
          announce('Solicitud no enviada. ' + error.guard.message, true);
          return;
        }
        if (choice === 'rescue') {
          $('dialog').close();
          rescueDialog(error.guard);
          return;
        }
        /* Cada vuelta suma un segundo al cierre: si esa variante
           también estaba usada, la siguiente guardia ofrece el
           segundo siguiente. Nunca se repite un criterio. */
        payload.shiftEnd = (payload.shiftEnd || 0) + 1;
      }
    }
    fillSat(); announce('Solicitud enviada. PacoSAT revisará cuándo libera el paquete el SAT.');
  }, 'Enviar solicitud');
}
function mailDialog() {
  const recipient = input('email', { required: true, value: satData.mail.recipient || '', maxLength: 200 });
  const from = input('email', { required: true, maxLength: 200 });
  const host = input('text', { required: true, maxLength: 253, placeholder: 'smtp.tu-proveedor.com' });
  const port = select([['465', '465 · TLS'], ['587', '587 · STARTTLS']], '587');
  const user = input('text', { autocomplete: 'off', maxLength: 200 });
  const password = input('password', { autocomplete: 'off', maxLength: 512 });
  dialog('Avisos por correo', [n('p', 'Usa los datos SMTP de tu proveedor. PacoSAT verifica la conexión antes de activar los avisos. Vuelve a configurarlos al reiniciar el servicio.'),
    field('Correo que recibe los avisos', recipient), field('Dirección del remitente', from), field('Servidor SMTP', host),
    field('Puerto', port), field('Usuario SMTP', user), field('Contraseña SMTP o de aplicación', password)], async () => {
    satData = await satApi('mail', { enabled: true, recipient: recipient.value.trim(), from: from.value.trim(),
      host: host.value.trim(), port: Number(port.value), user: user.value, password: password.value });
    password.value = '';
    fillSatMail(); announce('Avisos activados. Se enviarán al detectar nuevos CFDI recibidos.');
  }, 'Activar avisos');
}

async function pollSat() {
  if (!satToken || !ready || satPolling) return;
  satPolling = true;
  try {
    satData = await satApi('status');
    satError = '';
    flushOfflineQueue().catch(() => {});
    if (satData.settings) {
      /* La identidad del servidor manda sobre la copia local (1.6.6). */
      appSettings = { ...appSettings, ...satData.settings, logoData: appSettings.logoData };
      if (satData.settings.hasLogo && !appSettings.logoData) {
        try {
          const logo = await satApi('settings/logo');
          appSettings.logoData = 'data:' + logo.mime + ';base64,' + logo.data;
        } catch { /* sin logo disponible: se queda la marca de texto */ }
      }
      if (!satData.settings.hasLogo) appSettings.logoData = '';
      applySettings();
    }
    if (cloudStorage && satData.cloudRevision !== cloudRevision && !$('dialog').open && !importing &&
        !document.activeElement?.matches('input,select,textarea')) {
      await refresh(page === 'sat');
      cloudRevision = satData.cloudRevision;
    }
    const drain = async () => {
      for (const packet of satData.inbox) {
        if (importing || !people.some(person => person.id === packet.rfc)) continue;
        const archive = await satApi('packages/' + packet.id);
        if (importing || $('dialog').open) break;
        const result = await importBatch([new File([archive], 'SAT-' + packet.rfc + '-' + packet.id + '.zip')], packet.rfc, { quiet: true });
        if (result) { if (result.added) soundCue('notice'); await satApi('packages/' + packet.id, { imported: result.added }); }
      }
    };
    if (!$('dialog').open) {
      if (navigator.locks) await navigator.locks.request('pacosat-sat-import', { ifAvailable: true }, lock => lock ? drain() : undefined);
      else await drain();
    }
  } catch (error) {
    satError = error.message;
  } finally {
    satPolling = false;
    /* La insignia del Centro de Avisos se refresca con el mismo pulso
       del servidor (1.7.4): sin peticiones extra fuera de este ciclo. */
    refreshAvisos().catch(() => {});
    if (page === 'sat' && !$('dialog').open && !document.activeElement?.closest('#sat-live')) fillSat();
    /* Ajustes › Correo (1.11.0): si la sección de correo está en
       pantalla, el mismo pulso la mantiene al día, sin ritmo nuevo. */
    const mailLive = $('sat-mail-live');
    if (mailLive && !$('dialog').open && !document.activeElement?.closest('#sat-mail-live')) fillSatMail(mailLive);
  }
}
/* El registro del pulso vive en monitor-ui.part (1.11.0): un solo
   temporizador de 30 s para todo el cliente. */
