      ir.textContent = 'Guardar la contraseña CIEC';
      ir.onclick = () => ciecDialog(rfc);
    } else {
      falta.append(n('p', 'Este RFC tiene su e.firma guardada, pero no está autorizada en esta sesión: sin firmante activo, ninguna solicitud llega al SAT.'),
        n('p', 'Gesto único: autoriza la e.firma de ' + rfc + ' y vuelve a esta tarjeta.'));
      ir.textContent = 'Autorizar la e.firma';
