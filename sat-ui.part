     (un cierre desplazado que rueda al día siguiente), manda
     la coincidencia de siempre. */
  if (st.jobIds2914 && st.jobIds2914.size) {
    const porIds2914 = (satData.jobs || []).filter(job => st.jobIds2914.has(String(job.id)));
    if (porIds2914.length) mine = porIds2914;
  }
  const jobIds = new Set(mine.map(job => String(job.id)));
  const acts = (actsAll || []).filter(entry => String(entry.id || '').startsWith('sat:') &&
    jobIds.has(String(entry.id).split(':')[1]));
  const added = acts.reduce((sum, entry) => sum + (entry.added || 0), 0);
  const dups = acts.reduce((sum, entry) => sum + (entry.duplicates || 0), 0);
