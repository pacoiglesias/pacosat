    enlazar('constancia', () => estados.constancia.accion === 'ir-descarga' ? acciones['ir-descarga']() : acciones.pedir('constancia'));
    enlazar('opinion', () => estados.opinion.accion === 'ir-descarga' ? acciones['ir-descarga']() : acciones.pedir('opinion'));
    enlazar('declaraciones', (btn) => estados.declaraciones.accion === 'ir-descarga' ? acciones['ir-descarga']() : estados.declaraciones.accion === 'emparejar' ? acciones.emparejar() : acciones.decl(btn));
    enlazar('buzon', (btn) => estados.buzon.accion === 'ir-descarga' ? acciones['ir-descarga']() : estados.buzon.accion === 'emparejar' ? acciones.emparejar() : acciones.buzon(btn));
