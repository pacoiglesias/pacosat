        for (const ventana2914 of ventanas2914) {
          const payload = { rfc: st.rfc, direction: dir2913,
            start: ventana2914.start, end: ventana2914.end, type: 'cfdi' };
          if (!cob2914) {
            if (st.shiftDir?.[dir2913]) payload.shiftEnd = st.shiftDir[dir2913];
            else if (st.shift && direcciones2913.length === 1) payload.shiftEnd = st.shift;
