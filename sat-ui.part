  if (!st.running) return;
  const data = await satApi('ciec').catch(() => null);
  if (data) descargaPintarCiec2912(ctx, data);
}
function descargaPintarCiec2912(ctx, data) {
  const { st } = ctx;
  const perfil = (data?.profiles || []).find(p => p.rfc === st.rfc);
  if (!perfil) return;
  const progress = perfil.progress || {};
  const steps = (progress.steps || []).map(s => typeof s === 'string' ? s : (s?.text || ''));
  for (const texto of steps) {
    const halladas = /encontró (\d+) facturas/.exec(texto);
    if (halladas) st.found = Number(halladas[1]);
    const bajando = /Descargando tus facturas \((\d+) de (\d+)\)/.exec(texto);
    if (bajando) { st.downloaded = Number(bajando[1]); if (!st.found) st.found = Number(bajando[2]); }
  }
  descargaPintarCuentas2912(ctx);
  const cap = perfil.captcha;
  if (cap && cap.image) {
    ctx.fase.textContent = 'Tu gesto: el captcha';
    ctx.detalle.textContent = 'El portal enseñó su captcha: escríbelo aquí y la descarga sigue sola.';
    /* (2.9.14) Los pasos también se encienden durante la
       espera del captcha: esta rama volvía sin pasar por
       descargaPasos2913 y la marcha tenía un estado — el del
       gesto — sin su paso dibujado encendido. */
    descargaPasos2913(ctx);
