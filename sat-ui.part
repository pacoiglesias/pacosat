    ctx.detalle.textContent = acts.length ? 'El SAT ya liberó paquetes: se están guardando en tu expediente.'
      : 'El SAT está preparando tu paquete; esto puede tardar. La solicitud ya está en el SAT y se importará sola cuando la libere.';
    descargaPasos2913(ctx);
