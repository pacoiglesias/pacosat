      ctx.go.textContent = st.cobToda2914 ? 'Descargar'
        : decididas.some(dir => (cobPorDir2914[dir].restos || []).length) ? 'Pedir solo lo que falta'
        : (pedidas.length ? 'Pedir la variante' : 'Descargar');
    } else if (pedidas.length) {
      st.shift = 1;
      const fecha = typeof fmtFechaHora === 'function' ? fmtFechaHora(pedidas[0].at) : String(pedidas[0].at);
      ctx.planAviso.textContent = 'Ojo: esta ventana ya se pidió el ' + fecha +
        ' y está en espera del SAT: no se repite. Si descargas, se pedirá la variante — el mismo periodo cerrando 1 segundo más tarde —, no el criterio exacto.';
      ctx.planAviso.hidden = false;
