       aplica: ese sentido no se envía o envía solo su resto. */
    const shiftDir2913 = {};
    const cobPorDir2914 = {};
    for (const dir of direcciones) {
      const plan = await satApi('plan', { rfc: st.rfc, direction: dir, type: 'cfdi',
        start: ctx.start.value, end: ctx.end.value });
      cobPorDir2914[dir] = plan?.cobertura || null;
      const deEste = planYaPedidas230(plan);
      shiftDir2913[dir] = deEste.length ? 1 : 0;
      pedidas.push(...deEste);
    }
    if (seq !== st.planSeq || st.running) return;
    st.planConocido = true;
    st.cobertura2914 = cobPorDir2914;
    const decididas = direcciones.filter(dir => descargaCoberturaDe2914(st, dir));
    st.cobToda2914 = direcciones.length > 0 && decididas.length === direcciones.length &&
      direcciones.every(dir => cobPorDir2914[dir].completa);
    st.cobParcial2914 = decididas.length > 0 && !st.cobToda2914;
    for (const dir of decididas) shiftDir2913[dir] = 0;
    st.shiftDir = shiftDir2913;
    st.shift = direcciones.some(dir => !decididas.includes(dir) && shiftDir2913[dir]) ? 1 : 0;
    /* La nota corta de la cobertura parcial: viaja al aviso y
       a la línea de cierre, para que la tarjeta diga qué parte
       ya constaba y qué parte se pide. */
    st.notaCobertura2914 = decididas
      .filter(dir => !cobPorDir2914[dir].completa)
      .map(dir => descargaCoberturaTexto2914(st, dir, true)).join(' ');
    if (decididas.length) {
      const notas = decididas.map(dir => descargaCoberturaTexto2914(st, dir));
      if (st.cobToda2914)
