  const cuentaEls = {};
  for (const [clave, etiqueta] of [['found', 'encontrados'], ['downloaded', 'descargados'], ['saved', 'guardados']]) {
    const celda = n('span');
    const fuerte = n('strong', '0'); fuerte.dataset.dl2912Count = clave;
    celda.append(fuerte, n('small', ' ' + etiqueta));
    cuentas.append(celda); cuentaEls[clave] = fuerte;
  }
  const reloj = n('span', '0:00', 'dl2912-elapsed'); reloj.dataset.dl2912Elapsed = '1';
  const captchaBox = n('div', undefined, 'ciec-captcha');
