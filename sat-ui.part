      img.dataset.dl2912CaptchaImg = '1'; img.src = cap.image;
      img.alt = 'Captcha del portal del SAT';
      const entrada = input('text', { maxLength: 32, autocomplete: 'off', placeholder: 'Escribe lo que ves' });
      entrada.dataset.dl2912CaptchaInput = '1';
      const seguir = n('button', 'Seguir con la descarga', 'primary');
      seguir.type = 'button'; seguir.dataset.dl2912CaptchaGo = '1';
      seguir.onclick = async () => {
        const texto = entrada.value.trim();
        if (!texto) return;
        seguir.disabled = true;
        try {
          const vuelta = await satApi('ciec/captcha', { rfc: st.rfc, text: texto });
          entrada.value = '';
          st.captchaSince = '';
          ctx.captchaBox.hidden = true;
          descargaPintarCiec2912(ctx, vuelta);
        } catch (error) {
          ctx.detalle.textContent = String(error?.message || error || 'sin detalle');
          seguir.disabled = false;
        }
      };
      ctx.captchaBox.append(n('h4', 'El portal pide el captcha — intento ' + (cap.attempt || 1) + ' de ' + (cap.max || 3)),
        n('p', 'Escribe los caracteres de la imagen tal como se ven. Es tu gesto de seguridad: PacoSAT lo teclea en el portal y no lo guarda en ningún sitio.', 'muted'),
        img, fieldWrap('Lo que ves en la imagen', entrada), seguir);
