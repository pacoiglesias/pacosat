    ctx.detalle.textContent = progress.step || 'Trabajando en el portal…';
    return;
  }
  const run = (perfil.runs || [])[0];
  if (!run) return;
  if (run.ok) {
    st.found = run.found || 0; st.downloaded = run.downloaded || 0; st.saved = run.added || 0;
    descargaPintarCuentas2912(ctx);
    descargaTerminar2912(ctx, (run.added || 0) > 0
      ? 'Listo: ' + run.added + ' XML guardados en tu expediente'
      : (run.duplicates || 0) > 0
        ? 'Listo: el SAT entregó ' + run.duplicates + ' XML y ya estaban en tu expediente.'
        : 'Listo: el SAT no encontró CFDI nuevos en ese periodo.');
  } else {
    descargaDetener2912(ctx);
    ctx.fase.textContent = 'La descarga no terminó';
    ctx.detalle.textContent = String(run.error || 'El portal no completó la bajada: mira el diario de descargas CIEC de esta pantalla.');
  }
}

/* Pantalla de descarga de la pestaña SAT (1.11.0): SOLO la descarga.
   Devuelve [guía «Sincronización directa», contenedor #sat-live] y
   fillSat() pinta dentro perfiles/solicitudes y la cola de trabajos
   (más el historial de peticiones, plegado como detalle técnico).
   Las constancias/opinión (satDocsSection) y las declaraciones
   (declaracionesSection) ya NO se pintan aquí: viven en Documentos y
   la cáscara las compone allí. El correo y el silencio tampoco: son
   satMailSection(), en Ajustes › Correo. */
function satDownloadScreen() {
  const guide = n('section', undefined, 'guide');
  const info = n('div');
  info.append(n('h2', 'Sincronización directa con el SAT'),
    n('p', 'Autoriza la e.firma por RFC. PacoSAT solicita CFDI, descarga los paquetes y los incorpora al expediente. El servicio puede seguir abierto aunque cierres la pestaña.'));
  const controls = n('div', undefined, 'actions');
  /* Una sola puerta de alta (1.18.0): «Dar de alta un RFC» abre el
     selector de método — e.firma o CIEC según el caso — en vez de
     dos botones que parecían dos altas distintas. «Configurar
     RFC» sigue siendo lo suyo: desbloquear un RFC ya dado de alta
     para esta sesión. */
  controls.append(action('Dar de alta un RFC', () => altaRfcDialog2912(), 'primary', 'plus'),
    action('Configurar RFC', () => unlockDialog(), undefined, 'lock'),
    action('Solicitar un periodo', requestDialog, undefined, 'sync'));
  guide.append(info, controls);
  const restBar = n('div', undefined, 'panel-head');
  restBar.append(cell('Modo descanso general', 'Un toque apaga todas las descargas y los avisos; al reanudar, PacoSAT se pone al día solo.'), restSwitch());
  guide.append(restBar);
  const container = n('div'); container.id = 'sat-live';
  fillSat(container);
  /* (2.8.0 · diseño 3) La casa única de descargas: bajo lo de
     pedir y lo pedido (fillSat, con la cuota y «Baja lo mismo»
     antepuestos por la envoltura de Vigilancia) viven los
     paneles de cobertura — qué meses tienes, descargas
     pedidas, huecos, metadatos, automática mensual y mapa
     anual — que antes eran la pantalla «Descargados del SAT».
     Para saber «qué bajó, qué falta y cuánta cuota queda» ya
     no hay que visitar tres sitios. */
  /* (2.9.12 · Piezas 2 y 3) La pantalla abre con su tarjeta
     protagonista de descarga; la guía, la cola y la cobertura
     siguen enteras tras ella, en su sitio secundario. */
  const casa280 = [descargarCard2912(), guide, container];
  /* (2.9.13 · mejoras 10 y 12) El año de un vistazo y el
     historial con su gráfico, entre la tarjeta y la cobertura
     completa: la rejilla dice qué meses tienes por sentido y
     el historial, cuántos XML entraron por día. */
  const anio2913 = descargaAnioGrid2913();
  if (anio2913) casa280.push(anio2913);
  const hist2913 = descargaHistorial2913();
  if (hist2913) casa280.push(hist2913);
  if (typeof coberturaPaneles280 === 'function') casa280.push(...coberturaPaneles280(true));
  return casa280;
}
/* (2.9.13 · mejora 10) El mapa del año en rejilla: 12 meses ×
   dos sentidos (emitidos / recibidos) para el RFC en ámbito,
   desde los registros guardados (la misma fuente de «Qué
   meses tienes»): completo = el mes tiene CFDI y ya cerró;
   parcial = tiene CFDI y es el mes en curso; vacío = dentro
   de tu rango de actividad sin ningún CFDI; fuera = antes de
   tu primer mes con actividad. Tocar un mes abre la hoja de
   descarga con ese mes y ese sentido puestos. */
function descargaAnioGrid2913() {
  const rfc = typeof scope !== 'undefined' ? scope : '';
  const records = (typeof satData !== 'undefined' && satData?.coverage?.records) || [];
  const grupos = records.filter(g => !rfc || g.rfc === rfc);
  if (!grupos.length) return null;
  const anio = new Date().getFullYear();
  const mesCurso = anio + '-' + String(new Date().getMonth() + 1).padStart(2, '0');
  const panelAnio = panel('Tu año de un vistazo · ' + anio,
    'Cada mes, por sentido: verde si tienes sus CFDI, ámbar si es el mes en curso, vacío si dentro de tu actividad no consta ninguno. Toca un mes para pedirlo.');
  const MESES2913 = ['ene', 'feb', 'mar', 'abr', 'may', 'jun', 'jul', 'ago', 'sep', 'oct', 'nov', 'dic'];
  for (const dir of ['issued', 'received']) {
    const grupo = grupos.find(g => g.direction === dir);
    const fila = n('div', undefined, 'dl2913-anio-fila');
    fila.append(n('span', dir === 'issued' ? 'Emitidos' : 'Recibidos', 'dl2913-anio-rotulo'));
    const porMes = new Map((grupo?.months || []).map(c => [c.month, c]));
    for (let m = 1; m <= 12; m++) {
      const clave = anio + '-' + String(m).padStart(2, '0');
      const celda = n('button', MESES2913[m - 1], 'dl2913-mes');
      celda.type = 'button';
      let estado = 'fuera';
      if (grupo && clave >= grupo.first && clave <= grupo.last)
        estado = porMes.get(clave)?.count ? (clave === mesCurso ? 'parcial' : 'completo') : 'vacio';
      celda.dataset.estado = estado;
      celda.title = MESES2913[m - 1] + ' ' + anio + ' · ' + (dir === 'issued' ? 'emitidos' : 'recibidos') + ': ' +
        (estado === 'completo' ? 'tienes ' + number.format(porMes.get(clave).count) + ' CFDI'
          : estado === 'parcial' ? 'mes en curso, con ' + number.format(porMes.get(clave).count) + ' CFDI por ahora'
          : estado === 'vacio' ? 'sin CFDI guardados' : 'antes de tu actividad registrada');
      celda.onclick = () => {
        const ultimoDia = new Date(Date.UTC(anio, m, 0)).getUTCDate();
        downloadSheet((grupo?.rfc || rfc), { direction: dir, start: clave + '-01',
          end: clave + '-' + String(ultimoDia).padStart(2, '0') });
      };
      fila.append(celda);
    }
    panelAnio.append(fila);
  }
  return panelAnio;
}
/* (2.9.13 · mejora 12) El historial con gráfico: cuántos XML
   entraron por día en los últimos 14 días, de la actividad de
   importaciones (la misma que alimenta la franja: entradas
   «sat:» con sus nuevos y sus «ya estaban»). Sin actividad
   reciente, el panel lo dice en llano en vez de fingir un
   gráfico vacío. */
function descargaHistorial2913() {
  const entradas = (typeof activity !== 'undefined' && Array.isArray(activity) ? activity : [])
    .filter(e => String(e?.id || '').startsWith('sat:') && ((e.added || 0) + (e.duplicates || 0)) > 0);
  if (!entradas.length) return null;
  const dias = [];
  const hoyMs = new Date(new Date().toLocaleDateString('en-CA', { timeZone: 'America/Mexico_City' })).getTime();
  for (let i = 13; i >= 0; i--) dias.push({ desde: hoyMs - i * 86400000, total: 0 });
  for (const e of entradas) {
    const t = Number(e.at) || 0;
    const dia = dias.find(d => t >= d.desde && t < d.desde + 86400000);
    if (dia) dia.total += (e.added || 0) + (e.duplicates || 0);
  }
  if (!dias.some(d => d.total)) return null;
  const panelHist = panel('Historial de descargas',
    'Los XML que entraron por día en los últimos 14 días (nuevos y «ya estaban», contados una vez).');
  const max = Math.max(...dias.map(d => d.total), 1);
  const svg = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
  svg.setAttribute('viewBox', '0 0 280 64');
  svg.setAttribute('class', 'dl2913-hist');
  svg.setAttribute('role', 'img');
  svg.setAttribute('aria-label', 'Gráfico de XML descargados por día');
  dias.forEach((d, i) => {
    const alto = Math.max(2, Math.round((d.total / max) * 52));
    const rect = document.createElementNS('http://www.w3.org/2000/svg', 'rect');
    rect.setAttribute('x', String(4 + i * 20));
    rect.setAttribute('y', String(58 - alto));
    rect.setAttribute('width', '13');
    rect.setAttribute('height', String(alto));
    rect.setAttribute('rx', '2');
    const titulo = document.createElementNS('http://www.w3.org/2000/svg', 'title');
    titulo.textContent = new Date(d.desde).toLocaleDateString('es-MX', { day: 'numeric', month: 'short' }) + ': ' + d.total + ' XML';
    rect.append(titulo);
    svg.append(rect);
  });
  panelHist.append(svg);
  const total14 = dias.reduce((s, d) => s + d.total, 0);
  panelHist.append(n('p', 'En total, ' + number.format(total14) + ' XML en 14 días. El detalle de cada paquete vive en el Registro y en «Qué meses tienes».', 'muted'));
  return panelHist;
}
/* Nombre anterior de la misma pantalla: se conserva como alias de
   transición hasta que la cáscara (ui.part) termine de apuntar a
   satDownloadScreen(); no añade comportamiento. */
/* La línea de un trabajo con portalRescue (2.9.7 · C2): sin
   portalRescue no hay línea; recuperada, la frase honesta sin
   botón (no hay nada que bajar); sin recuperar y con
   pendientes, la frase con su conteo y el botón que baja ese
   periodo por el portal, con progreso y Cancelar en la línea. */
function portalRescueLinea297(job) {
  const rescue = job?.portalRescue;
  if (!rescue) return null;
  const box = n('div', undefined, 'portal-rescue297');
  box.dataset.portalRescue297 = '1';
  box.dataset.rfc297 = job.rfc || '';
  if (rescue.recuperada) {
    box.append(n('p', 'Sus documentos ya entraron por el portal. La solicitud sigue abierta en el SAT (no se puede cancelar desde aquí) y PacoSAT ya no depende de ella.'));
    return box;
  }
  const pendientes = Number(rescue.pendientes) || 0;
  if (!pendientes) return null;
  box.append(n('p', 'El SAT aún no entrega esta solicitud. Sus ' + pendientes +
    ' documentos conocidos se pueden bajar ahora por el portal'));
  const prog = n('div');
  const bajar = action('Bajarlos ahora por el portal', async () => {
    bajar.disabled = true;
    await portalLanzar297(prog, { rfc: job.rfc,
      period: { direction: job.direction, startAt: job.periodStart, endAt: job.periodEnd },
      origen: 'rescate' }, (ok, state, runError) => {
        prog.append(n('p', ok ? 'Hecho: los documentos bajaron por el portal.'
          : 'No se pudo bajar por el portal: ' + (runError ? runError.message : portalMotivo297(state)),
          ok ? 'ok-text' : 'error-text'));
      });
  }, 'primary', 'down');
  bajar.dataset.portalRescueBajar297 = '1';
  box.append(bajar, prog);
  return box;
}
function fillSat(target = $('sat-live')) {
  if (!target) return;
  const schedules = panel('Revisión automática por RFC');
  if (satError) schedules.append(empty('No se pudo leer el estado', satError, action('Actualizar', pollSat)));
  else {
    const profiles = satData.profiles.filter(row => !scope || row.rfc === scope);
    if (!profiles.length) schedules.append(empty('Sin RFC configurados', 'Primero autoriza la e.firma de este RFC para que PacoSAT pueda trabajar con el SAT.', action('Autorizar e.firma', () => efirmaDialog(), 'primary', 'key')));
    else schedules.append(grid(['RFC', 'Frecuencia', 'Próxima revisión', 'Estado', 'Acción'], profiles.map(row => {
      const restingProfile = Boolean(row.paused) || (row.pauseUntil || 0) > Date.now();
      const buttons = n('div', undefined, 'actions');
      if (row.accessMethod === 'ciec') {
        /* Método CIEC (1.12.0): sin e.firma no hay desbloqueo ni
           descarga automática; la fila lo dice claro y manda a la
           tarjeta CIEC de esta misma pantalla. */
        buttons.append(action('Contraseña CIEC', () => ciecDialog(row.rfc)));
        return [
          cell(row.rfc, 'Acceso con contraseña (CIEC)' + (row.ciecStored ? ' · Contraseña guardada en el servidor' : ' · Falta guardar la contraseña')),
          'Descarga a mano',
          'Cuando la pidas',
          cell('Con contraseña', 'Sin e.firma: se descarga desde la tarjeta CIEC de esta pantalla, con tu captcha'),
          buttons
        ];
      }
      if (row.unlocked) buttons.append(action('Bloquear', async () => { satData = await satApi('lock', { rfc: row.rfc }); fillSat(); }));
      else buttons.append(action('Desbloquear', () => unlockDialog(row.rfc)));
      if (restingProfile) buttons.append(action('Reanudar', async () => {
        satData = await satApi('pause', { rfc: row.rfc, paused: false });
        fillSat(); announce(row.rfc + ' vuelve a vigilar; se pondrá al día con la ventana pendiente.');
      }, 'primary'));
      else buttons.append(action('Descansar', async () => {
        satData = await satApi('pause', { rfc: row.rfc, paused: true });
        fillSat(); announce(row.rfc + ' entra en descanso: sin descargas ni avisos.');
      }), action('Hasta…', () => pauseUntilDialog(row)));
      if (row.unlocked && !restingProfile) buttons.append(action('Descargar ahora', async () => {
        /* UX-06: fuerza el ciclo de este RFC al momento (el servidor
           aplica los mismos frenos: descanso o bloqueo lo impiden).
           Sin conexión (1.7.0) queda en cola como intención 5002. */
        const data = await requestRunNow(row.rfc);
        if (data) {
          satData = data;
          fillSat(); announce('Revisión inmediata de ' + row.rfc + ' ejecutada: solicitudes programadas y paquetes al día.');
          soundCue('success');
        }
      }, undefined, 'sync'));
      return [
        cell(row.rfc, row.error || (row.unlocked ? 'Activo · ' + directions[row.direction] : 'Primero autoriza la e.firma de este RFC para que PacoSAT pueda trabajar con el SAT.') +
          (row.efirmaStored ? ' · Guardada en el servidor' : '')),
        (row.minutes / 60) + ' h · últimos ' + row.days + ' días',
        row.unlocked ? localDateTime(row.nextRun) : 'En pausa',
        restingProfile ? cell('Descansando', row.pauseUntil ? 'Hasta ' + localDateTime(row.pauseUntil) : 'Hasta que lo reanudes') : cell('Vigilando', 'Descargas y avisos activos'),
        buttons
      ];
    })));
  }
  const queue = panel('Solicitudes recientes');
  const jobs = satData.jobs.filter(row => !scope || row.rfc === scope);
  /* (2.9.9 · D3) La lista de solicitudes corta en 25 y «Ver
     más» trae las siguientes, sin salir de la pantalla. */
  if (jobs.length) queue.append(grid(['RFC', 'Periodo', 'Estado', 'Acción'], jobs.slice(0, satJobsLimite299).map(row => [
    cell(row.rfc, directions[row.direction] + (row.kind === 'metadata' ? ' · Solo el listado' : '')), dateLabel(row.periodStart) + ' – ' + dateLabel(row.periodEnd),
    cell(satStatus[row.status] || row.status, [row.error || (row.status === 'pending' ? 'Próxima consulta ' + localDateTime(row.due) : ''),
      criteriaNotes[row.criteriaState] || ''].filter(Boolean).join(' · ')),
    row.status === 'pending' ? action('Reintentar consulta', async () => { satData = await satApi('retry', { id: row.id }); fillSat(); announce('Consulta programada para el siguiente ciclo del servicio.'); }) : n('span', 'Creada ' + localDateTime(row.created))
  ])));
  else queue.append(empty('Todavía no hay solicitudes', 'Al activar un RFC, PacoSAT iniciará la revisión en segundo plano.'));
  if (jobs.length > satJobsLimite299) {
    const foot299 = n('div', undefined, 'table-foot');
    foot299.append(n('span', 'Ves ' + number.format(Math.min(satJobsLimite299, jobs.length)) + ' de ' + number.format(jobs.length) + ' solicitudes'),
      action('Ver más', () => { satJobsLimite299 += 25; fillSat(target); }, 'soft'));
    queue.append(foot299);
  }
  /* Línea honesta + rescate por el portal (2.9.7 · C2): un
     trabajo cfdi «pending» de más de 48 h trae portalRescue en
     el estado — si sus documentos ya entraron por el portal,
     la línea lo dice y aclara que la solicitud del SAT sigue
     abierta sin depender de ella; si no, ofrece bajarlos ahora
     por el portal con el periodo del propio trabajo. */
  for (const job of jobs) {
    const lineaRescate297 = portalRescueLinea297(job);
    if (lineaRescate297) queue.append(lineaRescate297);
  }
  /* Detalle técnico plegado (1.11.0): el historial de peticiones sale
     de la vista diaria; vive cerrado dentro de la descarga y solo se
     abre si se quiere ver la maquinaria. El correo y el silencio ya
     no se pintan aquí: son satMailSection(), en Ajustes › Correo. */
  /* La tarjeta CIEC (1.12.0) cierra la pantalla cuando algún RFC
     usa ese método: ahí se elige el rango y se descarga, con el
     captcha escrito por Paco en la propia tarjeta. */
  /* Descargar primero (1.32.1, S5): la pestaña abre con las
     solicitudes (el trabajo) y la tabla de revisión automática
     — configuración — va plegada debajo, no presidiendo. */
  const schedulesFold = n('details', undefined, 'seal-details');
  schedulesFold.append(n('summary', 'Revisión automática por RFC — configuración'), schedules);
  const satNodes = [queue, schedulesFold, satCriteriaBookDetails()];
  if ((satData.profiles || []).some(row => row.accessMethod === 'ciec')) satNodes.push(ciecPanel());
  target.replaceChildren(...satNodes);
}
/* Historial de peticiones al SAT: el registro persistente de cada
   petición enviada, por RFC, con su resultado. Es la fuente de verdad
   de la guardia, del planificador y del rescate — y por eso es
   detalle técnico: un <details> cerrado al entrar (patrón
   seal-details de la app), no un panel más de la pila diaria. */
function satCriteriaBookDetails() {
  const details = n('details', undefined, 'seal-details sat-criteria-book');
  details.append(n('summary', 'Historial de peticiones al SAT'));
  details.append(n('p', 'Cada petición que PacoSAT hace al SAT queda registrada para no repetirla nunca: el SAT castiga las peticiones repetidas. Si una petición se agota, PacoSAT busca otra vía solo.'));
  const entries = (satData.criteriaBook || []).filter(row => !scope || row.rfc === scope);
  if (!entries.length) details.append(empty('Sin peticiones todavía', 'Cuando se envíe la primera solicitud al SAT, quedará registrada aquí.'));
  else details.append(grid(['RFC', 'Criterio', 'Envíos', 'Estado', 'Acción'], entries.slice(0, 60).map(entry => {
    const acts = n('div', undefined, 'actions');
    if (entry.state === 'agotado' || entry.state === 'rescatado')
      acts.append(action(entry.state === 'agotado' ? 'Preparar rescate' : 'Ver rescate', () => rescueDialog(entry)));
    if (entry.state !== 'disponible')
      acts.append(action('Pedir con el cierre exacto', () => requestDialog({ rfc: entry.rfc, direction: entry.direction,
        start: entry.startAt.slice(0, 10), end: entry.endAt.slice(0, 10), type: entry.type, shiftEnd: true })));
    return [cell(entry.rfc, (entry.type === 'metadata' ? 'Solo el listado' : 'CFDI') + ' · ' + directions[entry.direction]),
      stampLabel(entry.startAt) + ' → ' + stampLabel(entry.endAt),
      entry.sends.length ? entry.sends.length + ' · ' + (entry.presumed ? 'presunto enviado' : localDateTime(entry.lastSentAt)) : 'Sin envíos propios',
      cell(criteriaNotes[entry.state] || entry.state, entry.state === 'rescatado' ? 'Entraron ' + entry.rescuedCount + ' CFDI por la carpeta vigilada' :
        entry.state === 'agotado' ? 'Solo se quemó esta combinación exacta' : ''),
      acts];
  })));
  return details;
}
/* ===== Correo y aviso de silencio (1.11.0) =====
   Salen de la pantalla de descarga: son configuración, no trabajo
   diario. satMailSection() devuelve UN nodo —un div#sat-mail-live
   con los dos paneles ya rellenos desde satData— para que Ajustes ›
   Correo lo incruste tal cual en su lista de paneles.
   fillSatMail() repinta ese nodo tras cada cambio (los diálogos de
   SMTP y de umbral la llaman al guardar, y pollSat la refresca si el
   nodo está en pantalla). Estado y explicación van separados
   (píldora + texto), nunca fundidos en una sola etiqueta. */
function satMailSection() {
  const container = n('div'); container.id = 'sat-mail-live';
  fillSatMail(container);
  return container;
}
function fillSatMail(target = $('sat-mail-live')) {
  if (!target) return;
  target.replaceChildren(satMailPanel(), satEventMailPanel(), satSilencePanel());
}
/* Avisos importantes por correo (1.13.0): los tres sucesos que no
   pueden quedarse dentro de la app —una factura vigilada que el
   SAT cancela, un emisor que entra en el listado 69-B y una
   descarga de documentos del SAT que termina mal— salen por
   correo, uno por suceso, a la dirección de avisos. Interruptor
   propio, activado por defecto; sin correo configurado, la
   tarjeta lo dice y no sale nada. */
function satEventMailPanel() {
  const wrap = panel('Avisos importantes por correo');
  const bar = n('div', undefined, 'panel-head');
  const notice = n('div');
  const activo = satData.mail.enabled && satData.mail.alerts !== false;
  notice.append(!satData.mail.enabled ? statusPill('dim', 'Sin correo configurado') :
      satData.mail.alerts === false ? statusPill('dim', 'Desactivado') : statusPill('ok', 'Activado'),
    n('p', 'Un correo por suceso, solo para lo que no puede esperar: una factura vigilada que el SAT cancela, ' +
      'un emisor tuyo que entra en el listado 69-B (presunto o definitivo) y una descarga de documentos del SAT ' +
      '(constancia u opinión, manual o automática) que termina mal. El correo cuenta qué pasó, de quién es la ' +
      'causa y qué hacer; nunca lleva credenciales ni importes que no estén ya en el aviso de la app.'));
  if (!satData.mail.enabled) notice.append(n('p',
    'Sin dirección de avisos configurada estos avisos no salen: configura el correo arriba y llegarán a esa dirección.', 'error-text'));
  else if (satData.mail.recipient) notice.append(n('p', 'Dirección de avisos: ' + satData.mail.recipient + '.'));
  const buttons = n('div', undefined, 'actions');
  if (satData.mail.enabled) buttons.append(action(activo ? 'Desactivar' : 'Activar', async () => {
    satData = await satApi('mail/alerts', { enabled: !activo });
    fillSatMail();
    announce(activo ? 'Avisos importantes por correo desactivados.' : 'Avisos importantes por correo activados.');
  }));
  bar.append(notice, buttons); wrap.append(bar);
  return wrap;
}
function satMailPanel() {
  const alerts = panel('Avisos por correo');
  const bar = n('div', undefined, 'panel-head');
  const notice = n('div');
  notice.append(satData.mail.enabled ? statusPill('ok', 'Activado') : statusPill('dim', 'Desactivado'),
    n('p', 'Te avisa por correo cuando llega un CFDI recibido nuevo. El correo lleva el conteo, sin adjuntar los XML.' +
      (satData.mail.enabled && satData.mail.recipient ? ' Correo de avisos: ' + satData.mail.recipient + '.' : '')));
  if (satData.mail.error) notice.append(n('p', satData.mail.error, 'error-text'));
  const buttons = n('div', undefined, 'actions');
  buttons.append(action('Configurar SMTP', mailDialog, undefined, 'lock'));
  if (satData.mail.enabled) {
    buttons.append(action('Enviar correo de prueba', async () => {
      /* UX-09: la primera prueba del SMTP no debe ser un aviso real. */
      await satApi('mail/test', {});
      announce('Correo de prueba enviado a ' + satData.mail.recipient + '. Revisa tu bandeja: si llegó, los avisos funcionarán.');
      soundCue('success');
    }, undefined, 'bell'));
    buttons.append(action('Desactivar', async () => { satData = await satApi('mail', { enabled: false }); fillSatMail(); }));
  }
  bar.append(notice, buttons); alerts.append(bar);
  return alerts;
}
function satSilencePanel() {
  const silence = panel('Aviso de silencio');
  const bar = n('div', undefined, 'panel-head');
  const notice = n('div');
  notice.append(satData.silenceDays ? statusPill('ok', 'Activado') : statusPill('dim', 'Desactivado'),
    n('p', satData.silenceDays ?
      'Te avisa por correo cuando llega una factura esperada y no llega: si un RFC lleva ' + satData.silenceDays + ' días sin CFDI recibidos nuevos, PacoSAT avisa una vez por episodio. Tú defines el umbral.' :
      'Te avisa por correo cuando llega una factura esperada y no llega. Define el umbral de días para activarlo.'));
  const buttons = n('div', undefined, 'actions');
  buttons.append(action('Cambiar umbral', silenceDialog, undefined, 'bell'));
  bar.append(notice, buttons); silence.append(bar);
  return silence;
}
function silenceDialog() {
  const days = input('number', { min: 0, max: 365, value: satData.silenceDays || 0, required: true });
  dialog('Aviso de silencio', [
    n('p', 'Si un RFC pasa más días que el umbral sin recibir CFDI nuevos, PacoSAT avisa por correo una vez por episodio. Con 0 queda desactivado.'),
    field('Días sin CFDI nuevos para avisar', days)], async () => {
    satData = await satApi('silence', { days: Number(days.value) });
    fillSatMail(); announce(Number(days.value) ? 'Aviso de silencio activo: ' + days.value + ' días.' : 'Aviso de silencio desactivado.');
  });
}
function restDialog() {
  const until = input('date', { required: true, min: new Intl.DateTimeFormat('en-CA', { timeZone: 'America/Mexico_City' }).format() });
  dialog('Descanso general de PacoSAT', [
    n('p', 'Mientras dure el descanso no se envía ninguna solicitud al SAT (la disciplina 5002 queda intacta) y no se genera ningún aviso. La carpeta vigilada y los respaldos siguen trabajando. Al llegar la fecha, la vigilancia se reanuda sola y se pone al día con la ventana pendiente.'),
    field('Descansar hasta el', until)], async () => {
    const ms = new Date(until.value + 'T08:00:00-06:00').getTime();
    satData = await satApi('rest', { until: ms });
    fillSat(); announce('PacoSAT entra en descanso hasta el ' + until.value + '.');
  });
}
function pauseUntilDialog(row) {
  const until = input('date', { required: true, min: new Intl.DateTimeFormat('en-CA', { timeZone: 'America/Mexico_City' }).format() });
  dialog('Descanso de ' + row.rfc, [
    n('p', 'Este RFC deja de descargar y de generar avisos hasta la fecha indicada; entonces se reanuda solo y se pone al día con la ventana pendiente.'),
    field('Descansando hasta el', until)], async () => {
    const ms = new Date(until.value + 'T08:00:00-06:00').getTime();
    satData = await satApi('pause', { rfc: row.rfc, until: ms });
    fillSat(); announce(row.rfc + ' descansa hasta el ' + until.value + '.');
  });
}
function unlockDialog(rfc) {
  const person = selectPerson();
  if (rfc && people.some(row => row.id === rfc)) person.value = rfc;
  const defaults = satData.profiles.find(row => row.rfc === person.value);
  const interval = select([['60','Cada hora'],['120','Cada 2 horas'],['240','Cada 4 horas'],['360','Cada 6 horas'],['720','Cada 12 horas'],['1440','Cada día']], String(defaults?.minutes || 240));
  const days = input('number', { min: 1, max: 31, value: defaults?.days || 7, required: true });
  const direction = select(Object.entries(directions), defaults?.direction || 'received');
  const certificate = input('file', { required: true, accept: '.cer' });
  const key = input('file', { required: true, accept: '.key' });
  const password = input('password', { required: true, maxLength: 256, autocomplete: 'off' });
  dialog('Autorizar sincronización', [
    n('p', 'Autorización solo para esta sesión del servicio: al reiniciar habrá que autorizar de nuevo. Para que la e.firma quede guardada y se reactive sola, usa «Subir e.firma».'),
    field('Contribuyente', person), field('Qué revisar', direction), field('Frecuencia', interval), field('Días de búsqueda', days),
    field('Certificado .cer', certificate), field('Llave privada .key', key), field('Contraseña de la e.firma', password)
  ], async () => {
    const fileData = async file => {
      check(file && file.size <= 32 * KB, 'Selecciona un archivo de e.firma válido.');
      return encode64(bytes(await file.arrayBuffer()));
    };
    satData = await satApi('unlock', { rfc: person.value, minutes: Number(interval.value), days: Number(days.value),
      direction: direction.value, certificate: await fileData(certificate.files[0]), key: await fileData(key.files[0]), password: password.value });
    password.value = '';
    fillSat(); announce('Sincronización autorizada para ' + person.value + '.');
  }, 'Autorizar');
}
function efirmaDialog(prefillRfc) {
  const person = selectPerson();
  if (prefillRfc && people.some(row => row.id === prefillRfc)) person.value = prefillRfc;
  const defaults = (satData.profiles || []).find(row => row.rfc === person.value) || {};
  const interval = select([['60','Cada hora'],['120','Cada 2 horas'],['240','Cada 4 horas'],['360','Cada 6 horas'],['720','Cada 12 horas'],['1440','Cada día']], String(defaults.minutes || 360));
  const days = input('number', { min: 1, max: 31, value: defaults.days || 7, required: true });
  const direction = select(Object.entries(directions), defaults.direction || 'received');
  const certificate = input('file', { required: true, accept: '.cer' });
  const key = input('file', { required: true, accept: '.key' });
  const password = input('password', { required: true, maxLength: 256, autocomplete: 'off' });
  /* «Probar y guardar» (1.6.12): el servidor comprueba TODO antes de
     guardar — que el certificado sea de este RFC, que no esté caducado
     y que la llave y la contraseña cuadren — y la e.firma queda en la
     carpeta protegida del servidor, activa también tras reiniciar.
     Si algo no cuadra, no se guarda nada y lo anterior no se toca. */
  dialog('Subir e.firma al servidor', [
    n('p', 'La e.firma se guarda solo en la carpeta protegida del servidor: nunca entra en la base de datos ni en los respaldos. Antes de guardar se comprueba que el certificado sea de este RFC, que esté vigente y que la llave y la contraseña cuadren; si algo falla, no se guarda nada.'),
    field('Contribuyente', person), field('Qué revisar', direction), field('Frecuencia', interval), field('Días de búsqueda', days),
    field('Certificado .cer', certificate), field('Llave privada .key', key), field('Contraseña de la e.firma', password)
  ], async () => {
    const fileData = async file => {
      check(file && file.size <= 32 * KB, 'Selecciona un archivo de e.firma válido.');
      return encode64(bytes(await file.arrayBuffer()));
    };
    satData = await satApi('efirma', { rfc: person.value, minutes: Number(interval.value), days: Number(days.value),
      direction: direction.value, certificate: await fileData(certificate.files[0]), key: await fileData(key.files[0]), password: password.value });
    password.value = '';
    fillSat();
    const profile = satData.profiles.find(row => row.rfc === person.value);
    announce('e.firma guardada y activa para ' + person.value +
      (profile?.certExpires ? '. Vigente hasta el ' + localDateTime(profile.certExpires) : '') + '. Se reactivará sola tras cada reinicio.');
    soundCue('success');
  }, 'Probar y guardar');
}
function guardChoice(guard) {
  return new Promise(resolve => {
    const box = n('div');
    const titles = { agotado: 'El SAT ya no acepta este criterio tal cual', rescatado: 'Periodo ya rescatado por el portal',
      ultima: 'Este criterio ya se pidió: no se repite' };
    box.append(n('h3', titles[guard.state] || titles.ultima),
      n('p', guard.message),
      /* Fechas siempre en formato humano (UX-25): nada de ISO crudo. */
      n('p', 'Ventana del criterio: ' + stampLabel(guard.startAt) + ' a ' + stampLabel(guard.endAt) +
        '. Cerrando el periodo 1 segundo más tarde (' + stampLabel(guard.shiftedEndAt) + ') el criterio es nuevo ' +
        'ante el SAT y en la práctica no entra ningún CFDI extra.'));
    if (guard.state === 'agotado') box.append(n('p',
      'Lo quemado es solo esta combinación exacta (RFC, sentido, tipo y fechas con segundos): ni el RFC ni la ' +
      'e.firma están quemados. También puedes recuperar el periodo a mano desde el portal del SAT: es un canal ' +
      'aparte (hasta 2.000 XML al día) y PacoSAT prepara la lista exacta de folios. Y si solo necesitas ' +
      'reconciliar el histórico, el mismo periodo como Metadatos es otro criterio, con su propio cupo.'));
    if (guard.state === 'rescatado') box.append(n('p',
      'Los XML de este periodo ya entraron por la carpeta vigilada tras descargarlos del portal: están en el expediente.'));
    const row = n('div', undefined, 'actions');
    row.append(action('Cerrar 1 segundo más tarde y enviar', () => resolve('shift'), 'primary', 'sync'));
    if (guard.state === 'agotado' || guard.state === 'rescatado')
      row.append(action(guard.state === 'agotado' ? 'Preparar el rescate por el portal' : 'Ver el rescate', () => resolve('rescue')));
    row.append(action('No enviar', () => resolve('cancel')));
    box.append(row);
    $('fields').replaceChildren(box);
  });
}
/* Rescate 5002 asistido: el servidor prepara la lista exacta de folios
   pendientes del periodo quemado (de los metadatos guardados, sin los
   ya descargados) y las instrucciones paso a paso para bajarlos del
   portal del SAT. Al dejarlos en la carpeta vigilada, el criterio pasa
   a «rescatado» en el libro. Sin botón de guardado: es una guía. */
async function rescueDialog(source) {
  const plan = await satApi('rescue', { rfc: source.rfc, direction: source.direction, startAt: source.startAt, endAt: source.endAt });
  const box = n('div');
  box.append(n('p', 'Periodo quemado: ' + stampLabel(plan.startAt) + ' a ' + stampLabel(plan.endAt) + ' · ' +
      (plan.direction === 'received' ? 'Recibidos' : 'Emitidos') + ' · ' + plan.rfc),
    n('p', plan.folios.length ? 'Según los metadatos guardados faltan ' + plan.folios.length + ' folios por ' +
      'descargar: son los de esta lista (los que ya están en el expediente no aparecen).' :
      'Todavía no hay metadatos guardados de este periodo: descarga por el periodo completo y deja que la ' +
      'carpeta vigilada descarte sola los duplicados.'));
  if (plan.folios.length) {
    const list = n('ul', undefined, 'rescue-folios');
    for (const folio of plan.folios.slice(0, 200)) list.append(n('li',
      folio.uuid + ' · ' + (folio.issuedAt || '').slice(0, 19) + ' · ' + folio.emitter + ' → ' + folio.receiver +
      ' · ' + (folio.total ? '$' + folio.total : '—')));
    box.append(list);
    if (plan.folios.length > 200) box.append(n('p', '…y ' + (plan.folios.length - 200) + ' folios más en el mismo periodo.'));
  }
  const steps = n('ol', undefined, 'rescue-steps');
  for (const step of plan.instructions) steps.append(n('li', step));
  box.append(steps);
  /* El rescate sin salir de la pantalla (2.9.7 · C2): el mismo
     periodo del plan se baja ahora por el portal, con su
     progreso y su Cancelar en la propia hoja del rescate. */
  const progRescate297 = n('div');
  const bajarRescate297 = action('Bajarlos ahora por el portal', async () => {
    bajarRescate297.disabled = true;
    await portalLanzar297(progRescate297, { rfc: plan.rfc || source.rfc,
      period: { direction: plan.direction || source.direction,
        startAt: plan.startAt || source.startAt, endAt: plan.endAt || source.endAt },
      origen: 'rescate' }, (ok, state, runError) => {
        progRescate297.append(n('p', ok ? 'Hecho: los documentos bajaron por el portal.'
          : 'No se pudo bajar por el portal: ' + (runError ? runError.message : portalMotivo297(state)),
          ok ? 'ok-text' : 'error-text'));
      });
  }, 'primary', 'down');
  bajarRescate297.dataset.portalRescueBajar297 = '1';
  box.append(bajarRescate297, progRescate297);
  dialog('Rescate por el portal del SAT', [box]);
}
/* Hoja de descarga (1.13.1, pieza C2): el botón directo «Descargar
   CFDI» abre ESTA hoja — atajos de un toque, rango con calendario,
   sentido (incluido «ambos», que el diálogo viejo no ofrecía),
   resumen previo en una línea y resultado contado en el sitio
   (patrón E): solicitados, paquetes, CFDI nuevos y «ya estaban»
   sin duplicar. Si el SAT deja la solicitud en preparación —lo
   normal en su servicio—, la hoja lo dice y el paquete se importa
   solo cuando el SAT lo libera. La guardia 5002 actúa igual que
   en el diálogo clásico, con su elección en la propia hoja. */
function downloadSheet(rfc, preset = {}) {
  const person = people.find(row => row.id === rfc) || people.find(row => row.id === scope) || people[0];
  const chosenRfc = person?.id || rfc;
  const today = new Intl.DateTimeFormat('en-CA', { timeZone: 'America/Mexico_City', year: 'numeric', month: '2-digit', day: '2-digit' }).format();
  const form = n('form', undefined, 'dialog-form');
  form.append(n('h3', 'Descargar CFDI · ' + chosenRfc),
    n('p', 'PacoSAT pide el periodo al SAT con la e.firma de ' + (person?.name || chosenRfc) + '. El SAT suele tardar en preparar el paquete: cuando lo libera, se importa solo.', 'muted'));
  const start = input('date', { max: today, value: preset.start || today.slice(0, 8) + '01', required: true });
  const end = input('date', { max: today, value: preset.end || today, required: true });
  const direction = select([['both', 'Emitidos y recibidos'], ['received', 'Solo recibidos'], ['issued', 'Solo emitidos']], preset.direction || 'both');
  const summary = n('p', '', 'dl-summary');
  const status = n('div', '', 'dl-status');
  const refreshSummary = () => { summary.textContent = downloadSummaryText(person?.name || '', chosenRfc, direction.value, start.value, end.value); };
  /* Aviso de ventana ya pedida EN LA HOJA (2.9.5 · R4): el
     diálogo clásico avisa desde la 2.3.0 (pieza 7), pero esta
     hoja — la que Paco abre — nunca consultaba el plan: con
     la ventana de en vivo (Recibidos 2026-11-08→14, con su
     solicitud viva) solo decía «Se pedirá al SAT: …» y dejaba
     «Pedir y descargar» activo, sin aviso. La hoja consulta
     el plan al abrir y al cambiar la ventana: si consta
     pedida, el aviso vive en su cara y el envío queda
     CONDICIONADO — confirmar pide la variante (el mismo
     periodo cerrando 1 segundo más tarde), nunca el criterio
     exacto, que no se repite jamás. */
  const planAviso295 = n('p', '', 'plan-note plan-yapedida230');
  planAviso295.hidden = true;
  let planSeq295 = 0;
  let planShift295 = 0;
  const refreshPlan295 = async () => {
    const seq = ++planSeq295;
    planShift295 = 0;
    if (typeof satToken === 'undefined' || !satToken || typeof planYaPedidas230 !== 'function') { planAviso295.hidden = true; return; }
    const direcciones = direction.value === 'both' ? ['received', 'issued'] : [direction.value];
    try {
      const pedidas = [];
      for (const dir295 of direcciones) {
        const plan295 = await satApi('plan', { rfc: chosenRfc, direction: dir295, type: 'cfdi', start: start.value, end: end.value });
        pedidas.push(...planYaPedidas230(plan295));
      }
      if (seq !== planSeq295) return;
      if (pedidas.length) {
        planShift295 = 1;
        const fecha295 = typeof fmtFechaHora === 'function' ? fmtFechaHora(pedidas[0].at) : String(pedidas[0].at);
        planAviso295.textContent = 'Ojo: esta ventana ya se pidió el ' + fecha295 +
          ' y está en espera del SAT: no se repite. Si confirmas, se pedirá la variante — el mismo periodo cerrando 1 segundo más tarde —, no el criterio exacto.';
        planAviso295.hidden = false;
      } else planAviso295.hidden = true;
    } catch { if (seq === planSeq295) planAviso295.hidden = true; }
  };
  const chips = n('div', undefined, 'actions');
  for (const [kind, label] of [['mes', 'Este mes hasta hoy'], ['mes-pasado', 'Mes pasado completo'], ['anio', 'Año en curso'], ['7d', 'Últimos 7 días'], ['30d', 'Últimos 30 días']]) {
    const chip = action(label, () => {
      const range = downloadShortcutRange(kind, today);
      start.value = range.start; end.value = range.end; refreshSummary(); refreshPlan295();
    });
    chip.type = 'button';
    chips.append(chip);
  }
  for (const control of [start, end, direction]) control.addEventListener('change', () => { refreshSummary(); refreshPlan295(); });
  refreshSummary();
  refreshPlan295();
  /* Sin firmante activo, la hoja lo dice ANTES de lanzar
     (1.32.1, B3): el estado sale del perfil real del servidor
     (unlocked = hay conector capaz de firmar ahora), no de una
     foto vieja. El gesto es autorizar la e.firma, en su sitio. */
  const perfilHoja = (typeof satData !== 'undefined' && satData?.profiles || []).find(p => p.id === chosenRfc || p.rfc === chosenRfc);
  if (perfilHoja && !perfilHoja.unlocked && perfilHoja.accessMethod !== 'ciec') {
    const aviso = n('div', undefined, 'dl-sin-firmante');
    aviso.append(n('p', 'Este RFC no tiene firmante activo ahora mismo: su e.firma no está autorizada en el servidor, así que la descarga no puede firmar y ninguna solicitud llegaría al SAT.'),
      n('p', 'Gesto único: autoriza la e.firma de ' + chosenRfc + ' y vuelve a esta hoja.'));
    const irFirmas = n('button', 'Autorizar la e.firma', 'primary');
    irFirmas.type = 'button';
    irFirmas.onclick = () => { closeDialog(); showSatDownload(); };
    aviso.append(irFirmas);
    form.append(aviso);
  }
  const send = n('button', 'Pedir y descargar', 'primary'); send.type = 'submit';
  if (perfilHoja && !perfilHoja.unlocked && perfilHoja.accessMethod !== 'ciec') send.disabled = true;
  const cancel = n('button', 'Cerrar', 'soft'); cancel.type = 'button';
  cancel.onclick = () => closeDialog();
  const buttons = n('div', undefined, 'actions'); buttons.append(send, cancel);
  form.append(fieldWrap('Atajos de un toque', chips), fieldWrap('Desde', start), fieldWrap('Hasta', end),
    fieldWrap('Comprobantes', direction), summary, planAviso295, status, buttons);
  form.onsubmit = event => {
    event.preventDefault();
    /* Confirmación ANTES de despachar (2.0.1 · nº 5 + nº 21):
       el resumen de lo que se pedirá (RFC, ventana, tipo y
       sentido, con el texto de siempre de la hoja). «Cancelar»
       no envía nada: no se gasta ningún criterio del SAT.
       (2.9.12 · Precisión 1) La descarga masiva NO usa el
       acceso del portal — va por el servicio web —, así que
       esta confirmación ya no enseña el estado de ese acceso:
       era contexto equivocado y el 18 nov era además falso.
       Ese estado solo se enseña donde la ruta del portal se
       usa de verdad (confirmarDespacho201, en ui.part). */
    status.replaceChildren();
    /* El resumen (RFC, ventana, tipo y sentido) ya lo enseña
       la propia hoja en su línea de resumen, justo encima:
       aquí no se repite — la confirmación añade el aviso de
       ventana ya pedida, si lo hay, y los dos botones. */
    status.append(n('p', 'Confirma antes de pedir: si la ventana o el sentido no son los que querías, cancela y corrígelos — no se gastará ningún criterio.', 'strong-line'));
    /* Ventana ya pedida (2.9.5 · R4): la confirmación repite
       el aviso y su botón pide la variante — el criterio
       exacto no se reenvía desde esta hoja. */
    if (planShift295) status.append(n('p', planAviso295.textContent, 'plan-note plan-yapedida230'));
    const filaConf = n('div', undefined, 'actions');
    const confirmar = n('button', planShift295 ? 'Confirmar y pedir la variante' : 'Confirmar y pedir al SAT', 'primary');
    confirmar.type = 'button';
    confirmar.onclick = () => { status.replaceChildren(); despachar(); };
    const cancelarConf = n('button', 'Cancelar', 'soft');
    cancelarConf.type = 'button';
    cancelarConf.onclick = () => status.replaceChildren(
      n('p', 'Solicitud no enviada: la cancelaste en la confirmación. No se gastó ningún criterio.'));
    filaConf.append(confirmar, cancelarConf);
    status.append(filaConf);
  };
  const despachar = async () => {
    send.disabled = true; send.textContent = 'Pidiendo al SAT…';
    status.replaceChildren(n('p', 'Enviando la solicitud al SAT…', 'muted'));
    /* (2.9.13 · A1) La hoja tenía el mismo defecto que la
       tarjeta: enviaba direction:'both' y el servidor solo
       acepta un sentido por envío. «Emitidos y recibidos» son
       dos envíos, uno por sentido, cada uno con su guardia. */
    const direccionesHoja2913 = direction.value === 'both' ? ['received', 'issued'] : [direction.value];
    try {
      for (const dirHoja2913 of direccionesHoja2913) {
        const payload = { rfc: chosenRfc, direction: dirHoja2913, start: start.value, end: end.value, type: 'cfdi' };
        /* Ventana ya pedida (2.9.5 · R4): lo que sale es la
           variante desde la primera vuelta — el criterio exacto
           no se reenvía ni siquiera para que la guardia lo pare. */
        if (planShift295) payload.shiftEnd = planShift295;
        for (;;) {
          try { satData = await satApi('request', payload); break; }
          catch (error) {
            if (!error.guard) throw error;
            const choice = await guardChoice(error.guard);
            if (choice === 'cancel') { status.replaceChildren(n('p', 'Solicitud no enviada: ' + error.guard.message)); send.disabled = false; send.textContent = 'Pedir y descargar'; return; }
            if (choice === 'rescue') { closeDialog(); rescueDialog(error.guard); return; }
            payload.shiftEnd = (payload.shiftEnd || 0) + 1;
          }
        }
      }
      /* Resultado contado con lo que el propio servidor expone: las
         solicitudes creadas (jobs del periodo) y las importaciones
         de actividad de esos trabajos (nuevos y «ya estaban»). */
      const mine = (satData.jobs || []).filter(job => job.rfc === chosenRfc && job.periodStart === start.value && job.periodEnd === end.value);
      const jobIds = new Set(mine.map(job => String(job.id)));
      /* Las importaciones se cuentan en la tienda de actividad (la
         misma que alimenta la franja de actividad), re-leída tras
         la petición: cada paquete importado deja su entrada con
         los nuevos y los «ya estaban» contados por UUID. */
      const actsAll = await readStore('activity').catch(() => activity);
      const acts = (actsAll || []).filter(entry => String(entry.id || '').startsWith('sat:') &&
        jobIds.has(String(entry.id).split(':')[1]));
      const nuevos = acts.reduce((sum, entry) => sum + (entry.added || 0), 0);
      const yaEstaban = acts.reduce((sum, entry) => sum + (entry.duplicates || 0), 0);
      const lines = ['Solicitud enviada: ' + mine.length + ' petición(es) al SAT para este periodo.'];
      if (acts.length) lines.push('Paquetes recibidos: ' + acts.length + ' · CFDI nuevos importados: ' + nuevos +
        ' · ya estaban: ' + yaEstaban + ' (sin duplicar)');
      const pendientes = mine.filter(job => job.status === 'pending').length;
      if (pendientes) lines.push('El SAT dejó ' + pendientes + ' solicitud(es) en preparación — es su comportamiento normal. ' +
        'Cuando libere el paquete, PacoSAT lo importa solo: lo verás en Actividad y en «Qué meses tienes».');
      status.replaceChildren(...lines.map((line, indice240) => {
        const linea240 = n('p', line);
        if (indice240 === 0) linea240.dataset.estado = 'aldia';
        return linea240;
      }));
      send.textContent = 'Pedir otro periodo';
      send.disabled = false;
      fillSat();
      soundCue('success');
    } catch (error) {
      const spec = problemSpec('descarga', { error });
      status.replaceChildren(problemCard(spec));
      send.disabled = false; send.textContent = 'Pedir y descargar';
    }
  };
  showDialog(form);
}
/* ===== Aviso antes de quemar una petición (2.3.0 · pieza 7) =====
   El plan de descarga trae, por criterio, yaPedida: null o
   { at, requestId } cuando esa ventana YA se pidió al SAT.
   Repetirla gasta otra petición: la confirmación lo dice
   ANTES de enviar, en llano y con su fecha, visible sin
   desplegar nada. La lectura es defensiva: el aviso sale de
   donde el plan lo traiga (el plan entero o sus criterios). */
function planYaPedidas230(plan) {
  const salida = [];
  const recoger = x => { if (x && typeof x === 'object' && x.at) salida.push(x); };
  if (!plan || typeof plan !== 'object') return salida;
  recoger(plan.yaPedida);
  for (const lista of [plan.criterios, plan.criteria, plan.ventanas])
    if (Array.isArray(lista)) for (const criterio of lista) recoger(criterio?.yaPedida);
  return salida;
}
function planAvisoYaPedida230(plan) {
  const pedidas = planYaPedidas230(plan);
  if (!pedidas.length) return '';
  const fecha = typeof fmtFechaHora === 'function' ? fmtFechaHora(pedidas[0].at) : String(pedidas[0].at);
  if (pedidas.length === 1)
    return 'Ojo: esta ventana ya se pidió el ' + fecha + '; repetirla gasta otra petición al SAT.';
  return 'Ojo: ' + pedidas.length + ' de estas ventanas ya se pidieron (la primera, el ' + fecha +
    '); repetirlas gasta otra petición al SAT por cada una.';
}
function requestDialog(preset) {
  const person = selectPerson();
  const today = new Intl.DateTimeFormat('en-CA', { timeZone: 'America/Mexico_City', year: 'numeric', month: '2-digit', day: '2-digit' }).format();
  const start = input('date', { max: today, value: today.slice(0, 8) + '01', required: true });
  const end = input('date', { max: today, value: today, required: true });
  const direction = select([['received', 'Recibidos'], ['issued', 'Emitidos']], 'received');
  /* Preselección (UX-05): desde un hueco de Cobertura el diálogo nace
     con el RFC, el sentido y los extremos exactos del hueco. */
  if (preset) {
    if (preset.rfc) person.value = preset.rfc;
    if (preset.direction) direction.value = preset.direction;
    if (preset.start) start.value = preset.start;
    if (preset.end) end.value = preset.end;
  }
  const type = select([['cfdi', 'CFDI (XML completos)'], ['metadata', 'Solo el listado (los datos de cada factura, sin bajar los XML)']], 'cfdi');
  if (preset?.type) type.value = preset.type;
  /* Tanda 7B (25): sin preselección de hueco, la hoja abre con el
     último rango usado de ese RFC y sentido, editable como siempre. */
  if (!preset && typeof satToken !== 'undefined' && satToken) {
    const cargarRango200h = () => satApi('descarga-rango200h?rfc=' + encodeURIComponent(person.value) +
      '&direction=' + encodeURIComponent(direction.value)).then(d => {
      if (d?.rango?.desde) { start.value = d.rango.desde; if (d.rango.hasta) end.value = d.rango.hasta; refreshPlan(); }
    }).catch(() => {});
    person.addEventListener('change', cargarRango200h);
    direction.addEventListener('change', cargarRango200h);
    cargarRango200h();
  }
  /* Periodos frecuentes en un clic (1.6.10): sin teclear fechas. */
  const quick = n('div', undefined, 'actions');
  const fmt = date => date.toISOString().slice(0, 10);
  const setRange = (from, to) => { start.value = fmt(from); end.value = fmt(to); refreshPlan(); };
  const nowDate = new Date(today + 'T12:00:00');
  quick.append(
    action('Mes pasado', () => setRange(new Date(nowDate.getFullYear(), nowDate.getMonth() - 1, 1), new Date(nowDate.getFullYear(), nowDate.getMonth(), 0))),
    action('Este trimestre', () => setRange(new Date(nowDate.getFullYear(), Math.floor(nowDate.getMonth() / 3) * 3, 1), nowDate)),
    action('Este año', () => setRange(new Date(nowDate.getFullYear(), 0, 1), nowDate)),
    action('Últimos 30 días', () => setRange(new Date(nowDate.getTime() - 29 * 86400000), nowDate)));
  /* Planificador anti-5002: antes de gastar una solicitud, el servidor
     cruza el criterio exacto contra el libro y avisa aquí mismo. Si ya
     se pidió, la vía es la variante del cierre exacto (nunca el duplicado);
     si el rango CFDI es amplio y nuevo, propone explorar primero con
     Metadatos. Es una lectura: no envía nada por sí solo. */
  const planNote = n('p', 'Revisando el criterio en el libro…', 'plan-note');
  /* El aviso de ventana ya pedida (pieza 7): visible sin
     desplegar nada, encima de la nota del plan. */
  const planYaPedida = n('p', '', 'plan-note plan-yapedida230');
  planYaPedida.hidden = true;
  const metaFirst = action('Pedir este rango como Metadatos', () => { type.value = 'metadata'; refreshPlan(); });
  metaFirst.hidden = true;
  const planBox = n('div', undefined, 'plan-box');
  planBox.append(planYaPedida, planNote, metaFirst);
  let planSeq = 0;
  async function refreshPlan() {
    const seq = ++planSeq;
    try {
      const plan = await satApi('plan', { rfc: person.value, direction: direction.value, type: type.value, start: start.value, end: end.value });
      if (seq !== planSeq) return;
      planNote.textContent = plan.reason;
      const avisoYaPedida = planAvisoYaPedida230(plan);
      planYaPedida.textContent = avisoYaPedida;
      planYaPedida.hidden = !avisoYaPedida;
      metaFirst.hidden = plan.recommendation !== 'metadata-first';
    } catch {
      if (seq !== planSeq) return;
      planNote.textContent = 'El planificador no pudo revisar el libro; la guardia actuará al enviar, como siempre.';
      planYaPedida.hidden = true;
      metaFirst.hidden = true;
    }
  }
  for (const control of [person, direction, type, start, end]) control.addEventListener('change', refreshPlan);
  refreshPlan();
  dialog('Solicitar un periodo al SAT', [field('Contribuyente', person), field('Comprobantes', direction),
    field('Tipo de solicitud', type), field('Revisión previa', planBox), field('Periodo frecuente', quick),
    field('Fecha inicial', start), field('Fecha final', end)], async () => {
    const payload = { rfc: person.value, direction: direction.value, start: start.value, end: end.value, type: type.value };
    satApi('descarga-rango200h', { rfc: person.value, direction: direction.value, desde: start.value, hasta: end.value }).catch(() => {});
    /* Desde el Libro, «Pedir con el cierre exacto» nace ya con la variante. */
    if (preset?.shiftEnd) payload.shiftEnd = 1;
    for (;;) {
      try { satData = await satApi('request', payload); break; }
      catch (error) {
        if (!error.guard) throw error;
        const choice = await guardChoice(error.guard);
        if (choice === 'cancel') {
          $('dialog').close();
          announce('Solicitud no enviada. ' + error.guard.message, true);
          return;
        }
        if (choice === 'rescue') {
          $('dialog').close();
          rescueDialog(error.guard);
          return;
        }
        /* Cada vuelta suma un segundo al cierre: si esa variante
           también estaba usada, la siguiente guardia ofrece el
           segundo siguiente. Nunca se repite un criterio. */
        payload.shiftEnd = (payload.shiftEnd || 0) + 1;
      }
    }
    fillSat(); announce('Solicitud enviada. PacoSAT revisará cuándo libera el paquete el SAT.');
  }, 'Enviar solicitud');
}
function mailDialog() {
  const recipient = input('email', { required: true, value: satData.mail.recipient || '', maxLength: 200 });
  const from = input('email', { required: true, maxLength: 200 });
  const host = input('text', { required: true, maxLength: 253, placeholder: 'smtp.tu-proveedor.com' });
  const port = select([['465', '465 · TLS'], ['587', '587 · STARTTLS']], '587');
  const user = input('text', { autocomplete: 'off', maxLength: 200 });
  const password = input('password', { autocomplete: 'off', maxLength: 512 });
  dialog('Avisos por correo', [n('p', 'Usa los datos SMTP de tu proveedor. PacoSAT verifica la conexión antes de activar los avisos. Vuelve a configurarlos al reiniciar el servicio.'),
    field('Correo que recibe los avisos', recipient), field('Dirección del remitente', from), field('Servidor SMTP', host),
    field('Puerto', port), field('Usuario SMTP', user), field('Contraseña SMTP o de aplicación', password)], async () => {
    satData = await satApi('mail', { enabled: true, recipient: recipient.value.trim(), from: from.value.trim(),
      host: host.value.trim(), port: Number(port.value), user: user.value, password: password.value });
    password.value = '';
    fillSatMail(); announce('Avisos activados. Se enviarán al detectar nuevos CFDI recibidos.');
  }, 'Activar avisos');
}

async function pollSat() {
  if (!satToken || !ready || satPolling) return;
  satPolling = true;
  try {
    satData = await satApi('status');
    satError = '';
    flushOfflineQueue().catch(() => {});
    if (satData.settings) {
      /* La identidad del servidor manda sobre la copia local (1.6.6). */
      appSettings = { ...appSettings, ...satData.settings, logoData: appSettings.logoData };
      if (satData.settings.hasLogo && !appSettings.logoData) {
        try {
          const logo = await satApi('settings/logo');
          appSettings.logoData = 'data:' + logo.mime + ';base64,' + logo.data;
        } catch { /* sin logo disponible: se queda la marca de texto */ }
      }
      if (!satData.settings.hasLogo) appSettings.logoData = '';
      applySettings();
    }
    if (cloudStorage && satData.cloudRevision !== cloudRevision && !$('dialog').open && !importing &&
        !document.activeElement?.matches('input,select,textarea')) {
      await refresh(page === 'sat');
      cloudRevision = satData.cloudRevision;
    }
    const drain = async () => {
      for (const packet of satData.inbox) {
        if (importing || !people.some(person => person.id === packet.rfc)) continue;
        const archive = await satApi('packages/' + packet.id);
        if (importing || $('dialog').open) break;
        const result = await importBatch([new File([archive], 'SAT-' + packet.rfc + '-' + packet.id + '.zip')], packet.rfc, { quiet: true });
        if (result) { if (result.added) soundCue('notice'); await satApi('packages/' + packet.id, { imported: result.added }); }
      }
    };
    if (!$('dialog').open) {
      if (navigator.locks) await navigator.locks.request('pacosat-sat-import', { ifAvailable: true }, lock => lock ? drain() : undefined);
      else await drain();
    }
  } catch (error) {
    satError = error.message;
  } finally {
    satPolling = false;
    /* La pantalla de entrada del login propio se ofrece una vez
       por carga, con el primer pulso ya resuelto (1.26.0). */
    if (typeof maybeShowEntry === 'function') maybeShowEntry().catch(() => {});
    /* La insignia del Centro de Avisos se refresca con el mismo pulso
       del servidor (1.7.4): sin peticiones extra fuera de este ciclo. */
    refreshAvisos().catch(() => {});
    /* El distintivo del Buzón se refresca con el mismo pulso:
       status.buzonUnread llega en satData (1.23.0). */
    if (typeof paintBuzonBadge === 'function') paintBuzonBadge();
    if (page === 'sat' && !$('dialog').open && !document.activeElement?.closest('#sat-live')) fillSat();
    /* Ajustes › Correo (1.11.0): si la sección de correo está en
       pantalla, el mismo pulso la mantiene al día, sin ritmo nuevo. */
    const mailLive = $('sat-mail-live');
    if (mailLive && !$('dialog').open && !document.activeElement?.closest('#sat-mail-live')) fillSatMail(mailLive);
  }
}
/* El registro del pulso vive en monitor-ui.part (1.11.0): un solo
   temporizador de 30 s para todo el cliente. */
