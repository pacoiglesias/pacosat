async function descargaSigueMasiva2912(ctx) {
  const { st } = ctx;
  if (!st.running) return;
  const data = await satApi('status').catch(() => null);
  if (data) satData = data;
  const actsAll = await readStore('activity').catch(() => activity);
  let mine = (satData.jobs || []).filter(job => job.rfc === st.rfc && job.kind === 'cfdi' &&
    job.periodStart === st.jobStart && job.periodEnd === st.jobEnd);
  /* (2.9.14) Con envíos por restos, los trabajos de la corrida
     son los capturados por id al enviar: la ventana pedida ya
