let satToken = document.querySelector('meta[name="pacosat-token"]')?.content ||
  sessionStorage.getItem('pacosat-guest-token') || undefined;
const guestMode = Boolean(document.querySelector('meta[name="pacosat-guest"]')) ||
  Boolean(sessionStorage.getItem('pacosat-guest-token'));
let satData = { profiles: [], jobs: [], inbox: [], mail: {} };
let satError = '', satPolling = false, cloudRevision;
const satStatus = { pending: 'En espera del SAT', finished: 'Paquetes recibidos', expired: 'Vencida', failed: 'Falló', rejected: 'Rechazada' };
const directions = { received: 'Recibidos', issued: 'Emitidos', both: 'Emitidos y recibidos' };
const criteriaNotes = { disponible: 'Criterio sin usar', ultima: 'Criterio ya usado · no se repite', agotado: 'El SAT ya no acepta este criterio tal cual: hay que pedirlo con el cierre exacto', rescatado: 'Criterio rescatado por el portal' };

/* Errores del servidor en lenguaje claro (UX-20): cada mensaje críptico
   conocido se traduce a qué pasó y qué hacer. Los que ya vienen claros
   (la mayoría desde la 1.6.7) pasan tal cual. */
const FRIENDLY_ERRORS = [
  [/sesión local inválida/i, 'El servicio se reinició y la sesión caducó: pulsa «Actualizar estado» o recarga la página para reconectar.'],
  [/^host inválido/i, 'El servicio rechazó la dirección de acceso: entra por la dirección oficial de PacoSAT en tu NAS.'],
  [/^solicitud inválida/i, 'La solicitud no es válida tal como se envió: revisa el RFC y el periodo e inténtalo de nuevo.'],
  [/^cfdi de otro rfc/i, 'Ese CFDI es de otro RFC: cambia el contribuyente seleccionado o registra ese RFC en tu cartera.'],
  [/almacenamiento todavía no está disponible/i, 'El almacenamiento aún se está preparando: espera unos segundos y reintenta; si persiste, cierra las demás pestañas de PacoSAT.'],
  /* §6 (1.11.0): «perfil de PacoSAT» es lenguaje del sistema; en la
     superficie se dice qué falta y cómo se resuelve. */
  [/no es un perfil de PacoSAT|no tiene perfil en PacoSAT/i, 'Primero autoriza la e.firma de este RFC para que PacoSAT pueda trabajar con el SAT.']
];
function friendlyError(message) {
  for (const [pattern, text] of FRIENDLY_ERRORS) if (pattern.test(message)) return text;
  return message;
}
async function satApi(route, data) {
  const headers = { 'X-PacoSAT-Token': satToken };
  if (data !== undefined) headers['Content-Type'] = 'application/json';
  const response = await fetch('/api/' + route, {
    method: data === undefined ? 'GET' : 'POST', headers,
    body: data === undefined ? undefined : JSON.stringify(data)
  });
  if (!response.ok) {
    const failed = await response.json().catch(() => ({}));
    const error = new Error(friendlyError(failed.error || 'El servicio local no respondió.'));
    error.guard = failed.guard || null;
    throw error;
  }
  return response.headers.get('Content-Type') === 'application/zip' ? response.blob() : response.json();
}
/* Lecturas compartidas por pintado (1.24.0, punto 4a): Hoy pedía
   «reports/checklist» dos veces en el mismo pintado (el panel Hoy
   y el cierre guiado) y cada pantalla re-lanzaba lecturas que el
   pulso acababa de traer. satApiLectura comparte la promesa de
   las GET idénticas durante 5 s: mismo dato, una sola llamada
   por pintado. Solo lecturas — las mutaciones jamás se
   comparten — y un fallo no se cachea. */
const satLecturas = new Map();
function satApiLectura(route) {
  const hit = satLecturas.get(route);
  if (hit && Date.now() - hit.at < 5000) return hit.promise;
  const promise = satApi(route);
  satLecturas.set(route, { at: Date.now(), promise });
  promise.catch(() => { if (satLecturas.get(route)?.promise === promise) satLecturas.delete(route); });
  return promise;
}
/* Mutación con recomprobación (1.13.1, pieza H): si la respuesta de
   una acción de GUARDAR se pierde (red caída, 502 del proxy tras
   aplicar el cambio), la pantalla NUNCA declara el fallo sin
   recomprobar: re-lee el estado afectado y, si el cambio consta
   aplicado, devuelve { aplicadoTrasError: true } para que la
   pantalla enseñe el éxito real; solo si no consta, relanza el
   error. Es el criterio global para «Ya se pagó», marcar pagado
   y cualquier mutación equivalente. */
async function satApiGuardar(route, data, comprobar) {
  try { return await satApi(route, data); }
  catch (error) {
    let aplicado = false;
    try { aplicado = Boolean(await comprobar()); } catch { aplicado = false; }
    if (aplicado) return { aplicadoTrasError: true };
    throw error;
  }
}
/* satApiBlob(): como satApi(), pero la respuesta es siempre un Blob
   (el ZIP del paquete de defensa de Cumplimiento), sin pasar por el
   desvío JSON de satApi ni depender de su Content-Type exacto. Se
   llamaba desde la 1.6.18 y nunca se definió (hotfix 1.7.3). El error
   se traduce igual que en satApi(). */
async function satApiBlob(route, data) {
  const headers = { 'X-PacoSAT-Token': satToken };
  if (data !== undefined) headers['Content-Type'] = 'application/json';
  const response = await fetch('/api/' + route, {
    method: data === undefined ? 'GET' : 'POST', headers,
    body: data === undefined ? undefined : JSON.stringify(data)
  });
  if (!response.ok) {
    const failed = await response.json().catch(() => ({}));
    const error = new Error(friendlyError(failed.error || 'El servicio local no respondió.'));
    error.guard = failed.guard || null;
    throw error;
  }
  return response.blob();
}
/* Descarga de salidas para las partes principales (1.31.0):
   copia del patrón de salidaDescargar de outputs-ui.part, pero
   con nombre propio — outputs-ui es una parte DIFERIDA que no
   siempre está cargada cuando el Centro SAT o Declaraciones
   pintan, y estas pantallas necesitan bajar su PDF/Excel/ZIP
   sin depender de ella. El servidor manda el artefacto en
   base64 con su nombre y su tipo; aquí solo se materializa. */
async function descargarSalida1310(ruta, payload, boton) {
  const texto = boton ? boton.textContent : '';
  if (boton) { boton.disabled = true; boton.textContent = 'Preparando…'; }
  try {
    const data = await satApi(ruta, payload);
    download(new Blob([decode64(data.content)], { type: data.type || 'application/octet-stream' }), data.name);
    toast('Salida lista: ' + data.name, 'ok');
  } catch (error) { toast(error.message, 'error'); }
  finally { if (boton) { boton.disabled = false; boton.textContent = texto; } }
}
/* Cancelar un trámite desde su tarjeta (1.31.0, A3): cada
   descriptor que satTramiteEstados adjunta como `cancelar`
   sabe su vía — el servidor es quien detiene de verdad (en
   cola sale de la cola; en curso se cancela y su resultado se
   descarta al llegar). El toast cuenta el resultado tal cual:
   si el servidor dice que ya no estaba en curso (stopped /
   habia en falso), también se dice, no se finge una parada. */
async function cancelarTramite1310(desc) {
  if (!desc || !desc.tipo) return;
  try {
    let data = null;
    if (desc.tipo === 'satdoc') data = await satApi('satdocs/cancel', { rfc: desc.rfc, kind: desc.kind });
    else if (desc.tipo === 'decl') data = await satApi('declaraciones/cancel', { rfc: desc.rfc });
    else if (desc.tipo === 'trib') data = await satApi('tributario/cancel', { rfc: desc.rfc });
    else if (desc.tipo === 'ejecutor') data = await satApi('executor/cancel', { jobId: desc.jobId });
    else return;
    if (data?.message) { toast(data.message, 'ok'); return; }
    const yaNoEstaba = data?.stopped === false || data?.habia === false || data?.cancelled === false;
    if (yaNoEstaba) toast('Ese trabajo ya no estaba en curso: no quedaba nada que cancelar.', 'ok');
    else toast('Cancelación pedida: el trabajo se detiene en el servidor y lo parcial se descarta' +
      (data?.estado ? ' (' + data.estado + ')' : '') + '.', 'ok');
  } catch (error) { toast(error.message, 'error'); }
}

function localDateTime(value) {
  if (!value) return 'Al activar';
  return new Intl.DateTimeFormat('es-MX', { dateStyle: 'short', timeStyle: 'short' }).format(value);
}
function selectPerson() {
  check(people.length, 'Agrega un contribuyente antes de configurar el SAT.');
  return select(people.map(person => [person.id, person.name + ' · ' + person.id]), scope || people[0].id);
}
/* Interruptor general de descanso (1.6.10, compartido en 1.6.11): la
   misma pieza vive en el Centro SAT y en la pantalla «Hoy en PacoSAT».
   Un toque para descansar o reactivar; la fecha se pide solo si se
   elige «Descansar hasta…». */
function restSwitch() {
  const wrap = n('div', undefined, 'rest-switch');
  const active = Boolean(satData.rest?.active);
  const label = n('span', undefined, 'rest-label');
  label.append(n('strong', active ? '🌙 Descansando' : '🟢 Vigilando'),
    n('small', active ? 'Sin envíos al SAT ni avisos' + (satData.rest.until && satData.rest.until < Date.UTC(2099, 0, 1) ? ' hasta ' + localDateTime(satData.rest.until) : ' (sin fecha: se reactiva con este interruptor)') :
      'Descarga y avisos automáticos activos'));
  const toggle = n('button', active ? 'Reactivar' : 'Descansar', 'rest-toggle');
  toggle.type = 'button';
  toggle.setAttribute('aria-pressed', String(active));
  toggle.onclick = async () => {
    /* El clic se CONFIRMA contra el estado que devuelve el servidor
       (1.27.0): hasta la 1.26, si la petición caía (el servidor
       rechazaba el centinela «sin fecha»), el error se lo tragaba
       el await y el botón parecía muerto — el «Descansar no
       desactiva nada» de Paco. Ahora un fallo se anuncia en voz
       alta y el éxito solo se anuncia si el estado guardado dice
       que el descanso quedó como se pidió. */
    toggle.disabled = true;
    try {
      if (active) {
        satData = await satApi('rest', { until: 0 });
        if (satData.rest?.active) throw new Error('El servidor sigue mostrando el descanso activo.');
        announce('Descanso general terminado. PacoSAT se pone al día con la ventana pendiente.');
      } else {
        /* Un toque, sin formularios: descanso sin fecha (se reactiva
           con el mismo interruptor). La fecha se elige con «Descansar
           hasta…». */
        satData = await satApi('rest', { until: Date.UTC(2100, 0, 1) });
        if (!satData.rest?.active) throw new Error('El servidor no guardó el descanso.');
        announce('PacoSAT entra en descanso general: sin descargas ni avisos hasta que lo reactives.');
      }
    } catch (error) {
      announce('El descanso no se pudo cambiar: ' + (error?.message || error));
    }
    toggle.disabled = false;
    render();
  };
  wrap.append(label, toggle);
  if (!active) wrap.append(action('Descansar hasta…', restDialog, undefined, 'bell'));
  return wrap;
}
/* ===== Acciones directas de SAT (1.13.1) =====
   La pantalla SAT abre con el verbo, no con tarjetas que hay que
   abrir para encontrarlo: un selector compacto de RFC (por defecto
   el ámbito actual) y cuatro botones grandes que disparan su flujo
   al momento — Descargar CFDI abre el diálogo de periodo (o baja a
   la tarjeta CIEC si ese RFC entra con contraseña), Constancia y
   Opinión lanzan su descarga por el endpoint de siempre con su
   clase (kind) y enseñan el progreso en su propia línea, y
   Declaraciones abre su panel en Documentos. Debajo de cada verbo,
   su último resultado conocido, leído de los datos que la API ya
   expone (satdocs, declaraciones y las solicitudes de satData);
   sin dato, una línea corta de qué hace. Las tarjetas de «Qué
   quieres hacer» quedan debajo como consulta y navegación, y la
   configuración pesada sigue en la pestaña de descarga, sin
   competir con estos cuatro botones. */
let satQuickRfc = '', satQuickDocs = null;
function satQuickCuando(doc) {
  const fecha = new Date(doc.issuedAt);
  return fecha.toDateString() === new Date().toDateString()
    ? 'hoy ' + fecha.toLocaleTimeString('es-MX', { hour: '2-digit', minute: '2-digit' })
    : 'el ' + localDate(doc.issuedAt);
}
/* ===== Parrilla de trámites del Centro SAT (1.29.2) =====
   La orden de Paco (12 nov 20:25): «quiero que sea mas visual,
   el boton de recibir cfdi, complemento, constancia, declaracion,
   buzon, botones visibles que dentro del boton se pueda
   actualizar, ver los ultimos, etc, mas visual todo, mas facil,
   mas sencillo». Cada trámite es una TARJETA-BOTÓN grande con su
   semáforo verdadero, lo último recibido y sus dos acciones
   dentro: «Actualizar» corre la vía que le toca (con efecto
   visible en la propia tarjeta) y «Ver los últimos» lleva a la
   lista filtrada de su pantalla de siempre. Las pantallas
   profundas no cambian: la tarjeta es la puerta.
   El estado de cada tarjeta lo calcula satTramiteEstados SOLO
   con datos del servidor (el mismo executorEstado que alimenta
   Hoy y Declaraciones, satdocs, tributario, los trabajos de
   descarga y los CFDI registrados): ninguna tarjeta dice «al
   día» si su vía está rota, huérfana o sin probar — dice el
   porqué en una línea y de quién es el gesto. */
function satTramiteEstados(d) {
  const salida = {};
  /* Alta preparada sin credenciales (1.30.0): las seis tarjetas
     dicen la verdad — falta su e.firma y el gesto es darla. */
  if (d.profile?.pending) {
    const falta = { nivel: 'warn', frase: 'Falta su e.firma', ultimo: 'sin recibir todavía',
      accion: 'ir-descarga', accionTexto: 'Dar sus credenciales',
      porque: 'Este RFC consta como contribuyente, pero aún no tiene credenciales en PacoSAT: el gesto es dar su e.firma o su CIEC en la pestaña Descargar CFDI.' };
    return { cfdi: falta, complementos: falta, constancia: falta, declaraciones: falta, buzon: falta, opinion: falta };
  }
  const jobActivo = (kinds) => (d.cola || []).find(job => job.rfc === d.rfc &&
    kinds.includes(job.kind) && ['en-cola', 'reclamado', 'en-curso'].includes(job.estado));
  const esperaEquipo = (job) => ({ nivel: 'warn', frase: 'Esperando tu equipo',
    porque: 'En cola en tu equipo.', accion: 'actualizar' });
  /* --- Descargar CFDI y Complementos (vía de descarga de siempre) --- */
  const cfdiBase = (() => {
    if (!d.profile) return { nivel: 'dim', frase: 'Sin alta de descarga',
      porque: 'Este RFC no tiene alta de descarga en PacoSAT: se da de alta en la pestaña Descargar CFDI.', accion: 'ir-descarga' };
    if (d.profile.accessMethod === 'ciec') return { nivel: 'warn', frase: 'Falta tu gesto',
      porque: 'Este RFC entra con contraseña (CIEC): la descarga pide tu captcha en su tarjeta.', accion: 'ciec', accionTexto: 'Ir a la descarga' };
    if (d.lastJob?.status === 'pending') return { nivel: 'warn', frase: 'Trabajando',
      porque: 'Solicitud en curso: el SAT está preparando el paquete.', accion: 'descargar' };
    if (d.lastJob && d.lastJob.status !== 'finished') return { nivel: 'bad', frase: 'Con problema',
      porque: 'La última solicitud: ' + (satStatus[d.lastJob.status] || d.lastJob.status) + ' · ' + localDateTime(d.lastJob.created) + '.', accion: 'descargar' };
    if (d.lastJob?.status === 'finished' || d.ultimoCfdi) return { nivel: 'ok', frase: 'Al día', accion: 'descargar' };
    return { nivel: 'dim', frase: 'Sin descargar todavía', accion: 'descargar' };
  })();
  salida.cfdi = { ...cfdiBase,
    ultimo: d.ultimoCfdi ? 'último: ' + d.ultimoCfdi : (d.lastJob?.status === 'finished'
      ? 'último paquete · ' + localDateTime(d.lastJob.created) : 'sin recibir todavía') };
  /* Barra de progreso (1.31.2): la solicitud viva del SAT trae
     su fase y su inicio reales; sin total conocido, la barra
     va indeterminada — el SAT no dice cuántos paquetes faltan. */
  if (d.lastJob?.status === 'pending')
    salida.cfdi.progreso = { fase: 'El SAT está preparando el paquete', desde: d.lastJob.created || 0 };
  salida.complementos = (() => {
    if (!d.complementos?.total) return { nivel: 'dim', frase: 'Sin recibir todavía',
      ultimo: 'sin recibir todavía', accion: cfdiBase.accion, accionTexto: cfdiBase.accionTexto,
      tecnico: 'Los complementos llegan con la descarga de CFDI: no hay una bajada aparte para ellos.' };
    if (cfdiBase.nivel === 'bad') return { nivel: 'warn', frase: 'La última descarga falló',
      ultimo: 'último: Complemento · ' + localDate(d.complementos.ultima), accion: cfdiBase.accion, accionTexto: cfdiBase.accionTexto,
      porque: 'Los complementos llegan con la descarga de CFDI: reinténtala desde su tarjeta.' };
    return { nivel: 'ok', frase: 'Al día',
      ultimo: 'último: Complemento · ' + localDate(d.complementos.ultima), accion: cfdiBase.accion, accionTexto: cfdiBase.accionTexto,
      detalle: number.format(d.complementos.total) + ' complemento(s) registrados' };
  })();
  /* --- Constancia y Opinión (navegador del servidor) --- */
  for (const [clave, kind, etiqueta] of [['constancia', 'constancia', 'Constancia'], ['opinion', 'opinion', 'Opinión']]) {
    const perfil = d.docsProfile;
    const doc = perfil?.[kind];
    const progreso = perfil?.progress?.kind === kind ? perfil.progress : null;
    if (!perfil) salida[clave] = { nivel: 'dim', frase: 'Sin datos a mano',
      ultimo: 'sin recibir todavía', accion: 'pedir',
      porque: 'El servidor no respondió a la lectura de documentos: recarga la pantalla.' };
    else if (progreso?.running) salida[clave] = { nivel: 'warn', frase: 'Trabajando',
      ultimo: progreso.step || 'Descargando del portal…', accion: 'pedir',
      /* A3 (1.31.0): la descarga corre de verdad en el servidor,
         así que su tarjeta lleva con qué pararla allí. */
      cancelar: { tipo: 'satdoc', rfc: d.rfc, kind },
      /* Barra (1.31.2): la fase y el inicio son los de la
         corrida del servidor, no una estimación. */
      progreso: { fase: progreso.step || 'Descargando del portal…', desde: progreso.at || 0 } };
    else if (progreso && progreso.ok === false) salida[clave] = { nivel: 'bad', frase: 'Con problema',
      ultimo: doc ? 'último: ' + etiqueta + ' · ' + satQuickCuando(doc) : 'sin recibir todavía', accion: 'pedir',
      porque: progreso.step || 'La última descarga no llegó.' };
    else if (doc) salida[clave] = { nivel: doc.level === 'ok' ? 'ok' : doc.level === 'warn' ? 'warn' : 'bad',
      frase: doc.level === 'ok' ? 'Al día' : doc.level === 'warn' ? 'Conviene renovarla' : 'Muy vieja: renuevala',
      ultimo: 'último: ' + etiqueta + ' · ' + satQuickCuando(doc), accion: 'pedir',
      tecnico: doc.level === 'ok' ? '' : 'La recencia se vigila con la política de PacoSAT (verde menos de 60 días, ámbar hasta 90): el documento no caduca oficialmente.' };
    else salida[clave] = { nivel: 'warn', frase: 'Sin recibir todavía',
      ultimo: 'sin recibir todavía', accion: 'pedir',
      tecnico: 'Cómo llega: PacoSAT lo baja del portal con la e.firma guardada al pulsar «Actualizar».' };
  }
  /* --- Declaraciones y Buzón (la puerta del ejecutor) --- */
  const puerta = (job, datosOk) => {
    if (job) {
      if (d.ejecutor?.enLinea && (job.estado === 'reclamado' || job.estado === 'en-curso'))
        return { nivel: 'warn', frase: 'Trabajando', porque: 'Tu ejecutor lo está corriendo en tu equipo.', accion: 'actualizar' };
      return esperaEquipo(job);
    }
    if (!d.ejecutor?.emparejado) return { nivel: 'warn', frase: 'Esperando tu equipo',
      porque: 'Todavía no has emparejado ningún equipo: sin ejecutor, esta vía no se toca.',
      accion: 'emparejar', accionTexto: 'Emparejar tu equipo' };
    if (!d.ejecutor.enLinea) return { nivel: 'warn', frase: 'Tu equipo no responde',
      porque: 'Última señal ' + (d.ejecutor.ultimoVisto ? localDateTime(d.ejecutor.ultimoVisto) : 'sin registrar') +
        ': abre el ejecutor en tu equipo y esta vía vuelve sola.', accion: 'actualizar' };
    return datosOk;
  };
  const declJob = jobActivo(['declaraciones-recuperar', 'declaracion-folio']);
  salida.declaraciones = { ...puerta(declJob, { nivel: 'ok', frase: 'Al día', accion: 'actualizar' }),
    ultimo: d.ultimoAcuse ? 'último: ' + d.ultimoAcuse : 'sin recibir todavía' };
  if (!declJob && d.declProgreso?.running)
    salida.declaraciones = { nivel: 'warn', frase: 'Trabajando', ultimo: salida.declaraciones.ultimo,
      porque: d.declProgreso.step || 'Recuperando declaraciones…', accion: 'actualizar' };
  /* A5 · Último resultado verdadero (1.31.0): sin trabajo activo,
     un «Al día» heredado no puede tapar el último fallo REAL —
     primero el progreso persistido (ok === false) y, si no, el
     último trabajo terminado del ejecutor para este RFC: solo
     un 'fallido' cambia la tarjeta; un 'hecho' deja lo de
     siempre, porque el acuse ya manda en su línea de último. */
  if (!declJob && !d.declProgreso?.running) {
    if (d.declProgreso?.ok === false) {
      salida.declaraciones = { nivel: 'bad', frase: 'La última recuperación falló',
        ultimo: salida.declaraciones.ultimo, accion: 'actualizar',
        porque: d.declProgreso.step || 'La última recuperación no llegó.' };
    } else {
      const terminado = (d.cola || []).filter(job => job.rfc === d.rfc &&
        ['declaraciones-recuperar', 'declaracion-folio'].includes(job.kind) &&
        ['hecho', 'fallido'].includes(job.estado))
        .sort((a, b) => ((b.creado ?? b.created) || 0) - ((a.creado ?? a.created) || 0))[0];
      if (terminado?.estado === 'fallido') {
        const cuandoMs = typeof (terminado.creado ?? terminado.created) === 'number'
          ? (terminado.creado ?? terminado.created) : Date.parse(terminado.creado ?? terminado.created);
        salida.declaraciones = { nivel: 'bad', frase: 'La última recuperación falló',
          ultimo: salida.declaraciones.ultimo, accion: 'actualizar',
          porque: (terminado.error || 'La última recuperación no llegó.') +
            (Number.isFinite(cuandoMs) ? ' · ' + localDateTime(cuandoMs) : '') + '.' };
      }
    }
  }
  /* A3 (1.31.0): si Declaraciones está viva de verdad, su
     tarjeta lleva el descriptor de su Cancelar — el trabajo
     del ejecutor por su jobId y, si no, la corrida local por
     su RFC. */
  if (declJob) salida.declaraciones.cancelar = { tipo: 'ejecutor', jobId: declJob.id };
  else if (d.declProgreso?.running) salida.declaraciones.cancelar = { tipo: 'decl', rfc: d.rfc };
  /* Barra (1.31.2): trabajo vivo de Declaraciones — del
     ejecutor (su traza real manda la fase) o de la corrida del
     servidor (su paso y su inicio). */
  if (declJob) {
    const pasos = declJob.steps || [];
    salida.declaraciones.progreso = { fase: pasos[pasos.length - 1]?.paso ||
      (declJob.estado === 'en-cola' ? 'En cola: esperando a tu equipo' : 'Trabajando en tu equipo'),
      desde: declJob.creado || 0 };
  } else if (d.declProgreso?.running)
    salida.declaraciones.progreso = { fase: d.declProgreso.step || 'Recuperando declaraciones…', desde: d.declProgreso.at || 0 };
  const buzonJob = jobActivo(['buzon-listar']);
  const buzonOk = d.trib?.ultimaConsulta
    ? (d.trib.sinAbrir ? { nivel: 'warn', frase: number.format(d.trib.sinAbrir) + ' sin abrir', accion: 'actualizar',
        porque: 'Las notificaciones se listan sin abrir ninguna: abrirlas es tu gesto, en el portal oficial.' }
      : { nivel: 'ok', frase: 'Al día', accion: 'actualizar' })
    : { nivel: 'dim', frase: 'Sin consultar todavía', accion: 'actualizar' };
  salida.buzon = { ...puerta(buzonJob, buzonOk),
    ultimo: d.trib?.ultimaConsulta ? 'última consulta · ' + buzonCuando(d.trib.ultimaConsulta) : 'sin consultar todavía' };
  if (!buzonJob && d.ejecutor?.emparejado && !d.ejecutor.enLinea && d.trib?.ultimaConsulta)
    salida.buzon.porque = 'Tu equipo no está en línea ahora: la próxima consulta espera a que lo abras.';
  /* A5 · Buzón (1.31.0): sin trabajo activo, si la última
     corrida del diario terminó MAL y es posterior a la última
     consulta buena, la tarjeta lo dice — la fecha de la buena
     no convierte en «al día» una consulta que después falló. */
  if (!buzonJob) {
    const run0 = d.trib?.runs?.[0];
    const finMs = run0 ? (typeof run0.finished === 'number' ? run0.finished : Date.parse(run0.finished)) : NaN;
    const buenaMs = d.trib?.ultimaConsulta
      ? (typeof d.trib.ultimaConsulta === 'number' ? d.trib.ultimaConsulta : Date.parse(d.trib.ultimaConsulta)) : 0;
    if (run0 && !run0.ok && Number.isFinite(finMs) && finMs > (buenaMs || 0))
      salida.buzon = { ...salida.buzon, nivel: 'bad', frase: 'La última consulta falló',
        porque: run0.error || 'La última consulta no llegó.' };
  }
  /* A3 · Buzón (1.31.0): vivo por el ejecutor (su jobId) o por
     la corrida del tributario en el servidor (su RFC). */
  if (buzonJob) salida.buzon.cancelar = { tipo: 'ejecutor', jobId: buzonJob.id };
  else if (d.trib?.progreso?.running) salida.buzon.cancelar = { tipo: 'trib', rfc: d.rfc };
  /* Barra (1.31.2): trabajo vivo del Buzón, con la misma
     doctrina que Declaraciones. */
  if (buzonJob) {
    const pasos = buzonJob.steps || [];
    salida.buzon.progreso = { fase: pasos[pasos.length - 1]?.paso ||
      (buzonJob.estado === 'en-cola' ? 'En cola: esperando a tu equipo' : 'Trabajando en tu equipo'),
      desde: buzonJob.creado || 0 };
  } else if (d.trib?.progreso?.running)
    salida.buzon.progreso = { fase: d.trib.progreso.step || 'Consultando el buzón…', desde: d.trib.progreso.at || 0 };
  /* La puerta auto-probada (1.30.0): su veredicto, en el detalle
     de esta tarjeta; si nunca se probó, no se dice nada. */
  if (d.puerta?.probada)
    salida.buzon.detalle = 'Puerta probada el ' + localDateTime(d.puerta.probada) + ': ' +
      (d.puerta.ok ? 'abre — la e.firma entra sola cada semana' : 'NO abre — ' + (d.puerta.error || 'sin motivo registrado'));
  return salida;
}
