    : 'Elige el periodo y pulsa Descargar: PacoSAT lo pide al SAT y lo guarda en tu expediente.', 'muted'));
  const hoy = new Intl.DateTimeFormat('en-CA', { timeZone: 'America/Mexico_City', year: 'numeric', month: '2-digit', day: '2-digit' }).format();
  const start = input('date', { max: hoy, value: hoy.slice(0, 8) + '01', required: true });
  start.dataset.dl2912Start = '1';
