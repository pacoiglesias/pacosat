/* ===== Tarjeta protagonista de Descargar (2.9.12 · Piezas 2 y 3) =====
   La vara de Paco (18 nov 2026, con su captura de OneFacture:
   «simple, fácil, limpio»): la pantalla abre con UNA tarjeta —
   el RFC ya elegido (el del selector global), dos fechas
   tecleables, un control claro Emitidos/Recibidos y UN botón
   «Descargar» —. Al descargar, progreso VIVO por pasos con su
   palabra («Consultando al SAT» → «Descargando» → «Guardando»),
   los tres contadores (encontrados · descargados · guardados)
   y el tiempo corriendo; si el SAT tarda, la tarjeta lo dice
   en llano con su Cancelar visible; al terminar, una línea
   llana y el acceso a ver lo bajado en Facturas. Nada técnico
   en la vista principal.
   La vía sale del perfil real del RFC: con e.firma autorizada,
   la masiva de siempre (mismo plan, misma guardia, mismo
   criterio que la hoja); sin e.firma pero con CIEC, la vía
   CIEC de la casa (sat-ciec) con el captcha DENTRO de la
   tarjeta — la máquina lo prepara todo y la persona hace solo
   su gesto de seguridad, que no se guarda en ningún sitio —;
   sin ningún acceso, la tarjeta nombra el único gesto que
   falta y no lanza nada. Todo lo demás de la pantalla (guía,
   cola, historial, cobertura) sigue tras la tarjeta. */
let descargaPollMs2912 = 3000;
function descargaRfc2912() {
  const perfiles = (typeof satData !== 'undefined' && satData?.profiles) || [];
  if (scope && (people.some(p => p.id === scope) || perfiles.some(p => (p.rfc || p.id) === scope))) return scope;
  if (perfiles.length) return perfiles[0].rfc || perfiles[0].id;
  return people[0]?.id || '';
}
function descargaModo2912(rfc) {
  const perfil = ((typeof satData !== 'undefined' && satData?.profiles) || [])
    .find(p => (p.rfc || p.id) === rfc);
  if (!perfil) return { modo: 'falta-alta', perfil: null };
  if (perfil.accessMethod === 'ciec')
    return perfil.ciecStored ? { modo: 'ciec', perfil } : { modo: 'falta-ciec', perfil };
  if (perfil.unlocked) return { modo: 'masiva', perfil };
  if (perfil.efirmaStored) return { modo: 'falta-firma', perfil };
  return { modo: 'falta-alta', perfil };
}
function altaRfcDialog2912() {
  dialog('Dar de alta un RFC', [
    n('p', 'Elige cómo entra este RFC al SAT: con su e.firma (recomendado: la descarga va sola) o con su contraseña CIEC (la descarga pide tu captcha).'),
    action('Con e.firma', () => { document.querySelector('dialog')?.close(); efirmaDialog(); }, 'primary', 'key'),
    action('Con contraseña (CIEC)', () => { document.querySelector('dialog')?.close(); ciecDialog(); }, undefined, 'key')]);
}
function descargarCard2912() {
  const rfc = descargaRfc2912();
  const nombre = people.find(p => p.id === rfc)?.name || '';
  const { modo } = descargaModo2912(rfc);
  const card = panel('Descargar CFDI');
  card.dataset.dl2912 = 'card';
  const body = n('div', undefined, 'dl2912-body');
  card.append(body);
  const rfcLinea = n('p', '', 'dl2912-rfc');
  rfcLinea.dataset.dl2912Rfc = '1';
  rfcLinea.append(n('strong', rfc || 'Sin RFC'));
  if (nombre && nombre !== rfc) rfcLinea.append(n('span', ' · ' + nombre, 'muted'));
  body.append(rfcLinea);
  const st = { rfc, modo, direction: 'both', running: false, shift: 0,
    planConocido: false, terminalSeen: false, captchaSince: '', found: 0, downloaded: 0, saved: 0,
    pollTimer: null, clockTimer: null, startedAt: 0 };
  /* Sin acceso (o sin su gesto previo): la tarjeta ES el gesto
