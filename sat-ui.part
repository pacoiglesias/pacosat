  if (steps.some(t => t.includes('Guardando en tu expediente'))) ctx.fase.textContent = 'Guardando';
  else if (steps.some(t => t.includes('Descargando tus facturas'))) ctx.fase.textContent = 'Descargando';
  else if (progress.running) ctx.fase.textContent = 'Consultando al SAT';
