function descargaCoberturaDe2914(st, dir) {
  const cob = st.cobertura2914?.[dir];
  return cob && Array.isArray(cob.cubierto) && cob.cubierto.length ? cob : null;
}
function descargaRangoTexto2914(r) {
  const dia = iso => typeof fmtFechaCorta === 'function'
    ? fmtFechaCorta(Date.parse(String(iso) + 'T12:00:00')) : String(iso);
  return r.start === r.end ? 'el ' + dia(r.start)
    : 'del ' + dia(r.start) + ' al ' + dia(r.end);
}
function descargaCoberturaTexto2914(st, dir, pasado = false) {
  const cob = descargaCoberturaDe2914(st, dir);
  if (!cob) return '';
  const sentido = dir === 'received' ? 'Recibidos' : 'Emitidos';
  if (cob.completa) return sentido + ' ya están cubiertos.';
  return sentido + ': ya consta ' + (cob.cubierto || []).map(descargaRangoTexto2914).join(' y ') +
