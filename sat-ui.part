    }
    if (docsProfile?.config?.enabled) {
      const cadencia = 'el día ' + docsProfile.config.day + ' de cada mes';
      estados.constancia.proxima = cadencia;
      estados.opinion.proxima = cadencia;
    }
    if (trib?.proximaAuto) estados.buzon.proxima = localDateTime(trib.proximaAuto);
    if (decl?.proximaAuto) estados.declaraciones.proxima = localDateTime(decl.proximaAuto);
