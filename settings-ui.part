/* Ajustes de identidad (1.6.6): nombre de la instalación, logo, color de
   acento y nombre del remitente de los correos. En modo servidor se
   guardan vía API en el volumen de datos (sobreviven a reinicios y
   redespliegues y viajan en el respaldo completo); en modo local se
   guardan en este navegador. Nada de esto toca pacosat-secrets. */
const ACCENT_SWATCHES = { '': '#0e6b4f', azul: '#175c9e', teal: '#0f766e', violeta: '#6d28d9',
  burdeos: '#9f2436', ambar: '#9a5b00', rosa: '#b01854', grafito: '#3f5468' };
let pendingLogo; // undefined = sin cambios · '' = quitar · dataURL = logo nuevo
async function satApiDelete(route) {
  const response = await fetch('/api/' + route, { method: 'DELETE', headers: { 'X-PacoSAT-Token': satToken } });
  if (!response.ok) throw new Error((await response.json().catch(() => ({}))).error || 'El servicio local no respondió.');
  return response.json();
}
const stampText = iso => {
  const date = new Date(iso);
  return date.toLocaleDateString('es-MX', { timeZone: 'America/Mexico_City', day: 'numeric', month: 'long', year: 'numeric' }) +
    ' a las ' + date.toLocaleTimeString('es-MX', { timeZone: 'America/Mexico_City', hour: '2-digit', minute: '2-digit' });
};
function settingsScreen() {
  pendingLogo = undefined;
  const panels = [];
  const identity = panel('Identidad de la instalación');
  const body = n('div', undefined, 'portal');
  const nameInput = input('text', { maxlength: '60', placeholder: 'PacoSAT', autocomplete: 'off' });
  nameInput.value = appSettings.installName;
  nameInput.id = 'settings-name';
  const senderInput = input('text', { maxlength: '60', placeholder: 'Sin nombre: como hasta ahora', autocomplete: 'off' });
  senderInput.value = appSettings.senderName;
  senderInput.id = 'settings-sender';
  body.append(field('Nombre de la instalación', nameInput),
    n('p', 'Se muestra en la cabecera, en el reporte mensual imprimible y en el manifiesto del paquete mensual.'),
    field('Nombre del remitente de los correos', senderInput),
    n('p', 'Los avisos del sistema saldrán como «Nombre <correo configurado>». Sin nombre, los correos no cambian.'));
  const logoRow = n('div', undefined, 'actions');
  const preview = n('img', undefined, 'logo-preview');
  preview.alt = 'Logo de la instalación';
  if (appSettings.logoData) preview.src = appSettings.logoData; else preview.hidden = true;
  preview.id = 'settings-logo-preview';
  const fileInput = input('file', { accept: '.png,.jpg,.jpeg,.svg,image/png,image/jpeg,image/svg+xml' });
  fileInput.setAttribute('aria-label', 'Subir logo');
  fileInput.onchange = async () => {
    const file = fileInput.files[0];
    fileInput.value = '';
    if (!file) return;
    if (file.size > 200 * 1024) { announce('El logo debe pesar como máximo 200 KB.', true); return; }
    if (file.type === 'image/svg+xml' && /<script|javascript:|on\w+\s*=/i.test(await file.text())) {
      announce('Ese SVG no es seguro (scripts o controladores) y no se acepta.', true); return;
    }
    pendingLogo = await new Promise(resolve => { const reader = new FileReader(); reader.onload = () => resolve(reader.result); reader.readAsDataURL(file); });
    preview.src = pendingLogo;
    preview.hidden = false;
    announce('Logo listo: se aplicará al guardar los ajustes.');
  };
  const removeLogo = action('Quitar logo', () => {
    pendingLogo = '';
    preview.hidden = true;
    preview.removeAttribute('src');
    announce('El logo se quitará al guardar los ajustes.');
  });
  logoRow.append(preview, fileInput, removeLogo);
  body.append(field('Logo (opcional)', logoRow), n('p', 'PNG, JPG o SVG seguro, hasta 200 KB. Se guarda en el servidor y se sirve desde el propio origen; sin logo se usa la marca de texto.'));
  const swatches = n('div', undefined, 'swatches');
  swatches.setAttribute('role', 'group');
  swatches.setAttribute('aria-label', 'Color de acento');
  for (const value of Object.keys(ACCENT_SWATCHES)) {
    const swatch = n('button', undefined, 'swatch');
    swatch.type = 'button';
    swatch.dataset.accentOption = value;
    swatch.setAttribute('aria-pressed', String(appSettings.accent === value));
    swatch.title = value ? SETTING_ACCENT_LABELS[value] : 'Predeterminado (verde)';
    const dot = n('span', undefined, 'swatch-dot');
    dot.style.background = ACCENT_SWATCHES[value];
    swatch.append(dot, n('span', value ? SETTING_ACCENT_LABELS[value] : 'Predeterminado'));
    swatch.onclick = () => {
      for (const other of swatches.querySelectorAll('[data-accent-option]')) other.setAttribute('aria-pressed', 'false');
      swatch.setAttribute('aria-pressed', 'true');
      appSettings.accent = value;
      applySettings();
    };
    swatches.append(swatch);
  }
  body.append(field('Color de acento', swatches),
    n('p', 'Paleta cerrada del sistema de diseño: cada color cumple contraste AA en tema claro y oscuro. «Predeterminado» restaura el verde original. El botón «Guardar ajustes» de la cabecera guarda todo.'));
  identity.append(body);
  panels.push(identity);
  const about = panel('Acerca de PacoSAT');
  const aboutBody = n('div', undefined, 'portal');
  const facts = n('div', undefined, 'facts');
  const fact = (label, value) => { const row = n('div'); row.append(n('small', label), n('strong', value)); return row; };
  facts.append(fact('Versión', 'PacoSAT ' + PACOSAT_META.version),
    fact('Autor', 'Creado por Paco Iglesias'),
    fact('Creación del software', stampText(PACOSAT_META.created) + ' (primer commit del repositorio)'));
  if (satToken && satData.buildModified) facts.append(fact('Última modificación de esta copia', stampText(new Date(satData.buildModified).toISOString())));
  if (satToken && satData.serverStartedAt) facts.append(fact('Esta instancia se inició', stampText(new Date(satData.serverStartedAt).toISOString())));
  aboutBody.append(facts, n('p', satToken ?
    'Los ajustes de identidad viven en el servidor, en su volumen de datos junto al estado operativo: sobreviven a reinicios y redespliegues, viajan en el respaldo completo y se restauran con él. Nunca se mezclan con las credenciales de pacosat-secrets.' :
    'Sin servidor, los ajustes se guardan en este navegador. La fecha de inicio de la instancia solo existe en modo servidor y por eso no se muestra aquí.'));
  about.append(aboutBody);
  panels.push(about);
  /* Sonidos por evento (1.6.11): el interruptor general vive en la
     cabecera; aquí se elige qué eventos suenan. Se guarda al momento en
     este navegador, sin pasar por «Guardar ajustes». */
  const sounds = panel('Sonidos de la interfaz');
  const soundsBody = n('div', undefined, 'portal');
  soundsBody.append(n('p', 'Sonidos discretos al completar acciones. El botón de altavoz de la cabecera los apaga todos.'));
  const soundPrefs = (() => { try { return JSON.parse(prefGet('pacosat-sound-events') || '{}'); } catch { return {}; } })();
  for (const [kind, label] of [['success', 'Éxito (importación terminada, respaldo creado)'],
    ['notice', 'Avisos (novedades y confirmaciones)'], ['alert', 'Alertas (algo requiere tu atención)'],
    ['error', 'Errores (una acción falló)']]) {
    const toggle = input('checkbox');
    toggle.checked = soundPrefs[kind] !== false;
    toggle.onchange = () => {
      const prefs = (() => { try { return JSON.parse(prefGet('pacosat-sound-events') || '{}'); } catch { return {}; } })();
      prefs[kind] = toggle.checked;
      prefSet('pacosat-sound-events', JSON.stringify(prefs));
      if (toggle.checked) soundCue(kind);
    };
    soundsBody.append(field(label, toggle));
  }
  sounds.append(soundsBody);
  panels.push(sounds);
  /* Guardar también al pie (UX-17): el botón de la cabecera queda lejos
     al hacer scroll en esta pantalla. */
  const saveBar = n('div', undefined, 'actions');
  saveBar.append(action('Guardar ajustes', saveAppSettings, 'primary', 'check'));
  panels.push(saveBar);
  if (satToken && !guestMode) panels.push(guestPanel());
  if (satToken && !guestMode) { panels.push(paperlessPanel()); panels.push(pushPanel()); }
  return panels;
}
/* Puente a Paperless (1.25.0, AGREGAR 2): las constancias,
   opiniones y acuses que PacoSAT archiva se copian también a tu
   Paperless con sus etiquetas. La ACTIVACIÓN es tuya: la
   dirección de tu Paperless y su token de API se guardan en el
   servidor (el token nunca vuelve a enseñarse). Si Paperless
   falla al consumir un documento, queda en la cola con su error
   y se reintenta: el original de PacoSAT nunca se pierde. */
function paperlessPanel() {
  const panelEl = panel('Puente a Paperless', 'Copia en tu archivo documental (Paperless-ngx) de las constancias, opiniones y acuses que PacoSAT archiva, con etiquetas por RFC y tipo.');
  const body = n('div');
  panelEl.append(body);
  const draw = async () => {
    body.replaceChildren(n('p', 'Consultando el puente…', 'muted'));
    try {
      const estado = await satApi('paperless');
      body.replaceChildren();
      const enCola = (estado.cola?.pendiente || 0) + (estado.cola?.error || 0);
      const strip = n('div', undefined, 'traffic-strip');
      strip.append(statusPill(estado.enabled ? 'ok' : 'dim', estado.enabled ? 'Puente ACTIVADO' : 'Puente apagado'),
        statusPill(estado.tokenSet ? 'ok' : 'warn', estado.tokenSet ? 'Token guardado' : 'Sin token'),
        statusPill(enCola ? 'warn' : 'ok', number.format(enCola) + ' en cola'),
        statusPill('dim', number.format(estado.cola?.subido || 0) + ' copiados'));
      body.append(strip);
      if (estado.ultimoError) body.append(n('p', 'Último error de la cola: ' + estado.ultimoError, 'error-text'));
      const form = n('div', undefined, 'sat-form');
      const activo = input('checkbox', { checked: Boolean(estado.enabled) });
      const base = input('url', { value: estado.baseUrl || '', placeholder: 'http://192.168.68.126:8000', 'aria-label': 'Dirección de Paperless' });
      const token = input('password', { placeholder: estado.tokenSet ? 'Token guardado — escribe solo para cambiarlo' : 'Token de API de Paperless', autocomplete: 'new-password' });
      const activoLabel = n('label', undefined, 'switch-line');
      activoLabel.append(activo, n('span', 'Activar el puente'));
      const guardar = n('button', 'Guardar el puente', 'soft');
      guardar.onclick = async () => {
        try {
          await satApi('paperless/config', { enabled: activo.checked, baseUrl: base.value.trim(),
            token: token.value.trim() || undefined });
          toast('Puente a Paperless guardado.', 'ok'); draw();
        } catch (error) { toast(error.message, 'error'); }
      };
      form.append(activoLabel, fieldWrap('Dirección de tu Paperless', base), fieldWrap('Token de API', token), guardar);
      body.append(form);
      if (enCola) {
        const retry = n('button', 'Reintentar la cola ahora', 'soft');
        retry.onclick = async () => {
          try { const r = await satApi('paperless/retry', {}); toast('Cola procesada: ' + r.subidos + ' documento(s) copiado(s) en esta pasada.', 'ok'); draw(); }
          catch (error) { toast(error.message, 'error'); }
        };
        body.append(retry);
      }
      body.append(n('p', 'Nota honesta: la subida usa la API estándar de Paperless-ngx. Si tu Paperless tiene el consumo averiado, los documentos se quedan en la cola con el error a la vista hasta que lo repares — PacoSAT no finge haber copiado lo que no copió.', 'muted'));
    } catch (error) { body.replaceChildren(n('p', error.message, 'error-text')); }
  };
  draw();
  return panelEl;
}
/* Avisos push PWA (1.25.0, AGREGAR 9): suscripción de ESTE
   dispositivo a los avisos críticos (69-B definitivo, factura
   cobrada cancelada y demás «mal + alta»). El aviso que viaja
   es genérico — ningún dato fiscal sale en la notificación — y
   al tocarla se abre la app, donde sí está el detalle. */
function pushPanel() {
  const panelEl = panel('Avisos push en este dispositivo', 'Un aviso en la pantalla de bloqueo cuando nazca algo crítico. Sin datos fiscales en la notificación: al tocarla se abre PacoSAT.');
  const body = n('div');
  panelEl.append(body);
  const deB64 = texto => Uint8Array.from(atob(texto.replaceAll('-', '+').replaceAll('_', '/')),
    c => c.charCodeAt(0));
  const draw = async () => {
    body.replaceChildren();
    if (!('serviceWorker' in navigator) || !('PushManager' in window)) {
      body.append(n('p', 'Este navegador no admite avisos push. En el iPhone, instala PacoSAT en la pantalla de inicio (Compartir → Añadir a pantalla de inicio) y vuelve aquí.', 'empty'));
      return;
    }
    const registration = await navigator.serviceWorker.ready;
    const actual = await registration.pushManager.getSubscription();
    body.append(statusPill(actual ? 'ok' : 'dim', actual ? 'Push ACTIVADO en este dispositivo' : 'Push desactivado en este dispositivo'));
    const fila = n('div', undefined, 'sat-actions');
    if (!actual) {
      const activar = n('button', 'Activar avisos push', 'primary');
      activar.onclick = async () => {
        try {
          const clave = await satApi('push/vapid');
          const sub = await registration.pushManager.subscribe({ userVisibleOnly: true,
            applicationServerKey: deB64(clave.key) });
          const json = sub.toJSON();
          await satApi('push/subscribe', { endpoint: json.endpoint, keys: json.keys });
          toast('Avisos push activados en este dispositivo.', 'ok'); draw();
        } catch (error) { toast(error.message, 'error'); }
      };
      fila.append(activar);
    } else {
      const prueba = n('button', 'Enviar una prueba', 'soft');
      prueba.onclick = async () => {
        try { await satApi('push/test', {}); toast('Prueba enviada: mira la pantalla de bloqueo.', 'ok'); }
        catch (error) { toast(error.message, 'error'); }
      };
      const desactivar = n('button', 'Desactivar en este dispositivo', 'soft');
      desactivar.onclick = async () => {
        try {
          await satApi('push/unsubscribe', { endpoint: actual.endpoint });
          await actual.unsubscribe();
          toast('Avisos push desactivados en este dispositivo.', 'ok'); draw();
        } catch (error) { toast(error.message, 'error'); }
      };
      fila.append(prueba, desactivar);
    }
    body.append(fila);
  };
  draw().catch(error => body.replaceChildren(n('p', error.message, 'error-text')));
  return panelEl;
}
async function saveAppSettings() {
  const name = $('settings-name')?.value ?? appSettings.installName;
  const sender = $('settings-sender')?.value ?? appSettings.senderName;
  const accent = document.querySelector('[data-accent-option][aria-pressed="true"]')?.dataset.accentOption ?? appSettings.accent;
  if (satToken) {
    const result = await satApi('settings', { installName: name, senderName: sender, accent });
    appSettings = { ...appSettings, ...result.settings, logoData: appSettings.logoData };
    if (pendingLogo === '') {
      await satApiDelete('settings/logo');
      appSettings.logoData = '';
      appSettings.hasLogo = false;
    } else if (pendingLogo) {
      const mime = /data:(.*?);/.exec(pendingLogo)[1];
      await satApi('settings/logo', { mime, data: pendingLogo.split(',')[1] });
      appSettings.logoData = pendingLogo;
      appSettings.hasLogo = true;
    }
    pendingLogo = undefined;
    announce('Ajustes guardados en el servidor.');
  } else {
    appSettings = { ...appSettings, installName: name.trim().slice(0, 60), senderName: sender.trim().slice(0, 60), accent,
      logoData: pendingLogo === '' ? '' : (pendingLogo || appSettings.logoData) };
    appSettings.hasLogo = Boolean(appSettings.logoData);
    try {
      localStorage.setItem('pacosat-settings', JSON.stringify({ installName: appSettings.installName,
        senderName: appSettings.senderName, accent: appSettings.accent, logoData: appSettings.logoData }));
    } catch { /* almacenamiento lleno o bloqueado: la identidad vale para esta sesión */ }
    pendingLogo = undefined;
    announce('Ajustes guardados en este navegador.');
  }
  applySettings();
  render();
}
