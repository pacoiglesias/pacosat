/* Ajustes de identidad (1.6.6): nombre de la instalación, logo, color de
   acento y nombre del remitente de los correos. En modo servidor se
   guardan vía API en el volumen de datos (sobreviven a reinicios y
   redespliegues y viajan en el respaldo completo); en modo local se
   guardan en este navegador. Nada de esto toca la carpeta de secretos del servidor. */
const ACCENT_SWATCHES = { '': '#175c9e', verde: '#0e6b4f', azul: '#175c9e', teal: '#0f766e', violeta: '#6d28d9',
  burdeos: '#9f2436', ambar: '#9a5b00', rosa: '#b01854', grafito: '#3f5468' };
let pendingLogo; // undefined = sin cambios · '' = quitar · dataURL = logo nuevo
async function satApiDelete(route) {
  const response = await fetch('/api/' + route, { method: 'DELETE', headers: { 'X-PacoSAT-Token': satToken } });
  if (!response.ok) throw new Error((await response.json().catch(() => ({}))).error || 'El servicio local no respondió.');
  return response.json();
}
const stampText = iso => {
  const date = new Date(iso);
  return date.toLocaleDateString('es-MX', { timeZone: 'America/Mexico_City', day: 'numeric', month: 'long', year: 'numeric' }) +
    ' a las ' + localTime(date.getTime());
};
function settingsScreen() {
  pendingLogo = undefined;
  const panels = [];
  const identity = panel('Identidad de la instalación');
  const body = n('div', undefined, 'portal');
  const nameInput = input('text', { maxlength: '60', placeholder: 'PacoSAT', autocomplete: 'off' });
  nameInput.value = appSettings.installName;
  nameInput.id = 'settings-name';
  const senderInput = input('text', { maxlength: '60', placeholder: 'Sin nombre: como hasta ahora', autocomplete: 'off' });
  senderInput.value = appSettings.senderName;
  senderInput.id = 'settings-sender';
  body.append(field('Nombre de la instalación', nameInput),
    n('p', 'Se muestra en la cabecera, en el reporte mensual imprimible y en el manifiesto del paquete mensual.'),
    field('Nombre del remitente de los correos', senderInput),
    n('p', 'Los avisos del sistema saldrán como «Nombre <correo configurado>». Sin nombre, los correos no cambian.'));
  const logoRow = n('div', undefined, 'actions');
  const preview = n('img', undefined, 'logo-preview');
  preview.alt = 'Logo de la instalación';
  if (appSettings.logoData) preview.src = appSettings.logoData; else preview.hidden = true;
  preview.id = 'settings-logo-preview';
  const fileInput = input('file', { accept: '.png,.jpg,.jpeg,.svg,image/png,image/jpeg,image/svg+xml' });
  fileInput.setAttribute('aria-label', 'Subir logo');
  fileInput.onchange = async () => {
    const file = fileInput.files[0];
    fileInput.value = '';
    if (!file) return;
    if (file.size > 200 * 1024) { announce('El logo debe pesar como máximo 200 KB.', true); return; }
    if (file.type === 'image/svg+xml' && /<script|javascript:|on\w+\s*=/i.test(await file.text())) {
      announce('Ese SVG no es seguro (scripts o controladores) y no se acepta.', true); return;
    }
    pendingLogo = await new Promise(resolve => { const reader = new FileReader(); reader.onload = () => resolve(reader.result); reader.readAsDataURL(file); });
    preview.src = pendingLogo;
    preview.hidden = false;
    announce('Logo listo: se aplicará al guardar los ajustes.');
  };
  const removeLogo = action('Quitar logo', () => {
    pendingLogo = '';
    preview.hidden = true;
    preview.removeAttribute('src');
    announce('El logo se quitará al guardar los ajustes.');
  });
  logoRow.append(preview, fileInput, removeLogo);
  body.append(field('Logo (opcional)', logoRow), n('p', 'PNG, JPG o SVG seguro, hasta 200 KB. Se guarda en el servidor y se sirve desde el propio origen; sin logo se usa la marca de texto.'));
  const swatches = n('div', undefined, 'swatches');
  swatches.setAttribute('role', 'group');
  swatches.setAttribute('aria-label', 'Color de acento');
  for (const value of Object.keys(ACCENT_SWATCHES)) {
    const swatch = n('button', undefined, 'swatch');
    swatch.type = 'button';
    swatch.dataset.accentOption = value;
    swatch.setAttribute('aria-pressed', String(appSettings.accent === value));
    swatch.title = value ? SETTING_ACCENT_LABELS[value] : 'Predeterminado (azul)';
    const dot = n('span', undefined, 'swatch-dot');
    dot.style.background = ACCENT_SWATCHES[value];
    swatch.append(dot, n('span', value ? SETTING_ACCENT_LABELS[value] : 'Predeterminado'));
    swatch.onclick = () => {
      for (const other of swatches.querySelectorAll('[data-accent-option]')) other.setAttribute('aria-pressed', 'false');
      swatch.setAttribute('aria-pressed', 'true');
      appSettings.accent = value;
      applySettings();
    };
    swatches.append(swatch);
  }
  body.append(field('Color de acento', swatches),
    n('p', 'Paleta cerrada del sistema de diseño: cada color cumple contraste AA en tema claro y oscuro. «Predeterminado» restaura el azul de la casa. El botón «Guardar ajustes» de la cabecera guarda todo.'));
  identity.append(body);
  panels.push(identity);
  const about = panel('Acerca de PacoSAT');
  const aboutBody = n('div', undefined, 'portal');
  const facts = n('div', undefined, 'facts');
  const fact = (label, value) => { const row = n('div'); row.append(n('small', label), n('strong', value)); return row; };
  facts.append(fact('Versión', 'PacoSAT ' + PACOSAT_META.version),
    fact('Autor', 'Creado por Paco Iglesias'),
    fact('Creación del software', stampText(PACOSAT_META.created) + ' (primer commit del repositorio)'));
  if (satToken && satData.buildModified) facts.append(fact('Última modificación de esta copia', stampText(new Date(satData.buildModified).toISOString())));
  if (satToken && satData.serverStartedAt) facts.append(fact('Esta instancia se inició', stampText(new Date(satData.serverStartedAt).toISOString())));
  aboutBody.append(facts, n('p', satToken ?
    'Los ajustes de identidad viven en el servidor, en su volumen de datos junto al estado operativo: sobreviven a reinicios y redespliegues, viajan en el respaldo completo y se restauran con él. Nunca se mezclan con las credenciales guardadas en la carpeta de secretos del servidor.' :
    'Sin servidor, los ajustes se guardan en este navegador. La fecha de inicio de la instancia solo existe en modo servidor y por eso no se muestra aquí.'));
  about.append(aboutBody);
  panels.push(about);
  /* Sonidos por evento (1.6.11): aquí se elige qué eventos
     suenan. (2.8.0 · diseño 27) El interruptor GENERAL también
     vive aquí desde esta ronda: salió de la cabecera — un
     ajuste de una vez al año no ocupa el sitio más caro del
     sistema — y este panel es su casa entera. Se guarda al
     momento en este navegador, sin pasar por «Guardar ajustes». */
  const sounds = panel('Sonidos de la interfaz');
  const soundsBody = n('div', undefined, 'portal');
  soundsBody.append(n('p', 'Sonidos discretos al completar acciones. El interruptor general los apaga todos; debajo eliges qué eventos suenan.'));
  {
    const master280 = input('checkbox');
    master280.id = 'sound-toggle';
    master280.checked = typeof soundOn !== 'undefined' ? soundOn : true;
    master280.onchange = () => {
      soundOn = master280.checked;
      prefSet('pacosat-sound', soundOn ? 'on' : 'off');
      if (soundOn) soundCue('notice');
    };
    soundsBody.append(field('Sonidos de la interfaz (todos)', master280));
  }
  const soundPrefs = (() => { try { return JSON.parse(prefGet('pacosat-sound-events') || '{}'); } catch { return {}; } })();
  for (const [kind, label] of [['success', 'Éxito (importación terminada, respaldo creado)'],
    ['notice', 'Avisos (novedades y confirmaciones)'], ['alert', 'Alertas (algo requiere tu atención)'],
    ['error', 'Errores (una acción falló)']]) {
    const toggle = input('checkbox');
    toggle.checked = soundPrefs[kind] !== false;
    toggle.onchange = () => {
      const prefs = (() => { try { return JSON.parse(prefGet('pacosat-sound-events') || '{}'); } catch { return {}; } })();
      prefs[kind] = toggle.checked;
      prefSet('pacosat-sound-events', JSON.stringify(prefs));
      if (toggle.checked) soundCue(kind);
    };
    soundsBody.append(field(label, toggle));
  }
  sounds.append(soundsBody);
  panels.push(sounds);
  /* Lo que PacoSAT hace solo (2.4.0 · WC4a): los ajustes nuevos
     de la ronda que el servidor ya sirve en status.settings y
     acepta por el POST /api/settings de siempre. Cada control
     se guarda AL CAMBIARLO, con su confirmación discreta en el
     propio panel; los valores pintados son los servidos, nunca
     escritos a mano. Solo en modo servidor: sin servidor no hay
     ajustes que servir ni que guardar. */
  if (satToken && !guestMode) panels.push(automaticosPanel240());
  /* Mapeo de agrupadoras del SAT (2.4.0 · WServ2, ítem 13): su
     editor vive aquí, en Ajustes — las pólizas se piden en
     Salidas, pero el mapeo es configuración de la instalación,
     como los demás ajustes que el servidor guarda. */
  if (satToken && !guestMode) panels.push(agrupadorasPanel240());
  /* Guardar también al pie (UX-17): el botón de la cabecera queda lejos
     al hacer scroll en esta pantalla. */
  const saveBar = n('div', undefined, 'actions');
  saveBar.append(action('Guardar ajustes', saveAppSettings, 'primary', 'check'));
  panels.push(saveBar);
  if (satToken && !guestMode) panels.push(guestPanel());
  if (satToken && !guestMode && !(typeof sesionNombrada298 === 'function' && sesionNombrada298())) panels.push(usersPanel298());
  if (satToken && !guestMode) { panels.push(paperlessPanel()); panels.push(pushPanel()); }
  /* Comercial apagado (2.3.0 · pieza 20): el panel comercial
     SOLO existe si /api/status dice comercial: true en ESTA
     instalación. Con false (lo normal) no se pinta ni el
     panel ni texto alguno: ni rastro en la interfaz. */
  if (typeof satData !== 'undefined' && satData?.comercial === true) panels.push(comercialPanel230());
  return panels;
}
/* Panel «Lo que PacoSAT hace solo» (2.4.0 · WC4a): pinta los
   ajustes automáticos servidos en status.settings —
   historico240 {enabled}, satdocsProgramadas240 {enabled},
   resumenSemanal240 {enabled} (trae su propia llave servida:
   se pinta como los demás) y toleranciaComisionCentavos240
   (un número en centavos que aquí se enseña y se edita en
   PESOS) — y los guarda al cambiarlos por el POST /api/settings
   de la pantalla, cada uno con su confirmación discreta. En
   pantalla solo van los nombres llanos: ninguna clave interna. */
function automaticosPanel240() {
  const panelEl = panel('Lo que PacoSAT hace solo',
    'Los trabajos automáticos de esta instalación. Cada interruptor se guarda al cambiarlo: no hace falta el botón «Guardar ajustes».');
  const body = n('div', undefined, 'portal');
  panelEl.append(body);
  const servidos = (typeof satData !== 'undefined' && satData && satData.settings) || {};
  const nota = n('p', '', 'muted ajustes-auto-nota240');
  const guardar = async (payload, textoOk) => {
    try {
      const result = await satApi('settings', payload);
      if (result && result.settings) {
        if (typeof satData !== 'undefined' && satData) satData.settings = result.settings;
        appSettings = { ...appSettings, ...result.settings, logoData: appSettings.logoData };
      }
      nota.dataset.estado = 'aldia';
      nota.textContent = textoOk;
    } catch (error) {
      nota.dataset.estado = 'error';
      nota.textContent = 'No se guardó: ' + error.message;
    }
  };
  const interruptor = (clave, etiqueta, explicacion, encendido, payloadDe, textoDe) => {
    const toggle = input('checkbox');
    toggle.checked = Boolean(encendido);
    toggle.dataset.ajuste240 = clave;
    toggle.onchange = () => guardar(payloadDe(toggle.checked),
      'Guardado: ' + textoDe(toggle.checked) + '.');
    body.append(field(etiqueta, toggle), n('p', explicacion, 'muted'));
  };
  interruptor('historico', 'Modo histórico de huecos',
    'De madrugada, una solicitud por hora, solo si faltan meses por descargar: PacoSAT tapa sola los huecos de tus descargas sin gastar solicitudes del SAT de más.',
    servidos.historico240?.enabled === true,
    on => ({ historico240: { enabled: on } }),
    on => on ? 'el modo histórico quedó encendido' : 'el modo histórico quedó apagado');
  interruptor('satdocs', 'Constancia y Opinión automáticas',
    'Se bajan solas cada mes; solo avisa si cambia el sentido o la fecha.',
    servidos.satdocsProgramadas240?.enabled !== false,
    on => ({ satdocsProgramadas240: { enabled: on } }),
    on => on ? 'la bajada automática de Constancia y Opinión quedó encendida' :
      'la bajada automática de Constancia y Opinión quedó apagada');
  interruptor('semanal', 'Resumen semanal por correo',
    'Cada lunes te llega un correo con lo cobrado, lo que vence y lo que falta, RFC por RFC. Si no hay nada que decir, no se manda.',
    servidos.resumenSemanal240?.enabled !== false,
    on => ({ resumenSemanal240: { enabled: on } }),
    on => on ? 'el resumen semanal quedó encendido' : 'el resumen semanal quedó apagado');
  /* La tolerancia viaja en centavos; Paco la ve y la toca en
     pesos. 0 la apaga. Se guarda al cambiar el campo. */
  const centavosServidos = Number(servidos.toleranciaComisionCentavos240);
  const tolInput = input('number', { min: '0', step: '0.01', 'aria-label': 'Tolerancia de comisión, en pesos' });
  tolInput.value = Number.isFinite(centavosServidos) ? String(centavosServidos / 100) : '0';
  tolInput.dataset.ajuste240 = 'tolerancia';
  tolInput.style.maxWidth = '140px';
  tolInput.onchange = () => {
    const pesos = Number(tolInput.value);
    if (!Number.isFinite(pesos) || pesos < 0) {
      nota.dataset.estado = 'error';
      nota.textContent = 'La tolerancia tiene que ser un importe en pesos, 0 o más.';
      return;
    }
    guardar({ toleranciaComisionCentavos240: Math.round(pesos * 100) },
      'Guardado: la tolerancia de comisión quedó en $' + pesos.toFixed(2) + '.');
  };
  body.append(field('Tolerancia de comisión al conciliar (pesos)', tolInput),
    n('p', 'Al conciliar, una diferencia hasta esta cantidad se propone como comisión bancaria. Con 0 queda apagada.', 'muted'));
  body.append(nota);
  return panelEl;
}
/* Panel comercial (2.3.0 · pieza 20): solo nace con
   status.comercial === true. Enseña el estado de licencia
   que devuelva GET /api/comercial/estado, en llano y solo
   con los campos que el servidor dé: sin campos conocidos,
   una línea sobria sin inventar licencias ni fechas. */
function comercialPanel230() {
  const panelEl = panel('Licencia comercial', 'El estado de la licencia de esta instalación de PacoSAT.');
  const body = n('div');
  panelEl.append(body);
  body.append(n('p', 'Leyendo el estado de la licencia…', 'muted'));
  satApi('comercial/estado').then(data => {
    if (!body.isConnected) return;
    body.replaceChildren();
    const texto = [data?.texto, data?.detalle, data?.estado, data?.licencia?.estado]
      .find(v => typeof v === 'string' && v.trim());
    body.append(n('p', texto || 'Panel comercial activo en esta instalación.'));
    if (typeof data?.licencia?.titular === 'string' && data.licencia.titular)
      body.append(n('p', 'Titular: ' + data.licencia.titular, 'muted'));
    if (typeof data?.licencia?.vence === 'string' && data.licencia.vence)
      body.append(n('p', 'Vigencia hasta: ' + data.licencia.vence, 'muted'));
  }).catch(error => {
    if (body.isConnected) body.replaceChildren(n('p', 'No se pudo leer el estado de la licencia: ' + error.message, 'error-text'));
  });
  return panelEl;
}
/* Puente a Paperless (1.25.0, AGREGAR 2): las constancias,
   opiniones y acuses que PacoSAT archiva se copian también a tu
   Paperless con sus etiquetas. La ACTIVACIÓN es tuya: la
   dirección de tu Paperless y su token de API se guardan en el
   servidor (el token nunca vuelve a enseñarse). Si Paperless
   falla al consumir un documento, queda en la cola con su error
   y se reintenta: el original de PacoSAT nunca se pierde. */
function paperlessPanel() {
  const panelEl = panel('Puente a Paperless', 'Copia en tu archivo documental (Paperless-ngx) de las constancias, opiniones y acuses que PacoSAT archiva, con etiquetas por RFC y tipo.');
  const body = n('div');
  panelEl.append(body);
  /* El resultado de la última prueba sobrevive al repintado
     del panel (pieza 17): guardar y repintar no lo borra. */
  let pruebaGuardada230 = '';
  const draw = async () => {
    body.replaceChildren(n('p', 'Consultando el puente…', 'muted'));
    try {
      const estado = await satApi('paperless');
      body.replaceChildren();
      const enCola = (estado.cola?.pendiente || 0) + (estado.cola?.error || 0);
      const strip = n('div', undefined, 'traffic-strip');
      strip.append(statusPill(estado.enabled ? 'ok' : 'dim', estado.enabled ? 'Puente ACTIVADO' : 'Puente apagado'),
        statusPill(estado.tokenSet ? 'ok' : 'warn', estado.tokenSet ? 'Token guardado' : 'Sin token'),
        statusPill(enCola ? 'warn' : 'ok', number.format(enCola) + ' en cola'),
        statusPill('dim', number.format(estado.cola?.subido || 0) + ' copiados'));
      body.append(strip);
      if (estado.ultimoError) body.append(n('p', 'Último error de la cola: ' + estado.ultimoError, 'error-text'));
      const form = n('div', undefined, 'sat-form');
      const activo = input('checkbox', { checked: Boolean(estado.enabled) });
      const base = input('url', { value: estado.baseUrl || '', placeholder: 'http://tu-paperless:8000', 'aria-label': 'Dirección de Paperless' });
      const token = input('password', { placeholder: estado.tokenSet ? 'Token guardado — escribe solo para cambiarlo' : 'Token de API de Paperless', autocomplete: 'new-password' });
      const activoLabel = n('label', undefined, 'switch-line');
      activoLabel.append(activo, n('span', 'Activar el puente'));
      /* Probar la conexión a un toque (2.3.0 · pieza 17): el
         resultado queda escrito EN el panel, no solo en un
         aviso que se va; y al guardar con el puente activo la
         prueba corre en el acto — activar y saber que funciona
         en el mismo gesto. */
      const pruebaTexto = n('p', pruebaGuardada230, 'muted paperless-prueba230');
      const probar = async () => {
        pruebaTexto.textContent = 'Probando la conexión con tu Paperless…';
        try {
          const r = await satApi('paperless/probar', {});
          pruebaGuardada230 = r?.texto || (r?.ok ? 'Paperless responde.' : 'Paperless no respondió.');
          pruebaTexto.dataset.estado = r?.ok ? 'aldia' : 'error';
          pruebaTexto.textContent = pruebaGuardada230;
          return Boolean(r?.ok);
        } catch (error) {
          pruebaGuardada230 = error.message;
          pruebaTexto.dataset.estado = 'error';
          pruebaTexto.textContent = pruebaGuardada230;
          return false;
        }
      };
      const guardar = n('button', 'Guardar el puente', 'soft');
      guardar.onclick = async () => {
        try {
          await satApi('paperless/config', { enabled: activo.checked, baseUrl: base.value.trim(),
            token: token.value.trim() || undefined });
          toast('Puente a Paperless guardado.', 'ok');
          if (activo.checked) { await probar(); draw(); }
          else draw();
        } catch (error) { toast(error.message, 'error'); }
      };
      const probarBtn = n('button', 'Probar conexión', 'soft');
      probarBtn.type = 'button';
      probarBtn.onclick = () => probar();
      form.append(activoLabel, fieldWrap('Dirección de tu Paperless', base), fieldWrap('Token de API', token), guardar, probarBtn, pruebaTexto);
      body.append(form);
      if (enCola) {
        const retry = n('button', 'Reintentar la cola ahora', 'soft');
        retry.onclick = async () => {
          try { const r = await satApi('paperless/retry', {}); toast('Cola procesada: ' + r.subidos + ' documento(s) copiado(s) en esta pasada.', 'ok'); draw(); }
          catch (error) { toast(error.message, 'error'); }
        };
        body.append(retry);
      }
      body.append(n('p', 'Nota honesta: la subida usa la API estándar de Paperless-ngx. Si tu Paperless tiene el consumo averiado, los documentos se quedan en la cola con el error a la vista hasta que lo repares — PacoSAT no finge haber copiado lo que no copió.', 'muted'));
    } catch (error) { body.replaceChildren(n('p', error.message, 'error-text')); }
  };
  draw();
  return panelEl;
}
/* Avisos push PWA (1.25.0, AGREGAR 9): suscripción de ESTE
   dispositivo a los avisos críticos (69-B definitivo, factura
   cobrada cancelada y demás «mal + alta»). El aviso que viaja
   es genérico — ningún dato fiscal sale en la notificación — y
   al tocarla se abre la app, donde sí está el detalle. */
function pushPanel() {
  const panelEl = panel('Avisos push en este dispositivo', 'Un aviso en la pantalla de bloqueo cuando nazca algo crítico. Sin datos fiscales en la notificación: al tocarla se abre PacoSAT.');
  const body = n('div');
  panelEl.append(body);
  const deB64 = texto => Uint8Array.from(atob(texto.replaceAll('-', '+').replaceAll('_', '/')),
    c => c.charCodeAt(0));
  const draw = async () => {
    body.replaceChildren();
    if (!('serviceWorker' in navigator) || !('PushManager' in window)) {
      body.append(n('p', 'Este navegador no admite avisos push. En el iPhone, instala PacoSAT en la pantalla de inicio (Compartir → Añadir a pantalla de inicio) y vuelve aquí.', 'empty'));
      return;
    }
    const registration = await navigator.serviceWorker.ready;
    const actual = await registration.pushManager.getSubscription();
    body.append(statusPill(actual ? 'ok' : 'dim', actual ? 'Push ACTIVADO en este dispositivo' : 'Push desactivado en este dispositivo'));
    const fila = n('div', undefined, 'sat-actions');
    if (!actual) {
      const activar = n('button', 'Activar avisos push', 'primary');
      activar.onclick = async () => {
        try {
          const clave = await satApi('push/vapid');
          const sub = await registration.pushManager.subscribe({ userVisibleOnly: true,
            applicationServerKey: deB64(clave.key) });
          const json = sub.toJSON();
          await satApi('push/subscribe', { endpoint: json.endpoint, keys: json.keys });
          toast('Avisos push activados en este dispositivo.', 'ok'); draw();
        } catch (error) { toast(error.message, 'error'); }
      };
      fila.append(activar);
    } else {
      const prueba = n('button', 'Enviar una prueba', 'soft');
      prueba.onclick = async () => {
        try { await satApi('push/test', {}); toast('Prueba enviada: mira la pantalla de bloqueo.', 'ok'); }
        catch (error) { toast(error.message, 'error'); }
      };
      const desactivar = n('button', 'Desactivar en este dispositivo', 'soft');
      desactivar.onclick = async () => {
        try {
          await satApi('push/unsubscribe', { endpoint: actual.endpoint });
          await actual.unsubscribe();
          toast('Avisos push desactivados en este dispositivo.', 'ok'); draw();
        } catch (error) { toast(error.message, 'error'); }
      };
      fila.append(prueba, desactivar);
    }
    body.append(fila);
  };
  draw().catch(error => body.replaceChildren(n('p', error.message, 'error-text')));
  return panelEl;
}
async function saveAppSettings() {
  const name = $('settings-name')?.value ?? appSettings.installName;
  const sender = $('settings-sender')?.value ?? appSettings.senderName;
  const accent = document.querySelector('[data-accent-option][aria-pressed="true"]')?.dataset.accentOption ?? appSettings.accent;
  if (satToken) {
    const result = await satApi('settings', { installName: name, senderName: sender, accent });
    appSettings = { ...appSettings, ...result.settings, logoData: appSettings.logoData };
    if (pendingLogo === '') {
      await satApiDelete('settings/logo');
      appSettings.logoData = '';
      appSettings.hasLogo = false;
    } else if (pendingLogo) {
      const mime = /data:(.*?);/.exec(pendingLogo)[1];
      await satApi('settings/logo', { mime, data: pendingLogo.split(',')[1] });
      appSettings.logoData = pendingLogo;
      appSettings.hasLogo = true;
    }
    pendingLogo = undefined;
    announce('Ajustes guardados en el servidor.');
  } else {
    appSettings = { ...appSettings, installName: name.trim().slice(0, 60), senderName: sender.trim().slice(0, 60), accent,
      logoData: pendingLogo === '' ? '' : (pendingLogo || appSettings.logoData) };
    appSettings.hasLogo = Boolean(appSettings.logoData);
    try {
      localStorage.setItem('pacosat-settings', JSON.stringify({ installName: appSettings.installName,
        senderName: appSettings.senderName, accent: appSettings.accent, logoData: appSettings.logoData }));
    } catch { /* almacenamiento lleno o bloqueado: la identidad vale para esta sesión */ }
    pendingLogo = undefined;
    announce('Ajustes guardados en este navegador.');
  }
  applySettings();
  render();
}

/* ===== API de PacoSAT (1.32.0) =====
   El panel de control de la puerta /api/v1: qué es, las llaves
   (crear con enseñanza única, pausar, reactivar, revocar), el
   uso contado desde el libro de llamadas — el mismo que audita
   el Registro — y la documentación con ejemplos para Excel,
   Power BI o cualquier sistema del despacho. Solo lectura
   siempre: ninguna llave escribe, y lo que la lista de cimientos
   prohíbe (e.firma, CIEC, contraseñas, contenido del Buzón) no
   tiene recurso que lo devuelva. */
function apiDocPanel1320() {
  const p = panel('API de PacoSAT · Qué es y cómo se usa');
  const base = location.origin + '/api/v1';
  p.append(
    n('p', 'La API deja que TU Excel, tu Power BI o tu sistema propio lean los datos de esta ' +
      'instalación de PacoSAT: los mismos totales, comprobantes, avisos y documentos que enseñan ' +
      'las pantallas, con las mismas cifras. Es de SOLO LECTURA y vive aquí, en tu equipo: ' +
      'ningún dato sale a ningún servidor de nadie.'),
    n('p', 'Cada sistema que conectes usa su propia llave. La llave se crea aquí, se enseña ' +
      'una sola vez y en el servidor queda solo su huella: si se pierde, se revoca y se crea ' +
      'otra. Una llave puede ser de lectura completa o de solo resúmenes, y puede quedar ' +
      'limitada a un solo RFC.'));
  const recursos = [
    ['Estado de la instalación', 'GET /api/v1/estado'],
    ['Totales por mes (el criterio de la pantalla Totales)', 'GET /api/v1/totales?rfc=TU_RFC&desde=2026-01&hasta=2026-12'],
    ['Comprobantes (lista paginada: pagina y porPagina)', 'GET /api/v1/cfdi?rfc=TU_RFC&porPagina=50'],
    ['Un comprobante en detalle', 'GET /api/v1/cfdi/EL_UUID?rfc=TU_RFC'],
    ['Avisos activos con su plazo y su gesto', 'GET /api/v1/avisos?rfc=TU_RFC'],
    ['Documentos del expediente', 'GET /api/v1/documentos?rfc=TU_RFC'],
    ['Resumen del Buzón Tributario (conteos y plazos, sin contenido)', 'GET /api/v1/buzon/resumen?rfc=TU_RFC'],
    ['El Registro en una ventana de tiempo', 'GET /api/v1/registro?rfc=TU_RFC'],
    ['Notas de los CFDI (solo llaves con alcance «lectura-notas», filtradas por su RFC)', 'GET /api/v1/cfdi/notas?rfc=TU_RFC']];
  const lista = n('div', undefined, 'api-recursos');
  for (const [nombre, ruta] of recursos) {
    const fila = n('div', undefined, 'api-recurso');
    fila.append(n('span', nombre), n('code', ruta));
    lista.append(fila);
  }
  p.append(lista);
  const ejemplo = 'curl -H "Authorization: Bearer TU_LLAVE" "' + base + '/totales?rfc=TU_RFC"';
  const consulta = '= Json.Document(Web.Contents("' + base + '/totales?rfc=TU_RFC", ' +
    '[Headers=[Authorization="Bearer TU_LLAVE"]]))';
  const bloque = (titulo, texto) => {
    const wrap = n('div', undefined, 'api-ejemplo');
    const copiar = action('Copiar', async () => {
      try { await navigator.clipboard.writeText(texto); toast('Copiado.', 'ok'); }
      catch { toast('No se pudo copiar: selecciónalo y cópialo a mano.', 'error'); }
    }, 'soft');
    const cabeza = n('div', undefined, 'api-ejemplo-head');
    cabeza.append(n('strong', titulo), copiar);
    wrap.append(cabeza,
      Object.assign(n('code', texto), { style: 'white-space:pre-wrap;word-break:break-all;display:block' }));
    return wrap;
  };
  p.append(
    n('h4', 'Ejemplo de llamada (curl)'),
    bloque('curl', ejemplo),
    n('h4', 'Para Excel o Power BI (Power Query → Obtener datos → En blanco)'),
    bloque('Power Query', consulta),
    n('p', 'Las respuestas son JSON con el sobre de la casa: «datos» y, en las listas, «meta» ' +
      'con la página y el total. Los errores traen su código y su explicación en claro ' +
      '(401 sin llave, 403 fuera de alcance o de su RFC, 429 si se pasa el ritmo de 60 ' +
      'llamadas por minuto). La cabecera oficial es Authorization: Bearer; también se ' +
      'acepta X-API-Key.'));
  return p;
}
function apiPanelSection1320() {
  const panels = [apiDocPanel1320()];
  const p = panel('Llaves de acceso y uso');
  const body = n('div', undefined, 'portal');
  p.append(body);
  panels.push(p);
  const pintar = data => {
    body.replaceChildren();
    /* La llave recién creada: se enseña UNA vez, aquí. */
    if (apiLlaveNueva1320) {
      const caja = n('div', undefined, 'api-llave-nueva');
      const codigo = Object.assign(n('code', apiLlaveNueva1320),
        { style: 'word-break:break-all;display:block;font-size:15px' });
      const copiar = action('Copiar la llave', async () => {
        try { await navigator.clipboard.writeText(apiLlaveNueva1320); toast('Llave copiada.', 'ok'); }
        catch { toast('No se pudo copiar: cópiala a mano.', 'error'); }
      });
      const cerrar = action('Ya la guardé', () => { apiLlaveNueva1320 = ''; pintar(data); }, 'soft');
      const acciones = n('div', undefined, 'actions');
      acciones.append(copiar, cerrar);
      caja.append(n('strong', 'Tu llave nueva — cópiala ahora'),
        n('p', 'No se vuelve a enseñar: en el servidor queda solo su huella. Si la pierdes, ' +
          'revócala y crea otra.'),
        codigo, acciones);
      body.append(caja);
    }
    /* Crear una llave. */
    const form = n('div', undefined, 'api-form');
    const nombreIn = input('text', { maxlength: '60', placeholder: '¿Para quién o para qué? (p. ej. Excel de la oficina)', autocomplete: 'off' });
    const alcanceSel = n('select');
    alcanceSel.append(new Option('Lectura completa', 'lectura'), new Option('Solo resúmenes', 'lectura-resumen'),
      new Option('Lectura completa + notas de los CFDI', 'lectura-notas'));
    const rfcSel = n('select');
    rfcSel.append(new Option('Todos los RFC', ''));
    for (const person of people) rfcSel.append(new Option(person.name + ' · ' + person.id, person.id));
    const crear = action('Crear llave', async () => {
      if (!nombreIn.value.trim()) { toast('Ponle un nombre a la llave.', 'error'); return; }
      crear.disabled = true;
      try {
        const creada = await satApi('apikeys', { nombre: nombreIn.value.trim(),
          alcance: alcanceSel.value, rfc: rfcSel.value });
        apiLlaveNueva1320 = creada.llave || '';
        toast('Llave creada: cópiala ahora, no se vuelve a enseñar.', 'ok');
        pintar(await satApi('apikeys'));
      } catch (error) {
        /* Respuesta perdida ≠ no creada: se re-lee antes de
           declarar el fallo (doctrina de la casa). */
        try {
          const releido = await satApi('apikeys');
          if (releido.llaves.some(k => k.nombre === nombreIn.value.trim())) {
            toast('La llave SÍ se creó (la respuesta se perdió por el camino). ' +
              'Su valor ya no se puede enseñar: revócala y crea otra para copiarla.', 'error');
            pintar(releido); return;
          }
        } catch { /* sin re-lectura: manda el error original */ }
        toast(error.message, 'error');
        crear.disabled = false;
      }
    });
    form.append(field('Nombre de la llave', nombreIn), field('Alcance', alcanceSel),
      field('Limitada a un RFC (opcional)', rfcSel), crear);
    body.append(form);
    /* Las llaves, con su uso. */
    if (!data.llaves.length)
      body.append(n('p', 'Todavía no hay llaves. Crea la primera para conectar tu Excel o tu sistema.'));
    /* El cambio de estado de una llave (2.9.5 · R1): la
       confirmación de revocar va con el DIÁLOGO PROPIO de la
       casa — la doctrina desde la 1.18.0 («fuera el confirm()
       nativo del navegador») — porque en el navegador real el
       diálogo nativo se traga: la re-verificación en vivo del
       18 nov pulsó «Revocar» tres veces «con su confirmación»
       y la llave siguió «Activa», sin llamada y sin error: la
       cadena moría en el confirm() antes de nacer. Y la
       tarjeta se pinta desde la RE-LECTURA del servidor, no
       desde la respuesta del POST: lo que la tarjeta enseña
       es lo que el servidor tiene, re-leído tras el cambio. */
    const ejecutarEstado295 = async (llave, estado, etiqueta) => {
      try {
        await satApi('apikeys/estado', { id: llave.id, estado });
        const releido = await satApi('apikeys');
        toast('Llave «' + llave.nombre + '»: ' + etiqueta + '.', 'ok');
        pintar(releido);
      } catch (error) {
        /* Respuesta perdida ≠ cambio perdido: se re-lee el
           registro antes de dar error (verdad de las acciones). */
        try {
          const releido = await satApi('apikeys');
          if (releido.llaves.find(k => k.id === llave.id)?.estado === estado) {
            toast('Hecho: «' + llave.nombre + '» quedó ' + etiqueta + ' (la respuesta se había perdido).', 'ok');
            pintar(releido); return;
          }
        } catch { /* manda el error original */ }
        toast(error.message, 'error');
      }
    };
    const actuar = (llave, estado, etiqueta) => {
      if (estado === 'revocada') {
        dialog('Revocar la llave',
          [n('p', '¿Revocar la llave «' + llave.nombre + '»? Dejará de funcionar al instante y no hay vuelta atrás: para volver a conectar ese sistema habrá que crear una llave nueva.')],
          async () => { await ejecutarEstado295(llave, estado, etiqueta); }, 'Revocar');
        return;
      }
      return ejecutarEstado295(llave, estado, etiqueta);
    };
    for (const llave of data.llaves) {
      const card = n('article', undefined, 'api-key-card');
      const pillEstado = llave.estado === 'activa' ? ['ok', 'Activa']
        : llave.estado === 'en-pausa' ? ['warn', 'En pausa'] : ['dim', 'Revocada'];
      const pillNode = statusPill(pillEstado[0], pillEstado[1]);
      const menuItems = [];
      if (llave.estado === 'activa')
        menuItems.push({ label: 'Pausar', fn: () => actuar(llave, 'en-pausa', 'en pausa') });
      if (llave.estado === 'en-pausa')
        menuItems.push({ label: 'Reactivar', fn: () => actuar(llave, 'activa', 'activa otra vez') });
      if (llave.estado !== 'revocada')
        menuItems.push({ label: 'Revocar', danger: true, fn: () => actuar(llave, 'revocada', 'revocada') });
      const head = n('div', undefined, 'tramite-head');
      head.append(n('strong', llave.nombre), pillNode);
      if (menuItems.length)
        head.append(cardMenu1312('Más opciones de la llave ' + llave.nombre, menuItems));
      const meta = n('p', undefined, 'api-key-meta');
      meta.append(
        n('span', (llave.alcance === 'lectura-resumen' ? 'Solo resúmenes' : llave.alcance === 'lectura-notas' ? 'Lectura completa + notas' : 'Lectura completa') +
          (llave.rfc ? ' · solo ' + llave.rfc : ' · todos los RFC')),
        n('span', 'Creada el ' + localDateTime(llave.creada)),
        n('span', llave.ultimoUso ? 'Último uso: ' + localDateTime(llave.ultimoUso) : 'Sin uso todavía'),
        n('span', 'Llamadas: ' + llave.llamadasHoy + ' hoy · ' + llave.llamadasTotal + ' en total'));
      card.append(head, meta);
      /* Revocar VISIBLE en la tarjeta (2.9.3 · F12): la acción
         vivía solo dentro del menú «Más opciones de la llave» y
         el barrido en vivo no la encontró — una acción necesaria
         no se esconde en un menú. El menú se conserva intacto
         (paridad); la tarjeta lleva su propio botón, con la
         misma confirmación de siempre. */
      if (llave.estado !== 'revocada') {
        const actosLlave293 = n('div', undefined, 'actions');
        const revocarBtn293 = n('button', 'Revocar', 'soft small');
        revocarBtn293.type = 'button';
        revocarBtn293.onclick = () => actuar(llave, 'revocada', 'revocada');
        actosLlave293.append(revocarBtn293);
        card.append(actosLlave293);
      }
      body.append(card);
    }
    /* Últimas llamadas, con su puerta al Registro. */
    if (data.llamadas?.length) {
      body.append(n('h4', 'Últimas llamadas'));
      const listaLlamadas = n('div', undefined, 'api-llamadas');
      for (const llamada of data.llamadas.slice(0, 12)) {
        const fila = n('div', undefined, 'api-llamada');
        fila.append(n('span', localDateTime(llamada.at)),
          n('span', llamada.llave), n('code', llamada.recurso),
          n('span', llamada.registros ? llamada.registros + ' registros' : ''),
          statusPill(llamada.estado < 400 ? 'ok' : llamada.estado === 429 ? 'warn' : 'bad',
            String(llamada.estado)));
        listaLlamadas.append(fila);
      }
      body.append(listaLlamadas);
      const alRegistro = action('Verlas en el Registro', () => navigate('registro'), 'soft');
      body.append(alRegistro);
    }
  };
  body.append(n('p', 'Cargando las llaves…'));
  satApi('apikeys').then(pintar).catch(error =>
    body.replaceChildren(n('p', 'El panel de la API vive en el servidor de tu casa: ' +
      'abre PacoSAT desde ahí para gestionar las llaves. (' + error.message + ')')));
  return panels;
}
let apiLlaveNueva1320 = '';
/* Panel «Cuentas agrupadoras del SAT» (2.4.0 · WServ2, ítem 13):
   el mapeo OPCIONAL contraparte (RFC) → código de agrupadora
   que el generador de pólizas aplica en la columna «Cuenta»
   del Excel. Sin mapeo para una contraparte, su columna sigue
   en blanco, como siempre: PacoSAT no incrusta el catálogo
   oficial ni inventa códigos — guarda el código que tú
   escribas, con su nombre llano al lado para reconocerlo. */
function agrupadorasPanel240() {
  const panelEl = panel('Cuentas agrupadoras del SAT (pólizas)',
    'Opcional: para cada contraparte, el código de cuenta agrupadora del SAT que debe llevar en las pólizas. El Excel de pólizas rellena su columna «Cuenta» solo donde hay mapeo; donde no lo hay, sigue en blanco como hasta ahora.');
  const body = n('div', undefined, 'portal');
  panelEl.append(body);
  let mapeo = {};
  const pintar = async () => {
    body.replaceChildren(n('p', 'Leyendo el mapeo…', 'muted'));
    try {
      const datos = await satApi('polizas/agrupadoras240');
      mapeo = datos.mapeo || {};
      body.replaceChildren();
      const claves = Object.keys(mapeo).sort();
      if (!claves.length) body.append(n('p', 'Sin ningún mapeo: las pólizas salen con la columna «Cuenta» en blanco, como siempre.', 'muted'));
      for (const rfc of claves) {
        const row = n('div', undefined, 'cp-row');
        row.append(statusPill('dim', mapeo[rfc].codigo),
          n('span', rfc + ' → ' + mapeo[rfc].codigo + (mapeo[rfc].nombre ? ' · ' + mapeo[rfc].nombre : '')));
        const quitar = n('button', 'Quitar', 'soft small');
        quitar.type = 'button';
        quitar.onclick = async () => {
          const copia = { ...mapeo }; delete copia[rfc];
          try {
            const r = await satApi('polizas/agrupadoras240', { mapeo: copia });
            mapeo = r.mapeo || {};
            toast('Mapeo quitado para ' + rfc + ': sus pólizas vuelven a salir en blanco.', 'ok');
            pintar();
          } catch (error) { toast(error.message, 'error'); }
        };
        row.append(quitar);
        body.append(row);
      }
      const form = n('div', undefined, 'sat-form');
      const rfcIn = input('text', { placeholder: 'RFC de la contraparte', maxlength: '13' });
      const codigoIn = input('text', { placeholder: 'Código de agrupadora (p. ej. el del catálogo del SAT)', maxlength: '20' });
      const nombreIn = input('text', { placeholder: 'Nombre llano (opcional)', maxlength: '80' });
      const guardar = n('button', 'Guardar el mapeo', 'primary');
      guardar.type = 'button';
      guardar.onclick = async () => {
        const rfc = rfcIn.value.trim().toUpperCase();
        if (!rfc || !codigoIn.value.trim()) { toast('Escribe el RFC de la contraparte y su código de agrupadora.', 'error'); return; }
        try {
          const r = await satApi('polizas/agrupadoras240',
            { mapeo: { ...mapeo, [rfc]: { codigo: codigoIn.value.trim(), nombre: nombreIn.value.trim() } } });
          mapeo = r.mapeo || {};
          toast('Mapeo guardado: las pólizas de ' + rfc + ' llevarán su agrupadora desde la próxima generación.', 'ok');
          pintar();
        } catch (error) { toast(error.message, 'error'); }
      };
      form.append(fieldWrap('Contraparte (RFC)', rfcIn), fieldWrap('Código de agrupadora del SAT', codigoIn),
        fieldWrap('Nombre llano', nombreIn), guardar);
      body.append(form);
    } catch (error) { body.replaceChildren(n('p', 'No se pudo leer el mapeo: ' + error.message, 'error-text')); }
  };
  pintar();
  return panelEl;
}
