function operationsScreen() {
  const selected = invoices.filter(matches);
  const docs = documents.filter(d => d.kind === 'Factura PDF' && (!scope || d.rfc === scope));
  /* Una sola bandeja (UX-18): la de Vigilancia SAT. Operaciones resume
     el conteo y enlaza; ya no duplica la lista con otros criterios. */
  const alerts = panel('Bandeja de atención');
  const pending = selected.filter(row => {
    const state = fiscalResults.get(row.id);
    return !state || state.error || state.sat?.state !== 'Vigente' || state.efos?.length;
  });
  alerts.append(n('p', pending.length ?
    pending.length + ' comprobantes requieren atención según la vigilancia (sin consulta no significa vigente; las coincidencias 69-B conservan su categoría).' :
    'Sin pendientes en los resultados cargados. La bandeja completa vive en Vigilancia SAT.'));
  alerts.append(action('Abrir Vigilancia SAT', () => { monitorFilter = 'attention'; navigate('monitor'); }, 'primary', 'shield'));
  const reconcile = panel('Conciliación XML y PDF');
  const unlinked = docs.filter(d => !d.uuid || !invoices.some(row => row.id === d.uuid && [row.from.rfc,row.to.rfc].includes(d.rfc)));
  const noPdf = selected.filter(row => !docs.some(d => d.uuid === row.id && [row.from.rfc,row.to.rfc].includes(d.rfc)));
  reconcile.append(n('p', unlinked.length + ' PDF pendientes de vincular · ' + noPdf.length + ' XML sin representación PDF. La ausencia de PDF no invalida un CFDI.'));
  if (unlinked.length) reconcile.append(grid(['PDF', 'RFC', 'Acción'], unlinked.slice(0,100).map(doc => [doc.name, doc.rfc, action('Vincular UUID', () => linkPdfDialog(doc))])));
  reconcile.append(action('Ver facturas', () => navigate('invoices')));
  const health = panel('Estado de operación');
  health.append(grid(['Componente', 'Estado'], [
    ['Almacenamiento', ready ? (cloudStorage ? 'Servidor privado' : 'Este navegador') : isStorageBlocked() ? 'Bloqueado por otra pestaña' : 'No disponible'],
    ['Servicio SAT', !satToken ? 'PacoSAT no se pudo conectar con su servidor. Revisa que el NAS esté encendido y vuelve a intentarlo.' : satError || 'Servicio disponible; revisa cada RFC en SAT'],
    ['RFC autorizados', String(satData.profiles.filter(p => p.unlocked && (!scope || p.rfc === scope)).length)],
    ['Correo', satData.mail.error || (satData.mail.enabled ? 'Configurado; entrega real pendiente de verificar' : 'Sin configurar')],
    ['Carpeta vigilada', !satToken ? 'Solo en modo servidor' : satData.watchFolder?.enabled ?
      'Activa' + (satData.watchFolder.subfolders ? ' · incluye subcarpetas' : '') + ' · ' + satData.watchFolder.imported + ' archivos importados · ' + satData.watchFolder.failed + ' con error' +
      (satData.watchFolder.incidents ? ' · ' + satData.watchFolder.incidents + ' con incidencias' : '') +
      (satData.watchFolder.waiting ? ' · ' + satData.watchFolder.waiting + ' en espera (copiándose)' : '') +
      (satData.watchFolder.lastScan ? ' · última revisión ' + localDateTime(satData.watchFolder.lastScan) : '') +
      (satData.watchFolder.error ? ' · ' + satData.watchFolder.error : '') : 'Sin configurar en el servidor'],
    ['Respaldo programado', !satToken ? 'Sin servidor: crea respaldos manuales' : satData.scheduledBackup?.enabled ?
      (satData.scheduledBackup.frequency === 'weekly' ? 'Semanal' : 'Diario') + ' · último: ' +
      (satData.scheduledBackup.last ? localDateTime(satData.scheduledBackup.last) : 'aún no') +
      (satData.scheduledBackup.error ? ' · Error: ' + satData.scheduledBackup.error : '') : 'Sin configurar en el servidor'],
    ['Respaldo', 'Exporta una copia cifrada antes de actualizar. Ningún respaldo incluye la e.firma ni las credenciales SMTP; el respaldo programado del servidor sí incluye la cola SAT y el estado operativo.']
  ]));
  const buttons = n('div', undefined, 'actions');
  buttons.append(action('Centro SAT', () => navigate('sat')), action('Crear respaldo cifrado', backupDialog), action('Actualizar estado', async () => { await pollSat(); await pollMonitor(); render(); }));
  if (satToken && satData.mail?.enabled) buttons.append(action('Enviar correo de prueba', async () => {
    await satApi('mail/test', {});
    announce('Correo de prueba enviado a ' + satData.mail.recipient + '.');
    soundCue('success');
  }, undefined, 'bell'));
  health.append(buttons);
  /* Salud del sistema (1.6.5): caducidad real de cada e.firma (leída del
     certificado al desbloquear; «sin dato» si nunca se leyó), última
     descarga con éxito por perfil, último respaldo con sus destinos y
     tamaño del expediente en conteos. */
  const sysHealth = panel('Salud del sistema');
  const expiryText = ms => {
    const days = Math.ceil((ms - Date.now()) / 86400000);
    const when = dateLabel(new Date(ms).toISOString());
    return days > 0 ? 'Vence el ' + when + ' (en ' + days + (days === 1 ? ' día' : ' días') + ')' :
      days === 0 ? 'Vence hoy, ' + when : 'Venció el ' + when + ' (hace ' + -days + (days === -1 ? ' día' : ' días') + ')';
  };
  const sb = satData.scheduledBackup || {};
  const healthRows = [];
  for (const profile of (satData.profiles || []).filter(p => !scope || p.rfc === scope)) {
    healthRows.push(['e.firma · ' + profile.rfc, profile.certExpires ? expiryText(profile.certExpires) :
      'Sin dato: se registra al desbloquear la e.firma con su certificado']);
    healthRows.push(['Última descarga con éxito · ' + profile.rfc, profile.lastSatSuccess ? localDateTime(profile.lastSatSuccess) : 'Sin registro']);
  }
  if (!healthRows.length && !satToken) healthRows.push(['Perfiles SAT', 'Solo en modo servidor']);
  healthRows.push(['Último respaldo correcto', !satToken ? 'Sin servidor: crea respaldos manuales' : sb.enabled ?
    (sb.last ? localDateTime(sb.last) : 'aún no') + (sb.secondary ? ' · destinos: principal y secundario' + (sb.secondaryError ? ' (el secundario falló: ' + sb.secondaryError + ')' : '') : ' · destino: solo principal') +
    (sb.verify ? ' · prueba de restauración: ' + (sb.verify.ok ? 'íntegra' : 'CON FALLO') : '') : 'Respaldo programado sin configurar']);
  healthRows.push(['Expediente', number.format(people.length) + ' RFC · ' + number.format(invoices.length) + ' CFDI · ' +
    number.format(documents.length) + ' documentos · ' + number.format(activity.length) + ' registros de bitácora']);
  /* Copia externa a Google Drive (1.6.15): antigüedad con semáforo —
     verde si la última copia buena tiene 7 días o menos. */
  if (satToken && sb.secondary) healthRows.push(['Copia externa (Google Drive)',
    sb.secondaryLastOk ? (sb.secondaryStale ? '⚠ Lleva más de 7 días: última buena el ' : 'Al día: última buena el ') +
      localDateTime(sb.secondaryLastOk) : '⚠ Aún no consta ninguna copia buena en el destino externo']);
  sysHealth.append(grid(['Elemento', 'Estado'], healthRows));
  return [health, sysHealth, selfTestPanel(), activityPanel(), alerts, reconcile];
}
function linkPdfDialog(doc) {
  const uuid = input('text', { required: true, maxLength: 36, value: doc.uuid || '', placeholder: 'UUID del XML importado' });
  dialog('Vincular PDF a su CFDI', [n('p', doc.name + ' · ' + doc.rfc), field('Folio fiscal', uuid)], async () => {
    const id = uuid.value.trim().toUpperCase();
    const row = invoices.find(item => item.id === id);
    check(UUID.test(id) && row, 'Importa primero el XML de ese UUID.');
    check([row.from.rfc,row.to.rfc].includes(doc.rfc), 'El XML corresponde a otro RFC.');
    check(!documents.some(d => d.id !== doc.id && d.rfc === doc.rfc && d.uuid === id && d.kind === 'Factura PDF'), 'Ese CFDI ya tiene un PDF vinculado.');
    await writeBatch({ documents: [{ ...doc, uuid: id }] });
    await refresh();
    await logEvent('PDF vinculado al CFDI ' + id);
    announce('PDF vinculado al XML.');
  });
}
