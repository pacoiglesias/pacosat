/* ===== Listas negras (1.6.13; renombre y rediseño 2.4.0) =====
   Pantalla del servidor: abre con la tarjeta protagonista del
   veredicto por RFC (el golpe vigente y la frescura), sigue con
   los golpes agrupados por clase y las fuentes en tarjetas
   compactas, y conserva todo lo demás: validador en tiempo
   real, padrón de contrapartes con su peor situación y su
   exposición, historial de cambios y constancia imprimible
   por empresa. Todo lenguaje llano: «lista negra» aquí
   significa que el SAT publicó ese RFC en un listado oficial,
   y las negras de verdad son solo las de operaciones
   inexistentes (69-B y 69-B Bis); los demás supuestos del
   art. 69 van en su clase, y los créditos fiscales se
   presentan como lo que son: contrapartes que deben al fisco. */
const LISTS_VIEW = { data: null };
const listStatePill = source => {
  /* Fallo digno (ronda de correcciones, 9 nov 2026): si la descarga de
     hoy falla pero existe una última copia buena, la tarjeta lo dice
     así — con su fecha y sus registros — y el cruce sigue con esa
     copia. El error desnudo solo aparece si nunca hubo copia. */
  if (source.count > 0 && source.fetched) {
    if (source.error) return statusPill('warn', 'Última copia válida del ' +
      new Date(source.fetched).toLocaleDateString('es-MX', { day: 'numeric', month: 'short', year: 'numeric' }));
    if (Date.now() - source.fetched > 48 * 3600 * 1000) return statusPill('warn', 'Desactualizado');
    return statusPill('ok', 'Al día');
  }
  if (source.error) return statusPill('bad', 'Con error');
  if (!source.fetched) return statusPill('dim', source.manual ? 'Sin cargar' : 'Pendiente');
  if (Date.now() - source.fetched > 48 * 3600 * 1000) return statusPill('warn', 'Desactualizado');
  return statusPill('ok', 'Al día');
};
async function loadLists() {
  LISTS_VIEW.data = await satApi('lists');
  /* Listas es vista propia con entrada de menú (2.0.1): al
     cargar, repinta su pantalla si es la visible y deja su
     resultado y su fecha en la entrada del menú, para que se
     vean sin entrar. */
  const menuTxt = document.getElementById('lists-menu-estado201');
  if (menuTxt) menuTxt.textContent = listsResumen201(LISTS_VIEW.data).corto;
  if (page === 'lists') render();
  return LISTS_VIEW.data;
}
/* ===== Resumen claro de Listas (2.0.1) =====
   La vista abre con la foto de un vistazo: por cada RFC propio,
   limpio o señalado (y en qué listado), y la fecha de la última
   comprobación. Esa fecha NO la guarda el cruce por RFC: sale
   de `fetched`, la descarga más reciente de los listados
   cargados — la pantalla lo dice en llano junto a la fecha, sin
   presentarla como otra cosa. Sin ninguna descarga, la vista
   dice «Todavía no se ha comprobado» y ofrece el gesto. La
   misma lectura alimenta la línea de Listas en Salud. */
function listsResumen201(data) {
  const sources = data?.sources || [];
  const cargadas = sources.filter(source => source.fetched);
  const ultima = cargadas.length ? Math.max(...cargadas.map(source => Number(source.fetched) || 0)) : null;
  const senaladas = (data?.counterparts || []).filter(cp => (cp.hits || []).length);
  const propios = (data?.counterparts || []).filter(cp => cp.source === 'perfil' || cp.kind === 'Propio');
  /* Texto llano del resultado con su fecha, para la línea de
     Hoy y la entrada del menú (2.0.1): el mismo resumen, dicho
     corto, sin otra fuente que esta. */
  const texto = !ultima ? 'todavía no se ha comprobado'
    : (senaladas.length ? senaladas.length + ' contraparte(s) señalada(s)' : 'sin contrapartes señaladas') +
      ' · última comprobación el ' + localDateTime(ultima);
  const corto = !ultima ? 'sin comprobar'
    : (senaladas.length ? senaladas.length + ' señalada(s)' : 'limpio') + ' · ' + localDate(ultima);
  return { sources, cargadas, ultima, senaladas, propios, texto, corto,
    etiquetasCargadas: cargadas.map(source => source.label) };
}
/* Comprobar ahora: la actualización de siempre (lists/refresh,
   que cruza TODOS los listados con el padrón), esperando a que
   el progreso del servidor termine antes de repintar — el mismo
   patrón de sondeo de las tarjetas de cada listado. */
async function listsComprobarAhora201(boton) {
  const texto = boton ? boton.textContent : '';
  if (boton) { boton.disabled = true; boton.textContent = 'Comprobando…'; }
  try {
    await satApi('lists/refresh', {});
    for (let i = 0; i < 200; i++) {
      await new Promise(resolve => setTimeout(resolve, 1200));
      const progress = await satApi('lists/progress').catch(() => null);
      if (!progress || !progress.running) break;
    }
    await loadLists();
    toast('Listados actualizados y cruzados con tu padrón.', 'ok');
  } catch (error) {
    toast(error.message, 'error');
    if (boton && boton.isConnected) { boton.disabled = false; boton.textContent = texto; }
  }
}
/* El error crudo de una fuente, en llano (2.3.2 · m-7): la
   tarjeta nunca pinta el texto técnico de la descarga; dice la
   causa en palabras de la casa, en el espíritu de problemSpec —
   qué pasó, y el gesto (o que no hace falta ninguno) lo añade
   quien pinta, según haya o no copia válida. */
function listsErrorLlano232(error) {
  const detalle = String(error || '');
  if (/timeout|aborted|aborterror|tard/i.test(detalle)) return 'la fuente oficial tardó demasiado en responder';
  if (/http\s*\d{3}|respondió con un error/i.test(detalle)) return 'la fuente oficial respondió con un error';
  if (/fetch|network|enotfound|econn|conexi|sin conexión|red\b/i.test(detalle)) return 'no hubo conexión con la fuente oficial';
  if (/columna rfc|registros reconocibles|no se reconoce|ilegible/i.test(detalle)) return 'el archivo descargado no se pudo leer como listado válido';
  return 'la descarga no se pudo completar';
}
/* ===== Veredicto de Listas negras (2.4.0 · W3a) =====
   La pantalla ya no abre con un volcado: abre con el VEREDICTO
   calculado de la respuesta viva de /api/lists — el golpe
   vigente de las listas negras de verdad (69-B y 69-B Bis:
   operaciones inexistentes), separado de los demás supuestos
   del art. 69 y de los créditos fiscales (que NO son lista
   negra: son contrapartes que deben al fisco). Ninguna cifra
   va escrita a mano: todo sale de los datos de la respuesta.
   Las tres funciones entre las marcas VEREDICTO240 son puras
   (solo leen la respuesta y formatean) para que la suite
   ronda240listas las ejercite con respuestas de juguete. */
/*VEREDICTO240-INICIO*/
function listsClase240(hit) {
  if (hit.listId === '69b' || hit.listId === '69b-bis') return 'negras';
  if (hit.listId === '69-firmes' || hit.listId === '69-exigibles') return 'creditos';
  return 'supuestos';
}
/* Un golpe está vigente si su situación no quedó regularizada:
   en 69-B, «Desvirtuado» y «Sentencia favorable» llegan del
   servidor con severity 'ok'; todo lo demás publicado manda. */
function listsGolpeVigente240(hit) { return hit.severity !== 'ok'; }
function listsVeredicto240(data) {
  const resumen = listsResumen201(data);
  const grupos = { negras: [], supuestos: [], creditos: [] };
  for (const cp of data?.counterparts || [])
    for (const hit of cp.hits || []) {
      if (!listsGolpeVigente240(hit)) continue;
      grupos[listsClase240(hit)].push({ cp, hit });
    }
  /* El golpe protagonista: el peor de las negras de verdad; a
     igual gravedad, el de mayor importe recibido. */
  const orden = { bad: 3, warn: 2, dim: 1, ok: 0 };
  const golpe = [...grupos.negras].sort((a, b) =>
    (orden[b.hit.severity] || 0) - (orden[a.hit.severity] || 0) ||
    (Number(b.cp.exposure?.received) || 0) - (Number(a.cp.exposure?.received) || 0))[0] || null;
  const estado = !resumen.ultima ? 'sin-comprobar' : golpe ? 'con-golpe' :
    (grupos.supuestos.length || grupos.creditos.length) ? 'con-avisos' : 'limpio';
  return { estado, golpe, grupos, resumen };
}
/* UNA sola frase de cobertura (2.9.0 · Bloque C): «limpio
   contra los N listados cargados; faltan M por cargar» — la
   misma en el veredicto y en la línea de cada RFC propio.
   Antes convivían «limpio contra los 8 cargados» y «8 de 10
   cargados» como si se contradijeran. */
function listsFraseCobertura290(resumen) {
  const cargadas = (resumen?.cargadas || []).length;
  const total = (resumen?.sources || []).length;
  const faltan = Math.max(0, total - cargadas);
  return 'limpio contra los ' + cargadas + ' listados cargados' +
    (faltan ? '; faltan ' + faltan + ' por cargar' : '');
}
function listsVeredictoTexto240(data) {
  const v = listsVeredicto240(data);
  const r = v.resumen;
  if (v.estado === 'sin-comprobar')
    return 'Todavía no se ha comprobado: ningún listado consta descargado, así que aún no hay cruce con tu padrón.';
  const fecha = 'Última comprobación: ' + localDateTime(r.ultima) +
    ' · ' + r.cargadas.length + ' de ' + r.sources.length + ' listados cargados.';
  if (v.estado === 'con-golpe') {
    const { cp, hit } = v.golpe;
    const bits = [(cp.name || cp.rfc) + ' · ' + cp.rfc, hit.label, 'Situación: ' + hit.detail];
    const rec = cp.detalle?.recibidos;
    const count = rec?.count || cp.exposure?.receivedCount || 0;
    const total = rec?.total || cp.exposure?.received || '';
    if (count) bits.push('Te ha facturado $' + money(total) + ' en ' + count + ' CFDI recibidos');
    const anio = (rec?.ultima || rec?.primera || '').slice(0, 4);
    if (anio) bits.push('último en ' + anio);
    return 'Un golpe vigente en las listas negras. ' + bits.join(' · ') + '. ' + fecha;
  }
  if (v.estado === 'con-avisos') {
    const partes = [];
    if (v.grupos.creditos.length) partes.push(v.grupos.creditos.length +
      ' contraparte(s) en créditos fiscales del art. 69 (deben al fisco; no es una lista negra)');
    if (v.grupos.supuestos.length) partes.push(v.grupos.supuestos.length +
      ' contraparte(s) en otros supuestos del art. 69');
    return 'Sin golpes en las listas negras de operaciones inexistentes. Constan ' +
      partes.join(' y ') + '. ' + fecha;
  }
  return 'Limpio: ninguna contraparte de tu padrón consta en las listas negras — ' +
    listsFraseCobertura290(r) + '. ' +
    fecha + ((data?.events || []).length ? '' :
      ' Sin cambios detectados desde la primera comprobación guardada.');
}
/*VEREDICTO240-FIN*/
/* La tarjeta protagonista: el veredicto, su golpe con todas sus
   cifras, el estado de tus RFC propios y la frescura — en el
   primer pantallazo. Su acción es real: sin comprobar, «Comprobar
   ahora» (la actualización de siempre); con golpe, saltar a la
   evidencia («Ver sus CFDI») o sacar su constancia. «Actualizar
   listados» sigue viviendo UNA vez en la cabecera (m-6). */
function listsVeredictoPanel240(data) {
  const v = listsVeredicto240(data);
  const hero = n('section', undefined, 'dashboard-hero');
  const main = n('div');
  main.append(n('div', 'LISTAS NEGRAS · EL VEREDICTO', 'hero-kicker'));
  main.append(n('h2', v.estado === 'con-golpe' ? 'Un golpe vigente en las listas negras' :
    v.estado === 'con-avisos' ? 'Sin golpes en las listas negras — con avisos del art. 69' :
    v.estado === 'limpio' ? 'Limpio: sin golpes en las listas negras' : 'Todavía no se ha comprobado'));
  main.append(n('p', listsVeredictoTexto240(data)));
  for (const cp of v.resumen.propios) {
    const hits = cp.hits || [];
    main.append(n('p', 'Tu RFC ' + cp.rfc + (cp.name ? ' (' + cp.name + ')' : '') + ': ' +
      (hits.length ? 'señalado en ' + [...new Set(hits.map(hit => hit.label))].join(' · ') :
        listsFraseCobertura290(v.resumen)) + '.'));
  }
  if (v.resumen.ultima)
    main.append(n('p', 'La fecha de la última comprobación es la descarga más reciente de los listados cargados; la de cada listado está en su tarjeta, justo abajo.'));
  hero.append(main);
  const side = n('div', undefined, 'hero-actions');
  side.append(statusPill(v.estado === 'con-golpe' ? 'bad' : v.estado === 'con-avisos' ? 'warn' :
      v.estado === 'limpio' ? 'ok' : 'dim',
    v.estado === 'con-golpe' ? 'Lista negra · golpe vigente' : v.estado === 'con-avisos' ? 'Con avisos del art. 69' :
      v.estado === 'limpio' ? 'Limpio' : 'Sin comprobar'));
  if (v.estado === 'sin-comprobar') {
    const comprobar = n('button', 'Comprobar ahora', 'primary');
    comprobar.onclick = () => listsComprobarAhora201(comprobar);
    side.append(comprobar);
  }
  if (v.golpe) {
    const { cp } = v.golpe;
    if (cp.detalle && (cp.detalle.recibidos || cp.detalle.emitidos)) {
      const ver = n('button', 'Ver sus CFDI', 'soft');
      ver.onclick = () => verCfdiDeContraparte(cp);
      side.append(ver);
    }
    const cert = n('button', 'Constancia', 'soft');
    cert.onclick = () => printListsCertificate(cp, data.sources);
    side.append(cert);
  }
  hero.append(side);
  return hero;
}
/* Los golpes agrupados por clase, con su explicación llana y
   despliegue progresivo: las negras de verdad abiertas; los
   demás grupos se despliegan a un toque. El detalle completo
   de cada contraparte (acciones, «qué significa») sigue en el
   Padrón, debajo — esto es la foto agrupada, no otro volcado. */
function listsGruposPanel240(data) {
  const v = listsVeredicto240(data);
  const total = v.grupos.negras.length + v.grupos.supuestos.length + v.grupos.creditos.length;
  if (!total) return null;
  const panelEl = panel('Los golpes, por clase',
    'No todo lo que publica el SAT es una lista negra: cada clase dice qué es en llano.');
  const defs = [
    ['negras', 'Listas negras de verdad · operaciones inexistentes (69-B y 69-B Bis)',
     'El SAT sostiene que estas empresas facturan operaciones que no existen. El dinero que te facturaron es el que el SAT puede cuestionar: es el golpe serio.', true],
    ['supuestos', 'Otros supuestos del art. 69',
     'Publicados por el SAT por otros motivos — no localizados, sentencias, CSD sin efectos y demás —: no son operaciones inexistentes, pero conviene vigilarlos.', false],
    ['creditos', 'Créditos fiscales · deben al fisco (art. 69)',
     'No es una lista negra: son contrapartes con un crédito fiscal firme o exigible. Su deuda es con el fisco, no contigo; su exposición en tus CFDI recibidos es cero salvo que conste otra cosa en su fila del Padrón.', false]];
  for (const [key, titulo, explicacion, abierto] of defs) {
    const items = v.grupos[key];
    if (!items.length) continue;
    /* (2.9.13 · A9) Una contraparte, una fila por clase: la
       misma empresa con dos golpes en la misma clase (JOSE
       JAVIER salía dos veces con el mismo RFC, los mismos
       CFDI y el mismo importe) se funde en una fila con sus
       golpes juntos; los golpes idénticos se cuentan una
       vez. Empresas distintas con el mismo nombre se
       distinguen por el RFC que la fila ya enseña. */
    const porRfc2913 = new Map();
    for (const item of items) {
      const clave = item.cp.rfc || item.cp.name || '';
      const previo = porRfc2913.get(clave);
      if (previo) { previo.hits.push(item.hit); continue; }
      porRfc2913.set(clave, { cp: item.cp, hits: [item.hit] });
    }
    const fusionados2913 = [...porRfc2913.values()];
    const det = n('details', undefined, 'seal-details');
    if (abierto) det.open = true;
    det.append(n('summary', titulo + ' · ' + fusionados2913.length + ' contraparte(s)'));
    det.append(n('p', explicacion, 'muted'));
    for (const { cp, hits } of fusionados2913) {
      const row = n('div', undefined, 'cp-row');
      const main = n('div', undefined, 'cp-main');
      main.append(n('strong', cp.name || cp.rfc));
      const vistos2913 = new Set();
      for (const hit of hits) {
        const linea = hit.label + ': ' + hit.detail;
        if (vistos2913.has(linea)) continue;
        vistos2913.add(linea);
        main.append(n('span', cp.rfc + ' · ' + linea, 'cp-hit sev-' + hit.severity));
      }
      if (cp.exposure && cp.exposure.receivedCount)
        main.append(n('span', 'Te ha facturado $' + money(cp.exposure.received) + ' en ' +
          cp.exposure.receivedCount + ' CFDI recibidos', 'muted'));
      else if (key === 'creditos')
        main.append(n('span', 'Sin CFDI recibidos suyos: exposición cero.', 'muted'));
      const peor2913 = hits.some(h => h.severity === 'bad') ? 'bad'
        : hits.some(h => h.severity === 'warn') ? 'warn' : 'dim';
      row.append(main, statusPill(peor2913 === 'bad' ? 'bad' : peor2913 === 'warn' ? 'warn' : 'dim',
        peor2913 === 'bad' ? 'Grave' : peor2913 === 'warn' ? 'Precaución' : 'Menor'));
      det.append(row);
    }
    panelEl.append(det);
  }
  return panelEl;
}
/* La clase en llano de cada fuente, para su tarjeta (2.4.0):
   la misma distinción del veredicto — las de operaciones
   inexistentes son las listas negras de verdad; firmes y
   exigibles son créditos fiscales; el resto, supuestos del
   art. 69. Sale del id de la fuente, no de textos nuevos. */
function listsClaseFuente240(source) {
  if (source.id === '69b' || source.id === '69b-bis') return 'Lista negra · operaciones inexistentes';
  if (source.id === '69-firmes' || source.id === '69-exigibles') return 'Créditos fiscales · art. 69';
  return 'Supuesto del art. 69';
}
function listsScreen() {
  if (!LISTS_VIEW.data) { loadLists(); return [panel('Listas negras', 'Cargando los listados y tu padrón…')]; }
  const data = LISTS_VIEW.data;
  const wrap = n('div');
  /* Tarjeta protagonista (2.4.0): el veredicto abre la vista;
     debajo, los golpes por clase y las fuentes en tarjetas
     compactas; el validador y el padrón quedan debajo. */
  wrap.append(listsVeredictoPanel240(data));
  const gruposPanel = listsGruposPanel240(data);
  if (gruposPanel) wrap.append(gruposPanel);
  /* Fuentes oficiales, en tarjetas compactas (2.4.0): cada una
     con su clase en llano, su estado, su última comprobación y
     su acción real — Actualizar en las automáticas; carga
     manual y «Buscar en el SAT ↗» en las dos manuales. */
  const sourcesPanel = panel('Las fuentes, una a una', 'Los listados automáticos se descargan solos cada día. Si uno lleva más de 48 horas sin actualizar, PacoSAT avisa: vigilar con datos viejos es peor que no vigilar. Los dos manuales no tienen archivo oficial descargable: se revisan a mano en el SAT.');
  const grid = n('div', undefined, 'sat-grid');
  for (const source of data.sources) {
    const card = n('article', undefined, 'sat-card');
    const head = n('div', undefined, 'sat-card-head');
    head.append(n('strong', source.label), listStatePill(source));
    if (source.manual) head.append(statusPill('dim', 'Manual'));
    const meta = n('div', undefined, 'sat-meta');
    /* Los tramos se unen con « · » explícito (1.11.0): como nodos
       sueltos salían pegados («14,830 registrosDescargado: …»). */
    const bits = [listsClaseFuente240(source),
      source.count ? source.count.toLocaleString('es-MX') + ' registros' : 'Sin registros cargados'];
    if (source.fetched) bits.push('Última comprobación: ' + localDateTime(source.fetched));
    if (source.declared) bits.push('La fuente declara: ' + source.declared);
    if (source.manual) bits.push('Este listado no tiene descarga automática oficial: se carga su archivo a mano.');
    meta.append(n('span', bits.join(' · ')));
    card.append(head, meta);
    /* (2.9.13 · Bloque C) Las dos fuentes manuales explican
       su «Sin cargar» en la propia tarjeta, sin tecnicismos:
       el SAT no publica esos listados como archivo, así que
       no existe descarga automática posible — verificado el
       17 nov 2026 —; se consultan en la página del SAT o se
       carga el archivo a mano si se consigue. */
    if (source.manual)
      card.append(n('p', 'El SAT no publica este listado como archivo: por eso no existe descarga automática posible, ' +
        'ni aquí ni en ningún programa. Se consulta en la página del SAT con el botón «Buscar en el SAT ↗» de abajo, ' +
        'o, si consigues el archivo por tu cuenta, lo cargas a mano con «Cargar archivo CSV» y el cruce se hace al momento.', 'muted'));
    if (source.error && source.count > 0 && source.fetched)
      card.append(n('p', 'La actualización de hoy falló: ' + listsErrorLlano232(source.error) +
        '. El cruce sigue usando la última copia válida, del ' +
        localDateTime(source.fetched) + '. No tienes que hacer nada: se reintenta sola en la próxima actualización.', 'muted'));
    else if (source.error) card.append(n('p', 'Último intento: ' + listsErrorLlano232(source.error) +
      '. Todavía no hay copia de este listado con la que cruzar tu padrón; se reintenta solo en la actualización diaria.', 'error-text'));
    const actions = n('div', undefined, 'sat-actions');
    if (source.url) {
      const update = n('button', 'Actualizar ahora', 'soft');
      const runBox = n('div', '', 'run-status');
      update.onclick = async () => {
        /* Patrón de acciones largas (1.13.1, piezas E/F): progreso
           medible del servidor junto al botón y Cancelar cooperativo;
           cancelar conserva la copia anterior y lo dice aquí mismo. */
        update.disabled = true; update.textContent = 'Actualizando…';
        const startedAt = Date.now();
        let overview = null, failure = null, stopped = false;
        const cancelBtn = n('button', 'Cancelar', 'soft');
        cancelBtn.onclick = async () => { cancelBtn.disabled = true; cancelBtn.textContent = 'Terminando el paso actual…';
          try { await satApi('lists/cancel', {}); } catch { /* puede haber terminado ya */ } };
        runBox.replaceChildren(n('p', 'Descargando el listado…', 'run-phase'), cancelBtn);
        /* Trabajo con estado (pieza H): el POST solo ARRANCA la
           actualización y responde al instante; el fin se conoce
           sondeando el progreso, no esperando dentro de la petición. */
        let finalProgress = null;
        try { await satApi('lists/refresh', { listId: source.id }); }
        catch (error) { failure = error; }
        while (!failure) {
          await new Promise(resolve => setTimeout(resolve, 1200));
          try {
            const progress = await satApi('lists/progress');
            finalProgress = progress;
            if (progress?.running && !stopped) {
              const secs = Math.round((Date.now() - startedAt) / 1000);
              runBox.replaceChildren(n('p', (progress.phase || 'Actualizando…') +
                (progress.total ? ' · ' + progress.done + ' de ' + progress.total : '') + ' · lleva ' + secs + ' s', 'run-phase'), cancelBtn);
              continue;
            }
            break;
          } catch { /* sin sondeo esta vuelta */ }
        }
        stopped = true;
        if (failure) { toast(failure.message, 'error'); render(); return; }
        overview = await satApi('lists');
        if (finalProgress?.cancelled) {
          runBox.replaceChildren(n('p', 'Cancelado por ti a las ' +
            localTime(Date.now()) +
            ': se sigue usando la copia del ' + (source.fetched ? localDateTime(source.fetched) : '—') + '.', 'run-final'));
          update.disabled = false; update.textContent = 'Actualizar ahora';
          return;
        }
        await loadLists(); toast('Listado actualizado.', 'ok');
      };
      actions.append(update, runBox);
    } else {
      const file = input('file', { accept: '.csv,text/csv' }); file.hidden = true;
      file.onchange = async () => {
        if (!file.files[0]) return;
        try {
          const content = bytesToBase64(new Uint8Array(await file.files[0].arrayBuffer()));
          await satApi('lists/import', { listId: source.id, content });
          await loadLists(); toast('Listado cargado y cruzado con tu padrón.', 'ok');
        } catch (error) { toast(error.message, 'error'); render(); }
      };
      const importBtn = n('button', 'Cargar archivo CSV', 'soft');
      importBtn.onclick = () => file.click();
      actions.append(importBtn, file);
      /* Fuentes manuales (2.4.0): junto a la carga, el enlace
         oficial del SAT declarado en el catálogo (enlaceSat de
         sat-lists.mjs, verificado el 17 nov 2026) — la consulta
         se hace en el SAT y el archivo que salga se carga aquí. */
      if (source.enlaceSat) {
        const enlaceSat = n('a', 'Buscar en el SAT ↗');
        enlaceSat.href = source.enlaceSat;
        enlaceSat.target = '_blank';
        enlaceSat.rel = 'noopener';
        actions.append(enlaceSat);
      }
    }
    card.append(actions);
    grid.append(card);
  }
  sourcesPanel.append(grid);
  if (data.lastCancelled) sourcesPanel.append(n('p', 'Última cancelación pedida por ti: ' + localDateTime(data.lastCancelled) +
    ' — la actualización se detuvo y se conservó la copia anterior de cada listado.', 'muted'));
  /* (2.9.16 · P4) Las fuentes van plegadas: el veredicto y
     los golpes mandan en la vista; el detalle de cada
     listado (su actualización y su carga manual) queda a
     un toque, sin retirarse. */
  wrap.append(plegable290('Las fuentes, una a una', sourcesPanel, 'listas-fuentes2916'));
  /* Validador (2.8.0 · diseño 22): ya no es una pantalla
     paralela — vive DENTRO del padrón, como su buscador:
     validar es buscar en el padrón y en los listados, con su
     veredicto y su documento. Se monta en el padrón, tras su
     resumen (más abajo). */
  const validator = n('section', undefined, 'lists-validar280');
  validator.append(n('h3', 'Validar una empresa'),
    n('p', 'Escribe un RFC o parte del nombre: se busca en el padrón y en TODOS los listados cargados, aunque no sea tu contraparte.', 'muted'));
  const vrow = n('div', undefined, 'filterbar');
  const vinput = input('search', { placeholder: 'RFC o nombre de la empresa…', 'aria-label': 'RFC o nombre a validar' });
  const vbtn = n('button', 'Validar', 'primary');
  const vout = n('div');
  const runValidate = async () => {
    vout.replaceChildren(n('p', 'Buscando en los listados…', 'empty'));
    try {
      const result = await satApi('lists/validate', { query: vinput.value });
      vout.replaceChildren();
      if (!result.matches.length) vout.append(n('p', 'Sin coincidencias: «' + result.query + '» no aparece en ningún listado cargado.', 'empty ok-note'));
      for (const match of result.matches) {
        const row = n('div', undefined, 'cp-row');
        row.append(n('strong', match.name || match.rfc),
          n('span', match.rfc + ' · ' + match.label + ' · ' + match.detail, 'muted'),
          statusPill(match.severity === 'bad' ? 'bad' : match.severity === 'warn' ? 'warn' : 'ok',
            match.severity === 'bad' ? 'Alerta' : match.severity === 'warn' ? 'Precaución' : 'Regularizado'));
        vout.append(row);
      }
    } catch (error) { vout.replaceChildren(n('p', error.message, 'error-text')); }
  };
  vbtn.onclick = runValidate;
  vinput.onkeydown = event => { if (event.key === 'Enter') runValidate(); };
  vrow.append(vinput, vbtn);
  validator.append(vrow, vout);
  /* Padrón */
  const counts = { bad: 0, warn: 0, clean: 0 };
  for (const cp of data.counterparts) {
    if (cp.severity === 'bad') counts.bad++;
    else if (cp.severity === 'warn' || cp.severity === 'dim') counts.warn++;
    else counts.clean++;
  }
  const registry = panel('Padrón de contrapartes', 'Toda empresa que te factura o a la que facturas, más las que agregues. «Exposición» es lo que te ha facturado quien aparece en un listado: ese dinero es el que el SAT podría cuestionar. Validar una empresa es buscarla aquí, en el propio padrón.');
  const summary = n('div', undefined, 'traffic-strip');
  summary.append(statusPill(counts.bad ? 'bad' : 'ok', counts.bad + ' con alerta grave'),
    statusPill(counts.warn ? 'warn' : 'ok', counts.warn + ' con precaución'),
    statusPill('ok', counts.clean + ' sin coincidencias'),
    statusPill('dim', data.counterparts.length + ' en el padrón'));
  registry.append(summary);
  registry.append(validator);
  /* Imprimir el padrón tal cual se ve (2.0.1 · nº 2): el mismo
     patrón de imprimirVista201 — membrete y la lista en
     pantalla, con su estado en los listados y su exposición. */
  if (typeof imprimirVista201 === 'function') {
    const imprimirPadron = n('button', 'Imprimir el padrón', 'soft');
    imprimirPadron.type = 'button';
    imprimirPadron.onclick = () => imprimirVista201('Listas negras · padrón de contrapartes',
      'El padrón cruzado con los listados oficiales cargados, tal cual se ve en pantalla.',
      ['Contraparte', 'RFC', 'Estado en los listados', 'En qué lista consta', 'Te ha facturado'],
      data.counterparts.map(cp => [cp.name || cp.rfc, cp.rfc,
        cp.severity === 'bad' ? 'En lista · grave' : cp.severity === 'warn' ? 'En lista' :
          cp.severity === 'dim' ? 'En lista · menor' : cp.severity === 'ok' ? 'Regularizada' : 'Limpia',
        (cp.hits || []).map(hit => hit.label + ': ' + hit.detail).join(' · '),
        cp.exposure?.receivedCount ? money(cp.exposure.received) + ' en ' + cp.exposure.receivedCount + ' CFDI' : '']));
    registry.append(imprimirPadron);
  }
  const addRow = n('div', undefined, 'filterbar');
  const addBtn = n('button', 'Agregar contraparte', 'soft');
  addBtn.onclick = () => counterpartDialog();
  const bulkFile = input('file', { accept: '.csv,.xlsx,text/csv,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet' });
  bulkFile.hidden = true;
  bulkFile.onchange = async () => {
    if (!bulkFile.files[0]) return;
    try {
      const rows = await parseSpreadsheetRows(bulkFile.files[0]);
      const result = await satApi('lists/counterparts/bulk', { rows });
      LISTS_VIEW.data = result;
      toast('Carga masiva: ' + result.bulk.saved + ' guardadas, ' + result.bulk.skipped + ' omitidas (RFC no válido).', 'ok');
      render();
    } catch (error) { toast(error.message, 'error'); }
  };
  const bulkBtn = n('button', 'Importar Excel o CSV (Nombre · RFC · Nota)', 'soft');
  bulkBtn.onclick = () => bulkFile.click();
  addRow.append(addBtn, bulkBtn, bulkFile);
  registry.append(addRow);
  for (const cp of data.counterparts) {
    const row = n('div', undefined, 'cp-row clickable');
    const main = n('div', undefined, 'cp-main');
    main.append(n('strong', cp.name || cp.rfc),
      n('span', cp.rfc + (cp.kind ? ' · ' + cp.kind : '') + (cp.source === 'cfdi' ? ' · detectada en tus CFDI' : cp.source === 'perfil' ? ' · tu empresa' : ''), 'muted'));
    if (cp.note) main.append(n('span', cp.note, 'muted'));
    for (const hit of cp.hits) main.append(n('span', hit.label + ': ' + hit.detail, 'cp-hit sev-' + hit.severity));
    if (cp.exposure && cp.exposure.receivedCount)
      main.append(n('span', 'Te ha facturado ' + money(cp.exposure.received) + ' en ' + cp.exposure.receivedCount + ' CFDI' +
        (cp.detalle?.recibidos?.primera ? ' · primero el ' + listaFecha(cp.detalle.recibidos.primera) +
          ' · último el ' + listaFecha(cp.detalle.recibidos.ultima) : ''), 'muted'));
    /* Cifras por dirección y saldo (1.13.1): lo emitido a un cliente
       y lo que aún te debe, del mismo payload que calcula el
       servidor desde los CFDI guardados y los saldos de Dinero. */
    const det = cp.detalle;
    if (det?.emitidos)
      main.append(n('span', 'Le has facturado ' + money(det.emitidos.total) + ' en ' + det.emitidos.count + ' CFDI' +
        (det.emitidos.primera ? ' · primero el ' + listaFecha(det.emitidos.primera) +
          ' · último el ' + listaFecha(det.emitidos.ultima) : ''), 'muted'));
    if (det?.saldoPorCobrar)
      main.append(n('span', det.saldoPorCobrar.facturas ?
        'Saldo por cobrar: ' + money(det.saldoPorCobrar.total) + ' · ' + det.saldoPorCobrar.facturas + ' factura(s) pendiente(s)' :
        'Sin saldo pendiente de cobro', det.saldoPorCobrar.facturas ? 'cp-hit sev-warn' : 'muted'));
    /* «Qué significa para ti» (1.13.1): la explicación en lenguaje
       claro según (lista, situación, rol), con las cifras de esta
       misma tarjeta — la respuesta vive en la pantalla, no en un
       correo ni en la memoria de nadie. */
    if (cp.hits.length) {
      const hit = cp.hits.find(candidate => candidate.severity === cp.severity) || cp.hits[0];
      const rol = cp.kind === 'Cliente' ? 'cliente' : cp.kind === 'Propio' ? 'propio' : 'proveedor';
      const significado = n('details', undefined, 'seal-details cp-significado');
      significado.append(n('summary', 'Qué significa para ti'));
      significado.append(problemCard(problemSpec('lista', {
        generico: cp.generico, listId: hit.listId, label: hit.label, detail: hit.detail, rol,
        dinero: det?.recibidos ? money(det.recibidos.total) : '', cfdiCount: det?.recibidos?.count || 0,
        saldo: det?.saldoPorCobrar?.facturas ? money(det.saldoPorCobrar.total) : '' })));
      main.append(significado);
    }
    row.append(main,
      statusPill(cp.severity === 'bad' ? 'bad' : cp.severity === 'warn' ? 'warn' : cp.severity === 'dim' ? 'dim' : 'ok',
        cp.severity === 'bad' ? 'En lista · grave' : cp.severity === 'warn' ? 'En lista' :
        cp.severity === 'dim' ? 'En lista · menor' : cp.severity === 'ok' ? 'Regularizada' : 'Limpia'));
    /* (2.9.9 · D2) UN solo botón de acciones por fila: el ⋯,
       con TODAS las acciones de antes dentro, mismas palabras
       y mismo efecto: «Ver sus CFDI» (1.13.1: Facturas filtrado
       por esta contraparte), «Constancia», «Expediente legal»
       (1.25.0, AGREGAR 6: el ZIP armado por el servidor; hace
       falta el contribuyente seleccionado, scope) y, en las
       manuales, «Editar» y «Quitar» (con su confirmación). */
    const itC = [];
    const push = (label, fn, danger) => itC.push({ label, fn, danger });
    if (cp.detalle && (cp.detalle.recibidos || cp.detalle.emitidos))
      push('Ver sus CFDI', () => verCfdiDeContraparte(cp));
    push('Constancia', () => printListsCertificate(cp, data.sources));
    push('Expediente legal', async () => {
      try {
        check(scope, 'Elige arriba el contribuyente: el expediente es de un RFC tuyo con esta contraparte.');
        const dataExp = await satApi('salidas/expediente', { rfc: scope, contraparte: cp.rfc });
        download(new Blob([Uint8Array.from(atob(dataExp.content), c => c.charCodeAt(0))], { type: dataExp.type }), dataExp.name);
        toast('Expediente de ' + (cp.name || cp.rfc) + ' descargado.', 'ok');
      } catch (error) { toast(error.message, 'error'); }
    });
    if (cp.source === 'manual') {
      push('Editar', () => counterpartDialog(cp));
      push('Quitar', async () => {
        /* Confirmación con el diálogo propio (2.9.7 · D4). */
        dialog('Quitar del padrón manual',
          [n('p', '¿Quitar a ' + cp.rfc + ' del padrón manual? Seguirá apareciendo si tiene CFDI tuyos.')],
          async () => { await satApi('lists/counterparts/remove', { rfc: cp.rfc }); await loadLists(); }, 'Quitar'); }, true);
    }
    const mC = cardMenu1312('Más opciones de esta contraparte');
    mC._setItems1312(itC);
    row.append(mC);
    registry.append(row);
  }
  if (!data.counterparts.length) registry.append(n('p', 'El padrón se llena solo con tus CFDI; también puedes agregar empresas a mano.', 'empty'));
  wrap.append(registry);
  /* Cambios */
  const eventsPanel = panel('Cambios detectados', 'Cada vez que un listado cambia para una de tus contrapartes queda anotado aquí y llega un aviso por correo.');
  if (!data.events.length) eventsPanel.append(n('p', 'Todavía no hay cambios: la primera descarga deja la línea base de tu padrón.', 'empty'));
  for (const event of data.events) {
    const row = n('div', undefined, 'cp-row');
    row.append(n('span', localDateTime(event.at), 'muted'),
      n('strong', event.rfc),
      n('span', event.label + ' · ' + event.change + (event.detail ? ' · ' + event.detail : '')));
    eventsPanel.append(row);
  }
  /* (2.9.16 · P4) El histórico de cambios va plegado tras el
     padrón: es consulta de archivo, no trabajo del día. */
  wrap.append(plegable290('Cambios detectados', eventsPanel, 'listas-cambios2916'));
  return [wrap];
}
/* Fecha corta de un día ISO («2026-11-03» → «3 nov 2026») sin pasar
   por Date: un día suelto no debe moverse por la zona horaria. */
const LISTA_MESES = ['ene', 'feb', 'mar', 'abr', 'may', 'jun', 'jul', 'ago', 'sep', 'oct', 'nov', 'dic'];
function listaFecha(iso) {
  const match = /^(\d{4})-(\d{2})-(\d{2})$/.exec(String(iso || ''));
  return match ? Number(match[3]) + ' ' + LISTA_MESES[Number(match[2]) - 1] + ' ' + match[1] : String(iso || '');
}
/* Salto a la evidencia (1.13.1): Facturas filtrado por el RFC de la
   contraparte usando el buscador de siempre (el término casa contra
   nombre, RFC y UUID de cada fila) y la dirección si solo tiene una. */
function verCfdiDeContraparte(cp) {
  term = cp.rfc; month = ''; invoiceKind = ''; invoiceState = ''; invoicePayState = '';
  direction = cp.detalle?.emitidos && !cp.detalle?.recibidos ? 'Emitidos' :
    cp.detalle?.recibidos && !cp.detalle?.emitidos ? 'Recibidos' : 'Todos';
  invoicePage = 0;
  navigate('invoices');
}
function counterpartDialog(existing = null) {
  const nameInput = input('text', { value: existing?.name || '', placeholder: 'Nombre o razón social' });
  const rfcInput = input('text', { value: existing?.rfc || '', placeholder: 'RFC' });
  const kindSelect = n('select');
  for (const kind of ['', 'Cliente', 'Proveedor', 'Ambos']) {
    const option = n('option', kind || 'Sin clasificar'); option.value = kind;
    if ((existing?.kind || '') === kind) option.selected = true;
    kindSelect.append(option);
  }
  const noteInput = input('text', { value: existing?.note || '', placeholder: 'Nota (opcional)' });
  /* Calendario de pago (1.7.4, criterio 6): con día de pago y/o plazo,
     el Centro de Avisos solo pregunta tras vencer ESE calendario;
     sin calendario manda la regla general (30/60 días). */
  const payDayInput = input('number', { value: existing?.payDay ?? '', min: '1', max: '31', placeholder: 'Ej. 10' });
  const payTermsInput = input('number', { value: existing?.payTerms ?? '', min: '0', max: '365', placeholder: 'Ej. 30' });
  dialog(existing ? 'Editar contraparte' : 'Agregar contraparte',
    [field('Nombre', nameInput), field('RFC', rfcInput), field('Tipo', kindSelect), field('Nota', noteInput),
     field('Día de pago (del mes, opcional)', payDayInput), field('Plazo en días desde la factura (opcional)', payTermsInput),
     n('p', 'El aviso de cobro/pago de esta contraparte solo nace cuando vence su calendario, y nace preguntando. Vacío = regla general.', 'muted')],
    async () => {
      await satApi('lists/counterparts', { rfc: rfcInput.value.trim().toUpperCase(),
        name: nameInput.value.trim(), kind: kindSelect.value, note: noteInput.value.trim(),
        payDay: payDayInput.value === '' ? null : Number(payDayInput.value),
        payTerms: payTermsInput.value === '' ? null : Number(payTermsInput.value) });
      await loadLists();
      toast('Contraparte guardada y cruzada con los listados.', 'ok');
    }, existing ? 'Guardar cambios' : 'Agregar y validar');
}
/* Lectura de hoja (CSV nativo o XLSX con el lector ZIP propio, sin
   librerías): columnas Nombre · RFC · Nota (y Tipo si viene). */
function splitCsvText(text) {
  const rows = []; let row = [], cell = '', quoted = false;
  for (let i = 0; i < text.length; i++) {
    const ch = text[i];
    if (quoted) {
      if (ch === '"') { if (text[i + 1] === '"') { cell += '"'; i++; } else quoted = false; }
      else cell += ch;
    } else if (ch === '"') quoted = true;
    else if (ch === ',' || ch === ';') { row.push(cell); cell = ''; }
    else if (ch === '\n' || ch === '\r') {
      if (ch === '\r' && text[i + 1] === '\n') i++;
      row.push(cell); cell = ''; rows.push(row); row = [];
    } else cell += ch;
  }
  if (cell || row.length) { row.push(cell); rows.push(row); }
  return rows.filter(r => r.some(c => String(c).trim()));
}
async function parseSpreadsheetRows(file) {
  const bytes = new Uint8Array(await file.arrayBuffer());
  let grid;
  if (/\.xlsx$/i.test(file.name)) {
    let shared = [], sheet = '';
    for await (const entry of zipEntries(bytes, /\.xml$/)) {
      if (/sharedStrings\.xml$/.test(entry.name)) {
        const doc = new DOMParser().parseFromString(decodeXml(entry.content), 'text/xml');
        shared = [...doc.querySelectorAll('si')].map(si => [...si.querySelectorAll('t')].map(t => t.textContent).join(''));
      }
      if (/worksheets\/sheet1\.xml$/.test(entry.name)) sheet = decodeXml(entry.content);
    }
    if (!sheet) throw new Error('No se encontró la primera hoja del libro.');
    const doc = new DOMParser().parseFromString(sheet, 'text/xml');
    grid = [...doc.querySelectorAll('row')].map(row => [...row.querySelectorAll('c')].map(cell => {
      const value = cell.querySelector('v')?.textContent || cell.querySelector('is t')?.textContent || '';
      return cell.getAttribute('t') === 's' ? (shared[Number(value)] || '') : value;
    }));
  } else {
    grid = splitCsvText(new TextDecoder('utf-8').decode(bytes).replace(/^﻿/, ''));
  }
  if (!grid.length) throw new Error('La hoja está vacía.');
  const header = grid[0].map(cell => String(cell).normalize('NFD').replace(/[̀-ͯ]/g, '').trim().toLowerCase());
  const hasHeader = header.some(cell => /nombre|rfc|nota|tipo/.test(cell));
  const col = (names, fallback) => { const i = header.findIndex(cell => names.includes(cell)); return hasHeader && i >= 0 ? i : fallback; };
  const ci = { name: col(['nombre', 'nombre o razon social', 'razon social'], 0), rfc: col(['rfc'], 1),
    note: col(['nota', 'notas'], 2), kind: col(['tipo'], 3) };
  return grid.slice(hasHeader ? 1 : 0).map(row => ({
    name: String(row[ci.name] || ''), rfc: String(row[ci.rfc] || ''),
    note: String(row[ci.note] || ''), kind: String(row[ci.kind] || '') }))
    .filter(row => row.rfc.trim());
}
function bytesToBase64(bytes) {
  let out = '';
  for (let i = 0; i < bytes.length; i += 0x8000) out += String.fromCharCode(...bytes.subarray(i, i + 0x8000));
  return btoa(out);
}
/* Constancia de validación por empresa: documento imprimible con la
   fecha, los listados consultados y el resultado. */
function printListsCertificate(cp, sources) {
  const section = $('print-report');
  section.replaceChildren();
  const head = n('div', undefined, 'report-head');
  head.append(n('h1', 'Constancia de validación en listados del SAT'),
    n('p', installName + ' · ' + localDateTime(Date.now())));
  const body = n('div', undefined, 'report-body');
  body.append(n('p', 'Empresa validada: ' + (cp.name || cp.rfc) + ' (' + cp.rfc + ')' + (cp.kind ? ' · ' + cp.kind : '')));
  const table = n('table', undefined, 'report-table');
  const thead = n('thead'); const htr = n('tr');
  for (const label of ['Listado oficial', 'Última descarga', 'Registros', 'Resultado']) htr.append(n('th', label));
  thead.append(htr); table.append(thead);
  const tbody = n('tbody');
  for (const source of sources) {
    const hit = cp.hits.find(item => item.listId === source.id);
    const tr = n('tr');
    tr.append(n('td', source.label),
      n('td', source.fetched ? localDateTime(source.fetched) : 'Sin cargar'),
      n('td', source.count ? source.count.toLocaleString('es-MX') : '—'),
      n('td', hit ? 'CONSTA: ' + hit.detail : 'Sin coincidencias'));
    tbody.append(tr);
  }
  table.append(tbody);
  body.append(table);
  if (cp.exposure && cp.exposure.receivedCount)
    body.append(n('p', 'Exposición registrada: te ha facturado ' + money(cp.exposure.received) + ' en ' + cp.exposure.receivedCount + ' CFDI.'));
  body.append(n('p', cp.hits.length ?
    'RESULTADO: la empresa CONSTA en al menos un listado oficial (ver detalle en la tabla). Esta constancia refleja los listados en la fecha de su última descarga indicada.' :
    'RESULTADO: la empresa NO consta en ninguno de los listados oficiales consultados en la fecha de su última descarga indicada.'));
  body.append(n('p', 'Generada por PacoSAT desde los listados oficiales publicados por el SAT (datos abiertos). No sustituye la consulta directa en el portal del SAT.'));
  section.append(head, body, reportFoot(cp.rfc));
  setTimeout(() => window.print(), 80);
}
