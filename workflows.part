function enviarPregunta232() {
  const botones = document.querySelectorAll ? document.querySelectorAll('main button') : [];
  for (const b of botones)
    if ((b.textContent || '').trim() === 'Preguntar') { b.click(); return true; }
  const q = document.querySelector('main input[type="text"]');
  if (q) q.focus();
