async function addPerson() {
  await requireStorage();
  const name = input('text', { required: true, maxLength: 120, placeholder: 'Nombre o razón social' });
  const id = input('text', { required: true, maxLength: 13, placeholder: 'RFC de 12 o 13 caracteres' });
  const note = n('p', '', 'rfc-note');
  const confirmDigit = input('checkbox');
  const confirmField = field('Guardar aunque el dígito verificador no cuadre', confirmDigit);
  confirmField.hidden = true;
  const hint = 'Al escribir se revisan la estructura, la fecha y el dígito verificador oficial. ' +
    'La revisión es de forma: no confirma que el RFC exista en el SAT.';
  const paint = () => {
    const result = validateRfc(id.value);
    confirmField.hidden = !(result.level === 'digit' && !result.generic);
    if (!id.value.trim()) { note.dataset.state = 'info'; note.textContent = hint; }
    else if (result.level === 'structure') { note.dataset.state = 'error'; note.textContent = result.error; }
    else if (result.generic) {
      note.dataset.state = 'info';
      note.textContent = 'Es uno de los RFC genéricos del SAT (público en general u operaciones con extranjeros): ' +
        'se acepta con esta nota y no se le exige el dígito verificador.';
    } else if (result.level === 'digit') {
      note.dataset.state = 'warn';
      note.textContent = 'El dígito verificador no cuadra: para esta base debería ser «' + result.digitExpected + '» y trae «' +
        result.rfc.slice(-1) + '». Casi siempre es una errata al teclear. Revisa el RFC y, solo si estás seguro de que así consta, ' +
        'marca la casilla para guardarlo de todos modos.';
    } else {
      note.dataset.state = 'ok';
      note.textContent = 'Válido en forma: estructura, fecha y dígito verificador correctos (' +
        (result.type === 'fisica' ? 'persona física' : 'persona moral') + '). Esto no confirma que el RFC exista en el SAT.';
    }
    return result;
  };
  id.oninput = () => { confirmDigit.checked = false; paint(); };
  dialog('Agregar contribuyente', [field('Nombre o razón social', name), field('RFC', id), note, confirmField], async () => {
    const rfc = id.value.trim().toUpperCase(), label = name.value.trim();
    check(label, 'Escribe un nombre o razón social.');
    const result = validateRfc(rfc);
    check(result.level !== 'structure', result.error);
    check(result.generic || result.level !== 'digit' || confirmDigit.checked,
      'El dígito verificador no cuadra (debería ser «' + result.digitExpected + '»). Corrige el RFC o marca la casilla «Guardar aunque el dígito verificador no cuadre».');
    check(!await readStore('people', rfc), 'Ese RFC ya está en tu cartera.');
    await writeBatch({ people: [{ id: rfc, name: label }] });
    scope = rfc;
    await refresh(); announce('Expediente creado para ' + rfc + '.');
    /* Siguiente paso visible (UX-24): el alta no termina en el Resumen
       sin guía; se ofrecen las dos acciones naturales del expediente.
       Se difiere un instante porque el propio diálogo del alta se está
       cerrando al terminar este envío. */
    setTimeout(() => {
      const next = n('div', undefined, 'actions');
      next.append(action('Importar sus XML/ZIP', () => { $('dialog').close(); chooseImport(); }, 'primary', 'up'),
        action('Autorizar su e.firma', () => { $('dialog').close(); if (typeof unlockDialog === 'function') unlockDialog(rfc); }, undefined, 'lock'));
      dialog('Expediente creado · ' + rfc, [n('p', '¿Qué sigue? Importa los XML que ya tengas de este RFC o autoriza su e.firma para que PacoSAT descargue solo.'), next]);
    }, 80);
  }, 'Agregar contribuyente');
  paint();
}
/* Mantenimiento de cartera (UX-07, 1.6.11): renombrar contribuyentes y
   eliminar o desvincular documentos, siempre con confirmación clara y
   asiento en la bitácora. Sin papelera: por eso se avisa antes. */
async function renamePerson(person) {
  const name = input('text', { required: true, maxLength: 120, value: person.name });
  dialog('Renombrar contribuyente', [n('p', 'El RFC ' + person.id + ' no cambia; solo el nombre visible en PacoSAT.'),
    field('Nombre o razón social', name)], async () => {
    check(name.value.trim(), 'Escribe un nombre o razón social.');
    await writeBatch({ people: [{ id: person.id, name: name.value.trim() }] });
    await refresh(); announce('Contribuyente renombrado a «' + name.value.trim() + '».');
  }, 'Renombrar');
}
/* Papelera de documentos (2.9.0 · Bloque C): el botón de la
   lista de Documentos YA NO borra — mueve a la papelera
   (marca en el registro; el PDF se queda guardado) y desde
   Archivo se restaura o se elimina de verdad. Así la palabra
   y el hecho coinciden con «los documentos no se borran». */
function papeleraDocumento290(doc) {
  dialog('Mover a la papelera', [n('p', '«' + doc.name + '» (' + doc.kind + ' · ' + doc.rfc + ') sale de Documentos y queda en la papelera de Archivo. ' +
    'No se borra nada: desde Archivo lo restauras cuando quieras, y solo ahí se puede eliminar de verdad.')], async () => {
    await writeBatch({ documents: [{ ...doc, papelera: Date.now() }] });
    await logEvent('Documento a la papelera: ' + doc.name);
    await refresh(); announce('Documento en la papelera: lo restauras desde Archivo.');
  }, 'Mover a la papelera');
}
function deleteDocument(doc) {
  dialog('Eliminar documento para siempre', [n('p', 'Se eliminará «' + doc.name + '» (' + doc.kind + ' · ' + doc.rfc + ') del expediente, con su PDF. ' +
    'Esto SÍ es para siempre: no hay vuelta atrás. Si dudas, déjalo en la papelera o crea antes un respaldo cifrado.')], async () => {
    await deleteStoreRecords('documents', [doc.id]);
    await deleteStoreRecords('files', [doc.id]);
    await logEvent('Documento eliminado para siempre: ' + doc.name);
    await refresh(); announce('Documento eliminado para siempre.');
  }, 'Eliminar para siempre');
}
function unlinkDocument(doc) {
  dialog('Desvincular PDF del CFDI', [n('p', '«' + doc.name + '» dejará de estar vinculado al folio ' + doc.uuid + '. El PDF se queda en el expediente.')], async () => {
    await writeBatch({ documents: [{ ...doc, uuid: '' }] });
    await logEvent('PDF desvinculado: ' + doc.name);
    await refresh(); announce('PDF desvinculado del CFDI.');
  }, 'Desvincular');
}
async function chooseImport() {
  await requireStorage();
  check(people.length, 'Agrega un RFC antes de importar.');
  if (!importing) $('incoming').click();
}
async function importBatch(source, requiredRfc = scope, { quiet = false, fromFolder = false } = {}) {
  if (importing) return;
  try { await requireStorage(); }
  catch (error) { if (quiet) throw error; announce(error.message, true); return; }
  /* Modo carpeta (1.7.4, pieza 1): la estructura tipo OneFacture
     (Emitidos/Recibidos/año/mes) entra por el MISMO pipeline; lo que no
     es XML/ZIP no se descarta en silencio: se anota como «no procesado»
     con su motivo y sale en el resumen fijo. */
  const allFiles = [...source];
  const files = allFiles.filter(file => /\.(xml|zip)$/i.test(file.name));
  const skipped = fromFolder
    ? allFiles.filter(file => !/\.(xml|zip)$/i.test(file.name)).slice(0, 20)
        .map(file => ({ name: file.name.slice(0, 180), reason: 'No es un XML ni un ZIP de CFDI: no se procesó.' }))
    : [];
  if (!files.length) return announce(fromFolder && skipped.length
    ? 'La carpeta no trae XML ni ZIP de CFDI (' + skipped.length + ' archivos de otro tipo, sin procesar).'
    : 'Elige archivos .xml o .zip con CFDI.', true);
  if (!people.length) return announce('Agrega primero los RFC que quieres importar.', true);
  importing = true;
  $('primary').disabled = true;
  /* Indicador global persistente: contador real por entradas (los ZIP
     suman sus entradas al total en cuanto se abre su directorio). */
  let totalUnits = files.length, doneUnits = 0;
  if (!quiet) activityStart(fromFolder ? 'Importando carpeta de comprobantes' : 'Importando comprobantes', totalUnits);
  let added = 0, duplicates = 0, review = 0, scopeRejected = 0;
  let nuevosEmitidos = 0, nuevosRecibidos = 0;
  const nuevosPorMes = new Map();
  const dupIds = [];
  const issues = [];
  const pending = new Map();
  const known = scopes();
  const seen = new Set((await readStore('invoices').catch(() => invoices)).map(row => row.id));
  /* CFDI de retenciones (2.4.0 · WC3b, ítem 14): su propio carril
     dentro de la misma importación — se clasifican por la raíz, se
     parsean con su parser y se guardan como documentos de su tipo,
     deduplicados por identidad y huella contra lo ya archivado. */
  const retConocidas = (await readStore('documents').catch(() => []))
    .filter(doc => doc && doc.kind === 'CFDI de retenciones');
  let addedRet = 0, duplicatesRet = 0;
  const pendingRet = new Map();
  let pendingSize = 0;
  const issue = (name, error) => {
    review++;
    if (issues.length < 20) issues.push({ name: name.slice(0, 180), reason: error.message.slice(0, 320) });
  };
  async function flush() {
    if (pendingRet.size) {
      await writeBatch({ documents: [...pendingRet.values()].map(item => item.row), files: [...pendingRet.values()].map(item => item.file) });
      addedRet += pendingRet.size;
      for (const item of pendingRet.values()) retConocidas.push(item.row);
      pendingRet.clear();
    }
    if (!pending.size) return;
    await writeBatch({ invoices: [...pending.values()].map(item => item.row), files: [...pending.values()].map(item => item.file) });
    added += pending.size;
    pending.clear();
    pendingSize = 0;
  }
  async function acceptRetenciones(name, xml) {
    let parsed;
    try {
      parsed = parseRetenciones(xml);
      check(!requiredRfc || parsed.from.rfc === requiredRfc || parsed.to.rfc === requiredRfc,
        'No corresponde a ' + requiredRfc + '. Emisor ' + parsed.from.rfc + ' · Receptor ' + parsed.to.rfc + '.');
      check(known.has(parsed.from.rfc) || known.has(parsed.to.rfc), 'Los RFC del documento de retenciones no están registrados.');
    } catch (error) {
      if (String(error.message).startsWith('No corresponde a')) scopeRejected++;
      issue(name, error); return;
    }
    const hash = await sha256Hex(xml);
    if (retencionesEsDuplicada(retConocidas, parsed, hash) ||
        retencionesEsDuplicada([...pendingRet.values()].map(item => item.row), parsed, hash)) { duplicatesRet++; return; }
    const dueno = requiredRfc && (parsed.from.rfc === requiredRfc || parsed.to.rfc === requiredRfc) ? requiredRfc :
      known.has(parsed.from.rfc) ? parsed.from.rfc : parsed.to.rfc;
    const row = retencionesDocRow(parsed, hash, dueno, 'importacion');
    pendingRet.set(row.id, { row, file: { id: row.id, blob: new Blob([xml], { type: 'application/xml' }) } });
    if (pendingRet.size >= 100) await flush();
  }
  async function accept(name, xml) {
    /* La clasificación manda: un CFDI de retenciones no se rechaza
       como Comprobante mal formado ni se archiva como tal. */
    if (clasificaDocumentoXml(xml) === 'retenciones') { await acceptRetenciones(name, xml); return; }
    let row;
    try {
      row = withFiscal(parseXml(xml), xml);
      /* Huella de importación (2.4.0 · WC3b, ítem 20): el SHA-256
         del fichero tal como entró; la ficha lo recalcula sobre el
         XML guardado y lo compara contra esta huella. */
      row.xmlHash = await sha256Hex(xml);
      check(!requiredRfc || row.from.rfc === requiredRfc || row.to.rfc === requiredRfc,
        'No corresponde a ' + requiredRfc + '. Emisor ' + row.from.rfc + ' · Receptor ' + row.to.rfc + '.');
      check(known.has(row.from.rfc) || known.has(row.to.rfc), 'Los RFC del comprobante no están registrados.');
    } catch (error) {
      /* UX-03: si hay un RFC seleccionado, avisar cuántos archivos se
         fueron a revisión SOLO por el alcance, para que no parezca que
         «desaparecieron» facturas de otros RFC. */
      if (String(error.message).startsWith('No corresponde a')) scopeRejected++;
      issue(name, error); return;
    }
    if (seen.has(row.id)) { duplicates++; if (dupIds.length < 50) dupIds.push(row.id); return; }
    seen.add(row.id);
    /* Desglose del resumen fijo: dirección y mes de cada nuevo. */
    if (known.has(row.from.rfc)) nuevosEmitidos++; else if (known.has(row.to.rfc)) nuevosRecibidos++;
    const monthKey = String(row.date || '').slice(0, 7);
    if (/^\d{4}-\d{2}$/.test(monthKey)) nuevosPorMes.set(monthKey, (nuevosPorMes.get(monthKey) || 0) + 1);
    pending.set(row.id, { row, file: { id: 'xml:' + row.id, blob: new Blob([xml], { type: 'application/xml' }) } });
    pendingSize += xml.length;
    if (pending.size >= 100 || pendingSize >= 12 * MB) await flush();
  }
  try {
    for (let i = 0; i < files.length; i++) {
      const file = files[i];
      if (!quiet) announce('Importando ' + (i + 1) + ' de ' + files.length + ' · ' + file.name);
      if (/\.xml$/i.test(file.name)) {
        if (file.size > 8 * MB) { issue(file.name, new Error('El XML supera 8 MB.')); doneUnits++; if (!quiet) activityProgress(doneUnits, file.name); continue; }
        let xml;
        try { xml = bytes(await file.arrayBuffer()); }
        catch (error) { issue(file.name, error); doneUnits++; if (!quiet) activityProgress(doneUnits, file.name); continue; }
        await accept(file.name, xml);
        doneUnits++;
        if (!quiet) activityProgress(doneUnits, file.name);
      } else {
        if (file.size > 80 * MB) { issue(file.name, new Error('El ZIP supera 80 MB.')); doneUnits++; if (!quiet) activityProgress(doneUnits, file.name); continue; }
        /* El ZIP cuenta como UNA unidad hasta abrir su directorio:
           entonces el total crece con sus entradas XML reales y el
           contador pasa a ser por comprobante (meta.total). */
        const meta = {};
        let zip;
        try { zip = zipXml(bytes(await file.arrayBuffer()), meta); }
        catch (error) { issue(file.name, error); doneUnits++; if (!quiet) activityProgress(doneUnits, file.name); continue; }
        let count = 0, expanded = false;
        while (true) {
          let entry;
          try { entry = await zip.next(); }
          catch (error) { issue(file.name, error); break; }
          if (!expanded && meta.total) {
            expanded = true;
            totalUnits += meta.total - 1;
            if (!quiet) activitySetTotal(totalUnits);
          }
          if (entry.done) {
            if (!count) issue(file.name, new Error('El ZIP no contiene CFDI XML.'));
            break;
          }
          count++;
          await accept(entry.value.name, entry.value.xml);
          doneUnits++;
          if (!quiet) activityProgress(doneUnits, file.name + ' · ' + entry.value.name);
        }
        if (expanded && count < meta.total) {
          /* El ZIP se interrumpió a mitad: el contador cierra el hueco
             para que la barra termine en el total anunciado. */
          doneUnits += meta.total - count;
          if (!quiet) activityProgress(doneUnits, file.name);
        }
        if (!expanded) { doneUnits++; if (!quiet) activityProgress(doneUnits, file.name); }
      }
    }
    await flush();
    await writeBatch({ activity: [{
      id: crypto.randomUUID(), name: files.length === 1 ? files[0].name.slice(0, 180) : files.length + ' archivos',
      date: new Date().toISOString(), added, duplicates, review, issues
    }] });
    if (!quiet) {
      /* Tarjeta de resultado persistente (UX-13): el resumen vive en el
         Resumen («Última importación») además del aviso superior. */
      lastImport = { at: Date.now(), added, duplicates, review, dupIds };
      announce(added + ' nuevos · ' + duplicates + ' duplicados · ' + review + ' por revisar' +
        (addedRet ? ' · ' + addedRet + ' CFDI de retenciones nuevos (en Documentos, como su tipo)' : '') +
        (duplicatesRet ? ' · ' + duplicatesRet + ' CFDI de retenciones duplicados' : '') +
        (scopeRejected ? '\n' + scopeRejected + ' archivo(s) no corresponden al RFC seleccionado (' + requiredRfc + ') y quedaron por revisar: cambia el contribuyente a ese RFC para importarlos.' : '') +
        (issues.length ? '\n' + issues.slice(0, 6).map(item => item.name + ' · ' + item.reason).join('\n') : ''), Boolean(review));
      if (!review) soundCue('success'); else if (added) soundCue('notice');
      /* Resumen FIJO (1.7.4, pieza 1): en importaciones grandes, con
         problemas o con archivos sin procesar, el resultado queda en
         pantalla hasta que el usuario lo cierra — nada de avisos
         fugaces para 2.493 comprobantes. */
      const esGrande = totalUnits >= 10 || review > 0 || skipped.length > 0 || addedRet > 0 || duplicatesRet > 0;
      if (esGrande) {
        const lines = [];
        lines.push(added
          ? number.format(added) + ' comprobantes nuevos (' + number.format(nuevosEmitidos) + ' emitidos · ' + number.format(nuevosRecibidos) + ' recibidos).'
          : 'Sin comprobantes nuevos.');
        if (nuevosPorMes.size) {
          const top = [...nuevosPorMes.entries()].sort((a, b) => b[0].localeCompare(a[0])).slice(0, 4);
          lines.push('Por mes: ' + top.map(([mes, n]) => mes + ': ' + number.format(n)).join(' · ') + (nuevosPorMes.size > 4 ? ' · …' : ''));
        }
        if (addedRet) lines.push(number.format(addedRet) + ' CFDI de retenciones nuevos: quedan en Documentos como su propio tipo («CFDI de retenciones»), con su ficha.');
        if (duplicatesRet) lines.push(number.format(duplicatesRet) + ' CFDI de retenciones duplicados: ya estaban en el expediente (misma identidad o misma huella) y no se tocaron.');
        if (duplicates) lines.push(number.format(duplicates) + ' duplicados: ya estaban en PacoSAT y no se tocaron.');
        if (review) {
          lines.push('Atención: ' + number.format(review) + ' por revisar — no entraron. Motivo de los primeros:');
          for (const item of issues.slice(0, 6)) lines.push('· ' + item.name + ' — ' + item.reason);
          if (scopeRejected) lines.push(number.format(scopeRejected) + ' no corresponden al RFC seleccionado (' + requiredRfc + '): cambia el contribuyente a ese RFC y vuelve a importarlos.');
          lines.push('Qué hacer: corrige el archivo o el RFC indicado y vuelve a importar solo esos; los demás ya están dentro.');
        }
        if (skipped.length) {
          lines.push('Sin procesar (' + skipped.length + '): no son XML ni ZIP de CFDI.');
          for (const item of skipped.slice(0, 6)) lines.push('· ' + item.name + ' — ' + item.reason);
        }
        activityDone('Procesado', lines);
      } else activityFinish();
    }
    return { added, duplicates, review };
  } catch (error) {
    announce(added + ' comprobantes guardados antes de interrumpir el lote. ' + error.message, true);
    if (!quiet) activityFail('La importación se interrumpió', added + ' comprobantes quedaron guardados antes de la interrupción. ' + error.message);
    if (quiet) throw error;
  } finally {
    importing = false;
    $('primary').disabled = !ready;
    try { await refresh(quiet && page === 'sat'); } catch (error) { announce(error.message, true); }
  }
}
async function addDocument() {
  await requireStorage();
  check(people.length, 'Agrega un RFC antes de archivar documentos.');
  const taxpayer = select(people.map(p => [p.id, p.name + ' · ' + p.id]), scope || people[0].id);
  const kind = select(DOCUMENTS.map(x => [x, x]), DOCUMENTS[0]);
  const date = input('date', { required: true });
  const period = input('text', { maxLength: 40, placeholder: 'Ej. Octubre 2026' });
  const picker = input('file', { required: true, accept: '.pdf' });
  dialog('Archivar PDF', [field('Contribuyente', taxpayer), field('Tipo de documento', kind), field('Fecha', date),
    field('Periodo, si aplica', period), field('Archivo', picker)], async () => {
    const file = picker.files[0];
    check(await pdfOk(file), 'Elige un PDF de hasta 15 MB.');
    const id = 'pdf:' + crypto.randomUUID();
    await writeBatch({ documents: [{ id, rfc: taxpayer.value, kind: kind.value, date: date.value, period: period.value.trim(), name: file.name.slice(0, 180) }],
      files: [{ id, blob: new Blob([file], { type: 'application/pdf' }) }] });
    docFilter = '';
    if (scope && scope !== taxpayer.value) scope = taxpayer.value;
    await refresh();
    await logEvent('PDF archivado · ' + kind.value + ' · ' + taxpayer.value);
    announce('PDF archivado en ' + taxpayer.value + '.');
  });
}
const TAX_NAMES = { '001': 'ISR', '002': 'IVA', '003': 'IEPS' };
const taxLabel = code => TAX_NAMES[code] || code;
async function copyText(text, label) {
  try { await navigator.clipboard.writeText(text); announce(label + ' copiado al portapapeles.'); }
  catch { announce('No se pudo copiar automáticamente; selecciona el texto y cópialo manualmente.', true); }
}
/* Visor CFDI profesional (1.6.7): la tarjeta resumen se queda arriba y
   debajo va la representación completa parseada del XML guardado —
   cabecera, partes, conceptos con impuestos, totales con desglose,
   timbre con sellos plegables, Pagos 2.0 y demás complementos — con el
   estado de la vigilancia, la historia, y las acciones de copiar UUID,
   descargar el XML, abrir el PDF vinculado e imprimir el comprobante. */
function cfdiPrint(row, full, opts = {}) {
  const section = $('print-report');
  /* Impresión por lote (1.6.16): opts.append añade el comprobante al
     documento en curso y opts.print=false difiere la impresión. */
  if (!opts.append) section.replaceChildren();
  /* Defecto corregido (1.13.1, visto por Paco el 10 nov): «Imprimir
     comprobante» desde el detalle entregaba una captura del propio
     diálogo — botones, la X y la barra de desplazamiento — porque
     el diálogo modal vive en la capa superior y Chrome imprime ESA
     capa, no el #print-report. Se cierra el diálogo antes de
     imprimir (y el CSS de impresión lo oculta además), para que el
     papel sea solo la representación del comprobante. */
  if (opts.print !== false) { const dlg = $('dialog'); if (dlg?.open) dlg.close(); }
  const head = n('div', undefined, 'report-head');
  if (appSettings.logoData) {
    const logo = n('img', undefined, 'report-logo');
    logo.src = appSettings.logoData;
    logo.alt = '';
    head.append(logo);
  }
  head.append(n('div', (appSettings.installName || 'PacoSAT') + ' · COMPROBANTE FISCAL', 'hero-kicker'),
    n('h1', KINDS[full.kind] + (full.serie || full.folio ? ' ' + [full.serie, full.folio].filter(Boolean).join('-') : '')),
    n('p', full.emisor.nombre + ' (' + full.emisor.rfc + ') → ' + full.receptor.nombre + ' (' + full.receptor.rfc + ')' +
      ' · ' + full.fecha + (full.timbre ? ' · Folio fiscal ' + full.timbre.uuid : ' · Sin timbre fiscal'), 'report-meta'));
  section.append(head);
  /* Emisor y receptor como bloques propios (1.13.1): nombre, RFC,
     régimen y CP de cada parte, como en una representación impresa
     de verdad — no fundidos en una fila de «Receptor». */
  const parties = n('div', undefined, 'print-parties');
  for (const [label, party, cp] of [['EMISOR', full.emisor, full.lugarExpedicion], ['RECEPTOR', full.receptor, full.receptor.domicilioFiscal]]) {
    const box = n('div', undefined, 'print-party');
    box.append(n('small', label), n('strong', party.nombre || party.rfc),
      n('span', 'RFC ' + party.rfc),
      n('span', 'Régimen fiscal ' + (party.regimen || '—')),
      n('span', 'CP ' + (cp || '—') + (party === full.receptor && full.receptor.usoCfdi ? ' · Uso de CFDI ' + full.receptor.usoCfdi : '')));
    parties.append(box);
  }
  section.append(parties);
  const fields = n('div');
  fields.append(grid(['Dato', 'Valor'], [
    ['Fecha de emisión', full.fecha], ['Lugar de expedición', full.lugarExpedicion || '—'],
    ['Forma / método de pago', [full.formaPago, full.metodoPago].filter(Boolean).join(' / ') || '—'],
    ['Moneda', full.moneda + (full.tipoCambio ? ' · TC ' + full.tipoCambio : '')],
    ['Nº de certificado del emisor', full.noCertificado || '—']
  ]));
  section.append(fields);
  const concepts = n('div');
  concepts.append(grid(['Descripción', 'Cantidad', 'Unidad', 'V. unitario', 'Importe'],
    full.conceptos.map(c => [c.descripcion, c.cantidad, c.unidad || c.claveUnidad, '$' + c.valorUnitario, '$' + c.importe])));
  section.append(concepts);
  const totals = [['Subtotal', '$' + full.subTotal]];
  if (full.descuento) totals.push(['Descuento', '−$' + full.descuento]);
  for (const t of full.impuestos.traslados) totals.push([taxLabel(t.impuesto) + ' trasladado ' + (t.tasa ? t.tasa + ' ' + t.tipoFactor : t.tipoFactor), '$' + t.importe]);
  for (const t of full.impuestos.retenciones) totals.push([taxLabel(t.impuesto) + ' retenido', '−$' + t.importe]);
  totals.push(['Total', '$' + full.total + ' ' + full.moneda]);
  const totalsWrap = n('div');
  totalsWrap.append(grid(['Totales', 'Importe'], totals));
  section.append(totalsWrap);
  if (full.timbre) {
    const timbre = n('div', undefined, 'report-note print-seals');
    timbre.append(n('p', 'Timbre Fiscal Digital · UUID ' + full.timbre.uuid + ' · Timbrado ' + full.timbre.fechaTimbrado +
      ' · PAC ' + full.timbre.rfcProvCertif + ' · Certificado SAT ' + full.timbre.noCertificadoSAT),
      n('p', 'Sello del CFDI: ' + full.timbre.selloCfd),
      n('p', 'Sello del SAT: ' + full.timbre.selloSat),
      n('p', 'Cadena original: ' + full.timbre.cadenaOriginal));
    section.append(timbre);
  }
  /* Línea final de estado en PacoSAT (1.13.1), claramente separada
     del cuerpo fiscal: qué dice el SAT de este comprobante y cómo
     está su pago según Dinero. Es información de gestión, no parte
     del documento fiscal, y va rotulada como tal. */
  if (row) {
    const estado = n('div', undefined, 'print-estado');
    let textoSat = 'Sin revisar todavía';
    try { textoSat = monitorStateInfo(row).badge; } catch { /* sin vigilancia a mano */ }
    let textoPago = '';
    try { if (row.kind === 'I') textoPago = visorEstadoPago(row, paidByMap()).label; } catch { /* sin Dinero a mano */ }
    estado.append(n('p', 'Estado en PacoSAT (no forma parte del documento fiscal) — Estado en el SAT: ' + textoSat +
      (textoPago ? ' · Estado de pago: ' + textoPago : '')));
    section.append(estado);
  }
  if (opts.print !== false) setTimeout(() => window.print(), 120);
}
/* ===== Línea de tiempo VISUAL del CFDI (2.4.0 · W5b2, pieza 6) =====
   Los pasos de la vida de la factura —emitido → pagado → REP →
   cancelado— pintados en su ficha, solo los que le aplican:
   una vigente no enseña «cancelado» y una PPD sin pagar se
   queda en «emitido». Cada paso lleva su fecha REAL de la
   ficha misma: la emisión de la fila, la fechaPago de su
   complemento, la fecha del propio REP (el CFDI de pago) y,
   si consta, la fecha en que la vigilancia vio la cancelación.
   Lo que no conste dice «sin fecha»: ninguna fecha se inventa.
   Función pura sobre (factura, todos los CFDI, contexto): la
   suite la fija con facturas de juguete. */
function cfdiLineaDatos240(row, todos, ctx = {}) {
  if (!row || row.kind !== 'I') return [];
  const pasos = [{ clave: 'emitido', etiqueta: 'Emitido', estado: 'hecho', fecha: row.date || null }];
  const reps = (todos || []).filter(doc => doc && doc.kind === 'P' && doc.fiscal?.payments &&
    (doc.fiscal.payments.pagos || []).some(pago => (pago.documentos || []).some(d => d.idDocumento === row.id)));
  let fechaPago = null, pagadoCents = 0n;
  for (const rep of reps)
    for (const pago of rep.fiscal.payments.pagos || [])
      for (const doc of pago.documentos || [])
        if (doc.idDocumento === row.id) {
          pagadoCents += typeof moneyCents === 'function' ? moneyCents(doc.impPagado) : 0n;
          if (pago.fechaPago && (!fechaPago || pago.fechaPago > fechaPago)) fechaPago = pago.fechaPago;
        }
  const esPue = row.fiscal?.paymentMethod === 'PUE';
  const total = typeof totalCents === 'function' ? totalCents(row) : 0n;
  const pagada = esPue || (total > 0n && pagadoCents >= total) || Boolean(ctx.marcada);
  if (esPue) pasos.push({ clave: 'pagado', etiqueta: 'Pagado', estado: 'hecho', fecha: row.date || null });
  else if (pagada) pasos.push({ clave: 'pagado', etiqueta: 'Pagado', estado: 'hecho', fecha: fechaPago || null });
  else if (pagadoCents > 0n) pasos.push({ clave: 'pagado', etiqueta: 'Pagado', estado: 'pendiente', fecha: fechaPago || null });
  if (reps.length) {
    const fechaRep = reps.map(rep => rep.date || '').filter(Boolean).sort().pop() || null;
    pasos.push({ clave: 'rep', etiqueta: 'REP (complemento de pago)', estado: 'hecho', fecha: fechaRep });
  }
  if (ctx.cancelada)
    pasos.push({ clave: 'cancelado', etiqueta: 'Cancelado', estado: 'hecho', fecha: ctx.fechaCancelacion || null });
  return pasos;
}
/* La fecha de un paso, en palabra: fecha real formateada o
   «sin fecha» — nunca una fecha aproximada. */
function cfdiLineaFecha240(fecha) {
  if (!fecha) return 'sin fecha';
  if (typeof fecha === 'number') return typeof fmtFechaCorta === 'function' ? fmtFechaCorta(fecha) : String(fecha);
  const texto = String(fecha);
  return texto.length >= 10 && typeof dateLabel === 'function' ? dateLabel(texto.slice(0, 10)) : texto;
}
/* El pintado: cada paso con su estado en icono + palabra +
   color (data-estado de W5a: hecho = al día; pendiente =
   esperando) y su fecha debajo. */
function cfdiLineaVisual240(pasos) {
  const box = n('div');
  box.dataset.lineaCfdi240 = '1';
  box.append(n('h3', 'Línea de tiempo'));
  const fila = n('div', undefined, 'linea240');
  for (const paso of pasos || []) {
    const celda = n('div', undefined, 'linea240-paso');
    celda.dataset.paso240 = paso.clave;
    const chip = n('span', paso.estado === 'hecho' ? 'Hecho' : 'Pendiente', 'estado240');
    chip.dataset.estado = paso.estado === 'hecho' ? 'aldia' : 'esperando';
    celda.append(n('strong', paso.etiqueta), chip, n('small', cfdiLineaFecha240(paso.fecha)));
    fila.append(celda);
  }
  box.append(fila);
  return box;
}
/* ===== El Lector de XML (2.9.7 · Pieza B) =====
   Al abrir un comprobante, su vista primera es el XML LEÍDO
   por el servidor (GET /api/cfdi/lectura?uuid=): protagonista
   con el total, conceptos con sus impuestos, impuestos
   trasladados y retenidos, forma y método de pago, uso CFDI,
   moneda, el timbre en despliegue progresivo y el complemento
   de pagos cuando lo trae. Si la lectura responde sinXml, la
   hoja lo dice en llano y ofrece «Bajar ahora» por el portal
   (POST /api/portal-cfdi/run { rfc, uuids:[uuid], origen:
   'factura' }), con su progreso vivo y su Cancelar; al
   terminar bien, la lectura se vuelve a pedir y se enseña.
   Todo lo que el detalle hacía ya (resumen, nota, saldo, la
   representación completa desde el XML local, la historia y
   los botones de XML/PDF/ZIP/enviar) se conserva intacto
   debajo: el Lector se suma, nada se pierde. */
function lectorImpuestosConcepto297(concepto) {
  const listas = [...(concepto?.impuestos?.traslados || concepto?.traslados || []),
    ...(concepto?.impuestos?.retenidos || concepto?.retenciones || [])];
  const partes = listas.map(t => (t.impuesto || t.nombre || 'Impuesto') +
    (t.tasa ? ' ' + t.tasa : '') + (t.importe ? ' $' + t.importe : ''));
  if (typeof concepto?.impuestos === 'string' && concepto.impuestos) partes.push(concepto.impuestos);
  return partes.join(' · ');
}
function lectorPintar297(body, lectura, row) {
  body.replaceChildren();
  const tipoTexto = (typeof KINDS !== 'undefined' && KINDS[lectura.tipo]) || lectura.tipo || row.kind || '';
  const estadoTexto = lectura.estado || (typeof invoiceStateOf === 'function' ? invoiceStateOf(row) : '') || '';
  const prota = n('div', undefined, 'invoice-summary lector-prota297');
  prota.dataset.lectorProtagonista297 = '1';
  const cabeza = n('div');
  cabeza.append(n('span', tipoTexto, 'period-chip'),
    n('h3', '$' + (lectura.total ?? '') + (lectura.moneda ? ' ' + lectura.moneda : '')),
    n('p', (lectura.emisor?.nombre || lectura.emisor?.rfc || '') + ' → ' +
      (lectura.receptor?.nombre || lectura.receptor?.rfc || '') + ' · ' +
      (lectura.fecha || '') + (estadoTexto ? ' · ' + estadoTexto : '')));
  prota.append(cabeza);
  body.append(prota);
  const conceptos = Array.isArray(lectura.conceptos) ? lectura.conceptos : [];
  if (conceptos.length) {
    const tabla = n('div', undefined, 'table-wrap');
    tabla.dataset.lectorConceptos297 = '1';
    tabla.append(grid(['Cantidad', 'Descripción', 'Precio', 'Importe', 'Impuestos'],
      conceptos.map(c => [String(c.cantidad ?? ''), String(c.descripcion || ''),
        '$' + (c.valorUnitario ?? c.precio ?? ''), '$' + (c.importe ?? ''),
        lectorImpuestosConcepto297(c) || '—'])));
    body.append(tabla);
  } else body.append(n('p', 'Este comprobante no trae conceptos en su lectura.', 'timeline-empty'));
  const facts = n('div', undefined, 'facts');
  const fact = (label, value) => { if (value === undefined || value === null || value === '') return;
    const box = n('div'); box.append(n('small', label), n('strong', String(value))); facts.append(box); };
  fact('Forma de pago', lectura.formaPago);
  fact('Método de pago', lectura.metodoPago);
  fact('Uso de CFDI', lectura.receptor?.uso);
  fact('Moneda', lectura.moneda);
  fact('Subtotal', lectura.subTotal !== undefined ? '$' + lectura.subTotal : '');
  fact('Descuento', lectura.descuento ? '−$' + lectura.descuento : '');
  const imp = lectura.impuestos || {};
  const sumaImp = lista => (lista || []).reduce((suma, t) => suma + (Number(t.importe) || 0), 0);
  fact('Total impuestos trasladados', imp.totalTrasladados ?? imp.trasladadosTotal ??
    ((imp.traslados || []).length ? '$' + sumaImp(imp.traslados).toFixed(2) : ''));
  fact('Total impuestos retenidos', imp.totalRetenidos ?? imp.retenidosTotal ??
    ((imp.retenidos || []).length ? '$' + sumaImp(imp.retenidos).toFixed(2) : ''));
  body.append(facts);
  for (const [titulo, lista, signo] of [['Impuestos trasladados', imp.traslados, '$'],
      ['Impuestos retenidos', imp.retenidos, '−$']]) {
    if (!(lista || []).length) continue;
    const wrapImp = n('div', undefined, 'table-wrap');
    wrapImp.append(grid([titulo, 'Importe'], lista.map(t => [
      (t.impuesto || t.nombre || 'Impuesto') + (t.tasa ? ' ' + t.tasa : '') + (t.tipoFactor ? ' ' + t.tipoFactor : ''),
      signo + (t.importe ?? '')])));
    body.append(wrapImp);
  }
  if (lectura.timbre) {
    const timbre = lectura.timbre;
    const detalles = n('details', undefined, 'seal-details lector-timbre297');
    detalles.dataset.lectorTimbre297 = '1';
    detalles.append(n('summary', 'Ver timbre'));
    const tfacts = n('div', undefined, 'facts');
    const tfact = (label, value) => { if (!value) return;
      const box = n('div'); box.append(n('small', label), n('strong', String(value))); tfacts.append(box); };
    tfact('UUID', timbre.uuid);
    tfact('Fecha de timbrado', timbre.fechaTimbrado);
    tfact('PAC', timbre.rfcProvCertif);
    tfact('Certificado del SAT', timbre.noCertificadoSAT);
    detalles.append(tfacts);
    for (const [label, value] of [['Sello del CFDI', timbre.selloCfd], ['Sello del SAT', timbre.selloSat],
        ['Cadena original', timbre.cadenaOriginal]]) {
      if (!value) continue;
      detalles.append(n('small', label), n('pre', String(value), 'xml-view'));
    }
    body.append(detalles);
  }
  const pagosLista = Array.isArray(lectura.pagos) ? lectura.pagos
    : Array.isArray(lectura.pagos?.pagos) ? lectura.pagos.pagos : [];
  if (pagosLista.length) {
    const pagosBox = n('div');
    pagosBox.dataset.lectorPagos297 = '1';
    pagosBox.append(n('h3', 'Complemento de pagos'));
    for (const pago of pagosLista) {
      pagosBox.append(n('p', 'Pago del ' + (pago.fechaPago || '') + ' · Forma ' + (pago.formaDePagoP || '—') +
        ' · ' + (pago.monto ? '$' + pago.monto + ' ' + (pago.monedaP || '') : 'Sin monto') +
        (pago.numOperacion ? ' · Operación ' + pago.numOperacion : '')));
      const docs = pago.documentos || pago.documentosRelacionados || [];
      if (docs.length) {
        const tablaDocs = n('div', undefined, 'table-wrap');
        tablaDocs.append(grid(['Documento (UUID)', 'Folio', 'Parcialidad', 'Saldo anterior', 'Pagado', 'Saldo insoluto'],
          docs.map(d => [String(d.idDocumento || d.uuid || ''), [d.serie, d.folio].filter(Boolean).join('-') || '—',
            String(d.numParcialidad ?? ''), '$' + (d.impSaldoAnt ?? ''), '$' + (d.impPagado ?? ''),
            '$' + (d.impSaldoInsoluto ?? '')])));
        pagosBox.append(tablaDocs);
      }
    }
    const totalPagos = lectura.pagos?.totales?.MontoTotalPagos;
    if (totalPagos) pagosBox.append(n('p', 'Monto total de pagos: $' + totalPagos));
    body.append(pagosBox);
  }
}
function lectorSeccion297(row) {
  const box = n('section', undefined, 'invoice-concepts lector297');
  box.dataset.lector297 = '1';
  box.append(n('h3', 'Lector del comprobante'));
  const body = n('div');
  body.append(n('p', 'Leyendo el XML…', 'timeline-empty'));
  box.append(body);
  const rfc = (typeof scope !== 'undefined' && scope) || row.to?.rfc || row.from?.rfc || '';
  const cargar = async () => {
    body.replaceChildren(n('p', 'Leyendo el XML…', 'timeline-empty'));
    try {
      const data = await lectorLectura297(row.id);
      const lectura = data?.lectura || null;
      if (!lectura) throw new Error('La lectura no trajo datos del comprobante.');
      lectorPintar297(body, lectura, row);
    } catch (error) {
      if (error?.data?.sinXml) {
        body.replaceChildren();
        body.append(n('p', 'Este comprobante está detectado por metadatos pero su XML aún no está en tu expediente', 'report-note'));
        const prog = n('div');
        const bajar = action('Bajar ahora', async () => {
          bajar.disabled = true;
          await portalLanzar297(prog, { rfc, uuids: [row.id], origen: 'factura' }, (ok, state, runError) => {
            if (ok) cargar();
            else prog.append(n('p', 'La bajada no terminó: ' +
              (runError ? runError.message : portalMotivo297(state)), 'error-text'));
          });
        }, 'primary', 'down');
        bajar.dataset.lectorBajar297 = '1';
        const acts = n('div', undefined, 'actions');
        acts.append(bajar);
        body.append(acts, prog);
      } else {
        body.replaceChildren(n('p', 'No se pudo leer el XML desde el servidor: ' + error.message, 'timeline-empty'));
      }
    }
  };
  if (typeof satToken !== 'undefined' && satToken) cargar();
  else body.replaceChildren(n('p', 'El Lector vive en el servidor: abre PacoSAT desde el servidor de tu casa para leer el XML aquí.', 'timeline-empty'));
  return box;
}
function invoiceDetail(row) {
  const summary = n('div', undefined, 'invoice-summary');
  const headline = n('div');
  headline.append(n('span', rowRole(row), 'period-chip'), n('h3', amount(row)), n('p', KINDS[row.kind] + ' · ' + dateLabel(row.date)));
  const parties = n('div', undefined, 'invoice-parties');
  for (const [label, party] of [['EMISOR', row.from], ['RECEPTOR', row.to]]) {
    const box = n('div');
    box.append(n('small', label), n('strong', party.name || party.rfc), n('span', party.rfc));
    parties.append(box);
  }
  /* El folio fiscal va en su bloque con la etiqueta ENCIMA
     (2.9.0 · Bloque C): con cell() a secas, el UUID y la
     etiqueta salían pegados («…6235Folio fiscal»). */
  const folioBloque290 = n('div', undefined, 'facts');
  const folioCelda290 = n('div');
  folioCelda290.append(n('small', 'Folio fiscal'), n('strong', row.id, 'rescue-folios'));
  folioBloque290.append(folioCelda290);
  summary.append(headline, parties, folioBloque290);
  /* (2.9.13 · mejora 8) El visor dibuja la factura COMO
     DOCUMENTO: su desglose en renglones — subtotal, IVA y el
     total en grande — con el marco de documento de la clase
     factura-doc2913. El desglose sale del XML guardado
     (invoiceIvaBaseCents/invoiceIvaCents); sin desglose no se
     dibuja la tabla: no se estima nada. */
  summary.classList.add('factura-doc2913');
  {
    const base2913 = typeof invoiceIvaBaseCents === 'function' ? invoiceIvaBaseCents(row) : null;
    const iva2913 = typeof invoiceIvaCents === 'function' ? invoiceIvaCents(row) : null;
    if (base2913 !== null && iva2913 !== null) {
      const desglose2913 = n('div', undefined, 'factura-desglose2913');
      const renglon2913 = (etiqueta, cents, grande = false) => {
        const r = n('div', undefined, 'factura-renglon2913' + (grande ? ' total' : ''));
        r.append(n('span', etiqueta), n('strong', '$' + centsLabel(cents)));
        return r;
      };
      desglose2913.append(renglon2913('Subtotal', base2913),
        renglon2913('IVA', iva2913),
        renglon2913('Total', totalCents(row), true));
      summary.append(desglose2913);
    }
  }
  summary.append(statusCell(row.id));
  /* Nota pegada al comprobante (F12, 1.31.0): texto libre de Paco
     sobre ESTE CFDI («esto es la renta de diciembre»). Vive en el
     servidor (tabla cfdi_notas), jamás toca el XML, y viaja en el
     Excel de facturas. Sin servidor no hay nota que guardar y no
     se finge un editor local. */
  if (satToken) {
    const notaSlot = n('div', undefined, 'actions');
    summary.append(notaSlot);
    const pintarNota = notaActual => {
      if (!notaSlot.isConnected && notaActual === undefined) return;
      notaSlot.replaceChildren();
      const input = document.createElement('input');
      input.type = 'text'; input.maxLength = 500;
      input.placeholder = 'Nota sobre este comprobante (opcional)';
      input.value = notaActual || '';
      input.style.flex = '1'; input.style.minWidth = '220px';
      const guardar = n('button', notaActual ? 'Guardar nota' : 'Añadir nota', 'soft small');
      guardar.type = 'button';
      guardar.onclick = async () => {
        guardar.disabled = true; guardar.textContent = 'Guardando…';
        try {
          const r = await satApi('cfdi/nota', { uuid: row.id, nota: input.value });
          toast(r.nota ? 'Nota guardada en el comprobante.' : 'Nota retirada del comprobante.', 'ok');
          pintarNota(r.nota);
        } catch (error) { toast(error.message, 'error'); guardar.disabled = false; guardar.textContent = 'Guardar nota'; }
      };
      notaSlot.append(input, guardar,
        n('span', 'Tu nota sobre este comprobante: se ve aquí y en el Excel de facturas.', 'muted'));
    };
    pintarNota('');
    satApi('cfdi/notas').then(data => {
      if (notaSlot.isConnected) pintarNota((data.notas || {})[row.id] || '');
    }).catch(() => {});
  }
  /* Saldo y «Marcar pagada» en el propio detalle (1.18.0): la
     factura dice si está pagada, parcial o pendiente y cuánto
     falta; el gesto vive aquí y no solo en Dinero, y se deshace. */
  if (row.kind === 'I') {
    const paidByDetail = paidByMap();
    const pagoDetalle = visorEstadoPago(row, paidByDetail);
    const saldoDetalle = balanceOf(row, paidByDetail).balance;
    summary.append(n('p', 'Estado de pago: ' + pagoDetalle.label +
      (saldoDetalle > 0n ? ' · Saldo $' + centsLabel(saldoDetalle) : ''), 'report-note'));
    /* «Revertir pago» persistente (1.23.0, D1): si el pago consta
       marcado A MANO, la ficha enseña el botón siempre — no solo
       unos segundos en la barra de «Deshacer». Fuente de verdad:
       /api/money (la misma que Dinero ya consume en
       dineroServerInfo): su «paid» suma complementos + marca
       manual, mientras el cálculo local (paidByMap) solo conoce
       complementos y PUE; un pagado del servidor mayor que el
       local, sin ser PUE, es la marca manual. Lo marcado en esta
       sesión (visorMarcados/dineroMarcados) también cuenta. */
    if (satToken) {
      const revertSlot = n('div', undefined, 'actions');
      summary.append(revertSlot);
      const pintarRevertir = () => {
        revertSlot.replaceChildren();
        const boton = n('button', 'Revertir pago', 'soft small');
        boton.type = 'button';
        boton.onclick = async () => {
          boton.disabled = true; boton.textContent = 'Revirtiendo…';
          try {
            /* Respuesta perdida = resultado desconocido: se
               re-lee /api/money y solo se declara error si el
               saldo sigue en cero (la marca seguiría puesta). */
            await satApiGuardar('money/unmark-paid', { uuid: row.id }, async () => {
              const data = await satApi('money');
              const entry = (data.balances || []).find(item => item.id === row.id);
              return Boolean(entry && Number(entry.balance) > 0);
            });
            visorMarcados.delete(row.id);
            dineroMarcados.delete(row.id);
            dineroServerCargado = false;
            document.querySelector('dialog')?.close();
            render();
            invoiceDetail(row);
            announce('Pago revertido: vuelve a estar por pagar');
          } catch (error) { toast(error.message, 'error'); boton.disabled = false; boton.textContent = 'Revertir pago'; }
        };
        revertSlot.append(boton,
          n('span', 'Este pago consta marcado a mano: revertirlo lo vuelve a dejar por pagar.', 'muted'));
      };
      if (visorMarcados.has(row.id) || dineroMarcados.has(row.id)) pintarRevertir();
      else satApi('money').then(data => {
        const entry = (data.balances || []).find(item => item.id === row.id);
        if (!entry || !revertSlot.isConnected) return;
        const localPaid = Number(centsPlain(balanceOf(row, paidByDetail).paid));
        if (entry.method !== 'PUE' && Number(entry.paid) > localPaid + 0.001) pintarRevertir();
      }).catch(() => {});
    }
    if (satToken && saldoDetalle > 0n) {
      const payActs = n('div', undefined, 'actions');
      /* F1 (1.22.0): el mismo «Ya se pagó» de Dinero, también en la
         ficha — un toque, sin pedir cómo se pagó, con Deshacer. */
      payActs.append(action('Ya se pagó', async () => {
        await satApi('money/mark-paid', { uuid: row.id });
        visorMarcados.add(row.id);
        document.querySelector('dialog')?.close();
        render();
        toastUndo('Marcada como pagada.', async () => {
          await satApi('money/unmark-paid', { uuid: row.id });
          visorMarcados.delete(row.id);
          announce('Pago deshecho: la factura vuelve a pendiente.');
          render();
        });
      }, 'primary', 'check'));
      summary.append(payActs);
    }
  }
  if (row.initialState) summary.append(n('p', 'Estado al importarse (según los metadatos del SAT): ' + row.initialState + '.', 'report-note'));
  /* El Lector es la vista al abrir (2.9.7 · Pieza B): va
     primero; el resumen y todo lo demás del detalle quedan
     debajo, intactos. */
  const contents = [lectorSeccion297(row), summary];
  /* Línea de tiempo visual (2.4.0 · W5b2, pieza 6): tras el
     resumen de la ficha, con los datos que la ficha ya carga
     —la factura, sus complementos en `invoices` y la fecha de
     la vigilancia para la cancelada—. */
  if (row.kind === 'I') {
    const vig240 = typeof fiscalResults !== 'undefined' ? fiscalResults.get(row.id) : null;
    const pasos240 = cfdiLineaDatos240(row, invoices, {
      cancelada: typeof invoiceStateOf === 'function' && invoiceStateOf(row) === 'Cancelado',
      fechaCancelacion: vig240?.sat?.checked || vig240?.checked || null,
      marcada: visorMarcados.has(row.id) || (typeof dineroMarcados !== 'undefined' && dineroMarcados.has(row.id))
    });
    if (pasos240.length) contents.push(cfdiLineaVisual240(pasos240));
  }
  const linked = documents.filter(doc => doc.kind === 'Factura PDF' && doc.uuid === row.id && (!scope || doc.rfc === scope));
  const actionsRow = n('div', undefined, 'actions');
  actionsRow.append(
    action('Copiar UUID', () => copyText(row.id, 'UUID'), undefined, 'file'),
    action('Descargar XML original', async () => {
      const file = await readStore('files', 'xml:' + row.id);
      check(file, 'Archivo no encontrado.');
      download(file.blob, row.id + '.xml');
    }, undefined, 'down'));
  /* (2.9.15 · B5) Copiar con un toque también el RFC de cada
     parte y el importe, como ya se copiaba el UUID. */
  if (row.from && row.from.rfc)
    actionsRow.append(action('Copiar RFC emisor', () => copyText(row.from.rfc, 'RFC del emisor'), undefined, 'file'));
  if (row.to && row.to.rfc)
    actionsRow.append(action('Copiar RFC receptor', () => copyText(row.to.rfc, 'RFC del receptor'), undefined, 'file'));
  actionsRow.append(action('Copiar importe', () => copyText(amount(row), 'Importe'), undefined, 'file'));
  /* Descarga a la carta (Ronda Salidas, 1.14.0): el PDF diseñado
     del comprobante lo construye el servidor desde el XML guardado
     (folio, conceptos, totales y total en letra). Sin servidor solo
     existe el XML local de siempre. */
  if (satToken) {
    const pedir = format => async event => {
      const boton = event?.currentTarget;
      if (boton) { boton.disabled = true; boton.textContent = 'Preparando…'; }
      try {
        const data = await satApi('salidas/cfdi', { id: row.id, format, rfc: scope });
        download(new Blob([decode64(data.content)], { type: data.type || 'application/octet-stream' }), data.name);
        toast('Descarga lista: ' + data.name, 'ok');
      } catch (error) { toast(error.message, 'error'); }
      finally { if (boton) { boton.disabled = false; boton.textContent = format === 'pdf' ? 'Descargar PDF' : 'XML + PDF'; } }
    };
    actionsRow.append(
      /* F2 (1.22.0): «Ver comprobante» — el PDF diseñado (con su
         QR verdadero) se abre en el visor sin descargar nada:
         ficha → un toque. */
      action('Ver comprobante', async event => {
        const boton = event?.currentTarget;
        if (boton) { boton.disabled = true; boton.textContent = 'Preparando…'; }
        try {
          const data = await satApi('salidas/cfdi', { id: row.id, format: 'pdf', rfc: scope });
          const blob = new Blob([decode64(data.content)], { type: 'application/pdf' });
          const doc = { name: data.name || ('Comprobante ' + row.id + '.pdf'), kind: 'Comprobante con QR', rfc: scope || row.to.rfc || '' };
          const dlg = document.querySelector('dialog');
          if (dlg?.open) { dlg.addEventListener('close', () => showPdfDialog(doc, blob), { once: true }); dlg.close(); }
          else showPdfDialog(doc, blob);
        } catch (error) { toast(error.message, 'error'); if (boton) { boton.disabled = false; boton.textContent = 'Ver comprobante'; } }
      }, undefined, 'eye'),
      action('Descargar PDF', pedir('pdf'), undefined, 'file'),
      action('XML + PDF', pedir('ambos'), undefined, 'down'));
    /* «Enviar» junto a las descargas de la ficha (2.4.0 ·
       W4a; W2c cablea el correo de los dos): el XML va por la
       clase «cfdi-xml» de /api/enviar — el servidor resuelve
       el file record xml:<uuid> del almacén — y el PDF del
       emisor va por {clase:'documento', id} cuando el
       documento «Factura PDF» de ESTE CFDI existe en el
       expediente (linked, el de «Ver PDF» de aquí arriba).
       Sin ese documento, el PDF queda como en W4a: solo
       WhatsApp/Compartir en esta tarjeta y su «Reenviar por
       correo» propio de siempre — ningún botón de correo que
       la ruta rechace. */
    if (typeof enviarBoton240 === 'function' && (typeof guestMode === 'undefined' || !guestMode)) {
      const notaCfdi = 'El correo de este comprobante ya tiene su camino en esta ficha («Reenviar por correo», aquí mismo). El PDF del emisor no consta como documento del expediente para este CFDI, así que por la ruta nueva no encaja: mándalo por WhatsApp o Compartir, o usa su «Reenviar por correo».';
      actionsRow.append(enviarBoton240(() => ({
        nombre: 'Comprobante ' + row.id + '.pdf',
        asunto: 'PacoSAT · Comprobante ' + row.id,
        correo: linked[0] ? { clase: 'documento', id: linked[0].id } : null,
        correoNota: linked[0] ? undefined : notaCfdi,
        archivo: () => enviarBlobSalida240('salidas/cfdi', { id: row.id, format: 'pdf', rfc: scope }) })));
      const envXml = enviarBoton240(() => ({
        nombre: row.id + '.xml',
        asunto: 'PacoSAT · XML ' + row.id,
        correo: { clase: 'cfdi-xml', uuid: row.id },
        archivo: async () => {
          const file = await readStore('files', 'xml:' + row.id);
          check(file, 'Archivo no encontrado.');
          return { blob: file.blob, nombre: row.id + '.xml' };
        } }));
      envXml.textContent = 'Enviar XML';
      envXml.prepend(icon('send'));
      actionsRow.append(envXml);
    }
  }
  for (const doc of linked) actionsRow.append(action('Ver PDF · ' + doc.rfc, () => {
    $('dialog').addEventListener('close', () => viewPdf(doc).catch(error => announce(error.message, true)), { once: true });
    $('dialog').close();
  }, undefined, 'file'));
  if (!linked.length) actionsRow.append(n('span', 'Sin PDF vinculado a este CFDI.', 'timeline-empty'));
  /* Comparador XML/PDF (2.4.0 · WC3b, ítem 15): sin el PDF DEL
     EMISOR no se ofrece comparación alguna — el PDF que diseña
     PacoSAT sale de este mismo XML y compararlo no probaría nada. */
  if (!linked.length) actionsRow.append(n('span', 'Sin PDF del emisor no hay comparación XML/PDF: el PDF que diseña PacoSAT sale de este mismo XML y compararlo no probaría nada.', 'timeline-empty'));
  /* Reenviar por correo (1.24.0, punto 11): el mismo diálogo del
     Buzón, con el dueño del comprobante (el perfil que es emisor
     o receptor) como RFC del reenvío — nunca otro. */
  if (satToken) {
    const perfilesFicha = (typeof satData !== 'undefined' && satData && satData.profiles) || [];
    const duenoFicha = [row.to?.rfc, row.from?.rfc].find(r => r && perfilesFicha.some(p => p.rfc === r)) ||
      scope || row.to?.rfc || row.from?.rfc || '';
    if (duenoFicha) actionsRow.append(action('Reenviar por correo',
      () => forwardDialog(duenoFicha, [row.id]), undefined, 'arrow'));
  }
  contents.push(actionsRow);
  /* Representación completa: se rellena al leer el XML guardado. */
  const fullSection = n('section', undefined, 'invoice-concepts');
  fullSection.append(n('h3', 'Comprobante completo'));
  const fullBody = n('div');
  fullBody.append(n('p', 'Leyendo el XML guardado…', 'timeline-empty'));
  fullSection.append(fullBody);
  contents.push(fullSection);
  (async () => {
    try {
      const file = await readStore('files', 'xml:' + row.id);
      check(file, 'El XML original no está en este equipo.');
      const rawBytes = bytes(await file.blob.arrayBuffer());
      const full = parseCfdiFull(rawBytes);
      fullBody.replaceChildren();
      const facts = n('div', undefined, 'facts');
      const fact = (label, value) => { if (!value) return; const box = n('div'); box.append(n('small', label), n('strong', value)); return box; };
      [fact('Versión', full.version), fact('Serie y folio', [full.serie, full.folio].filter(Boolean).join(' · ')),
        fact('Fecha de emisión', full.fecha), fact('Lugar de expedición', full.lugarExpedicion),
        fact('Tipo', KINDS[full.kind] + ' (' + full.tipoRaw + ')'), fact('Forma de pago', full.formaPago),
        fact('Método de pago', full.metodoPago), fact('Moneda', full.moneda + (full.tipoCambio ? ' · TC ' + full.tipoCambio : '')),
        fact('Nº de certificado', full.noCertificado), fact('Exportación', full.exportacion),
        fact('Uso de CFDI', full.receptor.usoCfdi), fact('Condiciones', full.condiciones)
      ].forEach(box => box && facts.append(box));
      const partiesFull = n('div', undefined, 'invoice-parties');
      for (const [label, party, extra] of [['EMISOR', full.emisor, 'Régimen ' + (full.emisor.regimen || '—')],
        ['RECEPTOR', full.receptor, 'Régimen ' + (full.receptor.regimen || '—') + ' · CP ' + (full.receptor.domicilioFiscal || '—')]]) {
        const box = n('div');
        box.append(n('small', label), n('strong', party.nombre || party.rfc), n('span', party.rfc), n('span', extra));
        partiesFull.append(box);
      }
      fullBody.append(facts, partiesFull);
      if (full.conceptos.length) {
        const table = n('div', undefined, 'table-wrap');
        table.append(grid(['Clave', 'Descripción', 'Cantidad', 'V. unitario', 'Importe', 'Impuestos'],
          full.conceptos.map(c => [c.claveProdServ, c.descripcion + (c.descuento ? ' (desc. $' + c.descuento + ')' : ''),
            c.cantidad + ' ' + (c.unidad || c.claveUnidad), '$' + c.valorUnitario, '$' + c.importe,
            [...c.traslados.map(t => taxLabel(t.impuesto) + ' ' + (t.tasa || '') + ' $' + t.importe),
              ...c.retenciones.map(t => taxLabel(t.impuesto) + ' ret. $' + t.importe)].join(' · ') || '—'])));
        fullBody.append(table);
      }
      const totalsRows = [['Subtotal', '$' + full.subTotal]];
      if (full.descuento) totalsRows.push(['Descuento', '−$' + full.descuento]);
      for (const t of full.impuestos.traslados) totalsRows.push([taxLabel(t.impuesto) + ' trasladado ' + (t.tasa ? t.tasa + ' ' + t.tipoFactor : t.tipoFactor), '$' + t.importe]);
      for (const t of full.impuestos.retenciones) totalsRows.push([taxLabel(t.impuesto) + ' retenido', '−$' + t.importe]);
      if (full.impuestos.totalTrasladados) totalsRows.push(['Total impuestos trasladados', '$' + full.impuestos.totalTrasladados]);
      if (full.impuestos.totalRetenidos) totalsRows.push(['Total impuestos retenidos', '−$' + full.impuestos.totalRetenidos]);
      totalsRows.push(['Total', '$' + full.total + ' ' + full.moneda]);
      const totalsWrap = n('div', undefined, 'table-wrap');
      totalsWrap.append(grid(['Totales con desglose', 'Importe'], totalsRows));
      fullBody.append(totalsWrap);
      if (full.timbre) {
        const timbreBox = n('div');
        timbreBox.append(n('h3', 'Timbre Fiscal Digital'));
        const tfacts = n('div', undefined, 'facts');
        const tfact = (label, value) => { if (!value) return; const box = n('div'); box.append(n('small', label), n('strong', value)); return box; };
        [tfact('UUID', full.timbre.uuid), tfact('Fecha de timbrado', full.timbre.fechaTimbrado),
          tfact('RFC del PAC', full.timbre.rfcProvCertif), tfact('Certificado del SAT', full.timbre.noCertificadoSAT),
          tfact('Certificado del emisor', full.noCertificado)].forEach(box => box && tfacts.append(box));
        timbreBox.append(tfacts);
        for (const [label, value] of [['Sello del CFDI', full.timbre.selloCfd], ['Sello del SAT', full.timbre.selloSat],
          ['Cadena original del timbre', full.timbre.cadenaOriginal]]) {
          const details = n('details', undefined, 'seal-details');
          const summaryEl = n('summary', label);
          const pre = n('pre', value, 'xml-view');
          details.append(summaryEl, pre, action('Copiar', () => copyText(value, label)));
          timbreBox.append(details);
        }
        fullBody.append(timbreBox);
      } else fullBody.append(n('p', 'Este comprobante no tiene Timbre Fiscal Digital (no está timbrado).', 'timeline-empty'));
      /* Semáforo de integridad (2.4.0 · WC3b, ítem 20): estructura,
         huella del fichero contra la registrada al importarlo y
         estado en el SAT según la vigilancia — solo lo comprobable,
         con lo no verificable dicho en llano (integridadCfdi). */
      const intBox = n('div');
      intBox.append(n('h3', 'Integridad del comprobante'));
      const itemVig240 = fiscalResults.get(row.id);
      const informe240 = integridadCfdi(full, { huellaRegistrada: row.xmlHash || '',
        huellaActual: await sha256Hex(rawBytes), estadoSat: itemVig240?.sat?.state || '',
        revisadoEl: itemVig240?.checked ? localDateTime(itemVig240.checked) : '' });
      intBox.dataset.integridad240 = informe240.nivel;
      intBox.append(n('p', informe240.nivel === 'verde' ? 'Semáforo verde: todo lo comprobable está bien.' :
        informe240.nivel === 'rojo' ? 'Semáforo rojo: algo de lo comprobable FALLA (va nombrado abajo).' :
        'Semáforo ámbar: falta algo por comprobar (lo que no consta va nombrado abajo).', 'report-note'));
      for (const punto of informe240.puntos) {
        const linea = n('p', punto.nombre + ': ' + punto.detalle);
        linea.dataset.punto240 = punto.nombre;
        linea.dataset.estado240 = punto.estado;
        intBox.append(linea);
      }
      intBox.append(n('p', informe240.noVerificado, 'report-note'));
      fullBody.append(intBox);
      /* Comparador XML ↔ PDF del emisor (2.4.0 · WC3b, ítem 15):
         solo cuando el expediente guarda el PDF DEL EMISOR de este
         CFDI (linked). El texto lo lee el servidor con su extractor
         de siempre (el de bank-statement, vía el índice de WC3a) y
         el contraste campo a campo lo hace compararCfdiPdf: igual,
         DIFERENTE con las dos cifras, o «no consta en el PDF». */
      if (linked.length) {
        const compBox = n('div');
        compBox.append(n('h3', 'Comparar con su PDF del emisor'));
        compBox.append(n('p', 'Este CFDI tiene archivado el PDF del emisor: su texto se contrasta campo a campo contra el XML. ' +
          'Lo que el PDF no traiga legible sale «no consta en el PDF», nunca como diferencia.', 'report-note'));
        const compResult = n('div');
        const compBtn = action('Comparar con su PDF', async () => {
          compResult.replaceChildren(n('p', 'Leyendo el PDF del emisor…', 'timeline-empty'));
          try {
            check(satToken, 'Sin servidor no se puede leer el texto del PDF: la comparación usa el lector de PDF del servidor.');
            const data = await satApi('cfdi/pdf-texto240?id=' + encodeURIComponent(linked[0].id));
            check(data.estado === 'ok' && data.texto, 'El PDF del emisor no trae texto legible: no hay campos que contrastar.');
            compResult.replaceChildren();
            for (const fila of compararCfdiPdf(full, data.texto)) {
              const linea = n('p');
              linea.dataset.campo240 = fila.campo;
              linea.dataset.estado240 = fila.estado;
              linea.append(n('strong', fila.campo + ': '),
                n('span', 'XML ' + (fila.xml || '—') + ' · PDF ' + (fila.estado === 'no-consta' ? 'no consta en el PDF' : (fila.pdf || '—')) + ' — '),
                n('strong', fila.estado === 'igual' ? 'Igual' : fila.estado === 'diferente' ? 'DIFERENTE' : 'No consta'));
              compResult.append(linea);
            }
          } catch (error) { compResult.replaceChildren(n('p', error.message, 'timeline-empty')); }
        }, undefined, 'search');
        compBox.append(compBtn, compResult);
        fullBody.append(compBox);
      }
      if (full.pagos) {
        const pagosBox = n('div');
        pagosBox.append(n('h3', 'Complemento de pagos 2.0'));
        for (const pago of full.pagos.pagos) {
          pagosBox.append(n('p', 'Pago del ' + pago.fechaPago + ' · Forma ' + (pago.formaDePagoP || '—') + ' · ' +
            (pago.monto ? '$' + pago.monto + ' ' + pago.monedaP : 'Sin monto') + (pago.numOperacion ? ' · Operación ' + pago.numOperacion : '')));
          if (pago.documentos.length) {
            const docs = n('div', undefined, 'table-wrap');
            docs.append(grid(['Documento (UUID)', 'Folio', 'Parcialidad', 'Saldo anterior', 'Pagado', 'Saldo insoluto'],
              pago.documentos.map(d => [d.idDocumento, [d.serie, d.folio].filter(Boolean).join('-') || '—', d.numParcialidad,
                '$' + d.impSaldoAnt, '$' + d.impPagado, '$' + d.impSaldoInsoluto])));
            pagosBox.append(docs);
          }
        }
        if (full.pagos.totales.MontoTotalPagos) pagosBox.append(n('p', 'Monto total de pagos: $' + full.pagos.totales.MontoTotalPagos));
        fullBody.append(pagosBox);
      }
      for (const name of full.otrosComplementos) pagosChip(fullBody, name);
      actionsRow.append(action('Imprimir comprobante', () => cfdiPrint(row, full), 'primary', 'print'));
    } catch (error) { fullBody.replaceChildren(n('p', error.message, 'timeline-empty')); }
  })();
  function pagosChip(parent, name) {
    const chip = n('p', 'Otro complemento detectado: ' + name, 'timeline-empty');
    parent.append(chip);
  }
  /* Historia del CFDI (1.6.5): línea de tiempo solo con datos guardados.
     La emisión y el PDF salen del expediente local; descargas, consultas
     de estado y avisos los aporta el servidor desde jobs y la vigilancia.
     Lo que no tenga histórico, no aparece. */
  const timelineSection = n('section', undefined, 'invoice-concepts');
  timelineSection.id = 'cfdi-timeline';
  timelineSection.append(n('h3', 'Historia del comprobante'));
  const timelineList = n('div', undefined, 'timeline');
  /* Esqueleto con la forma de la historia (2.4.0 · W5b2,
     pieza 4b): filas .sk-fila mientras llega, con su palabra
     de carga; el dato lo sustituye al pintar. */
  timelineList.setAttribute('aria-busy', 'true');
  if (typeof esqueletoPantalla240 === 'function') {
    const skelHistoria240 = esqueletoPantalla240(2);
    skelHistoria240.querySelector?.('.sk-hero')?.remove();
    timelineList.append(skelHistoria240);
  }
  timelineList.append(n('p', 'Cargando historia…', 'timeline-empty'));
  timelineSection.append(timelineList);
  contents.push(timelineSection);
  /* «Ver historia» fuera (2.3.2 · m-15): solo desplazaba
     dentro del mismo diálogo hasta la historia que ya está
     en él. La historia se queda; el botón, no. */
  (async () => {
    const events = [{ at: row.date, label: 'CFDI emitido', detail: KINDS[row.kind] + ' · ' + amount(row) }];
    for (const doc of linked) events.push({ at: null, label: 'PDF vinculado', detail: doc.name });
    if (typeof satToken !== 'undefined' && satToken) {
      try {
        const data = await satApi('invoice-history?id=' + encodeURIComponent(row.id));
        for (const event of data.events || []) if (event.kind !== 'emission' && event.kind !== 'pdf') events.push(event);
        /* Tanda 7B (2): la línea de vida completa del servidor
           (descubierto, avisos, notas, marcas, pagos, archivo).
           2.0.1 · nº 6: el hito «cancelada» se pinta como lo
           que es — con su fecha y su documento (la consulta de
           estado que la vio) — y los pasos que dejaron
           documento (descargada → su solicitud; pagada → su
           movimiento o su marca manual) llevan su enlace al
           documento, no solo el texto. */
        const vida200h = await satApi('vida200h?uuid=' + encodeURIComponent(row.id)).catch(() => null);
        for (const hito of vidaHitosVisibles232(vida200h?.hitos))
          events.push({ at: hito.at ? new Date(hito.at).toISOString() : null,
            label: hito.tipo === 'cancelada' ? 'Cancelada' : hitoTitulo232(hito.tipo),
            detail: hito.texto, hito201: hito });
      } catch { /* sin servidor o sin historia remota: se muestra la local */ }
    }
    events.sort((a, b) => (a.at || '9999').localeCompare(b.at || '9999'));
    /* El contenido real sustituye al esqueleto: la lista sale
       del estado ocupado (corrección visual 2.4.0, el mismo
       patrón que en Dinero: el contenedor que llevaba
       aria-busy es este mismo, y replaceChildren no lo
       retiraba). */
    timelineList.removeAttribute('aria-busy');
    timelineList.replaceChildren(...events.map(event => {
      const item = n('div', undefined, 'timeline-item');
      item.append(n('strong', event.label),
        n('small', (event.at ? localDateTime(Date.parse(event.at)) + ' · ' : '') + (event.detail || '')));
      const hito = event.hito201;
      if (hito?.documento) {
        const destinoCrudo = hito.enlace ||
          (hito.documento.tipo === 'solicitud-sat' ? 'sat'
            : hito.documento.tipo === 'movimiento-banco' ? 'bancos' : '');
        /* El enlace del hito de cancelación nombra la
           vigilancia; su pantalla en el cliente es «monitor». */
        const destino = destinoCrudo === 'vigilancia' ? 'monitor' : destinoCrudo;
        if (destino) {
          const ver = n('button', 'Ver el documento', 'soft small');
          ver.type = 'button';
          ver.onclick = () => {
            if (destino === 'bancos') { dineroTab = 'bancos'; navigate('money'); }
            else navigate(destino);
          };
          item.append(ver);
        }
      }
      return item;
    }));
  })();
  dialog('Detalle del CFDI', contents);
  $('dialog').classList.add('invoice-dialog');
  $('dialog').classList.add('cfdi-dialog');
}
/* Ficha básica del CFDI de retenciones (2.4.0 · WC3b, ítem 14):
   el documento vive en Documentos con su clase propia y TODOS sus
   datos parseados viajan en la fila (doc.retenciones), así que la
   ficha se pinta sin reabrir el XML; el XML original se descarga
   desde aquí. El cruce contra los CFDI normales archivados sale de
   cruceRetenciones: cuando no hay datos para cruzar, la ficha lo
   dice («sin cruce posible con lo archivado»), no finge uno. */
function retencionesDetail(doc) {
  const ret = doc.retenciones || {};
  const summary = n('div', undefined, 'invoice-summary');
  const headline = n('div');
  headline.append(n('span', 'CFDI de retenciones', 'period-chip'),
    n('h3', ret.totales?.retenido ? '$' + ret.totales.retenido + ' retenidos' : 'CFDI de retenciones'),
    n('p', 'CFDI de retenciones · ' + (doc.period || '') + (ret.folioInt ? ' · Folio interno ' + ret.folioInt : '')));
  const parties = n('div', undefined, 'invoice-parties');
  for (const [label, party] of [['EMISOR (RETENEDOR)', ret.from || {}], ['RECEPTOR (CONTRIBUYENTE)', ret.to || {}]]) {
    const box = n('div');
    box.append(n('small', label), n('strong', party.name || party.rfc || '—'), n('span', party.rfc || '—'));
    parties.append(box);
  }
  summary.append(headline, parties);
  const contents = [summary];
  const facts = n('div', undefined, 'facts');
  const fact = (label, value) => { if (!value) return; const box = n('div'); box.append(n('small', label), n('strong', value)); return box; };
  [fact('Fecha de expedición', ret.fecha ? dateLabel(ret.fecha) + ' ' + String(ret.fecha).slice(11, 16) : ''),
    fact('Periodo', doc.period),
    fact('Monto total de la operación', ret.totales?.operacion ? '$' + ret.totales.operacion : ''),
    fact('Base gravada', ret.totales?.gravado ? '$' + ret.totales.gravado : ''),
    fact('Monto exento', ret.totales?.exento ? '$' + ret.totales.exento : ''),
    fact('Total de retenciones', ret.totales?.retenido ? '$' + ret.totales.retenido : ''),
    fact('Huella SHA-256 al importarlo', doc.xmlHash || 'Sin huella de importación: no consta')]
    .forEach(box => box && facts.append(box));
  contents.push(facts);
  if (ret.detalle?.length) {
    const detalleWrap = n('div', undefined, 'table-wrap');
    detalleWrap.append(grid(['Impuesto retenido', 'Base', 'Importe retenido', 'Tipo de pago'],
      ret.detalle.map(d => [taxLabel(d.impuesto), d.base ? '$' + d.base : '—', '$' + d.monto, d.tipoPago || '—'])));
    contents.push(detalleWrap);
  }
  const cruce = cruceRetenciones(ret, invoices);
  const cruceBox = n('div');
  cruceBox.append(n('h3', 'Cruce con los CFDI normales'));
  const cruceTexto = n('p', cruce.mensaje, 'report-note');
  cruceTexto.dataset.cruce240 = cruce.estado;
  cruceBox.append(cruceTexto);
  if (cruce.detalle.length) {
    const cruceWrap = n('div', undefined, 'table-wrap');
    cruceWrap.append(grid(['Impuesto', 'En este documento', 'En los CFDI normales', 'Resultado'],
      cruce.detalle.map(fila => [taxLabel(fila.impuesto), fila.enRetenciones ? '$' + fila.enRetenciones : '—',
        fila.enCfdi ? '$' + fila.enCfdi : '—', fila.estado === 'igual' ? 'Igual' : 'DIFERENTE'])));
    cruceBox.append(cruceWrap);
  }
  contents.push(cruceBox);
  const acts = n('div', undefined, 'actions');
  acts.append(action('Descargar XML original', async () => {
    const file = await readStore('files', doc.id);
    check(file, 'Archivo no encontrado.');
    download(file.blob, (doc.name || 'CFDI de retenciones') + '.xml');
  }, undefined, 'down'));
  contents.push(acts);
  dialog('CFDI de retenciones', contents);
  $('dialog').classList.add('invoice-dialog');
}
/* ===== Línea de vida del CFDI (2.3.2 · M-7/m-14) =====
   Títulos llanos por tipo de hito: la clave interna
   («estado-sat», «emision») nunca se enseña. Y la afirmación
   del estado consultado vive UNA sola vez: en la entrada de
   la historia (con su fecha y, desde la 2.3.2, su detalle ya
   en llano del servidor); el hito «estado-sat» de la línea de
   vida contaba el mismo hecho otra vez y sale de la mezcla. */
const HITO_TITULOS232 = {
  descubierto: 'Descubierto en el SAT', emision: 'Emisión',
  descargado: 'Descargado del SAT', aviso: 'Aviso de novedades',
  correo: 'Nombrado en un correo', nota: 'Nota', pago: 'Pago',
  cancelada: 'Cancelada', marca: 'Marca a revisar',
  archivado: 'Archivado', 'estado-sat': 'Estado consultado en el SAT'
};
function hitoTitulo232(tipo) {
  return HITO_TITULOS232[tipo] || 'Línea de vida';
}
function vidaHitosVisibles232(hitos) {
  return (hitos || []).filter(hito => hito && hito.tipo !== 'estado-sat');
}
function invoiceActions(row) {
  /* (2.9.9 · D2) UN solo botón de acciones por fila: el ⋯.
     Dentro viven TODAS las acciones que la fila tenía — las
     directas de antes y las que ya estaban en el menú —, con
     las mismas palabras y el mismo efecto:
     · «Revisar ahora» (1.13.1): fuerza la revisión de ESTA
       factura en el SAT al momento. El invitado no lo ve.
     · «PDF» (1.32.1, F3): el PDF diseñado que construye el
       servidor desde el XML guardado, como en el detalle.
     · «XML»: descarga el XML guardado.
     · «Enviar» / «Enviar XML» (2.4.0 · W4a/W2c): la misma hoja
       de envío de antes (enviarTarjeta240 con las mismas
       opciones: el PDF usa {clase:'documento', id} del
       documento «Factura PDF» de este CFDI cuando existe; sin
       él, solo compartir con su nota; el XML usa «cfdi-xml»).
     · «Imprimir», «Copiar UUID», «Ver XML», «Archivar»
       (1.31.1, con su Deshacer; solo con servidor y nunca
       para el invitado) y «Compartir por correo» (7A, A7). */
  const itF = [];
  const push = (label, fn) => itF.push({ label, fn });
  if (typeof guestMode === 'undefined' || !guestMode) {
    const fb = { textContent: 'Revisar ahora', disabled: false };
    push('Revisar ahora', () => monitorCheckOne(row, fb));
  }
  const xmlFile = async () => {
    const file = await readStore('files', 'xml:' + row.id);
    check(file, 'Archivo no encontrado.');
    return file;
  };
  const bajarXml = async () => download((await xmlFile()).blob, row.id + '.xml');
  if (typeof satToken !== 'undefined' && satToken) {
    push('PDF', async () => {
      try {
        const data = await satApi('salidas/cfdi', { id: row.id, format: 'pdf', rfc: scope });
        download(new Blob([decode64(data.content)], { type: data.type || 'application/pdf' }), data.name);
      } catch (error) { toast(error.message, 'error'); }
    });
  }
  push('XML', bajarXml);
  if (typeof satToken !== 'undefined' && satToken && typeof enviarBoton240 === 'function' &&
      (typeof guestMode === 'undefined' || !guestMode)) {
    const linkedPdfFila = (typeof documents !== 'undefined' ? documents : [])
      .filter(doc => doc.kind === 'Factura PDF' && doc.uuid === row.id && (!scope || doc.rfc === scope));
    const optsPdf = () => ({
      nombre: 'Comprobante ' + row.id + '.pdf',
      asunto: 'PacoSAT · Comprobante ' + row.id,
      correo: linkedPdfFila[0] ? { clase: 'documento', id: linkedPdfFila[0].id } : null,
      correoNota: linkedPdfFila[0] ? undefined :
        'El correo de un comprobante vive en su ficha («Reenviar por correo»). El PDF del emisor no consta como documento del expediente para este CFDI, así que por la ruta nueva no encaja: mándalo por WhatsApp o Compartir desde aquí.',
      archivo: () => enviarBlobSalida240('salidas/cfdi', { id: row.id, format: 'pdf', rfc: scope }) });
    push('Enviar', () => enviarTarjeta240(optsPdf()));
    push('Enviar XML', () => enviarTarjeta240({
      nombre: row.id + '.xml',
      asunto: 'PacoSAT · XML ' + row.id,
      correo: { clase: 'cfdi-xml', uuid: row.id },
      archivo: async () => { const file = await xmlFile();
        return { blob: file.blob, nombre: row.id + '.xml' }; } }));
  }
  push('Imprimir', async () =>
    cfdiPrint(row, parseCfdiFull(bytes(await (await xmlFile()).blob.arrayBuffer()))));
  push('Copiar UUID', async () => {
      try { await navigator.clipboard.writeText(row.id); announce('UUID copiado: ' + row.id); }
      catch { announce('No se pudo copiar al portapapeles en este navegador.', true); }
    });
  push('Ver XML', async () => viewXml((await xmlFile()).blob, row.id + '.xml'));
  if ((typeof guestMode === 'undefined' || !guestMode) &&
    typeof satToken !== 'undefined' && satToken &&
    typeof cfdiArchivar1311 === 'function') {
    push('Archivar', () => cfdiArchivar1311(row)
      .catch(error => announce(error.message, true)));
  }
  if (typeof satToken !== 'undefined' && satToken && typeof ensureLazyPart === 'function') {
    push('Compartir por correo', () =>
      ensureLazyPart('salidas').then(() => { if (typeof compartir200g === 'function') compartir200g('cfdi', row.id); }));
  }
  const menuFila = cardMenu1312('Más opciones de esta factura');
  menuFila._setItems1312(itF);
  return menuFila;
}
async function viewXml(file, name) {
  check(file.size && file.size <= 8 * MB, 'El visor admite XML de hasta 8 MB.');
  const raw = bytes(await file.arrayBuffer());
  let text, encodingError;
  try { text = decodeXml(raw); }
  catch { text = new TextDecoder().decode(raw); encodingError = 'No se pudo leer la codificación declarada. Se muestra una lectura aproximada.'; }
  const fields = [n('p', name)];
  if (encodingError) fields.push(n('p', encodingError));
  else {
    try {
      const row = parseXml(raw);
      fields.push(cell(row.from.name || row.from.rfc, 'Emisor · ' + row.from.rfc),
        cell(row.to.name || row.to.rfc, 'Receptor · ' + row.to.rfc), cell(row.id, 'UUID · ' + amount(row)));
      const known = scopes();
      if (!known.has(row.from.rfc) && !known.has(row.to.rfc)) fields.push(n('p', 'Para importarlo, agrega el RFC del emisor o del receptor que corresponda a tu expediente.'));
      else {
        /* Sin callejón sin salida (UX-15): si el comprobante encaja en
           la cartera, se importa desde el propio visor. */
        fields.push(action('Importar este XML', async () => {
          $('dialog').close();
          await importBatch([new File([file], name || 'comprobante.xml', { type: 'application/xml' })]);
        }, 'primary', 'up'));
      }
    } catch (error) { fields.push(n('p', 'Revisión del importador · ' + error.message)); }
  }
  const viewer = n('pre', text, 'xml-view');
  viewer.tabIndex = 0;
  viewer.setAttribute('aria-label', 'Código XML original');
  fields.push(viewer);
  dialog('Visor XML', fields);
}
function reviewDetail(row) {
  const fields = [n('p', row.name + ' · ' + row.review + ' por revisar')];
  if (row.issues?.length) {
    const list = n('ul');
    for (const item of row.issues) list.append(n('li', item.name + ' · ' + item.reason));
    fields.push(list);
    if (row.issues.length < row.review) fields.push(n('p', 'Se muestran los primeros ' + row.issues.length + ' motivos del lote.'));
  } else fields.push(n('p', 'Este lote se registró antes de que PacoSAT guardara los motivos. Abre el XML original para revisarlo.'));
  dialog('Revisión de importación', fields);
}
function csvText(rows) {
  const escape = value => {
    const text = String(value);
    const safe = /^[\s\uFEFF]*[=+\-@]|^[\t\r\n]/u.test(text) ? "'" + text : text;
    return '"' + safe.replaceAll('"', '""') + '"';
  };
  return [['UUID', 'Emisor', 'RFC emisor', 'Receptor', 'RFC receptor', 'Fecha', 'Tipo', 'Total', 'Moneda'],
    ...rows.map(x => [x.id, x.from.name, x.from.rfc, x.to.name, x.to.rfc, x.date, KINDS[x.kind], x.total, x.currency])]
    .map(row => row.map(escape).join(',')).join('\r\n');
}
function exportCsv() {
  download(new Blob(['\uFEFF', csvText(invoiceRows())], { type: 'text/csv;charset=utf-8' }), 'CFDI-' + (scope || 'todos') + '.csv');
}
function totalsCsv() {
  const escape = value => {
    const text = String(value);
    const safe = /^[\s\uFEFF]*[=+\-@]|^[\t\r\n]/u.test(text) ? "'" + text : text;
    return '"' + safe.replaceAll('"', '""') + '"';
  };
  const rows = [['RFC', 'Contribuyente', 'Mes', 'Recibidos', 'Importe recibidos MXN', 'Emitidos', 'Importe emitidos MXN', 'En divisa (por código, sin sumar)', 'Canceladas (fuera de los totales)', 'Complementos de pago']];
  for (const [rfc, group] of monthlyTotals()) {
    for (const [monthKey, g] of group.months) rows.push([rfc, group.name, monthKey, g.received, centsPlain(g.receivedCents),
      g.issued, centsPlain(g.issuedCents),
      Object.entries(g.foreign).map(([code, slot]) => (slot.received + slot.issued) + ' en ' + code).join(' · '),
      g.cancelled, g.rep]);
  }
  return rows.map(row => row.map(escape).join(',')).join('\r\n');
}
function exportTotalsCsv() {
  download(new Blob(['\uFEFF', totalsCsv()], { type: 'text/csv;charset=utf-8' }), 'Totales-por-RFC-y-mes.csv');
}
async function snapshot(sinTechoUnico = false) {
  const data = { version: 2 };
  const records = cloudStorage ? await Promise.all(STORES.map(name => readStore(name))) : await new Promise((resolve, reject) => {
    const tx = db.transaction(STORES, 'readonly');
    const results = STORES.map(name => tx.objectStore(name).getAll());
    tx.oncomplete = () => resolve(results.map(request => request.result));
    tx.onabort = () => reject(tx.error || new Error('No se pudo crear el respaldo.'));
  });
  for (let i = 0; i < STORES.length; i++) data[STORES[i]] = records[i];
  /* El techo de 100 MB es POR ARCHIVO de respaldo. El respaldo
     partido (2.9.10) pide la foto sin él porque su gracia es
     partir lo que no cabe en un solo archivo; cada una de sus
     partes ya respeta el techo al empaquetarse. Los demás
     llamadores (respaldo completo, copia antes de restaurar)
     generan un único archivo y conservan el techo intacto. */
  check(sinTechoUnico || data.files.reduce((sum, file) => sum + file.blob.size, 0) <= 100 * MB, 'Este formato admite hasta 100 MB de archivos por respaldo.');
  data.files = await Promise.all(data.files.map(async item => ({ id: item.id, content: encode64(bytes(await item.blob.arrayBuffer())) })));
  return data;
}
async function validateBackup(data) {
  check(data?.version === 2 && STORES.every(key => Array.isArray(data[key])), 'El contenido del respaldo no es compatible.');
  const validText = (value, max) => typeof value === 'string' && value.length <= max;
  const registry = new Map();
  for (const p of data.people) {
    check(RFC.test(p?.id) && validText(p.name, 120) && p.name.trim() && !registry.has(p.id), 'El respaldo contiene un RFC inválido.');
    registry.set(p.id, { id: p.id, name: p.name });
  }
  const contents = new Map();
  for (const item of data.files) {
    check(validText(item?.id, 70) && validText(item.content, 21 * MB) && !contents.has(item.id), 'El respaldo contiene un archivo inválido.');
    contents.set(item.id, item.content);
  }
  const output = { people: [...registry.values()], invoices: [], documents: [], activity: [], files: [] };
  for (const entry of data.invoices) {
    const id = 'xml:' + entry.id;
    check(UUID.test(entry.id) && contents.has(id), 'Falta un XML en el respaldo.');
    const raw = decode64(contents.get(id));
    const row = withFiscal(parseXml(raw), raw);
    check(entry.id === row.id && (registry.has(row.from.rfc) || registry.has(row.to.rfc)), 'El XML del respaldo no coincide.');
    output.invoices.push(row);
    output.files.push({ id, blob: new Blob([raw], { type: 'application/xml' }) });
    contents.delete(id);
  }
  for (const entry of data.documents) {
    check(typeof entry.id === 'string' && /^pdf:[a-f0-9-]{36}$/.test(entry.id) && contents.has(entry.id) &&
      registry.has(entry.rfc) && DOCUMENTS.includes(entry.kind) && /^\d{4}-\d{2}-\d{2}$/.test(entry.date) &&
      validText(entry.period, 40) && validText(entry.name, 180), 'El respaldo contiene un documento inválido.');
    const blob = new Blob([decode64(contents.get(entry.id))], { type: 'application/pdf' });
    check(await pdfOk(blob), 'El respaldo contiene un PDF dañado.');
    const { id, rfc, kind, date, period, name, uuid } = entry;
    check(uuid === undefined || uuid === '' || (typeof uuid === 'string' && UUID.test(uuid)), 'El respaldo contiene un UUID de PDF inválido.');
    output.documents.push({ id, rfc, kind, date, period, name, uuid });
    output.files.push({ id, blob });
    contents.delete(id);
  }
  for (const entry of data.activity) {
    check(validText(entry.id, 70) && validText(entry.name, 180) && validText(entry.date, 40) &&
      ['added', 'duplicates', 'review'].every(key => Number.isSafeInteger(entry[key]) && entry[key] >= 0), 'El historial del respaldo es inválido.');
    const { id, name, date, added, duplicates, review } = entry;
    const issues = Array.isArray(entry.issues) ? entry.issues.slice(0, 20)
      .filter(item => validText(item?.name, 180) && validText(item.reason, 320))
      .map(item => ({ name: item.name, reason: item.reason })) : [];
    const restored = { id, name, date, added, duplicates, review, issues };
    if (validText(entry.event, 320)) restored.event = entry.event;
    output.activity.push(restored);
  }
  check(contents.size === 0, 'El respaldo contiene archivos sin expediente.');
  return output;
}
async function backupDialog() {
  await requireStorage();
  check(!importing && crypto.subtle, 'El respaldo no está disponible en este navegador o hay una importación activa.');
  const password = input('password', { required: true, minLength: 12, autocomplete: 'new-password' });
  const repeat = input('password', { required: true, minLength: 12, autocomplete: 'new-password' });
  dialog('Crear respaldo cifrado', [n('p', 'Sin esta contraseña el respaldo NO se puede abrir: no hay forma de recuperarla. Guárdala en tu gestor de contraseñas.', 'news-note'),
    field('Contraseña de al menos 12 caracteres', password), field('Confirma la contraseña', repeat)], async () => {
    check(password.value.length >= 12 && password.value === repeat.value, 'Revisa que las contraseñas coincidan.');
    download(await encryptBackup(await snapshot(), password.value), 'PacoSAT-' + new Date().toISOString().slice(0, 10) + '.faro');
    await logEvent('Respaldo cifrado creado');
    announce('Respaldo cifrado generado.');
    soundCue('success');
  }, 'Crear respaldo');
}
/* ZIP sin compresión (método «stored») construido en el navegador para
   el paquete mensual: basta el CRC y el directorio central que ya sabe
   leer zipXml, sin dependencias nuevas. */
function zipStore(entries) {
  const encoder = new TextEncoder();
  const parts = [], centrals = [];
  let offset = 0;
  for (const entry of entries) {
    const name = encoder.encode(entry.name);
    const data = entry.data instanceof Uint8Array ? entry.data : encoder.encode(String(entry.data));
    const crc = crc32(data);
    const local = new DataView(new ArrayBuffer(30));
    local.setUint32(0, 0x04034b50, true); local.setUint16(4, 20, true);
    local.setUint32(14, crc, true); local.setUint32(18, data.length, true); local.setUint32(22, data.length, true);
    local.setUint16(26, name.length, true);
    parts.push(new Uint8Array(local.buffer), name, data);
    const central = new DataView(new ArrayBuffer(46));
    central.setUint32(0, 0x02014b50, true); central.setUint16(4, 20, true); central.setUint16(6, 20, true);
    central.setUint32(16, crc, true); central.setUint32(20, data.length, true); central.setUint32(24, data.length, true);
    central.setUint16(28, name.length, true); central.setUint32(42, offset, true);
    centrals.push(new Uint8Array(central.buffer), name);
    offset += 30 + name.length + data.length;
  }
  const end = new DataView(new ArrayBuffer(22));
  end.setUint32(0, 0x06054b50, true); end.setUint16(8, entries.length, true); end.setUint16(10, entries.length, true);
  end.setUint32(12, centrals.reduce((sum, part) => sum + part.length, 0), true); end.setUint32(16, offset, true);
  parts.push(...centrals, new Uint8Array(end.buffer));
  return new Blob(parts, { type: 'application/zip' });
}
function monthlyPackageManifest(rfc, monthKey, files, generatedAt, installName = '') {
  return ['PacoSAT · Paquete mensual para la contadora', 'RFC: ' + rfc, 'Mes: ' + monthKey,
    'Generado: ' + generatedAt, ...(installName ? ['Instalación: ' + installName] : []), '', 'Contenido del paquete:']
    .concat(files.map(name => '- ' + name)).join('\n') + '\n';
}
async function restoreDialog(file) {
  await requireStorage();
  check(!importing && crypto.subtle, 'Espera a que termine la importación o abre la app en un navegador compatible.');
  const password = input('password', { required: true, autocomplete: 'off' });
  /* Restauración segura (UX-08): primero se LEE el respaldo y se enseña
     su contenido; nada se reemplaza hasta la confirmación del paso 2,
     que además ofrece guardar una copia cifrada de lo actual. */
  dialog('Restaurar respaldo', [n('p', 'Primero se lee el respaldo y se muestra qué contiene. Nada se reemplaza hasta que confirmes en el paso siguiente.'), field('Contraseña del respaldo', password)], async () => {
    const rawBackup = await decryptBackup(file, password.value);
    const contents = await validateBackup(rawBackup);
    const labels = { people: 'contribuyentes', invoices: 'CFDI', documents: 'documentos', files: 'archivos', activity: 'eventos de actividad' };
    const summary = STORES.map(name => contents[name].length + ' ' + labels[name]).join(' · ');
    const saveFirst = input('checkbox'); saveFirst.checked = true;
    const confirm = input('checkbox', { required: true });
    setTimeout(() => {
      dialog('Confirmar restauración', [
        n('p', 'Este respaldo contiene: ' + summary + '.'),
        rawBackup.operations ? n('p', 'Incluye el estado operativo (descargas, el libro de peticiones al SAT y avisos pendientes).') :
          n('p', 'No incluye estado operativo (es un respaldo anterior): tras restaurar, desbloquea cada perfil para reanudar las descargas.'),
        n('p', 'Al restaurar se REEMPLAZAN los expedientes actuales por los del respaldo.'),
        field('Guardar antes una copia cifrada de lo actual (con la contraseña de este respaldo)', saveFirst),
        field('Confirmo que quiero reemplazar los datos actuales', confirm)], async () => {
        check(confirm.checked, 'Confirma el reemplazo de los datos.');
        if (saveFirst.checked) {
          download(await encryptBackup(await snapshot(), password.value),
            'PacoSAT-antes-de-restaurar-' + new Date().toISOString().slice(0, 10) + '.faro');
        }
        await writeBatch(contents, true);
        let operationsNote = '';
        if (rawBackup.operations && typeof satToken !== 'undefined' && satToken) {
          await satApi('backup/operations', rawBackup.operations);
          await pollSat();
          operationsNote = ' También se restauró el estado operativo (descargas, el libro de peticiones al SAT y avisos pendientes); desbloquea cada perfil para reanudar.';
        }
        await refresh();
        await logEvent('Respaldo restaurado desde un archivo cifrado');
