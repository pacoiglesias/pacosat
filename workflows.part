/* Cierre › Calendario: APLICA el mes elegido en el campo de
   la pantalla y lo ENSEÑA — ese mes pasa a ser el del cierre
   (OUT.month, el que pintan el IVA y el reporte del periodo)
   y la vista salta a Reportes con ese mes aplicado. */
async function aplicarMesCierre232() {
  const monthInput = document.querySelector('main input[type="month"]');
  const mes = monthInput?.value || '';
  if (!/^\d{4}-\d{2}$/.test(mes)) {
