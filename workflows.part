   servidor ya sabe hacer: sin ejecutor vivo no encola y lo
   dice; con él, su equipo la corre al recogerla). */
async function probarEjecutor232() {
  const rfc = scope || (typeof satData !== 'undefined' && satData?.profiles?.[0]?.rfc) || people?.[0]?.id || '';
  if (!rfc) { toast('No hay ningún RFC con perfil para probar la puerta.', 'error'); return false; }
  try {
    const r = await satApi('salud/puerta', { rfc });
    if (r.probada) toast(r.ok ? 'La puerta de ' + rfc + ' abre: la e.firma entró al portal (probada ahora mismo).'
      : 'La puerta de ' + rfc + ' NO abre: ' + (r.error || 'sin motivo'), r.ok ? 'ok' : 'error');
    else if (r.encolado) toast(r.repetido
      ? 'La prueba de la puerta de ' + rfc + ' ya estaba en cola: no se duplicó.'
      : 'Prueba de puerta encolada para ' + rfc + ': tu ejecutor la corre al recogerla.', 'ok');
    else toast(r.motivo || 'La prueba no se encoló: abre el ejecutor en tu PC.', 'error');
    if (typeof pollSat === 'function') await pollSat().catch(() => {});
    render();
    return Boolean(r.encolado || r.probada);
  } catch (error) { toast(error.message, 'error'); return false; }
}
/* Ajustes › API: refresca el panel DE VERDAD — re-lee las
   llaves y el estado desde el servidor antes de repintar, y
   dice cuántas llaves constan. */
async function refrescarApi232() {
