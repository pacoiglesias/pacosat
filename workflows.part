  if (page === 'bancos') { navigate('bancos'); return; }
  if (page === 'preguntas') { navigate('preguntas'); const q = document.querySelector('#main input[type="text"]'); if (q) q.focus(); return; }
  if (page === 'offline') { navigate('offline'); return; }
