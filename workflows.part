  return false;
}
$('primary').onclick = handle(async () => {
  /* Despacho por DESTINO (1.11.0): la acción principal depende de la
     pestaña o sección en curso, no de la vista absorbida. */
  if (page === 'avisos') {
    /* La principal de Avisos es el recálculo veraz (1.29.1, D7):
       trabaja a la vista y enseña hora, cambio o error literal. */
    if (typeof avisosRecalcular === 'function') await avisosRecalcular().catch(error => announce(error.message, true));
    else { await refreshAvisos(true); render(); }
    return;
  }
  if (page === 'sat') {
    if (satTab === 'estado') { await pollMonitor(); return; }
    if (satTab === 'listas') { await satApi('lists/refresh', {}); await loadLists(); toast('Listados actualizados y cruzados con tu padrón.', 'ok'); return; }
    if (satTab === 'descargado') { await pollSat(); render(); return; }
    if (satTab === 'ejecutor') {
      /* Contextual (2.0, 2.6): con ejecutor emparejado, el
         primario es «Tu ejecutor» — y desde la 2.3.2 (M-11)
         lo PRUEBA de verdad encolando la prueba de puerta;
         sin ninguno, empareja. */
      const exP = satData?.ejecutor;
      if (exP?.emparejado) { await probarEjecutor232(); return; }
      document.querySelector('.executor-pair')?.click(); return;
    }
    /* Descargar (1.32.1, G4): la cabecera de la pantalla de
       descargar ABRE la hoja de descarga del RFC elegido — antes
       decía «Importar paquete» y abría el importador de archivos
       en la propia pantalla de bajar del SAT. */
    if (typeof downloadSheet === 'function' && scope) { downloadSheet(scope); return; }
    showSatDownload(); return;
  }
  /* Las ex-pestañas del Centro SAT como vistas propias (2.0.1):
     su primario despacha lo mismo que despachaba su pestaña. */
  if (page === 'lists') { await satApi('lists/refresh', {}); await loadLists(); toast('Listados actualizados y cruzados con tu padrón.', 'ok'); return; }
  if (page === 'monitor') { await pollMonitor(); return; }
  if (page === 'coverage') { await pollSat(); render(); return; }
  if (page === 'ejecutor') {
    const exP = satData?.ejecutor;
    if (exP?.emparejado) { await probarEjecutor232(); return; }
    document.querySelector('.executor-pair')?.click(); return;
  }
  if (page === 'descargar') {
    if (typeof downloadSheet === 'function' && scope) { downloadSheet(scope); return; }
    showSatDownload(); return;
  }
  if (page === 'reportes') {
    await ensureLazyPart('salidas');
    if (typeof exportFull === 'function') { await exportFull(''); return; }
    toast('La parte de reportes no se pudo cargar: inténtalo otra vez.', 'error'); return;
  }
  if (page === 'buzon') {
    /* «Marcar todo leído» (1.32.1, R1; 2.9.13 · A7): el botón
       de la franja salió por duplicado — la cabecera es el
       único sitio y llama a la función de la parte del buzón;
       sin nada sin leer, lo dice en vez de fingir el gesto. */
    if (typeof buzonMarcarTodoLeido2913 === 'function' &&
        typeof buzonCache !== 'undefined' && buzonCache && (buzonCache.unread || 0) > 0) {
      await buzonMarcarTodoLeido2913(); return;
    }
    toast('Recibidos está al día: no hay nada sin leer.', 'ok'); return;
  }
  if (page === 'tributario') {
    /* «Consultar ahora» (1.32.1, B1): la cabecera pulsa el MISMO
       botón de la pantalla — antes no tenía rama y caía al
       importador de archivos con la etiqueta de consultar. */
    const consultar = document.querySelector('.trib-consultar');
    if (consultar && !consultar.disabled) { consultar.click(); return; }
    if (consultar) { toast('La consulta del Buzón ya está en curso.', 'ok'); return; }
    toast('La pantalla del Buzón aún se está pintando: pulsa «Consultar ahora» en su franja.', 'error'); return;
  }
  if (page === 'salud') {
    /* «Revisar ahora la salud» (2.0 · tanda 4): la cabecera corre
       el cruce de coherencia a demanda y repinta — la etiqueta
       promete exactamente ese gesto. */
    await ensureLazyPart('salud');
    if (typeof saludRevisar200d === 'function') { await saludRevisar200d(); return; }
    render(); return;
  }
  if (page === 'settings') {
    if (ajustesSection === 'general') { await saveAppSettings(); return; }
    if (ajustesSection === 'contribuyentes') { await addPerson(); return; }
    if (ajustesSection === 'respaldos') { backupDialog(); return; }
    if (ajustesSection === 'sistema') { await pollSat(); await pollMonitor(); render(); return; }
    if (ajustesSection === 'api') { await refrescarApi232(); return; }
    render(); return;
  }
  if (page === 'salidas') {
    if (cierreSection === 'reportes') { navigate('reportes'); return; }
    if (cierreSection === 'diot') { exportDiotCsv(); return; }
    if (cierreSection === 'calendario') { await aplicarMesCierre232(); return; }
    await ensureLazyPart('salidas');
    if (typeof exportFull === 'function') { await exportFull(''); return; }
    toast('La parte de reportes no se pudo cargar: inténtalo otra vez.', 'error'); return;
  }
  if (page === 'dinero') {
    /* «Descargar Excel de saldos» (1.32.1, Di3): la cabecera de
       Dinero es su salida natural — antes navegaba a otra
       pantalla disfrazada de acción. */
    /* Con el RFC del selector (2.9.3 · F6): sin él, el servidor
       contestaba «Elige primero el RFC del expediente» aunque
       el RFC estuviera elegido en pantalla, y la banda quedaba
       pegada sin descarga — la llamada gemela del panel de
       salidas sí lo pasaba. */
    if (typeof descargarSalida1310 === 'function') { descargarSalida1310('salidas/xlsx', { kind: 'dinero', rfc: scope }, $('primary')); return; }
    toast('La salida de Dinero no se pudo cargar: inténtalo otra vez.', 'error'); return;
  }
  if (page === 'pagos') {
    /* «Preparar los pagos» (1.32.1, G1): baja al paso 2 y pulsa
       su botón real «Armar la lista desde las facturas del mes»
       — antes solo repintaba. */
    const armar = document.querySelector('.pagos-armar');
    if (armar) { armar.scrollIntoView({ block: 'center' }); armar.click(); return; }
    toast('Abre primero la tarjeta de vencimientos para preparar los pagos.', 'error'); return;
  }
  if (page === 'invoices') {
    /* «Descargar del SAT» (2.0, 1.3): la cabecera de Facturas
       abre la MISMA hoja de descarga que el botón de la
       pantalla — su acción protagonista, no el importador. */
    if (scope) downloadSheet(scope); else showSatDownload();
    return;
  }
  if (page === 'home') {
    /* El paso del día (2.0, 1.3): la etiqueta de pasoHoy200
       despacha a su gesto real; sin gesto protagonista, la
       descarga de CFDI del SAT con su hoja de periodos. */
    const paso = primaryLabel();
    if (paso === 'Ver tu ejecutor') satTab = 'ejecutor';
    if (paso === 'Dar sus credenciales') satTab = 'descargar';
    if (paso === 'Descargar del SAT') { if (scope) downloadSheet(scope); else showSatDownload(); }
    else navigate('sat');
    return;
  }
  if (page === 'contribuyentes') { navigate('home'); return; }
  if (page === 'preguntas') { enviarPregunta232(); return; }
  if (page === 'registro') { if (typeof downloadRegistroCsv === 'function') await downloadRegistroCsv(); return; }
  if (page === 'archivo') { const r280 = document.getElementById('archivo-recuperar280'); if (r280) { r280.click(); return; } navigate('invoices'); return; }
  if (page === 'declaraciones') {
    /* «Descargar declaraciones del SAT» (1.32.1, D2): la
       cabecera pulsa el MISMO botón grande de la pantalla —
       antes decía «Recuperar del SAT» y solo enfocaba el año. */
    const descargar = document.querySelector('.decl-descargar');
    if (descargar && !descargar.disabled) { descargar.click(); return; }
    toast('Elige primero el RFC y el ejercicio en la pantalla.', 'error'); return;
  }
  return page === 'docs' ? addDocument() : chooseImport();
});
for (const button of document.querySelectorAll('[data-view]')) button.onclick = () => { announce(); navigate(button.dataset.view); };
/* Buscador global (1.6.5): por UUID completo o parcial, por el
   FOLIO del CFDI (serie-folio: teclear «963» encuentra la factura
   963, 1.18.0) o por RFC y nombre de emisor/receptor — buscar una
   contraparte lleva a sus facturas y de ahí a su expediente.
   Aplica el término en el archivo de facturas y, si hay un único
   resultado, abre su detalle.
   Atajo Ctrl/Cmd+K para enfocar el buscador (no pisa la escritura en
   campos: solo actúa fuera de ellos o sobre el propio buscador). */
const globalSearchInput = $('global-search');
/* F1 · Buscador único (1.31.0): además del salto a Facturas de
   siempre, la búsqueda ofrece lo que case en Documentos del SAT
   (satApi('satdocs')) y en Avisos (satApi('avisos'); si ese
   nombre aún no responde en el servidor, el de siempre,
   'notices') por título, asunto o RFC, en un diálogo con sus
   dos secciones y el enlace a su pantalla (docs / avisos). El
   comportamiento para UUID/RFC/folio no cambia: esto solo
   AÑADE resultados cuando los hay y nunca tapa el detalle de
   una factura única ya abierto. */
const globalSearchNorm1310 = texto => String(texto || '').toLocaleLowerCase('es-MX')
  .normalize('NFD').replace(/[̀-ͯ]/g, '');
function globalSearchCasa1310(consulta, ...textos) {
  const aguja = globalSearchNorm1310(consulta).trim();
  if (!aguja) return false;
  const pajar = globalSearchNorm1310(textos.filter(Boolean).join(' '));
  if (pajar.includes(aguja)) return true;
  return aguja.split(/\s+/).some(palabra => palabra.length >= 3 && pajar.includes(palabra));
}
async function globalSearchExtras1310(query, facturasEncontradas) {
  try {
    if (typeof satToken === 'undefined' || !satToken) return;
    if (facturasEncontradas === 1) return;
    const [docsData, avisosData] = await Promise.all([
      satApi('satdocs').catch(() => null),
      satApi('avisos').catch(() => satApi('notices').catch(() => null))
    ]);
    const docsHits = [];
    for (const profile of docsData?.profiles || []) {
      for (const [kind, titulo] of [['constancia', 'Constancia de situación fiscal'], ['opinion', 'Opinión de cumplimiento']]) {
        if (!profile[kind]) continue;
        if (globalSearchCasa1310(query, titulo, profile.rfc)) docsHits.push(titulo + ' · ' + profile.rfc);
      }
    }
    const avisosHits = (avisosData?.avisos || []).filter(aviso =>
      globalSearchCasa1310(query, aviso.titulo, aviso.detalle, aviso.contraparte, aviso.nombre, aviso.rfc)).slice(0, 8);
    if (!docsHits.length && !avisosHits.length) return;
    if ($('dialog').open) return;
    const controls = [];
    if (docsHits.length) {
      controls.push(n('h3', 'Documentos del SAT'));
      for (const hit of docsHits) {
        const row = n('div', undefined, 'cp-row');
        row.append(n('span', hit),
          action('Ir a Documentos', () => { $('dialog').close(); navigate('docs'); }, 'soft small'));
        controls.push(row);
      }
    }
    if (avisosHits.length) {
      controls.push(n('h3', 'Avisos'));
      for (const aviso of avisosHits) {
        const row = n('div', undefined, 'cp-row');
        row.append(n('span', (aviso.titulo || 'Aviso') + (aviso.rfc ? ' · ' + aviso.rfc : '')),
          action('Ir a Avisos', () => { $('dialog').close(); navigate('avisos'); }, 'soft small'));
        controls.push(row);
      }
    }
    dialog('Más resultados para «' + query + '»', controls);
  } catch { /* Los extras nunca rompen la búsqueda de Facturas. */ }
}
/* Tanda 7B (1 · M7/F1): el buscador unificado del servidor —
   grupos CFDI / Documentos / Avisos / Registro, separados por
   RFC, cada resultado con su destino exacto. */
async function globalSearch200h(query) {
  try {
    if (typeof satToken === 'undefined' || !satToken) return;
    const data = await satApi('buscar200h?q=' + encodeURIComponent(query) +
      (scope ? '&rfc=' + encodeURIComponent(scope) : '&todos=1'));
    const grupos = data?.porRfc || [];
    if (!grupos.length || $('dialog').open) return;
    const controls = [];
    const titulos = { cfdi: 'CFDI', documentos: 'Documentos del SAT', avisos: 'Avisos', registro: 'Registro' };
    for (const grupoRfc of grupos) {
      /* El grupo sin dueño se etiqueta como lo que es
         (2.9.0 · Bloque C): el servidor lo clavea «SIN RFC» y
         el encabezado salía «RFC SIN RFC». */
      controls.push(n('h3', grupoRfc.rfc === 'SIN RFC' ? 'Sin RFC propio · avisos y registro del sistema' : 'RFC ' + grupoRfc.rfc));
      for (const [clave, items] of Object.entries(grupoRfc.grupos || {})) {
        if (!items?.length) continue;
        controls.push(n('strong', titulos[clave] || clave));
        for (const item of items.slice(0, 6)) {
          const row = n('div', undefined, 'cp-row');
          row.append(n('span', item.texto || item.uuid || ''),
            action('Ir', () => { $('dialog').close();
              if (item.destino?.uuid) { const inv = invoices.find(r => r.id === item.destino.uuid);
                if (inv) { navigate('invoices'); invoiceDetail(inv); return; } }
              navigate(item.destino?.vista || 'home'); }, 'soft small'));
          controls.push(row);
        }
      }
    }
    if (controls.length) dialog('Resultados en todo PacoSAT para «' + query + '»', controls);
  } catch { /* el camino de Facturas de siempre no se toca */ }
}
function runGlobalSearch() {
  const query = globalSearchInput.value.trim();
  if (!query) return;
  /* El buscador también EJECUTA acciones (1.6.11): nombres de pantalla
     y órdenes cortas («descargar ahora MFI…», «crear respaldo», «ir a
     cobertura») se resuelven antes de tratar el texto como búsqueda. */
  const lower = query.toLocaleLowerCase('es-MX');
  const screensByWord = [['resumen', 'home'], ['inicio', 'home'], ['hoy', 'home'], ['avisos', 'avisos'], ['centro de avisos', 'avisos'], ['facturas', 'invoices'], ['cfdi', 'invoices'],
    ['expedientes', 'docs'], ['documentos', 'docs'], ['centro sat', 'sat'], ['descargas', 'sat'], ['vigilancia', 'monitor'],
    ['69-b', 'monitor'], ['operaciones', 'operations'], ['alertas', 'operations'], ['cobertura', 'coverage'], ['huecos', 'coverage'],
    ['respaldos', 'backup'], ['respaldo', 'backup'], ['diot', 'diot'], ['ajustes', 'settings'], ['qué incluye', 'capacidades'], ['capacidades', 'capacidades'],
    /* Diccionario nuevo (1.18.0): las palabras de Paco llegan a su
       pantalla — pagos, dinero, cierre, documentos del SAT, bancos,
       listas y salidas ya no caen en «sin resultados». */
    ['pagos', 'pagos'], ['pagos al banco', 'pagos'], ['banco', 'pagos'], ['dinero', 'dinero'], ['saldos', 'dinero'],
    ['cierre', 'salidas'], ['reportes', 'salidas'], ['salidas', 'salidas'], ['informe', 'salidas'],
    ['constancia', 'docs'], ['constancia de situación fiscal', 'docs'], ['opinión', 'docs'], ['opinión de cumplimiento', 'docs'],
    ['declaraciones', 'docs'], ['bancos', 'bancos'], ['listas', 'lists'], ['listas 69-b', 'lists']];
  const downloadMatch = lower.match(/^descargar(?: ahora)?\s+([a-z0-9]{12,13})$/i);
  if (downloadMatch && typeof satData !== 'undefined' && satData) {
    const rfc = downloadMatch[1].toUpperCase();
    const profile = (satData.profiles || []).find(row => row.rfc === rfc);
    if (profile?.unlocked) {
      requestRunNow(rfc).then(data => { if (data) { satData = data; announce('Revisión inmediata de ' + rfc + ' ejecutada.'); soundCue('success'); } })
        .catch(error => announce(error.message, true));
      return;
    }
  }
  const screenHit = screensByWord.find(([word]) => lower === word || lower === 'ir a ' + word || lower === 'abrir ' + word);
  if (screenHit) { navigate(screenHit[1]); announce('Abriendo «' + query + '».'); return; }
  if (lower === 'crear respaldo' || lower === 'hacer respaldo') { navigate('backup'); backupDialog(); return; }
  const hadFilters = Boolean(term || month || invoiceKind || invoiceState);
  term = query; invoiceState = ''; invoiceKind = ''; month = ''; invoicePage = 0;
  navigate('invoices');
  const found = invoiceRows();
  /* CFDI de retenciones (2.4.0 · WC3b): no son comprobantes y no
     salen en Facturas; si la búsqueda casa con UNO solo (por folio
     interno, RFC o nombre) y con ninguna factura, se abre SU ficha. */
  if (!found.length) {
    const retHits = documents.filter(doc => !doc.archived && doc.kind === 'CFDI de retenciones' &&
      globalSearchCasa1310(query, doc.name, doc.identidad, doc.retenciones?.folioInt,
        doc.retenciones?.from?.rfc, doc.retenciones?.from?.name, doc.retenciones?.to?.rfc, doc.retenciones?.to?.name));
    if (retHits.length === 1) { retencionesDetail(retHits[0]); return; }
  }
  if (found.length === 1) invoiceDetail(found[0]);
  else announce((hadFilters ? 'Filtros anteriores limpiados. ' : '') +
    (found.length ? number.format(found.length) + ' comprobantes coinciden con «' + query + '».' :
    'Sin comprobantes para «' + query + '».'), !found.length);
  /* F1: sin bloquear el camino de Facturas, se buscan también
     los Documentos del SAT y los Avisos que casen. */
  globalSearchExtras1310(query, found.length);
  globalSearch200h(query);
}
globalSearchInput.addEventListener('keydown', event => {
  if (event.key === 'Enter') { event.preventDefault(); runGlobalSearch(); }
});
document.addEventListener('keydown', event => {
  if (!(event.ctrlKey || event.metaKey) || event.key.toLowerCase() !== 'k' || $('dialog').open) return;
  if (document.activeElement?.matches('input,select,textarea') && document.activeElement !== globalSearchInput) return;
  event.preventDefault();
  globalSearchInput.focus();
  globalSearchInput.select();
});
$('scope').onchange = () => { scope = $('scope').value; invoicePage = 0; render();
  /* Los distintivos cuentan el RFC elegido (1.28.0, P9). */
  if (typeof paintBuzonBadge === 'function') paintBuzonBadge();
  if (typeof paintTribBadge === 'function') paintTribBadge();
  if (typeof avisosBadgeCount === 'function' && typeof avisosCache !== 'undefined' && avisosCache) paintAvisosBadge(avisosBadgeCount(avisosCache)); };
/* F5: el selector de la barra superior manda igual que el lateral. */
if ($('scope-top')) $('scope-top').onchange = () => { scope = $('scope-top').value; invoicePage = 0; render();
  if (typeof paintBuzonBadge === 'function') paintBuzonBadge();
  if (typeof paintTribBadge === 'function') paintTribBadge();
  if (typeof avisosBadgeCount === 'function' && typeof avisosCache !== 'undefined' && avisosCache) paintAvisosBadge(avisosBadgeCount(avisosCache)); };
$('incoming').onchange = () => { const files = [...$('incoming').files]; $('incoming').value = ''; importBatch(files).catch(error => announce(error.message, true)); };
$('folder').onchange = () => { const files = [...$('folder').files]; $('folder').value = ''; importBatch(files, scope, { fromFolder: true }).catch(error => announce(error.message, true)); };
$('restore').onchange = handle(() => {
  const file = $('restore').files[0]; $('restore').value = ''; if (file) return restoreDialog(file);
});
$('close').onclick = $('cancel').onclick = () => $('dialog').close();
$('dialog').addEventListener('cancel', event => { if ($('save').disabled) event.preventDefault(); });
$('dialog').addEventListener('close', () => { $('fields').replaceChildren(); submit = null; });
$('form').onsubmit = async event => {
  event.preventDefault();
  if (!submit || $('save').disabled) return;
  $('save').disabled = $('cancel').disabled = $('close').disabled = true;
  $('formError').hidden = true;
  try { await submit(); $('dialog').close(); }
  catch (error) { $('formError').textContent = error.message; $('formError').hidden = false; }
  finally { $('save').disabled = $('cancel').disabled = $('close').disabled = false; }
};
window.addEventListener('dragover', event => {
  if (event.dataTransfer.types.includes('Files')) {
    event.preventDefault();
    if (!$('dialog').open) $('body').classList.add('drag-active');
  }
});
window.addEventListener('dragleave', event => { if (!event.relatedTarget) $('body').classList.remove('drag-active'); });
window.addEventListener('drop', event => {
  if (!event.dataTransfer.files.length) return;
  if ($('dialog').open && event.target instanceof HTMLInputElement && event.target.type === 'file') return;
  event.preventDefault(); $('body').classList.remove('drag-active');
  if (!$('dialog').open) importBatch(event.dataTransfer.files).catch(error => announce(error.message, true));
});
/* Preparación del almacenamiento (1.6.8). Hasta la 1.6.7, las acciones
   comprobaban `ready` en el acto y se rendían con «El almacenamiento
   todavía no está disponible.» si el usuario actuaba antes de que el
   arranque terminara; y si la apertura quedaba bloqueada por otra
   pestaña o fallaba, `ready` quedaba en falso para siempre y no había
   recuperación. Ahora las acciones ESPERAN a la preparación
   (requireStorage) con un límite razonable; si el almacén de verdad no
   abre, hay un reintento — el bloqueo pudo ceder si la otra pestaña ya
   se cerró — y solo entonces un mensaje claro y accionable según el
   modo y la causa (storageAdvice). En modo servidor (cloudStorage) la
   preparación es la carga inicial de datos desde el servidor: las
   acciones trabajan contra el servidor y nunca dependen de IndexedDB. */
const STORAGE_WAIT_MS = 10000;
let storageFailure = null;   // error definitivo de la última apertura local
let storagePending = false;  // hay una apertura local en curso
async function openLocalStorage() {
  storagePending = true;
  try { db = await openDatabase(); return true; }
  catch (error) { storageFailure = error; return false; }
  finally { storagePending = false; }
}
function storageAdvice() {
  if (cloudStorage) return 'PacoSAT no pudo cargar los datos del servidor. Revisa la conexión con el servidor, recarga la página y vuelve a intentarlo.';
  if (isStorageBlocked()) return 'Otra pestaña o ventana de PacoSAT tiene el almacenamiento local ocupado. Cierra las demás pestañas de PacoSAT, recarga esta página y vuelve a intentarlo.';
  return 'El navegador no dejó abrir el almacenamiento local de PacoSAT. Cierra las demás pestañas de la app, recarga la página y vuelve a intentarlo; si aun así falla, abre la app en Chrome o Edge con un perfil normal (no privado).';
}
let storageAttempt, readiness;
function beginReadiness() {
  storageAttempt = cloudStorage ? Promise.resolve(true) : openLocalStorage();
  readiness = storageAttempt.then(async opened => {
    if (!opened) return false;
    ready = true;
    await refresh();
    return true;
  });
  return readiness;
}
async function waitReadiness(waitMs) {
  if (ready) return true;
  /* `readiness` solo existe si el arranque ya ejecutó beginReadiness()
     (al final de este guion). Una acción puede llegar antes de eso — en
     Safari iOS le pasó a Paco al tocar «Agregar RFC» — o el arranque
     puede haberse quedado a medias, y la preparación se inicia entonces
     aquí mismo, perezosamente: la conducta es esperar, no reventar
     evaluando `.then` sobre undefined («undefined is not an object
     (evaluating 'readiness.then')» en JavaScriptCore). */
  if (!readiness) beginReadiness();
  let timer;
  const timeout = new Promise(resolve => { timer = setTimeout(() => resolve(false), waitMs); });
  const settled = readiness.then(() => ready, () => ready);
  const ok = await Promise.race([settled, timeout]);
  clearTimeout(timer);
  return Boolean(ok && ready);
}
async function retryStorage(waitMs) {
  /* Si la apertura sigue en curso (bloqueada por otra pestaña), no se
     abre otra: se vuelve a esperar sobre la misma preparación, que se
     completa sola en cuanto esa pestaña se cierra. Si el intento ya
     terminó en fallo, se reintenta desde cero; en modo servidor, la
     preparación nueva simplemente recarga los datos. */
  if (!storagePending) beginReadiness();
  return waitReadiness(waitMs);
}
async function requireStorage(waitMs = STORAGE_WAIT_MS) {
  if (ready) return;
  if (await waitReadiness(waitMs)) return;
  if (await retryStorage(waitMs)) return;
  throw new Error(storageAdvice());
}
/* Fin de la preparación del almacenamiento (1.6.8). */
/* Arranque (corregido en la 1.7.2): aquí SOLO arranca la preparación.
   El render inicial NO va en este punto del bloque: render() lee
   enlaces let de fragmentos posteriores (satData y satToken, en
   sat-ui.part) que aquí siguen en zona muerta (TDZ) — llamarlo aquí
   lanzaba ReferenceError y abortaba el resto del bloque entero, con
   lo que ni esta preparación ni las declaraciones posteriores
   llegaban a ejecutarse (defecto hasta la 1.7.1). El render inicial
   vive al final de capacidades-ui.part, el último fragmento, cuando
   todas las declaraciones ya corrieron. El orden visual no cambia:
   las continuaciones de esta promesa se resuelven cuando el bloque
   completo ya se evaluó, así que el primer pintado sigue siendo el
   esqueleto de este render y los datos llegan después, como siempre.
   `startup` sí nace aquí porque sat-ui.part y monitor-ui.part se
   suscriben a él a nivel superior (startup.then(...)) al cargarse. */
const startup = beginReadiness().then(opened => { if (!opened) announce(storageAdvice(), true); })
  .catch(error => announce(error.message, true));
startup.then(() => { computeNews(); if (newsCount && page === 'home') render(); });
