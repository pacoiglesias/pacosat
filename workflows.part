async function addPerson() {
  await requireStorage();
  const name = input('text', { required: true, maxLength: 120, placeholder: 'Nombre o razón social' });
  const id = input('text', { required: true, maxLength: 13, placeholder: 'RFC de 12 o 13 caracteres' });
  const note = n('p', '', 'rfc-note');
  const confirmDigit = input('checkbox');
  const confirmField = field('Guardar aunque el dígito verificador no cuadre', confirmDigit);
  confirmField.hidden = true;
  const hint = 'Al escribir se revisan la estructura, la fecha y el dígito verificador oficial. ' +
    'La revisión es de forma: no confirma que el RFC exista en el SAT.';
  const paint = () => {
    const result = validateRfc(id.value);
    confirmField.hidden = !(result.level === 'digit' && !result.generic);
    if (!id.value.trim()) { note.dataset.state = 'info'; note.textContent = hint; }
    else if (result.level === 'structure') { note.dataset.state = 'error'; note.textContent = result.error; }
    else if (result.generic) {
      note.dataset.state = 'info';
      note.textContent = 'Es uno de los RFC genéricos del SAT (público en general u operaciones con extranjeros): ' +
        'se acepta con esta nota y no se le exige el dígito verificador.';
    } else if (result.level === 'digit') {
      note.dataset.state = 'warn';
      note.textContent = 'El dígito verificador no cuadra: para esta base debería ser «' + result.digitExpected + '» y trae «' +
        result.rfc.slice(-1) + '». Casi siempre es una errata al teclear. Revisa el RFC y, solo si estás seguro de que así consta, ' +
        'marca la casilla para guardarlo de todos modos.';
    } else {
      note.dataset.state = 'ok';
      note.textContent = 'Válido en forma: estructura, fecha y dígito verificador correctos (' +
        (result.type === 'fisica' ? 'persona física' : 'persona moral') + '). Esto no confirma que el RFC exista en el SAT.';
    }
    return result;
  };
  id.oninput = () => { confirmDigit.checked = false; paint(); };
  dialog('Agregar contribuyente', [field('Nombre o razón social', name), field('RFC', id), note, confirmField], async () => {
    const rfc = id.value.trim().toUpperCase(), label = name.value.trim();
    check(label, 'Escribe un nombre o razón social.');
    const result = validateRfc(rfc);
    check(result.level !== 'structure', result.error);
    check(result.generic || result.level !== 'digit' || confirmDigit.checked,
      'El dígito verificador no cuadra (debería ser «' + result.digitExpected + '»). Corrige el RFC o marca la casilla «Guardar aunque el dígito verificador no cuadre».');
    check(!await readStore('people', rfc), 'Ese RFC ya está en tu cartera.');
    await writeBatch({ people: [{ id: rfc, name: label }] });
    scope = rfc;
    await refresh(); announce('Expediente creado para ' + rfc + '.');
    /* Siguiente paso visible (UX-24): el alta no termina en el Resumen
       sin guía; se ofrecen las dos acciones naturales del expediente.
       Se difiere un instante porque el propio diálogo del alta se está
       cerrando al terminar este envío. */
    setTimeout(() => {
      const next = n('div', undefined, 'actions');
      next.append(action('Importar sus XML/ZIP', () => { $('dialog').close(); chooseImport(); }, 'primary', 'up'),
        action('Autorizar su e.firma', () => { $('dialog').close(); if (typeof unlockDialog === 'function') unlockDialog(rfc); }, undefined, 'lock'));
      dialog('Expediente creado · ' + rfc, [n('p', '¿Qué sigue? Importa los XML que ya tengas de este RFC o autoriza su e.firma para que PacoSAT descargue solo.'), next]);
    }, 80);
  }, 'Agregar contribuyente');
  paint();
}
/* Mantenimiento de cartera (UX-07, 1.6.11): renombrar contribuyentes y
   eliminar o desvincular documentos, siempre con confirmación clara y
   asiento en la bitácora. Sin papelera: por eso se avisa antes. */
async function renamePerson(person) {
  const name = input('text', { required: true, maxLength: 120, value: person.name });
  dialog('Renombrar contribuyente', [n('p', 'El RFC ' + person.id + ' no cambia; solo el nombre visible en PacoSAT.'),
    field('Nombre o razón social', name)], async () => {
    check(name.value.trim(), 'Escribe un nombre o razón social.');
    await writeBatch({ people: [{ id: person.id, name: name.value.trim() }] });
    await refresh(); announce('Contribuyente renombrado a «' + name.value.trim() + '».');
  }, 'Renombrar');
}
function deleteDocument(doc) {
  dialog('Eliminar documento', [n('p', 'Se eliminará «' + doc.name + '» (' + doc.kind + ' · ' + doc.rfc + ') del expediente, con su PDF. ' +
    'No hay papelera: si dudas, crea antes un respaldo cifrado.')], async () => {
    await deleteStoreRecords('documents', [doc.id]);
    await deleteStoreRecords('files', [doc.id]);
    await logEvent('Documento eliminado: ' + doc.name);
    await refresh(); announce('Documento eliminado.');
  }, 'Eliminar documento');
}
function unlinkDocument(doc) {
  dialog('Desvincular PDF del CFDI', [n('p', '«' + doc.name + '» dejará de estar vinculado al folio ' + doc.uuid + '. El PDF se queda en el expediente.')], async () => {
    await writeBatch({ documents: [{ ...doc, uuid: '' }] });
    await logEvent('PDF desvinculado: ' + doc.name);
    await refresh(); announce('PDF desvinculado del CFDI.');
  }, 'Desvincular');
}
async function chooseImport() {
  await requireStorage();
  check(people.length, 'Agrega un RFC antes de importar.');
  if (!importing) $('incoming').click();
}
async function importBatch(source, requiredRfc = scope, { quiet = false, fromFolder = false } = {}) {
  if (importing) return;
  try { await requireStorage(); }
  catch (error) { if (quiet) throw error; announce(error.message, true); return; }
  /* Modo carpeta (1.7.4, pieza 1): la estructura tipo OneFacture
     (Emitidos/Recibidos/año/mes) entra por el MISMO pipeline; lo que no
     es XML/ZIP no se descarta en silencio: se anota como «no procesado»
     con su motivo y sale en el resumen fijo. */
  const allFiles = [...source];
  const files = allFiles.filter(file => /\.(xml|zip)$/i.test(file.name));
  const skipped = fromFolder
    ? allFiles.filter(file => !/\.(xml|zip)$/i.test(file.name)).slice(0, 20)
        .map(file => ({ name: file.name.slice(0, 180), reason: 'No es un XML ni un ZIP de CFDI: no se procesó.' }))
    : [];
  if (!files.length) return announce(fromFolder && skipped.length
    ? 'La carpeta no trae XML ni ZIP de CFDI (' + skipped.length + ' archivos de otro tipo, sin procesar).'
    : 'Elige archivos .xml o .zip con CFDI.', true);
  if (!people.length) return announce('Agrega primero los RFC que quieres importar.', true);
  importing = true;
  $('primary').disabled = true;
  /* Indicador global persistente: contador real por entradas (los ZIP
     suman sus entradas al total en cuanto se abre su directorio). */
  let totalUnits = files.length, doneUnits = 0;
  if (!quiet) activityStart(fromFolder ? 'Importando carpeta de comprobantes' : 'Importando comprobantes', totalUnits);
  let added = 0, duplicates = 0, review = 0, scopeRejected = 0;
  let nuevosEmitidos = 0, nuevosRecibidos = 0;
  const nuevosPorMes = new Map();
  const dupIds = [];
  const issues = [];
  const pending = new Map();
  const known = scopes();
  const seen = new Set((await readStore('invoices').catch(() => invoices)).map(row => row.id));
  let pendingSize = 0;
  const issue = (name, error) => {
    review++;
    if (issues.length < 20) issues.push({ name: name.slice(0, 180), reason: error.message.slice(0, 320) });
  };
  async function flush() {
    if (!pending.size) return;
    await writeBatch({ invoices: [...pending.values()].map(item => item.row), files: [...pending.values()].map(item => item.file) });
    added += pending.size;
    pending.clear();
    pendingSize = 0;
  }
  async function accept(name, xml) {
    let row;
    try {
      row = withFiscal(parseXml(xml), xml);
      check(!requiredRfc || row.from.rfc === requiredRfc || row.to.rfc === requiredRfc,
        'No corresponde a ' + requiredRfc + '. Emisor ' + row.from.rfc + ' · Receptor ' + row.to.rfc + '.');
      check(known.has(row.from.rfc) || known.has(row.to.rfc), 'Los RFC del comprobante no están registrados.');
    } catch (error) {
      /* UX-03: si hay un RFC seleccionado, avisar cuántos archivos se
         fueron a revisión SOLO por el alcance, para que no parezca que
         «desaparecieron» facturas de otros RFC. */
      if (String(error.message).startsWith('No corresponde a')) scopeRejected++;
      issue(name, error); return;
    }
    if (seen.has(row.id)) { duplicates++; if (dupIds.length < 50) dupIds.push(row.id); return; }
    seen.add(row.id);
    /* Desglose del resumen fijo: dirección y mes de cada nuevo. */
    if (known.has(row.from.rfc)) nuevosEmitidos++; else if (known.has(row.to.rfc)) nuevosRecibidos++;
    const monthKey = String(row.date || '').slice(0, 7);
    if (/^\d{4}-\d{2}$/.test(monthKey)) nuevosPorMes.set(monthKey, (nuevosPorMes.get(monthKey) || 0) + 1);
    pending.set(row.id, { row, file: { id: 'xml:' + row.id, blob: new Blob([xml], { type: 'application/xml' }) } });
    pendingSize += xml.length;
    if (pending.size >= 100 || pendingSize >= 12 * MB) await flush();
  }
  try {
    for (let i = 0; i < files.length; i++) {
      const file = files[i];
      if (!quiet) announce('Importando ' + (i + 1) + ' de ' + files.length + ' · ' + file.name);
      if (/\.xml$/i.test(file.name)) {
        if (file.size > 8 * MB) { issue(file.name, new Error('El XML supera 8 MB.')); doneUnits++; if (!quiet) activityProgress(doneUnits, file.name); continue; }
        let xml;
        try { xml = bytes(await file.arrayBuffer()); }
        catch (error) { issue(file.name, error); doneUnits++; if (!quiet) activityProgress(doneUnits, file.name); continue; }
        await accept(file.name, xml);
        doneUnits++;
        if (!quiet) activityProgress(doneUnits, file.name);
      } else {
        if (file.size > 80 * MB) { issue(file.name, new Error('El ZIP supera 80 MB.')); doneUnits++; if (!quiet) activityProgress(doneUnits, file.name); continue; }
        /* El ZIP cuenta como UNA unidad hasta abrir su directorio:
           entonces el total crece con sus entradas XML reales y el
           contador pasa a ser por comprobante (meta.total). */
        const meta = {};
        let zip;
        try { zip = zipXml(bytes(await file.arrayBuffer()), meta); }
        catch (error) { issue(file.name, error); doneUnits++; if (!quiet) activityProgress(doneUnits, file.name); continue; }
        let count = 0, expanded = false;
        while (true) {
          let entry;
          try { entry = await zip.next(); }
          catch (error) { issue(file.name, error); break; }
          if (!expanded && meta.total) {
            expanded = true;
            totalUnits += meta.total - 1;
            if (!quiet) activitySetTotal(totalUnits);
          }
          if (entry.done) {
            if (!count) issue(file.name, new Error('El ZIP no contiene CFDI XML.'));
            break;
          }
          count++;
          await accept(entry.value.name, entry.value.xml);
          doneUnits++;
          if (!quiet) activityProgress(doneUnits, file.name + ' · ' + entry.value.name);
        }
        if (expanded && count < meta.total) {
          /* El ZIP se interrumpió a mitad: el contador cierra el hueco
             para que la barra termine en el total anunciado. */
          doneUnits += meta.total - count;
          if (!quiet) activityProgress(doneUnits, file.name);
        }
        if (!expanded) { doneUnits++; if (!quiet) activityProgress(doneUnits, file.name); }
      }
    }
    await flush();
    await writeBatch({ activity: [{
      id: crypto.randomUUID(), name: files.length === 1 ? files[0].name.slice(0, 180) : files.length + ' archivos',
      date: new Date().toISOString(), added, duplicates, review, issues
    }] });
    if (!quiet) {
      /* Tarjeta de resultado persistente (UX-13): el resumen vive en el
         Resumen («Última importación») además del aviso superior. */
      lastImport = { at: Date.now(), added, duplicates, review, dupIds };
      announce(added + ' nuevos · ' + duplicates + ' duplicados · ' + review + ' por revisar' +
        (scopeRejected ? '\n' + scopeRejected + ' archivo(s) no corresponden al RFC seleccionado (' + requiredRfc + ') y quedaron por revisar: cambia el selector a «Todos los RFC» para importarlos.' : '') +
        (issues.length ? '\n' + issues.slice(0, 6).map(item => item.name + ' · ' + item.reason).join('\n') : ''), Boolean(review));
      if (!review) soundCue('success'); else if (added) soundCue('notice');
      /* Resumen FIJO (1.7.4, pieza 1): en importaciones grandes, con
         problemas o con archivos sin procesar, el resultado queda en
         pantalla hasta que el usuario lo cierra — nada de avisos
         fugaces para 2.493 comprobantes. */
      const esGrande = totalUnits >= 10 || review > 0 || skipped.length > 0;
      if (esGrande) {
        const lines = [];
        lines.push(added
          ? '✓ ' + number.format(added) + ' comprobantes nuevos (' + number.format(nuevosEmitidos) + ' emitidos · ' + number.format(nuevosRecibidos) + ' recibidos).'
          : 'Sin comprobantes nuevos.');
        if (nuevosPorMes.size) {
          const top = [...nuevosPorMes.entries()].sort((a, b) => b[0].localeCompare(a[0])).slice(0, 4);
          lines.push('Por mes: ' + top.map(([mes, n]) => mes + ': ' + number.format(n)).join(' · ') + (nuevosPorMes.size > 4 ? ' · …' : ''));
        }
        if (duplicates) lines.push(number.format(duplicates) + ' duplicados: ya estaban en PacoSAT y no se tocaron.');
        if (review) {
          lines.push('⚠ ' + number.format(review) + ' por revisar — no entraron. Motivo de los primeros:');
          for (const item of issues.slice(0, 6)) lines.push('· ' + item.name + ' — ' + item.reason);
          if (scopeRejected) lines.push(number.format(scopeRejected) + ' no corresponden al RFC seleccionado (' + requiredRfc + '): cambia el selector a «Todos los RFC» y vuelve a importarlos.');
          lines.push('Qué hacer: corrige el archivo o el RFC indicado y vuelve a importar solo esos; los demás ya están dentro.');
        }
        if (skipped.length) {
          lines.push('Sin procesar (' + skipped.length + '): no son XML ni ZIP de CFDI.');
          for (const item of skipped.slice(0, 6)) lines.push('· ' + item.name + ' — ' + item.reason);
        }
        activityDone('✓ Procesado', lines);
      } else activityFinish();
    }
    return { added, duplicates, review };
  } catch (error) {
    announce(added + ' comprobantes guardados antes de interrumpir el lote. ' + error.message, true);
    if (!quiet) activityFail('La importación se interrumpió', added + ' comprobantes quedaron guardados antes de la interrupción. ' + error.message);
    if (quiet) throw error;
  } finally {
    importing = false;
    $('primary').disabled = !ready;
    try { await refresh(quiet && page === 'sat'); } catch (error) { announce(error.message, true); }
  }
}
async function addDocument() {
  await requireStorage();
  check(people.length, 'Agrega un RFC antes de archivar documentos.');
  const taxpayer = select(people.map(p => [p.id, p.name + ' · ' + p.id]), scope || people[0].id);
  const kind = select(DOCUMENTS.map(x => [x, x]), DOCUMENTS[0]);
  const date = input('date', { required: true });
  const period = input('text', { maxLength: 40, placeholder: 'Ej. Octubre 2026' });
  const picker = input('file', { required: true, accept: '.pdf' });
  dialog('Archivar PDF', [field('Contribuyente', taxpayer), field('Tipo de documento', kind), field('Fecha', date),
    field('Periodo, si aplica', period), field('Archivo', picker)], async () => {
    const file = picker.files[0];
    check(await pdfOk(file), 'Elige un PDF de hasta 15 MB.');
    const id = 'pdf:' + crypto.randomUUID();
    await writeBatch({ documents: [{ id, rfc: taxpayer.value, kind: kind.value, date: date.value, period: period.value.trim(), name: file.name.slice(0, 180) }],
      files: [{ id, blob: new Blob([file], { type: 'application/pdf' }) }] });
    docFilter = '';
    if (scope && scope !== taxpayer.value) scope = taxpayer.value;
    await refresh();
    await logEvent('PDF archivado · ' + kind.value + ' · ' + taxpayer.value);
    announce('PDF archivado en ' + taxpayer.value + '.');
  });
}
const TAX_NAMES = { '001': 'ISR', '002': 'IVA', '003': 'IEPS' };
const taxLabel = code => TAX_NAMES[code] || code;
async function copyText(text, label) {
  try { await navigator.clipboard.writeText(text); announce(label + ' copiado al portapapeles.'); }
  catch { announce('No se pudo copiar automáticamente; selecciona el texto y cópialo manualmente.', true); }
}
/* Visor CFDI profesional (1.6.7): la tarjeta resumen se queda arriba y
   debajo va la representación completa parseada del XML guardado —
   cabecera, partes, conceptos con impuestos, totales con desglose,
   timbre con sellos plegables, Pagos 2.0 y demás complementos — con el
   estado de la vigilancia, la historia, y las acciones de copiar UUID,
   descargar el XML, abrir el PDF vinculado e imprimir el comprobante. */
function cfdiPrint(row, full, opts = {}) {
  const section = $('print-report');
  /* Impresión por lote (1.6.16): opts.append añade el comprobante al
     documento en curso y opts.print=false difiere la impresión. */
  if (!opts.append) section.replaceChildren();
  const head = n('div', undefined, 'report-head');
  if (appSettings.logoData) {
    const logo = n('img', undefined, 'report-logo');
    logo.src = appSettings.logoData;
    logo.alt = '';
    head.append(logo);
  }
  head.append(n('div', (appSettings.installName || 'PacoSAT') + ' · COMPROBANTE FISCAL', 'hero-kicker'),
    n('h1', KINDS[full.kind] + (full.serie || full.folio ? ' ' + [full.serie, full.folio].filter(Boolean).join('-') : '')),
    n('p', full.emisor.nombre + ' (' + full.emisor.rfc + ') → ' + full.receptor.nombre + ' (' + full.receptor.rfc + ')' +
      ' · ' + full.fecha + (full.timbre ? ' · Folio fiscal ' + full.timbre.uuid : ' · Sin timbre fiscal'), 'report-meta'));
  section.append(head);
  const fields = n('div');
  fields.append(grid(['Dato', 'Valor'], [
    ['Fecha de emisión', full.fecha], ['Lugar de expedición', full.lugarExpedicion || '—'],
    ['Forma / método de pago', [full.formaPago, full.metodoPago].filter(Boolean).join(' / ') || '—'],
    ['Moneda', full.moneda + (full.tipoCambio ? ' · TC ' + full.tipoCambio : '')],
    ['Régimen emisor', full.emisor.regimen || '—'],
    ['Receptor', full.receptor.nombre + ' · ' + full.receptor.rfc + ' · Régimen ' + (full.receptor.regimen || '—') +
      ' · CP ' + (full.receptor.domicilioFiscal || '—') + ' · Uso ' + (full.receptor.usoCfdi || '—')],
    ['Nº de certificado del emisor', full.noCertificado || '—']
  ]));
  section.append(fields);
  const concepts = n('div');
  concepts.append(grid(['Descripción', 'Cantidad', 'Unidad', 'V. unitario', 'Importe'],
    full.conceptos.map(c => [c.descripcion, c.cantidad, c.unidad || c.claveUnidad, '$' + c.valorUnitario, '$' + c.importe])));
  section.append(concepts);
  const totals = [['Subtotal', '$' + full.subTotal]];
  if (full.descuento) totals.push(['Descuento', '−$' + full.descuento]);
  for (const t of full.impuestos.traslados) totals.push([taxLabel(t.impuesto) + ' trasladado ' + (t.tasa ? t.tasa + ' ' + t.tipoFactor : t.tipoFactor), '$' + t.importe]);
  for (const t of full.impuestos.retenciones) totals.push([taxLabel(t.impuesto) + ' retenido', '−$' + t.importe]);
  totals.push(['Total', '$' + full.total + ' ' + full.moneda]);
  const totalsWrap = n('div');
  totalsWrap.append(grid(['Totales', 'Importe'], totals));
  section.append(totalsWrap);
  if (full.timbre) {
    const timbre = n('div', undefined, 'report-note print-seals');
    timbre.append(n('p', 'Timbre Fiscal Digital · UUID ' + full.timbre.uuid + ' · Timbrado ' + full.timbre.fechaTimbrado +
      ' · PAC ' + full.timbre.rfcProvCertif + ' · Certificado SAT ' + full.timbre.noCertificadoSAT),
      n('p', 'Sello del CFDI: ' + full.timbre.selloCfd),
      n('p', 'Sello del SAT: ' + full.timbre.selloSat),
      n('p', 'Cadena original: ' + full.timbre.cadenaOriginal));
    section.append(timbre);
  }
  if (opts.print !== false) setTimeout(() => window.print(), 80);
}
function invoiceDetail(row) {
  const summary = n('div', undefined, 'invoice-summary');
  const headline = n('div');
  headline.append(n('span', rowRole(row), 'period-chip'), n('h3', amount(row)), n('p', KINDS[row.kind] + ' · ' + dateLabel(row.date)));
  const parties = n('div', undefined, 'invoice-parties');
  for (const [label, party] of [['EMISOR', row.from], ['RECEPTOR', row.to]]) {
    const box = n('div');
    box.append(n('small', label), n('strong', party.name || party.rfc), n('span', party.rfc));
    parties.append(box);
  }
  summary.append(headline, parties, cell(row.id, 'Folio fiscal'));
  summary.append(statusCell(row.id));
  if (row.initialState) summary.append(n('p', 'Estado al importarse (según los metadatos del SAT): ' + row.initialState + '.', 'report-note'));
  const contents = [summary];
  const linked = documents.filter(doc => doc.kind === 'Factura PDF' && doc.uuid === row.id && (!scope || doc.rfc === scope));
  const actionsRow = n('div', undefined, 'actions');
  actionsRow.append(
    action('Copiar UUID', () => copyText(row.id, 'UUID'), undefined, 'file'),
    action('Descargar XML original', async () => {
      const file = await readStore('files', 'xml:' + row.id);
      check(file, 'Archivo no encontrado.');
      download(file.blob, row.id + '.xml');
    }, undefined, 'down'));
  for (const doc of linked) actionsRow.append(action('Ver PDF · ' + doc.rfc, () => {
    $('dialog').addEventListener('close', () => viewPdf(doc).catch(error => announce(error.message, true)), { once: true });
    $('dialog').close();
  }, undefined, 'file'));
  if (!linked.length) actionsRow.append(n('span', 'Sin PDF vinculado a este CFDI.', 'timeline-empty'));
  contents.push(actionsRow);
  /* Representación completa: se rellena al leer el XML guardado. */
  const fullSection = n('section', undefined, 'invoice-concepts');
  fullSection.append(n('h3', 'Comprobante completo'));
  const fullBody = n('div');
  fullBody.append(n('p', 'Leyendo el XML guardado…', 'timeline-empty'));
  fullSection.append(fullBody);
  contents.push(fullSection);
  (async () => {
    try {
      const file = await readStore('files', 'xml:' + row.id);
      check(file, 'El XML original no está en este equipo.');
      const full = parseCfdiFull(bytes(await file.blob.arrayBuffer()));
      fullBody.replaceChildren();
      const facts = n('div', undefined, 'facts');
      const fact = (label, value) => { if (!value) return; const box = n('div'); box.append(n('small', label), n('strong', value)); return box; };
      [fact('Versión', full.version), fact('Serie y folio', [full.serie, full.folio].filter(Boolean).join(' · ')),
        fact('Fecha de emisión', full.fecha), fact('Lugar de expedición', full.lugarExpedicion),
        fact('Tipo', KINDS[full.kind] + ' (' + full.tipoRaw + ')'), fact('Forma de pago', full.formaPago),
        fact('Método de pago', full.metodoPago), fact('Moneda', full.moneda + (full.tipoCambio ? ' · TC ' + full.tipoCambio : '')),
        fact('Nº de certificado', full.noCertificado), fact('Exportación', full.exportacion),
        fact('Uso de CFDI', full.receptor.usoCfdi), fact('Condiciones', full.condiciones)
      ].forEach(box => box && facts.append(box));
      const partiesFull = n('div', undefined, 'invoice-parties');
      for (const [label, party, extra] of [['EMISOR', full.emisor, 'Régimen ' + (full.emisor.regimen || '—')],
        ['RECEPTOR', full.receptor, 'Régimen ' + (full.receptor.regimen || '—') + ' · CP ' + (full.receptor.domicilioFiscal || '—')]]) {
        const box = n('div');
        box.append(n('small', label), n('strong', party.nombre || party.rfc), n('span', party.rfc), n('span', extra));
        partiesFull.append(box);
      }
      fullBody.append(facts, partiesFull);
      if (full.conceptos.length) {
        const table = n('div', undefined, 'table-wrap');
        table.append(grid(['Clave', 'Descripción', 'Cantidad', 'V. unitario', 'Importe', 'Impuestos'],
          full.conceptos.map(c => [c.claveProdServ, c.descripcion + (c.descuento ? ' (desc. $' + c.descuento + ')' : ''),
            c.cantidad + ' ' + (c.unidad || c.claveUnidad), '$' + c.valorUnitario, '$' + c.importe,
            [...c.traslados.map(t => taxLabel(t.impuesto) + ' ' + (t.tasa || '') + ' $' + t.importe),
              ...c.retenciones.map(t => taxLabel(t.impuesto) + ' ret. $' + t.importe)].join(' · ') || '—'])));
        fullBody.append(table);
      }
      const totalsRows = [['Subtotal', '$' + full.subTotal]];
      if (full.descuento) totalsRows.push(['Descuento', '−$' + full.descuento]);
      for (const t of full.impuestos.traslados) totalsRows.push([taxLabel(t.impuesto) + ' trasladado ' + (t.tasa ? t.tasa + ' ' + t.tipoFactor : t.tipoFactor), '$' + t.importe]);
      for (const t of full.impuestos.retenciones) totalsRows.push([taxLabel(t.impuesto) + ' retenido', '−$' + t.importe]);
      if (full.impuestos.totalTrasladados) totalsRows.push(['Total impuestos trasladados', '$' + full.impuestos.totalTrasladados]);
      if (full.impuestos.totalRetenidos) totalsRows.push(['Total impuestos retenidos', '−$' + full.impuestos.totalRetenidos]);
      totalsRows.push(['Total', '$' + full.total + ' ' + full.moneda]);
      const totalsWrap = n('div', undefined, 'table-wrap');
      totalsWrap.append(grid(['Totales con desglose', 'Importe'], totalsRows));
      fullBody.append(totalsWrap);
      if (full.timbre) {
        const timbreBox = n('div');
        timbreBox.append(n('h3', 'Timbre Fiscal Digital'));
        const tfacts = n('div', undefined, 'facts');
        const tfact = (label, value) => { if (!value) return; const box = n('div'); box.append(n('small', label), n('strong', value)); return box; };
        [tfact('UUID', full.timbre.uuid), tfact('Fecha de timbrado', full.timbre.fechaTimbrado),
          tfact('RFC del PAC', full.timbre.rfcProvCertif), tfact('Certificado del SAT', full.timbre.noCertificadoSAT),
          tfact('Certificado del emisor', full.noCertificado)].forEach(box => box && tfacts.append(box));
        timbreBox.append(tfacts);
        for (const [label, value] of [['Sello del CFDI', full.timbre.selloCfd], ['Sello del SAT', full.timbre.selloSat],
          ['Cadena original del timbre', full.timbre.cadenaOriginal]]) {
          const details = n('details', undefined, 'seal-details');
          const summaryEl = n('summary', label);
          const pre = n('pre', value, 'xml-view');
          details.append(summaryEl, pre, action('Copiar', () => copyText(value, label)));
          timbreBox.append(details);
        }
        fullBody.append(timbreBox);
      } else fullBody.append(n('p', 'Este comprobante no tiene Timbre Fiscal Digital (no está timbrado).', 'timeline-empty'));
      if (full.pagos) {
        const pagosBox = n('div');
        pagosBox.append(n('h3', 'Complemento de pagos 2.0'));
        for (const pago of full.pagos.pagos) {
          pagosBox.append(n('p', 'Pago del ' + pago.fechaPago + ' · Forma ' + (pago.formaDePagoP || '—') + ' · ' +
            (pago.monto ? '$' + pago.monto + ' ' + pago.monedaP : 'Sin monto') + (pago.numOperacion ? ' · Operación ' + pago.numOperacion : '')));
          if (pago.documentos.length) {
            const docs = n('div', undefined, 'table-wrap');
            docs.append(grid(['Documento (UUID)', 'Folio', 'Parcialidad', 'Saldo anterior', 'Pagado', 'Saldo insoluto'],
              pago.documentos.map(d => [d.idDocumento, [d.serie, d.folio].filter(Boolean).join('-') || '—', d.numParcialidad,
                '$' + d.impSaldoAnt, '$' + d.impPagado, '$' + d.impSaldoInsoluto])));
            pagosBox.append(docs);
          }
        }
        if (full.pagos.totales.MontoTotalPagos) pagosBox.append(n('p', 'Monto total de pagos: $' + full.pagos.totales.MontoTotalPagos));
        fullBody.append(pagosBox);
      }
      for (const name of full.otrosComplementos) pagosChip(fullBody, name);
      actionsRow.append(action('Imprimir comprobante', () => cfdiPrint(row, full), 'primary', 'print'));
    } catch (error) { fullBody.replaceChildren(n('p', error.message, 'timeline-empty')); }
  })();
  function pagosChip(parent, name) {
    const chip = n('p', 'Otro complemento detectado: ' + name, 'timeline-empty');
    parent.append(chip);
  }
  /* Historia del CFDI (1.6.5): línea de tiempo solo con datos guardados.
     La emisión y el PDF salen del expediente local; descargas, consultas
     de estado y avisos los aporta el servidor desde jobs y la vigilancia.
     Lo que no tenga histórico, no aparece. */
  const timelineSection = n('section', undefined, 'invoice-concepts');
  timelineSection.id = 'cfdi-timeline';
  timelineSection.append(n('h3', 'Historia del comprobante'));
  const timelineList = n('div', undefined, 'timeline');
  timelineList.append(n('p', 'Cargando historia…', 'timeline-empty'));
  timelineSection.append(timelineList);
  contents.push(timelineSection);
  actionsRow.append(action('Ver historia', () => timelineSection.scrollIntoView({ behavior: 'smooth', block: 'start' })));
  (async () => {
    const events = [{ at: row.date, label: 'CFDI emitido', detail: KINDS[row.kind] + ' · ' + amount(row) }];
    for (const doc of linked) events.push({ at: null, label: 'PDF vinculado', detail: doc.name });
    if (typeof satToken !== 'undefined' && satToken) {
      try {
        const data = await satApi('invoice-history?id=' + encodeURIComponent(row.id));
        for (const event of data.events || []) if (event.kind !== 'emission' && event.kind !== 'pdf') events.push(event);
      } catch { /* sin servidor o sin historia remota: se muestra la local */ }
    }
    events.sort((a, b) => (a.at || '9999').localeCompare(b.at || '9999'));
    timelineList.replaceChildren(...events.map(event => {
      const item = n('div', undefined, 'timeline-item');
      item.append(n('strong', event.label),
        n('small', (event.at ? localDateTime(Date.parse(event.at)) + ' · ' : '') + (event.detail || '')));
      return item;
    }));
  })();
  dialog('Detalle del CFDI', contents);
  $('dialog').classList.add('invoice-dialog');
  $('dialog').classList.add('cfdi-dialog');
}
function invoiceActions(row) {
  const wrap = n('div', undefined, 'actions');
  /* Acciones directas por fila (UX-14): lo esencial sin abrir el
     detalle — ver, descargar el XML, imprimir y copiar el UUID. */
  wrap.append(action('Ver CFDI', () => invoiceDetail(row)),
    action('Descargar XML', async () => {
      const file = await readStore('files', 'xml:' + row.id);
      check(file, 'Archivo no encontrado.');
      download(file.blob, row.id + '.xml');
    }, undefined, 'down'),
    action('Imprimir', async () => {
      const file = await readStore('files', 'xml:' + row.id);
      check(file, 'Archivo no encontrado.');
      cfdiPrint(row, parseCfdiFull(bytes(await file.blob.arrayBuffer())));
    }, undefined, 'print'),
    action('Copiar UUID', async () => {
      try { await navigator.clipboard.writeText(row.id); announce('UUID copiado: ' + row.id); }
      catch { announce('No se pudo copiar al portapapeles en este navegador.', true); }
    }),
    action('Ver XML', async () => {
      const file = await readStore('files', 'xml:' + row.id);
      check(file, 'Archivo no encontrado.');
      await viewXml(file.blob, row.id + '.xml');
    }));
  return wrap;
}
async function viewXml(file, name) {
  check(file.size && file.size <= 8 * MB, 'El visor admite XML de hasta 8 MB.');
  const raw = bytes(await file.arrayBuffer());
  let text, encodingError;
  try { text = decodeXml(raw); }
  catch { text = new TextDecoder().decode(raw); encodingError = 'No se pudo leer la codificación declarada. Se muestra una lectura aproximada.'; }
  const fields = [n('p', name)];
  if (encodingError) fields.push(n('p', encodingError));
  else {
    try {
      const row = parseXml(raw);
      fields.push(cell(row.from.name || row.from.rfc, 'Emisor · ' + row.from.rfc),
        cell(row.to.name || row.to.rfc, 'Receptor · ' + row.to.rfc), cell(row.id, 'UUID · ' + amount(row)));
      const known = scopes();
      if (!known.has(row.from.rfc) && !known.has(row.to.rfc)) fields.push(n('p', 'Para importarlo, agrega el RFC del emisor o del receptor que corresponda a tu expediente.'));
      else {
        /* Sin callejón sin salida (UX-15): si el comprobante encaja en
           la cartera, se importa desde el propio visor. */
        fields.push(action('Importar este XML', async () => {
          $('dialog').close();
          await importBatch([new File([file], name || 'comprobante.xml', { type: 'application/xml' })]);
        }, 'primary', 'up'));
      }
    } catch (error) { fields.push(n('p', 'Revisión del importador · ' + error.message)); }
  }
  const viewer = n('pre', text, 'xml-view');
  viewer.tabIndex = 0;
  viewer.setAttribute('aria-label', 'Código XML original');
  fields.push(viewer);
  dialog('Visor XML', fields);
}
function reviewDetail(row) {
  const fields = [n('p', row.name + ' · ' + row.review + ' por revisar')];
  if (row.issues?.length) {
    const list = n('ul');
    for (const item of row.issues) list.append(n('li', item.name + ' · ' + item.reason));
    fields.push(list);
    if (row.issues.length < row.review) fields.push(n('p', 'Se muestran los primeros ' + row.issues.length + ' motivos del lote.'));
  } else fields.push(n('p', 'Este lote se registró antes de que PacoSAT guardara los motivos. Abre el XML original para revisarlo.'));
  dialog('Revisión de importación', fields);
}
function csvText(rows) {
  const escape = value => {
    const text = String(value);
    const safe = /^[\s\uFEFF]*[=+\-@]|^[\t\r\n]/u.test(text) ? "'" + text : text;
    return '"' + safe.replaceAll('"', '""') + '"';
  };
  return [['UUID', 'Emisor', 'RFC emisor', 'Receptor', 'RFC receptor', 'Fecha', 'Tipo', 'Total', 'Moneda'],
    ...rows.map(x => [x.id, x.from.name, x.from.rfc, x.to.name, x.to.rfc, x.date, KINDS[x.kind], x.total, x.currency])]
    .map(row => row.map(escape).join(',')).join('\r\n');
}
function exportCsv() {
  download(new Blob(['\uFEFF', csvText(invoiceRows())], { type: 'text/csv;charset=utf-8' }), 'CFDI-' + (scope || 'todos') + '.csv');
}
function totalsCsv() {
  const escape = value => {
    const text = String(value);
    const safe = /^[\s\uFEFF]*[=+\-@]|^[\t\r\n]/u.test(text) ? "'" + text : text;
    return '"' + safe.replaceAll('"', '""') + '"';
  };
  const rows = [['RFC', 'Contribuyente', 'Mes', 'Recibidos', 'Importe recibidos MXN', 'Emitidos', 'Importe emitidos MXN', 'En otra moneda sin sumar']];
  for (const [rfc, group] of monthlyTotals()) {
    for (const [monthKey, g] of group.months) rows.push([rfc, group.name, monthKey, g.received, centsPlain(g.receivedCents),
      g.issued, centsPlain(g.issuedCents), g.receivedForeign + g.issuedForeign]);
  }
  return rows.map(row => row.map(escape).join(',')).join('\r\n');
}
function exportTotalsCsv() {
  download(new Blob(['\uFEFF', totalsCsv()], { type: 'text/csv;charset=utf-8' }), 'Totales-por-RFC-y-mes.csv');
}
async function snapshot() {
  const data = { version: 2 };
  const records = cloudStorage ? await Promise.all(STORES.map(name => readStore(name))) : await new Promise((resolve, reject) => {
    const tx = db.transaction(STORES, 'readonly');
    const results = STORES.map(name => tx.objectStore(name).getAll());
    tx.oncomplete = () => resolve(results.map(request => request.result));
    tx.onabort = () => reject(tx.error || new Error('No se pudo crear el respaldo.'));
  });
  for (let i = 0; i < STORES.length; i++) data[STORES[i]] = records[i];
  check(data.files.reduce((sum, file) => sum + file.blob.size, 0) <= 100 * MB, 'Este formato admite hasta 100 MB de archivos por respaldo.');
  data.files = await Promise.all(data.files.map(async item => ({ id: item.id, content: encode64(bytes(await item.blob.arrayBuffer())) })));
  return data;
}
async function validateBackup(data) {
  check(data?.version === 2 && STORES.every(key => Array.isArray(data[key])), 'El contenido del respaldo no es compatible.');
  const validText = (value, max) => typeof value === 'string' && value.length <= max;
  const registry = new Map();
  for (const p of data.people) {
    check(RFC.test(p?.id) && validText(p.name, 120) && p.name.trim() && !registry.has(p.id), 'El respaldo contiene un RFC inválido.');
    registry.set(p.id, { id: p.id, name: p.name });
  }
  const contents = new Map();
  for (const item of data.files) {
    check(validText(item?.id, 70) && validText(item.content, 21 * MB) && !contents.has(item.id), 'El respaldo contiene un archivo inválido.');
    contents.set(item.id, item.content);
  }
  const output = { people: [...registry.values()], invoices: [], documents: [], activity: [], files: [] };
  for (const entry of data.invoices) {
    const id = 'xml:' + entry.id;
    check(UUID.test(entry.id) && contents.has(id), 'Falta un XML en el respaldo.');
    const raw = decode64(contents.get(id));
    const row = withFiscal(parseXml(raw), raw);
    check(entry.id === row.id && (registry.has(row.from.rfc) || registry.has(row.to.rfc)), 'El XML del respaldo no coincide.');
    output.invoices.push(row);
    output.files.push({ id, blob: new Blob([raw], { type: 'application/xml' }) });
    contents.delete(id);
  }
  for (const entry of data.documents) {
    check(typeof entry.id === 'string' && /^pdf:[a-f0-9-]{36}$/.test(entry.id) && contents.has(entry.id) &&
      registry.has(entry.rfc) && DOCUMENTS.includes(entry.kind) && /^\d{4}-\d{2}-\d{2}$/.test(entry.date) &&
      validText(entry.period, 40) && validText(entry.name, 180), 'El respaldo contiene un documento inválido.');
    const blob = new Blob([decode64(contents.get(entry.id))], { type: 'application/pdf' });
    check(await pdfOk(blob), 'El respaldo contiene un PDF dañado.');
    const { id, rfc, kind, date, period, name, uuid } = entry;
    check(uuid === undefined || uuid === '' || (typeof uuid === 'string' && UUID.test(uuid)), 'El respaldo contiene un UUID de PDF inválido.');
    output.documents.push({ id, rfc, kind, date, period, name, uuid });
    output.files.push({ id, blob });
    contents.delete(id);
  }
  for (const entry of data.activity) {
    check(validText(entry.id, 70) && validText(entry.name, 180) && validText(entry.date, 40) &&
      ['added', 'duplicates', 'review'].every(key => Number.isSafeInteger(entry[key]) && entry[key] >= 0), 'El historial del respaldo es inválido.');
    const { id, name, date, added, duplicates, review } = entry;
    const issues = Array.isArray(entry.issues) ? entry.issues.slice(0, 20)
      .filter(item => validText(item?.name, 180) && validText(item.reason, 320))
      .map(item => ({ name: item.name, reason: item.reason })) : [];
    const restored = { id, name, date, added, duplicates, review, issues };
    if (validText(entry.event, 320)) restored.event = entry.event;
    output.activity.push(restored);
  }
  check(contents.size === 0, 'El respaldo contiene archivos sin expediente.');
  return output;
}
async function backupDialog() {
  await requireStorage();
  check(!importing && crypto.subtle, 'El respaldo no está disponible en este navegador o hay una importación activa.');
  const password = input('password', { required: true, minLength: 12, autocomplete: 'new-password' });
  const repeat = input('password', { required: true, minLength: 12, autocomplete: 'new-password' });
  dialog('Crear respaldo cifrado', [n('p', 'Sin esta contraseña el respaldo NO se puede abrir: no hay forma de recuperarla. Guárdala en tu gestor de contraseñas.', 'news-note'),
    field('Contraseña de al menos 12 caracteres', password), field('Confirma la contraseña', repeat)], async () => {
    check(password.value.length >= 12 && password.value === repeat.value, 'Revisa que las contraseñas coincidan.');
    download(await encryptBackup(await snapshot(), password.value), 'PacoSAT-' + new Date().toISOString().slice(0, 10) + '.faro');
    await logEvent('Respaldo cifrado creado');
    announce('Respaldo cifrado generado.');
    soundCue('success');
  }, 'Crear respaldo');
}
/* ZIP sin compresión (método «stored») construido en el navegador para
   el paquete mensual: basta el CRC y el directorio central que ya sabe
   leer zipXml, sin dependencias nuevas. */
function zipStore(entries) {
  const encoder = new TextEncoder();
  const parts = [], centrals = [];
  let offset = 0;
  for (const entry of entries) {
    const name = encoder.encode(entry.name);
    const data = entry.data instanceof Uint8Array ? entry.data : encoder.encode(String(entry.data));
    const crc = crc32(data);
    const local = new DataView(new ArrayBuffer(30));
    local.setUint32(0, 0x04034b50, true); local.setUint16(4, 20, true);
    local.setUint32(14, crc, true); local.setUint32(18, data.length, true); local.setUint32(22, data.length, true);
    local.setUint16(26, name.length, true);
    parts.push(new Uint8Array(local.buffer), name, data);
    const central = new DataView(new ArrayBuffer(46));
    central.setUint32(0, 0x02014b50, true); central.setUint16(4, 20, true); central.setUint16(6, 20, true);
    central.setUint32(16, crc, true); central.setUint32(20, data.length, true); central.setUint32(24, data.length, true);
    central.setUint16(28, name.length, true); central.setUint32(42, offset, true);
    centrals.push(new Uint8Array(central.buffer), name);
    offset += 30 + name.length + data.length;
  }
  const end = new DataView(new ArrayBuffer(22));
  end.setUint32(0, 0x06054b50, true); end.setUint16(8, entries.length, true); end.setUint16(10, entries.length, true);
  end.setUint32(12, centrals.reduce((sum, part) => sum + part.length, 0), true); end.setUint32(16, offset, true);
  parts.push(...centrals, new Uint8Array(end.buffer));
  return new Blob(parts, { type: 'application/zip' });
}
function monthlyPackageManifest(rfc, monthKey, files, generatedAt, installName = '') {
  return ['PacoSAT · Paquete mensual para la contadora', 'RFC: ' + rfc, 'Mes: ' + monthKey,
    'Generado: ' + generatedAt, ...(installName ? ['Instalación: ' + installName] : []), '', 'Contenido del paquete:']
    .concat(files.map(name => '- ' + name)).join('\n') + '\n';
}
async function restoreDialog(file) {
  await requireStorage();
  check(!importing && crypto.subtle, 'Espera a que termine la importación o abre la app en un navegador compatible.');
  const password = input('password', { required: true, autocomplete: 'off' });
  /* Restauración segura (UX-08): primero se LEE el respaldo y se enseña
     su contenido; nada se reemplaza hasta la confirmación del paso 2,
     que además ofrece guardar una copia cifrada de lo actual. */
  dialog('Restaurar respaldo', [n('p', 'Primero se lee el respaldo y se muestra qué contiene. Nada se reemplaza hasta que confirmes en el paso siguiente.'), field('Contraseña del respaldo', password)], async () => {
    const rawBackup = await decryptBackup(file, password.value);
    const contents = await validateBackup(rawBackup);
    const labels = { people: 'contribuyentes', invoices: 'CFDI', documents: 'documentos', files: 'archivos', activity: 'eventos de actividad' };
    const summary = STORES.map(name => contents[name].length + ' ' + labels[name]).join(' · ');
    const saveFirst = input('checkbox'); saveFirst.checked = true;
    const confirm = input('checkbox', { required: true });
    setTimeout(() => {
      dialog('Confirmar restauración', [
        n('p', 'Este respaldo contiene: ' + summary + '.'),
        rawBackup.operations ? n('p', 'Incluye el estado operativo (descargas, criterios 5002 y avisos pendientes).') :
          n('p', 'No incluye estado operativo (es un respaldo anterior): tras restaurar, desbloquea cada perfil para reanudar las descargas.'),
        n('p', 'Al restaurar se REEMPLAZAN los expedientes actuales por los del respaldo.'),
        field('Guardar antes una copia cifrada de lo actual (con la contraseña de este respaldo)', saveFirst),
        field('Confirmo que quiero reemplazar los datos actuales', confirm)], async () => {
        check(confirm.checked, 'Confirma el reemplazo de los datos.');
        if (saveFirst.checked) {
          download(await encryptBackup(await snapshot(), password.value),
            'PacoSAT-antes-de-restaurar-' + new Date().toISOString().slice(0, 10) + '.faro');
        }
        await writeBatch(contents, true);
        let operationsNote = '';
        if (rawBackup.operations && typeof satToken !== 'undefined' && satToken) {
          await satApi('backup/operations', rawBackup.operations);
          await pollSat();
          operationsNote = ' También se restauró el estado operativo (descargas, criterios 5002 y avisos pendientes); desbloquea cada perfil para reanudar.';
        }
        await refresh();
        await logEvent('Respaldo restaurado desde un archivo cifrado');
        announce('Respaldo restaurado.' + operationsNote);
      }, 'Restaurar ahora');
    }, 80);
  }, 'Leer el respaldo');
}
const handle = work => () => Promise.resolve().then(work).catch(error => announce(error.message, true));
$('add').onclick = handle(addPerson);
$('inspect').onclick = () => $('inspectFile').click();
$('inspectFile').onchange = handle(async () => {
  const file = $('inspectFile').files[0];
  $('inspectFile').value = '';
  if (file) await viewXml(file, file.name);
});
$('primary').onclick = handle(async () => {
  if (page === 'avisos') { await refreshAvisos(true); render(); return; }
  if (page === 'operations') { await pollSat(); await pollMonitor(); render(); return; }
  if (page === 'coverage') { await pollSat(); render(); return; }
  if (page === 'settings') { await saveAppSettings(); return; }
  if (page === 'capacidades') { navigate('settings'); return; }
  if (page === 'lists') { await satApi('lists/refresh', {}); await loadLists(); toast('Listados actualizados y cruzados con tu padrón.', 'ok'); return; }
  if (page === 'salidas') { await exportFull(''); return; }
  if (page === 'dinero') { navigate('salidas'); return; }
