for (const button of document.querySelectorAll('[data-view]')) button.onclick = () => { announce(); navigate(button.dataset.view); };
/* Buscador global (1.6.5): por UUID completo o parcial, folio fiscal
   (el propio UUID) o RFC de emisor/receptor. Aplica el término en el
   archivo de facturas y, si hay un único resultado, abre su detalle.
   Atajo Ctrl/Cmd+K para enfocar el buscador (no pisa la escritura en
   campos: solo actúa fuera de ellos o sobre el propio buscador). */
const globalSearchInput = $('global-search');
function runGlobalSearch() {
  const query = globalSearchInput.value.trim();
  if (!query) return;
  /* El buscador también EJECUTA acciones (1.6.11): nombres de pantalla
     y órdenes cortas («descargar ahora MFI…», «crear respaldo», «ir a
     cobertura») se resuelven antes de tratar el texto como búsqueda. */
  const lower = query.toLocaleLowerCase('es-MX');
  const screensByWord = [['resumen', 'home'], ['inicio', 'home'], ['hoy', 'home'], ['avisos', 'avisos'], ['centro de avisos', 'avisos'], ['facturas', 'invoices'], ['cfdi', 'invoices'],
    ['expedientes', 'docs'], ['documentos', 'docs'], ['centro sat', 'sat'], ['descargas', 'sat'], ['vigilancia', 'monitor'],
    ['69-b', 'monitor'], ['operaciones', 'operations'], ['alertas', 'operations'], ['cobertura', 'coverage'], ['huecos', 'coverage'],
    ['respaldos', 'backup'], ['respaldo', 'backup'], ['diot', 'diot'], ['ajustes', 'settings'], ['qué incluye', 'capacidades'], ['capacidades', 'capacidades']];
  const downloadMatch = lower.match(/^descargar(?: ahora)?\s+([a-z0-9]{12,13})$/i);
  if (downloadMatch && typeof satData !== 'undefined' && satData) {
    const rfc = downloadMatch[1].toUpperCase();
    const profile = (satData.profiles || []).find(row => row.rfc === rfc);
    if (profile?.unlocked) {
      requestRunNow(rfc).then(data => { if (data) { satData = data; announce('Revisión inmediata de ' + rfc + ' ejecutada.'); soundCue('success'); } })
        .catch(error => announce(error.message, true));
      return;
    }
  }
  const screenHit = screensByWord.find(([word]) => lower === word || lower === 'ir a ' + word || lower === 'abrir ' + word);
  if (screenHit) { navigate(screenHit[1]); announce('Abriendo «' + query + '».'); return; }
  if (lower === 'crear respaldo' || lower === 'hacer respaldo') { navigate('backup'); backupDialog(); return; }
  const hadFilters = Boolean(term || month || invoiceKind || invoiceState);
  term = query; invoiceState = ''; invoiceKind = ''; month = ''; invoicePage = 0;
  navigate('invoices');
  const found = invoiceRows();
  if (found.length === 1) invoiceDetail(found[0]);
  else announce((hadFilters ? 'Filtros anteriores limpiados. ' : '') +
    (found.length ? number.format(found.length) + ' comprobantes coinciden con «' + query + '».' :
    'Sin comprobantes para «' + query + '».'), !found.length);
}
globalSearchInput.addEventListener('keydown', event => {
  if (event.key === 'Enter') { event.preventDefault(); runGlobalSearch(); }
});
document.addEventListener('keydown', event => {
  if (!(event.ctrlKey || event.metaKey) || event.key.toLowerCase() !== 'k' || $('dialog').open) return;
  if (document.activeElement?.matches('input,select,textarea') && document.activeElement !== globalSearchInput) return;
  event.preventDefault();
  globalSearchInput.focus();
  globalSearchInput.select();
});
$('scope').onchange = () => { scope = $('scope').value; invoicePage = 0; render(); };
$('incoming').onchange = () => { const files = [...$('incoming').files]; $('incoming').value = ''; importBatch(files).catch(error => announce(error.message, true)); };
$('folder').onchange = () => { const files = [...$('folder').files]; $('folder').value = ''; importBatch(files, scope, { fromFolder: true }).catch(error => announce(error.message, true)); };
$('restore').onchange = handle(() => {
  const file = $('restore').files[0]; $('restore').value = ''; if (file) return restoreDialog(file);
});
$('close').onclick = $('cancel').onclick = () => $('dialog').close();
$('dialog').addEventListener('cancel', event => { if ($('save').disabled) event.preventDefault(); });
$('dialog').addEventListener('close', () => { $('fields').replaceChildren(); submit = null; });
$('form').onsubmit = async event => {
  event.preventDefault();
  if (!submit || $('save').disabled) return;
  $('save').disabled = $('cancel').disabled = $('close').disabled = true;
  $('formError').hidden = true;
  try { await submit(); $('dialog').close(); }
  catch (error) { $('formError').textContent = error.message; $('formError').hidden = false; }
  finally { $('save').disabled = $('cancel').disabled = $('close').disabled = false; }
};
window.addEventListener('dragover', event => {
  if (event.dataTransfer.types.includes('Files')) {
    event.preventDefault();
    if (!$('dialog').open) $('body').classList.add('drag-active');
  }
});
window.addEventListener('dragleave', event => { if (!event.relatedTarget) $('body').classList.remove('drag-active'); });
window.addEventListener('drop', event => {
  if (!event.dataTransfer.files.length) return;
  if ($('dialog').open && event.target instanceof HTMLInputElement && event.target.type === 'file') return;
  event.preventDefault(); $('body').classList.remove('drag-active');
  if (!$('dialog').open) importBatch(event.dataTransfer.files).catch(error => announce(error.message, true));
});
/* Preparación del almacenamiento (1.6.8). Hasta la 1.6.7, las acciones
   comprobaban `ready` en el acto y se rendían con «El almacenamiento
   todavía no está disponible.» si el usuario actuaba antes de que el
   arranque terminara; y si la apertura quedaba bloqueada por otra
   pestaña o fallaba, `ready` quedaba en falso para siempre y no había
   recuperación. Ahora las acciones ESPERAN a la preparación
   (requireStorage) con un límite razonable; si el almacén de verdad no
   abre, hay un reintento — el bloqueo pudo ceder si la otra pestaña ya
   se cerró — y solo entonces un mensaje claro y accionable según el
   modo y la causa (storageAdvice). En modo servidor (cloudStorage) la
   preparación es la carga inicial de datos desde el servidor: las
   acciones trabajan contra el servidor y nunca dependen de IndexedDB. */
const STORAGE_WAIT_MS = 10000;
let storageFailure = null;   // error definitivo de la última apertura local
let storagePending = false;  // hay una apertura local en curso
async function openLocalStorage() {
  storagePending = true;
  try { db = await openDatabase(); return true; }
  catch (error) { storageFailure = error; return false; }
  finally { storagePending = false; }
}
function storageAdvice() {
  if (cloudStorage) return 'PacoSAT no pudo cargar los datos del servidor. Revisa la conexión con el servidor, recarga la página y vuelve a intentarlo.';
  if (isStorageBlocked()) return 'Otra pestaña o ventana de PacoSAT tiene el almacenamiento local ocupado. Cierra las demás pestañas de PacoSAT, recarga esta página y vuelve a intentarlo.';
  return 'El navegador no dejó abrir el almacenamiento local de PacoSAT. Cierra las demás pestañas de la app, recarga la página y vuelve a intentarlo; si aun así falla, abre la app en Chrome o Edge con un perfil normal (no privado).';
}
let storageAttempt, readiness;
function beginReadiness() {
  storageAttempt = cloudStorage ? Promise.resolve(true) : openLocalStorage();
  readiness = storageAttempt.then(async opened => {
    if (!opened) return false;
    ready = true;
    await refresh();
    return true;
  });
  return readiness;
}
async function waitReadiness(waitMs) {
  if (ready) return true;
  /* `readiness` solo existe si el arranque ya ejecutó beginReadiness()
     (al final de este guion). Una acción puede llegar antes de eso — en
     Safari iOS le pasó a Paco al tocar «Agregar RFC» — o el arranque
     puede haberse quedado a medias, y la preparación se inicia entonces
     aquí mismo, perezosamente: la conducta es esperar, no reventar
     evaluando `.then` sobre undefined («undefined is not an object
     (evaluating 'readiness.then')» en JavaScriptCore). */
  if (!readiness) beginReadiness();
  let timer;
  const timeout = new Promise(resolve => { timer = setTimeout(() => resolve(false), waitMs); });
  const settled = readiness.then(() => ready, () => ready);
  const ok = await Promise.race([settled, timeout]);
  clearTimeout(timer);
  return Boolean(ok && ready);
}
async function retryStorage(waitMs) {
