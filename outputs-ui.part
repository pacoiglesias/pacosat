/* ===== Centro de salidas (1.6.16) =====
   Reportes con el desglose fiscal persistido, IVA del mes por RFC,
   comparativas año contra año, cierre de mes guiado, correo desde la
   app con su bitácora, informes automáticos (mensual a la contadora y
   resumen semanal) y la exportación completa legible. Todo se calcula
   con los datos del expediente: lo que no tiene desglose se dice, no
   se estima. */
const OUT = { month: new Date().toISOString().slice(0, 7), cp: '' };
function outMonthInvoices(month) {
  return invoices.filter(row => row.date.startsWith(month) && (!scope || row.from.rfc === scope || row.to.rfc === scope));
}
function ivaRows(month) {
  return people.map(person => {
    let issuedIva = 0n, receivedIva = 0n, issuedCount = 0, receivedCount = 0, missing = 0;
    for (const row of invoices) {
      if (!row.date.startsWith(month) || row.kind !== 'I' || (row.currency && row.currency !== 'MXN')) continue;
      const iva = invoiceIvaCents(row);
      if (row.from.rfc === person.id) { issuedCount++; if (iva === null) missing++; else issuedIva += iva; }
      if (row.to.rfc === person.id) { receivedCount++; if (iva === null) missing++; else receivedIva += iva; }
    }
    return { rfc: person.id, name: person.name, issuedIva, receivedIva, issuedCount, receivedCount, missing,
      balance: issuedIva - receivedIva };
  }).filter(row => row.issuedCount || row.receivedCount);
}
function salidasScreen() {
  const wrap = n('div');
  /* IVA del mes */
  const ivaPanel = panel('IVA del mes por RFC', 'IVA trasladado (lo que cobraste) e IVA acreditable (lo que te facturaron), desde el desglose guardado de cada XML. Si falta desglose, reprocésalo abajo: nunca se estima a ojo.');
  const monthRow = n('div', undefined, 'filterbar');
  const monthInput = input('month', { value: OUT.month, 'aria-label': 'Mes' });
  monthInput.onchange = () => { OUT.month = monthInput.value || OUT.month; render(); };
  monthRow.append(n('label', 'Mes '), monthInput);
  ivaPanel.append(monthRow);
  const rows = ivaRows(OUT.month);
  if (!rows.length) ivaPanel.append(n('p', 'Sin CFDI de ingreso en ese mes para tus RFC.', 'empty'));
  else ivaPanel.append(grid(['RFC', 'IVA trasladado', 'IVA acreditable', 'Saldo del mes', 'CFDI sin desglose'],
    rows.map(row => [cell(row.name || row.rfc, row.rfc),
      '$' + centsLabel(row.issuedIva), '$' + centsLabel(row.receivedIva),
      (row.balance >= 0n ? 'A pagar ≈ $' : 'A favor ≈ $') + centsLabel(row.balance < 0n ? -row.balance : row.balance),
      row.missing ? row.missing + ' (reprocesa)' : '—'])));
  /* El reproceso NO vive aquí (1.32.1, C3): su casa es Centro
     SAT › Estado de mis CFDI. Cuando faltan desgloses, este
     panel lo dice y enlaza allí — un solo sitio para la
     herramienta, sin duplicarla en cada pantalla que la echa
     de menos. */
  const faltanDesglose = rows.reduce((acc, row) => acc + (row.missing || 0), 0);
  if (faltanDesglose) {
    const aviso = n('div', undefined, 'cp-row');
    aviso.append(n('span', number.format(faltanDesglose) + ' CFDI sin desglose de IVA: su reproceso vive en Centro SAT › Estado de mis CFDI.'));
    const ir = n('button', 'Ir a Estado de mis CFDI', 'soft');
    ir.type = 'button';
    ir.onclick = () => { satTab = 'monitor'; navigate('sat'); };
    aviso.append(ir);
    ivaPanel.append(aviso);
  }
  wrap.append(ivaPanel);
  /* Reporte del periodo */
  const reportPanel = panel('Reporte del periodo', 'Totales del mes por sentido y por contraparte, con su IVA. Se puede imprimir, bajar en CSV o enviar por correo desde aquí.');
  const cpInput = input('search', { placeholder: 'Filtrar por contraparte (nombre o RFC)…', value: OUT.cp, 'aria-label': 'Contraparte' });
  cpInput.onchange = () => { OUT.cp = cpInput.value; render(); };
  reportPanel.append(cpInput);
  const monthInvoices = outMonthInvoices(OUT.month).filter(row =>
    !OUT.cp || (row.from.name + row.from.rfc + row.to.name + row.to.rfc).toLowerCase().includes(OUT.cp.toLowerCase()));
  let issuedTotal = 0n, receivedTotal = 0n, issuedIva = 0n, receivedIva = 0n;
  for (const row of monthInvoices) {
    if (row.currency && row.currency !== 'MXN') continue;
    const role = roles(row), iva = invoiceIvaCents(row);
    if (role.issued) { issuedTotal += totalCents(row); if (iva !== null) issuedIva += iva; }
    if (role.received) { receivedTotal += totalCents(row); if (iva !== null) receivedIva += iva; }
  }
  reportPanel.append(grid(['Concepto', 'Importe'], [
    ['CFDI emitidos (' + monthInvoices.filter(row => roles(row).issued).length + ')', '$' + centsLabel(issuedTotal)],
    ['IVA trasladado del mes', '$' + centsLabel(issuedIva)],
    ['CFDI recibidos (' + monthInvoices.filter(row => roles(row).received).length + ')', '$' + centsLabel(receivedTotal)],
    ['IVA acreditable del mes', '$' + centsLabel(receivedIva)]
  ]));
  const reportActions = n('div', undefined, 'sat-actions');
  const printBtn = n('button', 'Imprimir reporte', 'soft');
  printBtn.onclick = () => printPeriodReport(OUT.month, monthInvoices, { issuedTotal, receivedTotal, issuedIva, receivedIva });
  const csvBtn = n('button', 'Descargar CSV del mes', 'soft');
  csvBtn.onclick = () => download(new Blob(['\uFEFF', periodCsv(OUT.month)], { type: 'text/csv;charset=utf-8' }), 'reporte-' + OUT.month + '.csv');
  const mailBtn = n('button', 'Enviar por correo', 'soft');
  mailBtn.onclick = () => composeMailDialog({ subject: 'PacoSAT · Reporte ' + OUT.month,
    text: 'Adjunto el reporte del mes ' + OUT.month + ' generado por PacoSAT.',
    attachments: [{ filename: 'reporte-' + OUT.month + '.csv', content: encode64(new TextEncoder().encode(periodCsv(OUT.month))) }] });
  reportActions.append(printBtn, csvBtn, mailBtn);
  reportPanel.append(reportActions);
  wrap.append(reportPanel);
  /* Salidas diseñadas (Ronda Salidas, 1.14.0): los artefactos los
     construye el servidor con las cifras verdad; aquí solo se piden.
     Sin servidor se dice claro y no se finge ninguna descarga. */
  if (satToken) wrap.append(salidasDisenadasPanel());
  /* Tanda 7A: cierre guiado con semáforo real, ZIP del mes,
     envío al despacho, pólizas, candado y panel de valor. */
  if (satToken) { wrap.append(cierre200gPanel()); wrap.append(valor200gPanel()); }
  else wrap.append(panel('Salidas por destino (PDF y Excel)', 'Los PDF de papel y los Excel reales los construye el servidor de PacoSAT: conecta la app en modo servidor (NAS) para descargarlos desde aquí.'));
  /* Reporte Mano Fil (1.16.0, P12): su panel propio, tras las
     salidas diseñadas; sin servidor no se finge la descarga. */
  if (satToken) wrap.append(manoFilPanel());
  /* Comparativas año contra año */
  wrap.append(yoyPanel());
  /* El cierre guiado vive SOLO en su pestaña (1.18.0): la copia
     que esta pantalla pintaba en paralelo — con destinos que no
     llevaban a donde el paso se resuelve — se retiró. Aquí queda
     el camino, de un toque. */
  const cierrePointer = panel('Cierre del mes', 'La lista de pasos del cierre, con su estado y el camino a resolver cada uno, vive en su pestaña.');
  cierrePointer.append(action('Abrir el cierre guiado', () => { cierreSection = 'cierre'; render(); }, 'primary', 'check'));
  wrap.append(cierrePointer);
  /* Correo e informes automáticos viven en Ajustes › Correo y
     la exportación completa en Ajustes › Respaldos (1.32.1,
     C1): esta pantalla se queda con el cierre del mes — IVA,
     reportes del periodo y salidas por destino. */
  return [wrap];
}
/* Pide un artefacto de la capa de salidas y lo descarga con su
   nombre. El botón muestra «Preparando…» mientras el servidor
   trabaja: si algo falla, se dice el error tal cual. */
async function salidaDescargar(ruta, payload, boton) {
  const texto = boton ? boton.textContent : '';
  if (boton) { boton.disabled = true; boton.textContent = 'Preparando…'; }
  try {
    const data = await satApi(ruta, payload);
    download(new Blob([decode64(data.content)], { type: data.type || 'application/octet-stream' }), data.name);
    toast('Salida lista: ' + data.name, 'ok');
  } catch (error) { toast(error.message, 'error'); }
  finally { if (boton) { boton.disabled = false; boton.textContent = texto; } }
}
/* Salidas por destino (1.18.0): el muro de 14 botones se convierte
   en tres tarjetas — Para tu contadora · Para el banco · Para ti —
   con un botón por salida y su última generación al lado, leída
   del registro que el servidor lleva de cada artefacto. */
function salidasDisenadasPanel() {
  const panelEl = panel('Salidas por destino', 'Artefactos pensados para quien los recibe, no volcados de pantalla: PDF tamaño carta con folio y totales para imprimir o enviar, Excel real con importes como números, filtros y sumas, y ZIP ordenados por carpetas con su índice. Todo sale del mes y el RFC elegidos arriba.');
  const rfc = () => scope || people[0]?.id || '';
  const destinos = [
    ['Para tu contadora', [
      ['PDF de cierre mensual', 'salidas/pdf', () => ({ kind: 'cierre', rfc: rfc(), month: OUT.month }), 'pdf:cierre'],
      ['ZIP de cierre (con constancia y opinión)', 'salidas/zip', () => ({ scope: 'cierre', rfc: rfc(), month: OUT.month }), 'zip:cierre'],
      ['PDF del periodo', 'salidas/pdf', () => ({ kind: 'periodo', rfc: rfc(), month: OUT.month }), 'pdf:periodo'],
      ['ZIP del periodo', 'salidas/zip', () => ({ scope: 'periodo', rfc: rfc(), month: OUT.month }), 'zip:periodo'],
      ['Excel de facturas', 'salidas/xlsx', () => ({ kind: 'facturas', rfc: rfc(), month: OUT.month }), 'xlsx:facturas']]],
    ['Para el banco', [
      ['Excel de pagos al banco', 'salidas/xlsx', () => ({ kind: 'pagos', rfc: rfc() }), 'xlsx:pagos'],
      ['PDF de saldos', 'salidas/pdf', () => ({ kind: 'saldos', rfc: rfc() }), 'pdf:saldos'],
      ['Excel de saldos por cobrar', 'salidas/xlsx', () => ({ kind: 'saldos-cobrar', rfc: rfc() }), 'xlsx:saldos'],
      ['Excel de saldos por pagar', 'salidas/xlsx', () => ({ kind: 'saldos-pagar', rfc: rfc() }), 'xlsx:saldos']]],
    ['Para ti', [
      ['PDF del mapa anual de declaraciones', 'salidas/pdf', () => ({ kind: 'declaraciones', rfc: rfc(), year: OUT.month.slice(0, 4) }), 'pdf:declaraciones'],
      ['Excel de complementos de pago', 'salidas/xlsx', () => ({ kind: 'complementos', rfc: rfc() }), 'xlsx:complementos'],
      ['Excel de listados del SAT', 'salidas/xlsx', { kind: 'listados' }, 'xlsx:listados'],
      ['ZIP de todo el RFC', 'salidas/zip', () => ({ scope: 'rfc', rfc: rfc(), year: OUT.month.slice(0, 4) }), 'zip:rfc']]],
    /* Reportes nuevos (1.31.0): los de pantalla — Totales,
       Declaraciones, Avisos y Dinero — con el mismo patrón de
       filas (ruta + payload { kind, rfc } y el año donde
       aplica). El PDF de declaraciones es el que ya vivía en
       «Para ti»: se enlaza también aquí, en su tarjeta. */
    ['Reportes de pantalla', [
      ['PDF de Totales', 'salidas/pdf', () => ({ kind: 'totales', rfc: rfc(), year: OUT.month.slice(0, 4) }), 'pdf:totales'],
      ['Excel de Totales', 'salidas/xlsx', () => ({ kind: 'totales', rfc: rfc(), year: OUT.month.slice(0, 4) }), 'xlsx:totales'],
      ['PDF de Declaraciones', 'salidas/pdf', () => ({ kind: 'declaraciones', rfc: rfc(), year: OUT.month.slice(0, 4) }), 'pdf:declaraciones'],
      ['Excel de Declaraciones', 'salidas/xlsx', () => ({ kind: 'declaraciones', rfc: rfc(), year: OUT.month.slice(0, 4) }), 'xlsx:declaraciones'],
      ['PDF de Avisos', 'salidas/pdf', () => ({ kind: 'avisos', rfc: rfc() }), 'pdf:avisos'],
      ['Excel de Avisos', 'salidas/xlsx', () => ({ kind: 'avisos', rfc: rfc() }), 'xlsx:avisos'],
      ['Excel de Dinero', 'salidas/xlsx', () => ({ kind: 'dinero', rfc: rfc() }), 'xlsx:dinero']]]
  ];
  for (const [titulo, salidas] of destinos) {
    const card = n('div', undefined, 'kpi');
    card.append(n('strong', titulo));
    /* Una salida principal por destino (1.32.1, C2): la que se
       usa; el resto vive en el ⋯ de la tarjeta, con su nombre
       completo. La cara dejó de ser un muro de 20 botones
       idénticos donde nada mandaba. */
    salidas.forEach(([label, ruta, payload, clave], indice) => {
      if (indice > 0) return;
      const fila = n('div', undefined, 'cp-row');
      const btn = n('button', label, 'primary');
      btn.onclick = () => salidaDescargar(ruta, typeof payload === 'function' ? payload() : payload, btn);
      const ultima = n('span', 'Sin generar todavía', 'muted');
      ultima.dataset.salidaUltima = clave;
      fila.append(btn, ultima);
      card.append(fila);
    });
    const resto = salidas.slice(1);
    if (resto.length && typeof cardMenu1312 === 'function') {
      const menu = cardMenu1312(resto.map(([label, ruta, payload]) => [label,
        (boton) => salidaDescargar(ruta, typeof payload === 'function' ? payload() : payload, boton)]));
      menu.classList.add('salidas-mas');
      const filaMenu = n('div', undefined, 'cp-row');
      filaMenu.append(n('span', 'Más salidas de este destino', 'muted'), menu);
      card.append(filaMenu);
    }
    panelEl.append(card);
  }
  (async () => {
    const last = await satApi('salidas/last').catch(() => null);
    if (!last || !panelEl.isConnected) return;
    for (const el of panelEl.querySelectorAll('[data-salida-ultima]')) {
      const at = last[el.dataset.salidaUltima];
      if (at) el.textContent = 'Última generación: ' + localDate(at);
    }
  })();
  /* Reporte por contraparte: se elige quién y sale su PDF con
     movimientos, folio y saldo neto en letra. */
  const cps = new Map();
  for (const row of invoices) {
    if (scope && row.from.rfc !== scope && row.to.rfc !== scope) continue;
    const cp = row.from.rfc === scope ? row.to : row.from;
    if (cp?.rfc && cp.rfc !== scope) cps.set(cp.rfc, cp.name || cp.rfc);
  }
  if (cps.size) {
    const row = n('div', undefined, 'sat-actions');
    const picker = select([...cps.entries()].map(([value, label]) => [value, label + ' · ' + value]), [...cps.keys()][0], 'Contraparte del reporte');
    const btn = n('button', 'PDF por contraparte', 'soft');
    btn.onclick = () => salidaDescargar('salidas/pdf', { kind: 'contraparte', rfc: rfc(), contraparte: picker.value }, btn);
    row.append(picker, btn);
    panelEl.append(row);
  }
  return panelEl;
}
/* Reporte Mano Fil (1.16.0, propuesta P12): el informe del negocio
   para Rodrigo y José Javier en un par de toques — periodo por mes
   (el elegido arriba) o por rango —, en PDF diseñado o Excel real,
   construido por el servidor SOLO con datos de Mano Fil: el RFC va
   fijo en el servidor y ningún otro negocio se mezcla. */
const MFPERIODO = { mode: 'mes' };
function manoFilPanel() {
  const RFC = 'MFI6212158B4';
  const panelEl = panel('Reporte Mano Fil', 'El informe del negocio para Rodrigo y José Javier, desde el expediente: cuánto se facturó y cuánto se cobró, los pagos a proveedores con su folio, lo que se debe y a quién, los impuestos presentados, la nómina del periodo y el saldo en bancos. El resumen responde en pocas líneas y el detalle va detrás. Solo datos de Mano Fil.');
  if (!people.some(person => person.id === RFC)) {
    panelEl.append(n('p', 'El perfil de Mano Fil (' + RFC + ') no está en este expediente: este reporte es solo de ese negocio y no se genera para ningún otro.', 'empty'));
    return panelEl;
  }
  const modo = select([['mes', 'Mes completo'], ['rango', 'Rango de fechas']], MFPERIODO.mode, 'Periodo del reporte');
  const modoRow = n('div', undefined, 'filterbar');
  modoRow.append(n('label', 'Periodo '), modo);
  const mesRow = n('div', undefined, 'filterbar');
  mesRow.append(n('span', 'Mes del reporte: '), n('strong', OUT.month), n('span', ' (el mes elegido arriba, en «IVA del mes»)'));
  const [anio, mes] = OUT.month.split('-').map(Number);
  const ultimoDia = OUT.month + '-' + String(new Date(Date.UTC(anio, mes, 0)).getUTCDate()).padStart(2, '0');
  const desde = input('date', { value: OUT.month + '-01', 'aria-label': 'Desde' });
  const hasta = input('date', { value: ultimoDia, 'aria-label': 'Hasta' });
  const rangoRow = n('div', undefined, 'filterbar');
  rangoRow.append(n('label', 'Desde '), desde, n('label', ' Hasta '), hasta);
  const sync = () => { const esMes = modo.value === 'mes'; MFPERIODO.mode = modo.value;
    mesRow.style.display = esMes ? '' : 'none'; rangoRow.style.display = esMes ? 'none' : ''; };
  modo.onchange = sync;
  const actions = n('div', undefined, 'sat-actions');
  const payload = () => MFPERIODO.mode === 'mes' ? { month: OUT.month } : { from: desde.value, to: hasta.value };
  const pdfBtn = n('button', 'Descargar el reporte en PDF', 'primary');
  pdfBtn.onclick = () => salidaDescargar('salidas/reporte-manofil', { ...payload(), format: 'pdf' }, pdfBtn);
  const xlsxBtn = n('button', 'Descargar el reporte en Excel', 'soft');
  xlsxBtn.onclick = () => salidaDescargar('salidas/reporte-manofil', { ...payload(), format: 'xlsx' }, xlsxBtn);
  actions.append(pdfBtn, xlsxBtn);
  panelEl.append(modoRow, mesRow, rangoRow, actions);
  sync();
  return panelEl;
}
function periodCsv(month) {
  const escape = value => '"' + String(value ?? '').replaceAll('"', '""') + '"';
  /* El FOLIO viaja como columna propia desde la Ronda Salidas
     (1.14.0): sin folio, el CSV no se puede cruzar contra el papel
     ni contra el banco. */
  const rows = [['UUID', 'Folio', 'Fecha', 'Tipo', 'Emisor RFC', 'Emisor', 'Receptor RFC', 'Receptor', 'Subtotal', 'IVA', 'Total', 'Moneda', 'Método de pago']];
  for (const row of outMonthInvoices(month)) {
    const iva = invoiceIvaCents(row);
    const folio = row.fiscal ? (row.fiscal.series ? row.fiscal.series + '-' : '') + (row.fiscal.folio || '') : '';
    rows.push([row.id, folio, row.date, row.kind, row.from.rfc, row.from.name, row.to.rfc, row.to.name,
      row.fiscal?.subtotal || '', iva === null ? '' : centsPlain(iva), centsPlain(totalCents(row)), row.currency || 'MXN', row.fiscal?.paymentMethod || '']);
  }
  return rows.map(row => row.map(escape).join(',')).join('\r\n');
}
function printPeriodReport(month, rows, totals) {
  const section = $('print-report');
  section.replaceChildren();
  const head = n('div', undefined, 'report-head');
  head.append(n('h1', 'Reporte del periodo ' + month), n('p', installName + (scope ? ' · ' + scope : ' · Sin contribuyente')));
  const body = n('div', undefined, 'report-body');
  body.append(n('p', 'Emitidos: $' + centsLabel(totals.issuedTotal) + ' (IVA trasladado $' + centsLabel(totals.issuedIva) +
    ') · Recibidos: $' + centsLabel(totals.receivedTotal) + ' (IVA acreditable $' + centsLabel(totals.receivedIva) + ').'));
  const table = n('table');
  const thead = n('thead'); const htr = n('tr');
  for (const label of ['Fecha', 'Folio', 'UUID', 'Contraparte', 'Tipo', 'Total']) htr.append(n('th', label));
  thead.append(htr); table.append(thead);
  const tbody = n('tbody');
  /* Ronda Salidas (1.14.0): el reporte impreso lleva el FOLIO y el
     UUID COMPLETO, y ya no se corta en silencio a 500 filas: salen
     todas las del periodo. */
  for (const row of rows) {
    const role = roles(row);
    const tr = n('tr');
    const folio = row.fiscal ? (row.fiscal.series ? row.fiscal.series + '-' : '') + (row.fiscal.folio || '') : 'Sin folio';
    tr.append(n('td', row.date), n('td', folio), n('td', row.id),
      n('td', (role.issued ? row.to.name : row.from.name) || ''), n('td', row.kind), n('td', money(row.total)));
    tbody.append(tr);
  }
  table.append(tbody);
  body.append(table);
  body.append(n('p', 'Generado por PacoSAT desde el expediente local. Los importes de IVA salen del desglose guardado de cada XML.'));
  section.append(head, body, reportFoot(scope));
  setTimeout(() => window.print(), 80);
}
function yoyPanel() {
  const panelEl = panel('Comparativas año contra año', 'Quién te factura más que el año pasado y qué se está disparando: totales recibidos y emitidos por contraparte, año actual contra anterior (solo MXN).');
  const year = new Date().getFullYear();
  const totals = new Map();
  for (const row of invoices) {
    if ((row.currency && row.currency !== 'MXN') || row.kind !== 'I') continue;
    const y = row.date.slice(0, 4);
    if (y !== String(year) && y !== String(year - 1)) continue;
    for (const [rfc, name, field] of [[row.from.rfc, row.from.name, 'received'], [row.to.rfc, row.to.name, 'issued']]) {
      if (scope && rfc === scope) continue;
      const key = rfc;
      if (!totals.has(key)) totals.set(key, { name: name || rfc, rfc, receivedNow: 0n, receivedPrev: 0n, issuedNow: 0n, issuedPrev: 0n });
      const item = totals.get(key);
      item[field + (y === String(year) ? 'Now' : 'Prev')] += totalCents(row);
    }
  }
  const rows = [...totals.values()].map(item => ({ ...item,
    delta: (item.receivedNow - item.receivedPrev) + (item.issuedNow - item.issuedPrev) }))
    .filter(item => item.receivedNow || item.receivedPrev || item.issuedNow || item.issuedPrev)
    .sort((a, b) => (b.delta < a.delta ? -1 : b.delta > a.delta ? 1 : 0)).slice(0, 15);
  if (!rows.length) { panelEl.append(n('p', 'Aún no hay dos años de datos para comparar.', 'empty')); return panelEl; }
  panelEl.append(grid(['Contraparte', 'Recibido ' + (year - 1), 'Recibido ' + year, 'Emitido ' + (year - 1), 'Emitido ' + year, 'Cambio'],
    rows.map(item => [cell(item.name, item.rfc), '$' + centsLabel(item.receivedPrev), '$' + centsLabel(item.receivedNow),
      '$' + centsLabel(item.issuedPrev), '$' + centsLabel(item.issuedNow),
      (item.delta >= 0n ? '+$' : '−$') + centsLabel(item.delta < 0n ? -item.delta : item.delta)])));
  return panelEl;
}
function composeMailDialog(preset = {}) {
  const to = input('text', { placeholder: 'destinatario@ejemplo.com, otro@ejemplo.com', value: preset.to || '' });
  const subject = input('text', { placeholder: 'Asunto', value: preset.subject || '' });
  const text = n('textarea', preset.text || '');
  text.rows = 6;
  const controls = [field('Para', to), field('Asunto', subject), field('Mensaje', text)];
  if (preset.attachments?.length) controls.push(n('p', 'Adjuntos: ' + preset.attachments.map(item => item.filename).join(', '), 'muted'));
  dialog('Enviar correo desde PacoSAT', controls, async () => {
    await satApi('mail/send', { to: to.value, subject: subject.value, text: text.value, attachments: preset.attachments || [] });
    toast('Correo enviado y anotado en la bitácora.', 'ok');
    if (page === 'salidas') render();
  }, 'Enviar correo');
}
function mailPanel() {
  const panelEl = panel('Correo desde la app', 'Envía CFDI, reportes o constancias sin salir de PacoSAT. Cada envío queda anotado abajo.');
  const compose = n('button', 'Escribir correo', 'primary');
  compose.onclick = () => composeMailDialog();
  panelEl.append(compose);
  /* Correos y avisos · Enviados (2.0 · E10): la lista de
     mail_sends con asunto, destinatario, RFC, hora en el formato
     de la casa, tipo y estado de entrega (con su motivo en
     llano); tocar un envío enseña su contenido — el texto que
     salió y, si se guardó, su HTML —. Solo lectura: nada se
     reenvía desde aquí. */
  const enviados = panel('Correos y avisos · Enviados',
    'Todo lo que salió de esta instalación, con su estado de entrega. Toca un envío para ver su contenido. Solo lectura.');
  const log = n('div');
  enviados.append(log);
  panelEl.append(enviados);
  (async () => {
    try {
      const data = await satApi('mail/log');
      log.replaceChildren();
      if (!data.sends.length) { log.append(n('p', 'Todavía no se ha enviado ningún correo desde la app.', 'muted')); return; }
      for (const send of data.sends.slice(0, 50)) {
        const row = n('div', undefined, 'cp-row');
        row.dataset.mailSend200c = String(send.id);
        const detalle = n('div');
        detalle.hidden = true;
        const verHtml = send.html ? action('Ver el HTML que salió', () => {
          const url = URL.createObjectURL(new Blob([send.html], { type: 'text/html' }));
          window.open(url, '_blank');
        }, 'soft') : null;
        detalle.append(n('pre', send.body || '(este envío no guardó su texto)'));
        if (verHtml) detalle.append(verHtml);
        const cabeza = n('button', '', 'cell-link');
        cabeza.type = 'button';
        cabeza.textContent = send.subject + ' → ' + send.recipients;
        cabeza.onclick = () => { detalle.hidden = !detalle.hidden; };
        row.append(statusPill(send.ok ? 'ok' : 'bad', send.ok ? 'Enviado' : 'Falló'),
          n('span', localDateTime(send.at), 'muted'),
          n('span', (send.kind || 'correo') + (send.rfc ? ' · ' + send.rfc : ''), 'muted'),
          cabeza,
          n('span', send.error ? 'Motivo: ' + send.error : '', 'muted'));
        log.append(row, detalle);
      }
    } catch { /* sin servidor */ }
  })();
  return panelEl;
}
function autoReportsPanel() {
  const panelEl = panel('Informes automáticos', 'El paquete mensual a la contadora (con base DIOT, novedades de listas y PPD), el resumen semanal de los lunes y el Reporte Mano Fil mensual para Rodrigo y José Javier (se genera solo, queda guardado en Expedientes y sale por correo si lo activas). Se configuran una vez y salen solos.');
  const body = n('div');
  panelEl.append(body);
  const fill = async data => {
    const config = data || await satApi('reports/config');
    body.replaceChildren();
    const build = (key, title, withDay) => {
      const item = config[key] || {};
      const form = n('div', undefined, 'satdoc-form');
      const enabled = input('checkbox', { checked: Boolean(item.enabled) });
      const label = n('label', undefined, 'switch-line');
      label.append(enabled, n('span', title));
      form.append(label);
      let dayInput = null;
      if (withDay) { dayInput = input('number', { value: item.day || 3, min: 1, max: 28, 'aria-label': 'Día' }); form.append(n('span', 'Día '), dayInput); }
      const hourInput = input('number', { value: item.hour ?? 9, min: 0, max: 23, 'aria-label': 'Hora' });
      form.append(n('span', ' a las '), hourInput, n('span', ':00'));
      const recipients = input('text', { value: item.recipients || '', placeholder: 'Destinatarios (vacío = tu correo de avisos)' });
      form.append(recipients);
      const save = n('button', 'Guardar', 'soft');
      save.onclick = async () => {
        const next = { ...config, [key]: { enabled: enabled.checked, day: dayInput ? Number(dayInput.value) : 3,
          hour: Number(hourInput.value), recipients: recipients.value } };
        try { fill(await satApi('reports/config', next)); toast('Informe automático guardado.', 'ok'); }
        catch (error) { toast(error.message, 'error'); }
      };
      form.append(save);
      return form;
    };
    body.append(build('nora', 'Informe mensual a la contadora', true), build('weekly', 'Resumen semanal (lunes)', false),
      build('manofil', 'Reporte Mano Fil mensual (Rodrigo y José Javier)', true));
    /* Resumen de viernes (2.0 · A5): la semana fiscal en 5 líneas
       por RFC. Su forma trae día de la semana (1=lunes … 5=viernes);
       sin configuración guardada, el servidor lo activa solo si el
       correo de avisos ya está configurado. */
    {
      const item = config.friday || {};
      const form = n('div', undefined, 'satdoc-form');
      const enabled = input('checkbox', { checked: Boolean(item.enabled ?? (typeof satData !== 'undefined' && satData?.mail?.enabled)) });
      const label = n('label', undefined, 'switch-line');
      label.append(enabled, n('span', 'Resumen de viernes (la semana fiscal en 5 líneas, por RFC)'));
      form.append(label);
      const weekdayInput = input('number', { value: item.weekday || 5, min: 1, max: 7, 'aria-label': 'Día de la semana (1 es lunes)' });
      form.append(n('span', 'Día de la semana (1 = lunes) '), weekdayInput);
      const hourInput = input('number', { value: item.hour ?? 8, min: 0, max: 23, 'aria-label': 'Hora' });
      form.append(n('span', ' a las '), hourInput, n('span', ':00'));
      const recipients = input('text', { value: item.recipients || '', placeholder: 'Destinatarios (vacío = tu correo de avisos)' });
      form.append(recipients);
      const save = n('button', 'Guardar', 'soft');
      save.onclick = async () => {
        const next = { ...config, friday: { enabled: enabled.checked, weekday: Number(weekdayInput.value) || 5,
          hour: Number(hourInput.value), recipients: recipients.value } };
        try { fill(await satApi('reports/config', next)); toast('Informe automático guardado.', 'ok'); }
        catch (error) { toast(error.message, 'error'); }
      };
      form.append(save);
      body.append(form);
    }
    const nowBtn = n('button', 'Enviar ahora el paquete del mes pasado', 'soft');
    nowBtn.onclick = async () => {
      const prev = new Date(); prev.setMonth(prev.getMonth() - 1);
      const month = prev.toISOString().slice(0, 7);
      try {
        const result = await satApi('reports/send-now', { month });
        toast('Paquete de ' + month + ' enviado a ' + result.recipients + ' (' + result.counts.invoices + ' CFDI).', 'ok');
        render();
      } catch (error) { toast(error.message, 'error'); }
    };
    body.append(nowBtn);
    const mfBtn = n('button', 'Enviar ahora el Reporte Mano Fil del mes pasado', 'soft');
    mfBtn.onclick = async () => {
      const prev = new Date(); prev.setMonth(prev.getMonth() - 1);
      const month = prev.toISOString().slice(0, 7);
      try {
        const result = await satApi('reports/send-manofil', { month });
        toast('Reporte Mano Fil de ' + month + ' guardado en Expedientes y enviado a ' + result.recipients + '.', 'ok');
      } catch (error) { toast(error.message, 'error'); }
    };
    body.append(mfBtn);
  };
  fill();
  return panelEl;
}
/* La exportación completa, como panel (1.32.1, C1): su casa
   es Ajustes › Respaldos, junto al respaldo cifrado. */
function salidasExportPanel() {
  const exportPanel = panel('Exportación completa legible', 'Todos tus XML y PDF en carpetas por RFC y año, con su índice CSV. Independiente del respaldo cifrado: tus datos salen enteros cuando quieras.');
  const exportActions = n('div', undefined, 'sat-actions');
  const exportAll = n('button', 'Exportar todo', 'soft');
  exportAll.onclick = () => exportFull('');
  const yearNow = new Date().getFullYear();
  const exportYear = n('button', 'Exportar ' + yearNow, 'soft');
  exportYear.onclick = () => exportFull(String(yearNow));
  exportActions.append(exportAll, exportYear);
  exportPanel.append(exportActions);
  return exportPanel;
}
async function exportFull(year) {
  try {
    if (satToken) {
      toast('Preparando la exportación…', 'ok');
      const data = await satApi('export-full', { year });
      download(new Blob([decode64(data.content)], { type: 'application/zip' }), data.name);
      toast('Exportación lista: ' + data.files + ' archivos.', 'ok');
      return;
    }
    const files = await readStore('files');
    const byId = new Map(files.map(file => [file.id, file]));
    const entries = [];
    const index = [['UUID', 'Fecha', 'Emisor RFC', 'Receptor RFC', 'Tipo', 'Total']];
    for (const row of invoices) {
      const y = row.date.slice(0, 4);
      if (year && y !== year) continue;
      index.push([row.id, row.date, row.from.rfc, row.to.rfc, row.kind, row.total]);
      const file = byId.get('xml:' + row.id);
      if (file?.blob) entries.push({ name: row.from.rfc + '/' + y + '/' + row.id + '.xml', data: new Uint8Array(await file.blob.arrayBuffer()) });
    }
    for (const doc of documents) {
      const y = String(doc.date || '').slice(0, 4);
      if (year && y !== year) continue;
      const file = byId.get(doc.id);
      if (file?.blob) entries.push({ name: doc.rfc + '/' + y + '/documentos/' + (doc.name || doc.id), data: new Uint8Array(await file.blob.arrayBuffer()) });
    }
    const escape = value => '"' + String(value ?? '').replaceAll('"', '""') + '"';
    entries.unshift({ name: 'indice.csv', data: new TextEncoder().encode('﻿' + index.map(row => row.map(escape).join(',')).join('\r\n')) });
    download(new Blob([zipStore(entries)], { type: 'application/zip' }), 'PacoSAT-exportacion' + (year ? '-' + year : '-completa') + '.zip');
    toast('Exportación lista: ' + (entries.length - 1) + ' archivos.', 'ok');
  } catch (error) { toast(error.message, 'error'); }
}

/* ===== Tanda 7A (2.0) · Cierre guiado, ZIP del mes, panel de
   valor, pólizas y candado — todo se pide al servidor, que es
   quien comprueba contra los datos; aquí no se calcula nada. */
function cierre200gPanel() {
  const panelEl = panel('Cierre guiado del mes', 'El asistente comprueba cada paso contra los datos del expediente (cobertura, metadatos, vigilancia, Dinero y Bancos): nada se marca a mano. Con todo en verde, el mes se cierra y sus informes quedan generados.');
  const rfc = () => scope || people[0]?.id || '';
  const out = n('div');
  const cargar = async () => {
    out.replaceChildren(n('p', 'Comprobando el mes contra el expediente…', 'muted'));
    try {
      const est = await satApi('cierre200g?rfc=' + encodeURIComponent(rfc()) + '&month=' + encodeURIComponent(OUT.month));
      out.replaceChildren();
      for (const paso of est.pasos) {
        const row = n('div', undefined, 'cp-row');
        row.append(statusPill(paso.ok ? 'ok' : 'bad', paso.ok ? 'En verde' : 'Falta'),
          n('span', paso.label + ' — ' + paso.detalle));
        out.append(row);
      }
      if (est.cerrado) out.append(n('p', 'Mes cerrado el ' + localDate(est.cerradoAt) + (est.cerradoPor ? ' por ' + est.cerradoPor : '') + '.', 'ok-text'));
      const acciones = n('div', undefined, 'sat-actions');
      const cerrar = n('button', est.cerrado ? 'Mes cerrado' : 'Cerrar el mes', 'primary');
      cerrar.disabled = !est.completo || est.cerrado;
      cerrar.onclick = async () => {
        try { const r = await satApi('cierre200g/cerrar', { rfc: rfc(), month: OUT.month });
          toast('Mes cerrado: sus informes quedaron generados al cerrar.', 'ok'); cargar(); }
        catch (error) { toast(error.message, 'error'); }
      };
      const zip = n('button', 'El mes en un ZIP', 'soft');
      zip.onclick = () => salidaDescargar('salidas200g/zip-mes', { rfc: rfc(), month: OUT.month }, zip);
      const desp = n('button', 'Enviar al despacho', 'soft');
      desp.onclick = async () => {
        desp.disabled = true;
        try { const r = await satApi('salidas200g/enviar-despacho', { rfc: rfc(), month: OUT.month });
          if (r.enviado) toast('Enviado al despacho: ' + r.recipients, 'ok');
          else { download(new Blob([decode64(r.preparado.content)], { type: 'application/zip' }), r.preparado.name);
            toast(r.nota, 'ok'); }
        } catch (error) { toast(error.message, 'error'); }
        finally { desp.disabled = false; }
      };
      const pol = n('button', 'Para el contador (pólizas)', 'soft');
      pol.onclick = () => salidaDescargar('salidas200g/polizas', { rfc: rfc(), month: OUT.month }, pol);
      acciones.append(cerrar, zip, desp, pol);
      out.append(acciones);
      const inf = await satApi('informes200g?rfc=' + encodeURIComponent(rfc()) + '&month=' + encodeURIComponent(OUT.month)).catch(() => null);
      if (inf?.informe) {
        const fila = n('div', undefined, 'cp-row');
        fila.append(n('span', 'Informes del mes: ' + inf.informe.texto + (inf.informe.desactualizado ? ' · DESACTUALIZADO (los datos cambiaron tras el cierre)' : '')));
        const servir = n('button', 'Descargar el cierre guardado', 'soft');
        servir.onclick = () => salidaDescargar('informes200g/servir', { rfc: rfc(), month: OUT.month, cual: 'cierre' }, servir);
        const regen = n('button', 'Regenerar informes', 'soft');
        regen.onclick = async () => { try { await satApi('informes200g/regenerar', { rfc: rfc(), month: OUT.month }); toast('Informes regenerados con los datos de ahora.', 'ok'); cargar(); } catch (e) { toast(e.message, 'error'); } };
        fila.append(servir, regen);
        out.append(fila);
      }
      /* Candado del ejercicio (20#12) */
      const year = OUT.month.slice(0, 4);
      const filaCandado = n('div', undefined, 'cp-row');
      filaCandado.append(n('span', 'Ejercicio ' + year + ': ' + (est.ejercicioCerrado ? 'CERRADO — sus escrituras están bloqueadas en el servidor.' : 'abierto.')));
      const candadoBtn = n('button', est.ejercicioCerrado ? 'Desbloquear ejercicio ' + year : 'Cerrar ejercicio ' + year, 'soft');
      candadoBtn.onclick = async () => {
        if (est.ejercicioCerrado) {
          if (!confirm('¿Desbloquear el ejercicio ' + year + ' de ' + rfc() + '? Sus datos se podrán tocar otra vez y el gesto queda en el Registro.')) return;
          try { await satApi('ejercicios200g/desbloquear', { rfc: rfc(), year, confirmar: true }); toast('Ejercicio desbloqueado (registrado).', 'ok'); cargar(); }
          catch (e) { toast(e.message, 'error'); }
        } else {
          if (!confirm('¿Cerrar el ejercicio ' + year + ' de ' + rfc() + '? El servidor bloqueará notas, archivar, marcas de pago, importaciones y estados de ese año.')) return;
          try { await satApi('ejercicios200g/cerrar', { rfc: rfc(), year }); toast('Ejercicio cerrado: escrituras bloqueadas.', 'ok'); cargar(); }
          catch (e) { toast(e.message, 'error'); }
        }
      };
      filaCandado.append(candadoBtn);
      out.append(filaCandado);
    } catch (error) { out.replaceChildren(n('p', 'No se pudo comprobar: ' + error.message, 'error-text')); }
  };
  const ver = n('button', 'Comprobar el cierre del mes', 'soft');
  ver.onclick = cargar;
  panelEl.append(ver, out);
  return panelEl;
}
function valor200gPanel() {
  const panelEl = panel('Lo que PacoSAT ha cazado (panel de valor)', 'Contado SOLO de sus registros: cada cifra enseña su lista detrás. Nada estimado ni proyectado: lo que no sale de un registro, no va.');
  const perSel = select([['todo', 'Todo el histórico'], ['anio', 'Este año']], 'todo', 'Periodo');
  const out = n('div');
  const ver = n('button', 'Ver el panel de valor', 'soft');
  ver.onclick = async () => {
    out.replaceChildren(n('p', 'Contando desde los registros…', 'muted'));
    try {
      const v = await satApi('valor200g?periodo=' + encodeURIComponent(perSel.value));
      out.replaceChildren();
      const filas = [
        ['Cancelaciones detectadas a tiempo', v.cancelaciones.numero + ' · $' + v.cancelaciones.suma,
          v.cancelaciones.detalle.map(d => d.fecha + ' · ' + d.uuid + ' · $' + d.total).join('\n')],
        ['Emisores en listas 69-B (EFOS) marcados', v.efos.numero + ' · $' + v.efos.suma,
          v.efos.detalle.map(d => d.rfc + ' · ' + d.lista + ' · ' + d.comprobantes + ' comprobante(s) · $' + d.total).join('\n')],
        ['Plazos del Buzón atendidos (abiertas o archivadas)', String(v.buzon.cumplidos),
          v.buzon.detalle.map(d => d.fecha + ' · ' + d.rfc + ' · ' + d.asunto).join('\n')],
        ['Descargas terminadas', v.descargas.solicitudesTerminadas + ' solicitudes · ' + v.descargas.cfdiBajados + ' CFDI bajados', ''],
        ['Último ensayo de restauración', v.respaldosProbados ? (v.respaldosProbados.ok ? 'Pasó' : 'NO pasó') + ' · ' + localDate(v.respaldosProbados.at) : 'Sin ensayos registrados', v.respaldosProbados?.detalle || '']
      ];
      for (const [label, cifra, detalle] of filas) {
        const row = n('div', undefined, 'cp-row');
        row.append(n('span', label + ': '), n('strong', cifra));
        if (detalle) { const pre = n('pre', detalle); pre.style.whiteSpace = 'pre-wrap'; row.append(pre); }
        out.append(row);
      }
    } catch (error) { out.replaceChildren(n('p', 'No se pudo contar: ' + error.message, 'error-text')); }
  };
  panelEl.append(fieldWrap('Periodo', perSel), ver, out);
  return panelEl;
}

/* ===== Tanda 7A · Webhooks salientes, calendario fiscal vivo y
   restauración guiada (viven en esta parte diferida; Ajustes los
   monta con el patrón de montaje perezoso de siempre). */
function webhooks200gPanel() {
  const panelEl = panel('Webhooks salientes', 'Avisos automáticos a otro sistema cuando pasa algo en PacoSAT: CFDI nuevo, cancelación detectada, opinión descargada o novedad en el Buzón. Cada entrega va firmada (HMAC-SHA256) y queda registrada aquí; un webhook fallido nunca bloquea el suceso.');
  const out = n('div');
  const urlIn = input('url', { placeholder: 'https://tu-sistema.example/webhook', 'aria-label': 'Dirección del webhook' });
  const eventosSel = select([['cfdi-nuevo', 'CFDI nuevo'], ['cancelacion-detectada', 'Cancelación detectada'],
    ['opinion-descargada', 'Opinión descargada'], ['buzon-nuevo', 'Novedad en el Buzón']], 'cfdi-nuevo', 'Evento');
  const crear = n('button', 'Crear webhook', 'soft');
  crear.onclick = async () => {
    try { const r = await satApi('webhooks200g', { url: urlIn.value.trim(), eventos: [eventosSel.value] });
      toast('Webhook creado. Su secreto (se enseña una sola vez): ' + r.secret, 'ok'); pintar(); }
    catch (e) { toast(e.message, 'error'); }
  };
  const pintar = async () => {
    out.replaceChildren(n('p', 'Leyendo webhooks y entregas…', 'muted'));
    try {
      const d = await satApi('webhooks200g');
      out.replaceChildren();
      if (!d.webhooks.length) out.append(n('p', 'Sin webhooks todavía.', 'muted'));
      for (const h of d.webhooks) {
        const row = n('div', undefined, 'cp-row');
        row.append(statusPill(h.activo ? 'ok' : 'dim', h.activo ? 'Activo' : 'Apagado'),
          n('span', h.url + ' · eventos: ' + h.eventos.join(', ')));
        const probar = n('button', 'Enviar prueba', 'soft');
        probar.onclick = async () => { try { await satApi('webhooks200g/probar', { evento: h.eventos[0] || 'cfdi-nuevo' }); toast('Prueba enviada: mira el registro de entregas.', 'ok'); pintar(); } catch (e) { toast(e.message, 'error'); } };
        const toggle = n('button', h.activo ? 'Apagar' : 'Encender', 'soft');
        toggle.onclick = async () => { try { await satApi('webhooks200g/estado', { id: h.id, activo: !h.activo }); pintar(); } catch (e) { toast(e.message, 'error'); } };
        row.append(probar, toggle);
        out.append(row);
      }
      if (d.entregas.length) {
        out.append(n('strong', 'Últimas entregas'));
        for (const e of d.entregas.slice(0, 10)) {
          const row = n('div', undefined, 'cp-row');
          row.append(statusPill(e.ok ? 'ok' : 'bad', e.ok ? 'Entregada' : 'Falló'),
            n('span', e.evento + ' · ' + localDate(e.at) + ' · HTTP ' + (e.estado || '—') + ' · ' + e.intentos + ' intento(s)' + (e.error ? ' · ' + e.error : '')));
          out.append(row);
        }
      }
    } catch (e) { out.replaceChildren(n('p', e.message, 'error-text')); }
  };
  panelEl.append(fieldWrap('Dirección (URL)', urlIn), fieldWrap('Evento', eventosSel), crear, out);
  pintar();
  return panelEl;
}
function ics200gPanel() {
  const panelEl = panel('Calendario fiscal vivo (ICS)', 'Una dirección por RFC para suscribir tu calendario a los vencimientos que PacoSAT ya conoce (declaraciones, Buzón, e.firma). Se genera de los datos vivos en cada petición: nunca se queda viejo. Quien tenga la dirección puede ver esos vencimientos; regenerarla revoca la anterior.');
  const rfcSel = select(people.map(p => [p.id, (p.name || p.id) + ' · ' + p.id]), scope || people[0]?.id || '', 'Contribuyente');
  const out = n('div');
  const ver = n('button', 'Enseñar la dirección', 'soft');
  ver.onclick = async () => {
    out.replaceChildren(n('p', 'Pidiendo la dirección…', 'muted'));
    try {
      const d = await satApi('ics200g?rfc=' + encodeURIComponent(rfcSel.value));
      out.replaceChildren();
      const urlTxt = n('p', d.url);
      const copiar = n('button', 'Copiar la dirección', 'soft');
      copiar.onclick = () => { try { navigator.clipboard.writeText(d.url); toast('Dirección copiada.', 'ok'); } catch { toast('Copia la dirección a mano.', 'error'); } };
      const regen = n('button', 'Regenerar (revoca la anterior)', 'soft');
      regen.onclick = async () => {
        if (!confirm('¿Regenerar la dirección del calendario de ' + rfcSel.value + '? La anterior deja de funcionar al momento.')) return;
        try { const r = await satApi('ics200g/regenerar', { rfc: rfcSel.value }); toast('Dirección nueva generada: la anterior quedó revocada.', 'ok'); out.replaceChildren(n('p', r.url)); }
        catch (e) { toast(e.message, 'error'); }
      };
      const row = n('div', undefined, 'sat-actions'); row.append(copiar, regen);
      out.append(urlTxt, row);
    } catch (e) { out.replaceChildren(n('p', e.message, 'error-text')); }
  };
  panelEl.append(fieldWrap('Contribuyente', rfcSel), ver, out);
  return panelEl;
}
function restaurar200gPanel() {
  const panelEl = panel('Restaurar un respaldo (guiado)', 'Eliges el respaldo y PacoSAT hace el resto: ANTES de tocar nada crea un respaldo de seguridad del estado actual (obligatorio, sin opción de saltarlo), restaura y verifica con los conteos cruzados. Si la verificación no cuadra, te ofrece volver al respaldo de seguridad.');
  const out = n('div');
  const cargar = async () => {
    out.replaceChildren(n('p', 'Listando los respaldos guardados…', 'muted'));
    try {
      const d = await satApi('respaldos200g');
      out.replaceChildren();
      if (!d.configurado) { out.append(n('p', 'El respaldo programado no está configurado en esta instalación: sin carpeta de respaldos no hay nada que restaurar desde aquí.', 'muted')); return; }
      if (!d.respaldos.length) { out.append(n('p', 'No hay respaldos guardados todavía.', 'muted')); return; }
      for (const r of d.respaldos) {
        const row = n('div', undefined, 'cp-row');
        row.append(n('span', 'Respaldo del ' + r.stamp + ' · ' + r.destino + ' · ' + Math.max(1, Math.round(r.bytes / 1024)) + ' KB' +
          (r.seguridad ? ' · de seguridad (de una restauración anterior)' : '')));
        if (!r.seguridad) {
          const btn = n('button', 'Restaurar este', 'soft');
          btn.onclick = async () => {
            if (!confirm('Se va a reemplazar el expediente actual por el respaldo del ' + r.stamp + '. Antes, PacoSAT guardará un respaldo de seguridad del estado actual. ¿Seguir?')) return;
            btn.disabled = true; btn.textContent = 'Restaurando (con su respaldo de seguridad previo)…';
            try { const res = await satApi('respaldos200g/restaurar', { stamp: r.stamp, confirmar: true });
              toast(res.aviso, res.ok ? 'ok' : 'error'); cargar(); render(); }
            catch (e) { toast(e.message, 'error'); }
            finally { btn.disabled = false; btn.textContent = 'Restaurar este'; }
          };
          row.append(btn);
        }
        out.append(row);
      }
      const volver = n('button', 'Volver al respaldo de seguridad', 'soft');
      volver.onclick = async () => {
        if (!confirm('¿Volver al estado que había justo antes de la última restauración guiada?')) return;
        try { const res = await satApi('respaldos200g/volver-seguridad', {}); toast(res.ok ? 'De vuelta en el respaldo de seguridad, verificado.' : 'La vuelta se aplicó pero la verificación marca diferencias.', res.ok ? 'ok' : 'error'); render(); }
        catch (e) { toast(e.message, 'error'); }
      };
      out.append(volver);
    } catch (e) { out.replaceChildren(n('p', e.message, 'error-text')); }
  };
  const ver = n('button', 'Ver los respaldos', 'soft');
  ver.onclick = cargar;
  panelEl.append(ver, out);
  return panelEl;
}

/* ===== Tanda 7A · Compartir en un toque (A7), subir un papel
   en 2 toques (F7) y arrastrar y soltar (F13). */
async function compartir200g(kind, id) {
  try {
    const d = await satApi('compartir200g', { kind, id });
    composeMailDialog({ to: d.preparado.to, subject: d.preparado.subject,
      text: d.preparado.text, attachments: d.preparado.attachments });
    toast('Correo preparado con su ficha y adjunto: el envío es gesto tuyo.', 'ok');
  } catch (e) { toast(e.message, 'error'); }
}
function papelTipoSugerido200g(nombre) {
  const bajo = String(nombre || '').toLowerCase();
  if (/constancia|csf|situacion fiscal/.test(bajo)) return 'Constancia / CIF';
  if (/opinion|32-?d|cumplimiento/.test(bajo)) return 'Opinión de cumplimiento';
  if (/acuse|declaracion/.test(bajo)) return 'Acuse';
  if (/estado de cuenta/.test(bajo)) return 'Estado de cuenta';
  return 'Documento';
}
async function papelClasificar200g(file) {
  const buf = new Uint8Array(await file.arrayBuffer());
  let bin = '';
  for (let i = 0; i < buf.length; i += 32768) bin += String.fromCharCode(...buf.subarray(i, i + 32768));
  const content = btoa(bin);
  const rfcSel = select(people.map(p => [p.id, (p.name || p.id) + ' · ' + p.id]),
    scope && people.some(p => p.id === scope) ? scope : (people[0]?.id || ''), 'Contribuyente');
  const tipos = [...new Set(['Documento', 'Constancia / CIF', 'Opinión de cumplimiento', 'Acuse', 'Estado de cuenta', ...(typeof DOCUMENTS !== 'undefined' ? DOCUMENTS : [])])];
  const tipoSel = select(tipos.map(t => [t, t]), papelTipoSugerido200g(file.name), 'Tipo de documento');
  dialog('Archivar este papel', [
    n('p', '«' + file.name + '» — PacoSAT sugiere el contribuyente del ámbito y el tipo por su nombre; corrígelos aquí si no son, y al guardar queda archivado en Documentos.'),
    field('Contribuyente', rfcSel), field('Tipo', tipoSel)
  ], async () => {
    const r = await satApi('documentos200g/subir-papel', { name: file.name, content, rfc: rfcSel.value, kind: tipoSel.value });
    toast('Papel archivado como ' + r.kind + ' de ' + r.rfc + '.', 'ok');
    if (typeof refresh === 'function') await refresh();
    if (page === 'documents') render();
  }, 'Archivar el papel');
}
function subirPapel200g() {
  const inp = document.createElement('input');
  inp.type = 'file'; inp.accept = '.pdf,image/*';
  inp.onchange = () => { if (inp.files?.[0]) papelClasificar200g(inp.files[0]).catch(e => toast(e.message, 'error')); };
  inp.click();
}
/* Arrastrar y soltar sobre la app (F13): los XML/ZIP entran por
   el importador de siempre; un PDF suelto abre la tarjeta de
   clasificación del papel. Se registra una sola vez aunque la
   parte diferida se precargue en reposo. */
if (typeof window !== 'undefined' && !window.__papel200gDnD) {
  window.__papel200gDnD = true;
  window.addEventListener('dragover', e => { e.preventDefault(); });
  window.addEventListener('drop', e => {
    e.preventDefault();
    const files = [...(e.dataTransfer?.files || [])];
    if (!files.length) return;
    const xmls = files.filter(f => /\.(xml|zip)$/i.test(f.name));
    const pdfs = files.filter(f => /\.pdf$/i.test(f.name) || /^image\//.test(f.type));
    if (xmls.length && typeof importBatch === 'function')
      importBatch(xmls).catch(error => announce(error.message, true));
    for (const f of pdfs) papelClasificar200g(f).catch(error => toast(error.message, 'error'));
  });
}
