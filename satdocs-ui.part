/* ===== Constancias y opinión del SAT (1.6.14) =====
   Sección del Centro SAT: por RFC, semáforo de antigüedad de la
   constancia de situación fiscal y de la opinión de cumplimiento,
   activación de la descarga mensual automática con día, hora y
   destinatarios del correo, descarga inmediata y subida manual del
   PDF (vale igual para el semáforo). Solo SAT: el IMSS no entra. */
function satDocPill(doc, label) {
  if (!doc) return statusPill('dim', label + ': sin archivar');
  const level = doc.level === 'ok' ? 'ok' : doc.level === 'warn' ? 'warn' : 'bad';
  return statusPill(level, label + ': ' + doc.ageDays + ' días');
}
function satDocsSection() {
  const section = panel('Constancias y opinión del SAT',
    'La constancia de situación fiscal y la opinión de cumplimiento caducan a la vista de tus clientes: aquí se vigila su edad (verde menos de 60 días, ámbar hasta 90, rojo después) y, si activas la descarga automática, PacoSAT las renueva cada mes y las envía por correo.');
  const body = n('div');
  section.append(body);
  const fill = async data => {
    const view = data || await satApi('satdocs');
    body.replaceChildren();
    if (!view.profiles.length) {
      body.append(n('p', 'Configura primero un RFC arriba: sus constancias se vigilarán aquí.', 'empty'));
      return;
    }
    for (const profile of view.profiles) {
      const card = n('article', undefined, 'sat-card');
      const head = n('div', undefined, 'sat-card-head');
      head.append(n('strong', profile.rfc), satDocPill(profile.constancia, 'Constancia'), satDocPill(profile.opinion, 'Opinión'));
      card.append(head);
      const meta = n('div', undefined, 'sat-meta');
      /* Un clic en «Ver» y el documento se abre dentro de la app
         (1.10.2): nada de ir a buscarlo a una carpeta. */
      const verButton = (doc, label, kind) => {
        if (!doc?.fileId) return;
        const ver = n('button', 'Ver', 'soft small');
        ver.title = 'Ver la ' + label.toLowerCase() + ' dentro de PacoSAT';
        ver.onclick = () => viewDocOnline({ id: doc.fileId, rfc: profile.rfc, kind,
          name: label + ' · ' + profile.rfc + '.pdf' });
        meta.append(ver);
      };
      if (profile.constancia) {
        meta.append(n('span', 'Constancia emitida: ' + localDate(profile.constancia.issuedAt) + (profile.constancia.source === 'manual' ? ' (subida a mano)' : '')));
        verButton(profile.constancia, 'Constancia', 'Constancia / CIF');
      }
      if (profile.opinion) {
        meta.append(n('span', 'Opinión emitida: ' + localDate(profile.opinion.issuedAt) + (profile.opinion.source === 'manual' ? ' (subida a mano)' : '')));
        verButton(profile.opinion, 'Opinión', 'Opinión de cumplimiento');
      }
      if (profile.lastAttempt) meta.append(n('span', 'Último intento de descarga: ' + localDateTime(profile.lastAttempt)));
      card.append(meta);
      if (profile.lastError) card.append(n('p', 'Último intento: ' + profile.lastError, 'error-text'));
      /* Configuración del envío automático, en lenguaje llano. */
      const form = n('div', undefined, 'satdoc-form');
      const enabled = input('checkbox', { checked: Boolean(profile.config.enabled) });
      const dayInput = input('number', { value: profile.config.day, min: 1, max: 28, 'aria-label': 'Día del mes' });
      const hourInput = input('number', { value: profile.config.hour, min: 0, max: 23, 'aria-label': 'Hora' });
      const recipients = input('text', { value: profile.config.recipients, placeholder: 'Correos que reciben los documentos (separados por comas); vacío = tu correo de avisos' });
      const toggleLabel = n('label', undefined, 'switch-line');
      toggleLabel.append(enabled, n('span', 'Descarga automática mensual'));
      const when = n('label'); when.append(n('span', 'Día '), dayInput, n('span', ' a las '), hourInput, n('span', ':00'));
      const save = n('button', 'Guardar', 'soft');
      save.onclick = async () => {
        try {
          const data = await satApi('satdocs/config', { rfc: profile.rfc, enabled: enabled.checked,
            day: Number(dayInput.value), hour: Number(hourInput.value), recipients: recipients.value });
          toast('Configuración guardada para ' + profile.rfc + '.', 'ok');
          fill(data);
        } catch (error) { toast(error.message, 'error'); }
      };
      form.append(toggleLabel, when, recipients, save);
      card.append(form);
      const actions = n('div', undefined, 'sat-actions');
      const run = n('button', 'Descargar ahora', 'soft');
      run.onclick = async () => {
        run.disabled = true; run.textContent = 'Descargando del portal…';
        /* Progreso EN VIVO (1.10.1): la corrida sigue en el servidor
           aunque esta petición tarde lo que tarde; mientras tanto se
           consulta el estado cada pocos segundos y se pintan los
           pasos tal como ocurren — si se conectó, si está firmando,
           qué está pidiendo — sin refrescar la página. Al terminar,
           el sondeo se detiene y la tarjeta se repinta entera. */
        const poller = setInterval(async () => {
          try {
            const fresh = await satApi('satdocs');
            for (const item of fresh.profiles) {
              const box = body.querySelector('[data-progress-for="' + item.rfc + '"]');
              if (box) renderSatDocProgress(box, item);
              if (!item.progress?.running) {
                const runs = body.querySelector('[data-runs-for="' + item.rfc + '"]');
                if (runs) renderSatDocRuns(runs, item);
              }
            }
          } catch { /* un fallo de sondeo no tumba la descarga */ }
        }, 2500);
        try {
          const data = await satApi('satdocs/run', { rfc: profile.rfc });
          const failed = Object.values(data.results).filter(result => !result.ok).length;
          toast(failed ? 'El portal no entregó ' + failed + ' documento(s): quedó registrado en el diario y avisado.' :
            'Documentos descargados, archivados y enviados.', failed ? 'error' : 'ok');
          fill(data);
        } catch (error) { toast(error.message, 'error'); fill(); }
        finally { clearInterval(poller); }
      };
      const upload = n('button', 'Subir PDF a mano', 'soft');
      upload.onclick = () => satDocUploadDialog(profile.rfc, fill);
      actions.append(run, upload);
      card.append(actions);
      /* Progreso persistido de la última corrida (o de la que sigue
         en curso en el servidor) y el diario de corridas: al volver
         a esta pantalla —aunque se haya refrescado— se ve el estado
         real, no una pantalla muda. */
      const progressBox = n('div', undefined, 'sat-progress');
      progressBox.dataset.progressFor = profile.rfc;
      card.append(progressBox);
      renderSatDocProgress(progressBox, profile);
      const runsBox = n('div', undefined, 'sat-runs');
      runsBox.dataset.runsFor = profile.rfc;
      card.append(runsBox);
      renderSatDocRuns(runsBox, profile);
      body.append(card);
    }
  };
  fill();
  return section;
}
/* Pasos de una corrida, en lenguaje llano y con su hora: los
   mismos que el servidor persiste mientras descarga. */
function satDocStepList(steps, withUrl) {
  const list = n('ol', undefined, 'sat-steps');
  for (const step of steps || []) {
    const item = n('li');
    item.append(
      n('span', new Date(step.at).toLocaleTimeString('es-MX',
        { hour: '2-digit', minute: '2-digit', second: '2-digit' }), 'sat-step-time'),
      n('span', step.text + (withUrl && step.url ? ' · ' + step.url : '')));
    list.append(item);
  }
  return list;
}
function renderSatDocProgress(box, profile) {
  box.replaceChildren();
  const progress = profile.progress;
  if (!progress || !Array.isArray(progress.steps) || !progress.steps.length) return;
  const head = n('p', undefined, 'sat-progress-head');
  head.append(n('strong', progress.running ? 'Descargando ahora · ' : 'Última descarga · '),
    n('span', (progress.kind === 'opinion' ? 'Opinión de cumplimiento' : 'Constancia') + ' — ' + progress.step));
  box.append(head, satDocStepList(progress.steps, false));
  if (progress.running) {
    box.append(n('p', 'La descarga sigue en el servidor: puedes refrescar o salir y volver; al regresar verás el estado real.', 'sat-progress-note'));
  }
}
/* El diario: cada corrida con su resultado y sus pasos; si falló
   dentro del navegador, la captura y el HTML de la página en el
   punto del fallo se pueden ver y bajar desde aquí. */
function renderSatDocRuns(box, profile) {
  box.replaceChildren();
  const runs = Array.isArray(profile.runs) ? profile.runs : [];
  if (!runs.length) return;
  box.append(n('h4', 'Diario de descargas', 'sat-runs-title'));
  for (const run of runs.slice(0, 5)) {
    const details = n('details', undefined, 'sat-run');
    const summary = n('summary', localDateTime(run.started) + ' · ' +
      (run.kind === 'opinion' ? 'Opinión' : 'Constancia') +
      (run.ok ? ' · Guardada en Expedientes' : ' · Falló'));
    details.append(summary);
    if (!run.ok && run.error) details.append(n('p', run.error, 'error-text'));
    details.append(satDocStepList(run.steps, true));
    if (run.hasShot || run.hasHtml) {
      const files = n('div', undefined, 'sat-run-files');
      if (run.hasShot) {
        const shot = n('button', 'Bajar la captura de la página', 'soft');
        shot.onclick = async () => {
          try { download(await satApiBlob('satdocs/artifact?run=' + run.id + '&part=shot'), 'captura-del-fallo.png'); }
          catch (error) { toast(error.message, 'error'); }
        };
        files.append(shot);
      }
      if (run.hasHtml) {
        const html = n('button', 'Bajar el HTML de la página', 'soft');
        html.onclick = async () => {
          try { download(await satApiBlob('satdocs/artifact?run=' + run.id + '&part=html'), 'pagina-del-fallo.html'); }
          catch (error) { toast(error.message, 'error'); }
        };
        files.append(html);
      }
      details.append(files);
    }
    box.append(details);
  }
}
function satDocUploadDialog(rfc, fill) {
  const kind = n('select');
  for (const [value, label] of [['constancia', 'Constancia de situación fiscal'], ['opinion', 'Opinión de cumplimiento']]) {
    const option = n('option', label); option.value = value; kind.append(option);
  }
  const date = input('date', { required: true, value: new Date().toISOString().slice(0, 10) });
  const picker = input('file', { accept: '.pdf,application/pdf', required: true });
  dialog('Subir documento del SAT · ' + rfc,
    [field('Documento', kind), field('Fecha de emisión', date), field('Archivo PDF', picker)],
    async () => {
      const file = picker.files[0];
      check(file, 'Elige el archivo PDF.');
      const content = bytesToBase64(new Uint8Array(await file.arrayBuffer()));
      const data = await satApi('satdocs/upload', { rfc, kind: kind.value, date: date.value, content, name: file.name });
      await refresh();
      toast('Documento archivado en Expedientes y semáforo actualizado.', 'ok');
      fill(data);
    }, 'Archivar documento');
}
function localDate(value) {
  return new Date(value).toLocaleDateString('es-MX', { day: 'numeric', month: 'short', year: 'numeric' });
}
