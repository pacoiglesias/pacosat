/* ===== Constancias y opinión del SAT (1.6.14) =====
   Sección del Centro SAT: por RFC, semáforo de antigüedad de la
   constancia de situación fiscal y de la opinión de cumplimiento,
   activación de la descarga mensual automática con día, hora y
   destinatarios del correo, descarga inmediata y subida manual del
   PDF (vale igual para el semáforo). Solo SAT: el IMSS no entra. */
function satDocPill(doc, label) {
  if (!doc) return statusPill('dim', label + ': sin archivar');
  const level = doc.level === 'ok' ? 'ok' : doc.level === 'warn' ? 'warn' : 'bad';
  return statusPill(level, label + ': ' + doc.ageDays + ' días');
}
async function satQuickRunDoc(kind, rfc, button, line) {
  const nombre = kind === 'constancia' ? 'Constancia' : 'Opinión';
  button.disabled = true;
  line.textContent = 'Descargando del portal…';
  /* Progreso en vivo en la propia línea, como en las tarjetas de
     Documentos: se sondea el estado de la corrida del servidor. */
  const poller = setInterval(async () => {
    try {
      const fresh = await satApi('satdocs');
      const profile = fresh.profiles.find(item => item.rfc === rfc);
      if (profile?.progress?.running && profile.progress.step) {
        line.dataset.estado = 'encurso';
        line.textContent = profile.progress.step;
      }
    } catch { /* un fallo de sondeo no tumba la descarga */ }
  }, 2500);
  try {
    const data = await satApi('satdocs/run', { rfc, kind });
    satQuickDocs = { profiles: data.profiles };
    const profile = (data.profiles || []).find(item => item.rfc === rfc);
    if (profile?.[kind]) line.textContent = nombre + ' · descargada ' + satQuickCuando(profile[kind]);
    toast(data.results?.[kind]?.ok ? nombre + ' de ' + rfc + ' descargada y archivada en Documentos.' :
      'El portal no entregó el documento: el intento quedó registrado en Documentos.',
      data.results?.[kind]?.ok ? 'ok' : 'error');
  } catch (error) { toast(error.message, 'error'); }
  finally { clearInterval(poller); delete line.dataset.estado; button.disabled = false; }
}
/* Las cuatro tarjetas de Documentos (1.18.0): Constancia ·
   Opinión · CFDI · Declaraciones clavadas encima de los
   Expedientes, con la misma pieza de Hoy — nada de cazar cada
   documento por su pantalla. */
function docsTopCards() {
  const wrap = panel('Documentos del SAT',
    'Del RFC elegido arriba: cada documento con su fecha, su semáforo y su gesto — Ver y Renovar sin entrar pantalla por pantalla.');
  const gridBox = n('div', undefined, 'cmd-grid');
  wrap.append(gridBox);
  const cSlot = n('div'), oSlot = n('div');
  /* Declaraciones es destino propio desde la 1.28.0 (P2): la
     tarjeta lleva a su pantalla, no a una sección de esta. */
  const irAlMapa = () => navigate('declaraciones');
  /* A0 (1.23.0): la tarjeta de Declaraciones lleva «Descargar»
     junto a «Ver el mapa», como las demás: lanza la recuperación
     mensual del ejercicio en curso para el RFC de la tarjeta con
     el lanzador de siempre (declRun, global en
     declaraciones-ui.part), sin obligar a entrar al mapa. */
  const declActs = n('div');
  const declDescargar = n('button', 'Descargar declaraciones', 'soft');
  declDescargar.type = 'button';
  declDescargar.onclick = event => {
    event.stopPropagation();
    if (!scope) { toast('Elige arriba el contribuyente de estas declaraciones.', 'error'); return; }
    declEjercicio = new Date().getFullYear();
    declRun('mensuales', () => render(), declDescargar);
  };
  declActs.append(action('Ver el mapa', irAlMapa, 'soft', 'eye'), declDescargar);
  gridBox.append(cSlot, oSlot,
    cmdCard('cfdi', 'ok', 'CFDI del SAT', 'Descarga masiva y vigilancia',
      'Baja los comprobantes del mes o de un periodo',
      action('Descargar del SAT', () => showSatDownload(), 'soft', 'down'), () => showSatDownload()),
    cmdCard('decl', 'ok', 'Declaraciones', 'El mapa de tu año fiscal',
      'Qué consta presentado, qué toca y qué venció',
      declActs, irAlMapa));
  (async () => {
    await Promise.resolve();
    if (!cSlot.isConnected) return;
    const data = await satApi('satdocs').catch(() => null);
    const profiles = data?.profiles || [];
    const objetivo = profiles.find(row => row.rfc === scope) || (profiles.length === 1 ? profiles[0] : null);
    if (cSlot.isConnected) cSlot.replaceChildren(docCmdCard('constancia', objetivo));
    if (oSlot.isConnected) oSlot.replaceChildren(docCmdCard('opinion', objetivo));
  })();
  return wrap;
}
/* Versiones de los documentos del SAT (F5, 1.31.0): el
   expediente (documents, ya ordenado por fecha descendente en
   refresh()) guarda cada versión archivada; agrupadas por
   (rfc, kind), la primera de cada grupo es la vigente y las
   anteriores quedan con su fecha, sin pastilla. La tarjeta de
   cada perfil enseña además su documento del servidor — que
   sale de latestSatDoc, el más reciente por (rfc, kind) —
   marcado «Vigente» en su propia línea. */
function satDocVersiones() {
  const grupos = new Map();
  for (const doc of (typeof documents !== 'undefined' ? documents : [])) {
    if (doc.archived) continue;
    const kind = doc.kind === 'Constancia / CIF' ? 'constancia' :
      doc.kind === 'Opinión de cumplimiento' ? 'opinion' : null;
    if (!kind || !doc.rfc) continue;
    const clave = doc.rfc + '|' + kind;
    if (!grupos.has(clave)) grupos.set(clave, []);
    grupos.get(clave).push(doc);
  }
  return grupos;
}
/* Subir un papel en 2 toques (F7, 1.31.0): el tipo se sugiere
   del nombre del archivo — sin acentos y en minúsculas, para
   que «Opinión» y «opinion» sugieran lo mismo — y Paco lo
   confirma en el diálogo antes de que nada se suba. */
function satDocPapelSugerido(nombre) {
  const limpio = String(nombre || '').toLocaleLowerCase('es-MX')
    .normalize('NFD').replace(/[\u0300-\u036f]/g, '');
  if (limpio.includes('constancia')) return 'constancia';
  if (limpio.includes('opinion')) return 'opinion';
  return 'documento';
}
function satDocPapelDialog(rfc, fill, file) {
  const kind = select([['constancia', 'Constancia'], ['opinion', 'Opinión'], ['documento', 'Documento']],
    satDocPapelSugerido(file.name), 'Tipo de documento');
  const date = input('date', { required: true, value: new Date().toISOString().slice(0, 10) });
  /* El mismo diálogo simple de siempre (satDocUploadDialog):
     tipo confirmado por Paco y fecha; lo que cambia es que el
     archivo YA viene elegido del selector grande y puede ser
     PDF o imagen, pensado para el móvil. La subida va por el
     endpoint existente, satdocs/upload. */
  dialog('Subir un papel · ' + rfc,
    [n('p', 'Archivo: ' + file.name + '. El tipo viene sugerido por su nombre: confírmalo o cámbialo antes de archivar.'),
     field('Documento', kind), field('Fecha de emisión', date)],
    async () => {
      const content = bytesToBase64(new Uint8Array(await file.arrayBuffer()));
      const data = await satApi('satdocs/upload', { rfc, kind: kind.value, date: date.value, content, name: file.name });
      await refresh();
      toast('Papel archivado en Expedientes y semáforo actualizado.', 'ok');
      fill(data);
    }, 'Archivar papel');
}
/* ===== Tarjetas protagonistas de Documentos (2.4.0 · W3b) =====
   Decisión de Paco (17 nov 2026, 15:16): la Constancia NO lleva
   pantalla propia; entra como TARJETA PROTAGONISTA arriba del
   todo de Documentos, con la copia archivada y SU FECHA bien
   visible y el botón «Bajar la de hoy» en un toque; la Opinión
   de cumplimiento recibe el mismo trato, al lado. Nada de
   destino nuevo en el menú. Las tarjetas viven al frente de la
   sección del SAT —la primera pieza de la vista Documentos—,
   antes de sus tarjetas por contribuyente y del listado del
   expediente. Reutilizan la vía de siempre, probada desde el
   13 nov por ruta de servidor (sin ejecutor): la lectura
   satApi('satdocs') —cuyo perfil trae, por clase, issuedAt,
   ageDays, level, source, fileId y, en la Opinión, sentido y
   vigencia leídos del propio documento archivado— y la bajada
   satApi('satdocs/run', { rfc, kind }) de satQuickRunDoc y del
   botón «Descargar ahora» de esta misma sección. */
function docHeroFecha240(value) {
  const fecha = new Date(value);
  if (!Number.isFinite(fecha.getTime())) return '';
  return fecha.toLocaleDateString('es-MX', { day: 'numeric', month: 'long', year: 'numeric' });
}
async function docHeroRun240(kind, profile, button, line, repaint) {
  const nombre = kind === 'opinion' ? 'Opinión' : 'Constancia';
  button.disabled = true;
  line.textContent = 'Descargando del portal…';
  /* Progreso visible en la propia tarjeta, como en el resto de
     Documentos: se sondea el estado de la corrida del servidor
     y su paso actual se pinta en la línea de la tarjeta. */
  const poller = setInterval(async () => {
    try {
      const fresh = await satApi('satdocs');
      const item = (fresh.profiles || []).find(row => row.rfc === profile.rfc);
      if (item?.progress?.running && item.progress.kind === kind && item.progress.step) {
        line.dataset.estado = 'encurso';
        line.textContent = item.progress.step;
      }
    } catch { /* un fallo de sondeo no tumba la descarga */ }
  }, 2500);
  try {
    const data = await satApi('satdocs/run', { rfc: profile.rfc, kind });
    toast(data.results?.[kind]?.ok ?
      nombre + ' de hoy descargada y archivada: su fecha nueva ya está en la tarjeta.' :
      'El portal no entregó el documento: el porqué queda en su tarjeta.',
      data.results?.[kind]?.ok ? 'ok' : 'error');
    /* La copia nueva sustituye a la archivada en la tarjeta al
       momento: la sección entera se repinta con la respuesta
       del servidor, que ya trae la fecha nueva. */
    if (typeof repaint === 'function') await repaint(data);
  } catch (error) {
    toast(error.message, 'error');
    if (typeof repaint === 'function') await repaint().catch(() => {});
  } finally { clearInterval(poller); delete line.dataset.estado; }
}
/* La fecha de vigencia tal como el documento la trae
   («15 de enero de 2027», ISO o DD/MM/AAAA) como instante, o
   null si no se reconoce: la barra de vigencia solo se
   dibuja con fechas reales, nunca con una inventada. */
function docVigenciaFecha2913(texto) {
  const t = String(texto || '').trim();
  if (!t) return null;
  let m = /^(\d{4})-(\d{2})-(\d{2})/.exec(t);
  if (m) return new Date(Number(m[1]), Number(m[2]) - 1, Number(m[3])).getTime();
  m = /^(\d{1,2})\/(\d{1,2})\/(\d{4})/.exec(t);
  if (m) return new Date(Number(m[3]), Number(m[2]) - 1, Number(m[1])).getTime();
  m = /^(\d{1,2}) de ([a-záéíóú]+) de (\d{4})/i.exec(t);
  if (m) {
    const meses = { enero: 0, febrero: 1, marzo: 2, abril: 3, mayo: 4, junio: 5, julio: 6,
      agosto: 7, septiembre: 8, setiembre: 8, octubre: 9, noviembre: 10, diciembre: 11 };
    const mes = meses[m[2].toLowerCase()];
    if (mes !== undefined) return new Date(Number(m[3]), mes, Number(m[1])).getTime();
  }
  return null;
}
function docHeroCard240(kind, profile, repaint) {
  const esOpinion = kind === 'opinion';
  const nombre = esOpinion ? 'Opinión de cumplimiento' : 'Constancia de situación fiscal';
  const doc = profile?.[kind] || null;
  const corriendo = Boolean(profile?.progress?.running && profile.progress.kind === kind);
  const level = corriendo ? 'ambar' : !doc ? 'ambar' :
    doc.level === 'ok' ? 'ok' : doc.level === 'warn' ? 'ambar' : 'rojo';
  const card = n('article', undefined, 'cmd-card doc-hero240');
  card.dataset.level = level;
  card.dataset.hero240 = kind;
  /* Miniatura real de la primera página (2.4.0 · WC3a, pieza
     16): la que el servidor genera una vez y cachea por huella
     del fichero (thumbs200g). Se pide SOLO al pintar esta
     tarjeta — nada de generar las de todo el expediente al
     abrir la vista — y va con el ancho contenido de la casa
     (54), sin deformar la tarjeta ni el listado en móvil. Si
     el PDF no se puede renderizar, la tarjeta queda como
     siempre: ningún hueco ni icono falso en su lugar. */
  if (doc?.fileId && typeof satToken !== 'undefined' && satToken) {
    const thumbSlot = n('div', undefined, 'doc-hero-thumb240');
    fetch('/api/miniatura200g?id=' + encodeURIComponent(doc.fileId), { headers: { 'X-PacoSAT-Token': satToken } })
      .then(r => r.ok ? r.blob() : null).then(blob => {
        if (!blob || !thumbSlot.isConnected) return;
        const img = n('img');
        img.alt = 'Primera página de la ' + (esOpinion ? 'Opinión' : 'Constancia');
        img.width = 54;
        img.src = URL.createObjectURL(blob);
        thumbSlot.append(img);
      }).catch(() => {});
    card.append(thumbSlot);
  }
  const head = n('div', undefined, 'tramite-head');
  head.append(icon(esOpinion ? 'opinion' : 'constancia'), n('strong', nombre),
    statusPill(level === 'ok' ? 'ok' : level === 'rojo' ? 'bad' : 'warn',
      corriendo ? 'Bajando ahora…' : !doc ? 'Sin archivar' :
        doc.level === 'ok' ? 'Reciente' : doc.level === 'warn' ? 'Conviene renovarla' : 'Muy vieja'));
  card.append(head, n('p', 'De ' + profile.rfc, 'tramite-detalle'));
  /* La fecha de la copia archivada, EN GRANDE: el bloque
     protagonista de la casa (total-hero) con la fecha en
     lenguaje llano — «del 12 de noviembre de 2026» — o el
     estado honesto cuando aún no hay copia. */
  const hero = n('div', undefined, 'total-hero');
  hero.append(n('span', doc ? 'La copia que tienes archivada es' : 'Copia archivada', 'tramite-detalle'));
  hero.append(n('strong', doc ? 'del ' + docHeroFecha240(doc.issuedAt) : 'Aún no tienes una archivada',
    'doc-hero-fecha240'));
  card.append(hero);
  if (doc) card.append(n('p',
    (doc.ageDays === 0 ? 'Llegó hoy' : doc.ageDays === 1 ? 'Hace 1 día' : 'Hace ' + doc.ageDays + ' días') +
    (doc.source === 'manual' ? ' · subida a mano' : ' · bajada del portal del SAT'), 'cmd-last'));
  /* (2.9.13 · mejora 15) La vigencia como BARRA: en la
     Opinión, el tiempo que queda hasta la fecha que el
     propio documento trae; en la Constancia (que no caduca),
     la frescura de la copia contra la política de recencia
     de la casa (60/90 días, la de docLevel). Sin fecha
     reconocible no se dibuja barra: no se inventa. */
  if (doc) {
    let pct2913 = null, leyenda2913 = '';
    const vence2913 = esOpinion ? docVigenciaFecha2913(doc.vigencia) : null;
    const emitida2913 = new Date(doc.issuedAt).getTime();
    if (vence2913 && Number.isFinite(emitida2913) && vence2913 > emitida2913) {
      const queda2913 = vence2913 - Date.now();
      pct2913 = Math.max(0, Math.min(100, queda2913 / (vence2913 - emitida2913) * 100));
      leyenda2913 = queda2913 > 0
        ? 'Vigencia: quedan ' + Math.ceil(queda2913 / 86400000) + ' días de los ' +
          Math.round((vence2913 - emitida2913) / 86400000) + ' del documento.'
        : 'Vigencia cumplida: el documento ya pasó su fecha.';
    } else if (Number.isFinite(doc.ageDays)) {
      pct2913 = Math.max(0, Math.min(100, 100 - doc.ageDays / 90 * 100));
      leyenda2913 = 'Frescura de la copia (política de la casa): reciente hasta los 60 días; ' +
        'entre 60 y 90 conviene renovarla; después se considera vieja. La constancia no caduca.';
    }
    if (pct2913 !== null) {
      const barra2913 = n('div', undefined, 'doc-hero-barra2913');
      const relleno2913 = n('div', undefined, 'doc-hero-barra-fill2913');
      relleno2913.style.width = pct2913.toFixed(0) + '%';
      relleno2913.dataset.level = level;
      barra2913.append(relleno2913);
      card.append(barra2913, n('p', leyenda2913, 'cmd-last'));
    }
  }
  if (esOpinion) {
    if (doc?.sentido) {
      const fila = n('p', undefined, 'cmd-last');
      fila.append(statusPill(doc.sentido === 'negativa' ? 'bad' : 'ok',
        'Sentido: ' + doc.sentido.toUpperCase(), undefined, undefined, true));
      if (doc.vigencia) fila.append(n('span', ' · vigente hasta el ' + doc.vigencia));
      card.append(fila);
    } else if (doc) {
      /* El sentido sale del texto del propio documento al
         archivarlo; si ahí no consta, no se inventa. */
      card.append(n('p', 'Su sentido no consta en la copia archivada: ábrela con «Ver» para leerlo.', 'cmd-last'));
    } else {
      card.append(n('p', 'Bájala para ver su sentido: al archivarla, su sentido queda a la vista en esta tarjeta.', 'cmd-last'));
    }
  }
  const line = n('span', corriendo && profile.progress.step ? profile.progress.step : '',
    'muted doc-hero-linea240');
  if (corriendo && profile.progress.step) line.dataset.estado = 'encurso';
  const acts = n('div', undefined, 'cmd-actions');
  const bajar = n('button', 'Bajar la de hoy', 'primary');
  bajar.type = 'button';
  bajar.disabled = corriendo;
  bajar.onclick = () => docHeroRun240(kind, profile, bajar, line, repaint);
  acts.append(bajar);
  if (doc?.fileId) {
    const ver = n('button', 'Ver', 'soft');
    ver.type = 'button';
    ver.title = 'Ver la copia archivada dentro de PacoSAT';
    ver.onclick = () => viewDocOnline({ id: doc.fileId, rfc: profile.rfc,
      kind: esOpinion ? 'Opinión de cumplimiento' : 'Constancia / CIF',
      name: nombre + ' · ' + profile.rfc + '.pdf' });
    const descargar = n('button', 'Descargar', 'soft');
    descargar.type = 'button';
    descargar.title = 'Descargar la copia archivada';
    descargar.onclick = () => downloadDocOnline({ id: doc.fileId, name: nombre + ' · ' + profile.rfc + '.pdf' });
    acts.append(ver, descargar);
    /* «Enviar» junto a «Descargar» (2.4.0 · W4a): la copia
       archivada es un documento del expediente — su fileId ES
       el id de su entrada en documents —, así que su correo
       va por la clase «documento» del conjunto cerrado. */
    if (typeof enviarBoton240 === 'function' && (typeof guestMode === 'undefined' || !guestMode))
      acts.append(enviarBoton240({
        nombre: nombre + ' · ' + profile.rfc + '.pdf',
        asunto: 'PacoSAT · ' + nombre + ' · ' + profile.rfc,
        correo: { clase: 'documento', id: doc.fileId },
        archivo: () => enviarBlobDocumento240({ id: doc.fileId, name: nombre + ' · ' + profile.rfc + '.pdf' }) }));
  }
  acts.append(line);
  card.append(acts);
  /* Si la última bajada de ESTA clase falló, el porqué vive en
     la tarjeta con el modelo único de problema (semáforo, de
     quién es —SAT o sistema—, qué significa y el gesto, o que
     se reintenta solo): sale del progreso persistido y del
     último fallo que la lectura ya trae, no de un texto nuevo. */
  if (!corriendo && profile?.progress?.kind === kind && profile.progress?.ok === false)
    card.append(problemCard(problemSpec('satdoc',
      { kind: profile.lastFailure?.kind || '', error: profile.lastFailure?.error || profile.progress.step || '' }), null));
  return card;
}
/* ===== Paquete para el banco y buscar dentro (2.4.0 · WC3a) =====
   Pieza 19: junto a las tarjetas protagonistas, una tarjeta por
   contribuyente visible con el botón «Paquete para el banco»:
   el servidor compone el ZIP (Constancia archivada + Opinión
   archivada + última declaración anual archivada) desde las
   referencias internas y la tarjeta enseña ANTES qué piezas
   constan y cuáles faltan — si falta alguna, el ZIP lleva las
   que hay y su NOTA.txt lo dice; si no hay ninguna, el botón
   se apaga y la tarjeta lo cuenta, sin generar un ZIP vacío.
   Su «Enviar» va por la clase «paquete-banco» del conjunto
   cerrado de /api/enviar, con el mismo ZIP de adjunto.
   Pieza 17: el panel «Buscar dentro de los documentos» busca
   en el nombre Y en el texto de los PDF del expediente; cada
   resultado dice dónde pegó y se abre con «Ver». */
function docBancoCard240(profile) {
  const card = n('article', undefined, 'cmd-card doc-banco240');
  card.dataset.banco240 = profile.rfc;
  const head = n('div', undefined, 'tramite-head');
  head.append(icon('bank'), n('strong', 'Paquete para el banco'));
  card.append(head, n('p', 'De ' + profile.rfc + ' · Constancia, Opinión y última declaración anual archivadas, en un solo ZIP listo para el banco.', 'tramite-detalle'));
  const line = n('p', 'Revisando qué piezas constan archivadas…', 'muted doc-banco-linea240');
  card.append(line);
  const acts = n('div', undefined, 'cmd-actions');
  const esInvitado = typeof guestMode !== 'undefined' && guestMode;
  const generar = n('button', 'Generar paquete', 'primary');
  generar.type = 'button';
  generar.disabled = true;
  generar.onclick = async () => {
    generar.disabled = true;
    line.textContent = 'Componiendo el paquete…';
    try {
      const data = await satApi('paquete-banco240', { rfc: profile.rfc });
      download(new Blob([decode64(data.content)], { type: 'application/zip' }), data.name);
      line.textContent = 'Paquete generado y descargado: ' + (data.incluidas || []).join('; ') +
        ((data.faltan || []).length ? '. No consta archivado: ' + data.faltan.join('; ') + ' — la nota dentro del ZIP lo dice.' : '.');
      toast('Paquete para el banco de ' + profile.rfc + ' descargado.', 'ok');
    } catch (error) {
      line.textContent = 'El paquete no se generó: ' + error.message;
      toast(error.message, 'error');
    } finally { generar.disabled = false; }
  };
  if (!esInvitado) acts.append(generar);
  card.append(acts);
  if (typeof satToken !== 'undefined' && satToken) {
    satApi('paquete-banco240?rfc=' + encodeURIComponent(profile.rfc)).then(data => {
      if (!card.isConnected || !data?.piezas) return;
      const p = data.piezas;
      const lleva = [], falta = [];
      if (p.constancia?.hay) lleva.push('Constancia (del ' + p.constancia.fecha + ')'); else falta.push('Constancia');
      if (p.opinion?.hay) lleva.push('Opinión (del ' + p.opinion.fecha + ')'); else falta.push('Opinión');
      if (p.anual?.hay) lleva.push('Anual ' + p.anual.ejercicio + (p.anual.esAcuse ? ' (su acuse)' : '')); else falta.push('declaración anual');
      if (!data.alguna) {
        line.textContent = 'Aún no hay ninguna pieza archivada de este RFC: baja la Constancia y la Opinión con sus tarjetas de arriba, y el paquete se podrá generar.';
        return;
      }
      line.textContent = 'Lleva: ' + lleva.join(' · ') + (falta.length ? '. Falta: ' + falta.join(' · ') + ' — el ZIP sale con lo que hay y su nota lo dice.' : '.');
      generar.disabled = false;
      if (!esInvitado && typeof enviarBoton240 === 'function')
        acts.append(enviarBoton240({
          nombre: 'Paquete para el banco · ' + profile.rfc,
          asunto: 'PacoSAT · Paquete para el banco · ' + profile.rfc,
          correo: { clase: 'paquete-banco', rfc: profile.rfc },
          archivo: () => enviarBlobSalida240('paquete-banco240', { rfc: profile.rfc }) }));
    }).catch(() => {
      if (!card.isConnected) return;
      line.textContent = 'No se pudo revisar el expediente: el paquete se puede intentar igualmente; el servidor dirá qué piezas constan.';
      generar.disabled = false;
    });
  }
  return card;
}
function docBuscarPanel240() {
  const wrap = panel('Buscar dentro de los documentos',
    'Busca en el nombre y en el TEXTO de los PDF archivados: cada resultado dice dónde pegó y, si pegó en el texto, enseña el fragmento que contiene la frase.');
  const fila = n('div', undefined, 'filters');
  const entrada = input('search', { placeholder: 'Una frase del documento: «total a pagar», «cláusula»…', 'aria-label': 'Buscar dentro de los documentos' });
  const boton = n('button', 'Buscar', 'primary');
  boton.type = 'button';
  const estado = n('p', '', 'muted');
  const resultados = n('div');
  const buscar = async () => {
    const q = entrada.value.trim();
    if (q.length < 3) { estado.textContent = 'Escribe al menos 3 letras para buscar.'; return; }
    boton.disabled = true;
    estado.textContent = 'Buscando en los documentos…';
    resultados.replaceChildren();
    try {
      const data = await satApi('buscar-contenido240?q=' + encodeURIComponent(q) +
        (typeof scope !== 'undefined' && scope ? '&rfc=' + encodeURIComponent(scope) : ''));
      const lista = data.resultados || [];
      const notas = [];
      if (data.indexadosAhora) notas.push('se leyó el texto de ' + data.indexadosAhora + ' documento(s) por primera vez' +
        (data.pendientes ? '; quedan ' + data.pendientes + ' por leer: busca otra vez para completar' : ''));
      if (!lista.length) notas.push('ningún documento archivado trae esa frase en su nombre ni en su texto');
      estado.textContent = notas.length ? 'Sin resultados: ' + notas.join(' — ') + '.' :
        lista.length + (lista.length === 1 ? ' resultado' : ' resultados') + '.';
      if (lista.length && notas.length) estado.textContent = lista.length + ' resultado(s) — ' + notas.join(' — ') + '.';
      for (const r of lista) {
        const filaR = n('div', undefined, 'cp-row doc-buscar-fila240');
        const main = n('div', undefined, 'cp-main');
        main.append(n('strong', (r.kind ? r.kind + ' · ' : '') + (r.name || 'Documento')),
          n('span', (r.rfc || '') + (r.date ? ' · ' + dateLabel(r.date) : ''), 'muted'));
        if (r.donde === 'texto' && r.fragmento)
          main.append(n('span', 'En el texto: «' + r.fragmento + '»', 'doc-buscar-frag240'));
        filaR.append(main, statusPill(r.donde === 'texto' ? 'ok' : 'dim',
          r.donde === 'texto' ? 'Pegó en el texto' : 'Pegó en el nombre'));
        const ver = n('button', 'Ver', 'soft small');
        ver.type = 'button';
        ver.onclick = () => viewDocOnline({ id: r.id, rfc: r.rfc, kind: r.kind, name: r.name });
        filaR.append(ver);
        resultados.append(filaR);
      }
    } catch (error) {
      estado.textContent = 'La búsqueda no salió: ' + error.message;
    } finally { boton.disabled = false; }
  };
  boton.onclick = buscar;
  entrada.onkeydown = event => { if (event?.key === 'Enter') buscar(); };
  fila.append(entrada, boton);
  wrap.append(fila, estado, resultados);
  return wrap;
}
function satDocsSection() {
  const section = panel('Constancias y opinión del SAT',
    'Vigencia y renovación de tu constancia y tu opinión, por contribuyente.');
  /* Ancla de «Ver los últimos» de las tarjetas del Centro SAT (1.29.2). */
  section.id = 'satdocs-section';
  /* W3b (2.4.0): las dos tarjetas protagonistas abren la vista
     Documentos — van en su propio contenedor, ANTES del cuerpo
     de la sección, para que el repintado del cuerpo (fill) no
     las arrastre y queden siempre encima del listado. */
  const heroBox = n('div', undefined, 'cmd-grid doc-hero-grid240');
  section.append(heroBox);
  /* WC3a (2.4.0): junto a las protagonistas — el paquete para
     el banco de cada contribuyente visible y el buscar dentro
     de los documentos — en sus propios contenedores, para que
     el repintado del cuerpo (fill) no los arrastre. */
  const bancoBox = n('div', undefined, 'cmd-grid doc-banco-grid240');
  section.append(bancoBox);
  section.append(docBuscarPanel240());
  const body = n('div');
  section.append(body);
  const fill = async data => {
    const view = data || await satApi('satdocs');
    body.replaceChildren();
    if (!view.profiles.length) {
      heroBox.replaceChildren();
      bancoBox.replaceChildren();
      body.append(n('p', 'Aún no hay RFC dados de alta: agrega el primero en Ajustes › Contribuyentes y sus documentos se vigilarán aquí.', 'empty'));
      return;
    }
    /* Sin mezcla de RFC (1.28.0, P7): con un contribuyente
       elegido, la sección enseña SOLO sus tarjetas y sus
       formularios, como ya hacen las tarjetas de arriba. */
    const visibles = scope ? view.profiles.filter(profile => profile.rfc === scope) : view.profiles;
    /* F5 (1.31.0): las versiones archivadas de cada (rfc, kind),
       para marcar la vigente y dejar las anteriores con su fecha. */
    const versiones = satDocVersiones();
    if (!visibles.length) {
      heroBox.replaceChildren();
      bancoBox.replaceChildren();
      body.append(n('p', 'El contribuyente elegido no tiene documentos del SAT vigilados todavía.', 'empty'));
      return;
    }
    /* W3b (2.4.0): las protagonistas de cada contribuyente
       visible — Constancia y Opinión, lado a lado (en móvil se
       apilan por la rejilla de siempre) — encima de todo lo
       demás de la sección y del listado del expediente. */
    heroBox.replaceChildren(...visibles.flatMap(profile => [
      docHeroCard240('constancia', profile, fill),
      docHeroCard240('opinion', profile, fill)]));
    /* WC3a (2.4.0): el paquete para el banco, junto a las
       protagonistas, una tarjeta por contribuyente visible. */
    bancoBox.replaceChildren(...visibles.map(profile => docBancoCard240(profile)));
    for (const profile of visibles) {
      const card = n('article', undefined, 'sat-card');
      const head = n('div', undefined, 'sat-card-head');
      head.append(n('strong', profile.rfc),
        /* Tanda 7B (27): glifos propios de trazo fino de la casa. */
        icon('constancia'), satDocPill(profile.constancia, 'Constancia'),
        icon('opinion'), satDocPill(profile.opinion, 'Opinión'));
      card.append(head);
      const meta = n('div', undefined, 'sat-meta');
      /* Un clic en «Ver» y el documento se abre dentro de la app
         (1.10.2): nada de ir a buscarlo a una carpeta. */
      const verButton = (doc, label, kind) => {
        if (!doc?.fileId) return;
        /* Tanda 7B (0c): la miniatura real de la primera página,
           la que el servidor ya genera y cachea (thumbs200g). */
        if (typeof satToken !== 'undefined' && satToken)
          fetch('/api/miniatura200g?id=' + encodeURIComponent(doc.fileId), { headers: { 'X-PacoSAT-Token': satToken } })
            .then(r => r.ok ? r.blob() : null).then(blob => { if (!blob || !meta.isConnected) return;
              const img = n('img'); img.alt = 'Primera página de la ' + label; img.width = 54;
              img.src = URL.createObjectURL(blob); meta.prepend(img); }).catch(() => {});
        const ver = n('button', 'Ver', 'soft small');
        ver.title = 'Ver la ' + label.toLowerCase() + ' dentro de PacoSAT';
        ver.onclick = () => viewDocOnline({ id: doc.fileId, rfc: profile.rfc, kind,
          name: label + ' · ' + profile.rfc + '.pdf' });
        meta.append(ver);
      };
      if (profile.constancia) {
        meta.append(n('span', 'Constancia emitida: ' + localDate(profile.constancia.issuedAt) + (profile.constancia.source === 'manual' ? ' (subida a mano)' : '')));
        /* F5: este es el documento del servidor, el más reciente
           de su (rfc, kind): lleva su pastilla de vigente. */
        meta.append(statusPill('ok', 'Vigente'));
        verButton(profile.constancia, 'Constancia', 'Constancia / CIF');
      }
      if (profile.opinion) {
        meta.append(n('span', 'Opinión emitida: ' + localDate(profile.opinion.issuedAt) + (profile.opinion.source === 'manual' ? ' (subida a mano)' : '')));
        meta.append(statusPill('ok', 'Vigente'));
        if (profile.opinion.sentido) meta.append(n('span', 'Sentido: ' + profile.opinion.sentido.toUpperCase() +
          (profile.opinion.vigencia ? ' · vigente hasta el ' + profile.opinion.vigencia : '')));
        verButton(profile.opinion, 'Opinión', 'Opinión de cumplimiento');
      }
      /* Archivar visible junto a «Ver» (2.0.1): el documento
         vigente también se puede archivar sin cazarlo en un
         menú. El gesto es el de siempre (docArchivar1311, con
         su Deshacer) y actúa sobre la entrada del expediente
         que ES este documento: se localiza por su id, que es
         el fileId que el servidor archiva (archiveSatDoc guarda
         la entrada de documents con id = fileId). Sin entrada
         que case, no se pinta botón: nada de archivar a ciegas. */
      for (const [docSrv, kindDoc] of [[profile.constancia, 'constancia'], [profile.opinion, 'opinion']]) {
        if (!docSrv?.fileId || typeof docArchivar1311 !== 'function') continue;
        const entrada = (versiones.get(profile.rfc + '|' + kindDoc) || []).find(doc => doc.id === docSrv.fileId);
        if (!entrada) continue;
        const arch = n('button', 'Archivar', 'soft small');
        arch.type = 'button';
        arch.title = 'Archivar este documento: sale de Documentos y vive en Archivo, recuperable';
        arch.onclick = () => docArchivar1311(entrada);
        meta.append(arch);
      }
      if (profile.lastAttempt) meta.append(n('span', 'Último intento de descarga: ' + localDateTime(profile.lastAttempt)));
      card.append(meta);
      /* F5 · la lista de versiones (1.31.0): solo cuando hay
         más de una archivada de la misma clase — la primera
         (la más reciente del grupo) con su «Vigente» y las
         anteriores con su fecha, para que se vea cuál manda
         sin borrar la historia. 2.0.1: las anteriores llevan
         también su pastilla «Anterior» (antes iban sin marca
         y no se distinguían de un vistazo) y CADA fila lleva
         su «Archivar» visible junto a «Descargar» — archivar
         las viejas para no llenarse de constancias queda a un
         toque, con el Deshacer de siempre (docArchivar1311). */
      for (const [kindDoc, etiquetaDoc] of [['constancia', 'Constancia'], ['opinion', 'Opinión']]) {
        const grupo = versiones.get(profile.rfc + '|' + kindDoc) || [];
        if (grupo.length < 2) continue;
        const boxVersiones = n('div', undefined, 'sat-versiones');
        boxVersiones.append(n('strong', 'Versiones · ' + etiquetaDoc));
        /* (2.9.13 · A9) La misma versión bajada varias veces
           en el mismo instante se enseña UNA vez («bajada N
           veces»); dos documentos distintos del mismo día se
           distinguen por su HORA, no se duplican mudos — la
           auditoría vio la constancia del 16/11 y la del
           11/11 dos veces sin nada que las distinguiera. */
        const filasVersiones2913 = [];
        {
          const porMomento2913 = new Map();
          for (const docGrupo of grupo) {
            const claveMomento2913 = String(docGrupo.date || '') + '|' + (docGrupo.name || '');
            const previa2913 = porMomento2913.get(claveMomento2913);
            if (previa2913) { previa2913.veces++; continue; }
            const entrada2913 = { doc: docGrupo, veces: 1 };
            porMomento2913.set(claveMomento2913, entrada2913);
            filasVersiones2913.push(entrada2913);
          }
        }
        const diaDe2913 = doc => typeof doc.date === 'string' && doc.date.length >= 10
          ? doc.date.slice(0, 10) : new Date(doc.date).toISOString().slice(0, 10);
        const diasConVarias2913 = new Set();
        {
          const porDia2913 = new Map();
          for (const entrada2913 of filasVersiones2913) {
            const dia = diaDe2913(entrada2913.doc);
            porDia2913.set(dia, (porDia2913.get(dia) || 0) + 1);
          }
          for (const [dia, cuenta] of porDia2913) if (cuenta > 1) diasConVarias2913.add(dia);
        }
        const horaDe2913 = doc => typeof doc.date === 'string' && doc.date.length >= 16
          ? doc.date.slice(11, 16) : localTime(doc.date);
        filasVersiones2913.forEach(({ doc, veces }, indice) => {
          const fila = n('div', undefined, 'cp-row');
          fila.append(n('span', (doc.name || etiquetaDoc) + ' · ' +
            (typeof doc.date === 'string' && doc.date.length >= 10 ? dateLabel(doc.date) : localDate(doc.date)) +
            (diasConVarias2913.has(diaDe2913(doc)) ? ' · ' + horaDe2913(doc) : '') +
            (veces > 1 ? ' · bajada ' + veces + ' veces' : '')));
          if (indice === 0) fila.append(statusPill('ok', 'Vigente'));
          else fila.append(statusPill('dim', 'Anterior'));
          /* (2.9.9 · D2) UN solo botón de acciones por fila: el
             ⋯, con las acciones de la versión dentro — Ver y
             Descargar (1.32.1, Do3), Enviar (2.4.0 · W4a: cada
             versión es un documento del expediente por su id) y
             Archivar —, mismas palabras y mismo efecto. */
          const itV = [
            { label: 'Ver', fn: () => viewDocOnline(doc) },
            { label: 'Descargar', fn: () => downloadDocOnline(doc) }];
          if (typeof enviarBoton240 === 'function' && (typeof guestMode === 'undefined' || !guestMode))
            itV.push({ label: 'Enviar', fn: () => enviarTarjeta240({
              nombre: doc.name || etiquetaDoc,
              asunto: 'PacoSAT · ' + (doc.name || etiquetaDoc),
              correo: { clase: 'documento', id: doc.id },
              archivo: () => enviarBlobDocumento240(doc) }) });
          if (typeof docArchivar1311 === 'function')
            itV.push({ label: 'Archivar', fn: () => docArchivar1311(doc) });
          const mV = cardMenu1312('Más opciones de esta versión');
          mV._setItems1312(itV);
          fila.append(mV);
          boxVersiones.append(fila);
        });
        card.append(boxVersiones);
      }
      /* Puesta en marcha (M4): lo que falta para que este
         contribuyente quede trabajando, paso a paso. */
      if (profile.arranque && profile.arranque.hechas < profile.arranque.total) {
        const boxArranque = n('div', undefined, 'sat-arranque');
        boxArranque.append(n('strong', 'Puesta en marcha · ' + profile.arranque.hechas + ' de ' + profile.arranque.total));
        const list = n('ul');
        for (const step of profile.arranque.steps) {
          const pasoArranque240 = n('li', step.label + (step.done ? '' : (step.gesto ? ' — ' + step.gesto : '')));
          pasoArranque240.dataset.estado = step.done ? 'aldia' : 'sindatos';
          list.append(pasoArranque240);
        }
        boxArranque.append(list);
        card.append(boxArranque);
      }
      if (profile.lastError) {
        /* El último fallo se cuenta con el modelo único (1.13.0):
           semáforo, de quién es, qué significa y qué hacer; el
           mensaje crudo del motor queda en el detalle técnico. */
        if (profile.lastFailure) {
          const spec = problemSpec('satdoc', { kind: profile.lastFailure.kind, error: profile.lastFailure.error });
          card.append(problemCard(spec, spec.accion === 'subir-doc' ?
            action('Subir PDF a mano', () => satDocUploadDialog(profile.rfc, fill,
              !profile.constancia ? 'constancia' : !profile.opinion ? 'opinion' : profile.progress?.kind), 'soft') : null));
        } else card.append(n('p', 'Último intento: ' + profile.lastError, 'error-text'));
      }
      /* Configuración del envío automático, en lenguaje llano. */
      const form = n('div', undefined, 'satdoc-form');
      const enabled = input('checkbox', { checked: Boolean(profile.config.enabled) });
      const dayInput = input('number', { value: profile.config.day, min: 1, max: 28, 'aria-label': 'Día del mes' });
      const hourInput = input('number', { value: profile.config.hour, min: 0, max: 23, 'aria-label': 'Hora' });
      const recipients = input('text', { value: profile.config.recipients, placeholder: 'Correos que reciben los documentos (separados por comas); vacío = tu correo de avisos' });
      const toggleLabel = n('label', undefined, 'switch-line');
      toggleLabel.append(enabled, n('span', 'Descarga automática mensual'));
      const when = n('label'); when.append(n('span', 'Día '), dayInput, n('span', ' a las '), hourInput, n('span', ':00'));
      const save = n('button', 'Guardar descarga automática', 'soft');
      save.onclick = async () => {
        try {
          const data = await satApi('satdocs/config', { rfc: profile.rfc, enabled: enabled.checked,
            day: Number(dayInput.value), hour: Number(hourInput.value), recipients: recipients.value });
          toast('Configuración guardada para ' + profile.rfc + '.', 'ok');
          fill(data);
        } catch (error) { toast(error.message, 'error'); }
      };
      form.append(toggleLabel, when, recipients, save);
      /* La tarjeta es estado + acción (1.32.1, Do5): la
         configuración de la descarga automática va plegada en
         su propio «Descarga automática», no mezclada en la cara. */
      const formDetails = n('details', undefined, 'satdoc-config');
      formDetails.append(n('summary', 'Descarga automática — configuración'), form);
      card.append(formDetails);
      const actions = n('div', undefined, 'sat-actions');
      const run = n('button', 'Descargar ahora', 'primary');
      run.onclick = async () => {
        run.disabled = true; run.textContent = 'Descargando del portal…';
        /* Progreso EN VIVO (1.10.1): la corrida sigue en el servidor
           aunque esta petición tarde lo que tarde; mientras tanto se
           consulta el estado cada pocos segundos y se pintan los
           pasos tal como ocurren — si se conectó, si está firmando,
           qué está pidiendo — sin refrescar la página. Al terminar,
           el sondeo se detiene y la tarjeta se repinta entera. */
        const poller = setInterval(async () => {
          try {
            const fresh = await satApi('satdocs');
            for (const item of fresh.profiles) {
              const box = body.querySelector('[data-progress-for="' + item.rfc + '"]');
              if (box) renderSatDocProgress(box, item);
              if (!item.progress?.running) {
                const runs = body.querySelector('[data-runs-for="' + item.rfc + '"]');
                if (runs) renderSatDocRuns(runs, item);
              }
            }
          } catch { /* un fallo de sondeo no tumba la descarga */ }
        }, 2500);
        try {
          const data = await satApi('satdocs/run', { rfc: profile.rfc });
          const failed = Object.values(data.results).filter(result => !result.ok).length;
          toast(failed ? 'El portal no entregó ' + failed + ' documento(s): quedó registrado en el diario y avisado.' :
            'Documentos descargados, archivados y enviados.', failed ? 'error' : 'ok');
          fill(data);
        } catch (error) { toast(error.message, 'error'); fill(); }
        finally { clearInterval(poller); }
      };
      const upload = n('button', 'Subir PDF a mano', 'soft');
      upload.onclick = () => satDocUploadDialog(profile.rfc, fill,
        !profile.constancia ? 'constancia' : !profile.opinion ? 'opinion' : undefined);
      /* Subir un papel en 2 toques (F7, 1.31.0): botón grande
         junto al de siempre — un toque abre el selector (PDF o
         imagen, el mismo flujo en el móvil) y al elegir, el
         diálogo de confirmación ya trae el tipo sugerido por
         el nombre del archivo. */
      const papel = n('button', 'Subir un papel', 'soft');
      papel.type = 'button';
      const papelInput = input('file', { accept: 'application/pdf,image/*' });
      papelInput.hidden = true;
      papel.onclick = () => papelInput.click();
      papelInput.onchange = () => {
        const file = papelInput.files[0];
        papelInput.value = '';
        if (file) satDocPapelDialog(profile.rfc, fill, file);
      };
      actions.append(run, upload, papel, papelInput);
      card.append(actions);
      /* Progreso persistido de la última corrida (o de la que sigue
         en curso en el servidor) y el diario de corridas: al volver
         a esta pantalla —aunque se haya refrescado— se ve el estado
         real, no una pantalla muda. */
      const progressBox = n('div', undefined, 'sat-progress');
      progressBox.dataset.progressFor = profile.rfc;
      card.append(progressBox);
      renderSatDocProgress(progressBox, profile);
      const runsBox = n('div', undefined, 'sat-runs');
      runsBox.dataset.runsFor = profile.rfc;
      card.append(runsBox);
      renderSatDocRuns(runsBox, profile);
      body.append(card);
    }
  };
  fill();
  return section;
}
/* Pasos de una corrida, en lenguaje llano y con su hora: los
   mismos que el servidor persiste mientras descarga. */
function satDocStepList(steps, withUrl) {
  const list = n('ol', undefined, 'sat-steps');
  for (const step of steps || []) {
    const item = n('li');
    /* El prefijo «⚠» de un paso es un MARCADOR interno (lo emite el
       motor CIEC y lo detecta runPhaseStates en data.part): aquí se
       PINTA sin glifo — icono de la familia y el texto limpio — y el
       marcador en el dato no se toca (2.4.0 · W5b3). */
    const textoCrudo240 = String(step.text || '');
    const esAviso240 = textoCrudo240.startsWith('⚠');
    const textoPaso240 = n('span', (esAviso240 ? textoCrudo240.slice(1).trimStart() : textoCrudo240) +
      (withUrl && step.url ? ' · ' + step.url : ''));
    if (esAviso240) textoPaso240.dataset.estado = 'atencion';
    item.append(
      n('span', localTime(step.at), 'sat-step-time'),
      textoPaso240);
    list.append(item);
  }
  return list;
}
function renderSatDocProgress(box, profile) {
  box.replaceChildren();
  const progress = profile.progress;
  if (!progress || !Array.isArray(progress.steps) || !progress.steps.length) return;
  const head = n('p', undefined, 'sat-progress-head');
  head.append(n('strong', progress.running ? 'Descargando ahora · ' : 'Última descarga · '),
    n('span', (progress.kind === 'opinion' ? 'Opinión de cumplimiento' : 'Constancia') + ' — ' + progress.step));
  box.append(head);
  /* Corridas visuales (1.13.0): las fases de la tubería con su
     estado (hecho / en curso / falló aquí) mandan sobre el diario;
     el diario de líneas queda debajo como rastro. */
  const outcome = progress.running ? 'running' : progress.ok === false ? 'failed' : 'ok';
  box.append(runPhasesEl(SATDOC_PHASES, progress.steps, outcome));
  if (!progress.running && progress.ok === false) {
    const run = (profile.runs || []).find(candidate => !candidate.ok);
    const spec = problemSpec('satdoc', { kind: run?.errorKind || '', error: run?.error || progress.step });
    box.append(problemCard(spec, null));
    const evidencia = run ? evidenceButtons('satdoc', run) : null;
    if (evidencia) box.append(evidencia);
  }
  box.append(satDocStepList(progress.steps, false));
  if (progress.running) {
    box.append(n('p', 'La descarga sigue en el servidor: puedes refrescar o salir y volver; al regresar verás el estado real.', 'sat-progress-note'));
    /* Cancelar (pieza 9, 1.22.0): detiene la corrida EN EL
       SERVIDOR, descarta lo parcial y deja el último documento
       bueno intacto. Tras pedirlo, la pantalla RE-LEE el estado
       antes de afirmar que se canceló. */
    const cancel = n('button', 'Cancelar descarga', 'soft small danger');
    cancel.type = 'button';
    cancel.onclick = async () => {
      cancel.disabled = true; cancel.textContent = 'Cancelando…';
      try {
        await satApi('satdocs/cancel', { rfc: profile.rfc, kind: progress.kind });
        for (let i = 0; i < 20; i++) {
          const fresh = await satApi('satdocs').catch(() => null);
          const item = (fresh?.profiles || []).find(row => row.rfc === profile.rfc);
          if (!item) break;
          renderSatDocProgress(box, item);
          if (!item.progress?.running) {
            toast(item.progress?.step?.includes('cancelada') ? 'Descarga cancelada: lo parcial se descartó y tu último documento sigue intacto.' :
              'La corrida terminó antes de que el cancelar llegara.', 'ok');
            break;
          }
          await new Promise(resolve => setTimeout(resolve, 1500));
        }
      } catch (error) { toast(error.message, 'error'); cancel.disabled = false; cancel.textContent = 'Cancelar descarga'; }
    };
    box.append(cancel);
  }
}
/* El diario: cada corrida con su resultado y sus pasos; si falló
   dentro del navegador, la captura y el HTML de la página en el
   punto del fallo se pueden ver y bajar desde aquí. */
function renderSatDocRuns(box, profile) {
  box.replaceChildren();
  const runs = Array.isArray(profile.runs) ? profile.runs : [];
  if (!runs.length) return;
  box.append(n('h4', 'Diario de descargas', 'sat-runs-title'));
  for (const run of runs.slice(0, 5)) {
    const details = n('details', undefined, 'sat-run');
    /* El resumen diferencia el fallo (2.9.0 · Bloque C): tres
       corridas caídas enseñaban tres «Falló» idénticos; ahora
       cada resumen nombra su causa con el modelo único. */
    const causa290 = !run.ok && typeof problemSpec === 'function'
      ? (problemSpec('satdoc', { kind: run.errorKind || '', error: run.error || '' })?.titulo || '') : '';
    const summary = n('summary', localDateTime(run.started) + ' · ' +
      (run.kind === 'opinion' ? 'Opinión' : 'Constancia') +
      (run.ok ? ' · Guardada en Expedientes' : ' · Falló' + (causa290 ? ' — ' + causa290 : '')));
    details.append(summary);
    /* La corrida caída enseña sus fases con el falló-aquí, el
       problema con el modelo único y su evidencia a un clic
       (1.13.0); el diario de líneas queda como rastro completo. */
    details.append(runPhasesEl(SATDOC_PHASES, run.steps, run.ok ? 'ok' : 'failed'));
    if (!run.ok) {
      const spec = problemSpec('satdoc', { kind: run.errorKind || '', error: run.error || '' });
      details.append(problemCard(spec, null));
      const evidencia = evidenceButtons('satdoc', run);
      if (evidencia) details.append(evidencia);
    }
    details.append(satDocStepList(run.steps, true));
    box.append(details);
  }
}
/* ===== Trabajos del SAT (1.22.0, pieza 14): cola de lectura
   sobre los registros reales de todas las corridas, con su
   estado, su causa probada y su Cancelar. Lee /api/sat/trabajos. */
function trabajosSatSection() {
  const section = panel('Trabajos del SAT',
    'Todas las corridas contra el SAT en una sola cola: qué corre ahora (con su Cancelar), qué falló y por qué causa probada, y qué terminó y cuándo. Sale de los registros reales de cada motor, no de otra lista.');
  const body = n('div');
  section.append(body);
  const CLASE = { documento: 'Documento', declaraciones: 'Declaraciones', masiva: 'Paquetes',
    recuperacion: 'Recuperación', mensual: 'Mensual', ciec: 'CIEC' };
  const ESTADO = { 'en-curso': ['warn', 'En curso'], pausada: ['warn', 'Pausada'],
    terminada: ['ok', 'Terminada'], fallida: ['bad', 'Fallida'], cancelada: ['dim', 'Cancelada'],
    interrumpida: ['bad', 'Interrumpida por reinicio'] };
  const fill = async () => {
    const data = await satApi('sat/trabajos').catch(() => null);
    body.replaceChildren();
    const rows = data?.trabajos || [];
    if (!rows.length) {
      body.append(n('p', 'Sin corridas registradas todavía.', 'empty'));
      return;
    }
    for (const row of rows) {
      const line = n('div', undefined, 'cp-row');
      const pill = ESTADO[row.estado] || ['dim', row.estado];
      line.append(statusPill(pill[0], (CLASE[row.clase] || row.clase) + ' · ' + pill[1]),
        n('span', row.titulo + ' · ' + localDateTime(row.at) +
          (row.causa ? ' — ' + row.causa : '')));
      if (row.cancelar) {
        const cancel = n('button', 'Cancelar', 'soft small danger');
        cancel.type = 'button';
        cancel.onclick = async () => {
          cancel.disabled = true; cancel.textContent = 'Cancelando…';
          try {
            if (row.cancelar.tipo === 'satdoc')
              await satApi('satdocs/cancel', { rfc: row.cancelar.rfc, kind: row.cancelar.kind || undefined });
            else if (row.cancelar.tipo === 'decl')
              await satApi('declaraciones/cancel', { rfc: row.cancelar.rfc });
            else if (row.cancelar.tipo === 'job')
              await satApi('sat/cancel-job', { id: row.cancelar.id });
            toast('Cancelación pedida: la corrida se detiene en el servidor.', 'ok');
            setTimeout(fill, 1200);
          } catch (error) { toast(error.message, 'error'); cancel.disabled = false; cancel.textContent = 'Cancelar'; }
        };
        line.append(cancel);
      }
      /* «Seguir» tras cancelar (2.3.0 · pieza 6): la corrida
         cancelada se reanuda desde aquí con su jobId (el del
         ejecutor o el id de la fila); el servidor dice en
         llano qué se reanudó — o por qué no se puede — y ese
         texto queda a la vista junto al botón. */
      if (row.estado === 'cancelada' && typeof seguirBoton230 === 'function' && (row.jobId || row.id))
        line.append(seguirBoton230(row.jobId || row.id, fill));
      const go = n('button', 'Ver detalle', 'soft small');
      go.type = 'button';
      go.onclick = () => navigate(row.enlace === 'satdocs' || row.enlace === 'declaraciones' ? 'docs' : 'sat');
      line.append(go);
      body.append(line);
    }
  };
  fill();
  return section;
}
function satDocUploadDialog(rfc, fill, presetKind) {
  const kind = n('select');
  for (const [value, label] of [['constancia', 'Constancia de situación fiscal'], ['opinion', 'Opinión de cumplimiento']]) {
    const option = n('option', label); option.value = value; kind.append(option);
  }
  /* F3 (1.22.0): desde la tarjeta de un documento, el tipo ya
     viene puesto — un gesto menos y ningún error de clase. */
  if (presetKind) kind.value = presetKind;
  const date = input('date', { required: true, value: new Date().toISOString().slice(0, 10) });
  const picker = input('file', { accept: '.pdf,application/pdf', required: true });
  dialog('Subir documento del SAT · ' + rfc,
    [field('Documento', kind), field('Fecha de emisión', date), field('Archivo PDF', picker)],
    async () => {
      const file = picker.files[0];
      check(file, 'Elige el archivo PDF.');
      const content = bytesToBase64(new Uint8Array(await file.arrayBuffer()));
      const data = await satApi('satdocs/upload', { rfc, kind: kind.value, date: date.value, content, name: file.name });
      await refresh();
      toast('Documento archivado en Expedientes y semáforo actualizado.', 'ok');
      fill(data);
    }, 'Archivar documento');
}
function localDate(value) {
  return new Date(value).toLocaleDateString('es-MX', { day: 'numeric', month: 'short', year: 'numeric' });
}
