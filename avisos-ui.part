/* ===== Indicador de actividad global + Centro de Avisos (1.7.4) =====
   Pieza 1 (puntos 12 y 16): ninguna acción larga queda «en silencio».
   Un panel fijo y visible dice QUÉ se está haciendo, con contador real
   («procesando X de N») y barra; al terminar una importación grande, el
   resumen «✓ Procesado» queda FIJO en pantalla hasta que el usuario lo
   cierra: nuevos, duplicados, por revisar y qué hacer con cada problema.
   Pieza 2 (punto 17): el Centro de Avisos vive en el servidor (NAS): tres
   clases siempre visibles — LO QUE ESTÁ MAL, LO QUE FALTA y LO QUE EL
   SISTEMA NECESITA DE TI — con solventar real («Ya lo corregí» re-comprueba;
   «Ya se pagó» de UN TOQUE) y un solo correo-resumen configurable.
   Ronda de correcciones (9 nov 2026): la nota del pago manual pasa a
   OPCIONAL (cierre con un toque; la bitácora registra sola el cierre)
   y llega la selección múltiple con barra por lote: «Marcar pagadas»,
   «Cerrar» y «Borrar» (descartar), con confirmación y conteo.
   Ronda 1.11.0 (rediseño, flujos §3.3 y sistema-visual §5–§6): el cierre
   de saldo individual YA NO abre diálogo: «Ya se pagó» llama directamente
   a notices/answer con respuesta 'si', sin fecha y sin nota (la fecha la
   anota la bitácora sola); el responsable se ve como texto («Lo lleva: …»)
   y se cambia desde un diálogo discreto, no con un selector en la cara;
   el panel del correo-resumen SALE de esta pantalla y se expone como
   avisosMailSection() para que lo incruste Ajustes; y sin avisos la
   pantalla dice en grande «Todo en orden. No tienes avisos.». */

let activityState = null;
function activityStart(label, total = 0) {
  activityState = { label, done: 0, total: Math.max(0, total | 0) };
  const dock = $('activity-dock');
  dock.hidden = false;
  $('activity-label').textContent = label;
  $('activity-detail').textContent = '';
  activityPaint();
}
function activitySetTotal(total) {
  if (!activityState) return;
  activityState.total = Math.max(activityState.total, total | 0);
  activityPaint();
}
function activityProgress(done, detail) {
  if (!activityState) return;
  activityState.done = Math.max(activityState.done, done | 0);
  if (detail !== undefined) $('activity-detail').textContent = detail;
  activityPaint();
}
function activityPaint() {
  if (!activityState) return;
  const { done, total } = activityState;
  $('activity-count').textContent = total ? 'Procesando ' + number.format(done) + ' de ' + number.format(total) : '';
  const bar = $('activity-bar');
  bar.max = 100;
  bar.value = total ? Math.min(100, Math.round(done * 100 / total)) : 0;
  if (!total) bar.removeAttribute('value');
}
function activityFinish() {
  activityState = null;
  $('activity-dock').hidden = true;
}
function activityDone(title, lines) {
  activityFinish();
  $('activity-result-title').textContent = title;
  $('activity-result-text').replaceChildren(...lines.map(line =>
    typeof line === 'string' ? n('p', line) : line));
  $('activity-result').hidden = false;
  $('activity-result').scrollIntoView({ block: 'nearest', behavior: 'smooth' });
}
function activityFail(title, message) {
  activityFinish();
  activityDone('⚠ ' + title, [message]);
}
$('activity-result-close').onclick = () => { $('activity-result').hidden = true; };

/* ---------- Centro de Avisos ---------- */
let avisosCache = null;
let avisosInflight = null;
let avisosFetchedAt = 0;
/* Selección múltiple para acciones por lote (ronda de correcciones). */
const avisosSeleccion = new Set();
/* Filtro por RFC propio del Centro (1.9.0). */
let avisosRfcFiltro = '';
let avisosVisibles = [];
const AVISOS_CLASES = [
  ['necesita', 'Lo que el sistema necesita de ti', 'alert'],
  ['mal', 'Lo que está mal', 'x'],
  ['falta', 'Lo que falta', 'clock']
];
const AVISOS_ENLACES = {
  dinero: ['dinero', 'Ir a Dinero'], bancos: ['bancos', 'Ir a Bancos'],
  lists: ['lists', 'Ir a Listas negras'], monitor: ['monitor', 'Ir a Vigilancia SAT'],
  sat: ['sat', 'Ir al Centro SAT'], backup: ['backup', 'Ir a Respaldos'],
  docs: ['docs', 'Ir a Expedientes'], operaciones: ['operations', 'Ir a Operaciones'],
  cumplimiento: ['cumplimiento', 'Ir a Cumplimiento']
};
function avisosDisponibles() { return typeof satToken !== 'undefined' && Boolean(satToken); }
async function refreshAvisos(force = false) {
  if (!avisosDisponibles()) { paintAvisosBadge(0); return null; }
  if (avisosInflight) return avisosInflight;
  if (!force && avisosCache && Date.now() - avisosFetchedAt < 20000) return avisosCache;
  avisosInflight = (async () => {
    try {
      avisosCache = await satApi('notices');
      avisosFetchedAt = Date.now();
      paintAvisosBadge(avisosCache.counts.total);
      if (page === 'avisos') render();
    } catch { /* sin servidor alcanzable: no se inventa ningún conteo */ }
    avisosInflight = null;
    return avisosCache;
  })();
  return avisosInflight;
}
function paintAvisosBadge(count) {
  const badge = $('avisos-badge');
  if (!badge) return;
  badge.hidden = !count;
  badge.textContent = count ? number.format(count) : '';
}
function avisoFecha(ts) {
  return new Date(ts).toLocaleDateString('es-MX', { day: 'numeric', month: 'short' });
}
function avisoMeta(aviso) {
  const bits = [];
  if (aviso.nombre) bits.push(aviso.nombre + (aviso.contraparte ? ' · ' + aviso.contraparte : ''));
  else if (aviso.contraparte) bits.push(aviso.contraparte);
  if (aviso.importe) bits.push('$' + money(aviso.importe));
  /* 1.9.0: de qué RFC propio es y cuándo vence — como datos en la
     tarjeta, no escondidos en el texto. Quién lo lleva va en su propia
     línea como texto (1.11.0, sistema-visual §6), no en esta meta. */
  if (aviso.rfc) bits.push('RFC ' + aviso.rfc);
  if (aviso.vence) bits.push('vence el ' + avisoFecha(aviso.vence));
  if (aviso.baseline) bits.push('línea base (histórico)');
  bits.push('desde el ' + avisoFecha(aviso.creado));
  return bits.join(' · ');
}
/* Nombre visible de quién lleva el aviso (sistema-visual §6): el
   responsable se VE como texto («Lo lleva: la contadora»), nunca como
   selector en la cara de la tarjeta. El valor guardado sigue siendo
   'Paco' o 'Contadora' (el servidor solo acepta esos dos). */
function avisoResponsableLabel(aviso) {
  return aviso.responsable === 'Contadora' ? 'la contadora' : (aviso.responsable || 'Paco');
}
function avisoPill(aviso) {
  if (aviso.estado === 'por-confirmar') return statusPill('warn', 'Por confirmar');
  if (aviso.severidad === 'alta') return statusPill('bad', 'Importante');
  if (aviso.severidad === 'baja') return statusPill('dim', 'Menor');
  return statusPill('warn', 'Atención');
}
/* Pantalla propia del Centro. */
function avisosScreen() {
  const wrap = n('div');
  if (!avisosDisponibles()) {
    wrap.append(panel('Centro de Avisos', 'El Centro vive en el servidor de tu casa (el NAS), donde corre el motor de avisos. Abre PacoSAT desde el servidor para verlo; en esta copia local puedes seguir trabajando con tus facturas en Dinero.'));
    return [wrap];
  }
  if (!avisosCache) {
    /* Esqueleto de carga (1.25.0): bloques neutros con la forma de
       las tarjetas, no un párrafo de texto — como Hoy y Cobertura. */
    const loading = panel('Centro de Avisos', 'Consultando el servidor…');
    const skel = n('div', undefined, 'skel');
    skel.setAttribute('aria-busy', 'true');
    skel.setAttribute('aria-label', 'Cargando los avisos');
    for (let i = 0; i < 3; i++) skel.append(n('div', undefined, 'skel-block'));
    loading.append(skel);
    wrap.append(loading);
    refreshAvisos(true);
    return [wrap];
  }
  const data = avisosCache;
  /* Filtro por RFC propio (1.9.0): con varios RFC, cada quien ve
     solo lo suyo sin abrir cada tarjeta. */
  const rfcsConAvisos = Object.keys(data.porRfc || {});
  /* Regla de contribuyente (1.23.0, D4): Avisos tampoco mezcla
     RFC — sin filtro elegido manda el contribuyente seleccionado
     (scope), y la opción «Todos los RFC» desaparece del filtro. */
  if (!avisosRfcFiltro && scope && rfcsConAvisos.includes(scope)) avisosRfcFiltro = scope;
  if (avisosRfcFiltro && !rfcsConAvisos.includes(avisosRfcFiltro))
    avisosRfcFiltro = rfcsConAvisos.includes(scope) ? scope : (rfcsConAvisos[0] || '');
  const visiblesPorRfc = aviso => !avisosRfcFiltro || aviso.rfc === avisosRfcFiltro;
  avisosVisibles = data.avisos.filter(visiblesPorRfc).map(aviso => aviso.id);
  for (const id of [...avisosSeleccion]) if (!avisosVisibles.includes(id)) avisosSeleccion.delete(id);
  if (!data.counts.total) {
    /* Estado vacío bueno en grande (sistema-visual §5): frase grande +
       píldora ok. Nada de tres contadores a cero que parecen botones.
       El panel del correo-resumen ya no vive aquí (va en Ajustes vía
       avisosMailSection()). */
    const resumen = panel('Tus avisos');
    const bueno = n('div', undefined, 'empty');
    const buenoTitulo = n('h3', 'Todo en orden. No tienes avisos.');
    buenoTitulo.style.fontSize = '26px';
    bueno.append(statusPill('ok', 'Todo en orden'),
      buenoTitulo,
      n('p', 'Cuando algo necesite tu atención aparecerá aquí.'));
    const update = n('button', 'Actualizar ahora', 'soft small');
    update.onclick = () => refreshAvisos(true);
    bueno.append(update);
    resumen.append(bueno);
    wrap.append(resumen);
  } else {
    /* Resumen por clases: las tres categorías se conservan como
       agrupación cuando SÍ hay avisos. */
    const resumen = panel('Tus avisos', data.counts.total
      ? number.format(data.counts.total) + ' abiertos. Los de «línea base» son la foto inicial de tu histórico: están en el panel, sin correos ni atrasos retroactivos.'
      : 'Sin avisos abiertos. Todo en orden.');
    if (rfcsConAvisos.length > 1) {
      const filtro = n('div', undefined, 'filters');
      const picker = select(rfcsConAvisos.map(rfc => [rfc, 'RFC ' + rfc + ' (' + data.porRfc[rfc] + ')']),
        avisosRfcFiltro, 'Filtrar avisos por RFC');
      picker.onchange = () => { avisosRfcFiltro = picker.value; render(); };
      filtro.append(picker);
      resumen.append(filtro);
    }
    const strip = n('div', undefined, 'traffic-strip');
    for (const [clase, etiqueta] of AVISOS_CLASES)
      strip.append(statusPill(data.counts[clase] ? (clase === 'mal' ? 'bad' : 'warn') : 'ok',
        etiqueta + ': ' + number.format(data.counts[clase] || 0)));
    const update = n('button', 'Actualizar ahora', 'soft small');
    update.onclick = () => refreshAvisos(true);
    strip.append(update);
    resumen.append(strip);
    /* Barra por lote: selección múltiple sobre los avisos visibles. */
    resumen.append(avisosBatchBar());
    wrap.append(resumen);
    let algunaSeccion = false;
    /* Agrupados por causa raíz (1.25.0, mejora nº 2): el servidor
       marca los avisos que comparten causa (grupo) y la sección
       enseña UNA tarjeta de grupo con el total y sus comprobantes
       dentro, desplegables — las acciones de cada uno quedan en
       su tarjeta, como siempre. */
    const gruposPorClave = new Map((data.grupos || []).map(grupo => [grupo.clave, grupo]));
    const porId = new Map(data.avisos.map(aviso => [aviso.id, aviso]));
    const gruposPintados = new Set();
    for (const [clase, etiqueta, icono] of AVISOS_CLASES) {
      const deClase = data.avisos.filter(aviso => aviso.clase === clase && visiblesPorRfc(aviso));
      if (!deClase.length) continue;
      algunaSeccion = true;
      const section = panel(etiqueta + ' (' + number.format(deClase.length) + ')');
      for (const aviso of deClase) {
        const grupo = aviso.grupo ? gruposPorClave.get(aviso.grupo) : null;
        if (grupo) {
          if (gruposPintados.has(grupo.clave)) continue;
          gruposPintados.add(grupo.clave);
          section.append(avisoGrupoCard(grupo, grupo.miembros.map(id => porId.get(id)).filter(Boolean)));
        } else section.append(avisoCard(aviso));
      }
      wrap.append(section);
    }
    if (!algunaSeccion && avisosRfcFiltro) {
      const sinFiltro = panel('Tus avisos');
      sinFiltro.append(n('p', 'Con este filtro no hay avisos de ese RFC. Quita el filtro para verlos todos.', 'muted'));
      wrap.append(sinFiltro);
    }
  }
  if (data.historial.length) {
    const history = panel('Historial · ya solventado', 'Lo que se corrigió queda registrado aquí, con su nota.');
    for (const aviso of data.historial) {
      const row = n('div', undefined, 'cp-row');
      row.append(statusPill('ok', '✓ ' + avisoFecha(aviso.resuelto)),
        n('span', aviso.titulo + (aviso.resolucion ? ' — ' + aviso.resolucion : '')));
      /* Reabrir, editar el cierre y ver la bitácora (1.18.0): el
         historial deja de ser una lista muerta; un error de dedo
         tiene vuelta atrás y cada aviso cuenta su historia. */
      const acts = n('div', undefined, 'actions');
      acts.append(action('Reabrir', async () => {
        await satApi('notices/reopen', { id: aviso.id });
        await avisoAfterChange('Aviso reabierto: vuelve a estar en tus pendientes.');
      }, 'soft'));
      if (aviso.kind === 'saldo') acts.append(action('Editar cierre', () => avisoHistorialEditar(aviso), 'soft'));
      const logBox = n('div'); logBox.hidden = true;
      acts.append(action('Bitácora', async () => {
        if (!logBox.hidden) { logBox.hidden = true; return; }
        logBox.hidden = false;
        logBox.replaceChildren(n('p', 'Leyendo la bitácora…', 'muted'));
        try {
          const data = await satApi('notices/log?id=' + aviso.id);
          logBox.replaceChildren(...(data.log || []).map(entry =>
            n('p', avisoFecha(entry.at) + ' · ' + entry.nota, 'muted')));
          if (!data.log?.length) logBox.append(n('p', 'Sin movimientos registrados.', 'muted'));
        } catch (error) { logBox.replaceChildren(n('p', error.message, 'error-text')); }
      }, 'soft'));
      row.append(acts);
      history.append(row, logBox);
    }
    wrap.append(history);
  }
  return [wrap];
}
/* Panel de configuración del correo-resumen (1.11.0): SALE de la
   pantalla Avisos y pasa a Ajustes. Contrato: avisosMailSection(config?)
   devuelve UN nodo (el panel <section> listo para incrustar); si no se
   pasa config, usa la última conocida (avisosCache.config) o el valor
   por defecto del servidor (diario, 9 h). Guardar sigue llamando a
   POST notices/config, igual que antes. La etiqueta del campo ya no
   repite el título del panel (la auditoría vio «Correo-resumen»
   duplicado y pegado): título, estado y explicación van separados. */
function avisosMailSection(config) {
  const cfg = config || avisosCache?.config || { correo: 'diario', hora: 9 };
  const el = panel('Correo-resumen');
  const intro = n('div', undefined, 'portal');
  const estadoRow = n('div', undefined, 'traffic-strip');
  estadoRow.append(statusPill(cfg.correo === 'no' ? 'dim' : 'ok', cfg.correo === 'no' ? 'Desactivado' : 'Activado'));
  intro.append(estadoRow,
    n('p', 'Los avisos no llegan de uno en uno: como mucho, un solo correo con el resumen. El detalle completo vive en Avisos.'));
  el.append(intro);
  const form = n('div', undefined, 'sat-form');
  const correo = n('select');
  correo.setAttribute('aria-label', 'Cada cuánto quieres el resumen por correo');
  for (const [value, label] of [['diario', 'Un resumen cada día'], ['semanal', 'Un resumen cada lunes'], ['graves', 'Solo cuando haya algo importante'], ['no', 'Sin correo (solo el panel)']]) {
    const option = n('option', label); option.value = value;
    if (cfg.correo === value) option.selected = true;
    correo.append(option);
  }
  const hora = input('number', { min: '0', max: '23', value: String(cfg.hora ?? 9) });
  const save = n('button', 'Guardar', 'soft');
  save.onclick = async () => {
    try {
      const saved = await satApi('notices/config', { correo: correo.value, hora: Number(hora.value) });
      if (avisosCache) avisosCache.config = saved;
      toast('Preferencia del correo-resumen guardada.', 'ok');
    } catch (error) { toast(error.message, 'error'); }
  };
  form.append(fieldWrap('¿Cada cuánto quieres el resumen?', correo), fieldWrap('Hora de envío', hora), save);
  el.append(form);
  return el;
}
/* Barra de acciones por lote: casilla «seleccionar visibles», conteo
   y las tres acciones. Antes de aplicar, confirmación con el conteo;
   al terminar, el servidor reporta aplicados y saltados. */
function avisosBatchBar() {
  const bar = n('div', undefined, 'traffic-strip');
  const selLabel = n('label', ' Seleccionar visibles');
  const selAll = input('checkbox', { 'aria-label': 'Seleccionar los avisos visibles' });
  selAll.id = 'avisos-batch-all';
  selAll.checked = avisosVisibles.length > 0 && avisosVisibles.every(id => avisosSeleccion.has(id));
  selAll.onchange = () => {
    if (selAll.checked) for (const id of avisosVisibles) avisosSeleccion.add(id);
    else for (const id of avisosVisibles) avisosSeleccion.delete(id);
    paintAvisosBatch();
  };
  selLabel.prepend(selAll);
  const count = n('span', '', 'muted');
  count.id = 'avisos-batch-count';
  const paid = n('button', 'Marcar pagadas', 'primary small');
  paid.id = 'avisos-batch-paid';
  paid.onclick = () => avisoBatch('pagadas');
  const close = n('button', 'Cerrar', 'soft small');
  close.id = 'avisos-batch-close';
  close.onclick = () => avisoBatch('cerrar');
  const discard = n('button', 'Borrar', 'danger-soft small');
  discard.id = 'avisos-batch-discard';
  discard.onclick = () => avisoBatch('borrar');
  bar.append(selLabel, count, paid, close, discard);
  setTimeout(paintAvisosBatch, 0);
  return bar;
}
function paintAvisosBatch() {
  const count = $('avisos-batch-count');
  if (!count) return;
  const elegidos = avisosSeleccion.size;
  count.textContent = elegidos ? number.format(elegidos) + ' seleccionado' + (elegidos === 1 ? '' : 's') : 'Ninguno seleccionado';
  for (const id of ['avisos-batch-paid', 'avisos-batch-close', 'avisos-batch-discard']) {
    const btn = $(id);
    if (btn) btn.disabled = !elegidos;
  }
  const all = $('avisos-batch-all');
  if (all) all.checked = avisosVisibles.length > 0 && avisosVisibles.every(id => avisosSeleccion.has(id));
  document.querySelectorAll('.aviso-check').forEach(el => { el.checked = avisosSeleccion.has(Number(el.dataset.avisoId)); });
}
function avisoBatch(accion) {
  const ids = [...avisosSeleccion];
  if (!ids.length) return;
  const textos = {
    pagadas: ['Marcar pagadas', '¿Marcar pagadas ' + number.format(ids.length) + ' avisos? Solo se aplica a los avisos de saldo; los demás se saltan y al terminar te digo cuántos fueron.', 'Marcar pagadas'],
    cerrar: ['Cerrar avisos', '¿Cerrar ' + number.format(ids.length) + ' avisos? Quedan en el historial como cerrados por ti, sin re-comprobación.', 'Cerrar avisos'],
    borrar: ['Borrar avisos', '¿Borrar ' + number.format(ids.length) + ' avisos? Dejan de aparecer y no vuelven a salir; el descarte queda registrado en la bitácora.', 'Borrar avisos']
  };
  const [titulo, texto, boton] = textos[accion];
  dialog(titulo, [n('p', texto)], async () => {
    try {
      const result = await satApi('notices/batch', { ids, accion });
      avisosSeleccion.clear();
      avisosCache = result;
      avisosFetchedAt = Date.now();
      paintAvisosBadge(result.counts.total);
      toast('Lote terminado: ' + number.format(result.aplicados) + ' aplicados, ' + number.format(result.saltados) + ' saltados.', 'ok');
      soundCue('success');
      render();
    } catch (error) { toast(error.message, 'error'); }
  }, boton);
}
/* Tarjeta de grupo (1.25.0, mejora nº 2): una sola causa con N
   comprobantes — el titular dice la causa y el total; dentro,
   cada comprobante con su tarjeta y sus acciones de siempre. */
function avisoGrupoCard(grupo, miembros) {
  const card = n('div', undefined, 'aviso-card');
  const head = n('div', undefined, 'aviso-head');
  const primero = miembros[0] || {};
  head.append(avisoPill(primero), n('strong',
    number.format(grupo.cuenta) + ' avisos de la misma causa' +
    (grupo.nombre ? ' · ' + grupo.nombre : '')));
  card.append(head);
  card.append(n('p', 'La misma causa se repite en ' + number.format(grupo.cuenta) + ' comprobantes' +
    (grupo.importeTotal && grupo.importeTotal !== '0.00' ? ': en total $' + money(grupo.importeTotal) : '') +
    '. Ábrelos para ver cada uno con su siguiente paso.', 'muted'));
  const detalle = n('div');
  detalle.hidden = true;
  for (const aviso of miembros) detalle.append(avisoCard(aviso));
  const toggle = n('button', 'Ver los ' + number.format(grupo.cuenta) + ' comprobantes', 'soft small');
  toggle.onclick = () => {
    detalle.hidden = !detalle.hidden;
    toggle.textContent = detalle.hidden ? 'Ver los ' + number.format(grupo.cuenta) + ' comprobantes' : 'Ocultar los comprobantes';
  };
  card.append(toggle, detalle);
  return card;
}
/* Recordatorio de cobro (1.25.0, AGREGAR 5): nace un BORRADOR
   desde el aviso; Paco revisa texto y destino y SOLO su toque
   en «Enviar recordatorio» lo manda. Nada sale al prepararlo. */
function avisoRecordatorio(aviso) {
  (async () => {
    try {
      const data = await satApi('reminders/draft', { ref: aviso.ref });
      const borrador = data.reminder;
      const destino = input('email', { value: borrador.destino || '', placeholder: 'correo@cliente.mx' });
      const asunto = input('text', { value: borrador.asunto || '' });
      const cuerpo = n('textarea');
      cuerpo.value = borrador.cuerpo || '';
      cuerpo.rows = 9;
      dialog('Recordatorio de cobro — borrador', [
        n('p', 'Esto es un BORRADOR: no se ha enviado nada. Revisa el texto y el correo del cliente; solo saldrá cuando pulses «Enviar recordatorio».'),
        field('Correo del cliente', destino), field('Asunto', asunto), field('Texto', cuerpo)],
      async () => {
        try {
          check(/^\S+@\S+\.\S+$/.test(destino.value.trim()), 'Escribe el correo del cliente.');
          await satApi('reminders/send', { id: borrador.id, to: destino.value.trim(),
            asunto: asunto.value, cuerpo: cuerpo.value });
          toast('Recordatorio enviado a ' + destino.value.trim() + '.', 'ok');
          soundCue('success');
        } catch (error) { toast(error.message, 'error'); }
      }, 'Enviar recordatorio');
    } catch (error) { toast(error.message, 'error'); }
  })();
}
function avisoCard(aviso) {
  const card = n('div', undefined, 'aviso-card');
  const head = n('div', undefined, 'aviso-head');
  const check = input('checkbox', { 'aria-label': 'Seleccionar este aviso' });
  check.classList.add('aviso-check');
  check.dataset.avisoId = String(aviso.id);
  check.checked = avisosSeleccion.has(aviso.id);
  check.onchange = () => {
    if (check.checked) avisosSeleccion.add(aviso.id); else avisosSeleccion.delete(aviso.id);
    paintAvisosBatch();
  };
  head.append(check, avisoPill(aviso), n('strong', aviso.titulo));
  card.append(head);
  if (aviso.detalle) card.append(n('p', aviso.detalle));
  card.append(n('p', avisoMeta(aviso), 'muted'));
  /* Siguiente paso (1.9.0): la tarjeta dice qué toca hacer. Quién lo
     lleva se VE como texto en la línea de gestiones (1.11.0). */
  if (aviso.accion) card.append(n('p', 'Siguiente paso: ' + aviso.accion, 'aviso-next'));
  /* UNA acción principal, a la derecha (sistema-visual §4): en un aviso
     de saldo es «Ya se pagó» de un toque; en una solicitud de estado,
     subir el estado; en el resto, «Ya lo corregí». */
  const mainRow = n('div', undefined, 'traffic-strip');
  mainRow.style.justifyContent = 'flex-end';
  /* Gestiones en segunda línea discreta: nunca compiten con la acción
     principal ni llevan selectores en la cara de la tarjeta. */
  const gestiones = n('div', undefined, 'traffic-strip');
  gestiones.append(n('span', 'Lo lleva: ' + avisoResponsableLabel(aviso), 'muted'));
  const cambiarResp = n('button', 'Cambiar', 'soft small');
  cambiarResp.onclick = () => avisoCambiarResponsable(aviso);
  gestiones.append(cambiarResp);
  if (aviso.kind === 'saldo') {
    const paid = n('button', 'Ya se pagó', 'primary');
    paid.onclick = () => avisoMarkPaid(aviso, card, paid);
    mainRow.append(paid);
    /* Recordatorio de cobro como borrador (1.25.0, AGREGAR 5):
       solo en saldos POR COBRAR — es al cliente a quien se le
       recuerda, nunca a un proveedor. */
    if (aviso.direccion === 'cobrar') {
      const reminder = n('button', 'Recordatorio de cobro', 'soft small');
      reminder.onclick = () => avisoRecordatorio(aviso);
      gestiones.append(reminder);
    }
    if (aviso.estado === 'por-confirmar') {
      const no = n('button', 'Aún no', 'soft small');
      no.onclick = () => avisoConfirmNo(aviso);
      gestiones.append(no);
    } else {
      const fixed = n('button', 'Ya lo corregí', 'soft small');
      fixed.onclick = () => avisoResolve(aviso);
      gestiones.append(fixed);
    }
  } else if (aviso.kind === 'solicitud-estado') {
    mainRow.append(avisoUploadButton(aviso));
    const fixed = n('button', 'Ya lo corregí', 'soft small');
    fixed.onclick = () => avisoResolve(aviso);
    gestiones.append(fixed);
  } else {
    const fixed = n('button', 'Ya lo corregí', 'primary');
    fixed.onclick = () => avisoResolve(aviso);
    mainRow.append(fixed);
  }
  const enlace = AVISOS_ENLACES[aviso.enlace];
  if (enlace) {
    const go = n('button', enlace[1], 'soft small');
    go.onclick = () => navigate(enlace[0]);
    gestiones.append(go);
  }
  if (mainRow.childNodes.length) card.append(mainRow);
  card.append(gestiones);
  return card;
}
/* Cambiar quién lleva el aviso (1.11.0): el selector vive en este
   diálogo discreto — el «detalle» del aviso —, no en la cara de la
   tarjeta. Reutiliza POST notices/responsable, como antes. */
function avisoCambiarResponsable(aviso) {
  const picker = select([['Paco', 'Paco'], ['Contadora', 'La contadora']], aviso.responsable || 'Paco', 'Quién lleva el aviso');
  dialog('¿Quién lo lleva?',
    [n('p', 'Ahora lo lleva: ' + avisoResponsableLabel(aviso) + '. Cámbialo si lo va a resolver la otra persona.'),
     field('Lo lleva', picker)],
    async () => {
      avisosCache = await satApi('notices/responsable', { id: aviso.id, responsable: picker.value });
      avisosFetchedAt = Date.now();
      toast('Ahora lo lleva: ' + (picker.value === 'Contadora' ? 'la contadora' : picker.value) + '.', 'ok');
      render();
    }, 'Guardar');
}
async function avisoAfterChange(message) {
  toast(message, 'ok');
  soundCue('success');
  await refreshAvisos(true);
  render();
}
/* «Ya se pagó» de UN TOQUE (flujos §3.3, regla de Paco 9 nov 21:02):
   sin diálogo, sin campo «Fecha del pago», sin nota. Se llama al mismo
   cierre que ya acepta el servidor — POST notices/answer con
   respuesta 'si' y NADA más — y la fecha de hoy la anota la bitácora
   sola. La confirmación es breve («Pagado. Quedó en el historial.»)
   y desde la 1.18.0 trae «Deshacer»: el servidor ya sabe reabrir un
   aviso solventado (notices/reopen), así que un error de dedo se
   corrige sin salir de la pantalla. */
async function avisoMarkPaid(aviso, card, button) {
  /* Instantáneo (1.23.0, D2): al toque, la tarjeta se marca
     solventada EN EL SITIO (optimista) y la petición sale detrás;
     los conteos se refrescan desde GET /api/notices en segundo
     plano y el aviso sale de la lista sin recargar a mano. Si la
     respuesta se pierde o la red falla, se RE-LEE /api/notices:
     si el aviso ya consta solventado se mantiene el estado y se
     dice «Quedó marcado como pagado»; solo si la re-lectura PRUEBA que no
     se aplicó se revierte lo optimista y se enseña el error.
     Nunca se reintenta la escritura a ciegas. */
  if (button) { button.disabled = true; button.textContent = 'Registrando…'; }
  if (card) card.replaceChildren(statusPill('ok', 'Pagado'), n('span', 'Registrando el pago…'));
  const confirmar = mensaje => {
    toastUndo(mensaje, async () => {
      await satApi('notices/reopen', { id: aviso.id });
      announce('Pago deshecho: el aviso vuelve a estar abierto.');
      await refreshAvisos(true);
      render();
    });
    soundCue('success');
    avisosCache = null;
    refreshAvisos(true).catch(() => {});
  };
  try {
    const result = await satApiGuardar('notices/answer', { id: aviso.id, respuesta: 'si' }, async () => {
      const data = await satApi('notices');
      return (data.historial || []).some(item => item.id === aviso.id);
    });
    confirmar(result?.aplicadoTrasError ? 'Quedó marcado como pagado. Quedó en el historial.' : 'Pagado. Quedó en el historial.');
  } catch (error) {
    let aplicado = false;
    try {
      const data = await satApi('notices');
      aplicado = (data.historial || []).some(item => item.id === aviso.id);
      if (aplicado) { avisosCache = data; avisosFetchedAt = Date.now(); paintAvisosBadge(data.counts.total); }
    } catch { /* sin re-lectura posible: manda el error original */ }
    if (aplicado) { confirmar('Quedó marcado como pagado. Quedó en el historial.'); return; }
    toast(error.message, 'error');
    if (page === 'avisos') render(); /* revierte lo optimista repintando desde el servidor */
  }
}
/* (El alias avisoMarkPaidDialog de la 1.11.0 se retiró en la
   1.18.0: ningún llamador lo usa; la acción es avisoMarkPaid.) */
/* Edición posterior de un cierre ya hecho (flujos §3.3, paso 3):
   preparada en la 1.11.0 y CONECTADA en la 1.18.0 al endpoint del
   servidor notices/edit-close, que reescribe la nota del pago
   manual sin tocar el estado del aviso. */
function avisoHistorialEditar(aviso) {
  const nota = input('text', { placeholder: 'Ej. Pagado con Konfío el 8 de noviembre' });
  const fecha = input('date', {});
  dialog('Editar el cierre',
    [n('p', 'Añade una nota o cambia la fecha del pago de «' + aviso.titulo + '». Es opcional y posterior: el aviso ya quedó cerrado con un toque.'),
     field('Fecha del pago', fecha), field('Nota', nota)],
    async () => {
      await satApi('notices/edit-close', { id: aviso.id, nota: nota.value.trim(), fecha: fecha.value });
      await avisoAfterChange('Cierre actualizado en el historial.');
    }, 'Guardar');
}
function avisoConfirmNo(aviso) {
  dialog('Confirmar',
    [n('p', aviso.direccion === 'cobrar'
      ? 'Confirmas que ' + (aviso.nombre || 'la contraparte') + ' aún NO ha pagado. El aviso pasará a «Lo que está mal» como saldo vencido: en PacoSAT no consta el pago.'
      : 'Confirmas que aún NO se ha pagado. El aviso pasará a «Lo que está mal» como saldo vencido: en PacoSAT no consta el pago.')],
    async () => {
      await satApiGuardar('notices/answer', { id: aviso.id, respuesta: 'no' }, async () => {
        const data = await satApi('notices');
        const actual = (data.avisos || []).find(item => item.id === aviso.id);
        return !actual || actual.estado !== 'por-confirmar';
      });
      await avisoAfterChange('Aviso de atraso creado en «Lo que está mal».');
    }, 'Sí, aún no');
}
async function avisoResolve(aviso) {
  try {
    const result = await satApi('notices/resolve', { id: aviso.id });
    if (result.ok) { await avisoAfterChange('Comprobado: ya está bien. Aviso cerrado y guardado en el historial.'); return; }
    dialog('Todavía falta algo',
      [n('p', 'PacoSAT lo volvió a comprobar y aún no está solventado:'),
       n('p', result.falta || 'La condición del aviso sigue presente.', 'error-text'),
       n('p', 'Cuando lo corrijas, vuelve a pulsar «Ya lo corregí» y lo verificamos otra vez.')],
      async () => {}, 'Entendido');
  } catch (error) { toast(error.message, 'error'); }
}
/* Solicitud interna (criterio 8): el estado que falta se sube AQUÍ, en
   la propia tarjeta; al aportarlo se procesa y el aviso se solventa. */
function avisoUploadButton(aviso) {
  const holder = n('span');
  const btn = n('button', 'Subir el estado aquí', 'primary small');
  btn.onclick = async () => {
    try {
      const banks = await satApi('banks');
      const solicitud = aviso.solicitud || {};
      const account = (banks.accounts || []).find(row =>
        row.bank.toLocaleLowerCase('es-MX') === String(solicitud.banco || '').toLocaleLowerCase('es-MX') &&
        (row.missing || []).includes(solicitud.mes));
      check(account, 'No encontré la cuenta de ' + (solicitud.banco || 'ese banco') + ' con ese mes faltante: súbelo desde Bancos.');
      const form = n('div', undefined, 'sat-form');
      const file = input('file', { accept: 'application/pdf' });
      const up = n('button', 'Subir y procesar', 'primary small');
      up.onclick = async () => {
        try {
          check(file.files?.[0], 'Elige el PDF del estado de cuenta.');
          activityStart('Procesando el estado de ' + solicitud.banco + ' de ' + solicitud.mes, 1);
          const content = encode64(new Uint8Array(await file.files[0].arrayBuffer()));
          await satApi('banks/statements', { accountId: account.id, month: solicitud.mes, content });
          activityProgress(1, 'Estado archivado y leído.');
          activityDone('✓ Estado recibido', ['El estado de ' + solicitud.banco + ' de ' + solicitud.mes + ' quedó archivado y leído. Los avisos que dependían de él se re-comprueban solos.']);
          await avisoAfterChange('Estado aportado: la solicitud se solventó.');
        } catch (error) { activityFail('No se pudo procesar el estado', error.message); toast(error.message, 'error'); }
      };
      form.append(fieldWrap('PDF del estado · ' + solicitud.mes, file), up);
      holder.replaceChildren(form);
    } catch (error) { toast(error.message, 'error'); }
  };
  holder.append(btn);
  return holder;
}
