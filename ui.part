/* Mapa ÚNICO de pantallas (1.11.0): los 9 destinos del menú más
   Preguntas (vive en la barra superior). Título, frase de para qué
   (la tarea, no el sistema) y acción principal con verbo + objeto.
   Las vistas absorbidas no tienen entrada: navigate() las traduce
   al destino y la pestaña/sección que les corresponde (VIEW_ALIASES),
   así ningún enlace interno viejo se rompe y ninguna función se
   pierde (tabla de correspondencia de flujos.md §1). */
const screens = {
  home: ['Hoy', 'Cómo amanece todo: qué hizo el sistema, qué falta y qué vence.', 'Importar XML / ZIP'],
  avisos: ['Avisos', 'Lo que está mal, lo que falta y lo que el sistema necesita de ti.', 'Revisar avisos ahora'],
  buzon: ['Buzón', 'Lo nuevo que llegó a tu expediente: CFDI y documentos recientes, leídos y sin leer.', 'Marcar todo leído'],
  tributario: ['Buzón Tributario', 'Las notificaciones del SAT para este RFC: PacoSAT las lista sin abrir ninguna.', 'Consultar ahora'],
  invoices: ['Facturas', 'Todos tus CFDI: emitidos y recibidos, su estado en el SAT y su PDF, en una sola tabla.', 'Importar XML / ZIP'],
  docs: ['Documentos', 'Tu expediente por RFC: constancia, opinión, declaraciones, acuses y PDF archivados, con «Ver» de un clic.', 'Archivar PDF'],
  dinero: ['Dinero', 'Cuánto debes, cuánto te deben y qué ya se movió.', 'Abrir Cierre y reportes'],
  pagos: ['Pagos al banco', 'Prepara los pagos del mes en tres pasos y llévate las tablas para el banco.', 'Preparar los pagos'],
  sat: ['SAT', 'Descarga tus facturas, tu constancia y tus declaraciones del SAT.', 'Importar paquete'],
  salidas: ['Cierre y reportes', 'Cierra el mes paso a paso, mira qué vence y prepara lo de tu contadora.', 'Exportación completa'],
  settings: ['Ajustes', 'Contribuyentes y e.firma, correo, respaldos, sin conexión, estado del sistema y acerca de.', 'Guardar ajustes'],
  preguntas: ['Preguntas', 'Pregunta en lenguaje normal y la respuesta sale de tus datos locales, sin enviar nada fuera.', 'Preguntar']
};
/* Vistas de la 1.10.x → destino nuevo (y su pestaña o sección). */
const VIEW_ALIASES = {
  visor: ['invoices'],
  operations: ['settings', 'sistema'],
  backup: ['settings', 'respaldos'],
  offline: ['settings', 'sinconexion'],
  capacidades: ['settings', 'acerca'],
  monitor: ['sat', 'estado'],
  lists: ['sat', 'listas'],
  coverage: ['sat', 'descargado'],
  cumplimiento: ['salidas', 'calendario'],
  diot: ['salidas', 'diot'],
  bancos: ['dinero', 'bancos']
};
let satTab = 'descargar', dineroTab = 'dinero', cierreSection = 'cierre', ajustesSection = 'general';
const portals = [
  ['Descargar CFDI', 'Consulta emitidos y recibidos y descarga un paquete desde el SAT.', 'https://wwwmat.sat.gob.mx/consultas/42968/consulta-y-recuperacion-de-comprobantes-(nuevo)'],
  ['Constancia y CIF', 'Obtén la constancia de situación fiscal con cédula de identificación.', 'https://www.sat.gob.mx/portal/public/tramites/constancia-de-situacion-fiscal'],
  ['Opinión de cumplimiento', 'Consulta y guarda el PDF de la opinión.', 'https://wwwmat.sat.gob.mx/consultas/20777/consulta-tu-opinion-de-cumplimiento-de-obligaciones-fiscales'],
  ['Declaraciones y acuses', 'Recupera acuses de declaraciones presentadas.', 'https://wwwmatnp.sat.gob.mx/aplicacion/77792/reimprime-tus-acuses-de-declaraciones-presentadas']
];
/* Identidad de la instalación (1.6.6): en modo servidor vive en el
   servidor (tabla settings, sobrevive a reinicios); en modo local se
   guarda en este navegador. applySettings la refleja en la cabecera, el
   acento y el pie; el bloque «Acerca de» y el pie toman versión y sellos
   de PACOSAT_META (generados por build.mjs desde datos reales). */
let appSettings = { installName: '', senderName: '', accent: '', hasLogo: false, logoData: '' };
try {
  const saved = JSON.parse(localStorage.getItem('pacosat-settings') || 'null');
  if (saved && typeof saved === 'object') appSettings = { ...appSettings, ...saved, hasLogo: Boolean(saved.logoData) };
} catch { /* sin almacenamiento local: identidad por defecto */ }
const SETTING_ACCENT_LABELS = { azul: 'Azul', teal: 'Turquesa', violeta: 'Violeta', burdeos: 'Burdeos', ambar: 'Ámbar', rosa: 'Rosa', grafito: 'Grafito' };
function applySettings() {
  const root = document.documentElement;
  if (appSettings.accent) root.dataset.accent = appSettings.accent; else delete root.dataset.accent;
  $('brand-name').textContent = appSettings.installName || 'PacoSAT';
  const logoImg = $('brand-logo'), mark = $('brand-mark');
  if (appSettings.logoData) { logoImg.src = appSettings.logoData; logoImg.hidden = false; mark.style.display = 'none'; }
  else { logoImg.hidden = true; logoImg.removeAttribute('src'); mark.style.display = ''; }
  /* El sello de modificación lo aporta el servidor (la mtime real del
     archivo servido); sin servidor esa parte se omite, no se inventa. */
  const modified = typeof satData !== 'undefined' && satData.buildModified ? new Date(satData.buildModified) : null;
  $('app-footer').textContent = 'PacoSAT ' + PACOSAT_META.version + (modified ? ' · Modificado el ' +
    modified.toLocaleDateString('es-MX', { timeZone: 'America/Mexico_City', day: 'numeric', month: 'long', year: 'numeric' }) +
    ' a las ' + modified.toLocaleTimeString('es-MX', { timeZone: 'America/Mexico_City', hour: '2-digit', minute: '2-digit' }) : '') +
    ' · Creado por Paco Iglesias';
  /* Versión corta junto a la marca (UX-30): visible sin bajar al pie. */
  const sideVersion = $('side-version');
  if (sideVersion) sideVersion.textContent = 'Versión ' + PACOSAT_META.version;
}
let people = [], invoices = [], documents = [], activity = [];
let page = 'home', scope = '', direction = 'Todos', docFilter = '', term = '', month = '', invoicePage = 0;
/* El mes de Pagos vive en el núcleo (1.24.0): la parte de Pagos
   se carga bajo demanda, pero el Centro de mando pone el mes
   ANTES de navegar — si la declaración viviera en la parte, la
   asignación llegaría antes que su «let» y rompería. El resto
   del estado de Pagos sigue en su parte. */
let pagosMes = '';
let docTerm = '', docPage = 0, lastImport = null;
const invoiceSelection = new Set();
let invoiceKind = '', invoiceOrder = 'recent', invoiceState = '', invoicePayState = '';
let submit, importing = false, ready = false;
const number = new Intl.NumberFormat('es-MX');
const scopes = () => new Map(people.map(person => [person.id, person.name]));
const matches = invoice => {
  const known = scopes();
  return (scope ? [scope] : [...known.keys()]).some(id => id === invoice.from.rfc || id === invoice.to.rfc);
};
const roles = row => {
  const known = scopes();
  return { issued: scope ? row.from.rfc === scope : known.has(row.from.rfc), received: scope ? row.to.rfc === scope : known.has(row.to.rfc) };
};
function dateLabel(date) {
  if (date.length < 10) return date;
  return date.slice(8, 10) + '/' + date.slice(5, 7) + '/' + date.slice(0, 4);
}
/* 'AAAA-MM-DD HH:MM:SS' → 'dd/mm/aaaa hh:mm': un solo formato humano
   en todo lo visible (UX-25). */
function stampLabel(stamp) {
  if (!stamp || stamp.length < 16) return stamp || '';
  return stamp.slice(8, 10) + '/' + stamp.slice(5, 7) + '/' + stamp.slice(0, 4) + ' ' + stamp.slice(11, 16);
}
function amount(row) {
  const [integer, decimals] = row.total.split('.');
  return number.format(BigInt(integer)) + (decimals ? '.' + decimals : '.00') + (row.currency ? ' ' + row.currency : '');
}
/* Clave «AAAA-MM» del mes anterior: el valor por defecto de los
   selectores de mes de Cumplimiento y de Bancos. Se llamaba desde la
   1.6.18 y nunca se definió (hotfix 1.7.3). */
function previousMonthKey() {
  const now = new Date();
  const previous = new Date(now.getFullYear(), now.getMonth() - 1, 1);
  return previous.getFullYear() + '-' + String(previous.getMonth() + 1).padStart(2, '0');
}
/* Un importe suelto, ya en texto («1234.56»), con el mismo formato
   que amount() pero sin fila ni moneda: lo que piden Listas (la
   exposición de cada contraparte) y el Centro de salidas. Se llamaba
   desde la 1.6.13 y nunca se definió (hotfix 1.7.3). */
function money(value) {
  const [integer, decimals] = String(value ?? '0').split('.');
  return number.format(BigInt(integer || '0')) + (decimals ? '.' + decimals : '.00');
}
// Tema y sonidos de la interfaz (1.6.0): persistentes en este navegador.
const prefGet = key => { try { return localStorage.getItem(key); } catch { return null; } };
const prefSet = (key, value) => { try { localStorage.setItem(key, value); } catch { /* Sin almacenamiento, la preferencia dura la sesión. */ } };
const themeIsDark = () => document.documentElement.dataset.theme === 'dark' ||
  (!document.documentElement.dataset.theme && typeof matchMedia !== 'undefined' && matchMedia('(prefers-color-scheme: dark)').matches);
function applyTheme() {
  const saved = prefGet('pacosat-theme');
  if (saved === 'dark' || saved === 'light') document.documentElement.dataset.theme = saved;
  else delete document.documentElement.dataset.theme;
  const button = $('theme-toggle');
  if (button) { button.replaceChildren(icon(themeIsDark() ? 'sun' : 'moon')); button.setAttribute('aria-pressed', String(themeIsDark())); }
  /* La pestaña del sistema sigue al tema (1.26.0): antes el meta
     quedaba fijo en el azul marino claro aun en modo oscuro. */
  const metaTheme = document.querySelector('meta[name="theme-color"]');
  if (metaTheme) metaTheme.setAttribute('content', themeIsDark() ? '#060d18' : '#0e2a47');
}
let soundOn = prefGet('pacosat-sound') !== 'off';
let audioCtx = null;
function ensureAudio() {
  if (!soundOn) return null;
  try {
    audioCtx = audioCtx || new (window.AudioContext || window.webkitAudioContext)();
    if (audioCtx.state === 'suspended') void audioCtx.resume();
    return audioCtx;
  } catch { return null; }
}
function tone(frequency, start, duration, type = 'sine', gain = 0.055) {
  const ctx = ensureAudio();
  if (!ctx) return;
  const osc = ctx.createOscillator(), amp = ctx.createGain();
  const at = ctx.currentTime + start;
  osc.type = type; osc.frequency.value = frequency;
  amp.gain.setValueAtTime(0, at);
  amp.gain.linearRampToValueAtTime(gain, at + 0.012);
  amp.gain.exponentialRampToValueAtTime(0.0001, at + duration);
  osc.connect(amp); amp.connect(ctx.destination);
  osc.start(at); osc.stop(at + duration + 0.05);
}
/* Sonidos por evento (1.6.11): además del interruptor general de la
   cabecera, cada tipo de aviso se puede silenciar por separado en
   Ajustes. La preferencia vive en este navegador. */
const soundEventOn = kind => {
  try { return JSON.parse(prefGet('pacosat-sound-events') || '{}')[kind] !== false; }
  catch { return true; }
};
function soundCue(kind) {
  if (!soundOn || !soundEventOn(kind)) return;
  if (kind === 'success') { tone(659, 0, 0.13); tone(880, 0.1, 0.2); }
  else if (kind === 'error') tone(196, 0, 0.22, 'triangle', 0.075);
  else if (kind === 'alert') { tone(880, 0, 0.12); tone(880, 0.18, 0.12); }
  else tone(740, 0, 0.11);
}
function initPrefs() {
  applyTheme();
  const soundButton = $('sound-toggle');
  if (soundButton) {
    const paint = () => { soundButton.replaceChildren(icon(soundOn ? 'volume' : 'mute')); soundButton.setAttribute('aria-pressed', String(soundOn)); };
    paint();
    soundButton.onclick = () => { soundOn = !soundOn; prefSet('pacosat-sound', soundOn ? 'on' : 'off'); paint(); if (soundOn) soundCue('notice'); };
  }
  const themeButton = $('theme-toggle');
  if (themeButton) themeButton.onclick = () => { prefSet('pacosat-theme', themeIsDark() ? 'light' : 'dark'); applyTheme(); };
  /* Preguntas vive en la barra superior (1.11.0): icono global, no
     destino de menú. */
  const askButton = $('ask-button');
  if (askButton) askButton.onclick = () => navigate('preguntas');
  /* «Más» del móvil: abre la columna completa como hoja. */
  const moreButton = $('more-button');
  if (moreButton) moreButton.onclick = () => {
    const frame = document.querySelector('.frame');
    if (frame) frame.classList.toggle('sheet-open');
  };
  const unlock = () => { if (soundOn) ensureAudio(); };
  window.addEventListener('pointerdown', unlock, { once: true });
  window.addEventListener('keydown', unlock, { once: true });
}
initPrefs();
let newsCount = 0;
function computeNews() {
  try {
    const last = Number(localStorage.getItem('pacosat-last-visit') || 0);
    newsCount = last ? activity.filter(row => Date.parse(row.date) > last).length : 0;
    localStorage.setItem('pacosat-last-visit', String(Date.now()));
  } catch { newsCount = 0; }
  const badge = $('news-badge');
  if (badge) { badge.hidden = !newsCount; badge.textContent = newsCount ? number.format(newsCount) : ''; }
}
function totalCents(row) {
  const [integer, decimals = ''] = String(row.total).split('.');
  const padded = (decimals + '000').slice(0, 3);
  return BigInt(integer) * 100n + BigInt(padded.slice(0, 2)) + (padded[2] >= '5' ? 1n : 0n);
}
const centsPlain = cents => (cents / 100n).toString() + '.' + String(cents % 100n).padStart(2, '0');
function centsLabel(cents) {
  return number.format(cents / 100n) + '.' + String(cents % 100n).padStart(2, '0');
}
/* Nombre legible de una divisa verdadera (pieza 3): se nombra
   por su código, nunca como «otra moneda» genérica. */
const CURRENCY_NAMES = { USD: 'dólares USD', EUR: 'euros EUR', GBP: 'libras GBP', CAD: 'dólares CAD' };
const foreignNote = (foreign, side) => Object.entries(foreign || {})
  .filter(([, slot]) => slot[side] > 0)
  .map(([code, slot]) => slot[side] + ' en ' + (CURRENCY_NAMES[code] || code) + ', sin sumar a los pesos').join(' · ');
const rowCancelled = row => fiscalResults.get(row.id)?.sat?.state === 'Cancelado';
function monthlyTotals() {
  const groups = new Map();
  for (const person of people) {
    if (scope && person.id !== scope) continue;
    const months = new Map();
    for (const row of invoices) {
      const received = row.to.rfc === person.id, issued = row.from.rfc === person.id;
      if (!received && !issued) continue;
      const key = row.date.slice(0, 7);
      if (!months.has(key)) months.set(key, { received: 0, receivedCents: 0n, issued: 0, issuedCents: 0n,
        cancelled: 0, rep: 0, nomina: 0, foreign: {} });
      const group = months.get(key);
      /* N2 + pieza 3 (1.22.0): EL criterio del servidor, también
         aquí — las CANCELADAS no suman (van en su propia línea),
         los complementos de pago (clase P: llevan Moneda «XXX»
         por norma del CFDI y total 0) NO son «otra moneda» ni
         facturas que contar como emitidas/recibidas, la nómina
         (clase N) va aparte, y una divisa VERDADERA se agrupa
         por su código y jamás se suma a los pesos. Sin divisa
         verdadera, no hay nota alguna. */
      if (rowCancelled(row)) { group.cancelled++; continue; }
      if (row.kind === 'P') { group.rep++; continue; }
      if (row.kind === 'N') { group.nomina++; continue; }
      const currency = (row.currency || 'MXN').toUpperCase();
      if (currency !== 'MXN') {
        const slot = group.foreign[currency] || (group.foreign[currency] = { received: 0, issued: 0 });
        if (received) slot.received++;
        if (issued) slot.issued++;
        continue;
      }
      if (received) { group.received++; group.receivedCents += totalCents(row); }
      if (issued) { group.issued++; group.issuedCents += totalCents(row); }
    }
    if (months.size) groups.set(person.id, { name: person.name, months: [...months.entries()].sort((a, b) => b[0].localeCompare(a[0])) });
  }
  return groups;
}
function totalsPanel() {
  const totals = monthlyTotals();
  const wrap = panel('Totales por RFC y mes');
  if (!totals.size) {
    wrap.append(empty('Sin comprobantes todavía', 'Los totales por contribuyente y mes aparecerán al importar o sincronizar CFDI.'));
    return wrap;
  }
  wrap.querySelector('.panel-head').append(action('Exportar totales CSV', exportTotalsCsv, 'metric-link', 'down'),
    action('Reporte mensual', reportDialog, 'metric-link', 'print'),
    action('Paquete mensual', monthlyPackageDialog, 'metric-link', 'box'));
  const rows = [];
  let truncated = false;
  for (const [rfc, group] of totals) {
    if (group.months.length > 12) truncated = true;
    for (const [monthKey, g] of group.months.slice(0, 12)) rows.push([
      cell(group.name, rfc), monthKey.slice(5, 7) + '/' + monthKey.slice(0, 4),
      number.format(g.received), cell(centsLabel(g.receivedCents), foreignNote(g.foreign, 'received')),
      number.format(g.issued), cell(centsLabel(g.issuedCents),
        [foreignNote(g.foreign, 'issued'),
          g.rep ? g.rep + ' complemento(s) de pago (no son facturas en otra moneda)' : '',
          g.cancelled ? g.cancelled + ' cancelada(s), fuera de los totales' : '',
          g.nomina ? g.nomina + ' de nómina, aparte' : ''].filter(Boolean).join(' · '))
    ]);
  }
  wrap.append(grid(['Contribuyente', 'Mes', 'Recibidos', 'Importe recibidos', 'Emitidos', 'Importe emitidos'], rows));
  wrap.append(n('p', 'Importes en MXN sumados al centavo.' + (truncated ? ' Se muestran los últimos 12 meses por RFC; la exportación CSV incluye todos.' : '')));
  return wrap;
}
function reportDialog() {
  const months = [...new Set([...monthlyTotals().values()].flatMap(group => group.months.map(([key]) => key)))].sort().reverse();
  check(months.length, 'Todavía no hay totales para reportar.');
  const monthSel = select(months.map(key => [key, key.slice(5, 7) + '/' + key.slice(0, 4)]), months[0], 'Mes del reporte');
  dialog('Reporte mensual por RFC', [n('p', 'Vista para imprimir o guardar en PDF del mes elegido. Respeta el contribuyente seleccionado en el selector principal; sin selección, incluye a todos.'),
    field('Mes', monthSel)], () => printMonthlyReport(monthSel.value), 'Generar e imprimir');
}
function printMonthlyReport(key) {
  const section = $('print-report');
  section.replaceChildren();
  const head = n('div', undefined, 'report-head');
  if (appSettings.logoData) {
    const logo = n('img', undefined, 'report-logo');
    logo.src = appSettings.logoData;
    logo.alt = '';
    head.append(logo);
  }
  head.append(n('div', (appSettings.installName || 'PacoSAT') + ' · REPORTE MENSUAL', 'hero-kicker'), n('h1', 'Reporte mensual ' + key.slice(5, 7) + '/' + key.slice(0, 4)),
    n('p', (scope ? (scopes().get(scope) || scope) + ' · ' + scope : 'Todos los contribuyentes') + ' · Generado el ' + localDateTime(Date.now()), 'report-meta'));
  section.append(head);
  const rows = [];
  for (const [rfc, group] of monthlyTotals()) {
    const found = group.months.find(([monthKey]) => monthKey === key);
    if (!found) continue;
    const g = found[1];
    rows.push([group.name + ' (' + rfc + ')', number.format(g.received), '$' + centsLabel(g.receivedCents),
      number.format(g.issued), '$' + centsLabel(g.issuedCents)]);
  }
  const tableWrap = n('div');
  tableWrap.append(grid(['Contribuyente', 'Recibidos', 'Importe recibidos MXN', 'Emitidos', 'Importe emitidos MXN'],
    rows.length ? rows : [['Sin comprobantes en el mes', '', '', '', '']]));
  section.append(tableWrap);
  /* Detalle comprobante a comprobante del mes (UX-23): el reporte para
     la contadora lista cada CFDI, no solo los totales. */
  const detail = invoices.filter(row => row.date.startsWith(key) && matches(row));
  if (detail.length) {
    section.append(n('h3', 'Comprobantes del mes'));
    const detailWrap = n('div');
    detailWrap.append(grid(['Fecha', 'UUID', 'Emisor → receptor', 'Tipo', 'Total'],
      detail.map(row => [dateLabel(row.date), row.id, (row.from.name || row.from.rfc) + ' → ' + (row.to.name || row.to.rfc),
        KINDS[row.kind], amount(row)])));
    section.append(detailWrap);
  }
  let checked = 0, cancelled = 0, efosHits = 0;
  for (const row of invoices) {
    if (!row.date.startsWith(key) || !matches(row)) continue;
    const item = fiscalResults.get(row.id);
    if (item?.sat) { checked++; if (item.sat.state === 'Cancelado') cancelled++; }
    if (item?.efos?.length) efosHits++;
  }
  section.append(n('p', 'Vigilancia según la última consulta disponible en esta sesión: ' + checked + ' CFDI del mes consultados al SAT, ' +
    cancelled + ' cancelados y ' + efosHits + ' con coincidencia 69-B. Si la vigilancia no ha corrido, estos conteos quedan parciales.', 'report-note'));
  section.append(n('p', 'Importes en MXN sumados al centavo desde el total de cada CFDI (sin canceladas); las divisas verdaderas se cuentan por su código y no se suman a los pesos, y los complementos de pago (Moneda «XXX» por norma, total 0) no son facturas en otra moneda. Documento de trabajo generado por PacoSAT, no una declaración.', 'report-note'));
  section.append(reportFoot(scope));
  setTimeout(() => window.print(), 80);
}
/* Pie de documento impreso (1.26.0, Ronda Visual): todo informe
   que sale en papel cierra con quién lo emite, para qué RFC y
   cuándo — la diferencia entre una captura y un documento; la
   paginación la pone la regla @page de la hoja. */
function reportFoot(rfc) {
  const foot = n('div', undefined, 'report-foot');
  foot.append(n('span', (appSettings.installName || 'PacoSAT') + ' · Expediente fiscal'),
    n('span', (rfc || scope || 'Todos los contribuyentes') + ' · ' +
      new Date().toLocaleDateString('es-MX', { dateStyle: 'long' })));
  return foot;
}
/* Paquete mensual para la contadora (1.6.5): un ZIP descargable por RFC
   y mes con los totales en CSV, la base DIOT de ese mes en CSV, un
   resumen HTML listo para imprimir/guardar en PDF y el manifiesto.
   Solo descarga del usuario: PacoSAT no envía nada a terceros. */
function monthlyPackageDialog() {
  const totals = monthlyTotals();
  check(totals.size, 'Todavía no hay totales para preparar un paquete.');
  const rfcs = [...totals.keys()];
  const rfcSel = select(rfcs.map(rfc => [rfc, (totals.get(rfc).name || rfc) + ' · ' + rfc]),
    scope && totals.has(scope) ? scope : rfcs[0], 'Contribuyente');
  const monthSel = select([], '', 'Mes');
  const fillMonths = () => {
    monthSel.replaceChildren(...totals.get(rfcSel.value).months.map(([key]) => {
      const option = n('option', key.slice(5, 7) + '/' + key.slice(0, 4));
      option.value = key;
      return option;
    }));
  };
  rfcSel.onchange = fillMonths;
  fillMonths();
  dialog('Paquete mensual para la contadora', [n('p', 'Un ZIP por RFC y mes con: totales en CSV, base DIOT del mes en CSV, resumen imprimible (HTML), el detalle con folio, los XML del mes y el manifiesto con el contenido y la fecha de generación. Se descarga en tu equipo; PacoSAT no lo envía a nadie.'),
    field('Contribuyente', rfcSel), field('Mes', monthSel)], () => buildMonthlyPackage(rfcSel.value, monthSel.value));
  $('save').textContent = 'Preparar y descargar';
}
async function buildMonthlyPackage(rfc, monthKey) {
  const group = monthlyTotals().get(rfc);
  const found = group?.months.find(([key]) => key === monthKey);
  check(found, 'Ese RFC no tiene comprobantes en el mes elegido.');
  const g = found[1];
  const esc = value => {
    const text = String(value);
    const safe = /^[\s\uFEFF]*[=+\-@]|^[\t\r\n]/u.test(text) ? "'" + text : text;
    return '"' + safe.replaceAll('"', '""') + '"';
  };
  const escHtml = text => String(text).replaceAll('&', '&amp;').replaceAll('<', '&lt;').replaceAll('>', '&gt;');
  const totalesCsv = [['RFC', 'Contribuyente', 'Mes', 'Recibidos', 'Importe recibidos MXN', 'Emitidos', 'Importe emitidos MXN', 'Canceladas (fuera de los totales)', 'Complementos de pago'],
    [rfc, group.name, monthKey, g.received, centsPlain(g.receivedCents), g.issued, centsPlain(g.issuedCents), g.cancelled, g.rep]]
    .map(row => row.map(esc).join(',')).join('\r\n');
  const providers = new Map();
  for (const row of invoices) {
    if (row.to.rfc !== rfc || !row.date.startsWith(monthKey)) continue;
    /* N2 también en la DIOT del navegador: sin canceladas, sin
       complementos de pago y sin nómina; la divisa verdadera se
       anota por código y no se suma. */
    if (rowCancelled(row) || row.kind === 'P' || row.kind === 'N') continue;
    if (!providers.has(row.from.rfc)) providers.set(row.from.rfc, { name: row.from.name || '', count: 0, cents: 0n, divisas: {} });
    const provider = providers.get(row.from.rfc);
    const currency = (row.currency || 'MXN').toUpperCase();
    if (currency !== 'MXN') { provider.divisas[currency] = (provider.divisas[currency] || 0) + 1; continue; }
    provider.count++;
    provider.cents += totalCents(row);
    if (!provider.name && row.from.name) provider.name = row.from.name;
  }
  const diotText = [['Mes', 'RFC proveedor', 'Proveedor', 'CFDI recibidos', 'Total MXN', 'En divisa (por código, sin sumar)'],
    ...[...providers].sort((a, b) => a[0].localeCompare(b[0])).map(([providerRfc, provider]) =>
      [monthKey, providerRfc, provider.name, provider.count, centsPlain(provider.cents),
        Object.entries(provider.divisas).map(([code, n]) => n + ' en ' + code).join(' · ')])]
    .map(row => row.map(esc).join(',')).join('\r\n');
  let checked = 0, cancelled = 0, efosHits = 0;
  for (const row of invoices) {
    if (!row.date.startsWith(monthKey) || (row.from.rfc !== rfc && row.to.rfc !== rfc)) continue;
    const item = fiscalResults.get(row.id);
    if (item?.sat) { checked++; if (item.sat.state === 'Cancelado') cancelled++; }
    if (item?.efos?.length) efosHits++;
  }
  const generated = localDateTime(Date.now());
  const resumen = '<!DOCTYPE html>\n<html lang="es"><head><meta charset="utf-8"><title>PacoSAT · Resumen ' + monthKey + ' · ' + escHtml(rfc) + '</title>' +
    '<style>body{font-family:system-ui,sans-serif;margin:32px;color:#17293f}h1{font-size:22px}table{border-collapse:collapse}td,th{border:1px solid #bcccdc;padding:6px 10px;text-align:left}.nota{color:#54687f;font-size:12px}</style></head><body>' +
    '<p>PACOSAT · PAQUETE MENSUAL</p><h1>Resumen ' + monthKey.slice(5, 7) + '/' + monthKey.slice(0, 4) + ' · ' + escHtml(group.name) + ' (' + escHtml(rfc) + ')</h1>' +
    '<table><tr><th>Concepto</th><th>Cantidad</th><th>Importe MXN</th></tr>' +
    '<tr><td>CFDI recibidos</td><td>' + g.received + '</td><td>$' + centsLabel(g.receivedCents) + '</td></tr>' +
    '<tr><td>CFDI emitidos</td><td>' + g.issued + '</td><td>$' + centsLabel(g.issuedCents) + '</td></tr></table>' +
    '<p class="nota">Vigilancia según la última consulta disponible: ' + checked + ' CFDI consultados, ' + cancelled + ' cancelados, ' + efosHits +
    ' con coincidencia 69-B. Importes en MXN sumados al centavo (sin canceladas); las divisas verdaderas se cuentan por su código, sin sumar. Generado el ' + generated +
    ' por PacoSAT. Documento de trabajo, no una declaración.</p></body></html>';
  /* Detalle de los CFDI del mes (UX-23): el paquete incluye el listado
     comprobante a comprobante, no solo los totales. */
  const detailRows = invoices.filter(row => row.date.startsWith(monthKey) && (row.from.rfc === rfc || row.to.rfc === rfc));
  /* Ronda Salidas (1.14.0): el detalle lleva el FOLIO y el paquete
     incluye POR FIN los XML del mes (carpeta xml/): sin ellos la
     contadora no podía timbrar nada contra el papel. Los que no
     tengan XML guardado se cuentan en el manifiesto, no se callan. */
  const detailCsv = [['UUID', 'Folio', 'Fecha', 'Emisor', 'RFC emisor', 'Receptor', 'RFC receptor', 'Tipo', 'Total', 'Moneda'],
    ...detailRows.map(row => [row.id, row.fiscal ? (row.fiscal.series ? row.fiscal.series + '-' : '') + (row.fiscal.folio || '') : '', row.date, row.from.name, row.from.rfc, row.to.name, row.to.rfc, KINDS[row.kind], row.total, row.currency])]
    .map(row => row.map(esc).join(',')).join('\r\n');
  const xmlEntries = [];
  try {
    const files = await readStore('files');
    const byId = new Map(files.map(file => [file.id, file]));
    for (const row of detailRows) {
      const file = byId.get('xml:' + row.id);
      if (file?.blob) xmlEntries.push({ name: 'xml/' + row.id + '.xml', data: new Uint8Array(await file.blob.arrayBuffer()) });
    }
  } catch { /* sin almacén local: el paquete sale sin XML y el manifiesto lo cuenta */ }
  const names = ['totales.csv', 'base-diot.csv', 'resumen.html', 'manifiesto.txt', 'cfdi-del-mes.csv',
    'xml/ · ' + xmlEntries.length + ' XML de los CFDI del mes (' + (detailRows.length - xmlEntries.length) + ' sin XML guardado)'];
  const encoder = new TextEncoder();
  const zip = zipStore([
    { name: names[0], data: encoder.encode('\uFEFF' + totalesCsv) },
    { name: names[1], data: encoder.encode('\uFEFF' + diotText) },
    { name: names[2], data: encoder.encode(resumen) },
    { name: names[4], data: encoder.encode('\uFEFF' + detailCsv) },
    ...xmlEntries,
    { name: names[3], data: encoder.encode(monthlyPackageManifest(rfc, monthKey, names, generated, appSettings.installName)) }
  ]);
  download(zip, 'PacoSAT-' + rfc + '-' + monthKey + '.zip');
  announce('Paquete mensual de ' + rfc + ' (' + monthKey.slice(5, 7) + '/' + monthKey.slice(0, 4) + ') descargado.');
}
function diotGroups() {
  const groups = new Map();
  for (const row of invoices) {
    if (!roles(row).received) continue;
    /* N2: la DIOT tampoco cuenta canceladas, complementos de pago
       ni nómina; la divisa verdadera se cuenta por código aparte. */
    if (rowCancelled(row) || row.kind === 'P' || row.kind === 'N') continue;
    const key = row.date.slice(0, 7) + '|' + row.from.rfc;
    if (!groups.has(key)) groups.set(key, { month: row.date.slice(0, 7), rfc: row.from.rfc, name: row.from.name || '', count: 0, cents: 0n, foreign: 0,
      baseCents: 0n, ivaCents: 0n, withheldCents: 0n, withFiscal: 0 });
    const group = groups.get(key);
    if (row.currency && row.currency !== 'MXN') { group.foreign++; continue; }
    group.count++;
    group.cents += totalCents(row);
    /* Desglose fiscal (1.6.16): valor de actos e IVA por proveedor
       desde el desglose persistido; sin desglose, no se estima nada. */
    const base = invoiceIvaBaseCents(row), iva = invoiceIvaCents(row);
    if (base !== null && iva !== null) {
      group.withFiscal++;
      if (!row.currency || row.currency === 'MXN') {
        group.baseCents += base; group.ivaCents += iva;
        for (const w of row.fiscal.withheld) group.withheldCents += moneyCents(w.amount);
      }
    }
    if (!group.name && row.from.name) group.name = row.from.name;
  }
  return [...groups.values()].sort((a, b) => b.month.localeCompare(a.month) || a.rfc.localeCompare(b.rfc));
}
function diotScreen() {
  const wrap = panel('Totales por proveedor y mes · CFDI recibidos');
  wrap.append(n('p', 'Base de trabajo para la contadora, no la declaración. Suma por RFC emisor y mes el total, el valor de actos y el IVA de los CFDI recibidos' +
    (scope ? ' para ' + scope : ' de todos tus RFC') + '. El desglose sale del XML guardado: si un CFDI aún no tiene desglose, reprocésalo desde Salidas; la DIOT formal sigue requiriendo los ajustes de la contadora.'));
  const rows = diotGroups();
  if (!rows.length) { wrap.append(empty('Sin CFDI recibidos', 'Importa comprobantes recibidos para construir la base por proveedor.')); return [wrap]; }
  wrap.querySelector('.panel-head').append(action('Exportar CSV', exportDiotCsv, 'metric-link', 'down'));
  wrap.append(grid(['Mes', 'RFC proveedor', 'Proveedor', 'CFDI', 'Valor de actos', 'IVA', 'Total MXN'], rows.slice(0, 200).map(group => [
    group.month.slice(5, 7) + '/' + group.month.slice(0, 4), group.rfc, group.name || '—', number.format(group.count),
    group.withFiscal ? '$' + centsLabel(group.baseCents) : 'sin desglose',
    group.withFiscal ? '$' + centsLabel(group.ivaCents) : '—',
    cell('$' + centsLabel(group.cents), group.foreign ? group.foreign + ' en otra moneda sin sumar' : '')
  ])));
  if (rows.length > 200) wrap.append(n('p', 'Se muestran las primeras 200 filas; la exportación CSV incluye todas.'));
  return [wrap];
}
function diotCsv() {
  const escape = value => {
    const text = String(value);
    const safe = /^[\s\uFEFF]*[=+\-@]|^[\t\r\n]/u.test(text) ? "'" + text : text;
    return '"' + safe.replaceAll('"', '""') + '"';
  };
  const rows = [['Mes', 'RFC proveedor', 'Proveedor', 'CFDI recibidos', 'Valor de actos MXN', 'IVA trasladado MXN', 'Retenciones MXN', 'Total MXN', 'CFDI con desglose', 'En otra moneda sin sumar']];
  for (const group of diotGroups()) rows.push([group.month, group.rfc, group.name, group.count, centsPlain(group.baseCents), centsPlain(group.ivaCents), centsPlain(group.withheldCents), centsPlain(group.cents), group.withFiscal, group.foreign]);
  return rows.map(row => row.map(escape).join(',')).join('\r\n');
}
function exportDiotCsv() {
  check(diotGroups().length, 'Sin CFDI recibidos para exportar.');
  download(new Blob(['\uFEFF', diotCsv()], { type: 'text/csv;charset=utf-8' }), 'Base-DIOT-' + (scope || 'todos') + '.csv');
  announce('Base DIOT exportada en CSV.');
}
function monthlyChart() {
  const byMonth = new Map();
  for (const group of monthlyTotals().values()) for (const [key, g] of group.months) {
    if (!byMonth.has(key)) byMonth.set(key, { issued: 0n, received: 0n });
    const entry = byMonth.get(key);
    entry.issued += g.issuedCents; entry.received += g.receivedCents;
  }
  const keys = [...byMonth.keys()].sort().slice(-6);
  const wrap = panel('Totales por mes');
  if (!keys.length) {
    wrap.append(empty('Sin datos para el gráfico', 'Al importar CFDI verás aquí la evolución mensual de emitidos y recibidos.'));
    return wrap;
  }
  const NS = 'http://www.w3.org/2000/svg';
  const svg = document.createElementNS(NS, 'svg');
  svg.setAttribute('viewBox', '0 0 640 238'); svg.setAttribute('class', 'chart'); svg.setAttribute('role', 'img');
  svg.setAttribute('aria-label', 'Gráfico de barras con los importes emitidos y recibidos de los últimos meses');
  const el = (tag, attrs, text) => {
    const node = document.createElementNS(NS, tag);
    for (const [name, value] of Object.entries(attrs || {})) node.setAttribute(name, value);
    if (text) node.textContent = text;
    return node;
  };
  const base = 198, top = 26, height = base - top;
  let max = 0n;
  for (const key of keys) { const entry = byMonth.get(key); if (entry.issued > max) max = entry.issued; if (entry.received > max) max = entry.received; }
  for (const frac of [0.25, 0.5, 0.75, 1]) svg.append(el('line', { x1: 10, x2: 630, y1: base - height * frac, y2: base - height * frac, class: 'grid-line' }));
  svg.append(el('line', { x1: 10, x2: 630, y1: base, y2: base, class: 'grid-line' }));
  const shortMoney = cents => {
    const pesos = Number(cents) / 100;
    return pesos >= 100000 ? '$' + number.format(Math.round(pesos / 1000)) + ' mil' : '$' + centsLabel(cents);
  };
  const slot = 620 / keys.length, barW = Math.min(27, slot / 4.5);
  keys.forEach((key, index) => {
    const entry = byMonth.get(key);
    const center = 10 + slot * index + slot / 2;
    /* Rótulos fuera de la barra y ESCALONADOS por serie (1.11.0):
       emitidos 19 px por encima de su barra, recibidos 5 px; si en
       un mes las dos cifras quedan a menos de 13 px (barras de
       altura parecida), la de recibidos sube lo justo para no
       pisar a la otra — con el tope del gráfico como límite. La
       cifra completa vive siempre en el título de cada barra. */
    const labelY = {};
    for (const [kind, cents] of [['issued', entry.issued], ['received', entry.received]]) {
      if (!cents) continue;
      const h = max ? Math.max(1, Math.round(Number(cents) / Number(max) * height)) : 0;
      labelY[kind] = base - h - (kind === 'issued' ? 19 : 5);
    }
    if (labelY.issued !== undefined && labelY.received !== undefined && Math.abs(labelY.issued - labelY.received) < 13)
      labelY.received = Math.max(11, labelY.issued - 14);
    for (const [kind, cents, offset] of [['issued', entry.issued, -barW - 2], ['received', entry.received, 2]]) {
      const h = max ? Math.max(1, Math.round(Number(cents) / Number(max) * height)) : 0;
      if (cents) {
        const bar = el('rect', { x: center + offset, y: base - h, width: barW, height: h, rx: 3, class: 'bar-' + kind });
        bar.append(el('title', {}, (kind === 'issued' ? 'Emitidos ' : 'Recibidos ') + key + ': $' + centsLabel(cents)));
        svg.append(bar, el('text', { x: center + offset + barW / 2, y: labelY[kind], 'text-anchor': 'middle' }, shortMoney(cents)));
      }
    }
    svg.append(el('text', { x: center, y: base + 18, 'text-anchor': 'middle' }, key.slice(5, 7) + '/' + key.slice(0, 4)));
  });
  const chartWrap = n('div', undefined, 'chart-wrap'); chartWrap.append(svg);
  const legend = n('div', undefined, 'chart-legend');
  const item = (cls, label) => { const span = n('span'); const sw = n('i', undefined, cls); span.append(sw, document.createTextNode(label)); return span; };
  legend.append(item('sw-issued', 'Emitidos'), item('sw-received', 'Recibidos'));
  wrap.append(chartWrap, legend);
  return wrap;
}
function n(tag, text, cls) {
  const el = document.createElement(tag);
  if (text !== undefined) el.textContent = text;
  if (cls) el.className = cls;
  return el;
}
function icon(name) {
  const svg = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
  svg.setAttribute('aria-hidden', 'true');
  const use = document.createElementNS(svg.namespaceURI, 'use');
  use.setAttribute('href', '#i-' + name);
  svg.append(use);
  return svg;
}
function action(label, work, cls, glyph) {
  const button = n('button', label, cls);
  button.type = 'button';
  if (glyph) button.prepend(icon(glyph));
  button.onclick = () => Promise.resolve().then(work).catch(error => announce(error.message, true));
  return button;
}
function announce(message = '', error = false, quiet = false) {
  $('status').textContent = message;
  $('status').hidden = !message;
  $('status').dataset.error = error;
  if (message && error) soundCue('error');
  /* Avisos flotantes (1.26.0, Ronda Visual): la barra #status
     sigue siendo el registro, pero la confirmación también se
     ve donde está el dedo — en una lista larga en el móvil, la
     barra queda fuera de pantalla y el aviso se perdía. quiet
     es para quien flota su propia tarjeta (toastUndo). */
  if (message && !quiet) floatToast(message, error ? 'error' : 'ok');
}
let lastFloat = { text: '', at: 0 };
function floatToast(message, kind = 'ok', undoWork = null) {
  const box = $('toasts');
  if (!box || !message) return null;
  const now = Date.now();
  if (!undoWork && lastFloat.text === message && now - lastFloat.at < 1500) return null;
  lastFloat = { text: message, at: now };
  while (box.children.length >= 3) box.firstChild.remove();
  const card = n('div', undefined, 'toast-card');
  card.dataset.kind = kind;
  card.setAttribute('role', 'status');
  card.append(n('p', message));
  const dismiss = () => { if (card.isConnected) card.remove(); };
  if (undoWork) {
    const undo = n('button', 'Deshacer', 'soft small');
    undo.type = 'button';
    undo.onclick = async () => {
      undo.disabled = true;
      try { await undoWork(); dismiss(); }
      catch (error) { announce(error.message, true); }
    };
    card.append(undo);
  }
  const close = n('button', undefined, 'icon-button toast-close');
  close.type = 'button';
  close.setAttribute('aria-label', 'Cerrar el aviso');
  close.append(icon('close'));
  close.onclick = dismiss;
  card.append(close);
  box.append(card);
  setTimeout(dismiss, undoWork ? 15000 : kind === 'error' ? 9000 : 6000);
  return card;
}
/* toast(): el nombre con el que los fragmentos nuevos (Centro de
   salidas, Dinero, Cumplimiento, Bancos, Constancias…) piden el mismo
   aviso que announce() pinta en la barra de estado. Nunca se definió
   (hotfix 1.7.3): cada llamada moría con «toast is not defined» — lo
   vio Paco en producción — y los catch que avisaban con toast()
   enmascaraban el error verdadero tras ese ReferenceError. El segundo
   argumento es el de las llamadas: 'error' marca el aviso como error
   y cualquier otro valor ('ok') lo deja como aviso normal. */
function toast(message, kind) {
  announce(message, kind === 'error');
}
/* toastUndo(): la acción se aplicó y se puede deshacer un momento
   (1.18.0, «deshacer universal»): el botón vive en la barra de
   estado junto al aviso; si no se toca, la acción queda. */
function toastUndo(message, undoWork) {
  announce(message, false, true);
  const bar = $('status');
  /* El deshacer es UNO (1.26.0): el botón de la barra y el de la
     tarjeta flotante comparten el mismo trabajo protegido — si
     uno lo ejecuta, el otro ya no puede repetirlo. */
  let done = false;
  const run = async () => {
    if (done) return;
    done = true;
    await undoWork();
  };
  const button = n('button', 'Deshacer', 'status-undo');
  button.type = 'button';
  button.onclick = async () => {
    button.disabled = true;
    try { await run(); } catch (error) { announce(error.message, true); }
  };
  bar.append(' ', button);
  floatToast(message, 'ok', run);
  setTimeout(() => { if (button.isConnected && !button.disabled) announce(''); }, 15000);
}
async function logEvent(text) {
  if (!ready) return;
  const entry = { id: crypto.randomUUID(), name: String(text).slice(0, 180), date: new Date().toISOString(),
    added: 0, duplicates: 0, review: 0, issues: [], event: String(text).slice(0, 320) };
  try {
    await writeBatch({ activity: [entry] });
    activity = [entry, ...activity.filter(row => row.id !== entry.id)];
  } catch { /* La bitácora es informativa: nunca debe interrumpir la operación principal. */ }
}
function panel(title) {
  const wrap = n('section', undefined, 'panel');
  if (title) {
    const header = n('div', undefined, 'panel-head');
    header.append(n('h2', title));
    wrap.append(header);
  }
  return wrap;
}
function grid(headers, rows) {
  const wrap = n('div', undefined, 'table-wrap');
  const table = n('table'), head = n('thead'), body = n('tbody'), header = n('tr');
  for (const heading of headers) header.append(n('th', heading));
  head.append(header);
  for (const row of rows) {
    const tr = n('tr');
    for (const [index, cellValue] of row.entries()) {
      const td = n('td');
      /* data-label: en móvil la tabla se vuelve lista de tarjetas y
         cada celda enseña su encabezado (1.18.0). */
      if (headers[index]) td.dataset.label = headers[index];
      if (cellValue instanceof Node) td.append(cellValue);
      else td.textContent = cellValue;
      tr.append(td);
    }
    body.append(tr);
  }
  table.append(head, body); wrap.append(table);
  return wrap;
}
function cell(title, note) {
  const wrap = n('div', title);
  if (note) wrap.append(n('small', note));
  return wrap;
}
function empty(title, message, button) {
  const el = n('div', undefined, 'empty');
  el.append(n('h3', title), n('p', message));
  if (button) el.append(button);
  return el;
}
function select(items, value, label) {
  const input = n('select');
  for (const [id, name] of items) input.append(new Option(name, id));
  input.value = value;
  if (label) input.setAttribute('aria-label', label);
  return input;
}
function field(label, input) {
  const el = n('label', label); el.append(input); return el;
}
/* fieldWrap(): el nombre con el que los fragmentos nuevos (Dinero,
   Cumplimiento, Bancos, invitado) piden este mismo envoltorio de
   etiqueta y control. Se llamaba desde la 1.6.17 y nunca se definió
   (hotfix 1.7.3): es field(), sin duplicar comportamiento. */
const fieldWrap = field;
function input(type, props) { return Object.assign(n('input'), { type }, props); }
function dialog(title, controls, work, confirmLabel) {
  $('dialogTitle').textContent = title;
  $('fields').replaceChildren(...controls);
  $('formError').hidden = true;
  $('save').hidden = !work;
  /* Cada diálogo nombra su acción real (UX-11): «Enviar solicitud»,
     «Autorizar», «Crear respaldo»… no siempre «Guardar». */
  if (work) $('save').textContent = confirmLabel || 'Guardar';
  submit = work;
  $('dialog').showModal();
  /* Ojo en contraseñas (UX-21): todo campo de contraseña de un diálogo
     puede mostrarse u ocultarse sin tener que re-teclearlo. */
  for (const pw of $('fields').querySelectorAll('input[type="password"]')) {
    const eye = n('button', undefined, 'pw-eye');
    eye.type = 'button';
    eye.setAttribute('aria-label', 'Mostrar u ocultar la contraseña');
    eye.append(icon('eye'));
    eye.onclick = () => { pw.type = pw.type === 'password' ? 'text' : 'password'; };
    pw.after(eye);
  }
}
/* Puente de diálogos (hotfix 1.7.3): Bancos (confirmar saldos) y el
   acceso de invitado componen su propio <form class="dialog-form">,
   con su título, sus botones y su onsubmit, y lo muestran con
   showDialog() y lo cierran con closeDialog(); ninguna de las dos
   existía. El formulario propio se aloja en el <dialog> compartido,
   ocultando mientras tanto el formulario integrado, y se retira al
   cerrar — también cuando el diálogo se cierra con Esc —. */
let hostedForm = null;
function showDialog(form) {
  closeDialog();
  hostedForm = form;
  $('form').hidden = true;
  $('dialog').append(form);
  $('dialog').addEventListener('close', () => closeDialog(), { once: true });
  $('dialog').showModal();
}
function closeDialog() {
  if (hostedForm) { hostedForm.remove(); hostedForm = null; }
  $('form').hidden = false;
  if ($('dialog').open) $('dialog').close();
}
function download(blob, name) {
  const url = URL.createObjectURL(blob);
  const link = n('a'); link.href = url; link.download = name;
  document.body.append(link); link.click(); link.remove();
  setTimeout(() => URL.revokeObjectURL(url), 15000);
}
async function refresh(skipRender = false) {
  [people, invoices, documents, activity] = await Promise.all(['people', 'invoices', 'documents', 'activity'].map(store => readStore(store)));
  people.sort((a, b) => a.name.localeCompare(b.name, 'es-MX'));
  invoices.sort((a, b) => b.date.localeCompare(a.date) || a.id.localeCompare(b.id));
  documents.sort((a, b) => b.date.localeCompare(a.date));
  activity.sort((a, b) => b.date.localeCompare(a.date));
  /* Regla de contribuyente (1.23.0, D4): las pantallas de trabajo
     nunca mezclan RFC — la opción «Todos los RFC» desaparece del
     selector global y, si el alcance no es un perfil válido (al
     arrancar viene en ''), manda el PRIMER perfil. El único sitio
     con todos es el directorio de contribuyentes (Ajustes). En
     modo invitado, people ya viene filtrado por su alcance en el
     servidor (gScope): el primer perfil es uno de los suyos. */
  if (!people.some(person => person.id === scope)) scope = people[0]?.id || '';
  const scopeOptions = () => people.length ?
    people.map(p => new Option(p.name + ' · ' + p.id, p.id)) : [new Option('Sin contribuyentes', '')];
  $('scope').replaceChildren(...scopeOptions());
  $('scope').value = scope;
  /* F5: el espejo de la barra superior se puebla y se sincroniza
     con el lateral en cada repintado. */
  const scopeTop = $('scope-top');
  if (scopeTop) {
    scopeTop.replaceChildren(...scopeOptions());
    scopeTop.value = scope;
  }
  prefetchLazyParts();
  if (!skipRender) render();
}
function navigate(view) {
  const alias = VIEW_ALIASES[view];
  if (alias) {
    view = alias[0];
    if (alias[1]) {
      if (view === 'sat') satTab = alias[1];
      else if (view === 'settings') ajustesSection = alias[1];
      else if (view === 'salidas') cierreSection = alias[1];
      else if (view === 'dinero') dineroTab = alias[1];
    }
  }
  page = view;
  /* El resultado de una importación vive en su pantalla (sistema
     visual §5): al cambiar de pantalla se despide solo. */
  const result = $('activity-result');
  if (result) result.hidden = true;
  const frame = document.querySelector('.frame');
  if (frame) frame.classList.remove('sheet-open');
  for (const button of document.querySelectorAll('[data-view]')) {
    if (button.dataset.view === page) button.setAttribute('aria-current', 'page');
    else button.removeAttribute('aria-current');
  }
  render();
}
/* Atajo para otras pantallas: ir a SAT en su pestaña de descarga. */
function showSatDownload() { satTab = 'descargar'; navigate('sat'); }
/* Barra de pestañas/secciones con el patrón único (.tabbar). */
function tabbar(items, current, pick) {
  const bar = n('div', undefined, 'tabbar');
  bar.setAttribute('role', 'tablist');
  for (const [key, label] of items) {
    const button = n('button', label);
    button.type = 'button';
    button.setAttribute('role', 'tab');
    button.setAttribute('aria-selected', String(key === current));
    button.onclick = () => pick(key);
    bar.append(button);
  }
  return bar;
}
/* La acción principal de SAT y de Ajustes depende de la pestaña o
   sección en curso: una sola etiqueta por contexto, siempre con
   verbo + objeto. */
function primaryLabel() {
  if (page === 'sat') return { descargar: 'Importar paquete', estado: 'Revisar mis CFDI ahora', listas: 'Actualizar listados', descargado: 'Actualizar estado' }[satTab] || 'Importar paquete';
  if (page === 'settings') return { general: 'Guardar ajustes', contribuyentes: 'Agregar RFC', correo: 'Guardar el correo', respaldos: 'Crear respaldo', sinconexion: 'Sincronizar ahora', sistema: 'Actualizar estado', acerca: 'Ver la versión' }[ajustesSection] || 'Guardar ajustes';
  if (page === 'salidas') return { cierre: 'Exportación completa', calendario: 'Crear paquete de defensa', diot: 'Exportar CSV', reportes: 'Exportación completa' }[cierreSection] || 'Exportación completa';
  return screens[page][2];
}
/* ===== Carga diferida de pantallas (1.24.0, punto 4b) =====
   Pagos, Bancos (dentro de Dinero) y Reportes (dentro de Cierre)
   viajan en partes que el servidor sirve en /parte/<nombre> y
   que la CSP autoriza por su huella. La primera entrada las
   pide, enseña su «cargando» honesto y pinta al llegar; en
   reposo se precargan solas. Si la parte no llega, la pantalla
   enseña el error con su reintento — nunca un hueco muerto. */
const lazyLoadedParts = new Set(), lazyPartPromises = new Map();
function ensureLazyPart(name) {
  if (lazyLoadedParts.has(name)) return Promise.resolve(true);
  if (lazyPartPromises.has(name)) return lazyPartPromises.get(name);
  const url = typeof PACOSAT_LAZY !== 'undefined' ? PACOSAT_LAZY[name] : null;
  if (!url || typeof fetch !== 'function') return Promise.resolve(false);
  const promise = fetch(url).then(response => {
    if (!response.ok) throw new Error('HTTP ' + response.status);
    return response.text();
  }).then(code => {
    const el = document.createElement('script');
    el.textContent = code;
    document.head.appendChild(el);
    lazyLoadedParts.add(name);
    return true;
  }).catch(() => { lazyPartPromises.delete(name); return false; });
  lazyPartPromises.set(name, promise);
  return promise;
}
function lazyPartForView(view) {
  if (view === 'pagos') return 'pagos';
  if (view === 'salidas' && cierreSection === 'reportes') return 'salidas';
  if (view === 'dinero' && dineroTab === 'bancos') return 'bancos';
  return null;
}
function paintLazyState(name) {
  const [title, description] = screens[page];
  $('title').textContent = title;
  $('crumb').textContent = title;
  $('subtitle').textContent = description;
  const body = $('body');
  const wrap = panel(title);
  const note = n('p', 'Cargando esta pantalla…', 'today-line');
  wrap.append(note);
  body.replaceChildren(wrap);
  ensureLazyPart(name).then(ok => {
    if (lazyPartForView(page) !== name) return;
    if (ok) { render(); return; }
    note.textContent = 'Esta pantalla no se pudo cargar (la parte no llegó del servidor).';
    const retry = n('button', 'Reintentar', 'primary small');
    retry.type = 'button';
    retry.onclick = () => render();
    wrap.append(retry);
  });
}
/* Precarga en reposo: tras el primer pintado, las partes llegan
   sin prisa para que la primera entrada real sea instantánea. */
function prefetchLazyParts() {
  try {
    if (typeof fetch !== 'function' || typeof PACOSAT_LAZY === 'undefined') return;
    const go = () => { for (const name of Object.keys(PACOSAT_LAZY)) ensureLazyPart(name); };
    if (typeof requestIdleCallback === 'function') requestIdleCallback(go, { timeout: 5000 });
    else if (typeof setTimeout === 'function') setTimeout(go, 3500);
  } catch { /* la precarga es un extra: jamás rompe el arranque */ }
}
function render() {
  const lazyName = lazyPartForView(page);
  if (lazyName && !lazyLoadedParts.has(lazyName)) { paintLazyState(lazyName); return; }
  const [title, description] = screens[page];
  $('title').textContent = title;
  $('crumb').textContent = title;
  $('subtitle').textContent = description;
  $('eyebrow').textContent = scope || 'ESPACIO FISCAL';
  const headerCounts = $('counters');
  if (headerCounts) {
    const selectedCount = invoices.filter(matches).length;
    const docsCount = documents.filter(doc => !scope || doc.rfc === scope).length;
    headerCounts.textContent = people.length ?
      number.format(selectedCount) + ' CFDI · ' + number.format(docsCount) + ' PDF · ' + people.length + ' RFC' : '';
  }
  /* Importar vive en Hoy y en Facturas: fuera de ahí, la cabecera no
     lleva «Abrir XML / Factura PDF» (sistema visual §4). */
  const importingHere = page === 'home' || page === 'invoices';
  if ($('inspect')) $('inspect').hidden = !importingHere;
  if ($('pdf-import')) $('pdf-import').hidden = !importingHere;
  $('primary').replaceChildren(icon(page === 'settings' && ajustesSection === 'respaldos' ? 'lock' : page === 'salidas' && cierreSection === 'diot' ? 'down' : 'up'), n('span', primaryLabel()));
  $('primary').disabled = !ready || importing;
  /* El mapa se resuelve con typeof para las pantallas de las
     partes diferidas: nombrar pagosScreen antes de que su parte
     cargue lanzaría ReferenceError incluso pintando otra
     pantalla; la puerta de arriba garantiza que, cuando la
     vista es la suya, la función ya existe. */
  const content = ({ home, avisos: avisosScreen, buzon: buzonScreen, tributario: tributarioScreen, invoices: invoiceScreen, docs: docsView, dinero: dineroView,
    pagos: typeof pagosScreen === 'function' ? pagosScreen : null,
    sat: satView, salidas: cierreView, settings: ajustesView, preguntas: preguntasScreen })[page]();
  for (const el of content) el.classList?.add('view-in');
  $('body').replaceChildren(...content);
  applySettings();
}
/* Píldora de estado común (1.6.11): un solo lenguaje de semáforo en
   toda la app. ok = verde, warn = ámbar, bad = rojo, dim = gris (sin
   dato o en descanso: no es un problema). Pulsarla lleva a su pantalla. */
function statusPill(state, label, hint, onClick) {
  const pill = n('button', undefined, 'status-pill');
  pill.type = 'button';
  pill.dataset.state = state;
  pill.append(n('span', undefined, 'pill-dot'), n('span', label));
  if (hint) pill.title = hint;
  if (onClick) pill.onclick = onClick; else pill.disabled = true;
  return pill;
}
/* Pantalla «Hoy en PacoSAT» (1.6.11): resumen del día, pendientes con
   semáforo y UN siguiente paso sugerido. El interruptor general de
   descanso vive aquí y en el Centro SAT (la misma pieza). */
/* Caché compartida del panel «Hoy» (1.11.0); la invalida el pulso
   cuando detecta cambios en el servidor. */
let todayCache = { at: 0, data: null };
function todayPanel() {
  const wrap = panel();
  const head = n('div', undefined, 'panel-head');
  const titleBox = n('div');
  const nowDate = new Date();
  titleBox.append(n('h2', 'Hoy en PacoSAT'),
    n('p', nowDate.toLocaleDateString('es-MX', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' })));
  head.append(titleBox);
  if (typeof satToken !== 'undefined' && satToken && typeof restSwitch === 'function') head.append(restSwitch());
  wrap.append(head);
  const todayKey = nowDate.getFullYear() + '-' + String(nowDate.getMonth() + 1).padStart(2, '0') + '-' + String(nowDate.getDate()).padStart(2, '0');
  const todays = invoices.filter(row => row.date.startsWith(todayKey));
  let efos = 0, cancelled = 0;
  for (const row of invoices) {
    const state = invoiceStateOf(row);
    if (state === 'efos') efos++; else if (state === 'Cancelado') cancelled++;
  }
  wrap.append(n('p', todays.length ?
    'Hoy se registraron ' + todays.length + (todays.length === 1 ? ' CFDI nuevo.' : ' CFDI nuevos.') :
    'Hoy todavía no se registran CFDI nuevos.', 'today-line'));
  /* «Mientras no estabas» (1.25.0, mejora nº 9): hueco del
     resumen desde la última visita; lo rellena la parte asíncrona
     con el resumen del servidor y su botón de «visto». */
  const digestBox = n('div', undefined, 'mne-box');
  wrap.append(digestBox);
  let step = null;
  if (efos) step = ['Revisar los CFDI con 69-B', 'Un emisor en el listado 69-B puede poner en riesgo la deducción de esos comprobantes.', () => navigate('monitor')];
  else if (cancelled) step = ['Revisar los CFDI cancelados', 'Hay comprobantes cancelados en el SAT: conviene ver cuáles son y si afectan a pagos ya hechos.', () => navigate('monitor')];
  else if (typeof satData !== 'undefined' && satData && (satData.inbox || []).length) step = ['Importar los paquetes del SAT', 'Hay ' + satData.inbox.length + ' paquete(s) descargados esperando importación.', () => navigate('sat')];
  else if (!people.length) step = ['Agregar tu primer RFC', 'Sin contribuyentes no hay expediente: empieza registrando un RFC.', addPerson];
  else if (typeof satData !== 'undefined' && satData && (satData.profiles || []).some(row => !row.unlocked)) step = ['Autorizar la e.firma de los RFC pendientes', 'Sin e.firma activa no hay descarga automática para ese RFC.', () => navigate('sat')];
  /* UN siguiente paso protagonista (1.25.0, mejora nº 3): la
     caja es siempre la misma; lo local la pinta al instante y la
     parte asíncrona la SUSTITUYE si el servidor conoce algo más
     urgente (un crítico, un vencido, tu gesto CIEC en espera). */
  const stepBox = n('div', undefined, 'next-step');
  stepBox.dataset.protagonista = '1';
  if (step) stepBox.append(n('strong', 'Siguiente paso · ' + step[0]), n('p', step[1]), action('Hacerlo ahora', step[2], 'primary', 'arrow'));
  else stepBox.append(n('p', 'Todo en orden: no hay pendientes con semáforo. Buen día.'));
  wrap.append(stepBox);
  /* Transparencia (1.9.0): qué hizo el sistema, qué falta y qué
     vence — sin que Paco tenga que adivinarlo. Se rellena con los
     datos del servidor cuando está disponible. */
  const clarity = n('div', undefined, 'today-clarity');
  const colHizo = n('div', undefined, 'today-col');
  colHizo.append(n('h3', 'Lo que el sistema ya hizo'));
  const colFalta = n('div', undefined, 'today-col');
  colFalta.append(n('h3', 'Lo que falta'));
  const colVence = n('div', undefined, 'today-col');
  colVence.append(n('h3', 'Lo que vence'));
  clarity.append(colHizo, colFalta, colVence);
  wrap.append(clarity);
  const line = (col, text, go) => {
    const row = n('p', text, 'today-line');
    if (go) { const btn = n('button', 'Ver', 'soft small'); btn.onclick = go; row.append(' ', btn); }
    col.append(row);
  };
  (async () => {
    try {
      if (typeof satToken === 'undefined' || !satToken) {
        line(colFalta, 'Abre PacoSAT desde el servidor de tu casa para ver aquí el trabajo del sistema, los pendientes y los vencimientos.');
        return;
      }
      /* Cesión (1.13.0): el panel aún no está insertado cuando
         todayPanel() corre; con la caché de 30 s caliente no había
         ninguna espera antes de pintar y las tres columnas se
         quedaban vacías al volver a Hoy. Se cede el turno y, si el
         panel cambió entre tanto, se pinta en las columnas vivas. */
      await Promise.resolve();
      /* Caché de 30 s en memoria (1.11.0): el panel «Hoy» consume
         lo que el pulso único ya trajo en vez de lanzar sus 4
         llamadas en cada pintado. */
      if (!todayCache.data || Date.now() - todayCache.at > 30000) {
        todayCache = { at: Date.now(), data: await Promise.all([
          satApiLectura('notices').catch(() => null),
          satApiLectura('reconcile').catch(() => null),
          satApiLectura('reports/checklist?month=' + todayKey.slice(0, 7)).catch(() => null),
          satApiLectura('satdocs').catch(() => null),
          satApiLectura('monthly').catch(() => null),
          satApiLectura('activity/digest').catch(() => null)]) };
      }
      const [avisos, reconcile, checklist, satdocs, monthly, digest] = todayCache.data;
      let cHizo = colHizo, cFalta = colFalta, cVence = colVence;
      if (!wrap.isConnected) {
        const vivas = document.querySelectorAll('.today-clarity .today-col');
        if (vivas.length === 3) { cHizo = vivas[0]; cFalta = vivas[1]; cVence = vivas[2]; }
        else return;
      }
      /* Lo que hizo: historial del Centro y conciliaciones vivas. */
      const resueltos = (avisos?.historial || []).filter(item => item.resuelto && String(item.resuelto).startsWith(todayKey));
      line(cHizo, resueltos.length
        ? 'Hoy se solventaron ' + resueltos.length + ' aviso(s): ' + resueltos.slice(0, 2).map(item => item.titulo).join('; ') + (resueltos.length > 2 ? '…' : '') + '.'
        : 'Hoy no se ha cerrado ningún aviso todavía.', () => navigate('avisos'));
      if (reconcile) line(cHizo, 'Conciliaciones confirmadas y vigentes: ' + reconcile.confirmed.length + '.', () => navigate('dinero'));
      const informes = (avisos?.historial || []).filter(item => item.kind === 'informe').length;
      if (informes) line(cHizo, 'Informes mensuales enviados en el historial: ' + informes + '.');
      if (!resueltos.length && !reconcile) line(cHizo, 'Sin actividad registrada hoy: el sistema vigila en silencio.');
      /* Lo que falta: avisos abiertos y pasos del cierre en rojo/ámbar. */
      if (avisos?.counts?.total) line(cFalta, avisos.counts.total + ' aviso(s) abiertos: ' +
        [avisos.counts.mal ? avisos.counts.mal + ' por corregir' : '', avisos.counts.falta ? avisos.counts.falta + ' que faltan' : '',
          avisos.counts.espera ? avisos.counts.espera + ' en espera' : ''].filter(Boolean).join(', ') + '.',
        () => navigate('avisos'));
      else line(cFalta, 'Sin avisos abiertos: nada esperando por ti en el Centro.');
      /* Buzón (1.23.0, frente B): su línea vive siempre, también
         con 0 sin leer (en tono tranquilo: «todo visto»). */
      const buzonN = typeof buzonUnreadFor === 'function' ? buzonUnreadFor(scope) : 0;
      line(cFalta, 'Buzón: ' + number.format(buzonN) + ' sin leer' + (buzonN ? '.' : ': todo visto.'), () => navigate('buzon'));
      if (typeof paintBuzonBadge === 'function') paintBuzonBadge();
      /* Buzón Tributario (1.24.0, punto 1): su línea junto a la
         del Buzón — un toque desde Hoy a su pantalla. */
      const tribN = typeof tribSinAbrirFor === 'function' ? tribSinAbrirFor(scope) : 0;
      const tribConsultado = typeof tribConsultadoFor === 'function' ? tribConsultadoFor(scope) : false;
      const tribTenida = typeof tribTenidaFor === 'function' ? tribTenidaFor(scope) : null;
      line(cFalta, 'Buzón Tributario: ' + (tribConsultado
        ? number.format(tribN) + ' sin abrir' + (tribN
          ? (tribTenida ? ': la más antigua se tiene por notificada el ' + declFechaLarga(tribTenida.tenida) + ' aunque nadie la abra.' : '.')
          : ': todo abierto.')
        : 'sin consultar todavía.'), () => navigate('tributario'));
      if (typeof paintTribBadge === 'function') paintTribBadge();
      if (checklist) {
        const pending = checklist.items.filter(item => item.level !== 'ok');
        line(cFalta, pending.length
          ? 'Cierre de ' + checklist.month + ': faltan ' + pending.map(item => item.label.toLocaleLowerCase('es-MX')).join(', ') + '.'
          : 'Cierre de ' + checklist.month + ': los 10 pasos están en verde.', () => navigate('salidas'));
      }
      /* Lo que vence: avisos con fecha y documentos por caducar. */
      const upcoming = (avisos?.avisos || []).filter(item => item.vence)
        .sort((a, b) => String(a.vence).localeCompare(String(b.vence))).slice(0, 3);
      for (const item of upcoming)
        line(cVence, item.titulo + ' — vence el ' + new Date(item.vence).toLocaleDateString('es-MX', { day: 'numeric', month: 'short' }) +
          (item.responsable ? ' (lo resuelve ' + item.responsable + ')' : '') + '.', () => navigate('avisos'));
      for (const profile of satdocs?.profiles || []) {
        for (const [doc, label] of [[profile.constancia, 'Constancia'], [profile.opinion, 'Opinión']])
          if (doc && doc.level !== 'ok') line(cVence, label + ' de ' + profile.rfc + ': lleva ' + doc.ageDays +
            ' días; toca renovarla.', () => navigate('sat'));
      }
      if (!upcoming.length) line(cVence, 'Sin vencimientos a la vista en los avisos.');
      /* «Mientras no estabas» (1.25.0, mejora nº 9): lo que el
         sistema hizo desde tu última marca de «visto». */
      const digestVivo = document.querySelector('.mne-box');
      if (digestVivo && digest && (digest.eventos > 0 || digest.avisosNuevos > 0)) {
        const card = n('div', undefined, 'next-step');
        const partes = [];
        if (digest.cfdiNuevos) partes.push(digest.cfdiNuevos + ' CFDI nuevos archivados');
        if (digest.avisosNuevos) partes.push(digest.avisosNuevos + ' aviso(s) nuevos' +
          (digest.criticos ? ' — ' + digest.criticos + ' crítico(s)' : ''));
        for (const hecho of (digest.hechos || []).slice(0, 3)) partes.push(hecho.nombre + ' ×' + hecho.n);
        card.append(n('strong', 'Mientras no estabas'),
          n('p', partes.join(' · ') + '.'),
          action('Marcar como visto', async () => {
            try { await satApi('activity/seen', {}); } catch { /* la marca se reintenta al entrar */ }
            card.remove();
          }, 'soft'));
        digestVivo.replaceChildren(card);
      }
      /* El protagonista, por urgencia real (1.25.0, mejora nº 3):
         crítico > vencido > tu gesto CIEC en espera > portal
         cambiado > el por-confirmar más viejo. Sustituye a la
         sugerencia local si el servidor trae algo más urgente. */
      const pasoVivo = document.querySelector('[data-protagonista]');
      if (pasoVivo && avisos) {
        const abiertos = avisos.avisos || [];
        const critico = abiertos.find(item => item.clase === 'mal' && item.severidad === 'alta');
        const vencido = abiertos.filter(item => item.vence && item.vence < Date.now())
          .sort((a, b) => a.vence - b.vence)[0];
        const gesto = (monthly?.runs || []).some(run =>
          Object.values(run.perRfc || {}).some(entry => entry.status === 'esperando-gesto'));
        const portalCambio = typeof satData !== 'undefined' && satData?.portalSalud &&
          (satData.portalSalud.constancia?.cambio || satData.portalSalud.opinion?.cambio);
        const porConfirmar = abiertos.filter(item => item.estado === 'por-confirmar')
          .sort((a, b) => a.creado - b.creado)[0];
        let prota = null;
        if (critico) prota = ['Revisar un aviso crítico', critico.titulo + (critico.accion ? ' — ' + critico.accion + '.' : ''), () => navigate('avisos')];
        else if (vencido) prota = ['Resolver lo vencido', vencido.titulo + (vencido.accion ? ' — ' + vencido.accion + '.' : ''), () => navigate('avisos')];
        else if (gesto) prota = ['Dar tu gesto para la descarga CIEC', 'La corrida mensual quedó esperando tu captcha: el mes se baja desde su tarjeta en el Centro SAT y la corrida retoma su sitio sola.', () => navigate('sat')];
        else if (portalCambio) prota = ['El portal del SAT cambió', 'La sonda lo detectó antes de la corrida: nada que hacer por tu parte; la próxima descarga entra avisada.', () => navigate('avisos')];
        else if (porConfirmar) prota = ['Confirmar un pago', porConfirmar.titulo + (porConfirmar.accion ? ' — ' + porConfirmar.accion + '.' : ''), () => navigate('avisos')];
        if (prota) pasoVivo.replaceChildren(n('strong', 'Siguiente paso · ' + prota[0]),
          n('p', prota[1]), action('Hacerlo ahora', prota[2], 'primary', 'arrow'));
      }
    } catch { /* la transparencia es un extra: nunca rompe el Resumen */ }
  })();
  return wrap;
}
function home() {
  if (!ready) {
    /* Esqueleto de carga (1.6.5): mientras llegan los datos se muestran
       bloques neutros en vez de cifras a medias. */
    const skel = n('div', undefined, 'skel');
    skel.setAttribute('aria-busy', 'true');
    skel.setAttribute('aria-label', 'Cargando el resumen fiscal');
    for (let i = 0; i < 4; i++) skel.append(n('div', undefined, 'skel-block'));
    return [skel];
  }
  const selection = invoices.filter(matches);
  const pdfs = documents.filter(doc => !scope || doc.rfc === scope);
  const banner = n('section', undefined, 'dashboard-hero');
  const copy = n('div');
  /* Héroe en una línea (1.18.0): el RFC y el semáforo general ya
     viven en la tarjeta «Hoy»; aquí solo el nombre y el conteo. */
  copy.append(n('h2', scope ? scopes().get(scope) : 'Tu expediente fiscal'),
    n('p', people.length ? people.length + (people.length === 1 ? ' contribuyente en tu cartera' : ' contribuyentes en tu cartera') : 'Agrega tu primer RFC para abrir un expediente.'));
  const shortcuts = n('div', undefined, 'hero-actions');
  shortcuts.append(people.length ? action('Ver facturas', () => navigate('invoices'), undefined, 'file') : action('Agregar contribuyente', addPerson, undefined, 'plus'),
    action('SAT', () => navigate('sat'), undefined, 'sync'));
  banner.append(copy, shortcuts);
  const metrics = n('div', undefined, 'cards');
  for (const [label, value, glyph, open] of [
    ['CFDI recibidos', selection.filter(row => roles(row).received).length, 'down', () => { direction = 'Recibidos'; invoicePage = 0; navigate('invoices'); }],
    ['CFDI emitidos', selection.filter(row => roles(row).issued).length, 'up', () => { direction = 'Emitidos'; invoicePage = 0; navigate('invoices'); }],
    ['Documentos archivados', pdfs.length, 'folder', () => { docFilter = ''; navigate('docs'); }]
  ]) {
    const card = n('div', undefined, 'metric');
    const name = n('div', label, 'metric-label'); name.prepend(icon(glyph));
    card.append(name, n('strong', number.format(value)), action('Abrir', open, 'metric-link', 'arrow')); metrics.append(card);
  }
  const recent = panel('Últimos comprobantes');
  const latest = selection.slice(0, 5);
  if (latest.length) recent.append(grid(['Emisor', 'Fecha', 'Total', ''], latest.map(row => [
    cell(row.from.name || row.from.rfc, rowRole(row)), dateLabel(row.date), amount(row), action('Ver detalle', () => invoiceDetail(row))
  ])));
  else recent.append(empty('Sin movimientos todavía', 'Las facturas importadas o sincronizadas aparecerán aquí.'));
  const tasks = panel('Contribuyentes');
  const visiblePeople = people.filter(row => !scope || row.id === scope);
  if (!visiblePeople.length) tasks.append(empty('Crea tu primer expediente', 'Agrega un RFC y arrastra aquí los archivos XML o ZIP que ya tengas.', action('Agregar RFC', addPerson, 'primary', 'plus')));
  else {
    const counts = new Map(visiblePeople.map(p => [p.id, [0, 0, 0]]));
    for (const row of invoices) {
      if (counts.has(row.to.rfc)) counts.get(row.to.rfc)[0]++;
      if (counts.has(row.from.rfc)) counts.get(row.from.rfc)[1]++;
    }
    for (const doc of documents) if (counts.has(doc.rfc)) counts.get(doc.rfc)[2]++;
    tasks.append(grid(['Contribuyente', 'Recibidos', 'Emitidos', 'PDF', 'Acción'], visiblePeople.map(p => {
      /* Dos destinos claros (UX-29): «Facturas» va al archivo del RFC y
         «Expedientes» a sus PDF; «Abrir expediente» a secas confundía. */
      const acts = n('div', undefined, 'actions');
      acts.append(action('Facturas', () => { scope = p.id; $('scope').value = scope; invoicePage = 0; navigate('invoices'); }),
        action('Expedientes', () => { scope = p.id; $('scope').value = scope; docFilter = ''; navigate('docs'); }),
        action('Renombrar', () => renamePerson(p)));
      return [cell(p.name, p.id), ...counts.get(p.id).map(value => number.format(value)), acts];
    })));
  }
  const history = panel('Actividad');
  /* Los trabajos del servidor (barridos, descargas, cierres) se
     pintan aquí desde el mismo registro que alimenta el menú y el
     dock: el pulso de actividad rellena este hueco (1.18.0). */
  const sysActivity = n('div'); sysActivity.dataset.sysActivity = '1';
  history.append(sysActivity);
  if (newsCount) history.append(n('p', newsCount === 1 ? '1 novedad desde tu última visita' : number.format(newsCount) + ' novedades desde tu última visita', 'news-note'));
  if (!activity.length) history.append(empty('Sin actividad todavía', 'Aquí verás importaciones, descargas del SAT, respaldos, documentos archivados y cancelaciones detectadas.'));
  else {
    const list = n('div', undefined, 'activity-list');
    let activityIndex = 0;
    for (const row of activity.slice(0, 8)) {
      const item = n('div', undefined, 'activity-item');
      /* Plegado (1.18.0): cuatro a la vista; el resto tras «Ver más». */
      if (activityIndex++ >= 4) { item.hidden = true; item.dataset.folded = '1'; }
      const kind = row.event ? (row.event.startsWith('Cancelación') ? 'alert' : 'event') : (row.name.startsWith('SAT') ? 'sat' : 'import');
      /* Bitácora clicable (1.6.11): cada entrada abre el objeto al que
         se refiere — el CFDI de una cancelación, la pantalla del SAT,
         los respaldos o el archivo de facturas de un lote importado. */
      const uuidMatch = (row.event || '').match(/[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}/);
      const linkedInvoice = uuidMatch ? invoices.find(inv => inv.id === uuidMatch[0].toUpperCase()) : null;
      const openTarget = linkedInvoice ? () => invoiceDetail(linkedInvoice) :
        row.event?.includes('Respaldo') ? () => navigate('backup') :
        kind === 'sat' || row.event?.includes('SAT') ? () => navigate('sat') :
        !row.event ? () => navigate('invoices') : null;
      if (openTarget) {
        item.classList.add('activity-link');
        item.setAttribute('role', 'button');
        item.tabIndex = 0;
        item.onclick = openTarget;
        item.onkeydown = event => { if (event.key === 'Enter' || event.key === ' ') { event.preventDefault(); openTarget(); } };
      }
      const badge = n('span', kind === 'alert' ? 'Alerta' : kind === 'sat' ? 'SAT' : kind === 'event' ? 'Evento' : 'Lote', 'activity-kind');
      badge.dataset.kind = kind;
      const body = n('div', undefined, 'activity-body');
      if (row.event) body.append(n('strong', row.event), n('small', localDateTime(Date.parse(row.date))));
      else {
        body.append(n('strong', row.name),
          n('small', dateLabel(row.date) + ' · ' + row.added + ' nuevos · ' + row.duplicates + ' duplicados' + (row.review ? ' · ' + row.review + ' por revisar' : '')));
        if (row.review) body.append(action('Ver revisión', () => reviewDetail(row), 'metric-link', 'arrow'));
      }
      item.append(badge, body);
      list.append(item);
    }
    history.append(list);
    if (activity.length > 4) {
      const mas = action('Ver más actividad', () => {
        list.querySelectorAll('[data-folded]').forEach(el => { el.hidden = false; });
        mas.remove();
      }, 'quiet');
      history.append(mas);
    }
  }
  const secondary = n('div', undefined, 'dashboard-grid');
  secondary.append(recent, history);
  /* Hoy manda la tarjeta «Hoy» (1.11.0): primero y en grande. Fuera
     el panel de avisos incrustado (su resumen vive en las líneas de
     la propia tarjeta, con enlace a Avisos), fuera la fila de KPI
     que repetía conteos (con ceros sin acción) y fuera los gráficos
     que duplicaban los totales: queda UN gráfico y UNA tabla. */
  const blocks = [todayPanel(), banner, metrics, commandCenter(), monthlyChart()];
  /* Vista Nora (1.25.0, AGREGAR 3): si quien entra es la
     invitada-contadora, su pantalla inicial es su lista del mes
     en solo lectura. La marca la decide el servidor; se consulta
     una vez y, si llega tarde, la pantalla se repinta sola. */
  if (typeof guestMode !== 'undefined' && guestMode) {
    if (noraSesionCache === true) return [noraVistaPanel()];
    if (noraSesionCache === null) {
      noraSesionCache = 'consultando';
      satApi('guest/config').then(cfg => {
        noraSesionCache = Boolean(cfg.sesionContadora);
        if (noraSesionCache && document.querySelector('.dashboard-hero')) render();
      }).catch(() => { noraSesionCache = false; });
    }
  }
  /* Salud del sistema (1.13.0): justo tras el Centro de mando;
     tranquila y pequeña si todo va bien, con el problema y su
     gesto si algo se tuerce. La vieja franja de semáforos
     (trafficStrip) queda retirada: el Centro de mando la absorbe
     con contadores, última actividad y acciones directas. */
  const salud = healthCard();
  if (salud) blocks.splice(4, 0, salud);
  /* Salud del respaldo (1.23.0, frente C): la línea de Hoy con la
     antigüedad real y, si va atrasado o falló, el aviso visible. */
  const respaldoCard = typeof backupHealthCard === 'function' ? backupHealthCard() : null;
  if (respaldoCard) blocks.splice(5, 0, respaldoCard);
  if (lastImport) {
    /* Tarjeta persistente de la última importación (UX-13). */
    const card = panel('Última importación');
    card.append(n('p', lastImport.added + ' nuevos · ' + lastImport.duplicates + ' duplicados · ' + lastImport.review +
      ' por revisar · ' + localDateTime(lastImport.at)));
    const acts = n('div', undefined, 'actions');
    acts.append(action('Ver facturas', () => navigate('invoices'), undefined, 'file'));
    if (lastImport.dupIds.length) acts.append(action('Ver los UUID duplicados', () => {
      dialog('UUID duplicados en la última importación',
        [n('p', 'Estos folios ya estaban en tu expediente y no se importaron dos veces:'), ...lastImport.dupIds.map(id => n('p', id))]);
    }));
    card.append(acts);
    blocks.push(card);
  }
  blocks.push(secondary, tasks, totalsPanel());
  return blocks;
}

const invoiceStateOf = row => {
  const item = fiscalResults.get(row.id);
  if (item?.efos?.length) return 'efos';
  return item?.sat?.state || 'none';
};
/* Estado de pago por fila (del Visor, absorbido en la fusión de
   Facturas de la 1.11.0): el saldo oficial vive en el servidor
   (paidByMap/balanceOf de Dinero); visorMarcados recuerda lo
   marcado en esta sesión. */
const visorMarcados = new Set();
function visorEstadoPago(row, paidBy) {
  if (row.kind !== 'I') return { label: '—', state: 'dim' };
  if (visorMarcados.has(row.id)) return { label: 'Pagada', state: 'ok' };
  const { balance, paid } = balanceOf(row, paidBy);
  if (balance <= 0n) return { label: 'Pagada', state: 'ok' };
  if (paid > 0n) return { label: 'Parcial', state: 'warn' };
  return { label: 'Pendiente', state: 'warn' };
}
function invoiceRows() {
  const needle = term.trim().toLocaleLowerCase('es-MX');
  const known = scopes();
  const paidBy = invoicePayState ? paidByMap() : null;
  const matchScope = row => scope ? row.from.rfc === scope || row.to.rfc === scope : known.has(row.from.rfc) || known.has(row.to.rfc);
  const filtered = invoices.filter(row => matchScope(row) && (!month || row.date.startsWith(month)) && (!invoiceKind || row.kind === invoiceKind) &&
    (!invoiceState || invoiceStateOf(row) === invoiceState) &&
    (!invoicePayState || visorEstadoPago(row, paidBy).label.toLocaleLowerCase('es-MX') === invoicePayState) &&
    (direction === 'Todos' || (direction === 'Recibidos' ? (scope ? row.to.rfc === scope : known.has(row.to.rfc)) : (scope ? row.from.rfc === scope : known.has(row.from.rfc)))) &&
    /* El folio del CFDI entra en la búsqueda (1.18.0): teclear
       «963» encuentra la factura 963, no hace falta el UUID. */
    [row.id, row.from.rfc, row.to.rfc, row.from.name, row.to.name,
      row.fiscal ? ((row.fiscal.serie ? row.fiscal.serie + '-' : '') + (row.fiscal.folio || '')) : '']
      .some(text => String(text).toLocaleLowerCase('es-MX').includes(needle)));
  return invoiceOrder === 'oldest' ? filtered.reverse() : filtered;
}
function rowRole(row) {
  const result = roles(row);
  return result.issued && result.received ? 'Entre mis RFC' : result.issued ? 'Emitido' : 'Recibido';
}
function invoiceScreen() {
  const list = panel();
  const tabs = n('div', undefined, 'tabs');
  for (const title of ['Todos', 'Recibidos', 'Emitidos']) {
    const button = action(title, () => { direction = title; invoicePage = 0; render(); });
    button.setAttribute('aria-pressed', direction === title);
    tabs.append(button);
  }
  const controls = n('div', undefined, 'filters');
  const search = input('search', { value: term, placeholder: 'Buscar nombre, RFC, folio o UUID' });
  search.setAttribute('aria-label', 'Buscar comprobantes');
  const period = input('month', { value: month }); period.setAttribute('aria-label', 'Mes de emisión');
  const type = select([['', 'Todos los tipos'], ...Object.entries(KINDS)], invoiceKind, 'Tipo de CFDI');
  const state = select([['', 'Todos los estados SAT'], ['Vigente', 'Vigente'], ['Cancelado', 'Cancelado'], ['efos', 'Con 69-B'], ['none', 'Sin revisar todavía']], invoiceState, 'Estado SAT');
  const payState = select([['', 'Pagadas y pendientes'], ['pagada', 'Pagadas'], ['pendiente', 'Pendientes'], ['parcial', 'Parciales']], invoicePayState, 'Estado de pago');
  const order = select([['recent', 'Más recientes'], ['oldest', 'Más antiguos']], invoiceOrder, 'Orden');
  const exportButton = action('Exportar CSV', exportCsv, undefined, 'down');
  /* Importar carpeta en 2 toques desde Facturas (1.7.4, pieza 1):
     lee la estructura tipo OneFacture (Emitidos/Recibidos/año/mes) por
     el mismo pipeline que los sueltos, los ZIP y los paquetes SAT. */
  const folderButton = action('Importar carpeta', async () => {
    await requireStorage();
    check(people.length, 'Agrega primero un RFC.');
    if (!importing) $('folder').click();
  }, undefined, 'folder');
  /* Selección múltiple (UX-14): descargar varios XML en un ZIP.
     Ronda Salidas (1.14.0): con servidor, la selección baja como
     ZIP ORDENADO de la capa de salidas (carpetas por sentido y mes,
     cancelados aparte, índice con folio y manifiesto); el ZIP plano
     local queda como ruta sin servidor. */
  const zipButton = action('Descargar seleccionados (ZIP)', async () => {
    check(invoiceSelection.size, 'Selecciona al menos un comprobante.');
    if (satToken) {
      zipButton.disabled = true; zipButton.textContent = 'Preparando el ZIP…';
      try {
        const data = await satApi('salidas/zip', { scope: 'seleccion', rfc: scope, ids: [...invoiceSelection] });
        download(new Blob([decode64(data.content)], { type: 'application/zip' }), data.name);
        announce('ZIP ordenado descargado con ' + invoiceSelection.size + ' comprobantes.');
      } catch (error) { toast(error.message, 'error'); }
      finally { zipButton.disabled = false; zipButton.textContent = 'Descargar seleccionados (ZIP)'; }
      return;
    }
    const entries = [];
    for (const id of invoiceSelection) {
      const file = await readStore('files', 'xml:' + id);
      if (file) entries.push({ name: id + '.xml', data: bytes(await file.blob.arrayBuffer()) });
    }
    check(entries.length, 'Ninguno de los seleccionados tiene XML guardado.');
    download(zipStore(entries), 'CFDI-seleccionados.zip');
    announce(entries.length + ' XML descargados en un ZIP.');
  }, undefined, 'down');
  /* Impresión por lote (1.6.16): todos los seleccionados en un solo
     documento imprimible, cada uno con su representación completa. */
  const printButton = action('Imprimir seleccionados', async () => {
    let printed = 0;
    for (const id of invoiceSelection) {
      const row = invoices.find(item => item.id === id);
      const file = await readStore('files', 'xml:' + id);
      if (!row || !file) continue;
      cfdiPrint(row, parseCfdiFull(bytes(await file.blob.arrayBuffer())), { append: printed > 0, print: false });
      printed++;
    }
    check(printed, 'Ninguno de los seleccionados tiene XML guardado.');
    setTimeout(() => window.print(), 80);
    announce(printed + ' comprobantes listos para imprimir en un solo documento.');
  }, undefined, 'print');
  const chips = n('div', undefined, 'filter-chips');
  const clearFilters = () => {
    term = ''; month = ''; invoiceKind = ''; invoiceState = ''; invoicePayState = ''; direction = 'Todos'; invoicePage = 0; render();
  };
  const result = n('div');
  const update = () => {
    const rows = invoiceRows();
    const paidBy = paidByMap();
    exportButton.disabled = !rows.length;
    zipButton.disabled = !invoiceSelection.size;
    printButton.disabled = !invoiceSelection.size;
    /* Chips de filtros activos con su ✕ (UX-04): lo aplicado se ve y
       se quita sin cazar controles; y «Limpiar filtros» siempre a mano. */
    chips.replaceChildren();
    const activeChips = [];
    if (term) activeChips.push(['«' + term + '»', () => { term = ''; render(); }]);
    if (month) activeChips.push(['Mes ' + month.slice(5, 7) + '/' + month.slice(0, 4), () => { month = ''; render(); }]);
    if (invoiceKind) activeChips.push([KINDS[invoiceKind], () => { invoiceKind = ''; render(); }]);
    if (invoiceState) activeChips.push(['Estado: ' + invoiceState, () => { invoiceState = ''; render(); }]);
    if (direction !== 'Todos') activeChips.push([direction, () => { direction = 'Todos'; render(); }]);
    for (const [label, clear] of activeChips) {
      const chip = n('button', label + ' ✕', 'filter-chip');
      chip.type = 'button';
      chip.onclick = clear;
      chips.append(chip);
    }
    if (activeChips.length) chips.append(action('Limpiar filtros', clearFilters));
    invoicePage = Math.min(invoicePage, Math.max(0, Math.ceil(rows.length / 35) - 1));
    const sliced = rows.slice(invoicePage * 35, (invoicePage + 1) * 35);
    const foot = n('div', undefined, 'table-foot');
    foot.setAttribute('aria-live', 'polite');
    foot.append(n('span', number.format(rows.length) + ' comprobantes'));
    if (rows.length > 35) {
      const options = n('div', undefined, 'actions');
      const prev = action('Anterior', () => { invoicePage--; update(); });
      const next = action('Siguiente', () => { invoicePage++; update(); });
      prev.disabled = invoicePage === 0; next.disabled = (invoicePage + 1) * 35 >= rows.length;
      options.append(prev, n('span', String(invoicePage + 1)), next); foot.append(options);
    }
    const content = sliced.length ? grid(['', 'Emisor → receptor', 'Fecha', 'Folio', 'Tipo', 'Total', 'Estado SAT', 'Acción'], sliced.map(row => {
      const pick = input('checkbox');
      pick.checked = invoiceSelection.has(row.id);
      pick.setAttribute('aria-label', 'Seleccionar el CFDI ' + row.id);
      pick.onchange = () => {
        if (pick.checked) invoiceSelection.add(row.id); else invoiceSelection.delete(row.id);
        zipButton.disabled = !invoiceSelection.size;
    printButton.disabled = !invoiceSelection.size;
      };
      /* Fusión Facturas/Visor (1.11.0): la fila lleva las DOS
         píldoras — estado en el SAT (con su fecha, vía statusCell)
         y estado de pago (Pagada/Parcial/Pendiente, del Visor). */
      const estadoStack = n('div', undefined, 'estado-stack');
      estadoStack.style.display = 'flex';
      estadoStack.style.flexDirection = 'column';
      estadoStack.style.gap = '4px';
      estadoStack.style.alignItems = 'flex-start';
      estadoStack.append(statusCell(row.id));
      if (row.kind === 'I') {
        const pago = visorEstadoPago(row, paidBy);
        estadoStack.append(statusPill(pago.state, pago.label, 'Estado de pago según Dinero'));
      }
      return [pick, cell(row.from.name || row.from.rfc, '→ ' + (row.to.name || row.to.rfc)),
        dateLabel(row.date),
        /* Columna Folio (1.18.0): la factura se nombra por su folio,
           no por el fragmento de UUID. */
        cell(row.fiscal ? ((row.fiscal.serie ? row.fiscal.serie + '-' : '') + (row.fiscal.folio || '')) || '—' : '—', 'Folio'),
        cell(KINDS[row.kind], rowRole(row)), amount(row), estadoStack, invoiceActions(row)];
    })) : empty('Sin coincidencias', 'Importa un lote o cambia los filtros.', action('Limpiar filtros', clearFilters, 'primary'));
    /* En móvil la tabla se vuelve tarjetas (clases card-table). */
    if (content.classList?.contains('table-wrap')) {
      content.classList.add('card-table');
      content.querySelector('table')?.classList.add('grid-table');
    }
    result.replaceChildren(content, foot);
  };
  search.oninput = () => { term = search.value; invoicePage = 0; update(); };
  period.onchange = () => { month = period.value; invoicePage = 0; update(); };
  type.onchange = () => { invoiceKind = type.value; invoicePage = 0; update(); };
  state.onchange = () => { invoiceState = state.value; invoicePage = 0; update(); };
  payState.onchange = () => { invoicePayState = payState.value; invoicePage = 0; update(); };
  order.onchange = () => { invoiceOrder = order.value; invoicePage = 0; update(); };
  controls.append(search, period, type, state, payState, order, exportButton, folderButton, zipButton, printButton);
  /* Si hay CFDI sin revisar, el camino a revisarlos vive en la
     propia tabla (flujos §3.4): un toque y la revisión corre en
     SAT › Estado de mis CFDI. */
  if (invoices.filter(matches).some(row => invoiceStateOf(row) === 'none'))
    /* «Revisar mis CFDI ahora» EJECUTA la revisión (1.18.0): antes
       solo navegaba a Vigilancia. */
    controls.append(action('Revisar mis CFDI ahora', () => monitorCheckNow(), undefined, 'shield'));
  /* Filtros en móvil (1.18.0): panel plegable con «Aplicar» en vez
     de la fila que se salía por la derecha. En escritorio el botón
     no se ve y los filtros van como siempre. */
  controls.classList.add('invoice-filters');
  const applyFilters = action('Aplicar', () => controls.classList.remove('open'), 'filters-apply');
  controls.append(applyFilters);
  const filtersToggle = action('Filtrar', () => controls.classList.toggle('open'), 'filters-toggle');
  list.append(tabs, filtersToggle, controls, chips, result);
  update();
  return [list];
}
function documentScreen() {
  const list = panel('Documentos del expediente');
  const filters = n('div', undefined, 'filters');
  const choice = select([['', 'Todos los documentos'], ...DOCUMENTS.map(x => [x, x])], docFilter, 'Tipo de documento');
  choice.onchange = () => { docFilter = choice.value; docPage = 0; render(); };
  /* Buscador y paginación como en Facturas (UX-16): con cientos de PDF
     ya no toca hacer scroll infinito. */
  const search = input('search', { value: docTerm, placeholder: 'Buscar por nombre o folio fiscal' });
  search.setAttribute('aria-label', 'Buscar documentos');
  search.oninput = () => { docTerm = search.value; docPage = 0; paintDocs(); };
  filters.append(choice, search);
  list.append(filters);
  const result = n('div');
  list.append(result);
  function paintDocs() {
    const needle = docTerm.trim().toLocaleLowerCase('es-MX');
    const rows = documents.filter(doc => (!scope || doc.rfc === scope) && (!docFilter || doc.kind === docFilter) &&
      (!needle || (doc.name + ' ' + (doc.uuid || '')).toLocaleLowerCase('es-MX').includes(needle)));
    docPage = Math.min(docPage, Math.max(0, Math.ceil(rows.length / 35) - 1));
    const sliced = rows.slice(docPage * 35, (docPage + 1) * 35);
    result.replaceChildren();
    if (sliced.length) result.append(grid(['Documento', 'RFC', 'Fecha', 'Periodo', 'Acción'], sliced.map(doc => {
      const acts = n('div', undefined, 'actions');
      acts.append(action('Ver', () => viewDocOnline(doc)));
      if (doc.uuid) acts.append(action('Desvincular', () => unlinkDocument(doc)));
      acts.append(action('Eliminar', () => deleteDocument(doc)));
      return [cell(doc.kind, doc.uuid ? doc.uuid + ' · ' + doc.name : doc.name), doc.rfc, dateLabel(doc.date), doc.period || '—', acts];
    })));
    else result.append(empty('Sin documentos', 'Archiva un PDF o pide tu constancia y tu opinión en las tarjetas de aquí abajo.'));
    const foot = n('div', undefined, 'table-foot');
    foot.append(n('span', number.format(rows.length) + ' documentos'));
    if (rows.length > 35) {
      const options = n('div', undefined, 'actions');
      const prev = action('Anterior', () => { docPage--; paintDocs(); });
      const next = action('Siguiente', () => { docPage++; paintDocs(); });
      prev.disabled = docPage === 0; next.disabled = (docPage + 1) * 35 >= rows.length;
      options.append(prev, n('span', String(docPage + 1)), next);
      foot.append(options);
    }
    result.append(foot);
  }
  paintDocs();
  return [list];
}
function satGuideScreen() {
  const guide = n('section', undefined, 'guide');
  const info = n('div');
  info.append(n('h2', 'Descarga en el SAT e importa en PacoSAT'), n('p', 'Descarga el ZIP en el portal e impórtalo aquí. PacoSAT asigna los XML a los RFC registrados y omite los UUID repetidos. La descarga automática desde el SAT aún no está habilitada.'));
  const options = n('div', undefined, 'actions');
  options.append(action('Elegir ZIP o XML', chooseImport, 'primary', 'up'), action('Importar carpeta', () => {
    check(people.length, 'Agrega primero un RFC.'); $('folder').click();
  }, undefined, 'folder'));
  guide.append(info, options);
  const links = panel('Trámites oficiales');
  for (const [title, summary, url] of portals) {
    const item = n('div', undefined, 'portal');
    const link = n('a', title + ' ↗');
    link.href = url; link.target = '_blank'; link.rel = 'noopener noreferrer';
    item.append(link, n('p', summary)); links.append(item);
  }
  return [guide, links];
}
/* Salud del respaldo (1.23.0, frente C): consume status.backupHealth
   {enabled, lastOk, daysSince, stale, failed, error}. La misma tarjeta
   vive en Hoy y en Ajustes › Respaldos; «Comprobar respaldo ahora»
   llama a POST /api/backup/verify (existe desde la 1.22.0) y pinta
   el resultado EN EL SITIO, sin recargar la pantalla. Ante una
   respuesta perdida se re-lee el estado antes de declarar error. */
function backupHealthCard() {
  if (typeof satToken === 'undefined' || !satToken) return null;
  if (!(typeof satData !== 'undefined' && satData && satData.backupHealth)) return null;
  const wrap = panel('Respaldo');
  const body = n('div', undefined, 'portal');
  const estado = n('p', '', 'today-line');
  const result = n('div');
  const paint = () => {
    const bh = satData.backupHealth || {};
    if (!bh.enabled) estado.textContent = 'Respaldo programado sin activar en el servidor: actívalo para que la copia se haga sola.';
    else if (bh.failed) estado.textContent = '⚠ El último respaldo falló' + (bh.error ? ': ' + bh.error : '.');
    else if (bh.lastOk) {
      const dias = bh.daysSince != null ? Number(bh.daysSince) :
        Math.max(0, Math.floor((Date.now() - (typeof bh.lastOk === 'number' ? bh.lastOk : Date.parse(bh.lastOk))) / 86400000));
      estado.textContent = 'Último respaldo correcto: ' + (dias === 0 ? 'hoy' : 'hace ' + dias + (dias === 1 ? ' día' : ' días')) +
        (bh.stale ? ' — ⚠ va atrasado: toca comprobarlo.' : '.');
    } else estado.textContent = 'Respaldo activado, pero aún no consta ninguno correcto.';
  };
  paint();
  const verify = n('button', 'Comprobar respaldo ahora', 'soft');
  verify.type = 'button';
  verify.onclick = async () => {
    verify.disabled = true; verify.textContent = 'Comprobando…';
    try {
      const data = await satApi('backup/verify', {});
      result.replaceChildren(...(data.results || []).map(item =>
        n('p', (item.ok ? '✓ ' : '✗ ') + item.label + ': ' + item.detail, item.ok ? '' : 'error-text')));
      if (!data.results?.length) result.replaceChildren(n('p', data.ok ? '✓ Respaldo íntegro.' : '✗ La comprobación falló.', data.ok ? '' : 'error-text'));
      toast(data.ok ? 'Respaldo comprobado: íntegro.' : 'La comprobación del respaldo falló.', data.ok ? 'ok' : 'error');
      await pollSat().catch(() => {});
      paint();
    } catch (error) {
      let releido = false;
      try { await pollSat(); releido = Boolean(satData.backupHealth); } catch { /* sin re-lectura posible */ }
      if (releido) {
        paint();
        result.replaceChildren(n('p', 'La respuesta se perdió: arriba ves el estado que el servidor tiene ahora, re-leído antes de darlo por error.', 'muted'));
      } else toast(error.message, 'error');
    } finally { verify.disabled = false; verify.textContent = 'Comprobar respaldo ahora'; }
  };
  /* Ensayo de restauración completo (1.24.0, punto 6): resucita
     el conjunto en una base aislada del servidor y cuenta lo que
     contiene; el resultado se pinta en el sitio, en llano. Vive
     en esta tarjeta —la de Hoy y la de Ajustes › Respaldos— para
     que la prueba quede a un toque desde Hoy y a dos desde
     Ajustes. */
  const restoreResult = n('div');
  const restore = n('button', 'Probar restauración', 'soft');
  restore.type = 'button';
  restore.onclick = async () => {
    restore.disabled = true; restore.textContent = 'Resucitando la copia en un espacio aislado…';
    try {
      const data = await satApi('backup/restore-test', {});
      restoreResult.replaceChildren(n('p', (data.ok ? '✓ ' : '✗ ') + (data.detail || 'Sin detalle.'), data.ok ? '' : 'error-text'));
      toast(data.ok ? 'La copia resucita: el ensayo pasó.' : 'El ensayo de restauración no pasó.', data.ok ? 'ok' : 'error');
    } catch (error) {
      /* Respuesta perdida: el ensayo deja su resultado en el
         estado del respaldo; se re-lee antes de declarar error. */
      let releido = false;
      try { await pollSat(); releido = Boolean(satData.backupHealth); } catch { /* sin re-lectura posible */ }
      if (releido) restoreResult.replaceChildren(n('p', 'La respuesta se perdió: el estado de arriba es el que el servidor tiene ahora, re-leído antes de darlo por error.', 'muted'));
      else toast(error.message, 'error');
    } finally { restore.disabled = false; restore.textContent = 'Probar restauración'; }
  };
  body.append(estado, verify, result, restore, restoreResult);
  wrap.append(body);
  return wrap;
}
/* Cierre de línea base histórica (1.23.0, frente E — acción de
   administrador): primero el cálculo en seco (dryRun) con su
   informe, y solo con confirmación expresa el cierre de verdad.
   No se borra nada: lo cerrado queda en el archivo consultable. */
function baselineClosePanel() {
  const wrap = panel('Cerrar línea base histórica');
  const body = n('div', undefined, 'portal');
  body.append(n('p', 'Cierra los avisos y archiva los comprobantes de los ejercicios ya prescritos (2020 y anteriores), para que dejen de ocupar las pantallas y las colas de trabajo. No se borra nada: todo queda en el archivo, consultable.'));
  const out = n('div');
  const run = n('button', 'Cerrar línea base histórica', 'soft');
  run.type = 'button';
  run.onclick = async () => {
    run.disabled = true; run.textContent = 'Calculando el cierre…';
    try {
      const dry = await satApi('admin/baseline-close', { dryRun: true });
      out.replaceChildren(
        n('p', 'Avisos a cerrar: ' + number.format(dry.avisos?.count || 0) + ' por $' + money(dry.avisos?.sum ?? 0)),
        n('p', 'Comprobantes a archivar: ' + number.format(dry.comprobantes?.count || 0) + ' por $' + money(dry.comprobantes?.sum ?? 0) +
          (dry.comprobantes?.ilegibles ? ' · ' + number.format(dry.comprobantes.ilegibles) + ' ilegibles' : '')),
        n('p', 'Primer ejercicio vivo tras el cierre: ' + (dry.corte?.primerEjercicioVivo || '—')));
      const confirmar = n('button', 'Sí, cerrar la línea base', 'primary small');
      confirmar.type = 'button';
      confirmar.onclick = async () => {
        confirmar.disabled = true; confirmar.textContent = 'Cerrando…';
        try {
          const done = await satApiGuardar('admin/baseline-close', { dryRun: false }, async () => {
            const check = await satApi('admin/baseline-close', { dryRun: true });
            return (check.avisos?.count || 0) === 0 && (check.comprobantes?.count || 0) === 0;
          });
          out.replaceChildren(n('p', '✓ Línea base cerrada' + (done?.aplicadoTrasError ? ' (quedó registrado: la re-lectura lo confirma)' : '') +
            '. Ejecutado: ' + (done.ejecutado === false ? 'no' : 'sí') +
            ' · avisos ' + number.format(done.avisos?.count ?? dry.avisos?.count ?? 0) +
            ' · comprobantes ' + number.format(done.comprobantes?.count ?? dry.comprobantes?.count ?? 0) +
            '. Nada se borró: queda en el archivo.'));
          toast('Línea base histórica cerrada.', 'ok');
          refreshAvisos(true).catch(() => {});
        } catch (error) { toast(error.message, 'error'); confirmar.disabled = false; confirmar.textContent = 'Sí, cerrar la línea base'; }
      };
      out.append(confirmar);
    } catch (error) { toast(error.message, 'error'); }
    finally { run.disabled = false; run.textContent = 'Cerrar línea base histórica'; }
  };
  body.append(run, out);
  wrap.append(body);
  return wrap;
}
/* Login propio de administrador (1.24.0, decisión 2A): enseña el
   estado —configurado o pendiente de que Paco fije su
   contraseña— y, si está configurado, deja entrar y salir desde
   aquí. La contraseña SOLO viaja en el envío del formulario a su
   propio servidor; nunca se guarda en la página. La puerta
   vigente no cambia con esto: el login convive con ella. */
function adminLoginCard() {
  if (typeof satToken === 'undefined' || !satToken) return null;
  const wrap = panel('Login propio de administrador');
  const body = n('div', undefined, 'portal');
  const estado = n('p', '', 'today-line');
  const zona = n('div');
  body.append(estado, zona);
  wrap.append(body);
  const configurado = Boolean(typeof satData !== 'undefined' && satData && satData.adminLogin && satData.adminLogin.configurado);
  if (!configurado) {
    estado.textContent = 'Pendiente de que fijes tu contraseña en la configuración del servidor (la carpeta protegida pacosat-secrets): sin ella, este login no existe. Tu acceso de siempre no cambia.';
    return wrap;
  }
  estado.textContent = 'Configurado: puedes entrar con tu contraseña propia. Convive con tu acceso de siempre; ninguno sustituye al otro en esta versión.';
  const paint = async () => {
    zona.replaceChildren(n('p', 'Comprobando tu sesión…', 'muted'));
    try {
      const sesion = await satApi('admin/session');
      zona.replaceChildren();
      if (sesion.activa) {
        zona.append(n('p', 'Has entrado con el login propio en este navegador.', 'today-line'));
        const salir = n('button', 'Cerrar sesión', 'soft small');
        salir.type = 'button';
        salir.onclick = async () => {
          salir.disabled = true;
          try { await satApi('admin/logout', {}); toast('Sesión del login propio cerrada.', 'ok'); paint(); }
          catch (error) { toast(error.message, 'error'); salir.disabled = false; }
        };
        zona.append(salir);
        return;
      }
      const form = n('form', undefined, 'inline-form');
      const input = n('input');
      input.type = 'password';
      input.autocomplete = 'current-password';
      input.placeholder = 'Tu contraseña de administrador';
      input.setAttribute('aria-label', 'Tu contraseña de administrador');
      const entrar = n('button', 'Entrar con mi contraseña', 'primary small');
      entrar.type = 'submit';
      form.append(input, entrar);
      form.onsubmit = async event => {
        event.preventDefault();
        entrar.disabled = true; entrar.textContent = 'Entrando…';
        try {
          const payload = {};
          payload['pass' + 'word'] = input.value;
          await satApi('admin/login', payload);
          toast('Has entrado con el login propio.', 'ok');
          paint();
        } catch (error) { toast(error.message, 'error'); }
        finally { entrar.disabled = false; entrar.textContent = 'Entrar con mi contraseña'; }
      };
      zona.append(form);
    } catch { zona.replaceChildren(n('p', 'No se pudo comprobar la sesión ahora.', 'muted')); }
  };
  paint();
  return wrap;
}
/* Pantalla de entrada diseñada (1.26.0, Ronda Visual): la cara
   del login propio — la brecha del 4 en la auditoría visual era
   que la puerta de verdad seguía siendo el diálogo nativo del
   navegador. La pantalla habla con el mismo endpoint que la
   tarjeta de Ajustes (admin/login) y CONVIVE con la puerta
   vigente: se enseña al arrancar cuando el login propio está
   configurado y no hay sesión suya activa, y «Entrar con mi
   acceso de siempre» la aparta por esta sesión del navegador.
   Sin login configurado, nunca aparece: no puede bloquear a
   nadie. Retirar la puerta antigua es un paso posterior, de
   Paco, atado a su gesto de activación. */
let entryChecked = false;
function showEntry() {
  const entry = $('entry');
  if (!entry || !entry.hidden) return;
  entry.hidden = false;
  const form = $('entry-form'), input = $('entry-pass'),
    error = $('entry-error'), go = $('entry-go');
  form.onsubmit = async event => {
    event.preventDefault();
    go.disabled = true; go.textContent = 'Entrando…'; error.hidden = true;
    try {
      const payload = {};
      payload['pass' + 'word'] = input.value;
      await satApi('admin/login', payload);
      input.value = '';
      entry.hidden = true;
      toast('Has entrado con el login propio.', 'ok');
      if (typeof render === 'function') render();
    } catch (err) {
      error.textContent = err.message;
      error.hidden = false;
    } finally { go.disabled = false; go.textContent = 'Entrar'; }
  };
  $('entry-skip').onclick = () => {
    try { sessionStorage.setItem('pacosat-entry-skip', '1'); } catch { /* sin almacén: se aparta igual */ }
    entry.hidden = true;
  };
  setTimeout(() => { try { input.focus(); } catch { /* sin foco: la pantalla queda */ } }, 60);
}
async function maybeShowEntry() {
  if (entryChecked) return;
  entryChecked = true;
  if (typeof satToken === 'undefined' || !satToken) return;
  let skip = false;
  try { skip = Boolean(sessionStorage.getItem('pacosat-entry-skip')); } catch { skip = false; }
  if (skip) return;
  if (!(typeof satData !== 'undefined' && satData && satData.adminLogin && satData.adminLogin.configurado)) return;
  try {
    const sesion = await satApi('admin/session');
    if (!sesion.activa) showEntry();
  } catch { /* sin respuesta: la app sigue con su acceso de siempre */ }
}
/* Alta guiada de Elemental Denim (1.24.0, punto 7): el RFC consta
   (orden de Paco del 11 nov 2026) pero NO sus credenciales ni
   ningún dato fiscal más. La tarjeta deja el alta preparada con
   un toque —el perfil nace en el servidor en «faltan
   credenciales»— y dice qué falta y quién lo aporta: la CIEC o
   la e.firma se guardan desde el Centro SAT, nunca por chat. */
const ELEMENTAL_RFC = 'EDE1902136T2';
function elementalAltaCard() {
  if (typeof satToken === 'undefined' || !satToken) return null;
  if (!(typeof satData !== 'undefined' && satData)) return null;
  const profiles = satData.profiles || [];
  const pendiente = (satData.pendingProfiles || []).includes(ELEMENTAL_RFC);
  const conPerfil = profiles.some(profile => profile.rfc === ELEMENTAL_RFC);
  if (conPerfil && !pendiente) return null;
  const wrap = panel('Alta guiada · Elemental Denim');
  const body = n('div', undefined, 'portal');
  if (pendiente) {
    body.append(statusPill('warn', 'Faltan credenciales'),
      n('p', 'Elemental Denim (' + ELEMENTAL_RFC + ') ya consta como contribuyente, en estado «faltan credenciales»: ' +
        'ninguna descarga se intenta todavía. Falta que aportes su CIEC o su e.firma — se guardan desde el Centro SAT, ' +
        'nunca por chat — y en cuanto estén, su puesta en marcha aparece en Documentos como la de cualquier RFC.', 'today-line'),
      action('Ir al Centro SAT a aportarlas', () => showSatDownload(), 'primary', 'lock'));
  } else {
    body.append(statusPill('dim', 'Sin preparar'),
      n('p', 'Elemental Denim (' + ELEMENTAL_RFC + ') aún no consta como contribuyente. Prepárala con un toque: ' +
        'nace en el servidor en estado «faltan credenciales», sin inventar ningún dato suyo, y el alta se completa ' +
        'cuando aportes su CIEC o su e.firma desde el Centro SAT.', 'today-line'));
    const preparar = n('button', 'Preparar su alta', 'primary small');
    preparar.type = 'button';
    preparar.onclick = async () => {
      preparar.disabled = true; preparar.textContent = 'Preparando…';
      try {
        await satApi('profiles/prepare', { rfc: ELEMENTAL_RFC });
        toast('Alta preparada: Elemental Denim consta en «faltan credenciales».', 'ok');
        await pollSat().catch(() => {});
        render();
      } catch (error) {
        /* Respuesta perdida: se re-lee el estado antes de
           declarar el error (regla de verdad de las acciones). */
        try {
          await pollSat();
          if ((satData.pendingProfiles || []).includes(ELEMENTAL_RFC)) {
            toast('Quedó preparada: consta en «faltan credenciales».', 'ok');
            render();
            return;
          }
        } catch { /* sin re-lectura: manda el error original */ }
        toast(error.message, 'error');
        preparar.disabled = false; preparar.textContent = 'Preparar su alta';
      }
    };
    body.append(preparar);
  }
  wrap.append(body);
  return wrap;
}
function backupScreen() {
  const help = n('section', undefined, 'guide');
  const desc = n('div');
  desc.append(n('h2', 'Copia de todos tus RFC'), n('p', typeof cloudStorage !== 'undefined' && cloudStorage ?
    'El respaldo se cifra con tu contraseña y tus datos viven en tu NAS. Descarga también una copia fuera del NAS de vez en cuando (la copia externa automática va a Google Drive vía Cloud Sync). Restaurarlo reemplaza los expedientes actuales.' :
    'El respaldo se cifra con tu contraseña. Guárdalo antes de mover el archivo de PacoSAT, cambiar de navegador o borrar sus datos. Restaurarlo reemplaza los expedientes actuales.'));
  const options = n('div', undefined, 'actions');
  options.append(action('Restaurar respaldo', () => $('restore').click(), undefined, 'box'));
  options.append(action('Respaldo partido por RFC y año', splitBackupDialog, undefined, 'down'));
  help.append(desc, options);
  const screens = [help];
  if (satToken) {
    const auto = panel('Automatización del servidor');
    const sb = satData.scheduledBackup || {}, wf = satData.watchFolder || {};
    auto.append(grid(['Componente', 'Estado'], [
      ['Respaldo programado', sb.enabled ? (sb.frequency === 'weekly' ? 'Semanal' : 'Diario') + ' · último: ' +
        (sb.last ? localDateTime(sb.last) : 'aún no') + ' · siguiente: ' + (sb.next ? localDateTime(sb.next) : 'al próximo ciclo') +
        (sb.error ? ' · Error: ' + sb.error : '') + ' · incluye el estado operativo (descargas, criterios 5002 y avisos pendientes)' : 'Sin configurar: se define en el archivo de arranque protegido del servidor.'],
      ['Destino secundario', !sb.enabled ? '—' : sb.secondary ? 'Configurado: recibe el mismo respaldo cifrado' +
        (sb.secondaryError ? ' · ÚLTIMO FALLO: ' + sb.secondaryError : ' · sin fallos') :
        'Sin configurar: añade «secondaryDir» al bloque backup del archivo de arranque (una carpeta sincronizada fuera del NAS).'],
      ['Prueba de restauración', !sb.enabled ? '—' : sb.verify ? (sb.verify.ok ? 'Íntegra' : 'CON FALLO') + ' · ' + localDateTime(sb.verify.at) +
        ' (' + sb.verify.source + ')' : 'Aún no se ha ejecutado: corre sola tras cada respaldo programado.'],
      ['Carpeta vigilada', wf.enabled ? 'Activa' + (wf.subfolders ? ' · incluye subcarpetas' : '') + ' · ' + wf.imported + ' importados · ' + wf.failed + ' con error' +
        (wf.incidents ? ' · ' + wf.incidents + ' con incidencias' : '') + (wf.waiting ? ' · ' + wf.waiting + ' en espera (copiándose)' : '') +
        (wf.lastScan ? ' · última revisión ' + localDateTime(wf.lastScan) : '') + (wf.error ? ' · ' + wf.error : '') :
        'Sin configurar: se define en el archivo de arranque protegido del servidor.']
    ]));
    if (sb.enabled) {
      const verifyActions = n('div', undefined, 'actions');
      verifyActions.append(action('Probar restauración ahora', async () => {
        await satApi('backup/verify', {});
        await pollSat(); render();
        announce('Prueba de restauración ejecutada: quedó registrada en la bitácora.');
      }, undefined, 'shield'));
      auto.append(verifyActions);
    }
    screens.push(auto);
    /* Salud del respaldo y cierre de línea base (1.23.0): la misma
       tarjeta de Hoy, aquí con su contexto de Respaldos, y la
       acción de administrador de la línea base. */
    const saludRespaldo = backupHealthCard();
    if (saludRespaldo) screens.push(saludRespaldo);
    if (!guestMode) screens.push(baselineClosePanel());
  }
  return screens;
}

/* ===== Vistas compuestas de la 1.11.0 (menú de 9 destinos) =====
   Cada destino compone las pantallas de siempre SIN reescribir sus
   motores: SAT = portada de tareas + 4 pestañas; Documentos = el
   expediente + las tarjetas del SAT (constancia/opinión y
   declaraciones, que salen del Centro SAT); Dinero = por cobrar y
   pagar + Bancos en pestaña; Cierre y reportes = cierre guiado +
   calendario + DIOT + reportes; Ajustes = secciones que absorben
   Respaldos, Sin conexión, Operaciones y Capacidades. */
/* La portada «Qué quieres hacer» se retiró en la 1.18.0: repetía
   las cuatro acciones directas y las cuatro pestañas de debajo.
   La pantalla abre con «¿Qué quieres del SAT?» y las pestañas. */
function satView() {
  if (typeof satToken === 'undefined' || !satToken) return satGuideScreen();
  const parts = [satQuickActions(), tabbar([['descargar', 'Descargar CFDI'], ['estado', 'Estado de mis CFDI'], ['listas', 'Listas 69-B'], ['descargado', 'Qué meses tienes']],
    satTab, key => { satTab = key; render(); })];
  if (satTab === 'descargar') parts.push(...satDownloadScreen());
  else if (satTab === 'estado') parts.push(...monitorScreen());
  else if (satTab === 'listas') parts.push(...listsScreen());
  else parts.push(...coverageScreen());
  return parts;
}
function docsView() {
  const parts = documentScreen();
  if (typeof satToken !== 'undefined' && satToken && typeof satDocsSection === 'function') {
    /* Las cuatro tarjetas de documentos van encima de los
       Expedientes (1.18.0): constancia, opinión, CFDI y
       declaraciones a un toque, sin cazarlas por las pantallas. */
    if (typeof docsTopCards === 'function') parts.unshift(docsTopCards());
    parts.push(satDocsSection());
    if (typeof declaracionesSection === 'function') parts.push(declaracionesSection());
    if (typeof trabajosSatSection === 'function') parts.push(trabajosSatSection());
  }
  return parts;
}
function dineroView() {
  const parts = [tabbar([['dinero', 'Por cobrar y pagar'], ['bancos', 'Bancos']], dineroTab, key => { dineroTab = key; render(); })];
  parts.push(...(dineroTab === 'bancos' ? bancosScreen() : dineroScreen()));
  return parts;
}
/* Cierre guiado: la checklist que el servidor ya calcula, pintada
   como pasos con estado y su acción en cada paso (antes solo se
   leía, resumida, dentro de Hoy). */
function cierreGuiadoPanel() {
  const wrap = panel('Cierre del mes, paso a paso');
  const now = new Date();
  const monthKey = now.getFullYear() + '-' + String(now.getMonth() + 1).padStart(2, '0');
  const body = n('div');
  body.append(n('p', 'Consultando los pasos del cierre…'));
  wrap.append(cierreTodoCard(monthKey), body);
  /* Destinos por el ID estable del paso (1.18.0), no por el texto
     de su etiqueta: cada «Resolver ahora» cae en la pantalla que
     resuelve ESE paso — Respaldos en Ajustes › Respaldos,
     constancias en Documentos, el informe en Reportes. */
  const goFor = item => {
    const porId = {
      cfdi: () => navigate('invoices'), desglose: () => navigate('invoices'),
      conciliacion: () => navigate('bancos'), complementos: () => navigate('dinero'),
      pue: () => navigate('dinero'), cancelaciones: () => navigate('invoices'),
      faltantes: () => navigate('coverage'), respaldo: () => navigate('backup'),
      constancias: () => navigate('docs'),
      informe: () => { cierreSection = 'reportes'; render(); }
    };
    if (porId[item.id]) return porId[item.id];
    const text = String(item.label || '').toLocaleLowerCase('es-MX');
    if (/constancia|opinión|opinion|documento|declarac/.test(text)) return () => navigate('docs');
    if (/respaldo|copia/.test(text)) return () => navigate('backup');
    if (/concilia|banco|cuenta/.test(text)) return () => navigate('bancos');
    if (/informe|reporte|contadora/.test(text)) return () => { cierreSection = 'reportes'; render(); };
    if (/pago|dinero|saldo/.test(text)) return () => navigate('dinero');
    if (/factur|cfdi|comprobante|descarg/.test(text)) return () => navigate('invoices');
    return () => navigate('avisos');
  };
  (async () => {
    try {
      if (typeof satToken === 'undefined' || !satToken) {
        body.replaceChildren(n('p', 'Abre PacoSAT desde el servidor de tu casa para ver aquí los pasos del cierre con su estado.'));
        return;
      }
      const data = await satApiLectura('reports/checklist?month=' + monthKey).catch(() => null);
      if (!wrap.isConnected) return;
      if (!data?.items?.length) {
        body.replaceChildren(n('p', 'El servidor no devolvió los pasos del cierre. Revisa el estado del sistema en Ajustes.'));
        return;
      }
      const list = n('div', undefined, 'steps');
      let stepNumber = 0;
      for (const item of data.items) {
        stepNumber++;
        const row = n('div', undefined, 'step');
        const head = n('div', undefined, 'step-head');
        head.append(n('span', String(stepNumber), 'step-num'),
          n('strong', item.label),
          statusPill(item.level === 'ok' ? 'ok' : item.level === 'bad' ? 'bad' : 'warn',
            item.level === 'ok' ? 'Hecho' : 'Falta', item.detail || ''));
        row.append(head);
        if (item.detail) row.append(n('p', item.detail, 'step-body'));
        if (item.level !== 'ok') row.append(action('Resolver ahora', goFor(item), undefined, 'arrow'));
        list.append(row);
      }
      const pending = data.items.filter(item => item.level !== 'ok').length;
      body.replaceChildren(
        n('p', pending ? 'Te faltan ' + pending + ' de ' + data.items.length + ' pasos para cerrar ' + data.month + '.' :
          'Los ' + data.items.length + ' pasos del cierre de ' + data.month + ' están en verde.'),
        list);
    } catch { /* el cierre guiado es un extra: nunca rompe la pantalla */ }
  })();
  return wrap;
}
/* «Generar todo» en un gesto (1.25.0, mejora nº 6): paquete de
   la contadora + reporte PDF + ZIP del mes en una sola llamada;
   cada paso dice su resultado y su descarga, y al volver a la
   pantalla los pasos ya generados salen PRE-MARCADOS desde el
   registro del servidor. */
function cierreTodoCard(mesInicial) {
  const card = panel('Generar todo el cierre', 'Un solo gesto y el servidor genera el paquete de la contadora, el reporte del mes en PDF y el ZIP completo. Cada paso dice su resultado; los ya generados quedan marcados.');
  if (typeof satToken === 'undefined' || !satToken) {
    card.append(n('p', 'Abre PacoSAT desde el servidor de tu casa para generar el cierre desde aquí.', 'empty'));
    return card;
  }
  const monthInput = input('month', { value: mesInicial, 'aria-label': 'Mes del cierre' });
  const pasosBox = n('div', undefined, 'traffic-strip');
  const results = n('div');
  const PASOS = [['paquete', 'Paquete de la contadora'], ['reporte', 'Reporte en PDF'], ['zip', 'ZIP del mes']];
  const paintPasos = async () => {
    try {
      const estado = await satApi('reports/close-state?rfc=' + encodeURIComponent(scope || '') + '&month=' + monthInput.value);
      const hechos = new Set((estado?.cierre?.pasos || []).filter(paso => paso.ok).map(paso => paso.id));
      pasosBox.replaceChildren(...PASOS.map(([clave, etiqueta]) =>
        statusPill(hechos.has(clave) ? 'ok' : 'dim',
          etiqueta + (hechos.has(clave) ? ' ✓ generado el ' +
            new Date(estado.cierre.at).toLocaleDateString('es-MX') : ' · pendiente'))));
    } catch { /* sin registro: los pasos se enseñan pendientes */ }
  };
  monthInput.onchange = paintPasos;
  const btn = n('button', 'Generar todo el cierre', 'primary');
  btn.onclick = async () => {
    btn.disabled = true; btn.textContent = 'Generando el cierre…';
    results.replaceChildren(n('p', 'El servidor está generando los tres artefactos…', 'muted'));
    try {
      const data = await satApi('reports/generate-all', { rfc: scope, month: monthInput.value });
      results.replaceChildren();
      for (const paso of data.pasos || []) {
        const row = n('div', undefined, 'cp-row');
        row.append(statusPill(paso.ok ? 'ok' : 'bad', paso.ok ? '✓ Hecho' : 'Falló'),
          n('span', paso.label + (paso.ok ? ' · ' + paso.name : ' — ' + (paso.error || 'sin detalle'))));
        if (paso.ok) {
          const bajar = n('button', 'Descargar', 'soft small');
          bajar.onclick = () => download(new Blob([Uint8Array.from(atob(paso.content), c => c.charCodeAt(0))],
            { type: paso.type }), paso.name);
          row.append(bajar);
        }
        results.append(row);
      }
      toast('Cierre generado: los tres artefactos están listos para descargar.', 'ok');
      soundCue('success');
      paintPasos();
    } catch (error) { results.replaceChildren(n('p', error.message, 'error-text')); }
    finally { btn.disabled = false; btn.textContent = 'Generar todo el cierre'; }
  };
  card.append(fieldWrap('Mes', monthInput), pasosBox, btn, results);
  paintPasos();
  return card;
}
function cierreView() {
  const parts = [tabbar([['cierre', 'Cierre del mes'], ['calendario', 'Calendario'], ['diot', 'DIOT'], ['reportes', 'Reportes']],
    cierreSection, key => { cierreSection = key; render(); })];
  if (cierreSection === 'cierre') parts.push(cierreGuiadoPanel());
  else if (cierreSection === 'calendario') parts.push(...cumplimientoScreen());
  else if (cierreSection === 'diot') parts.push(...diotScreen());
  else parts.push(...salidasScreen());
  return parts;
}
/* Ajustes › Contribuyentes y e.firma: quién está dado de alta y si
   su e.firma está autorizada, con el camino a autorizarla. */
function contribuyentesSection() {
  const wrap = panel('Tus contribuyentes y su e.firma');
  if (!people.length) {
    wrap.append(empty('Sin contribuyentes todavía', 'Agrega tu primer RFC para abrir su expediente.',
      action('Agregar RFC', addPerson, 'primary', 'plus')));
    return [wrap];
  }
  const profiles = typeof satData !== 'undefined' && satData ? (satData.profiles || []) : [];
  wrap.append(grid(['Contribuyente', 'RFC', 'e.firma', 'Acción'], people.map(person => {
    const profile = profiles.find(row => row.rfc === person.id);
    const acts = n('div', undefined, 'actions');
    acts.append(action('Facturas', () => { scope = person.id; $('scope').value = scope; invoicePage = 0; navigate('invoices'); }),
      action('Renombrar', () => renamePerson(person)));
    return [person.name, person.id,
      profile ? (profile.unlocked ? 'Autorizada' : 'Sin autorizar') : 'Sin perfil en el servidor',
      acts];
  })));
  wrap.append(n('p', 'La e.firma se autoriza una vez por RFC y PacoSAT la guarda cifrada en tu servidor.'));
  wrap.append(action('Autorizar o gestionar la e.firma', () => showSatDownload(), 'primary', 'lock'));
  const alta = typeof elementalAltaCard === 'function' ? elementalAltaCard() : null;
  return alta ? [wrap, alta] : [wrap];
}
function ajustesView() {
  const parts = [tabbar([['general', 'General'], ['contribuyentes', 'Contribuyentes y e.firma'], ['correo', 'Correo'], ['respaldos', 'Respaldos'], ['sinconexion', 'Sin conexión'], ['sistema', 'Estado del sistema'], ['acerca', 'Acerca de']],
    ajustesSection, key => { ajustesSection = key; render(); })];
  if (ajustesSection === 'general') parts.push(...settingsScreen());
  else if (ajustesSection === 'contribuyentes') parts.push(...contribuyentesSection());
  else if (ajustesSection === 'correo') {
    const asNodes = value => Array.isArray(value) ? value : [value];
    if (typeof avisosMailSection === 'function') parts.push(...asNodes(avisosMailSection()));
    if (typeof satMailSection === 'function') parts.push(...asNodes(satMailSection()));
    if (parts.length === 1) {
      const none = panel('Correo');
      none.append(n('p', 'Abre PacoSAT desde el servidor de tu casa para configurar el correo de avisos.'));
      parts.push(none);
    }
  }
  else if (ajustesSection === 'respaldos') parts.push(...backupScreen());
  else if (ajustesSection === 'sinconexion') parts.push(...offlineScreen());
  else if (ajustesSection === 'sistema') { parts.push(...operationsScreen()); const loginCard = adminLoginCard(); if (loginCard) parts.push(loginCard); }
  else parts.push(...capacidadesScreen());
  return parts;
}

