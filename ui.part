/* ===== Componentes universales (1.31.2, orden de Paco 23:07–23:10) =====
   Un solo menú ⋯ de tarjeta y una sola barra de progreso para
   TODA la app: el mismo componente en el Centro SAT, Avisos,
   Dinero, Pagos y Documentos, y la barra en todo trabajo vivo
   (Actividad, tarjetas, plazos). Nada de variantes por pantalla. */
/* Tiempo transcurrido en claro: «lleva 12 s» / «lleva 2 min 05 s»
   / «lleva 1 h 03 min». El dato sale del inicio real del trabajo;
   sin inicio conocido no se pinta tiempo (no se inventa). */
function fmtElapsed1312(desde, ahora = Date.now()) {
  const ms = Number(desde);
  if (!Number.isFinite(ms) || ms <= 0) return '';
  const s = Math.max(0, Math.round((ahora - ms) / 1000));
  if (s < 60) return 'lleva ' + s + ' s';
  if (s < 3600) return 'lleva ' + Math.floor(s / 60) + ' min ' + String(s % 60).padStart(2, '0') + ' s';
  return 'lleva ' + Math.floor(s / 3600) + ' h ' + String(Math.floor(s / 60) % 60).padStart(2, '0') + ' min';
}
/* Barra de progreso de un trabajo vivo: fase en lenguaje claro,
   tiempo transcurrido y — SOLO si el total se conoce de verdad —
   conteo y porcentaje. Sin total: barra indeterminada animada
   suave, jamás un % inventado y jamás la barra sola. */
function jobProgress1312({ fase = '', desde = 0, done = null, total = null, estado = '' } = {}) {
  const wrap = n('div', undefined, 'job-progress');
  wrap.setAttribute('role', 'progressbar');
  /* Progreso honesto en cola (2.0, M4 / 1.2): un trabajo que
     ESPERA (en cola, en pausa o esperando equipo/gesto) no ha
     empezado: barra a 0, sin porcentaje ni relleno animado que
     parezca avance, y el tiempo de espera como protagonista.
     El relleno solo existe en curso y con pasos reales. */
  const espera = ['en-cola', 'esperando', 'pausado'].includes(estado);
  const conocido = !espera && Number.isFinite(Number(total)) && Number(total) > 0 && Number.isFinite(Number(done));
  const pct = conocido ? Math.min(100, Math.round(Number(done) / Number(total) * 100)) : 0;
  if (conocido) wrap.setAttribute('aria-valuenow', String(pct));
  if (espera) wrap.setAttribute('aria-valuenow', '0');
  const linea = n('div', undefined, 'job-progress-line');
  const bits = [];
  if (fase) bits.push(fase);
  if (conocido) bits.push(number.format(Number(done)) + ' de ' + number.format(Number(total)));
  const transcurrido = fmtElapsed1312(desde);
  const tiempo = espera && transcurrido ? transcurrido.replace(/^lleva /, 'esperando desde hace ') : transcurrido;
  linea.append(n('span', bits.join(' · ')), n('span', tiempo, 'job-progress-time'));
  const bar = n('div', undefined, 'job-bar' + (espera ? ' job-bar-espera' : conocido ? '' : ' job-bar-ind'));
  const fill = n('i', undefined, 'job-bar-fill');
  if (conocido) fill.style.width = pct + '%';
  if (espera) fill.style.width = '0%';
  bar.append(fill);
  wrap.append(linea, bar);
  return wrap;
}
/* Barra de PLAZO (mismo componente, otro dato): cuánto del plazo
   ya corrió entre su inicio real y su vencimiento real, con el
   tramo por días que quedan — verde, ámbar con 3 días o menos,
   rojo con 1 día o menos. Sin inicio o sin vencimiento conocidos
   NO se pinta: la barra no inventa plazos. */
function plazoBar1312(inicioMs, venceMs, ahora = Date.now()) {
  const aMs = v => { const num = Number(v); return Number.isFinite(num) && num > 0 ? num : Date.parse(v); };
  const inicio = aMs(inicioMs), vence = aMs(venceMs);
  if (!Number.isFinite(inicio) || !Number.isFinite(vence) || vence <= inicio) return null;
  const pct = Math.max(0, Math.min(100, Math.round((ahora - inicio) / (vence - inicio) * 100)));
  const diasQuedan = Math.round((vence - ahora) / 86400000);
  const tramo = diasQuedan <= 1 ? 'plazo-bad' : diasQuedan <= 3 ? 'plazo-warn' : 'plazo-ok';
  const wrap = n('div', undefined, 'job-progress plazo-progress');
  wrap.setAttribute('role', 'progressbar');
  wrap.setAttribute('aria-valuenow', String(pct));
  const linea = n('div', undefined, 'job-progress-line');
  linea.append(n('span', diasQuedan < 0 ? 'plazo vencido hace ' + Math.abs(diasQuedan) + (diasQuedan === -1 ? ' día' : ' días')
    : diasQuedan === 0 ? 'el plazo vence hoy'
    : diasQuedan === 1 ? 'queda 1 día de plazo'
    : 'quedan ' + number.format(diasQuedan) + ' días de plazo'));
  const bar = n('div', undefined, 'job-bar');
  const fill = n('i', undefined, 'job-bar-fill ' + tramo);
  fill.style.width = pct + '%';
  bar.append(fill);
  wrap.append(linea, bar);
  return wrap;
}
/* Menú ⋯ de tarjeta: botón de 44 px y panel con SOLO acciones
   reales (las pone quien crea la tarjeta; sin acciones no hay
   menú). Se cierra con clic fuera, con Esc y al elegir; usable
   con teclado (botones nativos, foco visible) y no desborda:
   el panel se ancla a la derecha de su tarjeta con tope de
   ancho de pantalla. Un solo menú abierto a la vez. */
let cardMenuAbierto1312 = null;
function closeCardMenus1312() {
  if (cardMenuAbierto1312) { cardMenuAbierto1312(); cardMenuAbierto1312 = null; }
}
function cardMenu1312(etiqueta = 'Más opciones') {
  const wrap = n('span', undefined, 'card-menu-wrap');
  const btn = n('button', '⋯', 'card-menu-btn');
  btn.type = 'button';
  btn.setAttribute('aria-haspopup', 'menu');
  btn.setAttribute('aria-expanded', 'false');
  btn.setAttribute('aria-label', etiqueta);
  btn.title = etiqueta;
  const menu = n('div', undefined, 'card-menu');
  menu.setAttribute('role', 'menu');
  menu.hidden = true;
  const cerrar = () => { menu.hidden = true; btn.setAttribute('aria-expanded', 'false'); if (cardMenuAbierto1312 === cerrar) cardMenuAbierto1312 = null; };
  btn.onclick = event => {
    event.stopPropagation();
    if (!menu.hidden) { cerrar(); return; }
    closeCardMenus1312();
    menu.hidden = false;
    btn.setAttribute('aria-expanded', 'true');
    cardMenuAbierto1312 = cerrar;
    menu.querySelector('button')?.focus();
  };
  wrap.append(btn, menu);
  wrap._setItems1312 = items => {
    menu.replaceChildren();
    for (const item of items || []) {
      const b = n('button', item.label, 'card-menu-item' + (item.danger ? ' danger' : ''));
      b.type = 'button';
      b.setAttribute('role', 'menuitem');
      b.onclick = event => { event.stopPropagation(); cerrar(); item.fn(); };
      menu.append(b);
    }
    wrap.hidden = !(items && items.length);
  };
  wrap._setItems1312([]);
  return wrap;
}
if (typeof document !== 'undefined' && !window.__cardMenu1312Global) {
  window.__cardMenu1312Global = true;
  document.addEventListener('click', event => {
    if (cardMenuAbierto1312 && !event.target.closest('.card-menu-wrap')) closeCardMenus1312();
  });
  document.addEventListener('keydown', event => { if (event.key === 'Escape') closeCardMenus1312(); });
}
async function refresh(skipRender = false) {
  [people, invoices, documents, activity] = await Promise.all(['people', 'invoices', 'documents', 'activity'].map(store => readStore(store)));
  people.sort((a, b) => a.name.localeCompare(b.name, 'es-MX'));
  invoices.sort((a, b) => b.date.localeCompare(a.date) || a.id.localeCompare(b.id));
  documents.sort((a, b) => b.date.localeCompare(a.date));
  activity.sort((a, b) => b.date.localeCompare(a.date));
  /* Archivo de CFDI (1.31.1): el servidor dice qué comprobantes
     están archivados (su columna records.archived, la misma del
     cierre de línea base) y el cliente los separa al entrar:
     las pantallas de trabajo no los cuentan ni los enseñan, y
     viven en la vista Archivo, recuperables con un toque. Sin
     servidor (modo local) la lista llega vacía y nada se oculta;
     si la lectura falla, tampoco se oculta nada por error. */
  invoicesArchivo = [];
  if (typeof satToken !== 'undefined' && satToken) {
    try {
      const arc = await satApi('cfdi/archivados');
      const ids = new Set((arc.ids || []).map(id => String(id).toUpperCase()));
      if (ids.size) {
        invoicesArchivo = invoices.filter(row => ids.has(String(row.id).toUpperCase()));
        invoices = invoices.filter(row => !ids.has(String(row.id).toUpperCase()));
      }
    } catch { /* sin lista: todo sigue en trabajo */ }
  }
  /* Regla de contribuyente (1.23.0, D4): las pantallas de trabajo
     nunca mezclan RFC — la opción «Todos los RFC» desaparece del
     selector global y, si el alcance no es un perfil válido (al
     arrancar viene en ''), manda el PRIMER perfil. El único sitio
     con todos es el directorio de contribuyentes (Ajustes). En
     modo invitado, people ya viene filtrado por su alcance en el
     servidor (gScope): el primer perfil es uno de los suyos. */
  if (!people.some(person => person.id === scope)) scope = people[0]?.id || '';
  const scopeOptions = () => people.length ?
    people.map(p => new Option(p.name + ' · ' + p.id, p.id)) : [new Option('Sin contribuyentes', '')];
  $('scope').replaceChildren(...scopeOptions());
  $('scope').value = scope;
  /* F5: el espejo de la barra superior se puebla y se sincroniza
     con el lateral en cada repintado. */
  const scopeTop = $('scope-top');
  if (scopeTop) {
    scopeTop.replaceChildren(...scopeOptions());
    scopeTop.value = scope;
  }
  prefetchLazyParts();
  if (!skipRender) render();
  if (typeof enlaceProfundo200c === 'function') enlaceProfundo200c();
}
function navigate(view) {
  /* (2.8.0 · diseño 26) El contexto de ayuda solo vive para
     la visita a Preguntas que lo trajo. */
  if (view !== 'preguntas' && typeof ayudaContexto280 !== 'undefined') ayudaContexto280 = null;
  const alias = VIEW_ALIASES[view];
  if (alias) {
    view = alias[0];
    if (alias[1]) {
      if (view === 'sat') satTab = alias[1];
      else if (view === 'settings') ajustesSection = alias[1];
      else if (view === 'salidas') cierreSection = alias[1];
      else if (view === 'dinero') dineroTab = alias[1];
    }
  }
  /* Centro SAT sin cajón (2.0.1): el destino 'sat' ya no es una
     pantalla con pestañas; cada pestaña vieja es hoy su propia
     vista enrutada y los enlaces internos que aún dicen
     navigate('sat') aterrizan en la que satTab marque. */
  if (view === 'sat') view = { descargar: 'descargar', estado: 'monitor', listas: 'lists', descargado: 'descargar', ejecutor: 'ejecutor' }[satTab] || 'descargar';
  page = view;
  /* El resultado de una importación vive en su pantalla (sistema
     visual §5): al cambiar de pantalla se despide solo. */
  const result = $('activity-result');
  if (result) result.hidden = true;
  const frame = document.querySelector('.frame');
  if (frame) frame.classList.remove('sheet-open');
  for (const button of document.querySelectorAll('[data-view]')) {
    if (button.dataset.view === page) button.setAttribute('aria-current', 'page');
    else button.removeAttribute('aria-current');
  }
  render();
}
/* Atajo para otras pantallas: ir a la pantalla de descarga del SAT. */
function showSatDownload() { navigate('descargar'); }
/* Barra de pestañas/secciones con el patrón único (.tabbar). */
function tabbar(items, current, pick) {
  const bar = n('div', undefined, 'tabbar');
  bar.setAttribute('role', 'tablist');
  for (const [key, label] of items) {
    const button = n('button', label);
    button.type = 'button';
    button.setAttribute('role', 'tab');
    button.setAttribute('aria-selected', String(key === current));
    button.onclick = () => pick(key);
    bar.append(button);
  }
  return bar;
}
/* La acción principal de SAT y de Ajustes depende de la pestaña o
   sección en curso: una sola etiqueta por contexto, siempre con
   verbo + objeto. */
function primaryLabel() {
  /* Regla de cabecera (1.32.1, auditoría de caminos G1): ninguna
     etiqueta promete lo que su clic no hace — cada etiqueta de
     esta tabla tiene su rama en el despacho de workflows.part
     ejecutando ESA acción, y la batería ronda1321 recorre la
     tabla contra el despacho para todas las pantallas/pestañas.
     Recibidos: la cabecera ES «Marcar todo leído» (el mismo
     botón de su franja, por su gancho de clase). Buzón
     Tributario: «Consultar ahora» consulta de verdad (antes
     caía al importador de archivos: la promesa más rota). */
  if (page === 'sat') return { descargar: 'Descargar del SAT', estado: 'Revisar mis CFDI ahora', listas: 'Actualizar listados', descargado: 'Actualizar estado', ejecutor: satData?.ejecutor?.emparejado ? 'Tu ejecutor' : 'Emparejar un ejecutor en mi equipo' }[satTab] || 'Descargar del SAT';
  /* Las ex-pestañas del Centro SAT son vistas propias (2.0.1):
     su primario es el de su ficha, con la misma rama de despacho. */
  if (page === 'descargar') return 'Descargar del SAT';
  if (page === 'monitor') return 'Revisar mis CFDI ahora';
  if (page === 'lists') return 'Actualizar listados';
  if (page === 'coverage') return 'Actualizar estado';
  if (page === 'ejecutor') return satData?.ejecutor?.emparejado ? 'Tu ejecutor' : 'Emparejar un ejecutor en mi equipo';
  if (page === 'reportes') return 'Exportación completa';
  if (page === 'settings') return { general: 'Guardar ajustes', contribuyentes: 'Agregar RFC', correo: 'Guardar el correo', respaldos: 'Crear respaldo', sinconexion: 'Sincronizar ahora', sistema: 'Actualizar estado', acerca: 'Ver la versión', api: 'Actualizar el panel' }[ajustesSection] || 'Guardar ajustes';
  if (page === 'salidas') return { cierre: 'Exportación completa', calendario: 'Elegir el mes del cierre', diot: 'Exportar CSV', reportes: 'Ir a Reportes' }[cierreSection] || 'Exportación completa';
  /* Primario contextual (2.0, hallazgo 1.3): en Facturas manda
     la descarga del SAT (su rama en el despacho abre la misma
     hoja que su botón «Descargar del SAT»); en Hoy manda el
     paso del día según la causa viva, y si no hay gesto
     protagonista, descargar CFDI del SAT. */
  if (page === 'invoices') return 'Descargar del SAT';
  if (page === 'home') return pasoHoy200();
  /* (2.9.13 · A7) Contribuyentes: la cabecera vuelve a su
     etiqueta propia, «Ir a Hoy» (la de su entrada en el mapa,
     con su despacho de siempre). La de 2.8.0 (diseño 24)
     repetía en la cabecera la etiqueta del gesto protagonista
     — el mismo «Ver el Buzón del SAT» dos veces en pantalla —
     y su clic ni siquiera hacía ese gesto: navegaba a Hoy.
     El gesto vive UNA vez: en su tarjeta protagonista. */
  if (page === 'contribuyentes') return screens.contribuyentes[2];
  /* (2.8.0 · diseño 25) Archivo: su primario es recuperar,
     no irse a Facturas; sin nada archivado, el de siempre. */
  if (page === 'archivo') {
    const hay280 = (typeof invoicesArchivo !== 'undefined' && invoicesArchivo.some(r => r.from?.rfc === scope || r.to?.rfc === scope)) ||
      (typeof documents !== 'undefined' && documents.some(d => d.archived && (!scope || d.rfc === scope)));
    return hay280 ? 'Recuperar el más antiguo' : 'Ir a Facturas';
  }
  return screens[page][2];
}
/* El paso del día para el primario de Hoy (2.0): solo gestos
   que constan en el estado — credenciales pendientes del RFC
   en ámbito, la causa viva de la puerta — y, en su defecto,
   la descarga de CFDI. Cada etiqueta tiene su rama en el
   despacho (workflows.part, page === 'home'). */
function pasoHoy200() {
  if (!satData) return 'Descargar del SAT';
  if (scope && (satData.pendingProfiles || []).includes(scope)) return 'Dar sus credenciales';
  const tipo = causaP200(scope ? satData.puerta?.[scope] : null, satData.ejecutor).tipo;
  return tipo === 'equipo' || tipo === 'sin-equipo' ? 'Ver tu ejecutor'
    : tipo === 'efirma' ? 'Revisar la e.firma' : 'Descargar del SAT';
}
/* ===== Tanda 2 · 2.0: identidad por RFC, destino exacto,
   acciones del día y panel general de contribuyentes =====
   Paleta cerrada y sobria (10 tonos apagados): cada fondo lleva
   texto blanco y TODOS miden contraste AA contra ese blanco
   (≥5.43:1; la medición completa vive en ronda200b). El color
   es un ACENTO FINO — el medallón con la inicial —: nunca
   repinta la app ni sale en reportes, PDF o correos. Se guarda
   en el servidor (settings.rfcColors, vía /api/settings) y
   viaja en el estado que el cliente ya descarga (satData). */
const RFC_PALETA200B = [
  ['azul', '#175c9e', 'Azul'], ['verde', '#0e6b4f', 'Verde'], ['teal', '#0f766e', 'Turquesa'],
  ['violeta', '#6d28d9', 'Violeta'], ['burdeos', '#9f2436', 'Burdeos'], ['ambar', '#9a5b00', 'Ámbar'],
  ['grafito', '#3f5468', 'Grafito'], ['oliva', '#556b1f', 'Oliva'], ['ciruela', '#7a2e5e', 'Ciruela'],
  ['marron', '#7c4a1e', 'Marrón']];
const rfcPaleta200b = clave => RFC_PALETA200B.find(([k]) => k === clave) || null;
function rfcColorClave200b(rfc) {
  if (!rfc) return '';
  const delEstado = typeof satData !== 'undefined' && satData ? satData.settings?.rfcColors?.[rfc] : '';
  if (delEstado) return delEstado;
  const delPerfil = typeof satData !== 'undefined' && satData ?
    (satData.profiles || []).find(p => p.rfc === rfc)?.color : '';
  return delPerfil || (typeof appSettings !== 'undefined' ? appSettings.rfcColors?.[rfc] : '') || '';
}
/* Medallón con la inicial: con color asignado, su fondo; sin
   color, el neutro de la casa (sin fondo inline: manda la clase). */
function medallon200b(rfc, nombre) {
  const el = n('span', undefined, 'rfc-medallon200b');
  el.textContent = String(nombre || rfc || '?').trim().charAt(0).toUpperCase() || '?';
  el.setAttribute('aria-hidden', 'true');
  const pal = rfcPaleta200b(rfcColorClave200b(rfc));
  el.dataset.color = pal ? pal[0] : '';
  if (pal) { el.style.background = pal[1]; el.style.color = '#ffffff'; }
  el.title = (nombre || rfc || '') + (pal ? ' · color ' + pal[2] : '');
  return el;
}
/* Salud compuesta por RFC (pieza 8): puerta de ESE RFC +
   ejecutor (el equipo es de la casa, sirve a todos) + avisos
   sin abrir de su Buzón Tributario. Verde/ámbar/rojo con su
   porqué en una frase; sin datos, gris honesto. */
function saludRfc200b(rfc, ahora = Date.now()) {
  const sd = typeof satData !== 'undefined' && satData ? satData : null;
  if (!sd || !rfc) return { nivel: 'dim', porque: 'sin datos todavía' };
  const puerta = sd.puerta?.[rfc] || null;
  const ex = sd.ejecutor || null;
  const sinAbrir = Number(sd.tributario?.[rfc]?.sinAbrir || 0);
  const causa = puerta && puerta.probada && puerta.ok === false ?
    (typeof causaP200 === 'function' ? causaP200(puerta, ex, ahora) : null) : null;
  /* Verdad de sede (2.9.0 · Bloque C): con el paseo en casa
     (sede NAS) el ejecutor de PC no interviene en NADA — su
     silencio no puede teñir el punto de este RFC, que refleja
     la PUERTA (probada, vieja o caída por la e.firma). Las dos
     ramas de «tu equipo no responde» solo existen en sede
     remota, para las instalaciones cliente. */
  const sedeNas290 = sd.paseo === 'nas';
  if (!sedeNas290 && causa && (causa.tipo === 'equipo' || causa.tipo === 'sin-equipo'))
    return { nivel: 'bad', porque: 'tu equipo no responde: la puerta no se puede probar' };
  if (causa && causa.tipo === 'efirma' && !causa.vieja)
    return { nivel: 'bad', porque: 'la puerta del SAT no abre con su e.firma' };
  if (!sedeNas290 && ex && ex.emparejado && !ex.enLinea)
    return { nivel: 'warn', porque: 'tu equipo no responde desde el ' + fmtFechaHora(ex.ultimoVisto) };
  if (causa && causa.vieja)
    return { nivel: 'warn', porque: 'la foto de su puerta es vieja (' + fmtFechaHora(puerta.probada) + ')' };
  if (sinAbrir > 0) return { nivel: 'warn', porque: number.format(sinAbrir) + ' notificación(es) del Buzón sin abrir' };
  if (puerta && puerta.ok) return { nivel: 'ok', porque: 'puerta abierta y sin avisos sin abrir' };
  return { nivel: 'dim', porque: 'puerta sin probar todavía' };
}
/* Urgencia de un RFC para ordenar listas y el panel (norma del
   añadido 13:54): gesto primero — puerta caída por causa viva,
   ejecutor sin señal, avisos sin abrir, vencimiento próximo. */
function urgenciaRfc200b(rfc, ahora = Date.now()) {
  const sd = typeof satData !== 'undefined' && satData ? satData : null;
  if (!sd || !rfc) return 0;
  let puntos = 0;
  const salud = saludRfc200b(rfc, ahora);
  if (salud.nivel === 'bad') puntos += 100; else if (salud.nivel === 'warn') puntos += 40;
  puntos += Math.min(30, Number(sd.tributario?.[rfc]?.sinAbrir || 0) * 10);
  puntos += Math.min(20, Number(sd.buzonUnread?.[rfc] || 0) * 4);
  const perfil = (sd.profiles || []).find(p => p.rfc === rfc);
  if (perfil?.certExpires) {
    const dias = Math.ceil((perfil.certExpires - ahora) / 86400000);
    if (dias <= 0) puntos += 90; else if (dias <= 30) puntos += 60; else if (dias <= 60) puntos += 30;
  }
  if ((sd.pendingProfiles || []).includes(rfc)) puntos += 80;
  return puntos;
}
/* Destino exacto (pieza 5 · O5): navegar y aterrizar en la
   tarjeta exacta — la pantalla destino marca su tarjeta con
   data-destino200b="<id>"; al llegar se busca, se desplaza y
   se realza un momento. Si la tarjeta no existe en el destino,
   se queda la pantalla como siempre: nunca un hueco muerto. */
let destinoPendiente200b = '';
function irDestino200b(view, destinoId) {
  destinoPendiente200b = destinoId || '';
  navigate(view);
  aplicarDestino200b();
}
/* Enlace profundo de los correos (2.0 · M3): la URL que traen
   los botones de los correos — origen + #/vista?rfc=&periodo=&
   uuid=&destino= — aterriza aquí al abrir la app: fija el
   contribuyente, el mes y, con uuid, abre el CFDI exacto. Solo
   destino: la URL nunca trae tokens ni credenciales. Si el
   destino no existe, se queda la pantalla: nunca un hueco. */
let enlaceAplicado200c = '';
function enlaceProfundo200c() {
  const hash = String(location.hash || '');
  if (!hash.startsWith('#/') || hash === enlaceAplicado200c) return;
  enlaceAplicado200c = hash;
  const [vista, query] = hash.slice(2).split('?');
  const params = new URLSearchParams(query || '');
  const rfc = params.get('rfc') || '';
  if (rfc && people.some(person => person.id === rfc)) scope = rfc;
  const periodo = params.get('periodo') || '';
  if (/^\d{4}-\d{2}$/.test(periodo)) month = periodo;
  const vistas200c = { facturas: 'invoices', avisos: 'avisos', documentos: 'docs',
    hoy: 'home', cierre: 'salidas', buzon: 'tributario', declaraciones: 'declaraciones' };
  const destino = params.get('destino') || '';
  const uuid = params.get('uuid') || '';
  if (uuid) term = uuid;
  navigate(vistas200c[vista] || 'home');
  if (destino) irDestino200b(vistas200c[vista] || 'home', destino);
  if (uuid) setTimeout(() => {
    const row = invoices.find(item => String(item.id).toUpperCase() === uuid.toUpperCase());
    if (row) invoiceDetail(row);
  }, 700);
}
function aplicarDestino200b() {
  if (!destinoPendiente200b) return;
  const id = destinoPendiente200b;
  destinoPendiente200b = '';
  const buscar = () => document.querySelector('[data-destino200b="' + id + '"]');
  let el = buscar();
  if (!el) { setTimeout(() => { el = buscar(); if (el) realzar200b(el); }, 350); return; }
  realzar200b(el);
}
function realzar200b(el) {
  try { el.scrollIntoView({ block: 'center', behavior: 'smooth' }); } catch { /* sin scroll: el realce basta */ }
  el.classList.add('destino-realce200b');
  setTimeout(() => el.classList.remove('destino-realce200b'), 2400);
}
