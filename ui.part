function plural290(cantidad, singular, pluralForma) {
  const n = Math.abs(Math.round(Number(cantidad) || 0));
  return n + ' ' + (n === 1 ? singular : (pluralForma || singular + 's'));
}
function diasTexto290(cantidad) { return plural290(cantidad, 'día', 'días'); }
/* Expandible con cableado propio (2.9.0 · Bloque C): botón +
   región con estado, sin depender de <details> — los dos
   expandibles que la auditoría cazó muertos (Diario de
   consultas del Buzón y «Cómo funciona» de Avisos) usaban
