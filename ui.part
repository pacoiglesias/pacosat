}
function buzonMenuTexto202(data) {
  return buzonEstado290(data).texto;
}
async function pintarBuzonMenu202() {
  const el = document.getElementById('buzon-menu-estado202');
  if (!el) return;
  if (typeof satToken === 'undefined' || !satToken || !scope) { el.textContent = ''; return; }
  try {
    const data = await satApi('tributario?rfc=' + encodeURIComponent(scope));
    if (el.isConnected) el.textContent = buzonMenuTexto202(data);
  } catch { if (el.isConnected) el.textContent = ''; }
}
/* Paseo en casa (2.8.0): la sede que el estado sirve
