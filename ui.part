   verbo + objeto. */
function primaryLabel() {
  /* Regla de cabecera (1.32.1, auditoría de caminos G1): ninguna
     etiqueta promete lo que su clic no hace — cada etiqueta de
     esta tabla tiene su rama en el despacho de workflows.part
     ejecutando ESA acción, y la batería ronda1321 recorre la
     tabla contra el despacho para todas las pantallas/pestañas.
     Recibidos: la cabecera ES «Marcar todo leído» (el mismo
     botón de su franja, por su gancho de clase). Buzón
     Tributario: «Consultar ahora» consulta de verdad (antes
     caía al importador de archivos: la promesa más rota). */
  if (page === 'sat') return { descargar: 'Descargar CFDI del SAT', estado: 'Revisar mis CFDI ahora', listas: 'Actualizar listados', descargado: 'Actualizar estado', ejecutor: satData?.ejecutor?.emparejado ? 'Tu ejecutor' : 'Emparejar un ejecutor en mi equipo' }[satTab] || 'Descargar CFDI del SAT';
  /* Las ex-pestañas del Centro SAT son vistas propias (2.0.1):
     su primario es el de su ficha, con la misma rama de despacho. */
  if (page === 'descargar') return 'Descargar CFDI del SAT';
  if (page === 'monitor') return 'Revisar mis CFDI ahora';
  if (page === 'lists') return 'Actualizar listados';
  if (page === 'coverage') return 'Actualizar estado';
  if (page === 'ejecutor') return satData?.ejecutor?.emparejado ? 'Tu ejecutor' : 'Emparejar un ejecutor en mi equipo';
  if (page === 'reportes') return 'Exportación completa';
  if (page === 'settings') return { general: 'Guardar ajustes', contribuyentes: 'Agregar RFC', correo: 'Guardar el correo', respaldos: 'Crear respaldo', sinconexion: 'Sincronizar ahora', sistema: 'Actualizar estado', acerca: 'Ver la versión', api: 'Actualizar el panel' }[ajustesSection] || 'Guardar ajustes';
  if (page === 'salidas') return { cierre: 'Exportación completa', calendario: 'Elegir el mes del cierre', diot: 'Exportar CSV', reportes: 'Exportación completa' }[cierreSection] || 'Exportación completa';
  /* Primario contextual (2.0, hallazgo 1.3): en Facturas manda
     la descarga del SAT (su rama en el despacho abre la misma
     hoja que su botón «Descargar del SAT»); en Hoy manda el
     paso del día según la causa viva, y si no hay gesto
     protagonista, descargar CFDI del SAT. */
  if (page === 'invoices') return 'Descargar del SAT';
  if (page === 'home') return pasoHoy200();
  return screens[page][2];
}
/* El paso del día para el primario de Hoy (2.0): solo gestos
