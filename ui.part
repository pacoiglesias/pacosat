  recientes.setAttribute('data-sys-activity', '');
  wrap.append(vivos, recientes);
  if (typeof satToken !== 'undefined' && satToken) {
    const cargar = async () => {
      if (wrap.isConnected === false) { clearInterval(reloj); return; }
      try { pintarHoyVivo240(await satApi('activity'), vivos); } catch { /* sin lectura: se queda lo pintado */ }
    };
    const reloj = setInterval(cargar, 30000);
