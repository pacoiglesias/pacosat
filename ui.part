     abre con su resumen y su fecha. Solo el acceso: el estado
     de las Listas vive en su vista y en su línea de Salud. */
  for (const [etiqueta, ir] of [['Opinión', () => irDestino200b('sat', 'opinion')],
      ['Listas 69-B', () => { satTab = 'listas'; navigate('sat'); }]]) {
    const boton = n('button', etiqueta, 'soft');
    boton.type = 'button';
    boton.onclick = ir;
    fila.append(boton);
  }
  const ponte = n('button', 'Ponte al día', 'soft');
  ponte.type = 'button';
  ponte.onclick = () => { ponte.disabled = true;
    ensureLazyPart('salud').then(() => ponteAlDia200e(ponte)).catch(() => { ponte.disabled = false; }); };
  fila.append(ponte);
  wrap.append(fila);
  return wrap;
}
/* Línea-resumen de salud y respaldo (pieza 1): su casa es
   Ajustes › Estado del sistema (y Respaldos); Hoy solo enlaza
   con su semáforo — una línea, un sitio dueño. */
function hoySaludLinea200b() {
  const wrap = panel();
  wrap.dataset.bloque200b = 'salud-linea';
  const fila = n('div', undefined, 'cp-row');
  const health = typeof satData !== 'undefined' && satData ? satData.health : null;
  const nivel = !health ? 'dim' : health.level === 'mal' ? 'bad' : health.level === 'vigilar' ? 'warn' : 'ok';
  const bh = typeof satData !== 'undefined' && satData ? satData.backupHealth : null;
  const textoRespaldo = !bh ? '' : bh.failed ? ' · el último respaldo falló' :
    bh.lastOk ? ' · respaldo del ' + fmtFechaHora(bh.lastOk) : '';
  fila.append(statusPill(nivel, nivel === 'bad' ? 'Salud: algo va mal' : nivel === 'warn' ? 'Salud: a vigilar' : nivel === 'ok' ? 'Salud: todo bien' : 'Salud: sin datos'),
    n('span', 'Salud del sistema y respaldo' + textoRespaldo + ' — su detalle vive en su pantalla.'));
  const ir = n('button', 'Ver la salud', 'soft small');
  ir.type = 'button';
  ir.onclick = () => navigate('salud');
  fila.append(ir);
  wrap.append(fila);
  return wrap;
}
/* ===== Modo «Solo lo urgente» de Hoy (2.0.1 · nº 4) =====
   Un interruptor: esconde lo que está bien (las líneas de
   estado y las tarjetas de acción) y deja solo los gestos
   pendientes («Lo que te necesita», que va tras este bloque)
   y los vencimientos (la tira fiscal). El modo normal no
   cambia ni crece: su medida sigue siendo la de la limpieza. */
let hoyUrgente201 = (() => { try { return localStorage.getItem('pacosat-hoy-urgente201') === '1'; } catch { return false; } })();
/* ===== Tira fiscal del mes en Hoy (2.0.1 · nº 15) =====
   Los vencimientos del RFC activo, del mes en curso, desde la
   MISMA fuente del calendario y del ICS (GET fiscal/calendar:
   sus eventos ya traen rfc, fecha y días que faltan). La tira
   ES la vista de los vencimientos en Hoy: ningún otro bloque
   de Hoy repite estas fechas. Sin vencimientos este mes, la
   tira no se pinta (Hoy no crece con huecos). */
function hoyFiscalTira201() {
  const tira = n('div', undefined, 'traffic-strip');
  if (typeof satToken === 'undefined' || !satToken) { tira.remove(); return tira; }
  satApi('fiscal/calendar').then(data => {
    if (!tira.isConnected) return;
    const mes = new Date().toISOString().slice(0, 7);
    const eventos = (data?.events || [])
      .filter(e => (!scope || e.rfc === scope) && String(e.date || '').startsWith(mes))
      .sort((a, b) => String(a.date).localeCompare(String(b.date)));
    if (!eventos.length) { tira.remove(); return; }
    tira.append(n('strong', 'Vencimientos de ' + MESES_TOT[Number(mes.slice(5, 7)) - 1] + ':'));
    for (const e of eventos)
      tira.append(statusPill(e.daysLeft < 0 ? 'bad' : e.daysLeft <= 5 ? 'warn' : 'dim',
        'Día ' + Number(String(e.date).slice(8)) + ' · ' + e.title +
        (e.daysLeft == null ? '' : e.daysLeft < 0 ? ' · venció hace ' + (-e.daysLeft) + ' día(s)'
          : e.daysLeft === 0 ? ' · vence hoy' : ' · en ' + e.daysLeft + ' día(s)')));
  }).catch(() => tira.remove());
  return tira;
}
/* ===== «A medias» en Hoy (2.0.1 · nº 16) =====
   Los trabajos que quedaron a medias (GET /api/a-medias201),
   como líneas con su botón «Seguir» — el destino que el
   servidor deja por pieza — dentro del flujo de «Lo que te
   necesita»: el panel solo aparece si hay algo a medias, así
   que Hoy no crece cuando no hay nada interrumpido. */
function aMedias201Panel() {
  const wrap = panel('A medias', 'Trabajos que quedaron a medias: cada uno sigue donde quedó, con su botón.');
  const body = n('div');
  wrap.append(body);
  wrap.style.display = 'none';
  if (typeof satToken === 'undefined' || !satToken) return wrap;
  satApi('a-medias201').then(data => {
    if (!wrap.isConnected) return;
    const items = (data?.items || []).filter(item => !scope || !item.rfc || item.rfc === scope);
    if (!items.length) return;
    wrap.style.display = '';
    for (const item of items) {
      const fila = n('div', undefined, 'gestos-row');
      const txt = n('div', undefined, 'gestos-txt');
      txt.append(n('strong', item.texto),
        n('p', (item.rfc ? item.rfc + ' · ' : '') + (item.at ? 'quedó a medias el ' + fmtFechaHora(item.at) : '')));
      fila.append(txt);
      const vista = item.seguir?.vista || '';
      if (vista) {
        const seguir = n('button', 'Seguir', 'primary small');
        seguir.type = 'button';
        seguir.onclick = () => {
          if (vista === 'bancos') { dineroTab = 'bancos'; navigate('money'); }
          else navigate(vista);
        };
        fila.append(seguir);
      }
      body.append(fila);
    }
  }).catch(() => {});
  return wrap;
}
/* ===== Hoy, mando único y corto (2.0.1, orden directa de
   Paco: «sigo viendo algo enredado; podría ser más limpio y
   práctico») =====
   Hoy deja de ser un resumen largo con bloques repetidos y pasa
   a ser SOLO esto, en este orden:
   (a) una línea de estado por pieza — puerta, ejecutor, última
       descarga y listas — cada una con su fecha, salida del dato
       que el cliente ya tiene (satData y el resumen de listas);
   (b) «Lo que te necesita» (el panel de gestos, que sigue tras
       este bloque en home());
   (c) las 4 acciones grandes con su estado y su fecha, y su
       botón HACE la cosa desde Hoy: descargar despacha la
       descarga del mes, buzón despacha la consulta, declara-
       ciones despacha la recuperación del ejercicio y Documen-
       tos abre su pantalla en un toque. Nada de botones que
       llevan a otra pantalla con otro botón.
   Constancia y Opinión NO viven aquí: su único sitio es
   Documentos (cero duplicados entre pantallas). */
function hoyMando201() {
  const wrap = n('section', undefined, 'panel');
  const sd = typeof satData !== 'undefined' && satData ? satData : null;
  const rfc = scope;
  const perfil = (sd?.profiles || []).find(p => p.rfc === rfc) || null;
  /* Interruptor «Solo lo urgente» (nº 4): en ese modo no se
     pintan ni las líneas de estado ni las tarjetas de acción;
     quedan los gestos (tras este bloque) y la tira fiscal. */
  const filaModo = n('div', undefined, 'actions');
  const modoBtn = n('button', hoyUrgente201 ? 'Ver Hoy completo' : 'Solo lo urgente', 'soft small');
  modoBtn.type = 'button';
  modoBtn.onclick = () => {
    hoyUrgente201 = !hoyUrgente201;
    try { localStorage.setItem('pacosat-hoy-urgente201', hoyUrgente201 ? '1' : ''); } catch {}
    render();
  };
  filaModo.append(modoBtn);
  if (hoyUrgente201) filaModo.append(n('span', 'Solo tus gestos pendientes y los vencimientos del mes.', 'muted'));
  wrap.append(filaModo);
  /* (a) Estado de las piezas, una línea por pieza con su fecha. */
  const estado = n('div', undefined, 'hoy-estado201');
  const linea = (etiqueta, texto) => {
    const fila = n('div', undefined, 'cp-row');
    fila.append(n('strong', etiqueta), n('span', texto));
    estado.append(fila);
    return fila;
  };
  const puerta = rfc ? sd?.puerta?.[rfc] : null;
  linea('Puerta del SAT', !puerta ? 'sin probar todavía'
    : (puerta.ok ? 'abre' : 'no abre') + ' · probada el ' + fmtFechaHora(puerta.probada));
  const ej = sd?.ejecutor;
  linea('Tu ejecutor', !ej?.emparejado ? 'sin emparejar todavía'
    : (ej.enLinea ? 'en línea' : 'sin señal') + (ej.ultimoVisto ? ' · última señal el ' + fmtFechaHora(ej.ultimoVisto) : ''));
  /* Trabajos esperando con el ejecutor dormido (nº 27, con la
     jerarquía de la nº 31): el dato reunido del servidor
     (ejecutorEspera201 en el estado) y el gesto EN LA PROPIA
     línea: «Ejecutar aquí». El paso de arrancar.bat ya no es
     el texto del aviso: queda como reserva discreta junto al
     botón, por si el enlace no responde. Sin emparejar, el
     gesto es otro (emparejar) y la línea lo dice con el paso
     del servidor. Solo si hay trabajos y el ejecutor no está
     en línea: si no, la línea no existe. */
  const esp201 = sd?.ejecutorEspera201;
  if (esp201 && esp201.esperando > 0 && !esp201.enLinea) {
    if (esp201.emparejado) {
      const filaEspera = linea('Trabajos esperando', number.format(esp201.esperando) +
        ' trabajo(s) en cola · tu ejecutor está dormido' +
        (esp201.ultimoVisto ? ' (sin señal desde el ' + fmtFechaHora(esp201.ultimoVisto) + ')' : '') +
        ': pulsa «Ejecutar aquí» para despertarlo.');
      const actosEspera = n('div', undefined, 'actions');
      actosEspera.append(ejecutarAqui201(true),
        n('span', 'Si el botón no responde, ábrelo con arrancar.bat en tu equipo.', 'muted'));
      filaEspera.append(actosEspera);
    } else linea('Trabajos esperando', number.format(esp201.esperando) + ' trabajo(s) en cola' +
      (esp201.paso ? ' — ' + esp201.paso : ''));
  }
  linea('Última descarga', perfil?.lastSatSuccess
    ? 'el ' + fmtFechaHora(perfil.lastSatSuccess) : 'sin descargas registradas todavía');
  const filaListas = linea('Listas del SAT', 'leyendo su última comprobación…');
  /* Foto de ejercicio cerrado tocada (nº 23): la línea solo
     aparece si el servidor marca un ejercicio sellado de este
     RFC como tocado (o sellado y en orden, en su versión
     tranquila). No se afirma qué cambió: eso no lo trae el
     dato; el detalle vive en Salud. */
  const filaFoto201 = linea('Ejercicio cerrado', '');
  if (typeof satToken !== 'undefined' && satToken && rfc) {
    satApi('ejercicios200g').then(data => {
      if (!wrap.isConnected) return;
      const sellados = (data?.ejercicios || []).filter(e => e.rfc === rfc && e.foto201);
      const tocada = sellados.find(e => e.fotoTocada201);
      if (tocada) filaFoto201.lastChild.textContent = 'el ejercicio ' + tocada.year +
        ' cambió después de su cierre (foto sellada el ' + fmtFechaHora(tocada.foto201.selladaAt) +
        '): algo lo tocó; el detalle está en Salud.';
      else if (sellados.length) filaFoto201.lastChild.textContent = 'sellado y sin cambios tras su cierre';
      else filaFoto201.remove();
    }).catch(() => filaFoto201.remove());
  } else filaFoto201.remove();
  if (!hoyUrgente201) wrap.append(estado);
  /* La tira fiscal va en los dos modos (nº 15): en el urgente
     es, con los gestos, lo único que queda. */
  wrap.append(hoyFiscalTira201());
  if (typeof satToken !== 'undefined' && satToken && typeof listsResumen201 === 'function') {
    satApi('lists').then(data => {
      if (!wrap.isConnected) return;
      const r = listsResumen201(data);
      filaListas.lastChild.textContent = r.texto;
      const menuTxt = document.getElementById('lists-menu-estado201');
      if (menuTxt) menuTxt.textContent = r.corto;
    }).catch(() => { if (wrap.isConnected) filaListas.lastChild.textContent = 'sin comprobar todavía'; });
  } else filaListas.lastChild.textContent = 'sin comprobar todavía';
  /* (c) Las 4 acciones grandes. */
  const grid = n('div', undefined, 'cmd-grid');
  const tarjeta = (titulo, estadoTxt, botonTxt, hacer, primario) => {
    const card = n('div', undefined, 'cmd-card');
    const textos = n('div', undefined, 'cmd-texts');
    textos.append(n('strong', titulo, 'cmd-title'), n('span', estadoTxt, 'cmd-last'));
    const btn = n('button', botonTxt, primario ? 'primary' : 'soft');
    btn.type = 'button';
    btn.onclick = () => hacer(btn);
    const acts = n('div', undefined, 'cmd-actions');
    acts.append(btn);
    card.append(textos, acts);
    grid.append(card);
    return textos;
  };
  const hoy = new Date();
  const rango = typeof downloadShortcutRange === 'function'
    ? downloadShortcutRange('mes', hoy.toISOString().slice(0, 10))
    : { start: hoy.toISOString().slice(0, 7) + '-01', end: hoy.toISOString().slice(0, 10) };
  tarjeta('Descargar facturas',
    perfil?.lastSatSuccess ? 'Última descarga el ' + fmtFechaHora(perfil.lastSatSuccess) : 'Sin descargas registradas todavía',
    'Descargar este mes',
    () => { if (scope && typeof downloadSheet === 'function') downloadSheet(scope, { start: rango.start, end: rango.end }); else showSatDownload(); }, true);
  const textosBuzon = tarjeta('Buzón Tributario', 'Leyendo su última consulta…', 'Consultar el buzón',
    btn => {
      if (!rfc) { navigate('tributario'); return; }
      /* Confirmación con pre-vuelo (nº 5 + nº 21): el resumen
         y el estado de la puerta ANTES de despachar. */
      confirmarDespacho201({
        titulo: 'Consultar el Buzón Tributario',
        lineas: ['Se listarán las notificaciones del Buzón Tributario de ' + rfc +
          ' desde tu equipo, con tu e.firma. No se abre ninguna notificación: abrirla es un gesto tuyo en el portal.'],
        rfc, boton: 'Consultar el buzón',
        alConfirmar: async () => {
          btn.disabled = true;
          try { await satApi('tributario/run', { rfc }); toast('Consulta del Buzón pedida: se corre en tu equipo con tu e.firma.', 'ok'); }
          catch (error) { toast(error.message, 'error'); }
          btn.disabled = false;
        } });
    });
  const textosDecl = tarjeta('Declaraciones', 'Leyendo el ejercicio ' + hoy.getFullYear() + '…', 'Recuperar declaraciones',
    btn => {
      if (typeof declRun !== 'function') { navigate('declaraciones'); return; }
      confirmarDespacho201({
        titulo: 'Recuperar declaraciones',
        lineas: ['Se recuperarán del portal las declaraciones del ejercicio ' + hoy.getFullYear() +
          ' de ' + rfc + ' con sus acuses, y quedarán archivadas en Documentos.'],
        rfc, boton: 'Recuperar declaraciones',
        alConfirmar: () => {
          declEjercicio = hoy.getFullYear();
          declRun('mensuales', () => { if (page === 'home') render(); }, btn);
        } });
    });
  /* El ejecutor en las tarjetas que lo necesitan (nº 31): la
     MISMA tarjeta que enseña el estado lleva su gesto. Si
     está despierto — lo normal: vive residente con arranque
     automático — el botón queda discreto, como acción
     secundaria. Si está dormido, el botón ES el gesto, ahí
     mismo, sin ir a otra pantalla. Sin emparejar no se
     pinta: su gesto es emparejar, y vive en su panel. */
  const ejecutorEnTarjeta201 = textos => {
    if (!ej?.emparejado || !textos?.parentElement) return;
    const fila = n('div', undefined, 'cmd-actions');
    if (ej.enLinea) fila.append(n('span', 'Tu ejecutor está despierto.', 'muted'), ejecutarAqui201(false));
    else fila.append(n('span', 'Tu ejecutor está dormido: sin él, esto queda en cola.', 'muted'), ejecutarAqui201(true));
    textos.parentElement.append(fila);
  };
  ejecutorEnTarjeta201(textosBuzon);
  ejecutorEnTarjeta201(textosDecl);
  const docsRfc = documents.filter(doc => !doc.archived && (!rfc || doc.rfc === rfc));
  const ultimoDoc = docsRfc.map(d => d.date || '').sort().pop();
  tarjeta('Documentos',
    docsRfc.length ? number.format(docsRfc.length) + ' documento(s) en el expediente' + (ultimoDoc ? ' · el último, del ' + dateLabel(ultimoDoc) : '')
      : 'El expediente está vacío todavía',
    'Abrir Documentos', () => navigate('docs'));
  if (!hoyUrgente201) wrap.append(grid);
  /* Estado vivo del Buzón y de Declaraciones: salen de las
     mismas lecturas que sus pantallas ya hacen (tributario y
     declaraciones del ejercicio en curso); si fallan, la
     tarjeta dice que no se pudo leer, sin inventar el dato. */
  if (typeof satToken !== 'undefined' && satToken && rfc) {
    satApi('tributario?rfc=' + encodeURIComponent(rfc)).then(data => {
      if (!wrap.isConnected) return;
      textosBuzon.lastChild.textContent = !data?.ultimaConsulta && !data?.total
        ? 'Sin consultar todavía'
        : (data.sinAbrir ? number.format(data.sinAbrir) + ' sin abrir' : 'Sin notificaciones pendientes') +
          (data.ultimaConsulta ? ' · consultado el ' + fmtFechaHora(data.ultimaConsulta) : '');
    }).catch(() => { if (wrap.isConnected) textosBuzon.lastChild.textContent = 'No se pudo leer su estado'; });
    satApi('declaraciones?rfc=' + encodeURIComponent(rfc) + '&ejercicio=' + hoy.getFullYear()).then(data => {
      if (!wrap.isConnected) return;
      const res = data?.resumen || {};
      const fechas = (data?.documentos || []).map(d => d.fechaPresentacion || '').filter(Boolean).sort();
      textosDecl.lastChild.textContent = 'Ejercicio ' + hoy.getFullYear() + ': ' +
        number.format(res.presentadas || 0) + ' presentada(s) en el expediente' +
        (fechas.length ? ' · la última, del ' + dateLabel(fechas[fechas.length - 1]) : '');
    }).catch(() => { if (wrap.isConnected) textosDecl.lastChild.textContent = 'No se pudo leer su estado'; });
  }
  return wrap;
}
/* Panel general de contribuyentes (pieza 9): TODOS los RFC,
   ordenados por urgencia, cada fila SOLO con lo de su RFC
   (puerta, última descarga, avisos sin abrir de su Buzón y
   próximo vencimiento de su e.firma — cada dato, de su
   registro). Tocar una fila fija el ámbito y lleva a su Hoy. */
function contribuyentesPanel200b() {
  const wrap = panel('Contribuyentes', 'Todos tus RFC de un vistazo, primero quien necesita un gesto. Toca uno para entrar a su Hoy.');
  wrap.dataset.bloque200b = 'panel-contribuyentes';
  const sd = typeof satData !== 'undefined' && satData ? satData : null;
  const perfiles = new Map((sd?.profiles || []).map(p => [p.rfc, p]));
  const filas = people.map(person => ({ rfc: person.id, nombre: person.name }));
  for (const p of sd?.profiles || [])
    if (!filas.some(f => f.rfc === p.rfc)) filas.push({ rfc: p.rfc, nombre: p.pending ? 'Alta preparada (faltan credenciales)' : 'Contribuyente' });
  filas.sort((a, b) => urgenciaRfc200b(b.rfc) - urgenciaRfc200b(a.rfc) || a.nombre.localeCompare(b.nombre, 'es-MX'));
  if (!filas.length) { wrap.append(n('p', 'Sin contribuyentes todavía.', 'empty')); return wrap; }
  /* Imprimir la lista tal cual se ve (2.0.1 · nº 2): el mismo
     patrón de Facturas/Dinero/Documentos, con membrete. */
  const filasImprimir201 = [];
  wrap.querySelector('.panel-head')?.append(action('Imprimir', () => imprimirVista201('Contribuyentes',
    'Todos tus RFC de un vistazo, en el orden de la pantalla.',
    ['Contribuyente', 'Puerta', 'Última descarga', 'Avisos sin abrir', 'e.firma'], filasImprimir201), 'metric-link', 'print'));
  for (const fila of filas) {
    const perfil = perfiles.get(fila.rfc);
    const salud = saludRfc200b(fila.rfc);
    const row = n('button', undefined, 'contrib-row200b');
    row.type = 'button';
    row.dataset.rfc = fila.rfc;
    const ultima = perfil?.lastSatSuccess ? fmtFechaHora(perfil.lastSatSuccess) : 'sin descargas registradas';
    const sinAbrir = Number(sd?.tributario?.[fila.rfc]?.sinAbrir || 0);
    const vence = perfil?.certExpires ? 'e.firma vence el ' + fmtFechaCorta(perfil.certExpires) : 'sin vencimiento a la vista';
    filasImprimir201.push([fila.nombre + ' · ' + fila.rfc, salud.porque, ultima, number.format(sinAbrir), vence]);
    const txt = n('span', undefined, 'contrib-txt200b');
    txt.append(n('strong', fila.nombre + ' · ' + fila.rfc),
      n('small', 'Puerta: ' + salud.porque + ' · Última descarga: ' + ultima +
        ' · Avisos sin abrir: ' + number.format(sinAbrir) + ' · ' + vence));
    const punto = n('span', undefined, 'salud-punto200b');
    punto.dataset.nivel = salud.nivel;
    punto.title = salud.porque;
    row.append(medallon200b(fila.rfc, fila.nombre), txt, punto);
    row.onclick = () => {
      scope = fila.rfc;
      const a1 = $('scope'); if (a1) a1.value = scope;
      const a2 = $('scope-top'); if (a2) a2.value = scope;
      navigate('home');
    };
    wrap.append(row);
  }
  return wrap;
}
function contribuyentesScreen200b() { return [contribuyentesPanel200b()]; }
/* Selector global desplegable (2.0 · pieza 8): el botón de la
   cabecera enseña el medallón y el nombre del contribuyente en
   ámbito; su panel trae buscador (visible desde 5 RFC: con
   1–2 sigue siendo un toque, como hoy), el punto de salud
   compuesto de cada RFC con su porqué en el título, y el
   «Ver todos» que abre el panel general. Elegir un RFC fija
   el ámbito y repinta, como hacía el selector de siempre. */
function pintarBotonScope200b() {
  const btn = $('scope-menu-btn200b');
  if (!btn || !btn.replaceChildren) return;
  const persona = people.find(p => p.id === scope);
  const salud = saludRfc200b(scope);
  const punto = n('span', undefined, 'salud-punto200b');
  punto.dataset.nivel = salud.nivel;
  punto.title = salud.porque;
  btn.replaceChildren(medallon200b(scope, persona?.name || scope),
    n('span', persona ? persona.name + ' · ' + scope : 'Sin contribuyente', 'scope-nombre200b'), punto);
  btn.title = 'Contribuyente: ' + (persona?.name || scope || '—') + ' — ' + salud.porque;
}
function pintarScopeMenu200b(filtro = '') {
  const menu = $('scope-menu200b');
  if (!menu) return;
  menu.replaceChildren();
  if (people.length >= 5) {
    const buscar = input('search', { placeholder: 'Buscar por nombre o RFC…', 'aria-label': 'Buscar contribuyente' });
    buscar.value = filtro;
    buscar.oninput = () => { pintarScopeMenu200b(buscar.value); const b2 = menu.querySelector('input'); if (b2) { b2.focus(); b2.setSelectionRange?.(b2.value.length, b2.value.length); } };
    menu.append(buscar);
  }
  const needle = filtro.trim().toLocaleLowerCase('es-MX');
  const ordenadas = [...people].sort((a, b) => urgenciaRfc200b(b.id) - urgenciaRfc200b(a.id) || a.name.localeCompare(b.name, 'es-MX'));
  let visibles = 0;
  for (const persona of ordenadas) {
    if (needle && !(persona.name + ' ' + persona.id).toLocaleLowerCase('es-MX').includes(needle)) continue;
    visibles++;
    const salud = saludRfc200b(persona.id);
    const row = n('button', undefined, 'scope-menu-row200b');
    row.type = 'button';
    row.dataset.rfc = persona.id;
    const punto = n('span', undefined, 'salud-punto200b');
    punto.dataset.nivel = salud.nivel;
    punto.title = salud.porque;
    row.append(medallon200b(persona.id, persona.name), n('span', persona.name + ' · ' + persona.id, 'scope-nombre200b'), punto);
    row.onclick = () => {
      scope = persona.id;
      const a1 = $('scope'); if (a1) a1.value = scope;
      const a2 = $('scope-top'); if (a2) a2.value = scope;
      menu.hidden = true;
      $('scope-menu-btn200b')?.setAttribute('aria-expanded', 'false');
      render();
    };
    menu.append(row);
  }
  if (!visibles) menu.append(n('p', 'Ningún contribuyente coincide con esa búsqueda.', 'muted'));
  const todos = n('button', 'Ver todos los contribuyentes', 'soft small');
  todos.type = 'button';
  todos.onclick = () => { menu.hidden = true; navigate('contribuyentes'); };
  menu.append(todos);
}
(function cablearScopeMenu200b() {
  const btn = typeof document !== 'undefined' ? document.getElementById('scope-menu-btn200b') : null;
  if (!btn || !btn.addEventListener) return;
  btn.addEventListener('click', () => {
    const menu = $('scope-menu200b');
    if (!menu) return;
    const abrir = menu.hidden;
    if (abrir) pintarScopeMenu200b('');
    menu.hidden = !abrir;
    btn.setAttribute('aria-expanded', String(abrir));
  });
  /* Buscador colapsable en móvil (2.0 · pieza 6): tras su
     icono; al tocarlo, la cabecera enseña el campo y lo enfoca. */
  const lupa = document.getElementById('search-toggle200b');
  if (lupa && lupa.addEventListener) lupa.addEventListener('click', () => {
    const top = document.querySelector('.top');
    if (top) top.classList.toggle('busqueda200b');
    const input = document.getElementById('global-search');
    if (input) { input.focus(); input.select?.(); }
  });
})();
/* Asignar el color de un RFC (2.0 · pieza 7): en servidor va
   por /api/settings (mapa rfcColors) y el estado servido lo
   trae de vuelta; sin servidor, vive en este navegador con
   los demás ajustes de identidad. */
async function asignarColor200b(rfc, color) {
  if (typeof satToken !== 'undefined' && satToken) {
    const result = await satApi('settings', { installName: appSettings.installName, senderName: appSettings.senderName,
      accent: appSettings.accent, rfcColor: { rfc, color } });
    appSettings = { ...appSettings, ...result.settings, logoData: appSettings.logoData };
    if (typeof satData !== 'undefined' && satData) satData.settings = result.settings;
  } else {
    appSettings.rfcColors = { ...(appSettings.rfcColors || {}) };
    if (color) appSettings.rfcColors[rfc] = color; else delete appSettings.rfcColors[rfc];
    try {
      const previo = JSON.parse(localStorage.getItem('pacosat-settings') || '{}');
      localStorage.setItem('pacosat-settings', JSON.stringify({ ...previo, rfcColors: appSettings.rfcColors }));
    } catch { /* sin memoria local: vale por la sesión */ }
  }
  render();
}
function colorPicker200b() {
  const wrap = panel('Color de cada contribuyente',
    'Un color por RFC, de la paleta cerrada de la casa: se ve como un medallón fino junto a su nombre — en el selector, en Hoy y en el panel general. No cambia el color de la app ni sale en reportes o correos.');
  wrap.dataset.bloque200b = 'color-rfc';
  for (const persona of people) {
    const row = n('div', undefined, 'cp-row');
    row.append(medallon200b(persona.id, persona.name), n('span', persona.name + ' · ' + persona.id));
    const opciones = n('div', undefined, 'swatches');
    const actual = rfcColorClave200b(persona.id);
    const sinColor = n('button', 'Sin color', 'swatch');
    sinColor.type = 'button';
    sinColor.setAttribute('aria-pressed', String(!actual));
    sinColor.onclick = () => asignarColor200b(persona.id, '').catch(error => toast(error.message, 'error'));
    opciones.append(sinColor);
    for (const [clave, hex, etiqueta] of RFC_PALETA200B) {
      const b = n('button', undefined, 'swatch');
      b.type = 'button';
      b.title = etiqueta;
      b.setAttribute('aria-pressed', String(actual === clave));
      const dot = n('span', undefined, 'swatch-dot');
      dot.style.background = hex;
      b.append(dot, n('span', etiqueta));
      b.onclick = () => asignarColor200b(persona.id, clave).catch(error => toast(error.message, 'error'));
      opciones.append(b);
    }
    row.append(opciones);
    wrap.append(row);
  }
  if (!people.length) wrap.append(n('p', 'Sin contribuyentes todavía.', 'empty'));
  return wrap;
}

/* ===== Carga diferida de pantallas (1.24.0, punto 4b) =====
   Pagos, Bancos (dentro de Dinero) y Reportes (dentro de Cierre)
   viajan en partes que el servidor sirve en /parte/<nombre> y
   que la CSP autoriza por su huella. La primera entrada las
   pide, enseña su «cargando» honesto y pinta al llegar; en
   reposo se precargan solas. Si la parte no llega, la pantalla
   enseña el error con su reintento — nunca un hueco muerto. */
const lazyLoadedParts = new Set(), lazyPartPromises = new Map();
function ensureLazyPart(name) {
  if (lazyLoadedParts.has(name)) return Promise.resolve(true);
  if (lazyPartPromises.has(name)) return lazyPartPromises.get(name);
  const url = typeof PACOSAT_LAZY !== 'undefined' ? PACOSAT_LAZY[name] : null;
  if (!url || typeof fetch !== 'function') return Promise.resolve(false);
  const promise = fetch(url).then(response => {
    if (!response.ok) throw new Error('HTTP ' + response.status);
    return response.text();
  }).then(code => {
    const el = document.createElement('script');
    el.textContent = code;
    document.head.appendChild(el);
    lazyLoadedParts.add(name);
    return true;
  }).catch(() => { lazyPartPromises.delete(name); return false; });
  lazyPartPromises.set(name, promise);
  return promise;
}
function lazyPartForView(view) {
  if (view === 'pagos') return 'pagos';
  if (view === 'registro') return 'registro';
  if (view === 'salud') return 'salud';
  if (view === 'salidas' && cierreSection === 'reportes') return 'salidas';
  /* Reportes (2.0.1) vive en la parte de salidas: sus botones
     piden los artefactos que esa parte ya sabe descargar. */
  if (view === 'reportes') return 'salidas';
  if (view === 'dinero' && dineroTab === 'bancos') return 'bancos';
  return null;
}
function paintLazyState(name) {
  const [title, description] = screens[page];
  $('title').textContent = title;
  $('crumb').textContent = title;
  $('subtitle').textContent = description;
  const body = $('body');
  const wrap = panel(title);
  const note = n('p', 'Cargando esta pantalla…', 'today-line');
  wrap.append(note);
  body.replaceChildren(wrap);
  ensureLazyPart(name).then(ok => {
    if (lazyPartForView(page) !== name) return;
    if (ok) { render(); return; }
    note.textContent = 'Esta pantalla no se pudo cargar (la parte no llegó del servidor).';
    const retry = n('button', 'Reintentar', 'primary small');
    retry.type = 'button';
    retry.onclick = () => render();
    wrap.append(retry);
  });
}
/* Precarga en reposo: tras el primer pintado, las partes llegan
   sin prisa para que la primera entrada real sea instantánea. */
function prefetchLazyParts() {
  try {
    if (typeof fetch !== 'function' || typeof PACOSAT_LAZY === 'undefined') return;
    const go = () => { for (const name of Object.keys(PACOSAT_LAZY)) ensureLazyPart(name); };
    if (typeof requestIdleCallback === 'function') requestIdleCallback(go, { timeout: 5000 });
    else if (typeof setTimeout === 'function') setTimeout(go, 3500);
  } catch { /* la precarga es un extra: jamás rompe el arranque */ }
}
function render() {
  const lazyName = lazyPartForView(page);
  if (lazyName && !lazyLoadedParts.has(lazyName)) { paintLazyState(lazyName); return; }
  const [title, description] = screens[page];
  $('title').textContent = title;
  $('crumb').textContent = title;
  $('subtitle').textContent = description;
  $('eyebrow').textContent = scope || 'ESPACIO FISCAL';
  /* Contadores fuera de la cabecera (1.32.1, G3): «N CFDI ·
     N PDF · N RFC» se repetía en TODAS las pantallas y en Hoy
     duplicaba sus propias métricas. Los conteos viven donde se
     trabaja con ellos (Hoy y Facturas); la cabecera queda limpia. */
  const headerCounts = $('counters');
  if (headerCounts) headerCounts.textContent = '';
  /* Importar vive en Hoy y en Facturas: fuera de ahí, la cabecera no
     lleva «Abrir XML / Factura PDF» (sistema visual §4). */
  const importingHere = page === 'home' || page === 'invoices';
  if ($('inspect')) $('inspect').hidden = !importingHere;
  if ($('pdf-import')) $('pdf-import').hidden = !importingHere;
  $('primary').replaceChildren(icon(page === 'settings' && ajustesSection === 'respaldos' ? 'lock' : page === 'salidas' && cierreSection === 'diot' ? 'down' : 'up'), n('span', primaryLabel()));
  $('primary').disabled = !ready || importing;
  /* El mapa se resuelve con typeof para las pantallas de las
     partes diferidas: nombrar pagosScreen antes de que su parte
     cargue lanzaría ReferenceError incluso pintando otra
     pantalla; la puerta de arriba garantiza que, cuando la
     vista es la suya, la función ya existe. */
  const content = ({ home, contribuyentes: contribuyentesScreen200b, avisos: avisosScreen, buzon: buzonScreen, tributario: tributarioScreen, invoices: invoiceScreen, docs: docsView, dinero: dineroView,
    declaraciones: declaracionesScreen,
    lists: typeof listsScreen === 'function' ? listsScreen : null,
    reportes: typeof reportesScreen201 === 'function' ? reportesScreen201 : null,
    monitor: typeof monitorScreen === 'function' ? monitorScreen : null,
    coverage: typeof coverageScreen === 'function' ? coverageScreen : null,
    ejecutor: typeof executorPanel === 'function' ? () => [executorPanel()] : null,
    descargar: typeof satDownloadScreen === 'function' ? satDownloadScreen : null,
    registro: typeof registroScreen === 'function' ? registroScreen : null,
    salud: typeof saludScreen200d === 'function' ? saludScreen200d : null,
    archivo: typeof archivoScreen1311 === 'function' ? archivoScreen1311 : null,
    pagos: typeof pagosScreen === 'function' ? pagosScreen : null,
    sat: satView, salidas: cierreView, settings: ajustesView, preguntas: preguntasScreen })[page]();
  for (const el of content) el.classList?.add('view-in');
  /* Pintado progresivo (2.0 · tanda 2, O2): el primer
     pantallazo (en Hoy: semáforo + gestos) pinta sin esperar
     al resto — los bloques bajo el pliegue llevan la clase
     .pintado-progresivo200b (content-visibility: auto con su
     hueco honesto de tamaño): el navegador los pinta al
     acercarse y, en reposo, la precarga de partes diferidas
     (prefetchLazyParts) ya usa requestIdleCallback. El DOM y
     su texto están completos desde el primer momento: las
     pruebas que leen el texto entero de Hoy no esperan a
     ningún pintado, y el orden visual final no cambia. El
     modo síncrono para pruebas es el propio diseño: no hay
     contenido que nazca tarde en el DOM. */
  if (page === 'home') content.forEach((el, i) => {
    if (i >= 2) el.classList?.add('pintado-progresivo200b');
  });
  /* Señales de la barra (1.31.1): cada pintado refresca el
     punto de la puerta y la señal de gestos con el estado que
     el servidor ya trajo — sin llamadas nuevas. */
  if (typeof senalesBarra1311 === 'function') { try { senalesBarra1311(); } catch { /* señal decorativa */ } }
  /* El botón del selector global refleja el ámbito y su
     salud en cada pintado (2.0 · pieza 8). */
  try { pintarBotonScope200b(); } catch { /* selector decorativo */ }
  $('body').replaceChildren(...content);
  applySettings();
}
/* Píldora de estado común (1.6.11): un solo lenguaje de semáforo en
   toda la app. ok = verde, warn = ámbar, bad = rojo, dim = gris (sin
   dato o en descanso: no es un problema). Pulsarla lleva a su pantalla. */
function statusPill(state, label, hint, onClick) {
  const pill = n('button', undefined, 'status-pill');
  pill.type = 'button';
  pill.dataset.state = state;
  pill.append(n('span', undefined, 'pill-dot'), n('span', label));
  if (hint) pill.title = hint;
  if (onClick) pill.onclick = onClick; else pill.disabled = true;
  return pill;
}
/* Pantalla «Hoy en PacoSAT» (1.6.11): resumen del día, pendientes con
   semáforo y UN siguiente paso sugerido. El interruptor general de
   descanso vive aquí y en el Centro SAT (la misma pieza). */
/* Caché compartida del panel «Hoy» (1.11.0); la invalida el pulso
   cuando detecta cambios en el servidor. */
let todayCache = { at: 0, data: null };
/* V1 · Semáforo del día (1.31.0): UNA pastilla grande según el
   estado real — fallos del Registro en 24 h (satData.registroResumen
   si el servidor lo trae en el estado; si no, el resumen que Hoy
   ya pide a registro/resumen), los avisos que necesitan tu gesto
   y la puerta auto-probada. Lo que no conste no se afirma: la
   pastilla de orden solo sale cuando esos tres datos, los que
   hay, no traen nada en contra. */
function hoySemaforoPintar1310(avisos, registro) {
  const franja = document.querySelector('[data-semaforo1310]');
  if (!franja) return;
  const resumenSrv = typeof satData !== 'undefined' && satData ? satData.registroResumen : null;
  const fallos = Number(resumenSrv?.fallos ?? registro?.fallos ?? 0) || 0;
  const necesita = Number(avisos?.counts?.necesita ??
    (avisos?.avisos || []).filter(aviso => aviso.clase === 'necesita').length) || 0;
  const puerta = typeof satData !== 'undefined' && satData ? satData.puerta : null;
  const puertaNoAbre = puerta
    ? (scope ? Boolean(puerta[scope]?.probada && puerta[scope]?.ok === false)
      : Object.values(puerta).some(veredicto => veredicto?.probada && veredicto?.ok === false))
    : false;
  let pill;
  if (fallos > 0) pill = statusPill('bad', 'Algo falló',
    fallos + ' fallo(s) en las últimas 24 h, según el Registro', () => navigate('registro'));
  else if (necesita > 0 || puertaNoAbre) pill = statusPill('warn', 'Te toca algo',
    [necesita ? necesita + ' aviso(s) necesitan tu gesto' : '',
      puertaNoAbre ? (causaP200(scope ? puerta[scope] : null, satData.ejecutor).tipo === 'equipo'
        ? 'tu equipo no responde: la puerta se probará sola al volver' : 'la puerta del SAT consta que no abre') : '']
      .filter(Boolean).join(' · '),
    () => navigate('avisos'));
  else pill = statusPill('ok', 'Todo en orden',
    'Sin fallos en 24 h, sin avisos que te necesiten y sin puerta cerrada que conste');
  franja.replaceChildren(pill);
}
/* V4 · Semana fiscal (1.31.0): hoy y los seis días siguientes,
   con un punto en los días en que algo vence o se espera — la
   próxima notificación que se tiene por notificada (solo si el
   tributario la conoce; si no, ese marcador no se pinta), el
   día 17 como límite de la declaración mensual del mes en
   curso y los avisos con fecha que la lista de Hoy conozca.
   Cada día lleva su número y el punto lleva el título. */
function hoySemanaPintar1310(avisos) {
  const fila = document.querySelector('[data-semana1310]');
  if (!fila) return;
  const marcas = new Map();
  const marcar = (key, titulo) => {
    if (!key) return;
    if (!marcas.has(key)) marcas.set(key, []);
    marcas.get(key).push(titulo);
  };
  const claveDe = d => d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' +
    String(d.getDate()).padStart(2, '0');
  const tenida = typeof tribTenidaFor === 'function' ? tribTenidaFor(scope) : null;
  if (tenida?.tenida) marcar(String(tenida.tenida).slice(0, 10), 'Una notificación se tiene por notificada');
  const hoy = new Date();
  marcar(hoy.getFullYear() + '-' + String(hoy.getMonth() + 1).padStart(2, '0') + '-17',
    'Día 17: límite de la declaración mensual de este mes');
  for (const aviso of avisos?.avisos || []) {
    if (!aviso.vence) continue;
    const vence = new Date(aviso.vence);
    if (Number.isNaN(vence.getTime())) continue;
    marcar(claveDe(vence), aviso.titulo || 'Aviso con fecha');
  }
  fila.replaceChildren();
  const DIAS_CORTOS = ['dom', 'lun', 'mar', 'mié', 'jue', 'vie', 'sáb'];
  for (let i = 0; i < 7; i++) {
    const diaFecha = new Date(hoy.getFullYear(), hoy.getMonth(), hoy.getDate() + i);
    const titulos = marcas.get(claveDe(diaFecha));
    const dia = n('div', undefined, 'semana-dia');
    if (i === 0) dia.dataset.hoy = '1';
    dia.append(n('small', DIAS_CORTOS[diaFecha.getDay()]), n('strong', String(diaFecha.getDate())));
    if (titulos?.length) {
      dia.title = titulos.join(' · ');
      const punto = n('span', '●', 'semana-punto');
      punto.title = titulos.join(' · ');
      dia.append(punto);
    }
    fila.append(dia);
  }
}
function todayPanel() {
  const wrap = panel();
  const head = n('div', undefined, 'panel-head');
  const titleBox = n('div');
  const nowDate = new Date();
  titleBox.append(n('h2', 'Hoy en PacoSAT'),
    n('p', nowDate.toLocaleDateString('es-MX', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' })));
  head.append(titleBox);
  if (typeof satToken !== 'undefined' && satToken && typeof restSwitch === 'function') head.append(restSwitch());
  wrap.append(head);
  /* V1+V4 (1.31.0): el semáforo del día y la franja de la semana
     fiscal abren la pantalla. Nacen VACÍOS a propósito: los pinta
     la parte asíncrona con los datos que Hoy ya carga (el resumen
     del Registro, los avisos y la puerta) — sin datos no se
     afirma ningún estado. */
  const semaforo1310 = n('div', undefined, 'traffic-strip');
  semaforo1310.dataset.semaforo1310 = '1';
  wrap.append(semaforo1310);
  const semana1310 = n('div', undefined, 'semana-fiscal');
  semana1310.dataset.semana1310 = '1';
  wrap.append(semana1310);
  const todayKey = nowDate.getFullYear() + '-' + String(nowDate.getMonth() + 1).padStart(2, '0') + '-' + String(nowDate.getDate()).padStart(2, '0');
  const todays = invoices.filter(row => row.date.startsWith(todayKey));
  let efos = 0, cancelled = 0;
  for (const row of invoices) {
    const state = invoiceStateOf(row);
    if (state === 'efos') efos++; else if (state === 'Cancelado') cancelled++;
  }
  wrap.append(n('p', todays.length ?
    'Hoy se registraron ' + todays.length + (todays.length === 1 ? ' CFDI nuevo.' : ' CFDI nuevos.') :
    'Hoy todavía no se registran CFDI nuevos.', 'today-line'));
  /* «Mientras no estabas» (1.25.0, mejora nº 9): hueco del
     resumen desde la última visita; lo rellena la parte asíncrona
     con el resumen del servidor y su botón de «visto». */
  const digestBox = n('div', undefined, 'mne-box');
  wrap.append(digestBox);
  let step = null;
  if (efos) step = ['Revisar los CFDI con 69-B', 'Un emisor en el listado 69-B puede poner en riesgo la deducción de esos comprobantes.', () => navigate('monitor')];
  else if (cancelled) step = ['Revisar los CFDI cancelados', 'Hay comprobantes cancelados en el SAT: conviene ver cuáles son y si afectan a pagos ya hechos.', () => navigate('monitor')];
  else if (typeof satData !== 'undefined' && satData && (satData.inbox || []).length) step = ['Importar los paquetes del SAT', 'Hay ' + satData.inbox.length + ' paquete(s) descargados esperando importación.', () => navigate('sat')];
  else if (!people.length) step = ['Agregar tu primer RFC', 'Sin contribuyentes no hay expediente: empieza registrando un RFC.', addPerson];
  else if (typeof satData !== 'undefined' && satData && (satData.profiles || []).some(row => !row.unlocked)) step = ['Autorizar la e.firma de los RFC pendientes', 'Sin e.firma activa no hay descarga automática para ese RFC.', () => navigate('sat')];
  /* UN siguiente paso protagonista (1.25.0, mejora nº 3): la
     caja es siempre la misma; lo local la pinta al instante y la
     parte asíncrona la SUSTITUYE si el servidor conoce algo más
     urgente (un crítico, un vencido, tu gesto CIEC en espera). */
  const stepBox = n('div', undefined, 'next-step');
  stepBox.dataset.protagonista = '1';
  if (step) stepBox.append(n('strong', 'Siguiente paso · ' + step[0]), n('p', step[1]), action('Hacerlo ahora', step[2], 'primary', 'arrow'));
  else stepBox.append(n('p', 'Todo en orden: no hay pendientes con semáforo. Buen día.'));
  wrap.append(stepBox);
  /* Transparencia (1.9.0): qué hizo el sistema, qué falta y qué
     vence — sin que Paco tenga que adivinarlo. Se rellena con los
     datos del servidor cuando está disponible. */
  const clarity = n('div', undefined, 'today-clarity');
  const colHizo = n('div', undefined, 'today-col today-col-hizo');
  colHizo.append(n('h3', 'Lo que el sistema ya hizo'));
  const colFalta = n('div', undefined, 'today-col today-col-falta');
  colFalta.append(n('h3', 'Lo que falta'));
  const colVence = n('div', undefined, 'today-col today-col-vence');
  colVence.append(n('h3', 'Lo que vence'));
  clarity.append(colHizo, colFalta, colVence);
  wrap.append(clarity);
  const line = (col, text, go) => {
    const row = n('p', text, 'today-line');
    if (go) { const btn = n('button', 'Ver', 'soft small'); btn.onclick = go; row.append(' ', btn); }
    col.append(row);
  };
  (async () => {
    try {
      if (typeof satToken === 'undefined' || !satToken) {
        line(colFalta, 'Abre PacoSAT desde el servidor de tu casa para ver aquí el trabajo del sistema, los pendientes y los vencimientos.');
        return;
      }
      /* Cesión (1.13.0): el panel aún no está insertado cuando
         todayPanel() corre; con la caché de 30 s caliente no había
         ninguna espera antes de pintar y las tres columnas se
         quedaban vacías al volver a Hoy. Se cede el turno y, si el
         panel cambió entre tanto, se pinta en las columnas vivas. */
      await Promise.resolve();
      /* Caché de 30 s en memoria (1.11.0): el panel «Hoy» consume
         lo que el pulso único ya trajo en vez de lanzar sus 4
         llamadas en cada pintado. */
      /* La caché compartida SOLO vale con su forma completa
         (1.31.1): el centro de mando la escribía con 4 datos y
         Hoy destructuraba 7 — digest, monthly y registro
         nacían undefined y «Desde que no estabas» no pintaba
         nunca si el mando pintaba primero. Los dos escritores
         llenan ya el mismo array de 7, y esta guarda rechaza
         cualquier forma corta que aparezca. */
      if (!todayCache.data || todayCache.data.length < 7 || Date.now() - todayCache.at > 30000) {
        todayCache = { at: Date.now(), data: await Promise.all([
          satApiLectura('notices').catch(() => null),
          satApiLectura('reconcile').catch(() => null),
          satApiLectura('reports/checklist?month=' + todayKey.slice(0, 7)).catch(() => null),
          satApiLectura('satdocs').catch(() => null),
          satApiLectura('monthly').catch(() => null),
          satApiLectura('activity/digest').catch(() => null),
          satApiLectura('registro/resumen').catch(() => null)]) };
      }
      const [avisos, reconcile, checklist, satdocs, monthly, digest, registro] = todayCache.data;
      /* El estado del ejecutor se lee UNA vez (1.29.1, D8): lo
         usan el protagonista, la línea de «Lo que falta» y la
         línea de la máquina — tres sitios, una sola lectura. */
      const ex = await satApiLectura('executor/overview').catch(() => null);
      /* V1+V4 (1.31.0): con los datos ya cargados, el semáforo y
         la semana se pintan en sus franjas vivas (estén en este
         panel o en su copia ya insertada en la página). */
      hoySemaforoPintar1310(avisos, registro);
      hoySemanaPintar1310(avisos);
      /* Tu lista de gestos (1.31.1): el gesto CIEC en espera
         solo consta con los datos del mes ya cargados. */
      if (typeof gestosPintarCiec1311 === 'function') gestosPintarCiec1311(monthly);
      /* Franjas vivas (1.31.1): el digest «Desde que no
         estabas» y el protagonista se pintan AQUÍ, junto al
         semáforo y la semana — en su nodo VIVO de la página, no
         tras la cesión de columnas: con varios pintados en
         carrera (arranque + cambio de RFC), el bloque viejo
         quedaba tras una salida temprana y la tarjeta no
         llegaba a la pantalla final aunque el servidor la
         hubiera calculado. Pintar en vivo es idempotente:
         replaceChildren, gana el último. */
      /* «Desde que no estabas» (1.25.0, mejora nº 9; completo
         en 1.31.1 con avisos cerrados y documentos recibidos):
         lo que el sistema hizo desde tu última marca de
         «visto». Si no cambió nada, la tarjeta no sale. */
      const digestVivo = document.querySelector('.mne-box');
      if (digestVivo && digest && (digest.eventos > 0 || digest.avisosNuevos > 0 ||
        digest.avisosCerrados > 0 || digest.documentosRecibidos > 0)) {
        const card = n('div', undefined, 'next-step');
        const partes = [];
        if (digest.cfdiNuevos) partes.push(digest.cfdiNuevos + ' CFDI nuevos');
        if (digest.avisosNuevos) partes.push(digest.avisosNuevos + ' aviso(s) nuevos' +
          (digest.criticos ? ' — ' + digest.criticos + ' crítico(s)' : ''));
        if (digest.avisosCerrados) partes.push(digest.avisosCerrados + ' aviso(s) cerrados');
        if (digest.documentosRecibidos) partes.push(digest.documentosRecibidos + ' documento(s) recibidos');
        for (const hecho of (digest.hechos || []).slice(0, 3)) partes.push(hecho.nombre + ' ×' + hecho.n);
        card.append(n('strong', 'Desde que no estabas'),
          n('p', partes.join(' · ') + '.'),
          action('Marcar como visto', async () => {
            try { await satApi('activity/seen', {}); } catch { /* la marca se reintenta al entrar */ }
            card.remove();
          }, 'soft'));
        digestVivo.replaceChildren(card);
      }
      /* El protagonista, por urgencia real (1.25.0, mejora nº 3):
         crítico > vencido > tu gesto CIEC en espera > portal
         cambiado > el por-confirmar más viejo. Sustituye a la
         sugerencia local si el servidor trae algo más urgente. */
      const pasoVivo = document.querySelector('[data-protagonista]');
      if (pasoVivo && avisos) {
        const abiertos = avisos.avisos || [];
        const critico = abiertos.find(item => item.clase === 'mal' && item.severidad === 'alta');
        const vencido = abiertos.filter(item => item.vence && item.vence < Date.now())
          .sort((a, b) => a.vence - b.vence)[0];
        const gesto = (monthly?.runs || []).some(run =>
          Object.values(run.perRfc || {}).some(entry => entry.status === 'esperando-gesto'));
        const portalCambio = typeof satData !== 'undefined' && satData?.portalSalud &&
          (satData.portalSalud.constancia?.cambio || satData.portalSalud.opinion?.cambio);
        const porConfirmar = abiertos.filter(item => item.estado === 'por-confirmar')
          .sort((a, b) => a.creado - b.creado)[0];
        let prota = null;
        if (critico) prota = ['Revisar un aviso crítico', critico.titulo + (critico.accion ? ' — ' + critico.accion + '.' : ''), () => navigate('avisos')];
        else if (vencido) prota = ['Resolver lo vencido', vencido.titulo + (vencido.accion ? ' — ' + vencido.accion + '.' : ''), () => navigate('avisos')];
        /* Trabajos esperando equipo (1.29.1, D8): con la cola
           parada por tu equipo, ESE es el siguiente paso — está
           por encima del gesto CIEC y del conteo de avisos,
           porque sin equipo en línea nada del SAT avanza. Su
           toque lleva al panel del ejecutor en Centro SAT. */
        else if (ex && ex.enCola > 0 && !ex.enLinea) {
          const emparejado = (ex.ejecutores || []).some(ej => !ej.revocado);
          prota = ['Tus trabajos del SAT esperan tu equipo',
            ex.enCola + (ex.enCola === 1 ? ' trabajo quedó en cola' : ' trabajos quedaron en cola') +
            (emparejado ? ': tu equipo no responde — ábrelo en tu PC y los recogerá solo.'
              : ': todavía no has emparejado ningún equipo — empareja tu PC y saldrán solos.'),
            () => { satTab = 'ejecutor'; navigate('sat'); }];
        }
        else if (gesto) prota = ['Dar tu gesto para la descarga CIEC', 'La corrida mensual quedó esperando tu captcha: el mes se baja desde su tarjeta en «Descargar del SAT» y la corrida retoma su sitio sola.', () => navigate('sat')];
        else if (portalCambio) prota = ['El portal del SAT cambió', 'La sonda lo detectó antes de la corrida: nada que hacer por tu parte; la próxima descarga entra avisada.', () => navigate('avisos')];
        else if (porConfirmar) prota = ['Confirmar un pago', porConfirmar.titulo + (porConfirmar.accion ? ' — ' + porConfirmar.accion + '.' : ''), () => navigate('avisos')];
        /* Hoy veraz (1.28.0, P4): si el servidor cuenta avisos
           abiertos y ninguno de los casos urgentes aplica, el
           protagonista es ese conteo — Hoy NUNCA dice «Todo en
           orden» con avisos abiertos. El protagonista nace del
           conteo del servidor, no de la foto local. */
        else if (avisos.counts?.total > 0) {
          const primero = abiertos[0];
          prota = ['Revisar tus avisos abiertos',
            avisos.counts.total + (avisos.counts.total === 1 ? ' aviso abierto' : ' avisos abiertos') +
            (primero ? ': el primero es «' + primero.titulo + '»' : '') + '.',
            () => navigate('avisos')];
        }
        if (prota) pasoVivo.replaceChildren(n('strong', 'Siguiente paso · ' + prota[0]),
          n('p', prota[1]), action('Hacerlo ahora', prota[2], 'primary', 'arrow'));
      }
      let cHizo = colHizo, cFalta = colFalta, cVence = colVence;
      if (!wrap.isConnected) {
        const vivas = document.querySelectorAll('.today-clarity .today-col');
        if (vivas.length === 3) { cHizo = vivas[0]; cFalta = vivas[1]; cVence = vivas[2]; }
        else return;
      }
      /* Lo que hizo: historial del Centro y conciliaciones vivas. */
      const resueltos = (avisos?.historial || []).filter(item => item.resuelto && String(item.resuelto).startsWith(todayKey));
      line(cHizo, resueltos.length
        ? 'Hoy se solventaron ' + resueltos.length + ' aviso(s): ' + resueltos.slice(0, 2).map(item => item.titulo).join('; ') + (resueltos.length > 2 ? '…' : '') + '.'
        : 'Hoy no se ha cerrado ningún aviso todavía.', () => navigate('avisos'));
      /* Sin ruido (1.28.0, P5): la línea de conciliaciones solo
         existe cuando hay alguna que contar. */
      if (reconcile?.confirmed.length) line(cHizo, 'Conciliaciones confirmadas y vigentes: ' + reconcile.confirmed.length + '.', () => navigate('dinero'));
      const informes = (avisos?.historial || []).filter(item => item.kind === 'informe').length;
      if (informes) line(cHizo, 'Informes mensuales enviados en el historial: ' + informes + '.');
      if (!resueltos.length && !reconcile?.confirmed.length) line(cHizo, 'Sin actividad registrada hoy: el sistema vigila en silencio.');
      /* Lo que falta: avisos abiertos y pasos del cierre en rojo/ámbar.
         Sin enumeraciones vacías (2.0, M9 / 3.2): la fila NOMBRA
         los avisos (títulos cortos) o no lleva dos puntos — nunca
         un «: .» tras un conteo de clases que puede venir vacío. */
      if (avisos?.counts?.total) {
        const nAv = avisos.counts.total;
        const tf200 = (avisos.avisos || []).map(a => a.titulo).filter(Boolean).slice(0, 3);
        /* Destino exacto (2.0 · O5): el «Ver» aterriza en la
           tarjeta del primer aviso abierto, no en la pantalla
           genérica; sin id, cae a la pantalla como siempre. */
        const primerAvisoId = (avisos.avisos || [])[0]?.id;
        line(cFalta, nAv + ' aviso(s) abiertos' +
          (tf200.length ? ': ' + tf200.join('; ') + (nAv > tf200.length ? '…' : '') : '') + '.',
          () => irDestino200b('avisos', primerAvisoId != null ? 'aviso-' + primerAvisoId : ''));
      }
      else line(cFalta, 'Sin avisos abiertos: nada esperando por ti en el Centro.');
      /* Sin vías (1.29.2): con avisos abiertos y ninguna vía
         fuera de la app conectada, Hoy lo dice con su gesto —
         una alerta que nace y no llega a ninguna parte es un
         silencio, y el silencio está prohibido. */
      if (avisos?.counts?.total && avisos.canales && !avisos.canales.correo && !avisos.canales.push)
        line(cFalta, 'Tus alertas no te llegan fuera de la app: activa el correo o el push para que te avisen al nacer.', () => navigate('settings'));
      /* Buzón: UNA sola fila con estado compuesto (2.0, M9 /
         3.4) — lo sin leer de Recibidos y lo sin abrir del
         Buzón Tributario del SAT en la misma línea, con su
         gesto único (consultar el Tributario). Antes eran dos
         filas que se pisaban («Buzón: 5 sin leer» y «Buzón
         Tributario: sin consultar todavía»). */
      const buzonN = typeof buzonUnreadFor === 'function' ? buzonUnreadFor(scope) : 0;
      const tribN = typeof tribSinAbrirFor === 'function' ? tribSinAbrirFor(scope) : 0;
      const tribConsultado = typeof tribConsultadoFor === 'function' ? tribConsultadoFor(scope) : false;
      const tribTenida = typeof tribTenidaFor === 'function' ? tribTenidaFor(scope) : null;
      const btSat = ' · Buzón Tributario del SAT: ';
      line(cFalta, 'Buzón: ' + number.format(buzonN) + ' sin leer' +
        (tribConsultado
          ? btSat + number.format(tribN) + ' sin abrir' + (tribN
            ? (tribTenida ? ' — la más antigua se tiene por notificada el ' + declFechaLarga(tribTenida.tenida) + ' aunque nadie la abra.' : '.')
            : ': todo abierto.')
          : btSat + 'sin consultar todavía: consúltalo para saber si el SAT te dejó algo.'),
        () => irDestino200b('tributario', 'buzon'));
      if (typeof paintBuzonBadge === 'function') paintBuzonBadge();
      if (typeof paintTribBadge === 'function') paintTribBadge();
      /* Ejecutor local (1.29.1, D8): su cola es un «lo que falta»
         más, con su toque al panel — no una frase escondida en la
         línea de la máquina. */
      if (ex && ex.enCola > 0) line(cFalta, 'Ejecutor local: ' + ex.enCola +
        (ex.enCola === 1 ? ' trabajo' : ' trabajos') +
        (ex.enLinea ? ' en cola; tu equipo está en línea y los está recogiendo.'
          : ' esperando tu equipo: sin él en línea, no salen.'),
        () => { satTab = 'ejecutor'; irDestino200b('sat', 'ejecutor'); });
      if (checklist) {
        const pending = checklist.items.filter(item => item.level !== 'ok');
        line(cFalta, pending.length
          ? 'Cierre de ' + checklist.month + ': faltan ' + pending.map(item => item.label.toLocaleLowerCase('es-MX')).join(', ') + '.'
          : 'Cierre de ' + checklist.month + ': los 10 pasos están en verde.', () => navigate('salidas'));
      }
      /* Lo que vence: avisos con fecha y documentos por caducar. */
      const upcoming = (avisos?.avisos || []).filter(item => item.vence)
        .sort((a, b) => String(a.vence).localeCompare(String(b.vence))).slice(0, 3);
      for (const item of upcoming)
        line(cVence, item.titulo + ' — vence el ' + new Date(item.vence).toLocaleDateString('es-MX', { day: 'numeric', month: 'short' }) +
          (item.responsable ? ' (lo resuelve ' + item.responsable + ')' : '') + '.',
          () => irDestino200b('avisos', item.id != null ? 'aviso-' + item.id : ''));
      for (const profile of satdocs?.profiles || []) {
        for (const [doc, label] of [[profile.constancia, 'Constancia'], [profile.opinion, 'Opinión']])
          if (doc && doc.level !== 'ok') line(cVence, label + ' de ' + profile.rfc + ': lleva ' + doc.ageDays +
            ' días; toca renovarla.', () => irDestino200b('sat', label === 'Constancia' ? 'constancia' : 'opinion'));
      }
      if (!upcoming.length) line(cVence, 'Sin vencimientos a la vista en los avisos.');
      /* La línea del Registro (1.28.0, P1): qué hizo el sistema en
         24 h y, si algo falló, qué fue — un toque a la bitácora. */
      if (registro) line(cHizo, 'Registro (24 h): ' + registro.conexiones + ' conexión(es) · ' + registro.acciones + ' acción(es)' +
        (registro.fallos ? ' · ' + registro.fallos + ' fallo(s)' + (registro.ultimoFallo
          ? ' — el último: ' + String(registro.ultimoFallo.texto).slice(0, 110) : '') : ' · sin fallos') + '.',
        () => navigate('registro'));
    } catch { /* la transparencia es un extra: nunca rompe el Resumen */ }
  })();
  return wrap;
}
function home() {
  if (!ready) {
    /* Esqueleto de carga (1.6.5): mientras llegan los datos se muestran
       bloques neutros en vez de cifras a medias. */
    const skel = n('div', undefined, 'skel');
    skel.setAttribute('aria-busy', 'true');
    skel.setAttribute('aria-label', 'Cargando el resumen fiscal');
    for (let i = 0; i < 4; i++) skel.append(n('div', undefined, 'skel-block'));
    return [skel];
  }
  const selection = invoices.filter(matches);
  const pdfs = documents.filter(doc => !doc.archived && (!scope || doc.rfc === scope));
  const banner = n('section', undefined, 'dashboard-hero');
  const copy = n('div');
  /* Héroe en una línea (1.18.0): el RFC y el semáforo general ya
     viven en la tarjeta «Hoy»; aquí solo el nombre y el conteo. */
  copy.append(n('h2', scope ? scopes().get(scope) : 'Tu expediente fiscal'),
    n('p', people.length ? people.length + (people.length === 1 ? ' contribuyente en tu cartera' : ' contribuyentes en tu cartera') : 'Agrega tu primer RFC para abrir un expediente.'));
  const shortcuts = n('div', undefined, 'hero-actions');
  shortcuts.append(people.length ? action('Ver facturas', () => navigate('invoices'), undefined, 'file') : action('Agregar contribuyente', addPerson, undefined, 'plus'),
    action('Ir a Descargar del SAT', () => navigate('sat'), undefined, 'sync'));
  banner.append(copy, shortcuts);
  const metrics = n('div', undefined, 'cards');
  for (const [label, value, glyph, open] of [
    ['CFDI recibidos', selection.filter(row => roles(row).received).length, 'down', () => { direction = 'Recibidos'; invoicePage = 0; navigate('invoices'); }],
    ['CFDI emitidos', selection.filter(row => roles(row).issued).length, 'up', () => { direction = 'Emitidos'; invoicePage = 0; navigate('invoices'); }],
    ['Documentos archivados', pdfs.length, 'folder', () => { docFilter = ''; navigate('docs'); }]
  ]) {
    const card = n('div', undefined, 'metric');
    const name = n('div', label, 'metric-label'); name.prepend(icon(glyph));
    /* La cifra ES el enlace (1.32.1, H4): el número lleva a su
       detalle; ya no hay un «Abrir» vecino haciendo ese trabajo. */
    const cifra = n('button', number.format(value), 'metric-value-link');
    cifra.type = 'button';
    cifra.title = 'Abrir ' + label;
    cifra.onclick = open;
    card.append(name, cifra); metrics.append(card);
  }
  const recent = panel('Últimos comprobantes');
  const latest = selection.slice(0, 5);
  if (latest.length) recent.append(grid(['Emisor', 'Fecha', 'Total', ''], latest.map(row => [
    cell(row.from.name || row.from.rfc, rowRole(row)), dateLabel(row.date), amount(row), action('Ver detalle', () => invoiceDetail(row))
  ])));
  else recent.append(empty('Sin movimientos todavía', 'Las facturas importadas o sincronizadas aparecerán aquí.'));
  const tasks = panel('Contribuyentes');
  const visiblePeople = people.filter(row => !scope || row.id === scope);
  if (!visiblePeople.length) tasks.append(empty('Crea tu primer expediente', 'Agrega un RFC y arrastra aquí los archivos XML o ZIP que ya tengas.', action('Agregar RFC', addPerson, 'primary', 'plus')));
  else {
    const counts = new Map(visiblePeople.map(p => [p.id, [0, 0, 0]]));
    for (const row of invoices) {
      if (counts.has(row.to.rfc)) counts.get(row.to.rfc)[0]++;
      if (counts.has(row.from.rfc)) counts.get(row.from.rfc)[1]++;
    }
    for (const doc of documents) if (!doc.archived && counts.has(doc.rfc)) counts.get(doc.rfc)[2]++;
    tasks.append(grid(['Contribuyente', 'Recibidos', 'Emitidos', 'PDF', 'Acción'], visiblePeople.map(p => {
      /* Dos destinos claros (UX-29): «Facturas» va al archivo del RFC y
         «Expedientes» a sus PDF; «Abrir expediente» a secas confundía. */
      const acts = n('div', undefined, 'actions');
      acts.append(action('Facturas', () => { scope = p.id; $('scope').value = scope; invoicePage = 0; navigate('invoices'); }),
        action('Expedientes', () => { scope = p.id; $('scope').value = scope; docFilter = ''; navigate('docs'); }),
        action('Renombrar', () => renamePerson(p)));
      return [cell(p.name, p.id), ...counts.get(p.id).map(value => number.format(value)), acts];
    })));
  }
  const history = panel('Actividad');
  /* Los trabajos del servidor (barridos, descargas, cierres) se
     pintan aquí desde el mismo registro que alimenta el menú y el
     dock: el pulso de actividad rellena este hueco (1.18.0). */
  const sysActivity = n('div'); sysActivity.dataset.sysActivity = '1';
  history.append(sysActivity);
  if (newsCount) history.append(n('p', newsCount === 1 ? '1 novedad desde tu última visita' : number.format(newsCount) + ' novedades desde tu última visita', 'news-note'));
  if (!activity.length) history.append(empty('Sin actividad todavía', 'Aquí verás importaciones, descargas del SAT, respaldos, documentos archivados y cancelaciones detectadas.'));
  else {
    const list = n('div', undefined, 'activity-list');
    let activityIndex = 0;
    for (const row of activity.slice(0, 8)) {
      const item = n('div', undefined, 'activity-item');
      /* Plegado (1.18.0): cuatro a la vista; el resto tras «Ver más». */
      if (activityIndex++ >= 4) { item.hidden = true; item.dataset.folded = '1'; }
      const kind = row.event ? (row.event.startsWith('Cancelación') ? 'alert' : 'event') : (row.name.startsWith('SAT') ? 'sat' : 'import');
      /* Bitácora clicable (1.6.11): cada entrada abre el objeto al que
         se refiere — el CFDI de una cancelación, la pantalla del SAT,
         los respaldos o el archivo de facturas de un lote importado. */
      const uuidMatch = (row.event || '').match(/[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}/);
      const linkedInvoice = uuidMatch ? invoices.find(inv => inv.id === uuidMatch[0].toUpperCase()) : null;
      const openTarget = linkedInvoice ? () => invoiceDetail(linkedInvoice) :
        row.event?.includes('Respaldo') ? () => navigate('backup') :
        kind === 'sat' || row.event?.includes('SAT') ? () => navigate('sat') :
        !row.event ? () => navigate('invoices') : null;
      if (openTarget) {
        item.classList.add('activity-link');
        item.setAttribute('role', 'button');
        item.tabIndex = 0;
        item.onclick = openTarget;
        item.onkeydown = event => { if (event.key === 'Enter' || event.key === ' ') { event.preventDefault(); openTarget(); } };
      }
      const badge = n('span', kind === 'alert' ? 'Alerta' : kind === 'sat' ? 'SAT' : kind === 'event' ? 'Evento' : 'Lote', 'activity-kind');
      badge.dataset.kind = kind;
      const body = n('div', undefined, 'activity-body');
      if (row.event) body.append(n('strong', row.event), n('small', localDateTime(Date.parse(row.date))));
      else {
        body.append(n('strong', row.name),
          n('small', dateLabel(row.date) + ' · ' + row.added + ' nuevos · ' + row.duplicates + ' duplicados' + (row.review ? ' · ' + row.review + ' por revisar' : '')));
        if (row.review) body.append(action('Ver revisión', () => reviewDetail(row), 'metric-link', 'arrow'));
      }
      item.append(badge, body);
      list.append(item);
    }
    history.append(list);
    if (activity.length > 4) {
      const mas = action('Ver más actividad', () => {
        list.querySelectorAll('[data-folded]').forEach(el => { el.hidden = false; });
        mas.remove();
      }, 'quiet');
      history.append(mas);
    }
  }
  const secondary = n('div', undefined, 'dashboard-grid');
  secondary.append(recent, history);
  /* Hoy manda la tarjeta «Hoy» (1.11.0): primero y en grande. Fuera
     el panel de avisos incrustado (su resumen vive en las líneas de
     la propia tarjeta, con enlace a Avisos), fuera la fila de KPI
     que repetía conteos (con ceros sin acción) y fuera los gráficos
     que duplicaban los totales: queda UN gráfico y UNA tabla. */
  /* Hoy adelgaza (2.0 · tanda 2, M5 / 3.1): Hoy se queda con
     EL DÍA — la tarjeta del día (semáforo compuesto, lo que
     falta y lo que vence), tus gestos, el paso protagonista y
     la franja compacta de acciones. Un estado, un sitio: la
     salud y el respaldo viven en Ajustes › Estado del sistema
     y Respaldos (aquí, una línea-resumen con su semáforo);
     «Esto es lo nuevo» vive en Ajustes › Acerca de; el Centro
     de mando de 7 bloques, los totales por mes y los últimos
     comprobantes viven en sus pantallas (Dinero, Cierre y
     Facturas), alcanzables en un toque desde la franja. El
     héroe y las métricas se retiran del cuerpo: repetían el
     contribuyente y los conteos que Facturas ya enseña. */
  /* Hoy corto (2.0.1): el mando único de arriba (estado de las
     piezas + las 4 acciones que HACEN) y, debajo, solo los
     gestos. El panel largo de la 2.0 (todayPanel: semáforo,
     semana, «desde que no estabas», protagonista y las tres
     columnas) y la franja de botones que llevaban a otras
     pantallas (hoyAcciones200b) se retiran de Hoy: cada dato
     vive en su pantalla y las acciones se hacen aquí. */
  const blocks = [hoyMando201()];
  /* Vista Nora (1.25.0, AGREGAR 3): si quien entra es la
     invitada-contadora, su pantalla inicial es su lista del mes
     en solo lectura. La marca la decide el servidor; se consulta
     una vez y, si llega tarde, la pantalla se repinta sola. */
  if (typeof guestMode !== 'undefined' && guestMode) {
    if (noraSesionCache === true) return [noraVistaPanel()];
    if (noraSesionCache === null) {
      noraSesionCache = 'consultando';
      satApi('guest/config').then(cfg => {
        noraSesionCache = Boolean(cfg.sesionContadora);
        if (noraSesionCache && page === 'home') render();
      }).catch(() => { noraSesionCache = false; });
    }
  }
  /* Lo que te toca y la línea de salud (2.0 · tanda 2): los
     gestos son del día y se quedan; la salud y el respaldo
     salen del cuerpo — queda UNA línea-resumen con su
     semáforo que lleva a Ajustes › Estado del sistema, su
     pantalla dueña. «Esto es lo nuevo» ya no vive en Hoy:
     su sitio es Ajustes › Acerca de (capacidadesScreen). */
  /* «Lo que te necesita»: solo gestos reales, con su botón.
     La línea de salud también sale de Hoy (2.0.1): Salud es
     entrada propia del menú y su detalle vive en su pantalla. */
  blocks.push(gestosPanel1311());
  /* «A medias» (nº 16): tras los gestos, en su mismo flujo; el
     panel solo se enseña si el servidor trae algo a medias. */
  blocks.push(aMedias201Panel());
  if (lastImport) {
    /* Tarjeta persistente de la última importación (UX-13). */
    const card = panel('Última importación');
    card.append(n('p', lastImport.added + ' nuevos · ' + lastImport.duplicates + ' duplicados · ' + lastImport.review +
      ' por revisar · ' + localDateTime(lastImport.at)));
    const acts = n('div', undefined, 'actions');
    acts.append(action('Ver facturas', () => navigate('invoices'), undefined, 'file'));
    if (lastImport.dupIds.length) acts.append(action('Ver los UUID duplicados', () => {
      dialog('UUID duplicados en la última importación',
        [n('p', 'Estos folios ya estaban en tu expediente y no se importaron dos veces:'), ...lastImport.dupIds.map(id => n('p', id))]);
    }));
    card.append(acts);
    blocks.push(card);
  }
  /* Fuera de Hoy (2.0 · tanda 2, M5): «Últimos comprobantes» y
     «Actividad» repetían Facturas y el Registro/la franja de
     actividad — viven en sus pantallas, a un toque. La tabla
     «Contribuyentes» la sustituye el panel general de
     contribuyentes (pieza 9), alcanzable desde el selector
     («Ver todos»): Hoy es de UN RFC y no mezcla el conjunto.
     Los bloques secondary/tasks ya no se montan en Hoy. */
  void secondary; void tasks; void visiblePeople;
  /* La tabla «Totales por RFC y mes» ya no vive en Hoy
     (1.32.1, H1/H2): repetía las cifras de Dinero y de Cierre y
     enterraba el primer pantallazo. Su casa es Cierre y
     reportes, donde está el reporte completo. */
  return blocks;
}

const invoiceStateOf = row => {
  const item = fiscalResults.get(row.id);
  if (item?.efos?.length) return 'efos';
  return item?.sat?.state || 'none';
};
/* Estado de pago por fila (del Visor, absorbido en la fusión de
   Facturas de la 1.11.0): el saldo oficial vive en el servidor
   (paidByMap/balanceOf de Dinero); visorMarcados recuerda lo
   marcado en esta sesión. */
const visorMarcados = new Set();
function visorEstadoPago(row, paidBy) {
  if (row.kind !== 'I') return { label: '—', state: 'dim' };
  if (visorMarcados.has(row.id)) return { label: 'Pagada', state: 'ok' };
  const { balance, paid } = balanceOf(row, paidBy);
  if (balance <= 0n) return { label: 'Pagada', state: 'ok' };
  if (paid > 0n) return { label: 'Parcial', state: 'warn' };
  return { label: 'Pendiente', state: 'warn' };
}
function invoiceRows() {
  const needle = term.trim().toLocaleLowerCase('es-MX');
  const known = scopes();
  const paidBy = invoicePayState ? paidByMap() : null;
  const matchScope = row => scope ? row.from.rfc === scope || row.to.rfc === scope : known.has(row.from.rfc) || known.has(row.to.rfc);
  const filtered = invoices.filter(row => matchScope(row) && (!month || row.date.startsWith(month)) && (!invoiceKind || row.kind === invoiceKind) &&
    (!invoiceState || invoiceStateOf(row) === invoiceState) &&
    (!invoiceContraparte201 || row.from.rfc === invoiceContraparte201 || row.to.rfc === invoiceContraparte201) &&
    (!invoicePayState || visorEstadoPago(row, paidBy).label.toLocaleLowerCase('es-MX') === invoicePayState) &&
    (direction === 'Todos' || (direction === 'Canceladas' ? invoiceStateOf(row) === 'Cancelado'
      : (direction === 'Recibidos' ? (scope ? row.to.rfc === scope : known.has(row.to.rfc)) : (scope ? row.from.rfc === scope : known.has(row.from.rfc))))) &&
    /* El folio del CFDI entra en la búsqueda (1.18.0): teclear
       «963» encuentra la factura 963, no hace falta el UUID.
       2.0.1 · nº 24: también el IMPORTE (tal cual viaja y con
       el formato de pantalla) y el CONCEPTO (las descripciones
       que el propio XML trae y la fila ya lleva): buscar
       «renta» o «343539» encuentra la factura sin su folio. */
    [row.id, row.from.rfc, row.to.rfc, row.from.name, row.to.name,
      row.fiscal ? ((row.fiscal.serie ? row.fiscal.serie + '-' : '') + (row.fiscal.folio || '')) : '',
      row.total, centsLabel(totalCents(row)), ...(row.concepts || [])]
      .some(text => String(text).toLocaleLowerCase('es-MX').includes(needle)));
  /* Orden de PRESENTACIÓN (2.0.1 · nº 26): por fecha o por
     importe, con un toque; no toca ningún cálculo. */
  if (invoiceOrder === 'oldest') return filtered.reverse();
  if (invoiceOrder === 'importe-mayor') return filtered.sort((a, b) => Number(totalCents(b) - totalCents(a)));
  if (invoiceOrder === 'importe-menor') return filtered.sort((a, b) => Number(totalCents(a) - totalCents(b)));
  return filtered;
}
function rowRole(row) {
  const result = roles(row);
  return result.issued && result.received ? 'Entre mis RFC' : result.issued ? 'Emitido' : 'Recibido';
}
/* Imprimir la vista, a la vista (2.0.1, orden de Paco: «no veo
   las funciones de imprimir reportes de forma clara»): un solo
   ayudante compone la tabla TAL CUAL está filtrada en la
   sección de impresión de siempre (#print-report, plantillas
   en Carta de la 1.32.1) y manda imprimir. Lo usan Facturas,
   Dinero y Documentos desde su botón «Imprimir» visible —
   nada de imprimir escondido en menús de tres puntos. */
/* ===== Pre-vuelo de la puerta y confirmación de despacho
   (2.0.1 · nº 5 y nº 21) =====
   Antes de despachar un trabajo contra el SAT (descarga,
   buzón, declaraciones) se enseña una tarjeta con el resumen
   de lo que se va a pedir y el estado REAL de la puerta de ese
   RFC: si consta probada y su último éxito (ultimoExito, el
   dato que la fase 1 dejó en el mapa de la puerta). Es un
   aviso veraz, no un candado: si la puerta no consta abierta,
   la tarjeta lo dice con su causa y ofrece probarla ahí mismo
   (salud/puerta, el despacho de siempre), y Paco puede seguir
   de todos modos. «Cancelar» está siempre visible y no
   despacha nada. */
function puertaTexto201(rfc) {
  const puerta = (typeof satData !== 'undefined' && satData?.puerta?.[rfc]) || null;
  if (!puerta || !puerta.probada)
    return { ok: false, texto: 'La puerta del SAT de ' + rfc + ' no se ha probado todavía: no consta ningún éxito.' };
  const exito = puerta.ultimoExito ? ' Último éxito real: el ' + fmtFechaHora(puerta.ultimoExito) + '.' : '';
  if (puerta.ok) return { ok: true, texto: 'Ahora sí: la puerta de ' + rfc + ' consta abierta (probada el ' +
    fmtFechaHora(puerta.probada) + ').' + exito };
  return { ok: false, texto: 'Ahora no consta que la puerta de ' + rfc + ' abra: ' +
    (puerta.error || 'la última prueba no abrió') + ' (probada el ' + fmtFechaHora(puerta.probada) + ').' +
    exito + ' Puedes probarla ahora o seguir de todos modos.' };
}
function confirmarDespacho201({ titulo, lineas, rfc, boton, alConfirmar }) {
  const form = n('form', undefined, 'dialog-form');
  form.append(n('h3', titulo));
  for (const linea of lineas || []) form.append(n('p', linea));
  if (rfc) {
    const pv = puertaTexto201(rfc);
    form.append(n('p', pv.texto, pv.ok ? 'muted' : 'error-text'));
    const probar = n('button', 'Probar la puerta ahora', 'soft');
    probar.type = 'button';
    probar.onclick = async () => {
      probar.disabled = true;
      try {
        const r = await satApi('salud/puerta', { rfc });
        toast(r.encolado ? 'Prueba de la puerta pedida: tu equipo la corre al recogerla.'
          : (r.motivo || 'La prueba no se encoló.'), r.encolado ? 'ok' : 'error');
      } catch (error) { toast(error.message, 'error'); }
      probar.disabled = false;
    };
    form.append(probar);
  }
  const acts = n('div', undefined, 'actions');
  const seguir = n('button', boton || 'Seguir', 'primary'); seguir.type = 'submit';
  const cancelar = n('button', 'Cancelar', 'soft'); cancelar.type = 'button';
  cancelar.onclick = () => closeDialog();
  acts.append(seguir, cancelar);
  form.append(acts);
  form.onsubmit = event => { event.preventDefault(); closeDialog(); alConfirmar(); };
  showDialog(form);
}
/* ===== «Ejecutar aquí» (2.0.1 · nº 31) =====
   El ejecutor vive RESIDENTE en el PC de Paco, con arranque
   automático: lo normal es que ya esté despierto, y así lo
   dice la tarjeta («está despierto»). Este botón es el
   RESPALDO para cuando está cerrado («está dormido»): un
   enlace LOCAL pacosat://ejecutar, el protocolo que su
   instalador registró en su Windows. La app no arranca nada
   por red y nunca enseña una ruta ni una carpeta (eso se
   fijó una vez en el instalador, en su PC): el enlace lo
   resuelve su propio equipo. Si el enlace no responde, la
   reserva es arrancar.bat — y solo se nombra como reserva,
   junto al botón, nunca como el camino. */
function ejecutarAqui201(dormido) {
  const b = n('button', dormido ? 'Ejecutar aquí' : 'Abrir ejecutor', dormido ? 'primary small' : 'soft small');
  b.type = 'button';
  b.title = dormido ? 'Despertar el ejecutor en tu equipo' : 'Abrir el ejecutor en tu equipo';
  b.onclick = () => { window.location.href = 'pacosat://ejecutar'; };
  return b;
}
/* ===== Tiempo estimado de un trabajo (2.0.1 · nº 22) =====
   La mediana real que el servidor calcula en /api/tiempos201
   (mínimo de 3 muestras, aplicado allí). Aquí solo se enseña
   cuando el tipo del trabajo tiene estimación: sin dato, no
   se pinta nada — nunca un tiempo inventado. La lectura se
   cachea un minuto: la franja de actividad se repinta seguido. */
let tiempos201Cache = null, tiempos201At = 0;
async function tiempoEstimado201(kind) {
  if (!kind || typeof satToken === 'undefined' || !satToken) return '';
  if (!tiempos201Cache || Date.now() - tiempos201At > 60000) {
    try { tiempos201Cache = await satApi('tiempos201'); tiempos201At = Date.now(); }
    catch { return ''; }
  }
  const porTipo = tiempos201Cache?.porTipo || {};
  const directo = porTipo[kind];
  if (directo?.medianaTexto) return directo.medianaTexto;
  /* Los tipos de la franja de actividad y las claves del
     historial no se llaman igual: el buzón se registra como
     «buzon-listar» y la descarga CIEC como «descarga-ciec»
     (integración 2.0.1). Declaraciones cae primero a su diario
     agregado y, si no hay, al trabajo del ejecutor. */
  const alias201 = { tributario: ['buzon-listar'], ciec: ['descarga-ciec'],
    declaraciones: ['declaraciones-recuperar', 'declaraciones-transacciones'] };
  for (const clave of alias201[kind] || []) {
    if (porTipo[clave]?.medianaTexto) return porTipo[clave].medianaTexto;
  }
  if (kind === 'documentos') {
    const clave = Object.keys(porTipo).find(k => k.startsWith('documento-sat:'));
    if (clave) return porTipo[clave].medianaTexto;
  }
  return '';
}
function imprimirVista201(titulo, nota, columnas, filas) {
  const section = $('print-report');
  if (!section) { window.print(); return; }
  section.replaceChildren();
  const head = n('div', undefined, 'report-head');
  head.append(n('h1', titulo), n('p', (appSettings.installName || 'PacoSAT') +
    (scope ? ' · ' + scope : '') + ' · ' + localDateTime(Date.now())));
  const body = n('div', undefined, 'report-body');
  if (nota) body.append(n('p', nota));
  const table = n('table');
  const thead = n('thead'); const htr = n('tr');
  for (const label of columnas) htr.append(n('th', label));
  thead.append(htr); table.append(thead);
  const tbody = n('tbody');
  for (const fila of filas) {
    const tr = n('tr');
    for (const valor of fila) tr.append(n('td', String(valor ?? '')));
    tbody.append(tr);
  }
  table.append(tbody);
  body.append(table);
  section.append(head, body);
  if (typeof reportFoot === 'function') section.append(reportFoot(scope));
  setTimeout(() => window.print(), 60);
}
function invoiceScreen() {
  const list = panel();
  /* Descargar SIN salir de Facturas (1.32.1, F1): el botón vive
     donde el usuario piensa «quiero los CFDI nuevos» — abre la
     hoja de descarga de siempre con el RFC elegido y el mes en
     pantalla como periodo sugerido. Si el perfil no tiene
     firmante activo, la hoja lo dice con su gesto (B3). */
  const descargarSat = n('button', 'Descargar del SAT', 'primary');
  descargarSat.type = 'button';
  descargarSat.onclick = () => {
    if (!scope) { toast('Elige arriba el contribuyente del que quieres descargar.', 'error'); return; }
    if (typeof downloadSheet === 'function') {
      const preset = month ? (() => { const [yy, mm] = month.split('-').map(Number);
        const ultimo = new Date(yy, mm, 0).getDate();
        return { start: month + '-01', end: month + '-' + String(ultimo).padStart(2, '0') }; })() : {};
      downloadSheet(scope, preset);
    } else toast('La hoja de descarga vive en Descargar del SAT.', 'error');
  };
  list.append(descargarSat);
  /* Tanda 7B (15 · 20#18/F9): vistas guardadas de Facturas — la
     combinación actual de filtros con nombre, aplicable en un
     toque. Los filtros ya recuerdan su último valor al volver
     (viven en las variables de la pantalla y en el RFC elegido). */
  if (typeof satToken !== 'undefined' && satToken) {
    const vistasBar200h = n('div', undefined, 'actions');
    const vistasSel200h = select([['', 'Vistas guardadas…']], '', 'Vistas guardadas de Facturas');
    const cargarVistas200h = () => satApi('vistas200h?rfc=' + encodeURIComponent(scope || '')).then(d => {
      vistasSel200h.replaceChildren(new Option('Vistas guardadas…', ''));
      for (const v of (d.vistas || []).filter(x => x.pantalla === 'facturas'))
        vistasSel200h.append(new Option(v.nombre, v.id, false, false));
      vistasSel200h._porId = Object.fromEntries((d.vistas || []).map(v => [v.id, v]));
    }).catch(() => {});
    vistasSel200h.onchange = () => { const v = vistasSel200h._porId?.[vistasSel200h.value];
      if (!v) return; const f = v.filtros || {};
      term = f.term || ''; month = f.month || ''; invoiceKind = f.kind || '';
      invoiceState = f.state || ''; invoicePayState = f.payState || ''; direction = f.direction || 'Todos';
      if (v.rfc) { scope = v.rfc; $('scope').value = scope; }
      invoicePage = 0; render(); };
    const guardarVista200h = n('button', 'Guardar vista', 'soft small');
    guardarVista200h.onclick = () => { const nombreIn = input('text', { maxLength: 60, required: true });
      dialog('Guardar la vista actual', [field('Nombre de la vista', nombreIn)], async () => {
        await satApi('vistas200h', { rfc: scope, pantalla: 'facturas', nombre: nombreIn.value,
          filtros: { term, month, kind: invoiceKind, state: invoiceState, payState: invoicePayState, direction } });
        toast('Vista guardada: la aplicas en un toque desde Facturas.'); cargarVistas200h();
      }, 'Guardar vista'); };
    const borrarVista200h = n('button', 'Borrar vista', 'soft small');
    borrarVista200h.onclick = async () => { if (!vistasSel200h.value) { toast('Elige primero la vista que quieres borrar.', 'error'); return; }
      await satApi('vistas200h/borrar', { id: vistasSel200h.value }); toast('Vista borrada.'); cargarVistas200h(); };
    vistasBar200h.append(vistasSel200h, guardarVista200h, borrarVista200h);
    list.append(vistasBar200h); cargarVistas200h();
  }
  const tabs = n('div', undefined, 'tabs');
  for (const title of ['Todos', 'Recibidos', 'Emitidos']) {
    const button = action(title, () => { direction = title; invoicePage = 0; render(); });
    button.setAttribute('aria-pressed', direction === title);
    tabs.append(button);
  }
  /* Cuarto filtro «Canceladas» (2.0.1, hallazgo de Paco en
     vivo): las canceladas dejaban de mezclarse con su pastilla
     entre las vigentes — tienen su filtro en la MISMA fila, con
     su contador, y su vista enseña el efecto en el mes que el
     servidor ya calcula. Es solo un filtro: las canceladas
     siguen FUERA de los totales, el cálculo no se toca. El
     contador cuenta las del ámbito en pantalla según el estado
     que la vigilancia ya trajo (invoiceStateOf). */
  const numCanceladas = invoices.filter(row => (!scope || row.from.rfc === scope || row.to.rfc === scope) &&
    invoiceStateOf(row) === 'Cancelado').length;
  const tabCanceladas = action('Canceladas (' + number.format(numCanceladas) + ')',
    () => { direction = 'Canceladas'; invoicePage = 0; render(); });
  tabCanceladas.setAttribute('aria-pressed', direction === 'Canceladas');
  tabs.append(tabCanceladas);
  const controls = n('div', undefined, 'filters');
  const search = input('search', { value: term, placeholder: 'Buscar nombre, RFC, folio, UUID, importe o concepto' });
  search.setAttribute('aria-label', 'Buscar comprobantes');
  const period = input('month', { value: month }); period.setAttribute('aria-label', 'Mes de emisión');
  const type = select([['', 'Todos los tipos'], ...Object.entries(KINDS)], invoiceKind, 'Tipo de CFDI');
  const state = select([['', 'Todos los estados SAT'], ['Vigente', 'Vigente'], ['Cancelado', 'Cancelado'], ['efos', 'Con 69-B'], ['none', 'Sin revisar todavía']], invoiceState, 'Estado SAT');
  const payState = select([['', 'Pagadas y pendientes'], ['pagada', 'Pagadas'], ['pendiente', 'Pendientes'], ['parcial', 'Parciales']], invoicePayState, 'Estado de pago');
  const order = select([['recent', 'Más recientes'], ['oldest', 'Más antiguos'],
    ['importe-mayor', 'Importe: de mayor a menor'], ['importe-menor', 'Importe: de menor a mayor']], invoiceOrder, 'Orden');
  /* Selector de contraparte (2.0.1 · nº 13): las empresas que
     aparecen como emisor o receptor en el ámbito en pantalla.
     Elegir una deja SOLO sus facturas, y el pie enseña el
     total de lo filtrado, presentado como lo que es. */
  const partesCp201 = new Map();
  for (const row of invoices) {
    if (scope && row.from.rfc !== scope && row.to.rfc !== scope) continue;
    for (const party of [row.from, row.to])
      if (party?.rfc && party.rfc !== scope && !partesCp201.has(party.rfc))
        partesCp201.set(party.rfc, party.name || party.rfc);
  }
  const cpSel201 = select([['', 'Todas las contrapartes'],
    ...[...partesCp201.entries()].sort((a, b) => a[1].localeCompare(b[1], 'es-MX'))
      .map(([rfc, nombre]) => [rfc, nombre + ' · ' + rfc])], invoiceContraparte201, 'Contraparte');
  const exportButton = action('Exportar CSV', exportCsv, undefined, 'down');
  /* Importar carpeta en 2 toques desde Facturas (1.7.4, pieza 1):
     lee la estructura tipo OneFacture (Emitidos/Recibidos/año/mes) por
     el mismo pipeline que los sueltos, los ZIP y los paquetes SAT. */
  const folderButton = action('Importar carpeta', async () => {
    await requireStorage();
    check(people.length, 'Agrega primero un RFC.');
    if (!importing) $('folder').click();
  }, undefined, 'folder');
  /* Selección múltiple (UX-14): descargar varios XML en un ZIP.
     Ronda Salidas (1.14.0): con servidor, la selección baja como
     ZIP ORDENADO de la capa de salidas (carpetas por sentido y mes,
     cancelados aparte, índice con folio y manifiesto); el ZIP plano
     local queda como ruta sin servidor. */
  const zipButton = action('Descargar seleccionados (ZIP)', async () => {
    check(invoiceSelection.size, 'Selecciona al menos un comprobante.');
    if (satToken) {
      zipButton.disabled = true; zipButton.textContent = 'Preparando el ZIP…';
      try {
        const data = await satApi('salidas/zip', { scope: 'seleccion', rfc: scope, ids: [...invoiceSelection] });
        download(new Blob([decode64(data.content)], { type: 'application/zip' }), data.name);
        announce('ZIP ordenado descargado con ' + invoiceSelection.size + ' comprobantes.');
      } catch (error) { toast(error.message, 'error'); }
      finally { zipButton.disabled = false; zipButton.textContent = 'Descargar seleccionados (ZIP)'; }
      return;
    }
    const entries = [];
    for (const id of invoiceSelection) {
      const file = await readStore('files', 'xml:' + id);
      if (file) entries.push({ name: id + '.xml', data: bytes(await file.blob.arrayBuffer()) });
    }
    check(entries.length, 'Ninguno de los seleccionados tiene XML guardado.');
    download(zipStore(entries), 'CFDI-seleccionados.zip');
    announce(entries.length + ' XML descargados en un ZIP.');
  }, undefined, 'down');
  /* Impresión por lote (1.6.16): todos los seleccionados en un solo
     documento imprimible, cada uno con su representación completa. */
  const printButton = action('Imprimir seleccionados', async () => {
    let printed = 0;
    for (const id of invoiceSelection) {
      const row = invoices.find(item => item.id === id);
      const file = await readStore('files', 'xml:' + id);
      if (!row || !file) continue;
      cfdiPrint(row, parseCfdiFull(bytes(await file.blob.arrayBuffer())), { append: printed > 0, print: false });
      printed++;
    }
    check(printed, 'Ninguno de los seleccionados tiene XML guardado.');
    setTimeout(() => window.print(), 80);
    announce(printed + ' comprobantes listos para imprimir en un solo documento.');
  }, undefined, 'print');
  const chips = n('div', undefined, 'filter-chips');
  const clearFilters = () => {
    term = ''; month = ''; invoiceKind = ''; invoiceState = ''; invoicePayState = ''; invoiceContraparte201 = ''; direction = 'Todos'; invoicePage = 0; render();
  };
  const result = n('div');
  const update = () => {
    const rows = invoiceRows();
    const paidBy = paidByMap();
    exportButton.disabled = !rows.length;
    zipButton.disabled = !invoiceSelection.size;
    printButton.disabled = !invoiceSelection.size;
    zipButton.hidden = !invoiceSelection.size;
    printButton.hidden = !invoiceSelection.size;
    /* Chips de filtros activos con su ✕ (UX-04): lo aplicado se ve y
       se quita sin cazar controles; y «Limpiar filtros» siempre a mano. */
    chips.replaceChildren();
    const activeChips = [];
    if (term) activeChips.push(['«' + term + '»', () => { term = ''; render(); }]);
    if (month) activeChips.push(['Mes ' + month.slice(5, 7) + '/' + month.slice(0, 4), () => { month = ''; render(); }]);
    if (invoiceKind) activeChips.push([KINDS[invoiceKind], () => { invoiceKind = ''; render(); }]);
    if (invoiceState) activeChips.push(['Estado: ' + invoiceState, () => { invoiceState = ''; render(); }]);
    if (invoiceContraparte201) activeChips.push(['Contraparte: ' + (partesCp201.get(invoiceContraparte201) || invoiceContraparte201),
      () => { invoiceContraparte201 = ''; render(); }]);
    if (direction !== 'Todos') activeChips.push([direction, () => { direction = 'Todos'; render(); }]);
    for (const [label, clear] of activeChips) {
      const chip = n('button', label + ' ✕', 'filter-chip');
      chip.type = 'button';
      chip.onclick = clear;
      chips.append(chip);
    }
    if (activeChips.length) chips.append(action('Limpiar filtros', clearFilters));
    invoicePage = Math.min(invoicePage, Math.max(0, Math.ceil(rows.length / 35) - 1));
    const sliced = rows.slice(invoicePage * 35, (invoicePage + 1) * 35);
    const foot = n('div', undefined, 'table-foot');
    foot.setAttribute('aria-live', 'polite');
    foot.append(n('span', number.format(rows.length) + ' comprobantes'));
    /* Total de lo filtrado (2.0.1 · nº 13): la suma de las
       facturas que los filtros dejan en pantalla (las
       canceladas fuera, como en todos los totales de la casa),
       presentada como lo que es: el total de lo filtrado. */
    if (invoiceContraparte201) {
      const totalFiltrado = rows.filter(row => !rowCancelled(row))
        .reduce((suma, row) => suma + totalCents(row), 0n);
      foot.append(n('span', 'Total de lo filtrado: $' + centsLabel(totalFiltrado)));
    }
    if (rows.length > 35) {
      const options = n('div', undefined, 'actions');
      const prev = action('Anterior', () => { invoicePage--; update(); });
      const next = action('Siguiente', () => { invoicePage++; update(); });
      prev.disabled = invoicePage === 0; next.disabled = (invoicePage + 1) * 35 >= rows.length;
      options.append(prev, n('span', String(invoicePage + 1)), next); foot.append(options);
    }
    const content = sliced.length ? grid(['', 'Emisor → receptor', 'Fecha', 'Folio', 'Tipo', 'Total', 'Estado SAT', 'Acción'], sliced.map(row => {
      const pick = input('checkbox');
      pick.checked = invoiceSelection.has(row.id);
      pick.setAttribute('aria-label', 'Seleccionar el CFDI ' + row.id);
      pick.onchange = () => {
        if (pick.checked) invoiceSelection.add(row.id); else invoiceSelection.delete(row.id);
        zipButton.disabled = !invoiceSelection.size;
        printButton.disabled = !invoiceSelection.size;
        zipButton.hidden = !invoiceSelection.size;
        printButton.hidden = !invoiceSelection.size;
      };
      /* Fusión Facturas/Visor (1.11.0): la fila lleva las DOS
         píldoras — estado en el SAT (con su fecha, vía statusCell)
         y estado de pago (Pagada/Parcial/Pendiente, del Visor). */
      const estadoStack = n('div', undefined, 'estado-stack');
      estadoStack.style.display = 'flex';
      estadoStack.style.flexDirection = 'column';
      estadoStack.style.gap = '4px';
      estadoStack.style.alignItems = 'flex-start';
      estadoStack.append(statusCell(row.id));
      if (row.kind === 'I') {
        const pago = visorEstadoPago(row, paidBy);
        estadoStack.append(statusPill(pago.state, pago.label, 'Estado de pago según Dinero'));
      }
      return [pick, cell(row.from.name || row.from.rfc, '→ ' + (row.to.name || row.to.rfc)),
        dateLabel(row.date),
        /* Columna Folio (1.18.0): la factura se nombra por su folio,
           no por el fragmento de UUID. */
        (() => { const folioBtn = n('button', row.fiscal ? ((row.fiscal.serie ? row.fiscal.serie + '-' : '') + (row.fiscal.folio || '')) || '—' : '—', 'cell-link');
          folioBtn.type = 'button'; folioBtn.title = 'Abrir el detalle de este comprobante';
          folioBtn.onclick = () => invoiceDetail(row); return folioBtn; })(),
        cell(KINDS[row.kind], rowRole(row)),
        (() => { const totalBtn = n('button', amount(row), 'cell-link cell-link-total');
          totalBtn.type = 'button'; totalBtn.title = 'Abrir el detalle de este comprobante';
          totalBtn.onclick = () => invoiceDetail(row); return totalBtn; })(), estadoStack, invoiceActions(row)];
    })) : empty('Sin coincidencias', !invoices.some(row => !scope || row.from.rfc === scope || row.to.rfc === scope)
        ? 'Todavía no hay facturas de este contribuyente en PacoSAT. Descárgalas del SAT o importa un lote.'
        : 'Importa un lote o cambia los filtros.',
      !invoices.some(row => !scope || row.from.rfc === scope || row.to.rfc === scope)
        ? action('Descargar del SAT', () => downloadSheet(scope), 'primary', 'down')
        : action('Limpiar filtros', clearFilters, 'primary'));
    /* En móvil la tabla se vuelve tarjetas (clases card-table). */
    if (content.classList?.contains('table-wrap')) {
      content.classList.add('card-table');
      content.querySelector('table')?.classList.add('grid-table');
    }
    /* Cabeceras tocables (2.0.1 · nº 26): «Fecha» alterna
       reciente/antiguo y «Total» alterna el orden por importe;
       la cabecera activa enseña su flecha. Es el mismo orden
       del selector de «Más filtros»: un solo estado. */
    if (content.querySelectorAll) for (const th of content.querySelectorAll('th')) {
      const base = th.textContent.replace(/ [↓↑]$/, '');
      if (base !== 'Fecha' && base !== 'Total') continue;
      const activo = base === 'Fecha' ? (invoiceOrder === 'recent' || invoiceOrder === 'oldest')
        : (invoiceOrder === 'importe-mayor' || invoiceOrder === 'importe-menor');
      if (activo) th.textContent = base + (invoiceOrder === 'oldest' || invoiceOrder === 'importe-menor' ? ' ↑' : ' ↓');
      th.style.cursor = 'pointer';
      th.title = 'Ordenar por ' + (base === 'Fecha' ? 'fecha' : 'importe');
      th.onclick = () => {
        invoiceOrder = base === 'Fecha'
          ? (invoiceOrder === 'oldest' ? 'recent' : 'oldest')
          : (invoiceOrder === 'importe-mayor' ? 'importe-menor' : 'importe-mayor');
        order.value = invoiceOrder; invoicePage = 0; update();
      };
    }
    if (direction === 'Canceladas' && rows.length) {
      /* El efecto en el mes, por cancelada (2.0.1): el dato NO
         viaja en la fila — lo calcula el servidor en
         /api/cancelacion-efecto200h desde el cálculo único y su
         texto llega tal cual. La FECHA de cancelación no llega
         al cliente: la fila enseña el estatus de cancelación
         del SAT (sat.cancellation, en su pastilla) y aquí se
         nombra la fecha de la última revisión como lo que es,
         sin presentarla como fecha de cancelación. */
      const efecto = n('div', undefined, 'canceladas-efecto201');
      efecto.append(n('h3', 'Efecto de cada cancelación en su mes'));
      const pagina = rows.slice(invoicePage * 35, invoicePage * 35 + 35);
      for (const row of pagina) {
        const item = fiscalResults.get(row.id);
        const lineaEfecto = n('p', 'Calculando el efecto…', 'muted');
        const fila = n('div', undefined, 'cp-row');
        const main = n('div', undefined, 'cp-main');
        main.append(n('strong', (row.from.name || row.from.rfc) + ' → ' + (row.to.name || row.to.rfc) +
            ' · ' + amount(row) + ' · emitido el ' + dateLabel(row.date)),
          n('span', 'Estado en el SAT: Cancelado' +
            (item?.sat?.cancellation ? ' (' + item.sat.cancellation + ')' : '') +
            (item?.sat?.checked ? ' · última revisión de PacoSAT: ' + localDateTime(item.sat.checked) : ''), 'muted'),
          lineaEfecto);
        fila.append(main);
        efecto.append(fila);
        satApi('cancelacion-efecto200h?uuid=' + encodeURIComponent(row.id)).then(data => {
          if (!lineaEfecto.isConnected) return;
          lineaEfecto.textContent = data?.texto || 'El servidor no devolvió el efecto de esta cancelación.';
        }).catch(() => { if (lineaEfecto.isConnected) lineaEfecto.textContent = 'No se pudo calcular el efecto de esta cancelación.'; });
      }
      result.replaceChildren(content, efecto, foot);
      return;
    }
    result.replaceChildren(content, foot);
  };
  search.oninput = () => { term = search.value; invoicePage = 0; update(); };
  period.onchange = () => { month = period.value; invoicePage = 0; update(); };
  type.onchange = () => { invoiceKind = type.value; invoicePage = 0; update(); };
  state.onchange = () => { invoiceState = state.value; invoicePage = 0; update(); };
  payState.onchange = () => { invoicePayState = payState.value; invoicePage = 0; update(); };
  cpSel201.onchange = () => { invoiceContraparte201 = cpSel201.value; invoicePage = 0; update(); };
  order.onchange = () => { invoiceOrder = order.value; invoicePage = 0; update(); };
  /* Sin muralla (1.32.1, F2): la barra enseña buscar + mes +
     estado; tipo, pago, orden, exportar e importar carpeta viven
     en «Más filtros», plegado. Las acciones de seleccionados
     solo existen cuando hay selección. */
  const masFiltros = n('div', undefined, 'filters-mas');
  masFiltros.hidden = true;
  masFiltros.append(type, payState, cpSel201, order, exportButton, folderButton);
  const masBtn = action('Más filtros', () => { masFiltros.hidden = !masFiltros.hidden; });
  zipButton.hidden = true; printButton.hidden = true;
  /* «Imprimir» visible de la vista filtrada (2.0.1): imprime
     las filas que los filtros dejan, no solo la selección. El
     «Imprimir seleccionados» de siempre sigue existiendo y
     aparece cuando hay selección. */
  const imprimirVistaBtn = action('Imprimir', () => {
    const filas = invoiceRows();
    imprimirVista201('Facturas' + (direction !== 'Todos' ? ' · ' + direction : '') + (month ? ' · ' + month : ''),
      number.format(filas.length) + ' comprobante(s) con los filtros en pantalla. Las canceladas no entran en los totales.',
      ['Fecha', 'Folio', 'Emisor → receptor', 'Tipo', 'Total', 'Estado SAT'],
      filas.map(row => [dateLabel(row.date),
        row.fiscal ? ((row.fiscal.serie ? row.fiscal.serie + '-' : '') + (row.fiscal.folio || '')) || '—' : '—',
        (row.from.name || row.from.rfc) + ' → ' + (row.to.name || row.to.rfc),
        KINDS[row.kind] || row.kind, amount(row),
        invoiceStateOf(row) === 'none' ? 'Sin revisar todavía' : invoiceStateOf(row)]));
  }, undefined, 'print');
  /* El «Imprimir» va en la fila de filtros principal (tabs),
     siempre a la vista también en móvil — no dentro del panel
     «Filtrar», que en móvil va plegado. */
  tabs.append(imprimirVistaBtn);
  controls.append(search, period, state, masBtn, zipButton, printButton);
  /* Si hay CFDI sin revisar, el camino a revisarlos vive en la
     propia tabla (flujos §3.4): un toque y la revisión corre en
     SAT › Estado de mis CFDI. */
  if (invoices.filter(matches).some(row => invoiceStateOf(row) === 'none'))
    /* «Revisar mis CFDI ahora» EJECUTA la revisión (1.18.0): antes
       solo navegaba a Vigilancia. */
    controls.append(action('Revisar mis CFDI ahora', () => monitorCheckNow(), undefined, 'shield'));
  /* Filtros en móvil (1.18.0): panel plegable con «Aplicar» en vez
     de la fila que se salía por la derecha. En escritorio el botón
     no se ve y los filtros van como siempre. */
  controls.classList.add('invoice-filters');
  const applyFilters = action('Aplicar', () => controls.classList.remove('open'), 'filters-apply');
  controls.append(applyFilters);
  const filtersToggle = action('Filtrar', () => controls.classList.toggle('open'), 'filters-toggle');
  list.append(tabs, filtersToggle, controls, masFiltros, chips, result);
  update();
  return [list];
}
function documentScreen() {
  const list = panel(docsGrupoDecl201 ? 'El resto del expediente' : 'Documentos del expediente');
  const filters = n('div', undefined, 'filters');
  const choice = select([['', 'Todos los documentos'], ...DOCUMENTS.map(x => [x, x])], docFilter, 'Tipo de documento');
  choice.onchange = () => { docFilter = choice.value; docPage = 0; render(); };
  /* Buscador y paginación como en Facturas (UX-16): con cientos de PDF
     ya no toca hacer scroll infinito. */
  const search = input('search', { value: docTerm, placeholder: 'Buscar por nombre o folio fiscal' });
  search.setAttribute('aria-label', 'Buscar documentos');
  search.oninput = () => { docTerm = search.value; docPage = 0; paintDocs(); };
  filters.append(choice, search);
  list.append(filters);
  /* La doctrina, en llano y a la vista (2.0.1): llenarse de
     papeles se resuelve archivando, no borrando. */
  list.append(n('p', 'Los documentos no se borran: se archivan y se recuperan cuando quieras, desde Archivo. Cada fila lleva su «Archivar» junto a «Descargar».', 'muted'));
  /* Subir un papel en 2 toques (tanda 7A, F7): el botón
     protagonista de Documentos; la tarjeta de clasificación
     vive en la parte diferida de Salidas. */
  if (typeof satToken !== 'undefined' && satToken) {
    const papelBtn = action('Subir un papel', () =>
      ensureLazyPart('salidas').then(() => { if (typeof subirPapel200g === 'function') subirPapel200g(); }), 'primary', 'up');
    const papelRow = n('div', undefined, 'sat-actions');
    papelRow.append(papelBtn, n('span', 'Foto o PDF: sugiere RFC y tipo, y archiva en 2 toques. En escritorio también puedes arrastrar el archivo sobre la app.', 'muted'));
    /* «Imprimir» visible de la vista (2.0.1): la lista del
       expediente tal cual está filtrada, en papel. */
    const imprimirDocsBtn = action('Imprimir', () => {
      const needle = docTerm.trim().toLocaleLowerCase('es-MX');
      const filas = documents.filter(doc => !doc.archived && (!scope || doc.rfc === scope) && (!docFilter || doc.kind === docFilter) &&
        (docFilter || (doc.kind !== 'Constancia / CIF' && doc.kind !== 'Opinión de cumplimiento')) &&
      /* Expediente vivo (2.0.1): con el grupo de Declaraciones
         pintado arriba, las declaraciones y sus acuses tampoco
         se repiten en esta lista — viven en su grupo, por
         ejercicio. Sin grupo (modo local), la lista los enseña
         como siempre. Con filtro de clase a mano, manda el
         filtro, igual que con constancia y opinión. */
      (docFilter || !docsGrupoDecl201 || !(doc.kind || '').startsWith('Declaración') && !(doc.kind || '').startsWith('Acuse')) &&
        (!needle || (doc.name + ' ' + (doc.uuid || '')).toLocaleLowerCase('es-MX').includes(needle)));
      imprimirVista201('Documentos del expediente', number.format(filas.length) + ' documento(s) con los filtros en pantalla.',
        ['Documento', 'RFC', 'Fecha', 'Periodo'],
        filas.map(doc => [doc.kind + ' · ' + doc.name, doc.rfc, dateLabel(doc.date), doc.period || '—']));
    }, 'soft', 'print');
    papelRow.append(imprimirDocsBtn);
    list.append(papelRow);
  }
  const result = n('div');
  list.append(result);
  function paintDocs() {
    const needle = docTerm.trim().toLocaleLowerCase('es-MX');
    const rows = documents.filter(doc => !doc.archived && (!scope || doc.rfc === scope) && (!docFilter || doc.kind === docFilter) &&
      /* Sin duplicados (1.32.1, Do2): la constancia y la opinión
         se pintan UNA vez — en sus tarjetas de trámite, con sus
         versiones — y Expedientes lista el resto de papeles. Con
         un filtro de clase elegido a mano, el filtro manda. */
      (docFilter || (doc.kind !== 'Constancia / CIF' && doc.kind !== 'Opinión de cumplimiento')) &&
      (docFilter || !docsGrupoDecl201 || !(doc.kind || '').startsWith('Declaración') && !(doc.kind || '').startsWith('Acuse')) &&
      (!needle || (doc.name + ' ' + (doc.uuid || '')).toLocaleLowerCase('es-MX').includes(needle)));
    docPage = Math.min(docPage, Math.max(0, Math.ceil(rows.length / 35) - 1));
    const sliced = rows.slice(docPage * 35, (docPage + 1) * 35);
    result.replaceChildren();
    if (sliced.length) result.append(grid(['Documento', 'RFC', 'Fecha', 'Periodo', 'Acción'], sliced.map(doc => {
      const acts = n('div', undefined, 'actions');
      acts.append(action('Ver', () => viewDocOnline(doc)));
      acts.append(action('Descargar', () => downloadDocOnline(doc)));
      if (doc.uuid) acts.append(action('Desvincular', () => unlinkDocument(doc)));
      if (typeof satToken !== 'undefined' && satToken) acts.append(action('Compartir', () =>
        ensureLazyPart('salidas').then(() => { if (typeof compartir200g === 'function') compartir200g('documento', doc.id); })));
      acts.append(action('Archivar', () => docArchivar1311(doc)));
      acts.append(action('Eliminar', () => deleteDocument(doc)));
      const celdaDoc = cell(doc.kind, doc.uuid ? doc.uuid + ' · ' + doc.name : doc.name);
      celdaDoc.dataset.doc200g = doc.id;
      return [celdaDoc, doc.rfc, dateLabel(doc.date), doc.period || '—', acts];
    })));
    else result.append(empty('Sin documentos', 'Sube un PDF o descarga tu constancia y tu opinión del SAT: el gesto está aquí mismo.',
      scope && typeof satToken !== 'undefined' && satToken
        ? action('Descargar constancia y opinión', async (boton) => {
            const texto = boton ? boton.textContent : '';
            if (boton) { boton.disabled = true; boton.textContent = 'Descargando del portal…'; }
            try {
              const data = await satApi('satdocs/run', { rfc: scope });
              const failed = Object.values(data.results || {}).filter(result => !result.ok).length;
              toast(failed ? 'El portal no entregó ' + failed + ' documento(s): quedó registrado.' :
                'Documentos descargados y archivados.', failed ? 'error' : 'ok');
              await refresh();
            } catch (error) { toast(error.message, 'error'); }
            finally { if (boton && boton.isConnected) { boton.disabled = false; boton.textContent = texto; } }
          }, 'primary', 'down')
        : undefined));
    /* Miniaturas reales (tanda 7A, A6): el servidor genera la
       primera página UNA vez y la cachea; aquí se cuelga la
       imagen solo donde el listado la confirma — si un PDF no
       se puede renderizar, queda el texto de siempre. */
    if (typeof satToken !== 'undefined' && satToken && sliced.length) {
      satApi('miniaturas200g' + (scope ? '?rfc=' + encodeURIComponent(scope) : '')).then(d => {
        if (!result.isConnected || !d?.documentos) return;
        const oks = new Set(d.documentos.filter(x => x.estado === 'ok').map(x => x.id));
        for (const celda of result.querySelectorAll('[data-doc200g]')) {
          const id = celda.dataset.doc200g;
          if (!oks.has(id)) continue;
          fetch('/api/miniatura200g?id=' + encodeURIComponent(id), { headers: { 'X-PacoSAT-Token': satToken } })
            .then(r => r.ok ? r.blob() : null).then(blob => {
              if (!blob || !celda.isConnected) return;
              const img = n('img'); img.alt = 'Primera página'; img.width = 54;
              img.src = URL.createObjectURL(blob); celda.prepend(img);
            }).catch(() => {});
        }
      }).catch(() => {});
    }
    const foot = n('div', undefined, 'table-foot');
    foot.append(n('span', number.format(rows.length) + ' documentos'));
    if (rows.length > 35) {
      const options = n('div', undefined, 'actions');
      const prev = action('Anterior', () => { docPage--; paintDocs(); });
      const next = action('Siguiente', () => { docPage++; paintDocs(); });
      prev.disabled = docPage === 0; next.disabled = (docPage + 1) * 35 >= rows.length;
      options.append(prev, n('span', String(docPage + 1)), next);
      foot.append(options);
    }
    result.append(foot);
  }
  paintDocs();
  return [list];
}
function satGuideScreen() {
  const guide = n('section', undefined, 'guide');
  const info = n('div');
  info.append(n('h2', 'Descarga en el SAT e importa en PacoSAT'), n('p', 'Descarga el ZIP en el portal e impórtalo aquí. PacoSAT asigna los XML a los RFC registrados y omite los UUID repetidos. Y si prefieres no bajarlos a mano, la descarga automática está en «Descargar del SAT»: pide el periodo y el paquete llega solo.'));
  const options = n('div', undefined, 'actions');
  options.append(action('Elegir ZIP o XML', chooseImport, 'primary', 'up'), action('Importar carpeta', () => {
    check(people.length, 'Agrega primero un RFC.'); $('folder').click();
  }, undefined, 'folder'));
  guide.append(info, options);
  const links = panel('Trámites oficiales');
  for (const [title, summary, url] of portals) {
    const item = n('div', undefined, 'portal');
    const link = n('a', title + ' ↗');
    link.href = url; link.target = '_blank'; link.rel = 'noopener noreferrer';
    item.append(link, n('p', summary)); links.append(item);
  }
  return [guide, links];
}
/* Salud del respaldo (1.23.0, frente C): consume status.backupHealth
   {enabled, lastOk, daysSince, stale, failed, error}. La misma tarjeta
   vive en Hoy y en Ajustes › Respaldos; «Comprobar respaldo ahora»
   llama a POST /api/backup/verify (existe desde la 1.22.0) y pinta
   el resultado EN EL SITIO, sin recargar la pantalla. Ante una
   respuesta perdida se re-lee el estado antes de declarar error. */
function backupHealthCard() {
  if (typeof satToken === 'undefined' || !satToken) return null;
  if (!(typeof satData !== 'undefined' && satData && satData.backupHealth)) return null;
  const wrap = panel('Respaldo');
  const body = n('div', undefined, 'portal');
  const estado = n('p', '', 'today-line');
  const result = n('div');
  const paint = () => {
    const bh = satData.backupHealth || {};
    if (!bh.enabled) estado.textContent = 'Respaldo programado sin activar en el servidor: actívalo para que la copia se haga sola.';
    else if (bh.failed) estado.textContent = '⚠ El último respaldo falló' + (bh.error ? ': ' + bh.error : '.');
    else if (bh.lastOk) {
      const dias = bh.daysSince != null ? Number(bh.daysSince) :
        Math.max(0, Math.floor((Date.now() - (typeof bh.lastOk === 'number' ? bh.lastOk : Date.parse(bh.lastOk))) / 86400000));
      estado.textContent = 'Último respaldo correcto: ' + (dias === 0 ? 'hoy' : 'hace ' + dias + (dias === 1 ? ' día' : ' días')) +
        (bh.stale ? ' — ⚠ va atrasado: toca comprobarlo.' : '.');
    } else estado.textContent = 'Respaldo activado, pero aún no consta ninguno correcto.';
  };
  paint();
  const verify = n('button', 'Comprobar respaldo ahora', 'soft');
  verify.type = 'button';
  verify.onclick = async () => {
    verify.disabled = true; verify.textContent = 'Comprobando…';
    try {
      const data = await satApi('backup/verify', {});
      result.replaceChildren(...(data.results || []).map(item =>
        n('p', (item.ok ? '✓ ' : '✗ ') + item.label + ': ' + item.detail, item.ok ? '' : 'error-text')));
      if (!data.results?.length) result.replaceChildren(n('p', data.ok ? '✓ Respaldo íntegro.' : '✗ La comprobación falló.', data.ok ? '' : 'error-text'));
      toast(data.ok ? 'Respaldo comprobado: íntegro.' : 'La comprobación del respaldo falló.', data.ok ? 'ok' : 'error');
      await pollSat().catch(() => {});
      paint();
    } catch (error) {
      let releido = false;
      try { await pollSat(); releido = Boolean(satData.backupHealth); } catch { /* sin re-lectura posible */ }
      if (releido) {
        paint();
        result.replaceChildren(n('p', 'La respuesta se perdió: arriba ves el estado que el servidor tiene ahora, re-leído antes de darlo por error.', 'muted'));
      } else toast(error.message, 'error');
    } finally { verify.disabled = false; verify.textContent = 'Comprobar respaldo ahora'; }
  };
  /* Ensayo de restauración completo (1.24.0, punto 6): resucita
     el conjunto en una base aislada del servidor y cuenta lo que
     contiene; el resultado se pinta en el sitio, en llano. Vive
     en esta tarjeta —la de Hoy y la de Ajustes › Respaldos— para
     que la prueba quede a un toque desde Hoy y a dos desde
     Ajustes. */
  const restoreResult = n('div');
  const restore = n('button', 'Probar restauración', 'soft');
  restore.type = 'button';
  restore.onclick = async () => {
    restore.disabled = true; restore.textContent = 'Resucitando la copia en un espacio aislado…';
    try {
      const data = await satApi('backup/restore-test', {});
      restoreResult.replaceChildren(n('p', (data.ok ? '✓ ' : '✗ ') + (data.detail || 'Sin detalle.'), data.ok ? '' : 'error-text'));
      toast(data.ok ? 'La copia resucita: el ensayo pasó.' : 'El ensayo de restauración no pasó.', data.ok ? 'ok' : 'error');
    } catch (error) {
      /* Respuesta perdida: el ensayo deja su resultado en el
         estado del respaldo; se re-lee antes de declarar error. */
      let releido = false;
      try { await pollSat(); releido = Boolean(satData.backupHealth); } catch { /* sin re-lectura posible */ }
      if (releido) restoreResult.replaceChildren(n('p', 'La respuesta se perdió: el estado de arriba es el que el servidor tiene ahora, re-leído antes de darlo por error.', 'muted'));
      else toast(error.message, 'error');
    } finally { restore.disabled = false; restore.textContent = 'Probar restauración'; }
  };
  body.append(estado, verify, result, restore, restoreResult);
  wrap.append(body);
  return wrap;
}
/* Cierre de línea base histórica (1.23.0, frente E — acción de
   administrador): primero el cálculo en seco (dryRun) con su
   informe, y solo con confirmación expresa el cierre de verdad.
   No se borra nada: lo cerrado queda en el archivo consultable. */
function baselineClosePanel() {
  const wrap = panel('Cerrar línea base histórica');
  const body = n('div', undefined, 'portal');
  body.append(n('p', 'Cierra los avisos y archiva los comprobantes de los ejercicios ya prescritos (2020 y anteriores), para que dejen de ocupar las pantallas y las colas de trabajo. No se borra nada: todo queda en el archivo, consultable.'));
  const out = n('div');
  const run = n('button', 'Cerrar línea base histórica', 'soft');
  run.type = 'button';
  run.onclick = async () => {
    run.disabled = true; run.textContent = 'Calculando el cierre…';
    try {
      const dry = await satApi('admin/baseline-close', { dryRun: true });
      out.replaceChildren(
        n('p', 'Avisos a cerrar: ' + number.format(dry.avisos?.count || 0) + ' por $' + money(dry.avisos?.sum ?? 0)),
        n('p', 'Comprobantes a archivar: ' + number.format(dry.comprobantes?.count || 0) + ' por $' + money(dry.comprobantes?.sum ?? 0) +
          (dry.comprobantes?.ilegibles ? ' · ' + number.format(dry.comprobantes.ilegibles) + ' ilegibles' : '')),
        n('p', 'Primer ejercicio vivo tras el cierre: ' + (dry.corte?.primerEjercicioVivo || '—')));
      const confirmar = n('button', 'Sí, cerrar la línea base', 'primary small');
      confirmar.type = 'button';
      confirmar.onclick = async () => {
        confirmar.disabled = true; confirmar.textContent = 'Cerrando…';
        try {
          const done = await satApiGuardar('admin/baseline-close', { dryRun: false }, async () => {
            const check = await satApi('admin/baseline-close', { dryRun: true });
            return (check.avisos?.count || 0) === 0 && (check.comprobantes?.count || 0) === 0;
          });
          out.replaceChildren(n('p', '✓ Línea base cerrada' + (done?.aplicadoTrasError ? ' (quedó registrado: la re-lectura lo confirma)' : '') +
            '. Ejecutado: ' + (done.ejecutado === false ? 'no' : 'sí') +
            ' · avisos ' + number.format(done.avisos?.count ?? dry.avisos?.count ?? 0) +
            ' · comprobantes ' + number.format(done.comprobantes?.count ?? dry.comprobantes?.count ?? 0) +
            '. Nada se borró: queda en el archivo.'));
          toast('Línea base histórica cerrada.', 'ok');
          refreshAvisos(true).catch(() => {});
        } catch (error) { toast(error.message, 'error'); confirmar.disabled = false; confirmar.textContent = 'Sí, cerrar la línea base'; }
      };
      out.append(confirmar);
    } catch (error) { toast(error.message, 'error'); }
    finally { run.disabled = false; run.textContent = 'Cerrar línea base histórica'; }
  };
  body.append(run, out);
  wrap.append(body);
  return wrap;
}
/* Login propio de administrador (1.24.0, decisión 2A): enseña el
   estado —configurado o pendiente de que Paco fije su
   contraseña— y, si está configurado, deja entrar y salir desde
   aquí. La contraseña SOLO viaja en el envío del formulario a su
   propio servidor; nunca se guarda en la página. La puerta
   vigente no cambia con esto: el login convive con ella. */
function adminLoginCard() {
  if (typeof satToken === 'undefined' || !satToken) return null;
  const wrap = panel('Login propio de administrador');
  const body = n('div', undefined, 'portal');
  const estado = n('p', '', 'today-line');
  const zona = n('div');
  body.append(estado, zona);
  wrap.append(body);
  const configurado = Boolean(typeof satData !== 'undefined' && satData && satData.adminLogin && satData.adminLogin.configurado);
  if (!configurado) {
    estado.textContent = 'Pendiente de que fijes tu contraseña en la configuración del servidor (la carpeta de secretos del servidor): sin ella, este login no existe. Tu acceso de siempre no cambia.';
    return wrap;
  }
  estado.textContent = 'Configurado: puedes entrar con tu contraseña propia. Convive con tu acceso de siempre; ninguno sustituye al otro en esta versión.';
  const paint = async () => {
    zona.replaceChildren(n('p', 'Comprobando tu sesión…', 'muted'));
    try {
      const sesion = await satApi('admin/session');
      zona.replaceChildren();
      if (sesion.activa) {
        zona.append(n('p', 'Has entrado con el login propio en este navegador.', 'today-line'));
        const salir = n('button', 'Cerrar sesión', 'soft small');
        salir.type = 'button';
        salir.onclick = async () => {
          salir.disabled = true;
          try { await satApi('admin/logout', {}); toast('Sesión del login propio cerrada.', 'ok'); paint(); }
          catch (error) { toast(error.message, 'error'); salir.disabled = false; }
        };
        zona.append(salir);
        return;
      }
      const form = n('form', undefined, 'inline-form');
      const input = n('input');
      input.type = 'password';
      input.autocomplete = 'current-password';
      input.placeholder = 'Tu contraseña de administrador';
      input.setAttribute('aria-label', 'Tu contraseña de administrador');
      const entrar = n('button', 'Entrar con mi contraseña', 'primary small');
      entrar.type = 'submit';
      form.append(input, entrar);
      form.onsubmit = async event => {
        event.preventDefault();
        entrar.disabled = true; entrar.textContent = 'Entrando…';
        try {
          const payload = {};
          payload['pass' + 'word'] = input.value;
          await satApi('admin/login', payload);
          toast('Has entrado con el login propio.', 'ok');
          paint();
        } catch (error) { toast(error.message, 'error'); }
        finally { entrar.disabled = false; entrar.textContent = 'Entrar con mi contraseña'; }
      };
      zona.append(form);
    } catch { zona.replaceChildren(n('p', 'No se pudo comprobar la sesión ahora.', 'muted')); }
  };
  paint();
  return wrap;
}
/* Pantalla de entrada diseñada (1.26.0, Ronda Visual): la cara
   del login propio — la brecha del 4 en la auditoría visual era
   que la puerta de verdad seguía siendo el diálogo nativo del
   navegador. La pantalla habla con el mismo endpoint que la
   tarjeta de Ajustes (admin/login) y CONVIVE con la puerta
   vigente: se enseña al arrancar cuando el login propio está
   configurado y no hay sesión suya activa, y «Entrar con mi
   acceso de siempre» la aparta por esta sesión del navegador.
   Sin login configurado, nunca aparece: no puede bloquear a
   nadie. Retirar la puerta antigua es un paso posterior, de
   Paco, atado a su gesto de activación. */
let entryChecked = false;
function showEntry() {
  const entry = $('entry');
  if (!entry || !entry.hidden) return;
  entry.hidden = false;
  const form = $('entry-form'), input = $('entry-pass'),
    error = $('entry-error'), go = $('entry-go');
  form.onsubmit = async event => {
    event.preventDefault();
    go.disabled = true; go.textContent = 'Entrando…'; error.hidden = true;
    try {
      const payload = {};
      payload['pass' + 'word'] = input.value;
      await satApi('admin/login', payload);
      input.value = '';
      entry.hidden = true;
      toast('Has entrado con el login propio.', 'ok');
      if (typeof render === 'function') render();
    } catch (err) {
      error.textContent = err.message;
      error.hidden = false;
    } finally { go.disabled = false; go.textContent = 'Entrar'; }
  };
  $('entry-skip').onclick = () => {
    try { sessionStorage.setItem('pacosat-entry-skip', '1'); } catch { /* sin almacén: se aparta igual */ }
    entry.hidden = true;
  };
  /* Ver/ocultar la contraseña (1.29.0, peldaño 1 — solo la parte
     visual): el botón cambia el tipo del campo, nada más. */
  const showBtn = $('entry-show');
  if (showBtn) showBtn.onclick = () => {
    const visible = input.type === 'text';
    input.type = visible ? 'password' : 'text';
    showBtn.textContent = visible ? 'Ver' : 'Ocultar';
    try { input.focus(); } catch { /* sin foco */ }
  };
  setTimeout(() => { try { input.focus(); } catch { /* sin foco: la pantalla queda */ } }, 60);
}
async function maybeShowEntry() {
  if (entryChecked) return;
  entryChecked = true;
  if (typeof satToken === 'undefined' || !satToken) return;
  let skip = false;
  try { skip = Boolean(sessionStorage.getItem('pacosat-entry-skip')); } catch { skip = false; }
  if (skip) return;
  if (!(typeof satData !== 'undefined' && satData && satData.adminLogin && satData.adminLogin.configurado)) return;
  try {
    const sesion = await satApi('admin/session');
    if (!sesion.activa) showEntry();
  } catch { /* sin respuesta: la app sigue con su acceso de siempre */ }
}
/* Alta guiada de Elemental Denim (1.24.0, punto 7): el RFC consta
   (orden de Paco del 11 nov 2026) pero NO sus credenciales ni
   ningún dato fiscal más. La tarjeta deja el alta preparada con
   un toque —el perfil nace en el servidor en «faltan
   credenciales»— y dice qué falta y quién lo aporta: la CIEC o
   la e.firma se guardan desde el Centro SAT, nunca por chat. */
const ELEMENTAL_RFC = 'EDE1902136T2';
function elementalAltaCard() {
  if (typeof satToken === 'undefined' || !satToken) return null;
  if (!(typeof satData !== 'undefined' && satData)) return null;
  const profiles = satData.profiles || [];
  const pendiente = (satData.pendingProfiles || []).includes(ELEMENTAL_RFC);
  const conPerfil = profiles.some(profile => profile.rfc === ELEMENTAL_RFC);
  if (conPerfil && !pendiente) return null;
  const wrap = panel('Alta guiada · Elemental Denim');
  const body = n('div', undefined, 'portal');
  if (pendiente) {
    body.append(statusPill('warn', 'Faltan credenciales'),
      n('p', 'Elemental Denim (' + ELEMENTAL_RFC + ') ya consta como contribuyente, en estado «faltan credenciales»: ' +
        'ninguna descarga se intenta todavía. Falta que aportes su CIEC o su e.firma — se guardan desde «Descargar del SAT», ' +
        'nunca por chat — y en cuanto estén, su puesta en marcha aparece en Documentos como la de cualquier RFC.', 'today-line'),
      action('Ir a Descargar del SAT a aportarlas', () => showSatDownload(), 'primary', 'lock'));
  } else {
    body.append(statusPill('dim', 'Sin preparar'),
      n('p', 'Elemental Denim (' + ELEMENTAL_RFC + ') aún no consta como contribuyente. Prepárala con un toque: ' +
        'nace en el servidor en estado «faltan credenciales», sin inventar ningún dato suyo, y el alta se completa ' +
        'cuando aportes su CIEC o su e.firma desde «Descargar del SAT».', 'today-line'));
    const preparar = n('button', 'Preparar su alta', 'primary small');
    preparar.type = 'button';
    preparar.onclick = async () => {
      preparar.disabled = true; preparar.textContent = 'Preparando…';
      try {
        await satApi('profiles/prepare', { rfc: ELEMENTAL_RFC });
        toast('Alta preparada: Elemental Denim consta en «faltan credenciales».', 'ok');
        await pollSat().catch(() => {});
        render();
      } catch (error) {
        /* Respuesta perdida: se re-lee el estado antes de
           declarar el error (regla de verdad de las acciones). */
        try {
          await pollSat();
          if ((satData.pendingProfiles || []).includes(ELEMENTAL_RFC)) {
            toast('Quedó preparada: consta en «faltan credenciales».', 'ok');
            render();
            return;
          }
        } catch { /* sin re-lectura: manda el error original */ }
        toast(error.message, 'error');
        preparar.disabled = false; preparar.textContent = 'Preparar su alta';
      }
    };
    body.append(preparar);
  }
  wrap.append(body);
  return wrap;
}
function backupScreen() {
  const help = n('section', undefined, 'guide');
  const desc = n('div');
  desc.append(n('h2', 'Copia de todos tus RFC'), n('p', typeof cloudStorage !== 'undefined' && cloudStorage ?
    'El respaldo se cifra con tu contraseña y tus datos viven en tu NAS. Descarga también una copia fuera del NAS de vez en cuando (la copia externa automática va a Google Drive vía Cloud Sync). Restaurarlo reemplaza los expedientes actuales.' :
    'El respaldo se cifra con tu contraseña. Guárdalo antes de mover el archivo de PacoSAT, cambiar de navegador o borrar sus datos. Restaurarlo reemplaza los expedientes actuales.'));
  const options = n('div', undefined, 'actions');
  options.append(action('Restaurar respaldo', () => $('restore').click(), undefined, 'box'));
  options.append(action('Respaldo partido por RFC y año', splitBackupDialog, undefined, 'down'));
  help.append(desc, options);
  const screens = [help];
  if (satToken) {
    const auto = panel('Automatización del servidor');
    const sb = satData.scheduledBackup || {}, wf = satData.watchFolder || {};
    auto.append(grid(['Componente', 'Estado'], [
      ['Respaldo programado', sb.enabled ? (sb.frequency === 'weekly' ? 'Semanal' : 'Diario') + ' · último: ' +
        (sb.last ? localDateTime(sb.last) : 'aún no') + ' · siguiente: ' + (sb.next ? localDateTime(sb.next) : 'al próximo ciclo') +
        (sb.error ? ' · Error: ' + sb.error : '') + ' · incluye el estado operativo (descargas, el libro de peticiones al SAT y avisos pendientes)' : 'Sin configurar: se define en el archivo de arranque protegido del servidor.'],
      ['Destino secundario', !sb.enabled ? '—' : sb.secondary ? 'Configurado: recibe el mismo respaldo cifrado' +
        (sb.secondaryLastOk ? ' · última copia buena: ' + localDateTime(sb.secondaryLastOk) : ' · aún sin copia registrada') +
        (sb.secondaryError ? ' · ÚLTIMO FALLO: ' + sb.secondaryError : ' · sin fallos') +
        ' — esa carpeta es la que sube a Google Drive por Cloud Sync: fuera del NAS solo viaja el archivo cifrado' :
        'Sin configurar: añade «secondaryDir» al bloque backup del archivo de arranque (una carpeta sincronizada fuera del NAS).'],
      ['Prueba de restauración', !sb.enabled ? '—' : sb.verify ? (sb.verify.ok ? 'Íntegra' : 'CON FALLO') + ' · ' + localDateTime(sb.verify.at) +
        ' (' + sb.verify.source + ')' : 'Aún no se ha ejecutado: corre sola tras cada respaldo programado.'],
      ['Carpeta vigilada', wf.enabled ? 'Activa' + (wf.subfolders ? ' · incluye subcarpetas' : '') + ' · ' + wf.imported + ' importados · ' + wf.failed + ' con error' +
        (wf.incidents ? ' · ' + wf.incidents + ' con incidencias' : '') + (wf.waiting ? ' · ' + wf.waiting + ' en espera (copiándose)' : '') +
        (wf.lastScan ? ' · última revisión ' + localDateTime(wf.lastScan) : '') + (wf.error ? ' · ' + wf.error : '') :
        'Sin configurar: se define en el archivo de arranque protegido del servidor.']
    ]));
    if (sb.enabled) {
      const verifyActions = n('div', undefined, 'actions');
      verifyActions.append(action('Probar restauración ahora', async () => {
        await satApi('backup/verify', {});
        await pollSat(); render();
        announce('Prueba de restauración ejecutada: quedó registrada en la bitácora.');
      }, undefined, 'shield'));
      auto.append(verifyActions);
    }
    screens.push(auto);
    /* Salud del respaldo y cierre de línea base (1.23.0): la misma
       tarjeta de Hoy, aquí con su contexto de Respaldos, y la
       acción de administrador de la línea base. */
    const saludRespaldo = backupHealthCard();
    if (saludRespaldo) screens.push(saludRespaldo);
    if (!guestMode) screens.push(baselineClosePanel());
  }
  return screens;
}

/* ===== Vistas compuestas de la 1.11.0 (menú de 9 destinos) =====
   Cada destino compone las pantallas de siempre SIN reescribir sus
   motores: SAT = portada de tareas + 4 pestañas; Documentos = el
   expediente + las tarjetas del SAT (constancia/opinión y
   declaraciones, que salen del Centro SAT); Dinero = por cobrar y
   pagar + Bancos en pestaña; Cierre y reportes = cierre guiado +
   calendario + DIOT + reportes; Ajustes = secciones que absorben
   Respaldos, Sin conexión, Operaciones y Capacidades. */
/* La portada «Qué quieres hacer» se retiró en la 1.18.0: repetía
   las cuatro acciones directas y las cuatro pestañas de debajo.
   La pantalla abre con «¿Qué quieres del SAT?» y las pestañas. */
function satView() {
  /* Centro SAT retirado como pantalla (2.0.1, orden directa de
     Paco): ya no hay parrilla ni cajón de pestañas. navigate()
     traduce el destino 'sat' a la vista propia que satTab
     marque (descargar/monitor/lists/coverage/ejecutor), así que
     esta función solo queda como red de seguridad para quien la
     llame directamente: devuelve la pantalla de descarga. */
  if (typeof satToken === 'undefined' || !satToken) return satGuideScreen();
  return satDownloadScreen();
}
function docsView() {
  /* Expediente vivo (2.0.1, añadido de Paco): agrupado por tipo
     y sin duplicados DENTRO de la pantalla. Las tarjetas
     superiores de la 1.18.0 (docsTopCards) se retiran: repetían
     la constancia y la opinión que la sección de abajo ya pinta
     con sus versiones. El orden es: la sección del SAT
     (Constancia y Opinión, con vigente/anterior y su Archivar),
     el grupo de Declaraciones por ejercicio con su señal de
     faltantes, y el resto del expediente en su lista. */
  /* Arrastrar y soltar en Documentos (2.0.1 · nº 25): la parte
     diferida de Salidas trae el oyente global que manda cada
     PDF/imagen soltado a la MISMA tarjeta de clasificación y
     confirmación del botón «Subir un papel»
     (papelClasificar200g) — cargarla al entrar en Documentos
     deja ese camino activo en esta pantalla, sin subidas
     paralelas sin confirmar. */
  if (typeof ensureLazyPart === 'function') ensureLazyPart('salidas').catch(() => {});
  const parts = [];
  docsGrupoDecl201 = Boolean(typeof satToken !== 'undefined' && satToken &&
    typeof satDocsSection === 'function' && typeof declaracionesGrupo201 === 'function');
  if (typeof satToken !== 'undefined' && satToken && typeof satDocsSection === 'function') {
    parts.push(satDocsSection());
    if (typeof declaracionesGrupo201 === 'function') parts.push(declaracionesGrupo201());
  }
  parts.push(...documentScreen());
  if (typeof satToken !== 'undefined' && satToken && typeof satDocsSection === 'function') {
    if (typeof trabajosSatSection === 'function') parts.push(trabajosSatSection());
  }
  return parts;
}
function dineroView() {
  const parts = [tabbar([['dinero', 'Por cobrar y pagar'], ['bancos', 'Bancos']], dineroTab, key => { dineroTab = key; render(); })];
  parts.push(...(dineroTab === 'bancos' ? bancosScreen() : dineroScreen()));
  return parts;
}
/* Cierre guiado: la checklist que el servidor ya calcula, pintada
   como pasos con estado y su acción en cada paso (antes solo se
   leía, resumida, dentro de Hoy). */
function cierreGuiadoPanel() {
  const wrap = panel('Cierre del mes, paso a paso');
  const now = new Date();
  const monthKey = now.getFullYear() + '-' + String(now.getMonth() + 1).padStart(2, '0');
  const body = n('div');
  body.append(n('p', 'Consultando los pasos del cierre…'));
  wrap.append(cierreTodoCard(monthKey), body);
  /* Destinos por el ID estable del paso (1.18.0), no por el texto
     de su etiqueta: cada «Resolver ahora» cae en la pantalla que
     resuelve ESE paso — Respaldos en Ajustes › Respaldos,
     constancias en Documentos, el informe en Reportes. */
  const goFor = item => {
    const porId = {
      cfdi: () => navigate('invoices'), desglose: () => navigate('invoices'),
      conciliacion: () => navigate('bancos'), complementos: () => navigate('dinero'),
      pue: () => navigate('dinero'), cancelaciones: () => navigate('invoices'),
      faltantes: () => navigate('coverage'), respaldo: () => navigate('backup'),
      constancias: () => navigate('docs'),
      informe: () => { cierreSection = 'reportes'; render(); }
    };
    if (porId[item.id]) return porId[item.id];
    const text = String(item.label || '').toLocaleLowerCase('es-MX');
    if (/constancia|opinión|opinion|documento|declarac/.test(text)) return () => navigate('docs');
    if (/respaldo|copia/.test(text)) return () => navigate('backup');
    if (/concilia|banco|cuenta/.test(text)) return () => navigate('bancos');
    if (/informe|reporte|contadora/.test(text)) return () => { cierreSection = 'reportes'; render(); };
    if (/pago|dinero|saldo/.test(text)) return () => navigate('dinero');
    if (/factur|cfdi|comprobante|descarg/.test(text)) return () => navigate('invoices');
    return () => navigate('avisos');
  };
  (async () => {
    try {
      if (typeof satToken === 'undefined' || !satToken) {
        body.replaceChildren(n('p', 'Abre PacoSAT desde el servidor de tu casa para ver aquí los pasos del cierre con su estado.'));
        return;
      }
      const data = await satApiLectura('reports/checklist?month=' + monthKey).catch(() => null);
      if (!wrap.isConnected) return;
      if (!data?.items?.length) {
        body.replaceChildren(n('p', 'El servidor no devolvió los pasos del cierre. Revisa el estado del sistema en Ajustes.'));
        return;
      }
      const list = n('div', undefined, 'steps');
      let stepNumber = 0;
      for (const item of data.items) {
        stepNumber++;
        const row = n('div', undefined, 'step');
        const head = n('div', undefined, 'step-head');
        head.append(n('span', String(stepNumber), 'step-num'),
          n('strong', item.label),
          statusPill(item.level === 'ok' ? 'ok' : item.level === 'bad' ? 'bad' : 'warn',
            item.level === 'ok' ? 'Hecho' : 'Falta', item.detail || ''));
        row.append(head);
        if (item.detail) row.append(n('p', item.detail, 'step-body'));
        if (item.level !== 'ok') row.append(action('Resolver ahora', goFor(item), undefined, 'arrow'));
        list.append(row);
      }
      const pending = data.items.filter(item => item.level !== 'ok').length;
      body.replaceChildren(
        n('p', pending ? 'Te faltan ' + pending + ' de ' + data.items.length + ' pasos para cerrar ' + data.month + '.' :
          'Los ' + data.items.length + ' pasos del cierre de ' + data.month + ' están en verde.'),
        list);
    } catch { /* el cierre guiado es un extra: nunca rompe la pantalla */ }
  })();
  return wrap;
}
/* «Generar todo» en un gesto (1.25.0, mejora nº 6): paquete de
   la contadora + reporte PDF + ZIP del mes en una sola llamada;
   cada paso dice su resultado y su descarga, y al volver a la
   pantalla los pasos ya generados salen PRE-MARCADOS desde el
   registro del servidor. */
function cierreTodoCard(mesInicial) {
  const card = panel('Generar todo el cierre', 'Un solo gesto y el servidor genera el paquete de la contadora, el reporte del mes en PDF y el ZIP completo. Cada paso dice su resultado; los ya generados quedan marcados.');
  if (typeof satToken === 'undefined' || !satToken) {
    card.append(n('p', 'Abre PacoSAT desde el servidor de tu casa para generar el cierre desde aquí.', 'empty'));
    return card;
  }
  const monthInput = input('month', { value: mesInicial, 'aria-label': 'Mes del cierre' });
  const pasosBox = n('div', undefined, 'traffic-strip');
  const results = n('div');
  const PASOS = [['paquete', 'Paquete de la contadora'], ['reporte', 'Reporte en PDF'], ['zip', 'ZIP del mes']];
  const paintPasos = async () => {
    try {
      const estado = await satApi('reports/close-state?rfc=' + encodeURIComponent(scope || '') + '&month=' + monthInput.value);
      const hechos = new Set((estado?.cierre?.pasos || []).filter(paso => paso.ok).map(paso => paso.id));
      pasosBox.replaceChildren(...PASOS.map(([clave, etiqueta]) =>
        statusPill(hechos.has(clave) ? 'ok' : 'dim',
          etiqueta + (hechos.has(clave) ? ' ✓ generado el ' +
            new Date(estado.cierre.at).toLocaleDateString('es-MX') : ' · pendiente'))));
    } catch { /* sin registro: los pasos se enseñan pendientes */ }
  };
  monthInput.onchange = paintPasos;
  const btn = n('button', 'Generar todo el cierre', 'primary');
  btn.onclick = async () => {
    btn.disabled = true; btn.textContent = 'Generando el cierre…';
    results.replaceChildren(n('p', 'El servidor está generando los tres artefactos…', 'muted'));
    try {
      const data = await satApi('reports/generate-all', { rfc: scope, month: monthInput.value });
      results.replaceChildren();
      for (const paso of data.pasos || []) {
        const row = n('div', undefined, 'cp-row');
        row.append(statusPill(paso.ok ? 'ok' : 'bad', paso.ok ? '✓ Hecho' : 'Falló'),
          n('span', paso.label + (paso.ok ? ' · ' + paso.name : ' — ' + (paso.error || 'sin detalle'))));
        if (paso.ok) {
          const bajar = n('button', 'Descargar', 'soft small');
          bajar.onclick = () => download(new Blob([Uint8Array.from(atob(paso.content), c => c.charCodeAt(0))],
            { type: paso.type }), paso.name);
          row.append(bajar);
        }
        results.append(row);
      }
      toast('Cierre generado: los tres artefactos están listos para descargar.', 'ok');
      soundCue('success');
      paintPasos();
    } catch (error) { results.replaceChildren(n('p', error.message, 'error-text')); }
    finally { btn.disabled = false; btn.textContent = 'Generar todo el cierre'; }
  };
  card.append(fieldWrap('Mes', monthInput), pasosBox, btn, results);
  paintPasos();
  return card;
}
function cierreView() {
  const parts = [tabbar([['cierre', 'Cierre del mes'], ['calendario', 'Calendario'], ['diot', 'DIOT'], ['reportes', 'Reportes']],
    cierreSection, key => { cierreSection = key; render(); })];
  if (cierreSection === 'cierre') parts.push(cierreGuiadoPanel());
  else if (cierreSection === 'calendario') parts.push(...cumplimientoScreen());
  else if (cierreSection === 'diot') parts.push(...diotScreen());
  else parts.push(...salidasScreen());
  return parts;
}
/* Ajustes › Contribuyentes y e.firma: quién está dado de alta y si
   su e.firma está autorizada, con el camino a autorizarla. */
function contribuyentesSection() {
  const wrap = panel('Tus contribuyentes y su e.firma');
  if (!people.length) {
    wrap.append(empty('Sin contribuyentes todavía', 'Agrega tu primer RFC para abrir su expediente.',
      action('Agregar RFC', addPerson, 'primary', 'plus')));
    return [wrap];
  }
  const profiles = typeof satData !== 'undefined' && satData ? (satData.profiles || []) : [];
  wrap.append(grid(['Contribuyente', 'RFC', 'e.firma', 'Acción'], people.map(person => {
    const profile = profiles.find(row => row.rfc === person.id);
    const acts = n('div', undefined, 'actions');
    acts.append(action('Facturas', () => { scope = person.id; $('scope').value = scope; invoicePage = 0; navigate('invoices'); }),
      action('Renombrar', () => renamePerson(person)));
    return [person.name, person.id,
      profile ? (profile.unlocked ? 'Autorizada' : 'Sin autorizar') : 'Sin perfil en el servidor',
      acts];
  })));
  /* D-ARRANQUE (1.29.2): si el archivo de arranque apunta a
     otra e.firma (la vieja) y su activación falló, se DICE aquí
     con la buena a la vista — la tabla de arriba pinta desde la
     base y el almacén, no desde el arranque —. Sin gesto: es un
     aviso, no una tarea. */
  const arranque = typeof satData !== 'undefined' && satData ? satData.arranque : null;
  if (arranque?.fallo && arranque.apuntaVieja) {
    const notaArranque = n('div', undefined, 'cp-row');
    notaArranque.append(statusPill('warn', '⚠ Archivo de arranque'),
      n('span', 'El archivo de arranque apunta a la e.firma vieja de ' + arranque.fallo.rfc +
        (arranque.fallo.vence ? ' (venció el ' + localDate(arranque.fallo.vence) + ')' : '') +
        '; tu e.firma buena es la del almacén, la guardada en el servidor. No tienes que hacer nada: es solo un aviso.'));
    wrap.append(notaArranque);
  }
  wrap.append(n('p', 'La e.firma se autoriza una vez por RFC y PacoSAT la guarda cifrada en tu servidor.'));
  wrap.append(action('Autorizar o gestionar la e.firma', () => showSatDownload(), 'primary', 'lock'));
  const alta = typeof elementalAltaCard === 'function' ? elementalAltaCard() : null;
  const otro = typeof otroRfcAltaCard === 'function' ? otroRfcAltaCard() : null;
  /* El color por RFC se asigna AQUÍ (2.0 · pieza 7). */
  return [wrap, colorPicker200b(), alta, otro].filter(Boolean);
}
/* Alta guiada de cualquier otro RFC (1.30.0): nace en
   «faltan credenciales», visible en la parrilla con su gesto. */
function otroRfcAltaCard() {
  if (typeof satToken === 'undefined' || !satToken) return null;
  if (!(typeof satData !== 'undefined' && satData)) return null;
  const wrap = panel('Alta guiada · Otro RFC');
  const body = n('div', undefined, 'portal');
  const pendientes = (satData.pendingProfiles || [])
    .filter(rfc => rfc !== ELEMENTAL_RFC && !(satData.profiles || []).some(p => p.rfc === rfc));
  if (pendientes.length)
    body.append(n('p', 'Ya constan en «faltan credenciales»: ' + pendientes.join(' · ') +
      '. Quedan aquí, en Ajustes, con su gesto: dar sus credenciales.', 'today-line'));
  body.append(n('p', 'Prepara el alta de otro contribuyente con su RFC: nace en «faltan credenciales», sin inventar ningún dato suyo.', 'today-line'));
  const fila = n('div', undefined, 'cp-row');
  const entrada = n('input', undefined, 'text-input');
  entrada.type = 'text'; entrada.placeholder = 'RFC (ej. TU RFC personal)';
  entrada.maxLength = 13; entrada.autocapitalize = 'characters'; entrada.spellcheck = false;
  const preparar = n('button', 'Preparar su alta', 'primary small');
  preparar.type = 'button';
  preparar.onclick = async () => {
    const rfc = String(entrada.value || '').toUpperCase().replace(/[^A-ZÑ&0-9]/g, '');
    if (!/^[A-ZÑ&]{3,4}[0-9]{6}[A-Z0-9]{3}$/.test(rfc)) { toast('Ese RFC no tiene la forma de un RFC: revísalo.', 'error'); return; }
    preparar.disabled = true; preparar.textContent = 'Preparando…';
    try {
      await satApi('profiles/prepare', { rfc });
      toast('Alta preparada: ' + rfc + ' consta en «faltan credenciales».', 'ok');
      await pollSat().catch(() => {}); render();
    } catch (error) {
      try {
        await pollSat();
        if ((satData.pendingProfiles || []).includes(rfc)) {
          toast('Quedó preparada: consta en «faltan credenciales».', 'ok'); render(); return;
        }
      } catch { /* sin re-lectura: manda el error original */ }
      toast(error.message, 'error');
      preparar.disabled = false; preparar.textContent = 'Preparar su alta';
    }
  };
  fila.append(entrada, preparar);
  body.append(fila);
  wrap.append(body);
  return wrap;
}
function ajustesView() {
  const parts = [tabbar([['general', 'General'], ['contribuyentes', 'Contribuyentes y e.firma'], ['correo', 'Correo'], ['respaldos', 'Respaldos'], ['sinconexion', 'Sin conexión'], ['sistema', 'Estado del sistema'], ['api', 'API'], ['acerca', 'Acerca de']],
    ajustesSection, key => { ajustesSection = key; render(); })];
  if (ajustesSection === 'general') parts.push(...settingsScreen());
  else if (ajustesSection === 'contribuyentes') parts.push(...contribuyentesSection());
  else if (ajustesSection === 'correo') {
    const asNodes = value => Array.isArray(value) ? value : [value];
    if (typeof avisosMailSection === 'function') parts.push(...asNodes(avisosMailSection()));
    if (typeof satMailSection === 'function') parts.push(...asNodes(satMailSection()));
    if (parts.length === 1) {
      const none = panel('Correo');
      none.append(n('p', 'Abre PacoSAT desde el servidor de tu casa para configurar el correo de avisos.'));
      parts.push(none);
    }
    /* Correo e informes automáticos viven AQUÍ (1.32.1, C1):
       salieron de Cierre y reportes. Sus paneles nacen en la
       parte perezosa de salidas: se cargan al entrar y se
       montan en su hueco sin bloquear la pantalla. */
    if (typeof satToken !== 'undefined' && satToken && typeof ensureLazyPart === 'function') {
      const mount = n('div');
      parts.push(mount);
      ensureLazyPart('salidas').then(ok => {
        if (!ok || typeof mailPanel !== 'function' || page !== 'settings' || ajustesSection !== 'correo'
            || !mount.isConnected) return;
        mount.append(mailPanel(), autoReportsPanel());
      });
    }
  }
  else if (ajustesSection === 'respaldos') {
    parts.push(...backupScreen());
    /* La exportación completa vive con los respaldos (1.32.1,
       C1): mismo gesto de sacar los datos fuera, dos formas. */
    if (typeof satToken !== 'undefined' && satToken && typeof ensureLazyPart === 'function') {
      const mount = n('div');
      parts.push(mount);
      ensureLazyPart('salidas').then(ok => {
        if (!ok || typeof salidasExportPanel !== 'function' || page !== 'settings' || ajustesSection !== 'respaldos'
            || !mount.isConnected) return;
        mount.append(salidasExportPanel());
        if (typeof restaurar200gPanel === 'function') mount.append(restaurar200gPanel());
      });
    }
  }
  else if (ajustesSection === 'sinconexion') parts.push(...offlineScreen());
  else if (ajustesSection === 'sistema') { parts.push(...operationsScreen()); const loginCard = adminLoginCard(); if (loginCard) parts.push(loginCard); }
  else if (ajustesSection === 'api') {
    parts.push(...apiPanelSection1320());
    /* Tanda 7A: webhooks salientes y calendario fiscal vivo,
       montados diferidos como la exportación de Respaldos. */
    if (typeof satToken !== 'undefined' && satToken && typeof ensureLazyPart === 'function') {
      const mount = n('div');
      parts.push(mount);
      ensureLazyPart('salidas').then(ok => {
        if (!ok || page !== 'settings' || ajustesSection !== 'api' || !mount.isConnected) return;
        if (typeof webhooks200gPanel === 'function') mount.append(webhooks200gPanel());
        if (typeof ics200gPanel === 'function') mount.append(ics200gPanel());
      });
    }
  }
  else parts.push(...capacidadesScreen());
  return parts;
}

