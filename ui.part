  enlaceAplicado200c = hash;
  const [vista, query] = hash.slice(2).split('?');
  const params = new URLSearchParams(query || '');
  const rfc = params.get('rfc') || '';
  if (rfc && people.some(person => person.id === rfc)) scope = rfc;
  const periodo = params.get('periodo') || '';
  if (/^\d{4}-\d{2}$/.test(periodo)) month = periodo;
  const vistas200c = { facturas: 'invoices', avisos: 'avisos', documentos: 'docs',
    hoy: 'home', cierre: 'salidas', buzon: 'tributario', declaraciones: 'declaraciones' };
  const destino = params.get('destino') || '';
  const uuid = params.get('uuid') || '';
  if (uuid) term = uuid;
  navigate(vistas200c[vista] || 'home');
  if (destino) irDestino200b(vistas200c[vista] || 'home', destino);
  if (uuid) setTimeout(() => {
    const row = invoices.find(item => String(item.id).toUpperCase() === uuid.toUpperCase());
    if (row) invoiceDetail(row);
  }, 700);
}
function aplicarDestino200b() {
  if (!destinoPendiente200b) return;
  const id = destinoPendiente200b;
  destinoPendiente200b = '';
  const buscar = () => document.querySelector('[data-destino200b="' + id + '"]');
  let el = buscar();
  if (!el) { setTimeout(() => { el = buscar(); if (el) realzar200b(el); }, 350); return; }
  realzar200b(el);
}
function realzar200b(el) {
  try { el.scrollIntoView({ block: 'center', behavior: 'smooth' }); } catch { /* sin scroll: el realce basta */ }
  el.classList.add('destino-realce200b');
