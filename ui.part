let invoiceRapido240 = '';
let submit, importing = false, ready = false;
const number = new Intl.NumberFormat('es-MX');
/* UN formato humano de fecha en las listas (1.29.0, peldaño 1):
   «12 nov, 12:00» — el mismo en Hoy, Buzón, Registro y
   Declaraciones, sin mezclar ISO ni fechas largas por pantalla. */
const MESES_CORTOS_1290 = ['ene', 'feb', 'mar', 'abr', 'may', 'jun', 'jul', 'ago', 'sep', 'oct', 'nov', 'dic'];
function fmtFechaHora(ms) {
  if (!ms) return '—';
  const d = new Date(Number(ms));
  if (Number.isNaN(d.getTime())) return '—';
  return d.getDate() + ' ' + MESES_CORTOS_1290[d.getMonth()] + ', ' +
    String(d.getHours()).padStart(2, '0') + ':' + String(d.getMinutes()).padStart(2, '0');
}
function fmtFechaCorta(ms) {
  if (!ms) return '—';
  const d = new Date(Number(ms));
  if (Number.isNaN(d.getTime())) return '—';
  return d.getDate() + ' ' + MESES_CORTOS_1290[d.getMonth()] + ' ' + d.getFullYear();
}
const scopes = () => new Map(people.map(person => [person.id, person.name]));
const matches = invoice => {
  const known = scopes();
  return (scope ? [scope] : [...known.keys()]).some(id => id === invoice.from.rfc || id === invoice.to.rfc);
};
const roles = row => {
  const known = scopes();
  return { issued: scope ? row.from.rfc === scope : known.has(row.from.rfc), received: scope ? row.to.rfc === scope : known.has(row.to.rfc) };
};
function dateLabel(date) {
  if (date.length < 10) return date;
  return date.slice(8, 10) + '/' + date.slice(5, 7) + '/' + date.slice(0, 4);
}
/* 'AAAA-MM-DD HH:MM:SS' → 'dd/mm/aaaa hh:mm': un solo formato humano
   en todo lo visible (UX-25). */
function stampLabel(stamp) {
  if (!stamp || stamp.length < 16) return stamp || '';
  return stamp.slice(8, 10) + '/' + stamp.slice(5, 7) + '/' + stamp.slice(0, 4) + ' ' + stamp.slice(11, 16);
}
function amount(row) {
  const [integer, decimals] = row.total.split('.');
  /* La moneda cruda «XXX» no se enseña (2.9.0 · Bloque C):
     los complementos de pago traen MonedaP «XXX» («sin
     moneda» en el catálogo del SAT) y salía «0.00 XXX». MXN
     no se nombra (es la moneda de la casa); otra moneda real
     se nombra; XXX se omite. */
  const moneda = row.currency && row.currency !== 'MXN' && row.currency !== 'XXX' ? ' ' + row.currency : '';
  return number.format(BigInt(integer)) + (decimals ? '.' + decimals : '.00') + moneda;
}
/* Clave «AAAA-MM» del mes anterior: el valor por defecto de los
   selectores de mes de Cumplimiento y de Bancos. Se llamaba desde la
   1.6.18 y nunca se definió (hotfix 1.7.3). */
function previousMonthKey() {
  const now = new Date();
  const previous = new Date(now.getFullYear(), now.getMonth() - 1, 1);
  return previous.getFullYear() + '-' + String(previous.getMonth() + 1).padStart(2, '0');
}
/* Un importe suelto, ya en texto («1234.56»), con el mismo formato
   que amount() pero sin fila ni moneda: lo que piden Listas (la
   exposición de cada contraparte) y el Centro de salidas. Se llamaba
   desde la 1.6.13 y nunca se definió (hotfix 1.7.3). */
function money(value) {
  const [integer, decimals] = String(value ?? '0').split('.');
  return number.format(BigInt(integer || '0')) + (decimals ? '.' + decimals : '.00');
}
// Tema y sonidos de la interfaz (1.6.0): persistentes en este navegador.
const prefGet = key => { try { return localStorage.getItem(key); } catch { return null; } };
const prefSet = (key, value) => { try { localStorage.setItem(key, value); } catch { /* Sin almacenamiento, la preferencia dura la sesión. */ } };
const themeIsDark = () => document.documentElement.dataset.theme === 'dark' ||
  (!document.documentElement.dataset.theme && typeof matchMedia !== 'undefined' && matchMedia('(prefers-color-scheme: dark)').matches);
function applyTheme() {
  const saved = prefGet('pacosat-theme');
  if (saved === 'dark' || saved === 'light') document.documentElement.dataset.theme = saved;
  else delete document.documentElement.dataset.theme;
  const button = $('theme-toggle');
  if (button) { button.replaceChildren(icon(themeIsDark() ? 'sun' : 'moon')); button.setAttribute('aria-pressed', String(themeIsDark())); }
  /* La pestaña del sistema sigue al tema (1.26.0): antes el meta
     quedaba fijo en el azul marino claro aun en modo oscuro. */
  const metaTheme = document.querySelector('meta[name="theme-color"]');
  if (metaTheme) metaTheme.setAttribute('content', themeIsDark() ? '#060d18' : '#0e2a47');
}
let soundOn = prefGet('pacosat-sound') !== 'off';
let audioCtx = null;
function ensureAudio() {
  if (!soundOn) return null;
  try {
    audioCtx = audioCtx || new (window.AudioContext || window.webkitAudioContext)();
    if (audioCtx.state === 'suspended') void audioCtx.resume();
    return audioCtx;
  } catch { return null; }
}
function tone(frequency, start, duration, type = 'sine', gain = 0.055) {
  const ctx = ensureAudio();
  if (!ctx) return;
  const osc = ctx.createOscillator(), amp = ctx.createGain();
  const at = ctx.currentTime + start;
  osc.type = type; osc.frequency.value = frequency;
  amp.gain.setValueAtTime(0, at);
  amp.gain.linearRampToValueAtTime(gain, at + 0.012);
  amp.gain.exponentialRampToValueAtTime(0.0001, at + duration);
  osc.connect(amp); amp.connect(ctx.destination);
  osc.start(at); osc.stop(at + duration + 0.05);
}
/* Sonidos por evento (1.6.11): además del interruptor general de la
   cabecera, cada tipo de aviso se puede silenciar por separado en
   Ajustes. La preferencia vive en este navegador. */
const soundEventOn = kind => {
  try { return JSON.parse(prefGet('pacosat-sound-events') || '{}')[kind] !== false; }
  catch { return true; }
};
function soundCue(kind) {
  if (!soundOn || !soundEventOn(kind)) return;
  if (kind === 'success') { tone(659, 0, 0.13); tone(880, 0.1, 0.2); }
  else if (kind === 'error') tone(196, 0, 0.22, 'triangle', 0.075);
  else if (kind === 'alert') { tone(880, 0, 0.12); tone(880, 0.18, 0.12); }
  else tone(740, 0, 0.11);
}
function initPrefs() {
  applyTheme();
  const soundButton = $('sound-toggle');
  if (soundButton) {
    const paint = () => { soundButton.replaceChildren(icon(soundOn ? 'volume' : 'mute')); soundButton.setAttribute('aria-pressed', String(soundOn)); };
    paint();
    soundButton.onclick = () => { soundOn = !soundOn; prefSet('pacosat-sound', soundOn ? 'on' : 'off'); paint(); if (soundOn) soundCue('notice'); };
  }
  const themeButton = $('theme-toggle');
  if (themeButton) themeButton.onclick = () => { prefSet('pacosat-theme', themeIsDark() ? 'light' : 'dark'); applyTheme(); };
  /* Ayuda en la barra superior (2.0 · tanda 4, 20#20): el botón
     de ayuda abre el cajón de la pantalla actual; Preguntas sigue
     a un toque desde dentro del cajón. */
  const askButton = $('ask-button');
  if (askButton) askButton.onclick = () => ayudaAbrir200d();
  /* «Más» del móvil: abre la columna completa como hoja. */
  const moreButton = $('more-button');
  if (moreButton) moreButton.onclick = () => {
    const frame = document.querySelector('.frame');
    if (frame) frame.classList.toggle('sheet-open');
  };
  const unlock = () => { if (soundOn) ensureAudio(); };
  window.addEventListener('pointerdown', unlock, { once: true });
  window.addEventListener('keydown', unlock, { once: true });
}
/* Cajón de ayuda por pantalla (2.0 · tanda 4, 20#20 primera
   mitad): qué es, para qué sirve y qué hacer en la pantalla
   actual, en tres bloques cortos y en llano. Los textos viven en
   la parte diferida de Salud (AYUDA_TEXTOS200D): el cajón la
   carga si hace falta y, si no llega, enseña la ficha de la
   pantalla y el camino a Preguntas — nunca un hueco muerto. */
/* Ayuda unificada (2.8.0 · diseño 26): UNA puerta — la
   pantalla Preguntas. El «?» ya no abre un cajón propio:
   guarda el contexto de la pantalla actual (su texto de
   ayuda, resuelto aquí con la sede servida) y abre Preguntas,
   que lo pinta PRIMERO y el preguntar debajo. Los atajos son
   una sección de esa misma pantalla. */
let ayudaContexto280 = null;
function ayudaTextoPantalla200d() {
  /* Bancos es subvista de Dinero (2.0.1 · nº 18): su texto
     propio gana al de Dinero cuando la pestaña activa es la
     de Bancos. */
  let claveAyuda201 = page === 'dinero' && typeof dineroTab !== 'undefined' && dineroTab === 'bancos' ? 'bancos' : page;
  /* Alias de clave (2.9.0 · Bloque C): la pantalla de descarga
     se llama «descargar» y su texto vive en «sat»; sin alias,
     la ayuda caía a un contexto ajeno o vacío. */
  if (claveAyuda201 === 'descargar') claveAyuda201 = 'descargar';
  let t = (typeof AYUDA_TEXTOS200D !== 'undefined' && AYUDA_TEXTOS200D[claveAyuda201]) || null;
  if (!t && claveAyuda201 === 'descargar' && typeof AYUDA_TEXTOS200D !== 'undefined') t = AYUDA_TEXTOS200D.sat || null;
  /* Paseo en casa (2.8.0): la ayuda de Buzón y Declaraciones
     se dice según la sede que el estado sirve — en sede NAS
     el paseo se hace desde casa y la ayuda no manda a la PC;
     en sede remota, el texto de siempre, intacto. */
  if (t && typeof satData !== 'undefined' && satData?.paseo === 'nas') {
    if (claveAyuda201 === 'tributario')
      t = { ...t, h: 'Pulsa «Consultar ahora» para listar de nuevo: el paseo se hace desde casa, desde tu NAS, con tu e.firma guardada. Abrir una notificación es gesto tuyo, en el portal del SAT.' };
    else if (claveAyuda201 === 'declaraciones')
      t = { ...t, h: 'Toca un mes para ver su detalle y «Descargar declaraciones del SAT» para recuperar las que falten: el paseo se hace desde casa, desde tu NAS, con tu e.firma guardada.' };
  }
  return { clave: claveAyuda201, nombre: screens[claveAyuda201]?.[0] || screens[page]?.[0] || 'Esta pantalla', t };
}
function ayudaAbrir200d() {
  /* El contexto se captura AL PULSAR (2.9.0 · Bloque C): la
     clave y el nombre de la pantalla de AHORA, no los de
     cuando la parte perezosa termine de cargar — antes, si
     la carga tardaba y Paco se movía, la ayuda enseñaba el
     contexto de OTRA pantalla («Ayuda · Facturas» dentro de
     Preguntas). El texto se rellena al llegar la parte. */
  const capturado = ayudaTextoPantalla200d();
  const abrir = () => {
    if (!capturado.t && typeof AYUDA_TEXTOS200D !== 'undefined')
      capturado.t = AYUDA_TEXTOS200D[capturado.clave] ||
        (capturado.clave === 'descargar' ? AYUDA_TEXTOS200D.sat : null) || null;
    ayudaContexto280 = capturado;
    navigate('preguntas');
  };
  if (typeof AYUDA_TEXTOS200D !== 'undefined' || typeof ensureLazyPart !== 'function') abrir();
  else ensureLazyPart('salud').then(abrir);
}
initPrefs();
let newsCount = 0;
function computeNews() {
  try {
    const last = Number(localStorage.getItem('pacosat-last-visit') || 0);
    newsCount = last ? activity.filter(row => Date.parse(row.date) > last).length : 0;
    localStorage.setItem('pacosat-last-visit', String(Date.now()));
  } catch { newsCount = 0; }
  const badge = $('news-badge');
  if (badge) { badge.hidden = !newsCount; badge.textContent = newsCount ? number.format(newsCount) : ''; }
}
function totalCents(row) {
  const [integer, decimals = ''] = String(row.total).split('.');
  const padded = (decimals + '000').slice(0, 3);
  return BigInt(integer) * 100n + BigInt(padded.slice(0, 2)) + (padded[2] >= '5' ? 1n : 0n);
}
const centsPlain = cents => (cents / 100n).toString() + '.' + String(cents % 100n).padStart(2, '0');
function centsLabel(cents) {
  return number.format(cents / 100n) + '.' + String(cents % 100n).padStart(2, '0');
}
/* Nombre legible de una divisa verdadera (pieza 3): se nombra
   por su código, nunca como «otra moneda» genérica. */
const CURRENCY_NAMES = { USD: 'dólares USD', EUR: 'euros EUR', GBP: 'libras GBP', CAD: 'dólares CAD' };
const foreignNote = (foreign, side) => Object.entries(foreign || {})
  .filter(([, slot]) => slot[side] > 0)
  .map(([code, slot]) => slot[side] + ' en ' + (CURRENCY_NAMES[code] || code) + ', sin sumar a los pesos').join(' · ');
const rowCancelled = row => fiscalResults.get(row.id)?.sat?.state === 'Cancelado';
function monthlyTotals() {
  const groups = new Map();
  for (const person of people) {
    if (scope && person.id !== scope) continue;
    const months = new Map();
    for (const row of invoices) {
      const received = row.to.rfc === person.id, issued = row.from.rfc === person.id;
      if (!received && !issued) continue;
      const key = row.date.slice(0, 7);
      if (!months.has(key)) months.set(key, { received: 0, receivedCents: 0n, issued: 0, issuedCents: 0n,
        cancelled: 0, rep: 0, nomina: 0, foreign: {} });
      const group = months.get(key);
      /* N2 + pieza 3 (1.22.0): EL criterio del servidor, también
         aquí — las CANCELADAS no suman (van en su propia línea),
         los complementos de pago (clase P: llevan Moneda «XXX»
         por norma del CFDI y total 0) NO son «otra moneda» ni
         facturas que contar como emitidas/recibidas, la nómina
         (clase N) va aparte, y una divisa VERDADERA se agrupa
         por su código y jamás se suma a los pesos. Sin divisa
         verdadera, no hay nota alguna. */
      if (rowCancelled(row)) { group.cancelled++; continue; }
      if (row.kind === 'P') { group.rep++; continue; }
      if (row.kind === 'N') { group.nomina++; continue; }
      const currency = (row.currency || 'MXN').toUpperCase();
      if (currency !== 'MXN') {
        const slot = group.foreign[currency] || (group.foreign[currency] = { received: 0, issued: 0 });
        if (received) slot.received++;
        if (issued) slot.issued++;
        continue;
      }
      if (received) { group.received++; group.receivedCents += totalCents(row); }
      if (issued) { group.issued++; group.issuedCents += totalCents(row); }
    }
    if (months.size) groups.set(person.id, { name: person.name, months: [...months.entries()].sort((a, b) => b[0].localeCompare(a[0])) });
  }
  return groups;
}
/* Totales por RFC y mes (1.29.0, adenda): ordenados por AÑOS y
   navegables — cada total se puede verificar hasta el documento.
   Un bloque por año (con su total del año; el año en curso
   desplegado, los anteriores plegados), los meses como filas
   clicables y, al tocar un mes, su detalle: los CFDI que
   componen los totales, recibidos y emitidos por separado, con
   folio, contraparte, importe y estado, y la suma del detalle
   igualando el total enseñado. Las notas del mes (complementos
   de pago que no son facturas, nómina aparte, canceladas fuera
   de totales) viven DENTRO del detalle, no en la lista. Los
   botones de cabecera se conservan; dentro del detalle,
   «Reporte mensual» y «Paquete mensual» actúan sobre ESE mes. */
let totalesDetalle = null;
const MESES_TOT = ['enero', 'febrero', 'marzo', 'abril', 'mayo', 'junio', 'julio', 'agosto', 'septiembre', 'octubre', 'noviembre', 'diciembre'];
/* V11 · Rejilla anual de Totales (1.31.0): en Totales no había
   ninguna rejilla .hm (la única vive en Cobertura, por días) —
   esta es por MESES: 12 celdas por año, con la intensidad por
   importe de las clases .hm-l0/.hm-l1/.hm-l2 que polish ya
   define, y clic en los meses con datos hasta el mismo detalle
   al que llevan las filas del año. Un mes sin comprobantes se
   pinta vacío y no promete ningún detalle. */
function totalesRejillaAnual1310(rfc, anio, meses) {
  const NS = 'http://www.w3.org/2000/svg';
  const svg = document.createElementNS(NS, 'svg');
  const el = (tag, attrs, text) => {
    const node = document.createElementNS(NS, tag);
    for (const [name, value] of Object.entries(attrs || {})) node.setAttribute(name, value);
    if (text) node.textContent = text;
    return node;
  };
  const porMes = new Map(meses);
  let max = 0n;
  for (const [, g] of meses) { const total = g.receivedCents + g.issuedCents; if (total > max) max = total; }
  svg.setAttribute('viewBox', '0 0 364 30');
  svg.setAttribute('class', 'hm');
  svg.setAttribute('role', 'img');
  svg.setAttribute('aria-label', 'Rejilla del año ' + anio + ': un cuadro por mes; toca un mes con datos para ver su detalle');
  for (let m = 0; m < 12; m++) {
    const monthKey = anio + '-' + String(m + 1).padStart(2, '0');
    const g = porMes.get(monthKey);
    const total = g ? g.receivedCents + g.issuedCents : 0n;
    const nivel = !total || max === 0n ? 0 : (total * 2n <= max ? 1 : 2);
    const rect = el('rect', { x: m * 30 + 2, y: 2, width: 26, height: 26, rx: 3, class: 'hm-l' + nivel });
    rect.append(el('title', {}, MESES_TOT[m] + ' ' + anio + (g
      ? ' · Recibidos $' + centsLabel(g.receivedCents) + ' — Emitidos $' + centsLabel(g.issuedCents) + ' · toca para ver los CFDI'
      : ' · Sin comprobantes')));
    if (g) {
      rect.style.cursor = 'pointer';
      rect.addEventListener('click', () => { totalesDetalle = { rfc, monthKey }; render(); });
    }
    svg.append(rect);
  }
  const scroll = n('div', undefined, 'hm-scroll');
  scroll.append(svg);
  return scroll;
}
function totalsPanel() {
  const totals = monthlyTotals();
  const wrap = panel('Totales por RFC y mes');
  if (!totals.size) {
    wrap.append(empty('Sin comprobantes todavía', 'Los totales por contribuyente y mes aparecerán al importar o sincronizar CFDI.'));
    return wrap;
  }
  if (totalesDetalle && totals.has(totalesDetalle.rfc)) {
    const group = totals.get(totalesDetalle.rfc);
    const found = group.months.find(([key]) => key === totalesDetalle.monthKey);
    if (found) { totalesDetallePintar(wrap, totalesDetalle.rfc, group, found[0], found[1]); return wrap; }
    totalesDetalle = null;
  }
  wrap.querySelector('.panel-head').append(action('Exportar totales CSV', exportTotalsCsv, 'metric-link', 'down'),
    action('Reporte mensual', () => reportDialog(), 'metric-link', 'print'),
    action('Paquete mensual', () => monthlyPackageDialog(), 'metric-link', 'box'));
  const anioEnCurso = String(new Date().getFullYear());
  for (const [rfc, group] of totals) {
    wrap.append(n('h3', group.name + ' · ' + rfc, 'tot-rfc'));
    const porAnio = new Map();
    for (const [monthKey, g] of group.months) {
      const anio = monthKey.slice(0, 4);
      if (!porAnio.has(anio)) porAnio.set(anio, []);
      porAnio.get(anio).push([monthKey, g]);
    }
    for (const [anio, meses] of [...porAnio.entries()].sort((a, b) => b[0].localeCompare(a[0]))) {
      const tot = meses.reduce((acc, [, g]) => ({ received: acc.received + g.received,
        receivedCents: acc.receivedCents + g.receivedCents, issued: acc.issued + g.issued,
        issuedCents: acc.issuedCents + g.issuedCents }),
        { received: 0, receivedCents: 0n, issued: 0, issuedCents: 0n });
      const bloque = n('details', undefined, 'tot-anio');
      if (anio === anioEnCurso) bloque.open = true;
      const sum = n('summary', undefined, 'tot-anio-sum');
      sum.append(n('strong', anio),
        n('span', 'Recibidos ' + number.format(tot.received) + ' · $' + centsLabel(tot.receivedCents) +
          ' — Emitidos ' + number.format(tot.issued) + ' · $' + centsLabel(tot.issuedCents), 'muted'));
      bloque.append(sum);
      /* V11: la rejilla del año va tras su resumen y antes de
         las filas de meses — el mismo destino por dos caminos. */
      bloque.append(totalesRejillaAnual1310(rfc, anio, meses));
      for (const [monthKey, g] of meses) {
        const fila = n('button', undefined, 'tot-mes');
        fila.type = 'button';
        fila.append(n('strong', MESES_TOT[Number(monthKey.slice(5, 7)) - 1] + ' ' + anio),
          n('span', 'Recibidos ' + number.format(g.received) + ' · $' + centsLabel(g.receivedCents) +
            ' — Emitidos ' + number.format(g.issued) + ' · $' + centsLabel(g.issuedCents)),
          n('span', 'Ver los CFDI →', 'tot-mes-go'));
        fila.onclick = () => { totalesDetalle = { rfc, monthKey }; render(); };
        bloque.append(fila);
      }
      wrap.append(bloque);
    }
  }
  /* Comparativo mes contra mes (2.0.1 · nº 11): el cálculo
     del servidor (totales200h con a/b), el mismo de los
     totales de arriba — aquí no se suma nada nuevo: se
     enseña su texto y sus dos fotos tal como las devuelve. */
  const rfcComp201 = scope && totals.has(scope) ? scope : [...totals.keys()][0];
  if (rfcComp201 && typeof satToken !== 'undefined' && satToken) wrap.append(totalesComparativo201(rfcComp201));
  wrap.append(n('p', 'Importes en MXN sumados al centavo. Toca un mes para bajar hasta los CFDI que componen sus totales: cada número, con su respaldo.'));
  return wrap;
}
function totalesComparativo201(rfc) {
  const box = n('div', undefined, 'tot-comp201');
  box.append(n('h3', 'Comparar dos meses · ' + rfc));
  const mesA = input('month', { value: previousMonthKey() });
  const mesB = input('month', { value: new Date().toISOString().slice(0, 7) });
  const out = n('div');
  const comparar = n('button', 'Comparar', 'soft');
  comparar.type = 'button';
  comparar.onclick = async () => {
    if (!mesA.value || !mesB.value) { toast('Elige los dos meses a comparar.', 'error'); return; }
    out.replaceChildren(n('p', 'Comparando…', 'muted'));
    try {
      const d = await satApi('totales200h?rfc=' + encodeURIComponent(rfc) +
        '&a=' + encodeURIComponent(mesA.value) + '&b=' + encodeURIComponent(mesB.value));
      out.replaceChildren(
        n('p', d.texto || ''),
        n('p', mesA.value + ': ' + number.format(d.a?.comprobantes || 0) + ' comprobante(s) · $' + (d.a?.importe || '0.00') +
          ' — ' + mesB.value + ': ' + number.format(d.b?.comprobantes || 0) + ' comprobante(s) · $' + (d.b?.importe || '0.00'), 'muted'));
    } catch (error) { out.replaceChildren(n('p', 'No se pudo comparar: ' + error.message, 'error-text')); }
  };
  const fila = n('div', undefined, 'actions');
  fila.append(fieldWrap('Mes A', mesA), fieldWrap('Mes B', mesB), comparar);
  box.append(fila, out);
  return box;
}
function totalesDetallePintar(wrap, rfc, group, monthKey, g) {
  const volver = n('button', '← Volver a los totales', 'soft small');
  volver.type = 'button';
  volver.onclick = () => { totalesDetalle = null; render(); };
  const head = n('div', undefined, 'tot-det-head');
  head.append(volver, n('strong', MESES_TOT[Number(monthKey.slice(5, 7)) - 1] + ' ' + monthKey.slice(0, 4) +
    ' · ' + group.name + ' (' + rfc + ')'));
  const acts = n('div', undefined, 'actions');
  acts.append(action('Reporte mensual de este mes', () => reportDialog(monthKey), 'soft small', 'print'),
    action('Paquete mensual de este mes', () => monthlyPackageDialog(rfc, monthKey), 'soft small', 'box'));
  wrap.append(head, acts);
  /* Las notas del mes, dentro de su detalle (1.29.0): lo que NO
     suma y por qué — complementos de pago, nómina, canceladas y
     divisas verdaderas contadas aparte. */
  const notas = [foreignNote(g.foreign, 'received'), foreignNote(g.foreign, 'issued'),
    g.rep ? g.rep + ' complemento(s) de pago (no son facturas: no suman)' : '',
    g.cancelled ? g.cancelled + ' cancelada(s), fuera de los totales' : '',
    g.nomina ? g.nomina + ' de nómina, aparte' : ''].filter(Boolean);
  if (notas.length) wrap.append(n('p', notas.join(' · ') + '.', 'muted'));
  /* El detalle con el MISMO criterio de monthlyTotals: sin
     canceladas, sin complementos (P) ni nómina (N), y solo MXN
     en los pesos — así la suma del detalle IGUALA el total. */
  const filas = invoices.filter(row => row.date.startsWith(monthKey) && !rowCancelled(row) &&
    row.kind !== 'P' && row.kind !== 'N' && (row.currency || 'MXN').toUpperCase() === 'MXN');
  /* F4 · Conciliación del mes (1.31.0): la diferencia, nombrada
     con sus documentos — de lo emitido (ingreso) del mes, cuánto
     consta cobrado y cuánto sigue sin cobro constatado; y lo
     mismo de lo recibido, cuánto consta pagado y cuánto sigue
     sin pago constatado. La cifra sale del cálculo que la casa
     ya usa para los saldos (balanceOf sobre paidByMap: PUE y
     complementos de pago, más las marcas a mano de esta sesión
     en visorMarcados/dineroMarcados): ninguna suma nueva. */
  if (typeof paidByMap === 'function' && typeof balanceOf === 'function') {
    const paidByConcilia = paidByMap();
    const concilia1310 = lista => {
      let total = 0n, cubierto = 0n;
      for (const row of lista) {
        if (row.kind !== 'I') continue;
        const bal = balanceOf(row, paidByConcilia);
        total += bal.total;
        let pagado = bal.paid;
        const marcada = (typeof visorMarcados !== 'undefined' && visorMarcados.has(row.id)) ||
          (typeof dineroMarcados !== 'undefined' && dineroMarcados.has(row.id));
        if (marcada && pagado < bal.total) pagado = bal.total;
        cubierto += pagado > bal.total ? bal.total : pagado;
      }
      return { total, cubierto, resto: total - cubierto };
    };
    const emiConcilia = concilia1310(filas.filter(row => row.from.rfc === rfc));
    if (emiConcilia.total > 0n) wrap.append(n('p', 'Conciliación de lo emitido: $' + centsLabel(emiConcilia.cubierto) +
      ' constan cobrados (complementos de pago, PUE y pagos marcados a mano) y $' + centsLabel(emiConcilia.resto) +
      ' sigue sin cobro constatado.', 'tot-concilia'));
    const recConcilia = concilia1310(filas.filter(row => row.to.rfc === rfc));
    if (recConcilia.total > 0n) wrap.append(n('p', 'Conciliación de lo recibido: $' + centsLabel(recConcilia.cubierto) +
      ' constan pagados (complementos de pago, PUE y pagos marcados a mano) y $' + centsLabel(recConcilia.resto) +
      ' sigue sin pago constatado.', 'tot-concilia'));
  }
  const folioDe = row => row.fiscal ? ((row.fiscal.serie ? row.fiscal.serie + '-' : '') + (row.fiscal.folio || '')) || '—' : '—';
  const estadoDe = row => { const st = invoiceStateOf(row); return st === 'none' ? 'Sin consultar' : st === 'efos' ? '69-B' : st; };
  const seccion = (titulo, lista, totalCentsMes, totalNum) => {
    const box = n('div', undefined, 'tot-det-sec');
    box.append(n('h3', titulo + ' · ' + number.format(lista.length)));
    if (!lista.length) box.append(n('p', 'Sin CFDI en esta lista.', 'muted'));
    else box.append(grid(['Folio', 'Contraparte', 'Fecha', 'Importe', 'Estado'], lista.map(row => [
      cell(folioDe(row), row.id), cell(titulo === 'Recibidos' ? (row.from.name || row.from.rfc) : (row.to.name || row.to.rfc),
        titulo === 'Recibidos' ? row.from.rfc : row.to.rfc), dateLabel(row.date),
      cell('$' + centsLabel(totalCents(row))), cell(estadoDe(row)),
      action('Ver', () => invoiceDetail(row), 'metric-link', 'arrow')])));
    const suma = lista.reduce((acc, row) => acc + totalCents(row), 0n);
    box.append(n('p', 'Suma del detalle: $' + centsLabel(suma) + ' — ' +
      (suma === totalCentsMes && lista.length === totalNum
        ? 'iguala el total del mes'
        : 'el total del mes es $' + centsLabel(totalCentsMes) + ' (' + number.format(totalNum) + '): si no cuadran, falta cargar CFDI en esta copia local.'), 'tot-suma'));
    return box;
  };
  wrap.append(seccion('Recibidos', filas.filter(row => row.to.rfc === rfc), g.receivedCents, g.received),
    seccion('Emitidos', filas.filter(row => row.from.rfc === rfc), g.issuedCents, g.issued));
}
function reportDialog(mesPreseleccionado = '') {
  const months = [...new Set([...monthlyTotals().values()].flatMap(group => group.months.map(([key]) => key)))].sort().reverse();
  check(months.length, 'Todavía no hay totales para reportar.');
  const monthSel = select(months.map(key => [key, key.slice(5, 7) + '/' + key.slice(0, 4)]),
    months.includes(mesPreseleccionado) ? mesPreseleccionado : months[0], 'Mes del reporte');
  dialog('Reporte mensual por RFC', [n('p', 'Vista para imprimir o guardar en PDF del mes elegido. Respeta el contribuyente seleccionado en el selector principal; sin selección, incluye a todos.'),
    field('Mes', monthSel)], () => printMonthlyReport(monthSel.value), 'Generar e imprimir');
}
function printMonthlyReport(key) {
  const section = $('print-report');
  section.replaceChildren();
  const head = n('div', undefined, 'report-head');
  if (appSettings.logoData) {
    const logo = n('img', undefined, 'report-logo');
    logo.src = appSettings.logoData;
    logo.alt = '';
    head.append(logo);
  }
  head.append(n('div', (appSettings.installName || 'PacoSAT') + ' · REPORTE MENSUAL', 'hero-kicker'), n('h1', 'Reporte mensual ' + key.slice(5, 7) + '/' + key.slice(0, 4)),
    n('p', (scope ? (scopes().get(scope) || scope) + ' · ' + scope : 'Todos los contribuyentes') + ' · Generado el ' + localDateTime(Date.now()), 'report-meta'));
  section.append(head);
  const rows = [];
  for (const [rfc, group] of monthlyTotals()) {
    const found = group.months.find(([monthKey]) => monthKey === key);
    if (!found) continue;
    const g = found[1];
    rows.push([group.name + ' (' + rfc + ')', number.format(g.received), '$' + centsLabel(g.receivedCents),
      number.format(g.issued), '$' + centsLabel(g.issuedCents)]);
  }
  const tableWrap = n('div');
  tableWrap.append(grid(['Contribuyente', 'Recibidos', 'Importe recibidos MXN', 'Emitidos', 'Importe emitidos MXN'],
    rows.length ? rows : [['Sin comprobantes en el mes', '', '', '', '']]));
  section.append(tableWrap);
  /* Detalle comprobante a comprobante del mes (UX-23): el reporte para
     la contadora lista cada CFDI, no solo los totales. */
  const detail = invoices.filter(row => row.date.startsWith(key) && matches(row));
  if (detail.length) {
    section.append(n('h3', 'Comprobantes del mes'));
    const detailWrap = n('div');
    detailWrap.append(grid(['Fecha', 'UUID', 'Emisor → receptor', 'Tipo', 'Total'],
      detail.map(row => [dateLabel(row.date), row.id, (row.from.name || row.from.rfc) + ' → ' + (row.to.name || row.to.rfc),
        KINDS[row.kind], amount(row)])));
    section.append(detailWrap);
  }
  let checked = 0, cancelled = 0, efosHits = 0;
  for (const row of invoices) {
    if (!row.date.startsWith(key) || !matches(row)) continue;
    const item = fiscalResults.get(row.id);
    if (item?.sat) { checked++; if (item.sat.state === 'Cancelado') cancelled++; }
    if (item?.efos?.length) efosHits++;
  }
  section.append(n('p', 'Vigilancia según la última consulta disponible en esta sesión: ' + checked + ' CFDI del mes consultados al SAT, ' +
    cancelled + ' cancelados y ' + efosHits + ' con coincidencia 69-B. Si la vigilancia no ha corrido, estos conteos quedan parciales.', 'report-note'));
  section.append(n('p', 'Importes en MXN sumados al centavo desde el total de cada CFDI (sin canceladas); las divisas verdaderas se cuentan por su código y no se suman a los pesos, y los complementos de pago (Moneda «XXX» por norma, total 0) no son facturas en otra moneda. Documento de trabajo generado por PacoSAT, no una declaración.', 'report-note'));
  section.append(reportFoot(scope));
  setTimeout(() => window.print(), 80);
}
/* Pie de documento impreso (1.26.0, Ronda Visual): todo informe
   que sale en papel cierra con quién lo emite, para qué RFC y
   cuándo — la diferencia entre una captura y un documento; la
   paginación la pone la regla @page de la hoja. */
function reportFoot(rfc) {
  const foot = n('div', undefined, 'report-foot');
  foot.append(n('span', (appSettings.installName || 'PacoSAT') + ' · Expediente fiscal'),
    n('span', (rfc || scope || 'Todos los contribuyentes') + ' · ' +
      new Date().toLocaleDateString('es-MX', { dateStyle: 'long' })));
  return foot;
}
/* Paquete mensual para la contadora (1.6.5): un ZIP descargable por RFC
   y mes con los totales en CSV, la base DIOT de ese mes en CSV, un
   resumen HTML listo para imprimir/guardar en PDF y el manifiesto.
   Solo descarga del usuario: PacoSAT no envía nada a terceros. */
function monthlyPackageDialog(rfcPreseleccionado = '', mesPreseleccionado = '') {
  const totals = monthlyTotals();
  check(totals.size, 'Todavía no hay totales para preparar un paquete.');
  const rfcs = [...totals.keys()];
  const rfcSel = select(rfcs.map(rfc => [rfc, (totals.get(rfc).name || rfc) + ' · ' + rfc]),
    rfcPreseleccionado && totals.has(rfcPreseleccionado) ? rfcPreseleccionado
      : scope && totals.has(scope) ? scope : rfcs[0], 'Contribuyente');
  const monthSel = select([], '', 'Mes');
  const fillMonths = () => {
    monthSel.replaceChildren(...totals.get(rfcSel.value).months.map(([key]) => {
      const option = n('option', key.slice(5, 7) + '/' + key.slice(0, 4));
      option.value = key;
      return option;
    }));
    if (mesPreseleccionado && totals.get(rfcSel.value).months.some(([key]) => key === mesPreseleccionado))
      monthSel.value = mesPreseleccionado;
  };
  rfcSel.onchange = fillMonths;
  fillMonths();
  dialog('Paquete mensual para la contadora', [n('p', 'Un ZIP por RFC y mes con: totales en CSV, base DIOT del mes en CSV, resumen imprimible (HTML), el detalle con folio, los XML del mes y el manifiesto con el contenido y la fecha de generación. Se descarga en tu equipo; PacoSAT no lo envía a nadie.'),
    field('Contribuyente', rfcSel), field('Mes', monthSel)], () => buildMonthlyPackage(rfcSel.value, monthSel.value));
  $('save').textContent = 'Preparar y descargar';
}
async function buildMonthlyPackage(rfc, monthKey) {
  const group = monthlyTotals().get(rfc);
  const found = group?.months.find(([key]) => key === monthKey);
  check(found, 'Ese RFC no tiene comprobantes en el mes elegido.');
  const g = found[1];
  const esc = value => {
    const text = String(value);
    const safe = /^[\s\uFEFF]*[=+\-@]|^[\t\r\n]/u.test(text) ? "'" + text : text;
    return '"' + safe.replaceAll('"', '""') + '"';
  };
  const escHtml = text => String(text).replaceAll('&', '&amp;').replaceAll('<', '&lt;').replaceAll('>', '&gt;');
  const totalesCsv = [['RFC', 'Contribuyente', 'Mes', 'Recibidos', 'Importe recibidos MXN', 'Emitidos', 'Importe emitidos MXN', 'Canceladas (fuera de los totales)', 'Complementos de pago'],
    [rfc, group.name, monthKey, g.received, centsPlain(g.receivedCents), g.issued, centsPlain(g.issuedCents), g.cancelled, g.rep]]
    .map(row => row.map(esc).join(',')).join('\r\n');
  const providers = new Map();
  for (const row of invoices) {
    if (row.to.rfc !== rfc || !row.date.startsWith(monthKey)) continue;
    /* N2 también en la DIOT del navegador: sin canceladas, sin
       complementos de pago y sin nómina; la divisa verdadera se
       anota por código y no se suma. */
    if (rowCancelled(row) || row.kind === 'P' || row.kind === 'N') continue;
    if (!providers.has(row.from.rfc)) providers.set(row.from.rfc, { name: row.from.name || '', count: 0, cents: 0n, divisas: {} });
    const provider = providers.get(row.from.rfc);
    const currency = (row.currency || 'MXN').toUpperCase();
    if (currency !== 'MXN') { provider.divisas[currency] = (provider.divisas[currency] || 0) + 1; continue; }
    provider.count++;
    provider.cents += totalCents(row);
    if (!provider.name && row.from.name) provider.name = row.from.name;
  }
  const diotText = [['Mes', 'RFC proveedor', 'Proveedor', 'CFDI recibidos', 'Total MXN', 'En divisa (por código, sin sumar)'],
    ...[...providers].sort((a, b) => a[0].localeCompare(b[0])).map(([providerRfc, provider]) =>
      [monthKey, providerRfc, provider.name, provider.count, centsPlain(provider.cents),
        Object.entries(provider.divisas).map(([code, n]) => n + ' en ' + code).join(' · ')])]
    .map(row => row.map(esc).join(',')).join('\r\n');
  let checked = 0, cancelled = 0, efosHits = 0;
  for (const row of invoices) {
    if (!row.date.startsWith(monthKey) || (row.from.rfc !== rfc && row.to.rfc !== rfc)) continue;
    const item = fiscalResults.get(row.id);
    if (item?.sat) { checked++; if (item.sat.state === 'Cancelado') cancelled++; }
    if (item?.efos?.length) efosHits++;
  }
  const generated = localDateTime(Date.now());
  const resumen = '<!DOCTYPE html>\n<html lang="es"><head><meta charset="utf-8"><title>PacoSAT · Resumen ' + monthKey + ' · ' + escHtml(rfc) + '</title>' +
    '<style>body{font-family:system-ui,sans-serif;margin:32px;color:#17293f}h1{font-size:22px}table{border-collapse:collapse}td,th{border:1px solid #bcccdc;padding:6px 10px;text-align:left}.nota{color:#54687f;font-size:12px}</style></head><body>' +
    '<p>PACOSAT · PAQUETE MENSUAL</p><h1>Resumen ' + monthKey.slice(5, 7) + '/' + monthKey.slice(0, 4) + ' · ' + escHtml(group.name) + ' (' + escHtml(rfc) + ')</h1>' +
    '<table><tr><th>Concepto</th><th>Cantidad</th><th>Importe MXN</th></tr>' +
    '<tr><td>CFDI recibidos</td><td>' + g.received + '</td><td>$' + centsLabel(g.receivedCents) + '</td></tr>' +
    '<tr><td>CFDI emitidos</td><td>' + g.issued + '</td><td>$' + centsLabel(g.issuedCents) + '</td></tr></table>' +
    '<p class="nota">Vigilancia según la última consulta disponible: ' + checked + ' CFDI consultados, ' + cancelled + ' cancelados, ' + efosHits +
    ' con coincidencia 69-B. Importes en MXN sumados al centavo (sin canceladas); las divisas verdaderas se cuentan por su código, sin sumar. Generado el ' + generated +
    ' por PacoSAT. Documento de trabajo, no una declaración.</p></body></html>';
  /* Detalle de los CFDI del mes (UX-23): el paquete incluye el listado
     comprobante a comprobante, no solo los totales. */
  const detailRows = invoices.filter(row => row.date.startsWith(monthKey) && (row.from.rfc === rfc || row.to.rfc === rfc));
  /* Ronda Salidas (1.14.0): el detalle lleva el FOLIO y el paquete
     incluye POR FIN los XML del mes (carpeta xml/): sin ellos la
     contadora no podía timbrar nada contra el papel. Los que no
     tengan XML guardado se cuentan en el manifiesto, no se callan. */
  const detailCsv = [['UUID', 'Folio', 'Fecha', 'Emisor', 'RFC emisor', 'Receptor', 'RFC receptor', 'Tipo', 'Total', 'Moneda'],
    ...detailRows.map(row => [row.id, row.fiscal ? (row.fiscal.series ? row.fiscal.series + '-' : '') + (row.fiscal.folio || '') : '', row.date, row.from.name, row.from.rfc, row.to.name, row.to.rfc, KINDS[row.kind], row.total, row.currency])]
    .map(row => row.map(esc).join(',')).join('\r\n');
  const xmlEntries = [];
  try {
    const files = await readStore('files');
    const byId = new Map(files.map(file => [file.id, file]));
    for (const row of detailRows) {
      const file = byId.get('xml:' + row.id);
      if (file?.blob) xmlEntries.push({ name: 'xml/' + row.id + '.xml', data: new Uint8Array(await file.blob.arrayBuffer()) });
    }
  } catch { /* sin almacén local: el paquete sale sin XML y el manifiesto lo cuenta */ }
  const names = ['totales.csv', 'base-diot.csv', 'resumen.html', 'manifiesto.txt', 'cfdi-del-mes.csv',
    'xml/ · ' + xmlEntries.length + ' XML de los CFDI del mes (' + (detailRows.length - xmlEntries.length) + ' sin XML guardado)'];
  const encoder = new TextEncoder();
  const zip = zipStore([
    { name: names[0], data: encoder.encode('\uFEFF' + totalesCsv) },
    { name: names[1], data: encoder.encode('\uFEFF' + diotText) },
    { name: names[2], data: encoder.encode(resumen) },
    { name: names[4], data: encoder.encode('\uFEFF' + detailCsv) },
    ...xmlEntries,
    { name: names[3], data: encoder.encode(monthlyPackageManifest(rfc, monthKey, names, generated, appSettings.installName)) }
  ]);
  download(zip, 'PacoSAT-' + rfc + '-' + monthKey + '.zip');
  announce('Paquete mensual de ' + rfc + ' (' + monthKey.slice(5, 7) + '/' + monthKey.slice(0, 4) + ') descargado.');
}
function diotGroups() {
  const groups = new Map();
  for (const row of invoices) {
    if (!roles(row).received) continue;
    /* N2: la DIOT tampoco cuenta canceladas, complementos de pago
       ni nómina; la divisa verdadera se cuenta por código aparte. */
    if (rowCancelled(row) || row.kind === 'P' || row.kind === 'N') continue;
    const key = row.date.slice(0, 7) + '|' + row.from.rfc;
    if (!groups.has(key)) groups.set(key, { month: row.date.slice(0, 7), rfc: row.from.rfc, name: row.from.name || '', count: 0, cents: 0n, foreign: 0,
      baseCents: 0n, ivaCents: 0n, withheldCents: 0n, withFiscal: 0 });
    const group = groups.get(key);
    if (row.currency && row.currency !== 'MXN') { group.foreign++; continue; }
    group.count++;
    group.cents += totalCents(row);
    /* Desglose fiscal (1.6.16): valor de actos e IVA por proveedor
       desde el desglose persistido; sin desglose, no se estima nada. */
    const base = invoiceIvaBaseCents(row), iva = invoiceIvaCents(row);
    if (base !== null && iva !== null) {
      group.withFiscal++;
      if (!row.currency || row.currency === 'MXN') {
        group.baseCents += base; group.ivaCents += iva;
        for (const w of row.fiscal.withheld) group.withheldCents += moneyCents(w.amount);
      }
    }
    if (!group.name && row.from.name) group.name = row.from.name;
  }
  return [...groups.values()].sort((a, b) => b.month.localeCompare(a.month) || a.rfc.localeCompare(b.rfc));
}
function diotScreen() {
  const wrap = panel('Totales por proveedor y mes · CFDI recibidos');
  wrap.append(n('p', 'Base de trabajo para la contadora, no la declaración. Suma por RFC emisor y mes el total, el valor de actos y el IVA de los CFDI recibidos' +
    (scope ? ' para ' + scope : ' de todos tus RFC') + '. El desglose sale del XML guardado: si un CFDI aún no tiene desglose, reprocésalo desde Salidas; la DIOT formal sigue requiriendo los ajustes de la contadora.'));
  const rows = diotGroups();
  if (!rows.length) { wrap.append(empty('Sin CFDI recibidos', 'Importa comprobantes recibidos para construir la base por proveedor.')); return [wrap]; }
  wrap.querySelector('.panel-head').append(action('Exportar CSV', exportDiotCsv, 'metric-link', 'down'));
  wrap.append(grid(['Mes', 'RFC proveedor', 'Proveedor', 'CFDI', 'Valor de actos', 'IVA', 'Total MXN'], rows.slice(0, 200).map(group => [
    group.month.slice(5, 7) + '/' + group.month.slice(0, 4), group.rfc, group.name || '—', number.format(group.count),
    group.withFiscal ? '$' + centsLabel(group.baseCents) : 'sin desglose',
    group.withFiscal ? '$' + centsLabel(group.ivaCents) : '—',
    cell('$' + centsLabel(group.cents), group.foreign ? group.foreign + ' en otra moneda sin sumar' : '')
  ])));
  if (rows.length > 200) wrap.append(n('p', 'Se muestran las primeras 200 filas; la exportación CSV incluye todas.'));
  return [wrap];
}
function diotCsv() {
  const escape = value => {
    const text = String(value);
    const safe = /^[\s\uFEFF]*[=+\-@]|^[\t\r\n]/u.test(text) ? "'" + text : text;
    return '"' + safe.replaceAll('"', '""') + '"';
  };
  const rows = [['Mes', 'RFC proveedor', 'Proveedor', 'CFDI recibidos', 'Valor de actos MXN', 'IVA trasladado MXN', 'Retenciones MXN', 'Total MXN', 'CFDI con desglose', 'En otra moneda sin sumar']];
  for (const group of diotGroups()) rows.push([group.month, group.rfc, group.name, group.count, centsPlain(group.baseCents), centsPlain(group.ivaCents), centsPlain(group.withheldCents), centsPlain(group.cents), group.withFiscal, group.foreign]);
  return rows.map(row => row.map(escape).join(',')).join('\r\n');
}
function exportDiotCsv() {
  check(diotGroups().length, 'Sin CFDI recibidos para exportar.');
  download(new Blob(['\uFEFF', diotCsv()], { type: 'text/csv;charset=utf-8' }), 'Base-DIOT-' + (scope || 'todos') + '.csv');
  announce('Base DIOT exportada en CSV.');
}
function monthlyChart() {
  const byMonth = new Map();
  for (const group of monthlyTotals().values()) for (const [key, g] of group.months) {
    if (!byMonth.has(key)) byMonth.set(key, { issued: 0n, received: 0n });
    const entry = byMonth.get(key);
    entry.issued += g.issuedCents; entry.received += g.receivedCents;
  }
  const keys = [...byMonth.keys()].sort().slice(-6);
  const wrap = panel('Totales por mes');
  if (!keys.length) {
    wrap.append(empty('Sin datos para el gráfico', 'Al importar CFDI verás aquí la evolución mensual de emitidos y recibidos.'));
    return wrap;
  }
  const NS = 'http://www.w3.org/2000/svg';
  const svg = document.createElementNS(NS, 'svg');
  svg.setAttribute('viewBox', '0 0 640 256'); svg.setAttribute('class', 'chart'); svg.setAttribute('role', 'img');
  svg.setAttribute('aria-label', 'Gráfico de barras con los importes emitidos y recibidos de los últimos meses');
  const el = (tag, attrs, text) => {
    const node = document.createElementNS(NS, tag);
    for (const [name, value] of Object.entries(attrs || {})) node.setAttribute(name, value);
    if (text) node.textContent = text;
    return node;
  };
  /* Aire para los rótulos (2.9.7 · D7, verificado con render
     real): el margen superior sube de 26 a 44 para que los DOS
     rótulos de un mes quepan apilados sobre la barra más alta
     sin pisarse ni salirse — con 26, el apilado no cabía y el
     tope de la corrección vieja dejaba los dos a la misma
     altura (solape medido en Chromium: 6 pares por ancho). */
  const base = 198, top = 44, height = base - top;
  let max = 0n;
  for (const key of keys) { const entry = byMonth.get(key); if (entry.issued > max) max = entry.issued; if (entry.received > max) max = entry.received; }
  for (const frac of [0.25, 0.5, 0.75, 1]) svg.append(el('line', { x1: 10, x2: 630, y1: base - height * frac, y2: base - height * frac, class: 'grid-line' }));
  svg.append(el('line', { x1: 10, x2: 630, y1: base, y2: base, class: 'grid-line' }));
  const shortMoney = cents => {
    const pesos = Number(cents) / 100;
    return pesos >= 100000 ? '$' + number.format(Math.round(pesos / 1000)) + ' mil' : '$' + centsLabel(cents);
  };
  const slot = 620 / keys.length, barW = Math.min(27, slot / 4.5);
  keys.forEach((key, index) => {
    const entry = byMonth.get(key);
    const center = 10 + slot * index + slot / 2;
    /* Rótulos fuera de la barra y ESCALONADOS por serie (1.11.0;
       raíz corregida en 2.9.7 · D7): emitidos 22 px por encima
       de su barra, recibidos 6 px — 16 px de separación ya con
       alturas iguales —; si aun así las dos cifras de un mes
       quedan a menos de 17 px (la caja del texto ronda los
       14 px), se APILAN las dos sobre la barra MÁS ALTA del
       mes: recibidos a 6 px sobre ella y emitidos a 23 px,
       con los 17 px garantizados entre ambos. La corrección
       vieja subía recibidos con un tope (máx. y=11) que, con
       la barra casi al máximo, dejaba los dos rótulos a la
       MISMA altura: solape real medido en Chromium sobre
       Reportes (6 pares solapados por ancho, escritorio y
       móvil). La cifra completa vive siempre en el título de
       cada barra. */
    const labelY = {};
    const barTop = {};
    for (const [kind, cents] of [['issued', entry.issued], ['received', entry.received]]) {
      if (!cents) continue;
      const h = max ? Math.max(1, Math.round(Number(cents) / Number(max) * height)) : 0;
      barTop[kind] = base - h;
      labelY[kind] = barTop[kind] - (kind === 'issued' ? 22 : 6);
    }
    if (labelY.issued !== undefined && labelY.received !== undefined &&
        Math.abs(labelY.issued - labelY.received) < 17) {
      const masAlta = Math.min(barTop.issued, barTop.received);
      labelY.received = masAlta - 6;
      labelY.issued = masAlta - 23;
    }
    for (const [kind, cents, offset] of [['issued', entry.issued, -barW - 2], ['received', entry.received, 2]]) {
      const h = max ? Math.max(1, Math.round(Number(cents) / Number(max) * height)) : 0;
      if (cents) {
        const bar = el('rect', { x: center + offset, y: base - h, width: barW, height: h, rx: 3, class: 'bar-' + kind });
        bar.append(el('title', {}, (kind === 'issued' ? 'Emitidos ' : 'Recibidos ') + key + ': $' + centsLabel(cents)));
        svg.append(bar, el('text', { x: center + offset + barW / 2, y: labelY[kind], 'text-anchor': 'middle' }, shortMoney(cents)));
      }
    }
    svg.append(el('text', { x: center, y: base + 18, 'text-anchor': 'middle' }, key.slice(5, 7) + '/' + key.slice(0, 4)));
  });
  const chartWrap = n('div', undefined, 'chart-wrap'); chartWrap.append(svg);
  const legend = n('div', undefined, 'chart-legend');
  const item = (cls, label) => { const span = n('span'); const sw = n('i', undefined, cls); span.append(sw, document.createTextNode(label)); return span; };
  legend.append(item('sw-issued', 'Emitidos'), item('sw-received', 'Recibidos'));
  wrap.append(chartWrap, legend);
  return wrap;
}
function n(tag, text, cls) {
  const el = document.createElement(tag);
  if (text !== undefined) el.textContent = text;
  if (cls) el.className = cls;
  return el;
}
function icon(name) {
  const svg = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
  svg.setAttribute('aria-hidden', 'true');
  const use = document.createElementNS(svg.namespaceURI, 'use');
  use.setAttribute('href', '#i-' + name);
  svg.append(use);
  return svg;
}
function action(label, work, cls, glyph) {
  const button = n('button', label, cls);
  button.type = 'button';
  if (glyph) button.prepend(icon(glyph));
  button.onclick = () => Promise.resolve().then(work).catch(error => announce(error.message, true));
  return button;
}
function announce(message = '', error = false, quiet = false) {
  $('status').textContent = message;
  $('status').hidden = !message;
  $('status').dataset.error = error;
  if (message && error) soundCue('error');
  /* Avisos flotantes (1.26.0, Ronda Visual): la barra #status
     sigue siendo el registro, pero la confirmación también se
     ve donde está el dedo — en una lista larga en el móvil, la
     barra queda fuera de pantalla y el aviso se perdía. quiet
     es para quien flota su propia tarjeta (toastUndo). */
  if (message && !quiet) floatToast(message, error ? 'error' : 'ok');
}
let lastFloat = { text: '', at: 0 };
function floatToast(message, kind = 'ok', undoWork = null) {
  const box = $('toasts');
  if (!box || !message) return null;
  const now = Date.now();
  if (!undoWork && lastFloat.text === message && now - lastFloat.at < 1500) return null;
  lastFloat = { text: message, at: now };
  while (box.children.length >= 3) box.firstChild.remove();
  const card = n('div', undefined, 'toast-card');
  card.dataset.kind = kind;
  card.setAttribute('role', 'status');
  card.append(n('p', message));
  const dismiss = () => { if (card.isConnected) card.remove(); };
  if (undoWork) {
    const undo = n('button', 'Deshacer', 'soft small');
    undo.type = 'button';
    undo.onclick = async () => {
      undo.disabled = true;
      try { await undoWork(); dismiss(); }
      catch (error) { announce(error.message, true); }
    };
    card.append(undo);
  }
  const close = n('button', undefined, 'icon-button toast-close');
  close.type = 'button';
  close.setAttribute('aria-label', 'Cerrar el aviso');
  close.append(icon('close'));
  close.onclick = dismiss;
  card.append(close);
  box.append(card);
  setTimeout(dismiss, undoWork ? 15000 : kind === 'error' ? 9000 : 6000);
  return card;
}
/* toast(): el nombre con el que los fragmentos nuevos (Centro de
   salidas, Dinero, Cumplimiento, Bancos, Constancias…) piden el mismo
   aviso que announce() pinta en la barra de estado. Nunca se definió
   (hotfix 1.7.3): cada llamada moría con «toast is not defined» — lo
   vio Paco en producción — y los catch que avisaban con toast()
   enmascaraban el error verdadero tras ese ReferenceError. El segundo
   argumento es el de las llamadas: 'error' marca el aviso como error
   y cualquier otro valor ('ok') lo deja como aviso normal. */
function toast(message, kind) {
  announce(message, kind === 'error');
}
/* toastUndo(): la acción se aplicó y se puede deshacer un momento
   (1.18.0, «deshacer universal»): el botón vive en la barra de
   estado junto al aviso; si no se toca, la acción queda. */
function toastUndo(message, undoWork) {
  announce(message, false, true);
  const bar = $('status');
  /* El deshacer es UNO (1.26.0): el botón de la barra y el de la
     tarjeta flotante comparten el mismo trabajo protegido — si
     uno lo ejecuta, el otro ya no puede repetirlo. */
  let done = false;
  const run = async () => {
    if (done) return;
    done = true;
    await undoWork();
  };
  const button = n('button', 'Deshacer', 'status-undo');
  button.type = 'button';
  button.onclick = async () => {
    button.disabled = true;
    try { await run(); } catch (error) { announce(error.message, true); }
  };
  bar.append(' ', button);
  floatToast(message, 'ok', run);
  setTimeout(() => { if (button.isConnected && !button.disabled) announce(''); }, 15000);
}
async function logEvent(text) {
  if (!ready) return;
  const entry = { id: crypto.randomUUID(), name: String(text).slice(0, 180), date: new Date().toISOString(),
    added: 0, duplicates: 0, review: 0, issues: [], event: String(text).slice(0, 320) };
  try {
    await writeBatch({ activity: [entry] });
    activity = [entry, ...activity.filter(row => row.id !== entry.id)];
  } catch { /* La bitácora es informativa: nunca debe interrumpir la operación principal. */ }
}
function panel(title) {
  const wrap = n('section', undefined, 'panel');
  if (title) {
    const header = n('div', undefined, 'panel-head');
    header.append(n('h2', title));
    wrap.append(header);
  }
  return wrap;
}
function grid(headers, rows) {
  const wrap = n('div', undefined, 'table-wrap');
  const table = n('table'), head = n('thead'), body = n('tbody'), header = n('tr');
  for (const heading of headers) header.append(n('th', heading));
  head.append(header);
  for (const row of rows) {
    const tr = n('tr');
    for (const [index, cellValue] of row.entries()) {
      const td = n('td');
      /* data-label: en móvil la tabla se vuelve lista de tarjetas y
         cada celda enseña su encabezado (1.18.0). */
      if (headers[index]) td.dataset.label = headers[index];
      if (cellValue instanceof Node) td.append(cellValue);
      else td.textContent = cellValue;
      tr.append(td);
    }
    body.append(tr);
  }
  table.append(head, body); wrap.append(table);
  return wrap;
}
function cell(title, note) {
  const wrap = n('div', title);
  /* (2.9.13 · A6) La nota va en su propia línea (clase
     cell-note, display:block en la piel): como <small> en línea
     salía pegada al título al leer la celda («Modo descanso
     generalUn toque…» en la auditoría en vivo). */
  if (note) wrap.append(n('small', note, 'cell-note'));
  return wrap;
}
function empty(title, message, button) {
  const el = n('div', undefined, 'empty');
  el.append(n('h3', title), n('p', message));
  if (button) el.append(button);
  return el;
}
function select(items, value, label) {
  const input = n('select');
  for (const [id, name] of items) input.append(new Option(name, id));
  input.value = value;
  if (label) input.setAttribute('aria-label', label);
  return input;
}
function field(label, input) {
  const el = n('label', label); el.append(input); return el;
}
/* fieldWrap(): el nombre con el que los fragmentos nuevos (Dinero,
   Cumplimiento, Bancos, invitado) piden este mismo envoltorio de
   etiqueta y control. Se llamaba desde la 1.6.17 y nunca se definió
   (hotfix 1.7.3): es field(), sin duplicar comportamiento. */
const fieldWrap = field;
function input(type, props) { return Object.assign(n('input'), { type }, props); }
function dialog(title, controls, work, confirmLabel) {
  $('dialogTitle').textContent = title;
  $('fields').replaceChildren(...controls);
  $('formError').hidden = true;
  $('save').hidden = !work;
  /* Cada diálogo nombra su acción real (UX-11): «Enviar solicitud»,
     «Autorizar», «Crear respaldo»… no siempre «Guardar». */
  if (work) $('save').textContent = confirmLabel || 'Guardar';
  submit = work;
  /* Repintar un diálogo ya abierto (2.9.7 · D2): el visor
     sustituye su vista previa por el PDF completo EN EL MISMO
     diálogo — showModal() sobre un diálogo abierto lanza
     InvalidStateError, así que solo se muestra si no lo está. */
  if (!$('dialog').open) $('dialog').showModal();
  /* Ojo en contraseñas (UX-21): todo campo de contraseña de un diálogo
     puede mostrarse u ocultarse sin tener que re-teclearlo. */
  for (const pw of $('fields').querySelectorAll('input[type="password"]')) {
    const eye = n('button', undefined, 'pw-eye');
    eye.type = 'button';
    eye.setAttribute('aria-label', 'Mostrar u ocultar la contraseña');
    eye.append(icon('eye'));
    eye.onclick = () => { pw.type = pw.type === 'password' ? 'text' : 'password'; };
    pw.after(eye);
  }
}
/* Puente de diálogos (hotfix 1.7.3): Bancos (confirmar saldos) y el
   acceso de invitado componen su propio <form class="dialog-form">,
   con su título, sus botones y su onsubmit, y lo muestran con
   showDialog() y lo cierran con closeDialog(); ninguna de las dos
   existía. El formulario propio se aloja en el <dialog> compartido,
   ocultando mientras tanto el formulario integrado, y se retira al
   cerrar — también cuando el diálogo se cierra con Esc —. */
let hostedForm = null;
function showDialog(form) {
  closeDialog();
  hostedForm = form;
  $('form').hidden = true;
  /* El título del diálogo es el del formulario alojado
     (2.9.0 · Bloque C): antes heredaba el de el diálogo
     anterior y la hoja de descarga se titulaba «Visor de
     documentos». */
  const tituloPropio290 = form.querySelector('h3')?.textContent?.trim();
  if (tituloPropio290) $('dialogTitle').textContent = tituloPropio290;
  $('dialog').append(form);
  $('dialog').addEventListener('close', () => closeDialog(), { once: true });
  $('dialog').showModal();
}
function closeDialog() {
  if (hostedForm) { hostedForm.remove(); hostedForm = null; }
  $('form').hidden = false;
  if ($('dialog').open) $('dialog').close();
}
function download(blob, name) {
  const url = URL.createObjectURL(blob);
  const link = n('a'); link.href = url; link.download = name;
  document.body.append(link); link.click(); link.remove();
  setTimeout(() => URL.revokeObjectURL(url), 15000);
}
/* ===== «Enviar» en un toque (2.4.0 · W4a, pedido de Paco
   17 nov 15:19–15:20) =====
   Botón «Enviar» VISIBLE junto a cada «Descargar» de reportes
   y documentos — nunca dentro de un menú ⋯ — que abre UNA
   tarjeta con los TRES canales, en lenguaje llano por canal:
   (1) CORREO: envío real por POST /api/enviar (la ruta de W2),
       con un conjunto CERRADO de adjuntos — {clase:'documento',
       id} del expediente, {clase:'zip-mes', rfc, mes} generado
       en el acto y {clase:'acuse', id} —; el cliente manda
       destinatario y asunto y el cuerpo lo genera el servidor.
       NADA sale sin la confirmación de Paco EN esta tarjeta.
       Si el envío falla (502), el porqué se enseña en la propia
       tarjeta y el borrador (destinatario y asunto) se CONSERVA
       en los campos para reintentar: la ruta no guarda
       borradores y esta tarjeta es su único sitio.
   (2) WHATSAPP y (3) COMPARTIR: la hoja de compartir del
       aparato (Web Share API con el archivo donde el navegador
       la admite). PacoSAT NO envía WhatsApp por su cuenta: en
       PC sin compartir-archivos, el respaldo honesto es bajar
       el documento y abrir el chat de WhatsApp (wa.me, sin
       número concreto) con el texto listo para adjuntarlo a
       mano — la tarjeta lo dice tal cual, sin prometer
       adjuntos donde el canal no los admite.
   Lo compartido se anota con logEvent (la bitácora local de
   actividad del cliente, el camino cliente→anotación que ya
   existe) como «compartido desde el aparato»: NO se finge una
   confirmación de entrega ni un asiento en el Registro del
   servidor, para el que no hay ruta cliente.
   Un envío por toque, sin lotes. El invitado no ve el botón:
   su acceso es de solo lectura y la ruta lo rechaza con 403. */
const ENVIAR_FRECUENTES240 = [
  ['n.rodriguez@consultoresbg.com', 'Nora · el despacho'],
  ['paco.iglesias@gmail.com', 'Yo mismo']];
function enviarDisponible240() {
  return typeof guestMode === 'undefined' || !guestMode;
}
/* El adjunto de una salida del servidor (base64 de satApi) como
   Blob listo para compartir: la misma petición que «Descargar»
   hace, sin descargar nada todavía. */
async function enviarBlobSalida240(ruta, payload) {
  const data = await satApi(ruta, payload);
  return { blob: new Blob([decode64(data.content)], { type: data.type || 'application/octet-stream' }),
    nombre: data.name || 'documento' };
}
/* El fichero de un documento del expediente como Blob: por la
   ruta en línea cuando hay servidor y, si no, la copia local. */
async function enviarBlobDocumento240(doc) {
  if (typeof satToken !== 'undefined' && satToken) {
    try { return { blob: await satApiBlob('files/view?id=' + encodeURIComponent(doc.id)), nombre: doc.name || 'documento.pdf' }; }
    catch { /* sin copia en línea: se intenta la local */ }
  }
  const file = await readStore('files', doc.id);
  if (file?.blob) return { blob: file.blob, nombre: doc.name || file.blob.name || 'documento.pdf' };
  throw new Error('No se encontró el fichero de este documento en este equipo.');
}
function enviarAnotar240(nombre) {
  /* Anotación local honesta: «compartido desde el aparato»,
     sin fingir entrega. logEvent es de esta misma parte. */
  if (typeof logEvent === 'function')
    logEvent('Compartido desde el aparato: ' + nombre).catch(() => {});
}
/* Compartir con el archivo donde el aparato lo admite.
   Devuelve 'compartido' | 'descargado' y lanza si el usuario
   cancela la hoja (AbortError) para que la tarjeta lo distinga
   de un fallo. */
async function enviarCompartirArchivo240(opts, estado) {
  const archivo = await opts.archivo();
  const file = new File([archivo.blob], archivo.nombre, { type: archivo.blob.type || 'application/octet-stream' });
  const datos = { files: [file], title: opts.nombre, text: opts.texto || ('Te envío ' + opts.nombre + ' (desde PacoSAT).') };
  if (typeof navigator !== 'undefined' && typeof navigator.share === 'function' &&
      (typeof navigator.canShare !== 'function' || navigator.canShare(datos))) {
    await navigator.share(datos);
    enviarAnotar240(opts.nombre);
    return 'compartido';
  }
  /* Respaldo honesto: sin compartir-archivos no hay adjunto
     posible por esta vía — se baja el documento y se dice. */
  download(archivo.blob, archivo.nombre);
  if (estado) estado.textContent = 'Este navegador no puede compartir archivos: el documento se descargó. Adjúntalo tú desde donde lo quieras mandar.';
  enviarAnotar240(opts.nombre);
  return 'descargado';
}
async function enviarPorWhatsApp240(opts, estado) {
  const texto = opts.texto || ('Te envío ' + opts.nombre + ' (desde PacoSAT).');
  /* En un aparato que comparte archivos, la hoja del sistema
     incluye WhatsApp con el adjunto de verdad: es el camino
     bueno y se ofrece como tal, sin prometer nada más. */
  if (typeof navigator !== 'undefined' && typeof navigator.share === 'function' && opts.archivo) {
    try {
      const archivo = await opts.archivo();
      const file = new File([archivo.blob], archivo.nombre, { type: archivo.blob.type || 'application/octet-stream' });
      if (typeof navigator.canShare !== 'function' || navigator.canShare({ files: [file] })) {
        await navigator.share({ files: [file], title: opts.nombre, text: texto });
        enviarAnotar240(opts.nombre);
        if (estado) estado.textContent = 'Hoja de compartir abierta: elige WhatsApp y el documento va adjunto.';
        return;
      }
    } catch (error) {
      if (error?.name === 'AbortError') throw error;
      /* si la hoja falla, se cae al respaldo de abajo */
    }
  }
  /* Respaldo de PC: PacoSAT no manda WhatsApp por su cuenta.
     Se baja el documento y se abre el chat (wa.me sin número:
     Paco elige a quién) con el texto listo; el adjunto lo pone
     él en el chat, y la tarjeta lo dice antes de hacerlo. */
  if (opts.archivo) {
    const archivo = await opts.archivo();
    download(archivo.blob, archivo.nombre);
  }
  const url = 'https://wa.me/?text=' + encodeURIComponent(texto + (opts.archivo ? ' (te adjunto el documento: se acaba de descargar en este equipo)' : ''));
  if (typeof window !== 'undefined' && typeof window.open === 'function') window.open(url, '_blank');
  if (estado) estado.textContent = 'Documento descargado y chat de WhatsApp abierto con el texto listo: adjunta el documento en el chat. PacoSAT no envía WhatsApp por su cuenta.';
  enviarAnotar240(opts.nombre);
}
/* La tarjeta de los tres canales. opts:
   { nombre, asunto, texto?, correo: {clase, id?|rfc?, mes?}|null,
     correoNota?: texto llano cuando el correo no encaja,
     archivo: async () => ({blob, nombre}) | null } */
function enviarTarjeta240(opts) {
  const controles = [];
  controles.push(n('p', 'Vas a enviar: ' + opts.nombre, 'muted'));
  /* --- Canal 1 · Correo --- */
  const seccionCorreo = n('div', undefined, 'enviar-canal240');
  seccionCorreo.append(n('h3', 'Por correo'));
  let paraInput = null, asuntoInput = null;
  if (opts.correo && typeof satToken !== 'undefined' && satToken) {
    seccionCorreo.append(n('p', 'Sale de verdad por el correo de PacoSAT, con el documento adjunto. Nada sale hasta que pulses «Enviar por correo» en esta tarjeta.'));
    const frecuentes = n('div', undefined, 'actions');
    paraInput = input('text', { placeholder: 'destinatario@ejemplo.com' });
    paraInput.setAttribute('aria-label', 'Destinatario');
    for (const [correo, etiqueta] of ENVIAR_FRECUENTES240) {
      const chip = n('button', etiqueta, 'soft small');
      chip.type = 'button';
      chip.onclick = () => { paraInput.value = correo; };
      frecuentes.append(chip);
    }
    asuntoInput = input('text', { value: opts.asunto || ('PacoSAT · ' + opts.nombre) });
    asuntoInput.setAttribute('aria-label', 'Asunto');
    const estadoCorreo = n('p', '', 'muted');
    estadoCorreo.dataset.enviarEstado = 'correo';
    const enviarBtn = n('button', 'Enviar por correo', 'primary');
    enviarBtn.type = 'button';
    enviarBtn.prepend(icon('mail'));
    enviarBtn.onclick = async () => {
      const para = paraInput.value.trim();
      const asunto = asuntoInput.value.trim();
      if (!para || !asunto) { estadoCorreo.textContent = 'Escribe el destinatario y el asunto: sin los dos, no sale nada.'; return; }
      enviarBtn.disabled = true;
      estadoCorreo.textContent = 'Enviando…';
      try {
        const r = await satApi('enviar', { para, asunto, ...opts.correo });
        estadoCorreo.dataset.estado = 'aldia';
        estadoCorreo.textContent = 'Enviado: ' + (r?.documento || opts.nombre) + ' a ' + para + '. Quedó anotado en el Registro.';
        toast('Enviado a ' + para + '.', 'ok');
      } catch (error) {
        /* El porqué, en la tarjeta; el borrador (destinatario y
           asunto) se queda en los campos para reintentar. */
        estadoCorreo.textContent = 'No salió: ' + error.message + ' Tu destinatario y tu asunto se quedan en esta tarjeta para reintentarlo.';
        toast(error.message, 'error');
        enviarBtn.disabled = false;
      }
    };
    seccionCorreo.append(frecuentes, field('Destinatario', paraInput), field('Asunto', asuntoInput),
      n('p', 'Adjunto: ' + opts.nombre, 'muted'), enviarBtn, estadoCorreo);
  } else if (opts.correo) {
    seccionCorreo.append(n('p', 'El correo sale desde el servidor de PacoSAT: abre la app desde tu servidor para usar este canal. WhatsApp y Compartir sí funcionan aquí.'));
  } else {
    seccionCorreo.append(n('p', opts.correoNota ||
      'Este documento no está entre los que el correo de PacoSAT puede adjuntar (solo documentos del expediente, el ZIP del mes y los acuses): mándalo por WhatsApp o Compartir, o descárgalo y adjúntalo desde tu correo.'));
  }
  controles.push(seccionCorreo);
  /* --- Canales 2 y 3 · WhatsApp y Compartir --- */
  const seccionHoja = n('div', undefined, 'enviar-canal240');
  seccionHoja.append(n('h3', 'Desde tu aparato'));
  seccionHoja.append(n('p', 'PacoSAT no envía WhatsApp por su cuenta: estos dos botones usan la hoja de compartir de tu aparato. Donde el navegador no puede compartir archivos, el documento se descarga y lo adjuntas tú; la tarjeta te lo dice en cada caso. Lo que compartas se anota como «compartido desde el aparato», sin fingir que llegó.'));
  const estadoHoja = n('p', '', 'muted');
  estadoHoja.dataset.enviarEstado = 'hoja';
  const filaHoja = n('div', undefined, 'actions');
  const whatsBtn = n('button', 'WhatsApp', 'soft');
  whatsBtn.type = 'button';
  whatsBtn.dataset.enviarCanal = 'whatsapp';
  whatsBtn.prepend(icon('send'));
  whatsBtn.onclick = async () => {
    whatsBtn.disabled = true;
    try { await enviarPorWhatsApp240(opts, estadoHoja); }
    catch (error) { if (error?.name !== 'AbortError') { estadoHoja.textContent = 'No se pudo preparar: ' + error.message; toast(error.message, 'error'); } }
    whatsBtn.disabled = false;
  };
  const compBtn = n('button', 'Compartir', 'soft');
  compBtn.type = 'button';
  compBtn.dataset.enviarCanal = 'compartir';
  compBtn.prepend(icon('share'));
  compBtn.onclick = async () => {
    compBtn.disabled = true;
    try {
      const como = await enviarCompartirArchivo240(opts, estadoHoja);
      if (como === 'compartido') { estadoHoja.textContent = 'Hoja de compartir abierta con el documento adjunto.'; toast('Compartido desde el aparato.', 'ok'); }
    } catch (error) { if (error?.name !== 'AbortError') { estadoHoja.textContent = 'No se pudo compartir: ' + error.message; toast(error.message, 'error'); } }
    compBtn.disabled = false;
  };
  if (opts.archivo) filaHoja.append(whatsBtn, compBtn);
  else seccionHoja.append(n('p', 'Este envío no tiene fichero que compartir desde aquí: usa «Descargar» y compártelo desde tu equipo.'));
  seccionHoja.append(filaHoja, estadoHoja);
  controles.push(seccionHoja);
  dialog('Enviar · ' + opts.nombre, controles, null);
}
/* El botón «Enviar» de cada superficie: visible, con su icono
   y su palabra, junto al «Descargar» de siempre. opts puede ser
   un objeto o una función que lo compone al pulsar (para que
   la referencia —mes, RFC, contraparte— sea la del momento). */
function enviarBoton240(opts, clase, etiqueta) {
  /* El botón nombra lo que envía (2.9.0 · Bloque C): en
     Reportes había siete «Enviar» idénticos; con etiqueta, el
     botón dice qué sale («Enviar este reporte» + el nombre en
     su título y su aria-label). */
  const btn = n('button', etiqueta || 'Enviar', clase || 'soft');
  btn.type = 'button';
  btn.dataset.enviar240 = typeof opts === 'function' ? 'dinamico' :
    (opts.correo ? opts.correo.clase : 'compartir');
  if (opts && typeof opts === 'object' && opts.nombre) {
    btn.title = 'Enviar · ' + opts.nombre;
    btn.setAttribute('aria-label', 'Enviar · ' + opts.nombre);
  }
  btn.prepend(icon('send'));
  btn.onclick = () => {
    const actual = typeof opts === 'function' ? opts() : opts;
    enviarTarjeta240(actual);
  };
  return btn;
}
/* ===== El trabajo VIVO en Hoy (2.4.0 · W4a) =====
   El hueco de Hoy: paintActivity (monitor-ui) pinta en
   [data-sys-activity] solo lo RECIENTE; el trabajo en curso
   vivía únicamente en la franja del dock. Este panel es el
   hueco completo en Hoy: arriba, el trabajo VIVO de la misma
   fuente que ya consume el cliente (GET /api/activity, la de
   pollActivity) con su detalle y su gesto de parada — el botón
   real activityControlButton de monitor-ui, que en el
   artefacto es alcanzable (misma función global, como ya hace
   buzon-ui) — y debajo, el hueco [data-sys-activity] de
   siempre para lo reciente. Si el botón real no fuera
   alcanzable, se pinta el estado y un botón que NAVEGA a
   Vigilancia, donde la franja con el control vive: nunca se
   duplica la lógica de parada aquí. */
/* ===== Línea ÚNICA de actividad (corrección visual 2.4.0) =====
   UNA sola composición para TODAS las tarjetas que pintan un
   trabajo vivo (la franja de paintActivity en monitor-ui, este
   panel de Hoy y la tarjeta fijada de Buzón): antes cada
   entrada concatenaba fase + detalle + nota y DESPUÉS la barra
   de progreso repetía la fase y el tiempo, así que una
   solicitud del SAT decía su estado TRES veces y repetía la
   explicación «Detenerla significa…» en cada entrada. Aquí:
   (1) la explicación de detener una solicitud sale de la
   entrada y se enseña UNA vez por tarjeta (actividadGuia240);
   (2) la línea de detalle lleva el estado, el «desde hace X»
   (el del detalle del servidor o, si no lo trae, el calculado
   desde since) y el dato que distingue a la entrada, sin
   repetir la fase cuando la fase ya está dicha en la línea;
   (3) la barra de progreso solo se pinta cuando aporta algo
   que la línea no dice (un conteo real o un paso distinto). */
function actividadGuia240(entry) {
  const limpio = value => String(value || '').replace(/\s+/g, ' ').trim();
  const core = limpio(entry?.stopExplain);
  if (core) return 'Detenerla significa: ' + core + (core.endsWith('.') ? '' : '.');
  const nota = limpio(entry?.note);
  if (/^detenerla significa:/i.test(nota)) return nota;
  if (nota.includes('el SAT la prepara igual')) return 'Detenerla significa: ' + nota.replace(/^.*?significa:\s*/i, '');
  return '';
}
function actividadLinea240(entry) {
  const limpio = value => String(value || '').replace(/\s+/g, ' ').trim()
    .replace(/^·\s*/, '').replace(/\s*·$/, '');
  const norm = value => limpio(value).toLocaleLowerCase('es-MX');
  const guia = actividadGuia240(entry);
  const nucleoGuia = guia.replace(/^Detenerla significa:\s*/i, '').replace(/\.$/, '');
  const partes = [];
  const mete = raw => {
    const parte = limpio(raw);
    if (!parte) return;
    if (/^detenerla significa:/i.test(parte)) return;
    if (nucleoGuia && norm(parte).includes(norm(nucleoGuia))) return;
    const np = norm(parte);
    for (let i = 0; i < partes.length; i++) {
      const nq = norm(partes[i]);
      if (nq === np) return;
      if (nq.includes(np)) return;
      if (np.includes(nq)) { partes[i] = parte; return; }
    }
    partes.push(parte);
  };
  /* (2.8.0 · diseño 1) La línea abre con el ESTADO (la fase,
     tal como la sirve el servidor) y el detalle entra detrás
     SIN su propio prefijo de estado: antes el detalle mandaba
     («esperando al SAT desde hace…») y la fase, duplicada en
     minúsculas dentro de él, se perdía o se repetía según la
     pantalla. Estado una vez, al frente, y luego el dato. */
  const fase280 = entry?.enPausa ? 'En pausa' : limpio(entry?.phase);
  let detalle280 = limpio(entry?.detail);
  if (fase280 && detalle280 && norm(detalle280).startsWith(norm(fase280)))
    detalle280 = detalle280.slice(fase280.length).replace(/^[ ·—-]+/, '');
  if (entry?.enPausa) mete('En pausa');
  else if (fase280) mete(fase280);
  mete(detalle280);
  if (!entry?.enPausa && fase280) mete(entry?.phase);
  mete(entry?.note);
  let linea = partes.join(' · ');
  /* El «desde hace X» forma parte de la línea: si el detalle
     del servidor no lo trae, sale de la marca real (since)
     con la misma palabra que usa la barra de progreso. */
  if (linea && !/desde hace/i.test(linea) && typeof fmtElapsed1312 === 'function') {
    const transcurrido = fmtElapsed1312(entry?.since || 0);
    if (transcurrido) {
      const espera = entry?.enPausa || ['en-cola', 'esperando', 'pausado'].includes(entry?.state || '');
      linea += ' · ' + (espera ? transcurrido.replace(/^lleva /, 'esperando desde hace ') : transcurrido);
    }
  }
  return linea;
}
/* La barra de un trabajo, SOLO con conteo real (2.8.0 ·
   diseño 1): la barra de «solo fase» era la tercera vez que se
   decía el estado en la misma fila (línea, bajo la fila y en
   la barra, con dos relojes que ni coincidían). La barra vive
   cuando aporta el dato que la línea no puede decir: cuántos
   van de cuántos (done/total). Sin conteo real, no hay barra:
   la línea única ya dice el estado y el «desde hace». */
function actividadProgreso240(entry, linea) {
  if (typeof jobProgress1312 !== 'function') return null;
  const tieneConteo = Number.isFinite(Number(entry?.total)) && Number(entry?.total) > 0 &&
    Number.isFinite(Number(entry?.done));
  if (!tieneConteo) return null;
  return jobProgress1312({ fase: '',
    desde: /desde hace/i.test(linea || '') ? 0 : (entry?.since || 0),
    done: entry?.done, total: entry?.total,
    estado: entry?.enPausa ? (entry?.state || 'pausado') : (entry?.state || '') });
}
function hoyVivoTexto240(entry) {
  return actividadLinea240(entry);
}
/* Despliegue progresivo del panel de Hoy: se recuerda entre
   repintados del pulso (variable de módulo), para que un
   refresco no repliegue la lista en la cara de Paco. */
let hoyActividadDesplegada240 = false;
function pintarHoyVivo240(view, box) {
  if (!box) return;
  const running = (view?.running || []).map(e => ({ ...e, enPausa: false }));
  const paused = (view?.paused || []).map(e => ({ ...e, enPausa: true }));
  const vivos = [...running, ...paused];
  box.replaceChildren();
  box.dataset.hoyVivos = String(vivos.length);
  if (!vivos.length) {
    box.append(n('p', 'Sin trabajo en curso ahora mismo.', 'muted'));
    return;
  }
  /* (2.8.0 · diseño 1) Con MÁS de 3 trabajos, el panel nace
     RESUMIDO en una línea («9 trabajos · 9 solicitudes
     esperando al SAT») tras su botón de despliegue: la tarjeta
     protagonista de la pantalla vuelve al primer pantallazo y
     ningún trabajo se pierde — desplegar enseña todos, cada
     uno con su Detener. Con 3 o menos, las filas se ven como
     siempre. */
  if (vivos.length > 3 && !hoyActividadDesplegada240) {
    let resumenHoy280 = vivos.length + ' trabajos en curso';
    if (vivos.every(e => e.kind === 'masiva' &&
      (e.state === 'esperando' || /esperando al sat/i.test(e.phase || ''))))
      resumenHoy280 += ' · ' + vivos.length + ' solicitudes esperando al SAT';
    box.append(n('p', resumenHoy280, 'today-line'));
    const toggleResumen280 = n('button', 'Ver los ' + vivos.length + ' trabajos', 'soft small');
    toggleResumen280.type = 'button';
    toggleResumen280.dataset.actividadToggle240 = 'hoy';
    toggleResumen280.onclick = () => {
      hoyActividadDesplegada240 = true;
      pintarHoyVivo240(view, box);
    };
    box.append(toggleResumen280);
    return;
  }
  /* La explicación de detener una solicitud, UNA vez por
     tarjeta (corrección visual 2.4.0): sale de las entradas
     y vive aquí, pequeña, solo si hay alguna solicitud. */
  const guiaHoy240 = vivos.map(actividadGuia240).find(Boolean);
  if (guiaHoy240) box.append(n('p', guiaHoy240, 'muted small'));
  /* Despliegue progresivo: las primeras 3 entradas y, si hay
     más, el botón que las despliega dentro de la misma
     tarjeta — cada una con su Detener a un toque. */
  const visiblesHoy240 = hoyActividadDesplegada240 ? vivos : vivos.slice(0, 3);
  for (const entry of visiblesHoy240) {
    const fila = n('div', undefined, 'cp-row hoy-vivo240');
    const main = n('div', undefined, 'cp-main');
    main.append(n('strong', String(entry.label || 'Trabajo').replace(/\s+/g, ' ').trim()),
      n('span', hoyVivoTexto240(entry), 'muted'));
    fila.append(main);
    const acts = n('div', undefined, 'actions');
    if (typeof activityControlButton === 'function') {
      if (entry.canPause) acts.append(activityControlButton(entry, entry.enPausa ? 'Reanudar' : 'Pausar', entry.enPausa ? 'reanudar' : 'pausar'));
      else if (entry.canResume && entry.enPausa) acts.append(activityControlButton(entry, 'Reanudar', 'reanudar'));
      if (entry.canStop) acts.append(activityControlButton(entry, entry.stopLabel || 'Cancelar', 'detener'));
    }
    if (!acts.childNodes.length) {
      const ir = n('button', 'Ver el control', 'soft small');
      ir.type = 'button';
      ir.onclick = () => navigate('monitor');
      acts.append(ir);
    }
    /* Vigilancia diferida (2.4.0 · W6): si su parte aún no ha
       llegado, se pide AHORA y este mismo panel se repinta con
       el botón real en cuanto aterriza — el «Ver el control»
       de arriba es solo el mientras tanto, no el destino. */
    if (typeof activityControlButton !== 'function' && typeof ensureLazyPart === 'function')
      ensureLazyPart('monitor').then(ok => { if (ok && box.isConnected) pintarHoyVivo240(view, box); });
    fila.append(acts);
    box.append(fila);
  }
  if (vivos.length > 3) {
    const toggleHoy240 = n('button',
      hoyActividadDesplegada240 ? 'Ver menos' : 'Ver las ' + (vivos.length - 3) + ' restantes',
      'soft small');
    toggleHoy240.type = 'button';
