  const ordenadas = [...people].sort((a, b) => urgenciaRfc200b(b.id) - urgenciaRfc200b(a.id) || a.name.localeCompare(b.name, 'es-MX'));
  let visibles = 0;
  for (const persona of ordenadas) {
    if (needle && !(persona.name + ' ' + persona.id).toLocaleLowerCase('es-MX').includes(needle)) continue;
    visibles++;
