const MESES_MENU202 = ['ene', 'feb', 'mar', 'abr', 'may', 'jun', 'jul', 'ago', 'sep', 'oct', 'nov', 'dic'];
function fechaCortaMenu202(ms) {
  const d = new Date(Number(ms));
  if (!ms || Number.isNaN(d.getTime())) return '';
  return d.getDate() + ' ' + MESES_MENU202[d.getMonth()] +
    (d.getFullYear() !== new Date().getFullYear() ? ' ' + d.getFullYear() : '');
}
/* UNA sola fuente del estado del Buzón (2.9.0 · Bloque C):
   el estado guardado — última consulta con éxito y su
   resultado — leído igual por Hoy, por el menú y por el
   panel. Función pura sobre la vista (acepta la del resumen
