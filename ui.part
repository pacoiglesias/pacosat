  if (typeof paintActivity === 'function') { try { paintActivity(); } catch { /* la franja nunca tumba el pintado */ } }
}
/* Píldora de estado común (1.6.11): un solo lenguaje de semáforo en
   toda la app. ok = verde, warn = ámbar, bad = rojo, dim = gris (sin
   dato o en descanso: no es un problema). Pulsarla lleva a su pantalla. */
function statusPill(state, label, hint, onClick, asSpan232 = false) {
  /* Modo texto (2.3.2 · m-11): cuando la píldora va DENTRO de
     otro botón (las filas de «Tus empresas») o es un dato sin
     destino (un conteo), se pinta como <span>: un <button>
     dentro de un <button> es HTML inválido y su clic, ambiguo. */
  if (asSpan232) {
    const pill = n('span', undefined, 'status-pill');
    pill.dataset.state = state;
    pill.append(n('span', undefined, 'pill-dot'), n('span', label));
    if (hint) pill.title = hint;
    return pill;
  }
  const pill = n('button', undefined, 'status-pill');
  pill.type = 'button';
  pill.dataset.state = state;
  pill.append(n('span', undefined, 'pill-dot'), n('span', label));
  if (hint) pill.title = hint;
  if (onClick) pill.onclick = onClick;
  else {
    /* Sin gesto no es un botón (2.9.0 · Bloque C): una píldora
       de estado o de conteo es una ETIQUETA y se pinta como
       <span> con la misma ropa — la auditoría cazó decenas de
       «botones» deshabilitados que no hacían nada (estados,
       contadores, fechas) en todos los paneles. */
    const tag = n('span', undefined, 'status-pill etiqueta290');
    tag.dataset.state = state;
    tag.append(n('span', undefined, 'pill-dot'), n('span', label));
    if (hint) tag.title = hint;
    return tag;
  }
  return pill;
}
/* Etiqueta de estado (2.9.0 · Bloque C): el <span> de una
   píldora que no tiene gesto — para los sitios que componen
   la píldora a mano en vez de pasar por statusPill. */
function etiqueta290(state, label, hint) {
  const tag = n('span', undefined, 'status-pill etiqueta290');
  tag.dataset.state = state;
  tag.append(n('span', undefined, 'pill-dot'), n('span', label));
  if (hint) tag.title = hint;
  return tag;
}
/* ===== Gráficas aplicadas II (2.4.0 · W5b2) =====
   Piezas 1 (sparklines), 10 (estado de la portada de acceso),
   4b (esqueletos aplicados) y el helper de destello de W5a.
   Regla de la casa para todo lo de aquí: ninguna serie se
   inventa — la sparkline solo se pinta con la serie que la
   pantalla ya calcula, y sin serie no se pinta nada. */
/* Helper de contrato de W5a (pieza 3): pinta el texto nuevo y
   destella SOLO si el valor cambió de verdad; el primer
   pintado nunca destella. La clase .cifra-nueva y su apagado
   con reduced-motion viven en polish.part (W5a). */
function marcarCifra240(el, textoNuevo) {
  if (!el) return;
  const nuevo = String(textoNuevo);
  const habia = el.dataset.v240 !== undefined;
  if (habia && el.dataset.v240 === nuevo) return;
  el.dataset.v240 = nuevo;
  el.textContent = nuevo;
  if (!habia) return;
  el.classList.remove('cifra-nueva');
  void el.offsetWidth;
  el.classList.add('cifra-nueva');
  el.addEventListener('animationend', () => el.classList.remove('cifra-nueva'), { once: true });
}
/* Variante con memoria entre pintados (pieza 3 aplicada):
   las tarjetas protagonistas se RECREAN en cada refresco del
   pulso, así que el «valor anterior» no puede vivir solo en el
   nodo: vive en esta memoria por clave. Primer pintado de la
   clave: sin destello; cambio real: destello; mismo valor:
   no toca nada. */
const cifra240Memoria = new Map();
function marcarCifraPulso240(el, clave, textoNuevo) {
  if (!el) return;
  const nuevo = String(textoNuevo);
  const anterior = cifra240Memoria.get(clave);
  el.textContent = nuevo;
  if (anterior === undefined || anterior === nuevo) { cifra240Memoria.set(clave, nuevo); return; }
  cifra240Memoria.set(clave, nuevo);
  el.classList.remove('cifra-nueva');
  void el.offsetWidth;
  el.classList.add('cifra-nueva');
  el.addEventListener('animationend', () => el.classList.remove('cifra-nueva'), { once: true });
}
/* Serie de Hoy (pieza 1): lo cobrado por mes, de los CFDI que
   Hoy ya trae cargados (invoices), con la MISMA regla de la
   cascada de Dinero: una PUE entra cobrada en su mes de
   emisión y una PPD entra en el mes de la fechaPago de su
   complemento, por su impPagado — nunca dos veces. Solo los
   emitidos por el ámbito en pantalla (scope, o todos los RFC
   propios sin scope). Devuelve [{mes, cents}] ordenado por
   mes; vacío si no hay cobros que consten. */
function hoySerieCobrado240(mesesMax = 6) {
  const propios = new Set(scope ? [scope] : people.map(person => person.id));
  const porId = new Map();
  for (const row of invoices || []) if (row?.kind === 'I' && row.id) porId.set(row.id, row);
  const cancelada = row => typeof invoiceStateOf === 'function' && invoiceStateOf(row) === 'Cancelado';
  const porMes = new Map();
  const suma = (mes, cents) => { if (/^\d{4}-\d{2}$/.test(mes)) porMes.set(mes, (porMes.get(mes) || 0n) + cents); };
  for (const row of invoices || []) {
    if (!row) continue;
    if (row.kind === 'I') {
      if (row.fiscal?.paymentMethod !== 'PUE' || cancelada(row)) continue;
      if (!propios.has(row.from?.rfc)) continue;
      suma(String(row.date || '').slice(0, 7), totalCents(row));
    } else if (row.kind === 'P') {
      for (const pago of row.fiscal?.payments?.pagos || [])
        for (const doc of pago.documentos || []) {
          const factura = porId.get(doc.idDocumento);
          if (!factura || cancelada(factura) || factura.fiscal?.paymentMethod === 'PUE') continue;
          if (!propios.has(factura.from?.rfc)) continue;
          suma(String(pago.fechaPago || '').slice(0, 7), moneyCents(doc.impPagado));
        }
    }
  }
  return [...porMes.entries()].sort((a, b) => a[0].localeCompare(b[0]))
    .slice(-mesesMax).map(([mes, cents]) => ({ mes, cents }));
}
/* Puntos EXACTOS de la sparkline: escala lineal entre el
   mínimo y el máximo de la serie (si todos valen lo mismo, la
   línea va por el centro). Función pura: la suite la fija con
   una serie de juguete. */
function sparklinePuntos240(valores, ancho = 96, alto = 28, margen = 3) {
  const nums = (valores || []).map(v => Number(v)).filter(v => Number.isFinite(v));
  if (nums.length < 2) return [];
  const min = Math.min(...nums), max = Math.max(...nums), rango = max - min;
  const pasoX = (ancho - margen * 2) / (nums.length - 1);
  const yDe = v => rango === 0 ? alto / 2
    : margen + (1 - (v - min) / rango) * (alto - margen * 2);
  return nums.map((v, i) => [Math.round((margen + i * pasoX) * 10) / 10, Math.round(yDe(v) * 10) / 10]);
}
/* La sparkline pintada: SVG propio, sin ejes ni librerías —
   acompaña a la cifra, no la sustituye. Sin serie (menos de
   dos puntos) devuelve null y la tarjeta no la enseña. */
function sparkline240(valores, etiqueta) {
  const puntos = sparklinePuntos240(valores);
  if (puntos.length < 2) return null;
  const NS = 'http://www.w3.org/2000/svg';
  const svg = document.createElementNS(NS, 'svg');
  svg.setAttribute('viewBox', '0 0 96 28');
  svg.setAttribute('class', 'spark240');
  svg.setAttribute('role', 'img');
  if (etiqueta) svg.setAttribute('aria-label', etiqueta);
  const linea = document.createElementNS(NS, 'polyline');
  linea.setAttribute('points', puntos.map(p => p[0] + ',' + p[1]).join(' '));
  linea.setAttribute('class', 'spark240-linea');
  svg.append(linea);
  const ultimo = document.createElementNS(NS, 'circle');
  ultimo.setAttribute('cx', puntos[puntos.length - 1][0]);
  ultimo.setAttribute('cy', puntos[puntos.length - 1][1]);
  ultimo.setAttribute('r', '2.4');
  ultimo.setAttribute('class', 'spark240-punto');
  svg.append(ultimo);
  return svg;
}
/* El acompañamiento completo: la sparkline con su periodo
   NOMBRADO en palabra («últimos 6 meses»). Sin serie, null. */
function sparklineBloque240(serie, textoPeriodo, etiqueta) {
  const valores = (serie || []).map(punto => punto.cents !== undefined ? punto.cents : punto);
  const svg = sparkline240(valores, etiqueta);
  if (!svg) return null;
  const bloque = n('div', undefined, 'spark240-bloque');
  bloque.dataset.spark240 = '1';
  bloque.append(svg, n('span', textoPeriodo, 'spark240-periodo'));
  return bloque;
}
/* Esqueleto con la forma de la pantalla (pieza 4b): la
   silueta protagonista + filas de las formas de W5a. La
   región que lo contiene va aria-busy mientras espera. */
function esqueletoPantalla240(filas = 3) {
  const skel = n('div', undefined, 'esqueleto');
  skel.setAttribute('aria-hidden', 'true');
  skel.dataset.esqueleto240 = '1';
  skel.append(n('div', undefined, 'sk-hero'));
  for (let i = 0; i < filas; i++) skel.append(n('div', undefined, 'sk-fila'));
  return skel;
}
/* Estado de la portada de acceso (pieza 10): sale SOLO de la
   lectura sin sesión de /healthz (W2: {ok, version, db}).
   Función pura sobre esa respuesta: en línea solo si el
   servidor dice ok y su base responde; cualquier otra cosa
   —incluida la ausencia de lectura— es su contrario honesto,
   nunca un «en línea» fingido. */
function entradaEstado240(health) {
  if (health && health.ok === true && health.db === 'ok')
    return { estado: 'aldia', texto: 'Sistema en línea' + (health.version ? ' · PacoSAT ' + health.version : '') };
  if (health)
    return { estado: 'error', texto: 'Sistema sin respuesta de su base de datos: puedes intentar entrar, pero el trabajo del SAT puede fallar.' };
  return { estado: 'atencion', texto: 'No se pudo comprobar el estado del sistema antes de entrar.' };
}
/* La lectura de la portada: fetch directo a /healthz, SIN
   credenciales ni token (la ruta es pública a propósito).
   Devuelve la respuesta o null si no hubo lectura. */
async function entradaSalud240() {
  try {
    const respuesta = await fetch('/healthz', { headers: { Accept: 'application/json' } });
    if (!respuesta || typeof respuesta.json !== 'function') return null;
    return await respuesta.json();
  } catch { return null; }
}
/* Pantalla «Hoy en PacoSAT» (1.6.11): resumen del día, pendientes con
   semáforo y UN siguiente paso sugerido. El interruptor general de
   descanso vive aquí y en el Centro SAT (la misma pieza). */
/* Caché compartida del panel «Hoy» (1.11.0); la invalida el pulso
   cuando detecta cambios en el servidor. */
let todayCache = { at: 0, data: null };
/* V1 · Semáforo del día (1.31.0): UNA pastilla grande según el
   estado real — fallos del Registro en 24 h (satData.registroResumen
   si el servidor lo trae en el estado; si no, el resumen que Hoy
   ya pide a registro/resumen), los avisos que necesitan tu gesto
   y la puerta auto-probada. Lo que no conste no se afirma: la
   pastilla de orden solo sale cuando esos tres datos, los que
   hay, no traen nada en contra. */
function hoySemaforoPintar1310(avisos, registro) {
  const franja = document.querySelector('[data-semaforo1310]');
  if (!franja) return;
  const resumenSrv = typeof satData !== 'undefined' && satData ? satData.registroResumen : null;
  const fallos = Number(resumenSrv?.fallos ?? registro?.fallos ?? 0) || 0;
  const necesita = Number(avisos?.counts?.necesita ??
    (avisos?.avisos || []).filter(aviso => aviso.clase === 'necesita').length) || 0;
  const puerta = typeof satData !== 'undefined' && satData ? satData.puerta : null;
  const puertaNoAbre = puerta
    ? (scope ? Boolean(puerta[scope]?.probada && puerta[scope]?.ok === false)
      : Object.values(puerta).some(veredicto => veredicto?.probada && veredicto?.ok === false))
    : false;
  let pill;
  if (fallos > 0) pill = statusPill('bad', 'Algo falló',
    fallos + ' fallo(s) en las últimas 24 h, según el Registro', () => navigate('registro'));
  else if (necesita > 0 || puertaNoAbre) pill = statusPill('warn', 'Te toca algo',
    [necesita ? necesita + ' aviso(s) necesitan tu gesto' : '',
      puertaNoAbre ? (causaP200(scope ? puerta[scope] : null, satData.ejecutor).tipo === 'equipo'
        ? 'tu equipo no responde: la puerta se probará sola al volver' : 'la puerta del SAT consta que no abre') : '']
      .filter(Boolean).join(' · '),
    () => navigate('avisos'));
  else pill = statusPill('ok', 'Todo en orden',
    'Sin fallos en 24 h, sin avisos que te necesiten y sin puerta cerrada que conste');
  franja.replaceChildren(pill);
}
/* V4 · Semana fiscal (1.31.0): hoy y los seis días siguientes,
   con un punto en los días en que algo vence o se espera — la
   próxima notificación que se tiene por notificada (solo si el
   tributario la conoce; si no, ese marcador no se pinta), el
   día 17 como límite de la declaración mensual del mes en
   curso y los avisos con fecha que la lista de Hoy conozca.
   Cada día lleva su número y el punto lleva el título. */
function hoySemanaPintar1310(avisos) {
  const fila = document.querySelector('[data-semana1310]');
  if (!fila) return;
  const marcas = new Map();
  const marcar = (key, titulo) => {
    if (!key) return;
    if (!marcas.has(key)) marcas.set(key, []);
    marcas.get(key).push(titulo);
  };
  const claveDe = d => d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' +
    String(d.getDate()).padStart(2, '0');
  const tenida = typeof tribTenidaFor === 'function' ? tribTenidaFor(scope) : null;
  if (tenida?.tenida) marcar(String(tenida.tenida).slice(0, 10), 'Una notificación se tiene por notificada');
  const hoy = new Date();
  marcar(hoy.getFullYear() + '-' + String(hoy.getMonth() + 1).padStart(2, '0') + '-17',
    'Día 17: límite de la declaración mensual de este mes');
  for (const aviso of avisos?.avisos || []) {
    if (!aviso.vence) continue;
    const vence = new Date(aviso.vence);
    if (Number.isNaN(vence.getTime())) continue;
    marcar(claveDe(vence), aviso.titulo || 'Aviso con fecha');
  }
  fila.replaceChildren();
  const DIAS_CORTOS = ['dom', 'lun', 'mar', 'mié', 'jue', 'vie', 'sáb'];
  for (let i = 0; i < 7; i++) {
    const diaFecha = new Date(hoy.getFullYear(), hoy.getMonth(), hoy.getDate() + i);
    const titulos = marcas.get(claveDe(diaFecha));
    const dia = n('div', undefined, 'semana-dia');
    if (i === 0) dia.dataset.hoy = '1';
    dia.append(n('small', DIAS_CORTOS[diaFecha.getDay()]), n('strong', String(diaFecha.getDate())));
    if (titulos?.length) {
      dia.title = titulos.join(' · ');
      const punto = n('span', '', 'semana-punto');
      /* El punto de la semana como FORMA dibujada (2.4.0 · W5b2, pieza 9b): fuera el glifo de punto de texto. */
      punto.style.cssText = 'display:inline-block;width:8px;height:8px;border-radius:50%;background:currentColor';
      punto.title = titulos.join(' · ');
      dia.append(punto);
    }
    fila.append(dia);
  }
}
function todayPanel() {
  const wrap = panel();
  const head = n('div', undefined, 'panel-head');
  const titleBox = n('div');
  const nowDate = new Date();
  titleBox.append(n('h2', 'Hoy en PacoSAT'),
    n('p', nowDate.toLocaleDateString('es-MX', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' })));
  head.append(titleBox);
  if (typeof satToken !== 'undefined' && satToken && typeof restSwitch === 'function') head.append(restSwitch());
  wrap.append(head);
  /* V1+V4 (1.31.0): el semáforo del día y la franja de la semana
     fiscal abren la pantalla. Nacen VACÍOS a propósito: los pinta
     la parte asíncrona con los datos que Hoy ya carga (el resumen
     del Registro, los avisos y la puerta) — sin datos no se
     afirma ningún estado. */
  const semaforo1310 = n('div', undefined, 'traffic-strip');
  semaforo1310.dataset.semaforo1310 = '1';
  wrap.append(semaforo1310);
  const semana1310 = n('div', undefined, 'semana-fiscal');
  semana1310.dataset.semana1310 = '1';
  wrap.append(semana1310);
  const todayKey = nowDate.getFullYear() + '-' + String(nowDate.getMonth() + 1).padStart(2, '0') + '-' + String(nowDate.getDate()).padStart(2, '0');
  const todays = invoices.filter(row => row.date.startsWith(todayKey));
  let efos = 0, cancelled = 0;
  for (const row of invoices) {
    const state = invoiceStateOf(row);
    if (state === 'efos') efos++; else if (state === 'Cancelado') cancelled++;
  }
  const lineaHoy240 = n('p', '', 'today-line');
  marcarCifraPulso240(lineaHoy240, 'hoy-registrados', todays.length ?
    'Hoy se registraron ' + todays.length + (todays.length === 1 ? ' CFDI nuevo.' : ' CFDI nuevos.') :
    'Hoy todavía no se registran CFDI nuevos.');
  wrap.append(lineaHoy240);
  /* «Mientras no estabas» (1.25.0, mejora nº 9): hueco del
     resumen desde la última visita; lo rellena la parte asíncrona
     con el resumen del servidor y su botón de «visto». */
  const digestBox = n('div', undefined, 'mne-box');
  wrap.append(digestBox);
  let step = null;
  if (efos) step = ['Revisar los CFDI con 69-B', 'Un emisor en el listado 69-B puede poner en riesgo la deducción de esos comprobantes.', () => navigate('monitor')];
  else if (cancelled) step = ['Revisar los CFDI cancelados', 'Hay comprobantes cancelados en el SAT: conviene ver cuáles son y si afectan a pagos ya hechos.', () => navigate('monitor')];
  else if (typeof satData !== 'undefined' && satData && (satData.inbox || []).length) step = ['Importar los paquetes del SAT', 'Hay ' + satData.inbox.length + ' paquete(s) descargados esperando importación.', () => navigate('sat')];
  else if (!people.length) step = ['Agregar tu primer RFC', 'Sin contribuyentes no hay expediente: empieza registrando un RFC.', addPerson];
  else if (typeof satData !== 'undefined' && satData && (satData.profiles || []).some(row => !row.unlocked)) step = ['Autorizar la e.firma de los RFC pendientes', 'Sin e.firma activa no hay descarga automática para ese RFC.', () => navigate('sat')];
  /* UN siguiente paso protagonista (1.25.0, mejora nº 3): la
     caja es siempre la misma; lo local la pinta al instante y la
     parte asíncrona la SUSTITUYE si el servidor conoce algo más
     urgente (un crítico, un vencido, tu gesto CIEC en espera). */
  const stepBox = n('div', undefined, 'next-step');
  stepBox.dataset.protagonista = '1';
  if (step) stepBox.append(n('strong', 'Siguiente paso · ' + step[0]), n('p', step[1]), action('Hacerlo ahora', step[2], 'primary', 'arrow'));
  else stepBox.append(n('p', 'Todo en orden: no hay pendientes con semáforo. Buen día.'));
  wrap.append(stepBox);
  /* Sparkline de la protagonista de Hoy (2.4.0 · W5b2, pieza
     1): la tendencia de lo cobrado por mes, de la serie que
     Hoy ya trae (hoySerieCobrado240, la regla de la cascada).
     Acompaña al protagonista sin sustituir ninguna cifra; sin
     serie de al menos dos meses con cobro, no se pinta. */
  const sparkHoy240 = sparklineBloque240(hoySerieCobrado240(6),
    'Cobrado por mes · últimos 6 meses', 'Tendencia de lo cobrado por mes, últimos 6 meses');
  if (sparkHoy240) wrap.append(sparkHoy240);
  /* Transparencia (1.9.0): qué hizo el sistema, qué falta y qué
     vence — sin que Paco tenga que adivinarlo. Se rellena con los
     datos del servidor cuando está disponible. */
  const clarity = n('div', undefined, 'today-clarity');
  const colHizo = n('div', undefined, 'today-col today-col-hizo');
  colHizo.append(n('h3', 'Lo que el sistema ya hizo'));
  const colFalta = n('div', undefined, 'today-col today-col-falta');
  colFalta.append(n('h3', 'Lo que falta'));
  const colVence = n('div', undefined, 'today-col today-col-vence');
  colVence.append(n('h3', 'Lo que vence'));
  clarity.append(colHizo, colFalta, colVence);
  wrap.append(clarity);
  const line = (col, text, go) => {
    const row = n('p', text, 'today-line');
    if (go) { const btn = n('button', 'Ver', 'soft small'); btn.onclick = go; row.append(' ', btn); }
    col.append(row);
  };
  (async () => {
    try {
      if (typeof satToken === 'undefined' || !satToken) {
        line(colFalta, 'Abre PacoSAT desde el servidor de tu casa para ver aquí el trabajo del sistema, los pendientes y los vencimientos.');
        return;
      }
      /* Cesión (1.13.0): el panel aún no está insertado cuando
         todayPanel() corre; con la caché de 30 s caliente no había
         ninguna espera antes de pintar y las tres columnas se
         quedaban vacías al volver a Hoy. Se cede el turno y, si el
         panel cambió entre tanto, se pinta en las columnas vivas. */
      await Promise.resolve();
      /* Caché de 30 s en memoria (1.11.0): el panel «Hoy» consume
         lo que el pulso único ya trajo en vez de lanzar sus 4
         llamadas en cada pintado. */
      /* La caché compartida SOLO vale con su forma completa
         (1.31.1): el centro de mando la escribía con 4 datos y
         Hoy destructuraba 7 — digest, monthly y registro
         nacían undefined y «Desde que no estabas» no pintaba
         nunca si el mando pintaba primero. Los dos escritores
         llenan ya el mismo array de 7, y esta guarda rechaza
         cualquier forma corta que aparezca. */
      if (!todayCache.data || todayCache.data.length < 7 || Date.now() - todayCache.at > 30000) {
        todayCache = { at: Date.now(), data: await Promise.all([
          satApiLectura('notices').catch(() => null),
          satApiLectura('reconcile').catch(() => null),
          satApiLectura('reports/checklist?month=' + todayKey.slice(0, 7)).catch(() => null),
          satApiLectura('satdocs').catch(() => null),
          satApiLectura('monthly').catch(() => null),
          satApiLectura('activity/digest').catch(() => null),
          satApiLectura('registro/resumen').catch(() => null)]) };
      }
      const [avisos, reconcile, checklist, satdocs, monthly, digest, registro] = todayCache.data;
      /* El estado del ejecutor se lee UNA vez (1.29.1, D8): lo
         usan el protagonista, la línea de «Lo que falta» y la
         línea de la máquina — tres sitios, una sola lectura. */
      const ex = await satApiLectura('executor/overview').catch(() => null);
      /* V1+V4 (1.31.0): con los datos ya cargados, el semáforo y
         la semana se pintan en sus franjas vivas (estén en este
         panel o en su copia ya insertada en la página). */
      hoySemaforoPintar1310(avisos, registro);
      hoySemanaPintar1310(avisos);
      /* Tu lista de gestos (1.31.1): el gesto CIEC en espera
         solo consta con los datos del mes ya cargados. */
      if (typeof gestosPintarCiec1311 === 'function') gestosPintarCiec1311(monthly);
      /* Franjas vivas (1.31.1): el digest «Desde que no
         estabas» y el protagonista se pintan AQUÍ, junto al
         semáforo y la semana — en su nodo VIVO de la página, no
         tras la cesión de columnas: con varios pintados en
         carrera (arranque + cambio de RFC), el bloque viejo
         quedaba tras una salida temprana y la tarjeta no
         llegaba a la pantalla final aunque el servidor la
         hubiera calculado. Pintar en vivo es idempotente:
         replaceChildren, gana el último. */
      /* «Desde que no estabas» (1.25.0, mejora nº 9; completo
         en 1.31.1 con avisos cerrados y documentos recibidos):
         lo que el sistema hizo desde tu última marca de
         «visto». Si no cambió nada, la tarjeta no sale. */
      const digestVivo = document.querySelector('.mne-box');
      if (digestVivo && digest && (digest.eventos > 0 || digest.avisosNuevos > 0 ||
        digest.avisosCerrados > 0 || digest.documentosRecibidos > 0)) {
        const card = n('div', undefined, 'next-step');
        const partes = [];
        if (digest.cfdiNuevos) partes.push(digest.cfdiNuevos + ' CFDI nuevos');
        if (digest.avisosNuevos) partes.push(digest.avisosNuevos + ' aviso(s) nuevos' +
          (digest.criticos ? ' — ' + digest.criticos + ' crítico(s)' : ''));
        if (digest.avisosCerrados) partes.push(digest.avisosCerrados + ' aviso(s) cerrados');
        if (digest.documentosRecibidos) partes.push(digest.documentosRecibidos + ' documento(s) recibidos');
        for (const hecho of (digest.hechos || []).slice(0, 3)) partes.push(hecho.nombre + ' ×' + hecho.n);
        card.append(n('strong', 'Desde que no estabas'),
          n('p', partes.join(' · ') + '.'),
          action('Marcar como visto', async () => {
            try { await satApi('activity/seen', {}); } catch { /* la marca se reintenta al entrar */ }
            card.remove();
          }, 'soft'));
        digestVivo.replaceChildren(card);
      }
      /* El protagonista, por urgencia real (1.25.0, mejora nº 3):
         crítico > vencido > tu gesto CIEC en espera > portal
         cambiado > el por-confirmar más viejo. Sustituye a la
         sugerencia local si el servidor trae algo más urgente. */
      const pasoVivo = document.querySelector('[data-protagonista]');
      if (pasoVivo && avisos) {
        const abiertos = avisos.avisos || [];
        const critico = abiertos.find(item => item.clase === 'mal' && item.severidad === 'alta');
        const vencido = abiertos.filter(item => item.vence && item.vence < Date.now())
          .sort((a, b) => a.vence - b.vence)[0];
        const gesto = (monthly?.runs || []).some(run =>
          Object.values(run.perRfc || {}).some(entry => entry.status === 'esperando-gesto'));
        const portalCambio = typeof satData !== 'undefined' && satData?.portalSalud &&
          (satData.portalSalud.constancia?.cambio || satData.portalSalud.opinion?.cambio);
        const porConfirmar = abiertos.filter(item => item.estado === 'por-confirmar')
          .sort((a, b) => a.creado - b.creado)[0];
        let prota = null;
        if (critico) prota = ['Revisar un aviso crítico', critico.titulo + (critico.accion ? ' — ' + critico.accion + '.' : ''), () => navigate('avisos')];
        else if (vencido) prota = ['Resolver lo vencido', vencido.titulo + (vencido.accion ? ' — ' + vencido.accion + '.' : ''), () => navigate('avisos')];
        /* Trabajos esperando equipo (1.29.1, D8): con la cola
           parada por tu equipo, ESE es el siguiente paso — está
           por encima del gesto CIEC y del conteo de avisos,
           porque sin equipo en línea nada del SAT avanza. Su
           toque lleva al panel del ejecutor en Centro SAT. */
        else if (ex && ex.enCola > 0 && !ex.enLinea) {
          const emparejado = (ex.ejecutores || []).some(ej => !ej.revocado);
          prota = ['Tus trabajos del SAT esperan tu equipo',
            ex.enCola + (ex.enCola === 1 ? ' trabajo quedó en cola' : ' trabajos quedaron en cola') +
            (emparejado ? ': tu equipo no responde — ábrelo en tu PC y los recogerá solo.'
              : ': todavía no has emparejado ningún equipo — empareja tu PC y saldrán solos.'),
            () => { satTab = 'ejecutor'; navigate('sat'); }];
        }
        else if (gesto) prota = ['Dar tu gesto para la descarga CIEC', 'La corrida mensual quedó esperando tu captcha: el mes se baja desde su tarjeta en «Descargar del SAT» y la corrida retoma su sitio sola.', () => navigate('sat')];
        else if (portalCambio) prota = ['El portal del SAT cambió', 'La sonda lo detectó antes de la corrida: nada que hacer por tu parte; la próxima descarga entra avisada.', () => navigate('avisos')];
        else if (porConfirmar) prota = ['Confirmar un pago', porConfirmar.titulo + (porConfirmar.accion ? ' — ' + porConfirmar.accion + '.' : ''), () => navigate('avisos')];
        /* Hoy veraz (1.28.0, P4): si el servidor cuenta avisos
           abiertos y ninguno de los casos urgentes aplica, el
           protagonista es ese conteo — Hoy NUNCA dice «Todo en
           orden» con avisos abiertos. El protagonista nace del
           conteo del servidor, no de la foto local. */
        else if (avisos.counts?.total > 0) {
          const primero = abiertos[0];
          prota = ['Revisar tus avisos abiertos',
            avisos.counts.total + (avisos.counts.total === 1 ? ' aviso abierto' : ' avisos abiertos') +
            (primero ? ': el primero es «' + primero.titulo + '»' : '') + '.',
            () => navigate('avisos')];
        }
        if (prota) pasoVivo.replaceChildren(n('strong', 'Siguiente paso · ' + prota[0]),
          n('p', prota[1]), action('Hacerlo ahora', prota[2], 'primary', 'arrow'));
      }
      let cHizo = colHizo, cFalta = colFalta, cVence = colVence;
      if (!wrap.isConnected) {
        const vivas = document.querySelectorAll('.today-clarity .today-col');
        if (vivas.length === 3) { cHizo = vivas[0]; cFalta = vivas[1]; cVence = vivas[2]; }
        else return;
      }
      /* Lo que hizo: historial del Centro y conciliaciones vivas. */
      const resueltos = (avisos?.historial || []).filter(item => item.resuelto && String(item.resuelto).startsWith(todayKey));
      line(cHizo, resueltos.length
        ? 'Hoy se solventaron ' + resueltos.length + ' aviso(s): ' + resueltos.slice(0, 2).map(item => item.titulo).join('; ') + (resueltos.length > 2 ? '…' : '') + '.'
        : 'Hoy no se ha cerrado ningún aviso todavía.', () => navigate('avisos'));
      /* Sin ruido (1.28.0, P5): la línea de conciliaciones solo
         existe cuando hay alguna que contar. */
      if (reconcile?.confirmed.length) line(cHizo, 'Conciliaciones confirmadas y vigentes: ' + reconcile.confirmed.length + '.', () => navigate('dinero'));
      const informes = (avisos?.historial || []).filter(item => item.kind === 'informe').length;
      if (informes) line(cHizo, 'Informes mensuales enviados en el historial: ' + informes + '.');
      if (!resueltos.length && !reconcile?.confirmed.length) line(cHizo, 'Sin actividad registrada hoy: el sistema vigila en silencio.');
      /* Lo que falta: avisos abiertos y pasos del cierre en rojo/ámbar.
         Sin enumeraciones vacías (2.0, M9 / 3.2): la fila NOMBRA
         los avisos (títulos cortos) o no lleva dos puntos — nunca
         un «: .» tras un conteo de clases que puede venir vacío. */
      if (avisos?.counts?.total) {
        const nAv = avisos.counts.total;
        const tf200 = (avisos.avisos || []).map(a => a.titulo).filter(Boolean).slice(0, 3);
        /* Destino exacto (2.0 · O5): el «Ver» aterriza en la
           tarjeta del primer aviso abierto, no en la pantalla
           genérica; sin id, cae a la pantalla como siempre. */
        const primerAvisoId = (avisos.avisos || [])[0]?.id;
        line(cFalta, nAv + ' aviso(s) abiertos' +
          (tf200.length ? ': ' + tf200.join('; ') + (nAv > tf200.length ? '…' : '') : '') + '.',
          () => irDestino200b('avisos', primerAvisoId != null ? 'aviso-' + primerAvisoId : ''));
      }
      else line(cFalta, 'Sin avisos abiertos: nada esperando por ti en el Centro.');
      /* Sin vías (1.29.2): con avisos abiertos y ninguna vía
         fuera de la app conectada, Hoy lo dice con su gesto —
         una alerta que nace y no llega a ninguna parte es un
         silencio, y el silencio está prohibido. */
      if (avisos?.counts?.total && avisos.canales && !avisos.canales.correo && !avisos.canales.push)
        line(cFalta, 'Tus alertas no te llegan fuera de la app: activa el correo o el push para que te avisen al nacer.', () => navigate('settings'));
      /* Buzón: UNA sola fila con estado compuesto (2.0, M9 /
         3.4) — lo sin leer de Recibidos y lo sin abrir del
         Buzón Tributario del SAT en la misma línea, con su
         gesto único (consultar el Tributario). Antes eran dos
         filas que se pisaban («Buzón: 5 sin leer» y «Buzón
         Tributario: sin consultar todavía»). */
      const buzonN = typeof buzonUnreadFor === 'function' ? buzonUnreadFor(scope) : 0;
      const tribN = typeof tribSinAbrirFor === 'function' ? tribSinAbrirFor(scope) : 0;
      const tribConsultado = typeof tribConsultadoFor === 'function' ? tribConsultadoFor(scope) : false;
      const tribTenida = typeof tribTenidaFor === 'function' ? tribTenidaFor(scope) : null;
      const btSat = ' · Buzón Tributario del SAT: ';
      line(cFalta, 'Buzón: ' + number.format(buzonN) + ' sin leer' +
        (tribConsultado
          ? btSat + number.format(tribN) + ' sin abrir' + (tribN
            ? (tribTenida ? ' — la más antigua se tiene por notificada el ' + declFechaLarga(tribTenida.tenida) + ' aunque nadie la abra.' : '.')
            : ': todo abierto.')
          : btSat + 'sin consultar todavía: consúltalo para saber si el SAT te dejó algo.'),
        () => irDestino200b('tributario', 'buzon'));
      if (typeof paintBuzonBadge === 'function') paintBuzonBadge();
      if (typeof paintTribBadge === 'function') paintTribBadge();
      /* Ejecutor local (1.29.1, D8): su cola es un «lo que falta»
         más, con su toque al panel — no una frase escondida en la
         línea de la máquina. */
      if (ex && ex.enCola > 0) line(cFalta, 'Ejecutor local: ' + ex.enCola +
        (ex.enCola === 1 ? ' trabajo' : ' trabajos') +
        (ex.enLinea ? ' en cola; tu equipo está en línea y los está recogiendo.'
          : ' esperando tu equipo: sin él en línea, no salen.'),
        () => { satTab = 'ejecutor'; irDestino200b('sat', 'ejecutor'); });
      if (checklist) {
        const pending = checklist.items.filter(item => item.level !== 'ok');
        line(cFalta, pending.length
          ? 'Cierre de ' + checklist.month + ': faltan ' + pending.map(item => item.label.toLocaleLowerCase('es-MX')).join(', ') + '.'
          : 'Cierre de ' + checklist.month + ': los 10 pasos están en verde.', () => navigate('salidas'));
      }
      /* Lo que vence: avisos con fecha y documentos por caducar. */
      const upcoming = (avisos?.avisos || []).filter(item => item.vence)
        .sort((a, b) => String(a.vence).localeCompare(String(b.vence))).slice(0, 3);
      for (const item of upcoming)
        line(cVence, item.titulo + ' — vence el ' + new Date(item.vence).toLocaleDateString('es-MX', { day: 'numeric', month: 'short' }) +
          (item.responsable ? ' (lo resuelve ' + item.responsable + ')' : '') + '.',
          () => irDestino200b('avisos', item.id != null ? 'aviso-' + item.id : ''));
      for (const profile of satdocs?.profiles || []) {
        for (const [doc, label] of [[profile.constancia, 'Constancia'], [profile.opinion, 'Opinión']])
          if (doc && doc.level !== 'ok') line(cVence, label + ' de ' + profile.rfc + ': lleva ' + doc.ageDays +
            ' días; toca renovarla.', () => irDestino200b('sat', label === 'Constancia' ? 'constancia' : 'opinion'));
      }
      if (!upcoming.length) line(cVence, 'Sin vencimientos a la vista en los avisos.');
      /* La línea del Registro (1.28.0, P1): qué hizo el sistema en
         24 h y, si algo falló, qué fue — un toque a la bitácora. */
      if (registro) line(cHizo, 'Registro (24 h): ' + registro.conexiones + ' conexión(es) · ' + registro.acciones + ' acción(es)' +
        (registro.fallos ? ' · ' + registro.fallos + ' fallo(s)' + (registro.ultimoFallo
          ? ' — el último: ' + String(registro.ultimoFallo.texto).slice(0, 110) : '') : ' · sin fallos') + '.',
        () => navigate('registro'));
    } catch { /* la transparencia es un extra: nunca rompe el Resumen */ }
  })();
  return wrap;
}
/* ===== Hoy 2.4.0 · WC4b1 — castigos 6, 18, 30 y 22 =====
   Cuatro piezas nuevas de Hoy, pintadas SOLO con datos que
   Hoy ya recibe o que el estado global (satData) ya trae:
   · (6) «Qué falta para cerrar el mes», por RFC: descargas
     (de las facturas que el cliente ya tiene cargadas),
     PPD sin REP (el MISMO predicado de la tarjeta de
     Facturas, facturasRapidoCoincide240, con su paidByMap
     calculado una vez) y listas (la misma lectura satApi
     ('lists') que el mando de Hoy ya hace, resumida por
     listsResumen201). BANCOS: desde la micro-pieza de WPWA
     (2.4.0) el estado global SÍ trae el conteo por RFC
     (bancosSinConciliar240, del cálculo de conciliación de
     Bancos en el servidor): con el campo, la fila enseña
     «Bancos: N movimientos sin conciliar» y entra en el
     veredicto; sin el campo, la fila conserva su texto
     honesto («se ve en Bancos»), enlaza a Bancos y NO entra
     en el veredicto — ni suma ni resta: no se inventa el dato.
   · (18) «Vencimientos»: la e.firma se lee del perfil del
     estado global (certExpires, el mismo dato de la línea
     de Contribuyentes — jamás una fecha escrita a mano);
     la Constancia, de la lectura satdocs que Hoy ya consume
     (su perfil trae issuedAt y ageDays). EL CSD NO CONSTA
     en ningún dato del perfil ni del sistema: su fila dice
     «no consta» y lleva al Calendario fiscal, donde la casa
     SÍ tiene dónde registrar un vencimiento a mano. La tira
     fiscal del mes (hoyFiscalTira201) NO se toca: enseña las
     obligaciones del mes, no las vigencias de certificados
     y documentos — esta tarjeta no la duplica.
   · (30) «Qué cambió en esta versión»: el panel lee del
     bloque de novedades de la casa, NOVEDADES_1311 (en
     final-ui.part), y solo se pinta si ese bloque es el de
     la versión que corre el artefacto (PACOSAT_META) — el
     mecanismo es este; al sellar la 2.4.0, el coordinador
     actualiza NOVEDADES_1311 (version + puntos) y el panel
     enseñará la lista llana de la 2.4.0 sin tocar este código.
   · (22) Atajos de teclado: «?» abre la tarjeta, h/f/d/o
     navegan, b enfoca el buscador, Esc cierra paneles. Los
     atajos de siempre se conservan y se listan (Ctrl+K del
     buscador, en workflows.part; Esc de los menús de
     tarjeta, arriba en este mismo archivo). Ningún atajo se
     dispara mientras se escribe en un campo. */
/* Fila clicable de las tarjetas de WC4b1: etiqueta con su
   estado (icono y palabra, vía statusPill en modo texto) y
   su dato; pintar() la repinta cuando llega su dato vivo. */
function hoyFila240(etiqueta, nivel, pillTexto, detalle, ir) {
  const fila = n('button', undefined, 'foto-rfc-fila230');
  fila.type = 'button';
  const txt = n('span', undefined, 'foto-rfc-txt230');
  const linea = n('span', undefined, 'foto-rfc-semaforos230');
  const pintar = (nivel2, pill2, detalle2) => {
    linea.replaceChildren(statusPill(nivel2, pill2, undefined, undefined, true),
      n('span', detalle2));
  };
  pintar(nivel, pillTexto, detalle);
  txt.append(n('strong', etiqueta), linea);
  fila.append(txt);
  fila.onclick = ir;
  return { fila, pintar };
}
function cierreRfcs240() {
  const lista = people.length ? people.map(p => ({ rfc: p.id, nombre: p.name }))
    : (typeof satData !== 'undefined' && satData ? (satData.profiles || []).map(p => ({ rfc: p.rfc, nombre: p.rfc })) : []);
  return scope ? lista.filter(x => x.rfc === scope) : lista;
}
const cierreMesTexto240 = mesKey => /^\d{4}-\d{2}$/.test(mesKey || '')
  ? MESES_TOT[Number(mesKey.slice(5, 7)) - 1] + ' de ' + mesKey.slice(0, 4) : '';
/* Los datos del cierre de UN RFC, de lo que Hoy ya tiene:
   descargas = el último mes con facturas de ese RFC entre
   las cargadas (al día si cubre el mes pasado completo, el
   último mes cerrado); PPD sin REP = el predicado único de
   Facturas sobre sus filas. Sin facturas, ppd puede salir
   null si el cálculo no es alcanzable: la fila lo dice. */
function cierreDatos240(rfc, ahora = Date.now(), paidBy = null) {
  const filas = invoices.filter(row => row.from.rfc === rfc || row.to.rfc === rfc);
  const meses = filas.map(row => String(row.date || '').slice(0, 7))
    .filter(m => /^\d{4}-\d{2}$/.test(m)).sort();
  const ultimoMes = meses.length ? meses[meses.length - 1] : '';
  const d = new Date(ahora);
  const prev = new Date(d.getFullYear(), d.getMonth() - 1, 1);
  const mesPrevio = prev.getFullYear() + '-' + String(prev.getMonth() + 1).padStart(2, '0');
  let ppd = null;
  try {
    const mapa = paidBy || paidByMap();
    ppd = filas.filter(row => facturasRapidoCoincide240(row, 'ppd-sin-rep', mapa, ahora)).length;
  } catch { ppd = null; }
  /* Bancos (2.4.0 · WPWA, micro-dato): el conteo de
     movimientos sin conciliar de ESTE RFC viaja en el estado
     global (satData.bancosSinConciliar240, del MISMO cálculo
     de conciliación de Bancos en el servidor). Si el campo
     no viaja o el RFC no consta en el mapa, queda null y la
     fila conserva su texto honesto de siempre («se ve en
     Bancos») sin entrar en el veredicto. */
  let bancosSin = null;
  try {
    const mapaBancos = (typeof satData !== 'undefined' && satData) ? satData.bancosSinConciliar240 : null;
    if (mapaBancos && typeof mapaBancos === 'object' && mapaBancos[rfc] !== undefined)
      bancosSin = Number(mapaBancos[rfc]) || 0;
  } catch { bancosSin = null; }
  return { rfc, ultimoMes, mesPrevio, alDia: Boolean(ultimoMes) && ultimoMes >= mesPrevio, ppd, bancosSin };
}
function cierreFaltas240(datos, listas) {
  const faltas = [];
  if (!datos.ultimoMes) faltas.push('las descargas (sin facturas registradas todavía)');
  else if (!datos.alDia) faltas.push('las descargas (último mes cubierto: ' + cierreMesTexto240(datos.ultimoMes) + ')');
  if (datos.bancosSin !== null && datos.bancosSin !== undefined && datos.bancosSin > 0)
    faltas.push(datos.bancosSin + (datos.bancosSin === 1 ? ' movimiento sin conciliar en Bancos' : ' movimientos sin conciliar en Bancos'));
  if (datos.ppd !== null && datos.ppd > 0)
    faltas.push(datos.ppd + (datos.ppd === 1 ? ' factura PPD sin REP' : ' facturas PPD sin REP'));
  if (listas && !listas.ultima) faltas.push('la comprobación de las listas negras');
  return faltas;
}
function cierreVeredicto240(nombre, datos, listas) {
  const faltas = cierreFaltas240(datos, listas);
  return faltas.length ? nombre + ': falta ' + faltas.join(', ') + '.'
    : nombre + ': todo listo para cerrar el mes.';
}
/* (2.8.0 · diseño 15) La línea-resumen del cierre en Hoy:
   «Te faltan 3 cosas para cerrar noviembre» — el conteo sale
   del MISMO cálculo que la checklist dueña (cierreDatos240 +
   cierreFaltas240) y la línea entera enlaza a Cierre y
   reportes, donde vive el desglose. Hoy resume; Cierre
   trabaja: el mismo desglose ya no se pinta en dos sitios. */
function cierreResumen280() {
  const wrap = panel('Cierre del mes');
  wrap.dataset.cierreResumen280 = '1';
  const rfcs = cierreRfcs240();
  if (!rfcs.length) {
    wrap.append(n('p', 'Sin contribuyentes todavía: agrega un RFC y esta línea dirá qué le falta para cerrar el mes.', 'empty'));
    return wrap;
  }
  const paidBy = paidByMap();
  const mesActual = cierreMesTexto240(new Date().toISOString().slice(0, 7));
  for (const { rfc, nombre } of rfcs) {
    const datos = cierreDatos240(rfc, Date.now(), paidBy);
    const faltas = cierreFaltas240(datos, null);
    const fila = n('button', undefined, 'cp-row cierre-resumen280');
    fila.type = 'button';
    fila.dataset.cierreResumenRfc280 = rfc;
    const texto = faltas.length
      ? (rfcs.length > 1 ? nombre + ': ' : '') + 'Te faltan ' + faltas.length + (faltas.length === 1 ? ' cosa' : ' cosas') + ' para cerrar ' + mesActual
      : (rfcs.length > 1 ? nombre + ': ' : '') + 'Todo listo para cerrar ' + mesActual;
    fila.append(n('span', texto), n('span', 'Ver el cierre', 'muted'));
    fila.onclick = () => navigate('salidas');
    wrap.append(fila);
  }
  return wrap;
}
/* (6) La tarjeta del cierre: veredicto primero por RFC y
   una fila clicable por componente, a su pantalla dueña.
   (2.8.0 · diseño 15: en Hoy la sustituye la línea-resumen de
   arriba; el desglose completo vive en Cierre y reportes.) */
function cierreMesPanel240() {
  const wrap = panel('Qué falta para cerrar el mes');
  wrap.dataset.cierre240 = '1';
  const rfcs = cierreRfcs240();
  if (!rfcs.length) {
    wrap.append(n('p', 'Sin contribuyentes todavía: agrega un RFC y esta tarjeta dirá qué le falta para cerrar el mes.', 'empty'));
    return wrap;
  }
  const paidBy = paidByMap();
  const bloques = [];
  for (const { rfc, nombre } of rfcs) {
    const datos = cierreDatos240(rfc, Date.now(), paidBy);
    const bloque = n('div');
    bloque.dataset.cierreRfc240 = rfc;
    bloque.append(n('strong', nombre + (nombre !== rfc ? ' · ' + rfc : '')));
    const veredicto = n('p', cierreVeredicto240(nombre, datos, null), 'today-line');
    veredicto.dataset.cierreVeredicto240 = rfc;
    bloque.append(veredicto);
    const filaDesc = hoyFila240('Descargas al día',
      datos.alDia ? 'ok' : 'warn', datos.alDia ? 'Al día' : 'Falta',
      datos.ultimoMes ? 'Último mes cubierto: ' + cierreMesTexto240(datos.ultimoMes) + '.'
        : 'Sin facturas registradas todavía.',
      () => navigate('descargar'));
    /* La fila de Bancos (2.4.0 · WPWA): con el conteo servido
       (datos.bancosSin, del estado global) enseña «Bancos: N
       movimientos sin conciliar» y entra en el veredicto vía
       cierreFaltas240, como las demás filas; sin el campo,
       conserva el texto honesto de WC4b1 y no entra. */
    const filaBancos = (datos.bancosSin === null || datos.bancosSin === undefined)
      ? hoyFila240('Bancos conciliados', 'dim', 'Se ve en Bancos',
        'Su conciliación se ve en Bancos: ese dato no viaja a Hoy.',
        () => navigate('bancos'))
      : hoyFila240('Bancos conciliados',
        datos.bancosSin ? 'warn' : 'ok', datos.bancosSin ? 'Faltan ' + datos.bancosSin : 'Conciliado',
        datos.bancosSin ? 'Bancos: ' + datos.bancosSin +
          (datos.bancosSin === 1 ? ' movimiento sin conciliar.' : ' movimientos sin conciliar.')
          : 'Bancos: sin movimientos sin conciliar.',
        () => navigate('bancos'));
    filaBancos.fila.dataset.cierreBancos240 = rfc;
    const filaRep = hoyFila240('REP completos',
      datos.ppd === null ? 'dim' : datos.ppd ? 'warn' : 'ok',
      datos.ppd === null ? 'Se ve en Facturas' : datos.ppd ? 'Faltan ' + datos.ppd : 'Completo',
      datos.ppd === null ? 'El conteo de PPD sin REP se ve en Facturas.'
        : datos.ppd ? datos.ppd + (datos.ppd === 1 ? ' factura PPD' : ' facturas PPD') +
          ' sin su complemento de pago (REP): el mismo conteo de la tarjeta de Facturas.'
        : 'Sin facturas PPD pendientes de su complemento de pago (REP).',
      () => navigate('invoices'));
    const filaListas = hoyFila240('Listas revisadas', 'dim', 'Leyendo…',
      'Leyendo su última comprobación…', () => navigate('lists'));
    filaListas.fila.dataset.cierreListas240 = rfc;
    bloque.append(filaDesc.fila, filaBancos.fila, filaRep.fila, filaListas.fila);
    bloques.push({ rfc, nombre, datos, veredicto, filaListas });
    wrap.append(bloque);
  }
  /* Las listas se comprueban en conjunto (no por RFC): la
     fecha es la de la última comprobación de los listados,
     la misma que enseña la línea de estado del mando. */
  if (typeof satToken !== 'undefined' && satToken && typeof listsResumen201 === 'function') {
    satApi('lists').then(data => {
      if (wrap.isConnected === false) return;
      const r = listsResumen201(data);
      for (const b of bloques) {
        if (r.ultima) b.filaListas.pintar('ok', 'Revisadas', 'Última comprobación el ' + fmtFechaHora(r.ultima) + '.');
        else b.filaListas.pintar('warn', 'Sin comprobar', 'Todavía no se han comprobado.');
        b.veredicto.textContent = cierreVeredicto240(b.nombre, b.datos, r);
      }
    }).catch(() => {
      for (const b of bloques) b.filaListas.pintar('dim', 'Se ve en Listas negras',
        'Su última comprobación se ve en Listas negras.');
    });
  } else {
    for (const b of bloques) b.filaListas.pintar('dim', 'Se ve en Listas negras',
      'Su última comprobación se ve en Listas negras.');
  }
  return wrap;
}
/* (18) Días que quedan hasta una fecha (ms): el mismo
   redondeo de la casa para la e.firma (Math.ceil sobre el
   día). Semáforo: verde >90, ámbar 30–90, rojo <30 o ya
   vencido. */
function vencDias240(hasta, ahora = Date.now()) {
  const t = Number(hasta);
  if (!Number.isFinite(t) || !t) return null;
  return Math.ceil((t - ahora) / 86400000);
}
function vencNivel240(dias) {
  if (dias === null || dias === undefined) return 'dim';
  return dias > 90 ? 'ok' : dias >= 30 ? 'warn' : 'bad';
}
/* Los tres vencimientos de un RFC desde los datos que
   constan: perfil = su fila del estado global (certExpires
   y, si algún día viajara, su CSD); satdoc = su perfil de
   la lectura satdocs (constancia), o undefined si aún no
   se ha leído y null si se leyó y no consta. */
function vencDatos240(perfil, satdoc, ahora = Date.now()) {
  const salida = [];
  const cert = Number(perfil?.certExpires) || null;
  if (cert) {
    const dias = vencDias240(cert, ahora);
    salida.push({ clave: 'efirma', etiqueta: 'e.firma', nivel: vencNivel240(dias),
      pill: dias < 0 ? 'Vencida' : 'Quedan ' + dias + (dias === 1 ? ' día' : ' días'),
      detalle: dias < 0 ? 'Venció el ' + fmtFechaCorta(cert) + '.'
        : 'Vence el ' + fmtFechaCorta(cert) + '.' });
  } else salida.push({ clave: 'efirma', etiqueta: 'e.firma', nivel: 'dim', pill: 'No consta',
    detalle: 'Su caducidad no consta: se registra al desbloquear la e.firma en PacoSAT.' });
  const csdCrudo = perfil?.csdExpires ?? perfil?.csdVigencia ?? satdoc?.csdExpires ?? satdoc?.csdVigencia ?? null;
  const csd = csdCrudo === null ? null : (Number(csdCrudo) || Date.parse(csdCrudo) || null);
  if (csd) {
    const dias = vencDias240(csd, ahora);
    salida.push({ clave: 'csd', etiqueta: 'CSD', nivel: vencNivel240(dias),
      pill: dias < 0 ? 'Vencido' : 'Quedan ' + dias + (dias === 1 ? ' día' : ' días'),
      detalle: dias < 0 ? 'Venció el ' + fmtFechaCorta(csd) + '.'
        : 'Vence el ' + fmtFechaCorta(csd) + '.' });
  } else salida.push({ clave: 'csd', etiqueta: 'CSD', nivel: 'dim', pill: 'No consta',
    detalle: 'Su vigencia no consta en ningún dato de PacoSAT: regístrala como vencimiento en el Calendario fiscal.' });
  const doc = satdoc ? satdoc.constancia : undefined;
  if (satdoc === undefined) salida.push({ clave: 'constancia', etiqueta: 'Constancia', nivel: 'dim',
    pill: 'Leyendo…', detalle: 'Leyendo la fecha de tu copia archivada…' });
  else if (doc) {
    const edad = Number.isFinite(Number(doc.ageDays)) && doc.ageDays !== null && doc.ageDays !== undefined
      ? Number(doc.ageDays) : Math.max(0, Math.floor((ahora - Number(doc.issuedAt)) / 86400000));
    salida.push({ clave: 'constancia', etiqueta: 'Constancia',
      nivel: doc.level === 'ok' ? 'ok' : doc.level === 'warn' ? 'warn' : doc.level ? 'bad'
        : edad <= 30 ? 'ok' : edad <= 90 ? 'warn' : 'bad',
      pill: edad === 0 ? 'De hoy' : 'Hace ' + edad + (edad === 1 ? ' día' : ' días'),
      detalle: 'Archivada el ' + fmtFechaCorta(doc.issuedAt) + ' · hace ' + edad +
        (edad === 1 ? ' día.' : ' días.') });
  } else salida.push({ clave: 'constancia', etiqueta: 'Constancia', nivel: 'warn', pill: 'Sin archivar',
    detalle: 'Todavía no hay una constancia archivada de este RFC.' });
  return salida;
}
function vencPanel240() {
  const rfcs = cierreRfcs240();
  if (!rfcs.length) return null;
  const wrap = panel('Vencimientos');
  wrap.dataset.venc240 = '1';
  const sd = typeof satData !== 'undefined' && satData ? satData : null;
  const destinos = {
    efirma: () => { ajustesSection = 'contribuyentes'; navigate('settings'); },
    csd: item => item && item.pill === 'No consta' ? navigate('cumplimiento') : navigate('docs'),
    constancia: () => navigate('docs')
  };
  const bloques = [];
  for (const { rfc, nombre } of rfcs) {
    const perfil = (sd?.profiles || []).find(p => p.rfc === rfc) || null;
    const bloque = n('div');
    bloque.dataset.vencRfc240 = rfc;
    bloque.append(n('strong', nombre + (nombre !== rfc ? ' · ' + rfc : '')));
    const filas = {};
    for (const item of vencDatos240(perfil, undefined)) {
      const fila = hoyFila240(item.etiqueta, item.nivel, item.pill, item.detalle,
        () => destinos[item.clave](item));
      fila.fila.dataset.vencFila240 = item.clave;
      filas[item.clave] = { fila, item };
      bloque.append(fila.fila);
    }
    bloques.push({ rfc, perfil, filas });
    wrap.append(bloque);
  }
  /* La Constancia llega con la lectura satdocs — la misma
     que Hoy ya consume para sus vencimientos —; si falla,
     su fila lo dice y enlaza a Documentos. */
  if (typeof satToken !== 'undefined' && satToken) {
    satApi('satdocs').then(data => {
      if (wrap.isConnected === false) return;
      const perfiles = new Map((data?.profiles || []).map(p => [p.rfc, p]));
      for (const b of bloques) {
        const item = vencDatos240(b.perfil, perfiles.get(b.rfc) || null)
          .find(x => x.clave === 'constancia');
        b.filas.constancia.fila.pintar(item.nivel, item.pill, item.detalle);
      }
    }).catch(() => {
      for (const b of bloques) b.filas.constancia.fila.pintar('dim', 'Se ve en Documentos',
        'La fecha de tu copia archivada se ve en Documentos.');
    });
  } else {
    for (const b of bloques) b.filas.constancia.fila.pintar('dim', 'Se ve en Documentos',
      'La fecha de tu copia archivada se ve en Documentos.');
  }
  return wrap;
}
/* (30) El bloque de novedades DE LA VERSIÓN EN CURSO: el
   mecanismo lee NOVEDADES_1311 y solo enseña si es el de
   la versión del artefacto — nunca una nota vieja. */
function versionDatos240() {
  const bloque = typeof NOVEDADES_1311 !== 'undefined' ? NOVEDADES_1311 : null;
  const version = typeof PACOSAT_META !== 'undefined' ? PACOSAT_META.version : '';
  if (!bloque || !version || bloque.version !== version || !Array.isArray(bloque.puntos)) return null;
  return { version, puntos: bloque.puntos };
}
function versionPanel240() {
  const datos = versionDatos240();
  if (!datos) return null;
  const wrap = panel('Qué cambió en esta versión');
  wrap.dataset.version240 = datos.version;
  wrap.append(n('p', 'PacoSAT ' + datos.version + ', en palabras llanas: lo nuevo y lo mejorado de esta versión.'));
  const lista = n('ul', undefined, 'novedades-list');
  for (const punto of datos.puntos) lista.append(n('li', punto));
  wrap.append(lista);
  return wrap;
}
/* (22) Atajos de teclado: la lista REAL — los nuevos de
   esta pieza y los de siempre (Ctrl+K enfoca el buscador,
   Esc ya cerraba los menús de tarjeta). */
const ATAJOS240 = [
  { tecla: '?', texto: 'Abrir la tarjeta de atajos de teclado' },
  { tecla: 'h', texto: 'Ir a Hoy' },
  { tecla: 'f', texto: 'Ir a Facturas' },
  { tecla: 'd', texto: 'Ir a Dinero' },
  { tecla: 'o', texto: 'Ir a Documentos' },
  { tecla: 'b', texto: 'Ir al Buscador (enfoca el buscador global)' },
  { tecla: 'Ctrl+K', texto: 'Enfocar el buscador global' },
  { tecla: 'Esc', texto: 'Cerrar el panel o el menú abierto' }
];
/* Mientras se escribe en un campo, ningún atajo se dispara:
   teclear «f» en un input es teclear, no navegar. */
function atajosEscribiendo240(target) {
  if (!target) return false;
  const tag = String(target.tagName || '').toUpperCase();
  if (tag === 'INPUT' || tag === 'TEXTAREA' || tag === 'SELECT') return true;
  return Boolean(target.isContentEditable);
}
/* El resolver PURO de la tecla: qué acción pide, o null.
   Con modificadores no actúa (Ctrl+K es del buscador, y
   Ctrl/Cmd/Alt + letra es del sistema o del navegador). */
function atajosTecla240(event) {
  if (!event || event.repeat) return null;
  if (event.ctrlKey || event.metaKey || event.altKey) return null;
  const tecla = String(event.key || '');
  if (tecla === 'Escape') return { tipo: 'cerrar' };
  if (atajosEscribiendo240(event.target)) return null;
  if (tecla === '?') return { tipo: 'atajos' };
  if (tecla.length !== 1) return null;
  const vista = { h: 'home', f: 'invoices', d: 'dinero', o: 'docs' }[tecla.toLowerCase()];
  if (vista) return { tipo: 'vista', vista };
  if (tecla.toLowerCase() === 'b') return { tipo: 'buscar' };
  return null;
}
let atajosDialogo240 = null;
function atajosLista240() {
  const lista = n('div');
  for (const atajo of ATAJOS240) {
    const fila = n('div', undefined, 'cp-row');
    fila.append(n('strong', atajo.tecla), n('span', atajo.texto));
    lista.append(fila);
  }
  lista.append(n('p', 'Los atajos no se disparan mientras escribes en un campo.', 'muted'));
  return lista;
}
function atajosAbrir240() {
  if (atajosDialogo240) return;
  document.querySelector('.atajos-cajon240')?.remove();
  const d = document.createElement('dialog');
  d.className = 'atajos-cajon240';
  d.dataset.atajosDialogo240 = '1';
  d.setAttribute('aria-label', 'Atajos de teclado');
  const head = n('div', undefined, 'modal-head');
  head.append(n('h2', 'Atajos de teclado'));
  const cerrar = n('button', undefined, 'icon-button');
  cerrar.type = 'button';
  cerrar.setAttribute('aria-label', 'Cerrar los atajos');
  cerrar.append(icon('close'));
  cerrar.onclick = () => atajosCerrar240();
  head.append(cerrar);
  d.append(head, atajosLista240());
  const acts = n('div', undefined, 'modal-actions');
  const salir = n('button', 'Cerrar', 'primary');
  salir.type = 'button';
  salir.onclick = () => atajosCerrar240();
  acts.append(salir);
  d.append(acts);
  document.body.append(d);
  atajosDialogo240 = d;
  if (d.showModal) d.showModal();
}
function atajosCerrar240() {
  if (atajosDialogo240) {
    const d = atajosDialogo240;
    atajosDialogo240 = null;
    try { if (d.open) d.close(); } catch { /* ya cerrado */ }
    d.remove();
  }
  const menu = document.getElementById('scope-menu200b');
  if (menu) menu.hidden = true;
}
function atajosEjecutar240(accion) {
  if (!accion) return;
  if (accion.tipo === 'cerrar') { atajosCerrar240(); return; }
  if (atajosDialogo240) { if (accion.tipo === 'atajos') atajosCerrar240(); return; }
  const dlg = document.getElementById('dialog');
  if (dlg && dlg.open) return;
  if (accion.tipo === 'atajos') navigate('preguntas'); /* (2.8.0 · diseño 26) los atajos viven como sección en Preguntas */
  else if (accion.tipo === 'vista') navigate(accion.vista);
  else if (accion.tipo === 'buscar') {
    const inp = document.getElementById('global-search');
    if (inp && inp.focus) inp.focus();
  }
}
function atajosTarjeta240() {
  const wrap = panel('Atajos de teclado');
  wrap.dataset.atajos240 = '1';
  wrap.append(n('p', 'Muévete sin ratón: pulsa «?» en cualquier pantalla para ver esta tarjeta.'));
  wrap.append(atajosLista240());
  return wrap;
}
if (typeof document !== 'undefined' && typeof window !== 'undefined' && !window.__atajos240Global) {
  window.__atajos240Global = true;
  document.addEventListener('keydown', event => atajosEjecutar240(atajosTecla240(event)));
  const botonAtajos240 = document.getElementById('atajos-btn240');
  if (botonAtajos240) botonAtajos240.onclick = () => navigate('preguntas'); /* (2.8.0 · diseño 26) */
}

/* ===== Hoy proactivo (2.9.7 · D6) =====
   Tarjeta de arranque junto al foco del sistema de la 2.9.0:
   «Esto pasó · Esto falta · Esto te propongo», en tres bloques
   que salen SOLO de datos que Hoy ya consume — la actividad y
   los cambios de /api/cambios (PASÓ), las piezas del foco
   focoSistema290 (FALTA) y los pendientes por metadatos de
   satData.metadata (PROPONGO a) — y de maquinaria existente:
   la bajada por el portal, POST /api/tributario/run, la
   navegación a Avisos y la navegación a Cierre (el cierre del
   mes vive tras el panel de Cierre — cierre200gPanel, en la
   parte diferida de salidas — y no tiene una función global
   invocable desde Hoy: la propuesta lo dice y navega allí,
   ningún botón finge cerrarlo desde aquí). Cada propuesta
   enseña su estado al terminar en su propia línea. Un bloque
   sin nada lo dice en una línea: la tarjeta nunca sale vacía
   ni con propuestas huecas. */
function hoyPropuestasPendientes297() {
  const sd = typeof satData !== 'undefined' && satData ? satData : null;
  const missing = sd?.metadata?.missing || [];
  if (!scope) return missing.length;
  return missing.filter(row => row.emitter === scope || row.receiver === scope).length;
}
function hoyProactivo297Panel() {
  const wrap = panel('Esto pasó · Esto falta · Esto te propongo');
  wrap.dataset.hoyProactivo297 = '1';
  const rfc = scope || (typeof satData !== 'undefined' && satData?.profiles?.[0]?.rfc) || '';
  /* — PASÓ: lo último de la actividad que Hoy ya trae — */
  const paso = n('div', undefined, 'hoy297-bloque');
  paso.dataset.hoy297Bloque = 'paso';
  paso.append(n('h3', 'Esto pasó'));
  const pasoBody = n('div');
  const ultimos = (typeof activity !== 'undefined' && Array.isArray(activity) ? activity : []).slice(0, 3);
  if (ultimos.length) for (const entry of ultimos)
    pasoBody.append(n('p', String(entry.event || entry.name || 'Actividad registrada') +
      (entry.date ? ' · ' + localDateTime(entry.date) : '')));
  else pasoBody.append(n('p', 'Nada nuevo desde ayer'));
  paso.append(pasoBody);
  if (typeof satToken !== 'undefined' && satToken) {
    const ruta = 'cambios' + (scope ? '?rfc=' + encodeURIComponent(scope) : '');
    satApi(ruta).then(data => {
      if (!wrap.isConnected) return;
      const { visibles, total } = typeof cambiosLineas230 === 'function'
        ? cambiosLineas230(data) : { visibles: [], total: 0 };
      if (!total) return;
      pasoBody.replaceChildren(...visibles.map(linea => n('p', linea.texto)));
    }).catch(() => { /* sin lectura de cambios: queda la actividad */ });
  }
  wrap.append(paso);
  /* — FALTA: los ítems del foco, los mismos de focoSistema290 — */
  const falta = n('div', undefined, 'hoy297-bloque');
  falta.dataset.hoy297Bloque = 'falta';
  falta.append(n('h3', 'Esto falta'));
  const foco = typeof focoSistema290 === 'function'
    ? focoSistema290(typeof satData !== 'undefined' ? satData : null,
      typeof focoSalud290 !== 'undefined' ? focoSalud290 : null,
      typeof focoListas290 !== 'undefined' ? focoListas290 : null,
      typeof satData !== 'undefined' ? satData?.coverage : null)
    : { piezas: [] };
  const faltan = (foco.piezas || []).filter(pieza => pieza.nivel === 'warn' || pieza.nivel === 'bad');
  if (faltan.length) for (const pieza of faltan)
    falta.append(n('p', pieza.nombre + ' — ' + pieza.motivo + ' (De quién: ' + pieza.deQuien + ')'));
  else falta.append(n('p', 'No falta nada'));
  wrap.append(falta);
  /* — PROPONGO: propuestas ya preparadas, a un toque — */
  const propongo = n('div', undefined, 'hoy297-bloque');
  propongo.dataset.hoy297Bloque = 'propongo';
  propongo.append(n('h3', 'Esto te propongo'));
  const propuesta = (textoBoton, nota, hacer) => {
    const fila = n('div', undefined, 'cp-row hoy297-propuesta');
    const main = n('div', undefined, 'cp-main');
    if (nota) main.append(n('span', nota, 'muted'));
    const estado = n('span', '', 'muted hoy297-estado');
    estado.dataset.propEstado297 = '1';
    main.append(estado);
    const btn = n('button', textoBoton, 'soft small');
    btn.type = 'button';
    btn.onclick = () => hacer(btn, estado, fila);
    fila.append(main, btn);
    propongo.append(fila);
    return fila;
  };
  const invitada = typeof guestMode !== 'undefined' && guestMode;
  if (!invitada && rfc) {
    const pendientes297 = hoyPropuestasPendientes297();
    if (pendientes297 > 0) propuesta(
      'Bajar ahora las ' + pendientes297 + ' facturas nuevas detectadas',
      'Son los CFDI que el SAT conoce por metadatos y aún no están en tu expediente como XML.',
      (btn, estado, fila) => {
        btn.disabled = true;
        const prog = n('div');
        fila.append(prog);
        portalLanzar297(prog, { rfc, allMissing: true, origen: 'hoy' }, (ok, state, error) => {
          estado.textContent = ok ? 'Hecho: las facturas nuevas bajaron por el portal.'
            : 'Falló: ' + (error ? error.message : portalMotivo297(state));
          btn.disabled = false;
        });
      });
    propuesta('Consultar el Buzón', 'Lista las notificaciones del Buzón Tributario de ' + rfc + ', sin abrir ninguna.',
      async (btn, estado) => {
        btn.disabled = true; estado.textContent = 'Pidiendo la consulta…';
        try { await satApi('tributario/run', { rfc }); estado.textContent = 'Hecho: consulta del Buzón pedida.'; }
        catch (error) { estado.textContent = 'Falló: ' + error.message; }
        btn.disabled = false;
      });
  }
  propuesta('Revisar los avisos', 'Los avisos de este RFC, en su pantalla.',
    (btn, estado) => { estado.textContent = 'Hecho: vas a Avisos.'; navigate('avisos'); });
  if (!invitada) propuesta('Generar el cierre del mes',
    'El cierre se comprueba y se cierra en su panel: esta propuesta te lleva a Cierre y reportes, donde está su botón.',
    (btn, estado) => { estado.textContent = 'Hecho: vas a Cierre y reportes.'; cierreSection = 'cierre'; navigate('salidas'); });
  wrap.append(propongo);
  return wrap;
}
/* ===== Tu día en cifras (2.9.13 · mejoras 1 y 2) =====
   Hoy abre — tras el mando — con la foto dibujada del día:
   las facturas del mes con su mini-gráfico de 6 meses, la
   puerta, el respaldo y el ANILLO de cobertura del año (días
   con descargas sobre los días que van del año, del mapa de
   cobertura que el estado ya trae). Todo sale de datos ya
   cargados en la sesión: ninguna lectura nueva. Sin ámbito
   elegido, la tarjeta no se pinta (Hoy no crece con huecos). */
function hoyDiaCifras2913() {
  if (!scope) return n('div');
  const wrap = panel('Tu día en cifras');
  wrap.classList.add('hoy-cifras2913');
  const fila = n('div', undefined, 'hoy-cifras-fila2913');
  /* Facturas del mes, con su mini-gráfico. */
  const mesActual = new Date().toISOString().slice(0, 7);
  const delMes = invoices.filter(row => (!row.from || row.from.rfc === scope || row.to.rfc === scope) &&
    String(row.date || '').startsWith(mesActual) && !rowCancelled(row));
  const porMes = new Map();
  for (const row of invoices) {
    if (rowCancelled(row)) continue;
    if (row.from.rfc !== scope && row.to.rfc !== scope) continue;
    const mes = String(row.date || '').slice(0, 7);
    if (/^\d{4}-\d{2}$/.test(mes)) porMes.set(mes, (porMes.get(mes) || 0) + 1);
  }
  const mesesMini = [...porMes.keys()].sort().slice(-6);
  const maxMini = Math.max(1, ...mesesMini.map(m => porMes.get(m)));
  const celdaFacturas = n('div', undefined, 'hoy-cifra2913');
  celdaFacturas.append(n('small', 'Facturas de este mes'),
    n('strong', number.format(delMes.length), 'hoy-cifra-num2913'));
  const mini = n('div', undefined, 'graf-barras2913 mini');
  for (const mes of mesesMini) {
    const col = n('div', undefined, 'graf-col2913');
    const barra = n('div', undefined, 'graf-barra2913 emitidos');
    barra.style.height = Math.max(3, Math.round(porMes.get(mes) / maxMini * 34)) + 'px';
    barra.title = mes + ': ' + porMes.get(mes) + ' facturas';
    col.append(barra, n('span', mes.slice(5), 'graf-mes2913'));
    mini.append(col);
  }
  celdaFacturas.append(mini);
  fila.append(celdaFacturas);
  /* El respaldo, con su semáforo. (La PUERTA no se repite en
     esta tarjeta: Hoy ya la enseña UNA vez, en la ficha del
     contribuyente — «Puerta del SAT · abre · probada el …» — y
     la regla de la casa es cada dato una vez por pantalla; la
     mejora 1 la nombraba entre las cifras del día y su sitio
     en Hoy es ese, a la vista en el primer pantallazo.) */
  const bh = typeof satData !== 'undefined' && satData ? satData.backupHealth : null;
  const celdaRespaldo = n('div', undefined, 'hoy-cifra2913');
  celdaRespaldo.append(n('small', 'Respaldo'),
    statusPill(!bh?.enabled ? 'dim' : bh.failed ? 'bad' : bh.lastOk ? 'ok' : 'warn',
      !bh?.enabled ? 'Sin activar' : bh.failed ? 'El último falló' : bh.lastOk ? 'Al día' : 'Sin constar'),
    n('span', bh?.lastOk ? 'Último bueno: ' + fmtFechaHora(typeof bh.lastOk === 'number' ? bh.lastOk : Date.parse(bh.lastOk)) : 'Sin respaldo bueno todavía.', 'muted'));
  fila.append(celdaRespaldo);
  /* El anillo de cobertura del año (mejora 2). */
  const diasMapa = typeof satData !== 'undefined' && satData ? satData.coverage?.days?.[scope] : null;
  if (diasMapa) {
    const anio = new Date().getFullYear();
    const conDescarga = new Set([...(diasMapa.received || []), ...(diasMapa.issued || [])]
      .filter(d => String(d).startsWith(String(anio)) && String(d) <= new Date().toISOString().slice(0, 10)));
    const inicioAnio = Date.UTC(anio, 0, 1);
    const diasTranscurridos = Math.max(1, Math.floor((Date.now() - inicioAnio) / 86400000) + 1);
    const pct = Math.min(100, Math.round(conDescarga.size / diasTranscurridos * 100));
    const celdaAnillo = n('div', undefined, 'hoy-cifra2913 hoy-anillo2913');
    celdaAnillo.append(n('small', 'Cobertura de ' + anio));
    const NS = 'http://www.w3.org/2000/svg';
    const svg = document.createElementNS(NS, 'svg');
    svg.setAttribute('viewBox', '0 0 84 84');
    svg.setAttribute('class', 'hoy-anillo-svg2913');
    svg.setAttribute('role', 'img');
    svg.setAttribute('aria-label', 'Cobertura del año: ' + conDescarga.size + ' días con descargas de ' + diasTranscurridos + ' transcurridos');
    const circulo = (extra) => {
      const c = document.createElementNS(NS, 'circle');
      c.setAttribute('cx', '42'); c.setAttribute('cy', '42'); c.setAttribute('r', '34');
      for (const [k, v] of Object.entries(extra)) c.setAttribute(k, v);
      return c;
    };
    svg.append(circulo({ fill: 'none', 'stroke-width': '9', class: 'anillo-fondo2913' }));
    const avance = circulo({ fill: 'none', 'stroke-width': '9', class: 'anillo-avance2913',
      'stroke-dasharray': (2 * Math.PI * 34).toFixed(1),
      'stroke-dashoffset': (2 * Math.PI * 34 * (1 - pct / 100)).toFixed(1),
      transform: 'rotate(-90 42 42)', 'stroke-linecap': 'round' });
    svg.append(avance);
    const textoPct = document.createElementNS(NS, 'text');
    textoPct.setAttribute('x', '42'); textoPct.setAttribute('y', '48');
    textoPct.setAttribute('text-anchor', 'middle');
    textoPct.setAttribute('class', 'anillo-pct2913');
    textoPct.textContent = pct + '%';
    svg.append(textoPct);
    celdaAnillo.append(svg, n('span', conDescarga.size + ' días con descargas de ' + diasTranscurridos + ' del año', 'muted'));
    fila.append(celdaAnillo);
  }
  wrap.append(fila);
  return wrap;
}
function home() {
  if (!ready) {
    /* Esqueleto de carga (1.6.5; forma de la pantalla desde
       2.4.0 · W5b2, pieza 4b): la silueta de Hoy —protagonista
       y filas— con las formas de W5a, en vez de bloques
       genéricos; desaparece en cuanto el dato pinta. */
    const skel = esqueletoPantalla240(3);
    skel.setAttribute('aria-busy', 'true');
    skel.setAttribute('aria-label', 'Cargando el resumen fiscal');
    return [skel];
  }
  /* Construcción no montada, fuera (2.3.2 · o-7): home()
     componía el héroe, las métricas, «Últimos comprobantes»,
     «Contribuyentes» y «Actividad» completos y NO los montaba
     — el return nunca los usaba y su coste se pagaba en cada
     pintado. Esos datos siguen vivos en sus pantallas (el
     contribuyente y los conteos, en Facturas; la actividad,
     en el Registro). La pantalla pintada no cambia. */
  /* Hoy manda (2.3.2 · M-8): el mando lleva dentro los
     gestos, por encima de sus 4 tarjetas de acción. */
  const blocks = [hoyMando201(gestosPanel1311())];
  /* (2.9.13 · mejoras 1 y 2) «Tu día en cifras», con el
     anillo de cobertura del año: tras el mando, antes de lo
     demás — Hoy abre con la foto dibujada. */
  blocks.push(hoyDiaCifras2913());
  /* Hoy proactivo (2.9.7 · D6): la tarjeta de arranque, junto
     al foco del sistema — tras el mando y antes de lo demás. */
  blocks.push(hoyProactivo297Panel());
  /* Vista Nora (1.25.0, AGREGAR 3): si quien entra es la
     invitada-contadora, su pantalla inicial es su lista del mes
     en solo lectura. La marca la decide el servidor; se consulta
     una vez y, si llega tarde, la pantalla se repinta sola. */
  if (typeof guestMode !== 'undefined' && guestMode) {
    if (noraSesionCache === true) return [noraVistaPanel()];
    if (noraSesionCache === null) {
      noraSesionCache = 'consultando';
      satApi('guest/config').then(cfg => {
        noraSesionCache = Boolean(cfg.sesionContadora);
        if (noraSesionCache && page === 'home') render();
      }).catch(() => { noraSesionCache = false; });
    }
  }
  /* Lo que te toca y la línea de salud (2.0 · tanda 2): los
     gestos son del día y se quedan; la salud y el respaldo
     salen del cuerpo — queda UNA línea-resumen con su
     semáforo que lleva a Ajustes › Estado del sistema, su
     pantalla dueña. «Esto es lo nuevo» ya no vive en Hoy:
     su sitio es Ajustes › Acerca de (capacidadesScreen). */
  /* «Lo que te necesita» ya entró con el mando, por encima
     de las tarjetas (2.3.2 · M-8). La línea de salud también
     sale de Hoy (2.0.1): Salud es entrada propia del menú y
     su detalle vive en su pantalla. */
  /* «A medias» (nº 16): tras los gestos, en su mismo flujo; el
     panel solo se enseña si el servidor trae algo a medias. */
  blocks.push(aMedias201Panel());
  /* La foto por RFC y «Qué cambió desde ayer» (2.3.0 · piezas
     10 y 11): tras lo a medias, en el mismo flujo. Ambas nacen
     ocultas y solo aparecen con algo real que decir — Hoy no
     crece con tarjetas vacías. */
  blocks.push(fotoRfcPanel230(), cambiosPanel230());
  /* El trabajo VIVO en Hoy (2.4.0 · W4a): el hueco de
     actividad de Hoy enseña también lo que está en curso —
     con su detalle y su gesto de parada — y no solo lo
     reciente, que sigue pintando paintActivity en su
     [data-sys-activity] dentro de este mismo panel. */
  blocks.push(hoyActividadPanel240());
  /* (2.8.0 · diseño 2, 13, 14 y 15) Hoy se queda con lo del
     día: el mando (estado, gestos y las 4 acciones), lo a
     medias, la foto y los cambios de ayer, la actividad y los
     vencimientos. Salen de Hoy: el desglose del cierre (queda
     UNA línea-resumen que enlaza a Cierre, diseño 15), «Qué
     cambió en esta versión» (vive en Ajustes › Acerca de,
     diseño 14) y la tarjeta de atajos (vive en la tecla «?» y
     en el botón de la barra, diseño 13). */
  blocks.push(cierreResumen280());
  const venc240 = vencPanel240();
  if (venc240) blocks.push(venc240);
  if (lastImport) {
    /* Tarjeta persistente de la última importación (UX-13). */
    const card = panel('Última importación');
    card.append(n('p', lastImport.added + ' nuevos · ' + lastImport.duplicates + ' duplicados · ' + lastImport.review +
      ' por revisar · ' + localDateTime(lastImport.at)));
    const acts = n('div', undefined, 'actions');
    acts.append(action('Ver facturas', () => navigate('invoices'), undefined, 'file'));
    if (lastImport.dupIds.length) acts.append(action('Ver los UUID duplicados', () => {
      dialog('UUID duplicados en la última importación',
        [n('p', 'Estos folios ya estaban en tu expediente y no se importaron dos veces:'), ...lastImport.dupIds.map(id => n('p', id))]);
    }));
    card.append(acts);
    blocks.push(card);
  }
  /* Fuera de Hoy (2.0 · tanda 2, M5): «Últimos comprobantes» y
     «Actividad» repetían Facturas y el Registro/la franja de
     actividad — viven en sus pantallas, a un toque. La tabla
     «Contribuyentes» la sustituye el panel general de
     contribuyentes (pieza 9), alcanzable desde el selector
     («Ver todos»): Hoy es de UN RFC y no mezcla el conjunto. */
  /* La tabla «Totales por RFC y mes» ya no vive en Hoy
     (1.32.1, H1/H2): repetía las cifras de Dinero y de Cierre y
     enterraba el primer pantallazo. Su casa es Cierre y
     reportes, donde está el reporte completo. */
  return blocks;
}

const invoiceStateOf = row => {
  const item = fiscalResults.get(row.id);
  if (item?.efos?.length) return 'efos';
  return item?.sat?.state || 'none';
};
/* Estado de pago por fila (del Visor, absorbido en la fusión de
   Facturas de la 1.11.0): el saldo oficial vive en el servidor
   (paidByMap/balanceOf de Dinero); visorMarcados recuerda lo
   marcado en esta sesión. */
const visorMarcados = new Set();
function visorEstadoPago(row, paidBy) {
  if (row.kind !== 'I') return { label: '—', state: 'dim' };
  if (visorMarcados.has(row.id)) return { label: 'Pagada', state: 'ok' };
  const { balance, paid } = balanceOf(row, paidBy);
  if (balance <= 0n) return { label: 'Pagada', state: 'ok' };
  if (paid > 0n) return { label: 'Parcial', state: 'warn' };
  return { label: 'Pendiente', state: 'warn' };
}
/* ===== Facturas 2.4.0 · W4b — chips rápidos (P5) y tarjeta
   protagonista «PPD sin REP» (castigo 8) =====
   UN SOLO CÁLCULO (facturasDatos240) alimenta los tres chips
   y la tarjeta: se compone una vez por pintado de la vista,
   sobre el ámbito en pantalla (el RFC elegido, como el resto
   de la vista), con el saldo reconciliado de siempre —
   balanceOf sobre paidByMap (complementos de pago reales;
   las PUE nacen pagadas) — y el criterio único de canceladas
   (rowCancelled: la cancelada no se debe ni se cobra).
   · PPD sin REP: factura de ingreso PPD con saldo vivo > 0
     (sin complemento que lo cuadre, o con complemento solo
     parcial: falta el REP del resto).
   · Canceladas del mes: estado SAT «Cancelado» y fecha del
     mes en curso.
   · Pendientes >30 días: ingreso con saldo vivo y más de
     30 días desde su fecha.
   Los días de atraso salen de la fecha de cada factura y de
   «ahora» (el parámetro permite el reloj de juguete de la
   suite); nunca se escribe un conteo a mano. */
const FACTURAS_RAPIDOS240 = [
  { clave: 'ppd-sin-rep', etiqueta: 'PPD sin REP', icono: 'alert' },
  { clave: 'canceladas-mes', etiqueta: 'Canceladas del mes', icono: 'file' },
  { clave: 'pendientes-30', etiqueta: 'Pendientes >30 días', icono: 'clock' }];
function facturasMesKey240(ahora = Date.now()) {
  const d = new Date(ahora);
  return d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0');
}
function facturasDiasAtraso240(row, ahora = Date.now()) {
  const t = Date.parse(row.date);
  if (!Number.isFinite(t)) return 0;
  return Math.max(0, Math.floor((ahora - t) / 86400000));
}
function facturasEnAlcance240(row) {
  return scope ? (row.from.rfc === scope || row.to.rfc === scope)
    : scopes().has(row.from.rfc) || scopes().has(row.to.rfc);
}
function facturasDatos240(ahora = Date.now()) {
  const paidBy = paidByMap();
  const mesKey = facturasMesKey240(ahora);
  const ppd = [];
  let pendientes30 = 0, canceladasMes = 0;
  for (const row of invoices) {
    if (!facturasEnAlcance240(row)) continue;
    if (invoiceStateOf(row) === 'Cancelado' && String(row.date || '').startsWith(mesKey))
      canceladasMes++;
    if (row.kind !== 'I' || rowCancelled(row)) continue;
    const { balance } = balanceOf(row, paidBy);
    if (balance <= 0n) continue;
    const dias = facturasDiasAtraso240(row, ahora);
    if (dias > 30) pendientes30++;
    if (row.fiscal?.paymentMethod === 'PPD')
      ppd.push({ row, saldo: balance, dias });
  }
  /* Los más atrasados primero: la lista corta de la tarjeta
     y el orden de reclamación son este mismo orden. */
  ppd.sort((a, b) => b.dias - a.dias || (b.saldo > a.saldo ? 1 : b.saldo < a.saldo ? -1 : 0) ||
    String(a.row.id).localeCompare(String(b.row.id)));
  return { ahora, mesKey, ppd,
    ppdTotal: ppd.reduce((suma, item) => suma + item.saldo, 0n),
    conteos: { 'ppd-sin-rep': ppd.length, 'canceladas-mes': canceladasMes, 'pendientes-30': pendientes30 } };
}
/* El predicado ÚNICO de los chips dentro del motor de la
   vista (invoiceRows): el chip no trae su propia lógica de
   filtrado — para «Canceladas del mes» la vista activa además
   su filtro de siempre (direction='Canceladas' + mes), y este
   predicado es su equivalente exacto sobre la fila. */
function facturasRapidoCoincide240(row, clave, paidBy, ahora = Date.now()) {
  if (clave === 'ppd-sin-rep')
    return row.kind === 'I' && row.fiscal?.paymentMethod === 'PPD' && !rowCancelled(row) &&
      balanceOf(row, paidBy || paidByMap()).balance > 0n;
  if (clave === 'pendientes-30')
    return row.kind === 'I' && !rowCancelled(row) &&
      balanceOf(row, paidBy || paidByMap()).balance > 0n && facturasDiasAtraso240(row, ahora) > 30;
  if (clave === 'canceladas-mes')
    return invoiceStateOf(row) === 'Cancelado' && String(row.date || '').startsWith(facturasMesKey240(ahora));
  return true;
}
function facturasFolio240(row) {
  return row.fiscal ? ((row.fiscal.serie ? row.fiscal.serie + '-' : '') + (row.fiscal.folio || '')) || '—' : '—';
}
/* El recordatorio al emisor, ya redactado en llano con los
   datos de SU factura (folio, fecha, importe y días de
   atraso): el mismo texto lo enseña la tarjeta, lo copia el
   botón «Copiar recordatorio» y lo lleva la hoja de Enviar. */
function facturasRecordatorio240(item) {
  const row = item.row;
  const emisor = row.from.name || row.from.rfc;
  return 'Hola, ' + emisor + ': te recordamos que la factura ' + facturasFolio240(row) +
    ' (folio fiscal ' + row.id + '), emitida el ' + dateLabel(row.date) + ' por $' + amount(row) +
    ', lleva ' + item.dias + (item.dias === 1 ? ' día' : ' días') + ' de atraso y aún no consta su ' +
    'complemento de pago (REP) en PacoSAT: queda un saldo de $' + centsLabel(item.saldo) + ' sin complemento. ' +
    '¿Podrías revisarlo y enviarnos el complemento de pago? Gracias.';
}
/* La tarjeta protagonista de Facturas (castigo 8): abre la
   vista con el veredicto PPD — total, importe y los más
   atrasados con sus días — y, sin pendientes, el estado
   limpio en verde honesto con su fecha de comprobación.
   Cada importe y cada folio abren su factura (invoiceDetail,
   el camino de siempre). El recordatorio NO es un documento
   del expediente: desde W2c la ruta de correo admite su
   clase propia «recordatorio» — el cliente solo pasa
   {clase:'recordatorio', uuid} y el SERVIDOR compone el
   cuerpo desde la factura reconciliada, sin adjunto —; la
   hoja del aparato lo sigue llevando como fichero .txt y
   «Copiar recordatorio» se queda. */
/* ===== Facturas dibujadas (2.9.13 · mejoras 6 y 7) =====
   Barras de emitidos/recibidos por mes (los últimos 6 meses
   con datos del ámbito en pantalla) y la tira de totales del
   periodo elegido (o de todo el ámbito): subtotal e IVA solo
   suman los CFDI con desglose guardado — los demás se cuentan
   como «sin desglose», no se estima nada — y el total suma
   todos los no cancelados en MXN. Todo sale de las facturas
   ya cargadas en la sesión: ninguna lectura nueva. */
function facturasGraficos2913() {
  const enAmbito = invoices.filter(row => !scope || row.from.rfc === scope || row.to.rfc === scope);
  if (!enAmbito.length) return n('div');
  const wrap = n('section', undefined, 'panel facturas-graficos2913');
  const porMes = new Map();
  for (const row of enAmbito) {
    if (rowCancelled(row)) continue;
    const mes = String(row.date || '').slice(0, 7);
    if (!/^\d{4}-\d{2}$/.test(mes)) continue;
    const g = porMes.get(mes) || { emitidos: 0, recibidos: 0 };
    if (row.from.rfc === scope) g.emitidos++; else if (row.to.rfc === scope) g.recibidos++;
    else { g.emitidos++; }
    porMes.set(mes, g);
  }
  const meses = [...porMes.keys()].sort().slice(-6);
  if (meses.length) {
    wrap.append(n('strong', 'Emitidos y recibidos por mes'));
    const maximo = Math.max(1, ...meses.map(m => Math.max(porMes.get(m).emitidos, porMes.get(m).recibidos)));
    const barras = n('div', undefined, 'graf-barras2913');
    for (const mes of meses) {
      const g = porMes.get(mes);
      const col = n('div', undefined, 'graf-col2913');
      const par = n('div', undefined, 'graf-par2913');
      const bE = n('div', undefined, 'graf-barra2913 emitidos');
      bE.style.height = Math.max(4, Math.round(g.emitidos / maximo * 64)) + 'px';
      bE.title = 'Emitidos: ' + g.emitidos;
      const bR = n('div', undefined, 'graf-barra2913 recibidos');
      bR.style.height = Math.max(4, Math.round(g.recibidos / maximo * 64)) + 'px';
      bR.title = 'Recibidos: ' + g.recibidos;
      par.append(bE, bR);
      col.append(par, n('span', g.emitidos + ' / ' + g.recibidos, 'graf-cifra2913'),
        n('span', mes.slice(5) + '/' + mes.slice(2, 4), 'graf-mes2913'));
      barras.append(col);
    }
    wrap.append(barras, n('p', 'Azul: emitidos · dorado: recibidos. La cifra es «emitidos / recibidos» de cada mes, sin canceladas.', 'muted'));
  }
  /* La tira de totales del periodo (mejora 7). */
  const delPeriodo = enAmbito.filter(row => !rowCancelled(row) && (!month || String(row.date || '').startsWith(month)));
  let base = 0n, iva = 0n, total = 0n, conDesglose = 0, sinDesglose = 0;
  for (const row of delPeriodo) {
    if (row.currency && row.currency !== 'MXN') continue;
    total += totalCents(row);
    const b = invoiceIvaBaseCents(row), i = invoiceIvaCents(row);
    if (b !== null && i !== null) { base += b; iva += i; conDesglose++; } else sinDesglose++;
  }
  const tira = n('div', undefined, 'total-strip facturas-totales2913');
  tira.append(
    cell('Subtotal', '$' + centsLabel(base)),
    cell('IVA', '$' + centsLabel(iva)),
    cell('Total del periodo', '$' + centsLabel(total)));
  wrap.append(tira, n('p', (month ? 'Periodo: ' + month + '. ' : 'Todo el ámbito en pantalla. ') +
    'Subtotal e IVA suman los ' + number.format(conDesglose) + ' CFDI con desglose guardado' +
    (sinDesglose ? '; ' + number.format(sinDesglose) + ' sin desglose no suman en esas dos cifras (no se estima nada)' : '') +
    '. El total suma todos los no cancelados en pesos.', 'muted'));
  return wrap;
}
function facturasPpdTarjeta240(datos) {
  const card = n('article', undefined, 'cmd-card facturas-ppd240');
  card.dataset.ppd240 = datos.ppd.length ? 'pendientes' : 'limpio';
  card.dataset.level = datos.ppd.length ? 'ambar' : 'ok';
  const head = n('div', undefined, 'tramite-head');
  head.append(icon(datos.ppd.length ? 'alert' : 'check'), n('strong', 'PPD sin REP'),
    statusPill(datos.ppd.length ? 'warn' : 'ok',
      datos.ppd.length ? datos.ppd.length + (datos.ppd.length === 1 ? ' factura' : ' facturas') + ' sin complemento'
        : 'Al día', undefined, undefined, true));
  card.append(head);
  if (!datos.ppd.length) {
    const hero = n('div', undefined, 'total-hero');
    hero.append(n('span', 'Comprobado el ' + fmtFechaCorta(datos.ahora), 'tramite-detalle'),
      n('strong', 'Sin PPD pendientes de REP'));
    card.append(hero, n('p', 'Ninguna factura a crédito (PPD) del ámbito en pantalla queda con saldo sin su complemento de pago.', 'cmd-last'));
    return card;
  }
  const hero = n('div', undefined, 'total-hero');
  hero.append(n('span', datos.ppd.length + (datos.ppd.length === 1 ? ' factura PPD' : ' facturas PPD') +
      ' sin su complemento de pago (REP) · saldo pendiente', 'tramite-detalle'),
    n('strong', '$' + centsLabel(datos.ppdTotal)));
  card.append(hero);
  for (const item of datos.ppd.slice(0, 5)) {
    const row = item.row;
    const fila = n('div', undefined, 'cp-row');
    const main = n('button', undefined, 'cmd-main');
    main.type = 'button';
    main.title = 'Abrir el detalle de esta factura';
    main.onclick = () => invoiceDetail(row);
    const textos = n('span', undefined, 'cmd-texts');
    textos.append(n('strong', (row.from.name || row.from.rfc) + ' · Folio ' + facturasFolio240(row), 'cmd-title'),
      n('span', dateLabel(row.date) + ' · importe $' + amount(row) + ' · saldo $' + centsLabel(item.saldo), 'cmd-last'),
      n('span', item.dias + (item.dias === 1 ? ' día' : ' días') + ' de atraso', 'cmd-big'));
    main.append(textos);
    fila.append(main);
    if (typeof guestMode === 'undefined' || !guestMode) {
      const acts = n('div', undefined, 'cmd-actions');
      const texto = facturasRecordatorio240(item);
      const copiar = n('button', 'Copiar recordatorio', 'soft small');
      copiar.type = 'button';
      copiar.onclick = () => copyText(texto, 'Recordatorio');
      acts.append(copiar);
      if (typeof enviarBoton240 === 'function') {
        const enviar = enviarBoton240({
          nombre: 'Recordatorio REP · Folio ' + facturasFolio240(row) + '.txt',
          asunto: 'PacoSAT · Recordatorio de complemento de pago · Folio ' + facturasFolio240(row),
          texto,
          /* Correo por su clase propia (2.4.0 · W2c): el
             cliente solo aporta la referencia {clase, uuid}
             y el destinatario en la tarjeta; el cuerpo lo
             compone el servidor desde la factura reconciliada,
             sin adjunto. La nota de W4b se retira: el correo
             ya funciona para el recordatorio. */
          correo: { clase: 'recordatorio', uuid: row.id },
          archivo: async () => ({ blob: new Blob([texto], { type: 'text/plain;charset=utf-8' }),
            nombre: 'Recordatorio REP · Folio ' + facturasFolio240(row) + '.txt' }) }, 'soft small');
        enviar.dataset.enviarRecordatorio240 = row.id;
        acts.append(enviar);
      }
      fila.append(acts);
    }
    card.append(fila);
  }
  if (datos.ppd.length > 5)
    card.append(n('p', 'Y ' + (datos.ppd.length - 5) + ' más: el chip «PPD sin REP · ' + datos.ppd.length +
      '» de aquí abajo deja la lista solo con ellas, ordenadas por atraso en esta tarjeta.', 'cmd-last'));
  return card;
}
function invoiceRows() {
  const needle = term.trim().toLocaleLowerCase('es-MX');
  const known = scopes();
  const paidBy = (invoicePayState || invoiceRapido240 === 'ppd-sin-rep' || invoiceRapido240 === 'pendientes-30') ? paidByMap() : null;
  const matchScope = row => scope ? row.from.rfc === scope || row.to.rfc === scope : known.has(row.from.rfc) || known.has(row.to.rfc);
  const filtered = invoices.filter(row => matchScope(row) && (!month || row.date.startsWith(month)) && (!invoiceKind || row.kind === invoiceKind) &&
    (!invoiceRapido240 || facturasRapidoCoincide240(row, invoiceRapido240, paidBy)) &&
    (!invoiceState || invoiceStateOf(row) === invoiceState) &&
    (!invoiceContraparte201 || row.from.rfc === invoiceContraparte201 || row.to.rfc === invoiceContraparte201) &&
    (!invoicePayState || visorEstadoPago(row, paidBy).label.toLocaleLowerCase('es-MX') === invoicePayState) &&
    (direction === 'Todos' || (direction === 'Canceladas' ? invoiceStateOf(row) === 'Cancelado'
      : (direction === 'Recibidos' ? (scope ? row.to.rfc === scope : known.has(row.to.rfc)) : (scope ? row.from.rfc === scope : known.has(row.from.rfc))))) &&
    /* El folio del CFDI entra en la búsqueda (1.18.0): teclear
       «963» encuentra la factura 963, no hace falta el UUID.
       2.0.1 · nº 24: también el IMPORTE (tal cual viaja y con
       el formato de pantalla) y el CONCEPTO (las descripciones
       que el propio XML trae y la fila ya lleva): buscar
       «renta» o «343539» encuentra la factura sin su folio. */
    [row.id, row.from.rfc, row.to.rfc, row.from.name, row.to.name,
      row.fiscal ? ((row.fiscal.serie ? row.fiscal.serie + '-' : '') + (row.fiscal.folio || '')) : '',
      row.total, centsLabel(totalCents(row)), ...(row.concepts || [])]
      .some(text => String(text).toLocaleLowerCase('es-MX').includes(needle)));
  /* Orden de PRESENTACIÓN (2.0.1 · nº 26): por fecha o por
     importe, con un toque; no toca ningún cálculo. */
  if (invoiceOrder === 'oldest') return filtered.reverse();
  if (invoiceOrder === 'importe-mayor') return filtered.sort((a, b) => Number(totalCents(b) - totalCents(a)));
  if (invoiceOrder === 'importe-menor') return filtered.sort((a, b) => Number(totalCents(a) - totalCents(b)));
  return filtered;
}
function rowRole(row) {
  const result = roles(row);
  return result.issued && result.received ? 'Entre mis RFC' : result.issued ? 'Emitido' : 'Recibido';
}
/* Imprimir la vista, a la vista (2.0.1, orden de Paco: «no veo
   las funciones de imprimir reportes de forma clara»): un solo
   ayudante compone la tabla TAL CUAL está filtrada en la
   sección de impresión de siempre (#print-report, plantillas
   en Carta de la 1.32.1) y manda imprimir. Lo usan Facturas,
   Dinero y Documentos desde su botón «Imprimir» visible —
   nada de imprimir escondido en menús de tres puntos. */
/* ===== Pre-vuelo de la puerta y confirmación de despacho
   (2.0.1 · nº 5 y nº 21) =====
   Antes de despachar un trabajo contra el SAT (descarga,
   buzón, declaraciones) se enseña una tarjeta con el resumen
   de lo que se va a pedir y el estado REAL de la puerta de ese
   RFC: si consta probada y su último éxito (ultimoExito, el
   dato que la fase 1 dejó en el mapa de la puerta). Es un
   aviso veraz, no un candado: si la puerta no consta abierta,
   la tarjeta lo dice con su causa y ofrece probarla ahí mismo
   (salud/puerta, el despacho de siempre), y Paco puede seguir
   de todos modos. «Cancelar» está siempre visible y no
   despacha nada. */
function puertaTexto201(rfc) {
  const puerta = (typeof satData !== 'undefined' && satData?.puerta?.[rfc]) || null;
  if (!puerta || !puerta.probada)
    return { ok: false, texto: 'La puerta del SAT de ' + rfc + ' no se ha probado todavía: no consta ningún éxito.' };
  const exito = puerta.ultimoExito ? ' Último éxito real: el ' + fmtFechaHora(puerta.ultimoExito) + '.' : '';
  if (puerta.ok) return { ok: true, texto: 'Ahora sí: la puerta de ' + rfc + ' consta abierta (probada el ' +
    fmtFechaHora(puerta.probada) + ').' + exito };
  return { ok: false, texto: 'Ahora no consta que la puerta de ' + rfc + ' abra: ' +
    (puerta.error || 'la última prueba no abrió') + ' (probada el ' + fmtFechaHora(puerta.probada) + ').' +
    exito + ' Puedes probarla ahora o seguir de todos modos.' };
}
function confirmarDespacho201({ titulo, lineas, rfc, boton, alConfirmar }) {
  const form = n('form', undefined, 'dialog-form');
  form.append(n('h3', titulo));
  for (const linea of lineas || []) form.append(n('p', linea));
  if (rfc) {
    const pv = puertaTexto201(rfc);
    form.append(n('p', pv.texto, pv.ok ? 'muted' : 'error-text'));
    const probar = n('button', 'Probar la puerta ahora', 'soft');
    probar.type = 'button';
    probar.onclick = async () => {
      probar.disabled = true;
      try {
        const r = await satApi('salud/puerta', { rfc });
        toast(r.encolado ? 'Prueba de la puerta pedida: tu equipo la corre al recogerla.'
          : (r.motivo || 'La prueba no se encoló.'), r.encolado ? 'ok' : 'error');
        /* (2.9.13 · A3) La foto nueva, al encabezado en el sitio. */
        if (typeof puertaRefrescarEnSitio2913 === 'function')
          await puertaRefrescarEnSitio2913(rfc).catch(() => {});
      } catch (error) { toast(error.message, 'error'); }
      probar.disabled = false;
    };
    form.append(probar);
  }
  const acts = n('div', undefined, 'actions');
  const seguir = n('button', boton || 'Seguir', 'primary'); seguir.type = 'submit';
  const cancelar = n('button', 'Cancelar', 'soft'); cancelar.type = 'button';
  cancelar.onclick = () => closeDialog();
  acts.append(seguir, cancelar);
  form.append(acts);
  form.onsubmit = event => { event.preventDefault(); closeDialog(); alConfirmar(); };
  showDialog(form);
}
/* ===== «Ejecutar aquí» (2.0.1 · nº 31) =====
   El ejecutor vive RESIDENTE en el PC de Paco, con arranque
   automático: lo normal es que ya esté despierto, y así lo
   dice la tarjeta («está despierto»). Este botón es el
   RESPALDO para cuando está cerrado («está dormido»): un
   enlace LOCAL pacosat://ejecutar, el protocolo que su
   instalador registró en su Windows. La app no arranca nada
   por red y nunca enseña una ruta ni una carpeta (eso se
   fijó una vez en el instalador, en su PC): el enlace lo
   resuelve su propio equipo. Si el enlace no responde, la
   reserva es arrancar.bat — y solo se nombra como reserva,
   junto al botón, nunca como el camino. */
function ejecutarAqui201(dormido) {
  const b = n('button', dormido ? 'Ejecutar aquí' : 'Abrir ejecutor', dormido ? 'primary small' : 'soft small');
  b.type = 'button';
  b.title = dormido ? 'Despertar el ejecutor en tu equipo' : 'Abrir el ejecutor en tu equipo';
  b.onclick = () => { window.location.href = 'pacosat://ejecutar'; };
  return b;
}
/* ===== Tiempo estimado de un trabajo (2.0.1 · nº 22) =====
   La mediana real que el servidor calcula en /api/tiempos201
   (mínimo de 3 muestras, aplicado allí). Aquí solo se enseña
   cuando el tipo del trabajo tiene estimación: sin dato, no
   se pinta nada — nunca un tiempo inventado. La lectura se
   cachea un minuto: la franja de actividad se repinta seguido. */
let tiempos201Cache = null, tiempos201At = 0;
/* Mapa de tipos de la franja a claves del historial de
   tiempos (2.0.1; 2.3.0 · pieza 4: el BARRIDO entra en el
   mapa — en la lista de trabajos en curso su kind es
   «barrido» y su historial puede constar con esa misma clave
   o como la revisión de comprobantes que es: sin alias, su
   estimación nunca se encontraba aunque el servidor la
   tuviera). Puro y ordenado: primero la clave propia. */
const TIEMPO_ALIAS230 = { tributario: ['buzon-listar'], ciec: ['descarga-ciec'],
  declaraciones: ['declaraciones-recuperar', 'declaraciones-transacciones'],
  barrido: ['revision-comprobantes', 'revision', 'vigilancia'] };
function tiempoClaves230(kind) {
  return [kind, ...(TIEMPO_ALIAS230[kind] || [])];
}
async function tiempoEstimado201(kind) {
  if (!kind || typeof satToken === 'undefined' || !satToken) return '';
  if (!tiempos201Cache || Date.now() - tiempos201At > 60000) {
    try { tiempos201Cache = await satApi('tiempos201'); tiempos201At = Date.now(); }
    catch { return ''; }
  }
  const porTipo = tiempos201Cache?.porTipo || {};
  for (const clave of tiempoClaves230(kind)) {
    if (porTipo[clave]?.medianaTexto) return porTipo[clave].medianaTexto;
  }
  if (kind === 'documentos') {
    const clave = Object.keys(porTipo).find(k => k.startsWith('documento-sat:'));
    if (clave) return porTipo[clave].medianaTexto;
  }
  return '';
}
function imprimirVista201(titulo, nota, columnas, filas) {
  const section = $('print-report');
  if (!section) { window.print(); return; }
  section.replaceChildren();
  const head = n('div', undefined, 'report-head');
  head.append(n('h1', titulo), n('p', (appSettings.installName || 'PacoSAT') +
    (scope ? ' · ' + scope : '') + ' · ' + localDateTime(Date.now())));
  const body = n('div', undefined, 'report-body');
  if (nota) body.append(n('p', nota));
  const table = n('table');
  const thead = n('thead'); const htr = n('tr');
  for (const label of columnas) htr.append(n('th', label));
  thead.append(htr); table.append(thead);
  const tbody = n('tbody');
  for (const fila of filas) {
    const tr = n('tr');
    for (const valor of fila) tr.append(n('td', String(valor ?? '')));
    tbody.append(tr);
  }
  table.append(tbody);
  body.append(table);
  section.append(head, body);
  if (typeof reportFoot === 'function') section.append(reportFoot(scope));
  setTimeout(() => window.print(), 60);
}
function invoiceScreen() {
  const list = panel();
  /* Tarjeta protagonista + datos de los chips (2.4.0 · W4b):
     UN cálculo para las dos cosas, hecho una vez aquí; la
     tarjeta abre la vista, antes que cualquier otra pieza. */
  const datos240 = facturasDatos240();
  list.append(facturasPpdTarjeta240(datos240));
  /* Descargar SIN salir de Facturas (1.32.1, F1): el botón vive
     donde el usuario piensa «quiero los CFDI nuevos» — abre la
     hoja de descarga de siempre con el RFC elegido y el mes en
     pantalla como periodo sugerido. Si el perfil no tiene
     firmante activo, la hoja lo dice con su gesto (B3). */
  const descargarSat = n('button', 'Descargar del SAT', 'primary');
  descargarSat.type = 'button';
  descargarSat.onclick = () => {
    if (!scope) { toast('Elige arriba el contribuyente del que quieres descargar.', 'error'); return; }
    if (typeof downloadSheet === 'function') {
      const preset = month ? (() => { const [yy, mm] = month.split('-').map(Number);
        const ultimo = new Date(yy, mm, 0).getDate();
        return { start: month + '-01', end: month + '-' + String(ultimo).padStart(2, '0') }; })() : {};
      downloadSheet(scope, preset);
    } else toast('La hoja de descarga vive en Descargar del SAT.', 'error');
  };
  list.append(descargarSat);
  /* (2.9.13 · mejoras 6 y 7) El año en barras y la tira de
     totales del periodo, bajo la protagonista. */
  list.append(facturasGraficos2913());
  /* Tanda 7B (15 · 20#18/F9): vistas guardadas de Facturas — la
     combinación actual de filtros con nombre, aplicable en un
     toque. Los filtros ya recuerdan su último valor al volver
     (viven en las variables de la pantalla y en el RFC elegido). */
  if (typeof satToken !== 'undefined' && satToken) {
    const vistasBar200h = n('div', undefined, 'actions');
    const vistasSel200h = select([['', 'Vistas guardadas…']], '', 'Vistas guardadas de Facturas');
    const cargarVistas200h = () => satApi('vistas200h?rfc=' + encodeURIComponent(scope || '')).then(d => {
      vistasSel200h.replaceChildren(new Option('Vistas guardadas…', ''));
      for (const v of (d.vistas || []).filter(x => x.pantalla === 'facturas'))
        vistasSel200h.append(new Option(v.nombre, v.id, false, false));
      vistasSel200h._porId = Object.fromEntries((d.vistas || []).map(v => [v.id, v]));
    }).catch(() => {});
    vistasSel200h.onchange = () => { const v = vistasSel200h._porId?.[vistasSel200h.value];
      if (!v) return; const f = v.filtros || {};
      term = f.term || ''; month = f.month || ''; invoiceKind = f.kind || '';
      invoiceState = f.state || ''; invoicePayState = f.payState || ''; direction = f.direction || 'Todos';
      invoiceRapido240 = '';
      if (v.rfc) { scope = v.rfc; $('scope').value = scope; }
      invoicePage = 0; render(); };
    const guardarVista200h = n('button', 'Guardar vista', 'soft small');
    guardarVista200h.onclick = () => { const nombreIn = input('text', { maxLength: 60, required: true });
      dialog('Guardar la vista actual', [field('Nombre de la vista', nombreIn)], async () => {
        await satApi('vistas200h', { rfc: scope, pantalla: 'facturas', nombre: nombreIn.value,
          filtros: { term, month, kind: invoiceKind, state: invoiceState, payState: invoicePayState, direction } });
        toast('Vista guardada: la aplicas en un toque desde Facturas.'); cargarVistas200h();
      }, 'Guardar vista'); };
    const borrarVista200h = n('button', 'Borrar vista', 'soft small');
    borrarVista200h.onclick = async () => { if (!vistasSel200h.value) { toast('Elige primero la vista que quieres borrar.', 'error'); return; }
      await satApi('vistas200h/borrar', { id: vistasSel200h.value }); toast('Vista borrada.'); cargarVistas200h(); };
    vistasBar200h.append(vistasSel200h, guardarVista200h, borrarVista200h);
    list.append(vistasBar200h); cargarVistas200h();
  }
  const tabs = n('div', undefined, 'tabs');
  for (const title of ['Todos', 'Recibidos', 'Emitidos']) {
    const button = action(title, () => { direction = title; invoicePage = 0; render(); });
    button.setAttribute('aria-pressed', direction === title);
    tabs.append(button);
  }
  /* Cuarto filtro «Canceladas» (2.0.1, hallazgo de Paco en
     vivo): las canceladas dejaban de mezclarse con su pastilla
     entre las vigentes — tienen su filtro en la MISMA fila, con
     su contador, y su vista enseña el efecto en el mes que el
     servidor ya calcula. Es solo un filtro: las canceladas
     siguen FUERA de los totales, el cálculo no se toca. El
     contador cuenta las del ámbito en pantalla según el estado
     que la vigilancia ya trajo (invoiceStateOf). */
  const numCanceladas = invoices.filter(row => (!scope || row.from.rfc === scope || row.to.rfc === scope) &&
    invoiceStateOf(row) === 'Cancelado').length;
  const tabCanceladas = action('Canceladas (' + number.format(numCanceladas) + ')',
    () => { direction = 'Canceladas'; invoicePage = 0; render(); });
  tabCanceladas.setAttribute('aria-pressed', direction === 'Canceladas');
  tabs.append(tabCanceladas);
  const controls = n('div', undefined, 'filters');
  const search = input('search', { value: term, placeholder: 'Buscar nombre, RFC, folio, UUID, importe o concepto' });
  search.setAttribute('aria-label', 'Buscar comprobantes');
  const period = input('month', { value: month }); period.setAttribute('aria-label', 'Mes de emisión');
  /* El selector de mes lleva su etiqueta visible (2.9.0 ·
     Bloque C): vacío, el control nativo enseña «---------- de
     ----», que no dice nada; con la etiqueta «Mes de emisión»
     y el botón de quitar el mes, el filtro se entiende. */
  const periodWrap290 = n('label', undefined, 'periodo290');
  periodWrap290.append(n('span', 'Mes de emisión'), period);
  if (month) { const quitarMes290 = n('button', 'Todos los meses', 'soft small'); quitarMes290.type = 'button';
    quitarMes290.onclick = () => { month = ''; invoicePage = 0; render(); }; periodWrap290.append(quitarMes290); }
  const type = select([['', 'Todos los tipos'], ...Object.entries(KINDS)], invoiceKind, 'Tipo de CFDI');
  const state = select([['', 'Todos los estados SAT'], ['Vigente', 'Vigente'], ['Cancelado', 'Cancelado'], ['efos', 'Con 69-B'], ['none', 'Sin revisar todavía']], invoiceState, 'Estado SAT');
  const payState = select([['', 'Pagadas y pendientes'], ['pagada', 'Pagadas'], ['pendiente', 'Pendientes'], ['parcial', 'Parciales']], invoicePayState, 'Estado de pago');
  const order = select([['recent', 'Más recientes'], ['oldest', 'Más antiguos'],
    ['importe-mayor', 'Importe: de mayor a menor'], ['importe-menor', 'Importe: de menor a mayor']], invoiceOrder, 'Orden');
  /* Selector de contraparte (2.0.1 · nº 13): las empresas que
     aparecen como emisor o receptor en el ámbito en pantalla.
     Elegir una deja SOLO sus facturas, y el pie enseña el
     total de lo filtrado, presentado como lo que es. */
  const partesCp201 = new Map();
  for (const row of invoices) {
    if (scope && row.from.rfc !== scope && row.to.rfc !== scope) continue;
    for (const party of [row.from, row.to])
      if (party?.rfc && party.rfc !== scope && !partesCp201.has(party.rfc))
        partesCp201.set(party.rfc, party.name || party.rfc);
  }
  const cpSel201 = select([['', 'Todas las contrapartes'],
    ...[...partesCp201.entries()].sort((a, b) => a[1].localeCompare(b[1], 'es-MX'))
      .map(([rfc, nombre]) => [rfc, nombre + ' · ' + rfc])], invoiceContraparte201, 'Contraparte');
  const exportButton = action('Exportar CSV', exportCsv, undefined, 'down');
  /* Importar carpeta en 2 toques desde Facturas (1.7.4, pieza 1):
     lee la estructura tipo OneFacture (Emitidos/Recibidos/año/mes) por
     el mismo pipeline que los sueltos, los ZIP y los paquetes SAT. */
  const folderButton = action('Importar carpeta', async () => {
    await requireStorage();
    check(people.length, 'Agrega primero un RFC.');
    if (!importing) $('folder').click();
  }, undefined, 'folder');
  /* Selección múltiple (UX-14): descargar varios XML en un ZIP.
     Ronda Salidas (1.14.0): con servidor, la selección baja como
     ZIP ORDENADO de la capa de salidas (carpetas por sentido y mes,
     cancelados aparte, índice con folio y manifiesto); el ZIP plano
     local queda como ruta sin servidor. */
  const zipButton = action('Descargar seleccionados (ZIP)', async () => {
    check(invoiceSelection.size, 'Selecciona al menos un comprobante.');
    if (satToken) {
      zipButton.disabled = true; zipButton.textContent = 'Preparando el ZIP…';
      try {
        const data = await satApi('salidas/zip', { scope: 'seleccion', rfc: scope, ids: [...invoiceSelection] });
        download(new Blob([decode64(data.content)], { type: 'application/zip' }), data.name);
        announce('ZIP ordenado descargado con ' + invoiceSelection.size + ' comprobantes.');
      } catch (error) { toast(error.message, 'error'); }
      finally { zipButton.disabled = false; zipButton.textContent = 'Descargar seleccionados (ZIP)'; }
      return;
    }
    const entries = [];
    for (const id of invoiceSelection) {
      const file = await readStore('files', 'xml:' + id);
      if (file) entries.push({ name: id + '.xml', data: bytes(await file.blob.arrayBuffer()) });
    }
    check(entries.length, 'Ninguno de los seleccionados tiene XML guardado.');
    download(zipStore(entries), 'CFDI-seleccionados.zip');
    announce(entries.length + ' XML descargados en un ZIP.');
  }, undefined, 'down');
  /* Impresión por lote (1.6.16): todos los seleccionados en un solo
     documento imprimible, cada uno con su representación completa.
     En modo servidor (2.9.3 · F3): el documento combinado lo
     construye el SERVIDOR (salidas/cfdi con la lista de ids: el
     mismo constructor del PDF individual) y se DESCARGA — en vivo
     la ventana de impresión del navegador anunció «listos para
     imprimir» y no llegó a abrir ningún diálogo. Sin servidor
     (modo local), queda el camino de siempre: componer e imprimir. */
  const printButton = action('Imprimir seleccionados', async () => {
    if (typeof satToken !== 'undefined' && satToken) {
      const data = await satApi('salidas/cfdi', { ids: [...invoiceSelection], format: 'pdf', rfc: scope });
      download(new Blob([decode64(data.content)], { type: data.type || 'application/pdf' }), data.name);
      announce('Documento combinado descargado: ' + data.name + ' — ábrelo para imprimirlo; trae la representación de cada seleccionado.');
      return;
    }
    let printed = 0;
    for (const id of invoiceSelection) {
      const row = invoices.find(item => item.id === id);
      const file = await readStore('files', 'xml:' + id);
      if (!row || !file) continue;
      cfdiPrint(row, parseCfdiFull(bytes(await file.blob.arrayBuffer())), { append: printed > 0, print: false });
      printed++;
    }
    check(printed, 'Ninguno de los seleccionados tiene XML guardado.');
    setTimeout(() => window.print(), 80);
    announce(printed + ' comprobantes listos para imprimir en un solo documento.');
  }, undefined, 'print');
  const chips = n('div', undefined, 'filter-chips');
  const clearFilters = () => {
    term = ''; month = ''; invoiceKind = ''; invoiceState = ''; invoicePayState = ''; invoiceContraparte201 = ''; direction = 'Todos'; invoiceRapido240 = ''; invoicePage = 0; render();
  };
  /* Chips de filtros rápidos (2.4.0 · W4b, P5): una fila de
     UN TOQUE sobre el listado, con el conteo del MISMO
     cálculo de la tarjeta (datos240). Activar un chip deja la
     lista solo con sus facturas por el motor de siempre
     (invoiceRows + su predicado; «Canceladas del mes» activa
     además el filtro de siempre: direction + mes en curso);
     desactivarlo vuelve al listado completo (clearFilters).
     En móvil la fila se desplaza en horizontal (estilos en
     línea: las hojas de estilo no son territorio de esta
     tanda) sin romper el listado. */
  const rapidosBar240 = n('div', undefined, 'filter-chips facturas-rapidos240');
  rapidosBar240.dataset.rapidos240 = '1';
  rapidosBar240.style.display = 'flex';
  rapidosBar240.style.flexWrap = 'nowrap';
  rapidosBar240.style.overflowX = 'auto';
  rapidosBar240.style.gap = '7px';
  for (const def of FACTURAS_RAPIDOS240) {
    const chip = n('button', def.etiqueta + ' · ' + number.format(datos240.conteos[def.clave]), 'filter-chip');
    chip.type = 'button';
    chip.dataset.rapido240 = def.clave;
    chip.setAttribute('aria-pressed', String(invoiceRapido240 === def.clave));
    if (invoiceRapido240 === def.clave) chip.classList.add('primary');
    chip.style.flex = '0 0 auto';
    chip.style.whiteSpace = 'nowrap';
    chip.prepend(icon(def.icono));
    chip.onclick = () => {
      if (invoiceRapido240 === def.clave) { clearFilters(); return; }
      invoiceRapido240 = def.clave;
      if (def.clave === 'canceladas-mes') { direction = 'Canceladas'; month = datos240.mesKey; }
      invoicePage = 0; render();
    };
    rapidosBar240.append(chip);
  }
  const result = n('div');
  const update = () => {
    const rows = invoiceRows();
    const paidBy = paidByMap();
    exportButton.disabled = !rows.length;
    zipButton.disabled = !invoiceSelection.size;
    printButton.disabled = !invoiceSelection.size;
    zipButton.hidden = !invoiceSelection.size;
    printButton.hidden = !invoiceSelection.size;
    /* Chips de filtros activos con su aspa (UX-04): lo aplicado se ve y
       se quita sin cazar controles; y «Limpiar filtros» siempre a mano. */
    chips.replaceChildren();
    const activeChips = [];
    if (term) activeChips.push(['«' + term + '»', () => { term = ''; render(); }]);
    if (month) activeChips.push(['Mes ' + month.slice(5, 7) + '/' + month.slice(0, 4), () => { month = ''; render(); }]);
    if (invoiceKind) activeChips.push([KINDS[invoiceKind], () => { invoiceKind = ''; render(); }]);
    if (invoiceState) activeChips.push(['Estado: ' + invoiceState, () => { invoiceState = ''; render(); }]);
    if (invoiceContraparte201) activeChips.push(['Contraparte: ' + (partesCp201.get(invoiceContraparte201) || invoiceContraparte201),
      () => { invoiceContraparte201 = ''; render(); }]);
    /* El chip del sentido se llama «Sentido: …» (2.9.0 ·
       Bloque C): como chip desnudo repetía el nombre de la
       pestaña («Recibidos» dos veces con dos papeles). */
    if (direction !== 'Todos') activeChips.push(['Sentido: ' + direction, () => { direction = 'Todos'; render(); }]);
    for (const [label, clear] of activeChips) {
      const chip = n('button', label, 'filter-chip');
      chip.append(icon('close'));
      chip.type = 'button';
      chip.onclick = clear;
      chips.append(chip);
    }
    if (activeChips.length) chips.append(action('Limpiar filtros', clearFilters));
    invoicePage = Math.min(invoicePage, Math.max(0, Math.ceil(rows.length / 35) - 1));
    const sliced = rows.slice(invoicePage * 35, (invoicePage + 1) * 35);
    const foot = n('div', undefined, 'table-foot');
    foot.setAttribute('aria-live', 'polite');
    foot.append(n('span', number.format(rows.length) + ' comprobantes'));
    /* Total de lo filtrado (2.0.1 · nº 13): la suma de las
       facturas que los filtros dejan en pantalla (las
       canceladas fuera, como en todos los totales de la casa),
       presentada como lo que es: el total de lo filtrado. */
    if (invoiceContraparte201) {
      const totalFiltrado = rows.filter(row => !rowCancelled(row))
        .reduce((suma, row) => suma + totalCents(row), 0n);
      foot.append(n('span', 'Total de lo filtrado: $' + centsLabel(totalFiltrado)));
    }
    if (rows.length > 35) {
      const options = n('div', undefined, 'actions');
      const prev = action('Anterior', () => { invoicePage--; update(); });
      const next = action('Siguiente', () => { invoicePage++; update(); });
      prev.disabled = invoicePage === 0; next.disabled = (invoicePage + 1) * 35 >= rows.length;
      options.append(prev, n('span', String(invoicePage + 1)), next); foot.append(options);
    }
    const content = sliced.length ? grid(['', 'Emisor → receptor', 'Fecha', 'Folio', 'Tipo', 'Total', 'Estado SAT', 'Acción'], sliced.map(row => {
      const pick = input('checkbox');
      pick.checked = invoiceSelection.has(row.id);
