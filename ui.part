  if (el.dataset.textoRemoto250 === undefined) el.dataset.textoRemoto250 = el.textContent;
  if (paseoNasCliente250()) {
    el.textContent = 'Reserva: el paseo se hace desde casa (tu NAS)';
    boton.title = 'Tu ejecutor — La reserva: el programa de tu equipo. En esta instalación el Buzón y las Declaraciones se pasean desde casa, desde tu NAS: no es un paso necesario de ningún paseo';
  } else {
    el.textContent = el.dataset.textoRemoto250;
