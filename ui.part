   de responder para que su cifra sea la canónica. */
let saldosCarga290 = null;
function cargarSaldosServidor290() {
  if (typeof dineroServerInfo !== 'undefined' && dineroServerInfo.size) return Promise.resolve(true);
  if (typeof satToken === 'undefined' || !satToken) return Promise.resolve(false);
  if (!saldosCarga290) saldosCarga290 = satApi('money').then(data => {
    dineroServerInfo = new Map((data.balances || []).map(b => [b.id, b]));
    dineroCanceladasSrv = data.canceladas || null;
    dineroServerCargado = true;
    return true;
  }).catch(() => false);
  return saldosCarga290;
}
/* UNA función de plural para todo el sistema (2.9.0 · Bloque
