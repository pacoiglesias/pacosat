  reportes: ['Reportes', 'Los reportes del sistema en un solo sitio: totales, contrapartes, declaraciones y bancos, en PDF, Excel o impresos.', 'Exportación completa'],
  monitor: ['Vigilancia de CFDI', 'El estado de tus comprobantes en el SAT: vigentes, cancelados y por revisar.', 'Revisar mis CFDI ahora'],
