function urgenciaRfc200b(rfc, ahora = Date.now()) {
  const sd = typeof satData !== 'undefined' && satData ? satData : null;
  if (!sd || !rfc) return 0;
  let puntos = 0;
  const salud = saludRfc200b(rfc, ahora);
  if (salud.nivel === 'bad') puntos += 100; else if (salud.nivel === 'warn') puntos += 40;
  puntos += Math.min(30, Number(sd.tributario?.[rfc]?.sinAbrir || 0) * 10);
  puntos += Math.min(20, Number(sd.buzonUnread?.[rfc] || 0) * 4);
  const perfil = (sd.profiles || []).find(p => p.rfc === rfc);
  if (perfil?.certExpires) {
    const dias = Math.ceil((perfil.certExpires - ahora) / 86400000);
    if (dias <= 0) puntos += 90; else if (dias <= 30) puntos += 60; else if (dias <= 60) puntos += 30;
  }
  if ((sd.pendingProfiles || []).includes(rfc)) puntos += 80;
  return puntos;
