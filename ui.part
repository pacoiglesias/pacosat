function porCobrarCanonico290(rfc = '') {
  if (typeof dineroServerInfo !== 'undefined' && dineroServerInfo.size) {
    let cents = 0n, filas = 0;
    for (const e of dineroServerInfo.values()) {
      if (!e.receivable) continue;
      if (rfc && e.from?.rfc !== rfc) continue;
      const b = moneyCents(e.balance || '0');
      if (b > 0n) { cents += b; filas++; }
    }
    return { cents, filas, fuente: 'servidor' };
  }
  const paidBy = paidByMap();
  const own = new Set(people.map(p => p.id));
  let cents = 0n, filas = 0;
  for (const row of invoices) {
    if (row.kind !== 'I' || !own.has(row.from?.rfc)) continue;
    if (rfc && row.from.rfc !== rfc) continue;
    if (row.archived || invoiceStateOf(row) === 'Cancelado') continue;
    if (typeof dineroMarcados !== 'undefined' && dineroMarcados.has(row.id)) continue;
    const b = balanceOf(row, paidBy).balance;
    if (b > 0n) { cents += b; filas++; }
  }
  return { cents, filas, fuente: 'local' };
}
function porPagarCanonico290(rfc = '') {
  if (typeof dineroServerInfo !== 'undefined' && dineroServerInfo.size) {
    let cents = 0n, filas = 0;
    for (const e of dineroServerInfo.values()) {
      if (!e.payable) continue;
      if (rfc && e.to?.rfc !== rfc) continue;
      const b = moneyCents(e.balance || '0');
      if (b > 0n) { cents += b; filas++; }
    }
    return { cents, filas, fuente: 'servidor' };
  }
  const paidBy = paidByMap();
  const own = new Set(people.map(p => p.id));
  let cents = 0n, filas = 0;
  for (const row of invoices) {
    if (row.kind !== 'I' || !own.has(row.to?.rfc)) continue;
    if (rfc && row.to.rfc !== rfc) continue;
    if (row.archived || invoiceStateOf(row) === 'Cancelado') continue;
    if (typeof dineroMarcados !== 'undefined' && dineroMarcados.has(row.id)) continue;
    const b = balanceOf(row, paidBy).balance;
    if (b > 0n) { cents += b; filas++; }
  }
