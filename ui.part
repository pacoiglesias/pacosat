function medallon200b(rfc, nombre) {
  const el = n('span', undefined, 'rfc-medallon200b');
  el.textContent = String(nombre || rfc || '?').trim().charAt(0).toUpperCase() || '?';
  el.setAttribute('aria-hidden', 'true');
  const pal = rfcPaleta200b(rfcColorClave200b(rfc));
  el.dataset.color = pal ? pal[0] : '';
  if (pal) { el.style.background = pal[1]; el.style.color = '#ffffff'; }
  el.title = (nombre || rfc || '') + (pal ? ' · color ' + pal[2] : '');
  return el;
}
/* Salud compuesta por RFC (pieza 8): puerta de ESE RFC +
   ejecutor (el equipo es de la casa, sirve a todos) + avisos
   sin abrir de su Buzón Tributario. Verde/ámbar/rojo con su
   porqué en una frase; sin datos, gris honesto. */
function saludRfc200b(rfc, ahora = Date.now()) {
  const sd = typeof satData !== 'undefined' && satData ? satData : null;
  if (!sd || !rfc) return { nivel: 'dim', porque: 'sin datos todavía' };
  const puerta = sd.puerta?.[rfc] || null;
  const ex = sd.ejecutor || null;
  const sinAbrir = Number(sd.tributario?.[rfc]?.sinAbrir || 0);
  const causa = puerta && puerta.probada && puerta.ok === false ?
    (typeof causaP200 === 'function' ? causaP200(puerta, ex, ahora) : null) : null;
  if (causa && (causa.tipo === 'equipo' || causa.tipo === 'sin-equipo'))
    return { nivel: 'bad', porque: 'tu equipo no responde: la puerta no se puede probar' };
  if (causa && causa.tipo === 'efirma' && !causa.vieja)
    return { nivel: 'bad', porque: 'la puerta del SAT no abre con su e.firma' };
  if (ex && ex.emparejado && !ex.enLinea)
    return { nivel: 'warn', porque: 'tu equipo no responde desde el ' + fmtFechaHora(ex.ultimoVisto) };
  if (causa && causa.vieja)
    return { nivel: 'warn', porque: 'la foto de su puerta es vieja (' + fmtFechaHora(puerta.probada) + ')' };
  if (sinAbrir > 0) return { nivel: 'warn', porque: number.format(sinAbrir) + ' notificación(es) del Buzón sin abrir' };
  if (puerta && puerta.ok) return { nivel: 'ok', porque: 'puerta abierta y sin avisos sin abrir' };
  return { nivel: 'dim', porque: 'puerta sin probar todavía' };
}
/* Urgencia de un RFC para ordenar listas y el panel (norma del
