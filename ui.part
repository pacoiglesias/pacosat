  const descargar = n('button', 'Descargar este mes', 'primary');
  descargar.type = 'button';
  descargar.onclick = () => { if (scope && typeof downloadSheet === 'function') downloadSheet(scope, { start: rango.start, end: rango.end }); else showSatDownload(); };
  fila.append(descargar);
  const cubierto = invoices.some(row => row.date.startsWith(mesKey) && (!scope || row.from.rfc === scope || row.to.rfc === scope));
  if (cubierto) {
    const pasado = n('button', 'Descargar el mes pasado', 'soft');
