const funcionNorm240 = texto => String(texto || '').toLocaleLowerCase('es-MX')
  .normalize('NFD').replace(/[̀-ͯ]/g, '').replace(/\s+/g, ' ').trim()
  .replace(/^(ir a|abrir|ver|quiero|busca|buscar)\s+/, '');
/* Resolver PURO: exacto contra nombre/frases; si no, contención
   (la frase contiene lo tecleado o al revés, con 4+ caracteres)
   eligiendo la frase más larga que case — determinista y sin
   estado: la misma consulta da siempre la misma función. */
function funcionBuscador240(consulta) {
  const q = funcionNorm240(consulta);
  if (!q) return null;
  for (const entrada of FUNCIONES240) {
    if (funcionNorm240(entrada.nombre) === q || entrada.frases.includes(q)) return entrada;
  }
  let mejor = null, mejorLargo = 0;
  for (const entrada of FUNCIONES240) {
    for (const frase of [funcionNorm240(entrada.nombre), ...entrada.frases]) {
      if (frase.length >= 4 && q.length >= 4 && (frase.includes(q) || q.includes(frase)) && frase.length > mejorLargo) {
        mejor = entrada; mejorLargo = frase.length;
      }
    }
  }
  return mejor;
}
/* Aterrizaje en la función: primero la pantalla (con su sección
   de Ajustes si la entrada la trae; los alias de vista los
   traduce navigate), después su tarjeta/campo exacto con
   reintentos — las pantallas diferidas (Salud, Registro, Pagos,
   Reportes) pintan un instante después de navegar. Si la
   tarjeta no existe en el destino, se queda la pantalla: nunca
   un hueco muerto (la regla de destino200b). */
let funcionDestinoTimer240 = null;
function irFuncion240(entrada) {
  if (!entrada) return;
  if (entrada.seccion && entrada.vista === 'settings') ajustesSection = entrada.seccion;
  navigate(entrada.vista);
  if (!entrada.destino) { announce('Abriendo la función «' + entrada.nombre + '».'); return; }
  const selector240 = entrada.destino.startsWith('destino:') ? '[data-destino200b="' + entrada.destino.slice(7) + '"]'
    : entrada.destino.startsWith('hero:') ? '[data-hero240="' + entrada.destino.slice(5) + '"]'
    : entrada.destino === 'bitacora' ? '[data-bitacora240="1"]'
    : entrada.destino === 'banco240' ? '[data-banco240]'
    : entrada.destino === 'cambios' ? '.cambios230'
    : entrada.destino === 'version240' ? '[data-version240]'
    : entrada.destino === 'atajos240' ? '[data-atajos240]'
    : entrada.destino === 'buscar-dentro' ? 'input[aria-label="Buscar dentro de los documentos"]' : '';
  if (!selector240) { announce('Abriendo la función «' + entrada.nombre + '».'); return; }
  if (funcionDestinoTimer240) { clearTimeout(funcionDestinoTimer240); funcionDestinoTimer240 = null; }
  let intentos = 0;
  const buscar = () => {
    const el = document.querySelector(selector240);
    if (el) {
      realzar200b(el);
      if (el.tagName === 'INPUT' || el.tagName === 'TEXTAREA') { try { el.focus(); } catch { /* el realce basta */ } }
      else { const boton = el.querySelector ? el.querySelector('button') : null; if (boton) { try { boton.focus({ preventScroll: true }); } catch { /* el realce basta */ } } }
      announce('Función «' + entrada.nombre + '»: ' + entrada.donde + '.');
      return;
    }
    intentos += 1;
    if (intentos <= 4) funcionDestinoTimer240 = setTimeout(buscar, intentos === 1 ? 350 : 600);
    else announce('Abriendo la función «' + entrada.nombre + '».');
  };
  buscar();
}
/* Cableado del buscador global para FUNCIONES: este oyente se
   registra ANTES que el de documentos (ui.part viaja antes que
   workflows.part en el artefacto), así que al pulsar Enter con
   una función que case, la función gana y el camino de
   documentos no se dispara; sin función que case, no toca nada
   y el buscador de siempre sigue su curso. Mientras se teclea,
   la franja «Función» de la cabecera (layout.part) nombra la
   función y su destino — un resultado de función se distingue
   de uno de documento porque se anuncia como FUNCIÓN y lleva
   directo a ella, sin lista de documentos de por medio. */
(function buscadorFunciones240() {
  const input = typeof document !== 'undefined' ? document.getElementById('global-search') : null;
  if (!input || !input.addEventListener) return;
  const pintar = () => {
    const barra = document.getElementById('funcion-sugerida240');
    if (!barra) return;
    const entrada = funcionBuscador240(input.value);
    if (!entrada) { barra.hidden = true; return; }
    const titulo = document.getElementById('funcion-sugerida240-titulo');
    const texto = document.getElementById('funcion-sugerida240-texto');
    if (titulo) titulo.textContent = 'Función · ' + entrada.nombre;
    if (texto) texto.textContent = 'Está en ' + entrada.donde + '. Pulsa Enter o «Ir a la función» y te llevo directo a ella.';
    barra.hidden = false;
    const ir = document.getElementById('funcion-sugerida240-ir');
    if (ir) ir.onclick = () => { barra.hidden = true; irFuncion240(entrada); };
  };
  input.addEventListener('input', pintar);
  input.addEventListener('keydown', event => {
    if (event.key !== 'Enter') return;
    const entrada = funcionBuscador240(input.value);
    if (!entrada) return;
    event.preventDefault();
    event.stopImmediatePropagation();
    const barra = document.getElementById('funcion-sugerida240');
    if (barra) barra.hidden = true;
    irFuncion240(entrada);
  });
})();
/* Franja compacta de acciones del día (piezas 1 y 2 · M5/O1):
   las cuatro acciones del día, sin los 7 bloques de antes.
   «Descargar este mes» abre la hoja con el periodo precargado
   (2 toques hasta «Pedir y descargar»); si el mes corriente ya
   tiene CFDI en el expediente, la franja ofrece también el mes
   pasado completo. */
function hoyAcciones200b() {
  const wrap = panel('Acciones del día');
  wrap.dataset.bloque200b = 'acciones';
  const fila = n('div', undefined, 'hoy-acciones200b');
  const hoy = new Date();
  const mesKey = hoy.getFullYear() + '-' + String(hoy.getMonth() + 1).padStart(2, '0');
  const rango = typeof downloadShortcutRange === 'function' ?
    downloadShortcutRange('mes', hoy.toISOString().slice(0, 10)) : { start: mesKey + '-01', end: hoy.toISOString().slice(0, 10) };
  const descargar = n('button', 'Descargar este mes', 'primary');
  descargar.type = 'button';
  descargar.onclick = () => { if (scope && typeof downloadSheet === 'function') downloadSheet(scope, { start: rango.start, end: rango.end }); else showSatDownload(); };
  fila.append(descargar);
  const cubierto = invoices.some(row => row.date.startsWith(mesKey) && (!scope || row.from.rfc === scope || row.to.rfc === scope));
  if (cubierto) {
    const pasado = n('button', 'Descargar el mes pasado', 'soft');
    pasado.type = 'button';
    pasado.onclick = () => {
      const r2 = downloadShortcutRange('mes-pasado', hoy.toISOString().slice(0, 10));
      if (scope && typeof downloadSheet === 'function') downloadSheet(scope, { start: r2.start, end: r2.end }); else showSatDownload();
    };
    fila.append(pasado);
  }
  const buzonBtn = n('button', 'Buzón Tributario', 'soft');
  buzonBtn.type = 'button';
  buzonBtn.onclick = () => irDestino200b('tributario', 'buzon');
  const declBtn = n('button', 'Declaraciones', 'soft');
  declBtn.type = 'button';
  declBtn.onclick = () => navigate('declaraciones');
  const constBtn = n('button', 'Constancia', 'soft');
  constBtn.type = 'button';
  constBtn.onclick = () => irDestino200b('sat', 'constancia');
  fila.append(buzonBtn, declBtn, constBtn);
  /* Visibilidad (2.0.1): la Opinión y las Listas 69-B vivían
     solo dentro del Centro SAT — la Opinión sin botón propio
     en Hoy y las Listas como pestaña sin señalización. Las
     dos entran en la franja del día: la Opinión a su tarjeta
     exacta, como la Constancia, y las Listas a su vista, que
     abre con su resumen y su fecha. Solo el acceso: el estado
     de las Listas vive en su vista y en su línea de Salud. */
  for (const [etiqueta, ir] of [['Opinión', () => irDestino200b('sat', 'opinion')],
      ['Listas 69-B', () => { satTab = 'listas'; navigate('sat'); }]]) {
    const boton = n('button', etiqueta, 'soft');
    boton.type = 'button';
    boton.onclick = ir;
    fila.append(boton);
  }
  const ponte = n('button', 'Ponte al día', 'soft');
  ponte.type = 'button';
  ponte.onclick = () => { ponte.disabled = true;
    ensureLazyPart('salud').then(() => ponteAlDia200e(ponte)).catch(() => { ponte.disabled = false; }); };
  fila.append(ponte);
  wrap.append(fila);
  return wrap;
}
/* Línea-resumen de salud y respaldo (pieza 1): su casa es
   Ajustes › Estado del sistema (y Respaldos); Hoy solo enlaza
   con su semáforo — una línea, un sitio dueño. */
function hoySaludLinea200b() {
  const wrap = panel();
  wrap.dataset.bloque200b = 'salud-linea';
  const fila = n('div', undefined, 'cp-row');
  const health = typeof satData !== 'undefined' && satData ? satData.health : null;
  const nivel = !health ? 'dim' : health.level === 'mal' ? 'bad' : health.level === 'vigilar' ? 'warn' : 'ok';
  const bh = typeof satData !== 'undefined' && satData ? satData.backupHealth : null;
  const textoRespaldo = !bh ? '' : bh.failed ? ' · el último respaldo falló' :
    bh.lastOk ? ' · respaldo del ' + fmtFechaHora(bh.lastOk) : '';
  fila.append(statusPill(nivel, nivel === 'bad' ? 'Salud: algo va mal' : nivel === 'warn' ? 'Salud: a vigilar' : nivel === 'ok' ? 'Salud: todo bien' : 'Salud: sin datos'),
    n('span', 'Salud del sistema y respaldo' + textoRespaldo + ' — su detalle vive en su pantalla.'));
  const ir = n('button', 'Ver la salud', 'soft small');
  ir.type = 'button';
  ir.onclick = () => navigate('salud');
  fila.append(ir);
  wrap.append(fila);
  return wrap;
}
/* ===== Modo «Solo lo urgente» de Hoy (2.0.1 · nº 4) =====
   Un interruptor: esconde lo que está bien (las líneas de
   estado y las tarjetas de acción) y deja solo los gestos
   pendientes («Lo que te necesita», que va tras este bloque)
   y los vencimientos (la tira fiscal). El modo normal no
   cambia ni crece: su medida sigue siendo la de la limpieza. */
let hoyUrgente201 = (() => { try { return localStorage.getItem('pacosat-hoy-urgente201') === '1'; } catch { return false; } })();
/* ===== Tira fiscal del mes en Hoy (2.0.1 · nº 15) =====
   Los vencimientos del RFC activo, del mes en curso, desde la
   MISMA fuente del calendario y del ICS (GET fiscal/calendar:
   sus eventos ya traen rfc, fecha y días que faltan). La tira
   ES la vista de los vencimientos en Hoy: ningún otro bloque
   de Hoy repite estas fechas. Sin vencimientos este mes, la
   tira no se pinta (Hoy no crece con huecos). */
function hoyFiscalTira201() {
  const tira = n('div', undefined, 'traffic-strip');
  if (typeof satToken === 'undefined' || !satToken) { tira.remove(); return tira; }
  satApi('fiscal/calendar').then(data => {
    if (!tira.isConnected) return;
    const mes = new Date().toISOString().slice(0, 7);
    const eventos = (data?.events || [])
      .filter(e => (!scope || e.rfc === scope) && String(e.date || '').startsWith(mes))
      .sort((a, b) => String(a.date).localeCompare(String(b.date)));
    if (!eventos.length) { tira.remove(); return; }
    /* (2.9.13 · mejora 3) La tira se DIBUJA: una línea del
       mes con un punto por vencimiento, colocado en su día,
       con el color de su semáforo y su etiqueta con los días
       que quedan. Es la misma fuente y el mismo filtro de
       siempre (el calendario fiscal, este mes, este RFC):
       cambia el dibujo, no el dato. */
    tira.classList.add('hoy-venc-tira2913');
    tira.append(n('strong', 'Vencimientos de ' + MESES_TOT[Number(mes.slice(5, 7)) - 1] + ':'));
    const linea = n('div', undefined, 'hoy-venc-linea2913');
    const diasMes = new Date(Number(mes.slice(0, 4)), Number(mes.slice(5, 7)), 0).getDate();
    for (const e of eventos) {
      const dia = Number(String(e.date).slice(8)) || 1;
      const nodo = n('div', undefined, 'hoy-venc-nodo2913');
      nodo.style.left = 'calc(' + ((dia - 0.5) / diasMes * 100).toFixed(2) + '% )';
      const punto = n('span', undefined, 'hoy-venc-punto2913');
      punto.dataset.state = e.daysLeft < 0 ? 'bad' : e.daysLeft <= 5 ? 'warn' : 'dim';
      const etiqueta = n('span', e.title + ' · día ' + dia +
        (e.daysLeft == null ? '' : e.daysLeft < 0 ? ' · venció hace ' + diasTexto290(-e.daysLeft)
          : e.daysLeft === 0 ? ' · vence hoy' : ' · en ' + diasTexto290(e.daysLeft)), 'hoy-venc-etiqueta2913');
      nodo.append(punto, etiqueta);
      nodo.title = e.title + ' · ' + e.date;
      linea.append(nodo);
    }
    tira.append(linea);
  }).catch(() => tira.remove());
  return tira;
}
/* ===== «A medias» en Hoy (2.0.1 · nº 16) =====
   Los trabajos que quedaron a medias (GET /api/a-medias201),
   como líneas con su botón «Seguir» — el destino que el
   servidor deja por pieza — dentro del flujo de «Lo que te
   necesita»: el panel solo aparece si hay algo a medias, así
   que Hoy no crece cuando no hay nada interrumpido. */
function aMedias201Panel() {
  const wrap = panel('A medias', 'Trabajos que quedaron a medias: cada uno sigue donde quedó, con su botón.');
  const body = n('div');
  wrap.append(body);
  wrap.style.display = 'none';
  if (typeof satToken === 'undefined' || !satToken) return wrap;
  satApi('a-medias201').then(data => {
    if (!wrap.isConnected) return;
    const items = (data?.items || []).filter(item => !scope || !item.rfc || item.rfc === scope);
    if (!items.length) return;
    wrap.style.display = '';
    for (const item of items) {
      const fila = n('div', undefined, 'gestos-row');
      const txt = n('div', undefined, 'gestos-txt');
      txt.append(n('strong', item.texto),
        n('p', (item.rfc ? item.rfc + ' · ' : '') + (item.at ? 'quedó a medias el ' + fmtFechaHora(item.at) : '')));
      fila.append(txt);
      /* «Seguir» tras cancelar (2.3.0 · pieza 6): si el ítem
         trae el trabajo (jobId), el botón REANUDA de verdad con
         POST /api/trabajos/seguir y enseña el texto devuelto —
         también el ok:false con su motivo. Sin trabajo que
         reanudar, queda el gesto de siempre: ir a su vista. */
      const jobId230 = item.seguir?.jobId || item.jobId || '';
      const vista = item.seguir?.vista || '';
      if (jobId230 && typeof seguirBoton230 === 'function') {
        fila.append(seguirBoton230(jobId230));
      } else if (vista) {
        const seguir = n('button', 'Seguir', 'primary small');
        seguir.type = 'button';
        seguir.onclick = () => {
          if (vista === 'bancos') { dineroTab = 'bancos'; navigate('money'); }
          else navigate(vista);
        };
        fila.append(seguir);
      }
      body.append(fila);
    }
  }).catch(() => {});
  return wrap;
}
/* ===== Hoy: «Qué cambió desde ayer» (2.3.0 · pieza 10) =====
   Tarjeta compacta alimentada por GET /api/cambios: una línea
   por cambio REAL desde ayer a las 00:00, máximo 5 y el resto
   se cuenta y se manda al Registro. Sin cambios, la tarjeta
   NO aparece: Hoy no crece con tarjetas vacías. */
function cambiosLineas230(data) {
  const lineas = Array.isArray(data?.lineas) ? data.lineas : [];
  const validas = lineas.filter(l => l && typeof l.texto === 'string' && l.texto.trim());
  return { visibles: validas.slice(0, 5), total: validas.length };
}
function cambiosPanel230() {
  const wrap = n('section', undefined, 'panel cambios230');
  wrap.style.display = 'none';
  if (typeof satToken === 'undefined' || !satToken) return wrap;
  const ruta = 'cambios' + (scope ? '?rfc=' + encodeURIComponent(scope) : '');
  satApi(ruta).then(data => {
    if (!wrap.isConnected) return;
    const { visibles, total } = cambiosLineas230(data);
    if (!total) return;
    wrap.style.display = '';
    wrap.append(n('h3', 'Qué cambió desde ayer'));
    for (const linea of visibles) {
      const fila = n('div', undefined, 'cp-row');
      if (linea.at) fila.append(statusPill(linea.clase === 'mal' ? 'bad' : linea.clase === 'bien' ? 'ok' : 'dim',
        fmtFechaHora(linea.at)));
      fila.append(n('span', linea.texto));
      wrap.append(fila);
    }
    if (total > visibles.length)
      wrap.append(n('p', 'Y ' + (total - visibles.length) + ' cambio(s) más desde ayer.', 'muted'));
    const actos = n('div', undefined, 'actions');
    const ver = n('button', 'Ver en el Registro', 'soft small');
    ver.type = 'button';
    ver.onclick = () => navigate('registro');
    actos.append(ver);
    wrap.append(actos);
  }).catch(() => {});
  return wrap;
}
/* ===== Hoy: la foto por RFC, «Tus empresas» (2.3.0 · pieza 11) =====
   GET /api/foto-rfc trae, por RFC, su color y cuatro fotos con
   fecha: puerta, buzón, declaraciones y listas. Una fila por
   RFC con su medallón de color y cuatro semáforos con su dato
   corto; tocar la fila selecciona ese RFC y lleva a Hoy (su
   radiografía). Con un solo RFC, una sola fila compacta. Si el
   servidor aún no da la foto, la sección no aparece. */
function fotoSemaforos230(f) {
  const salida = [];
  const puerta = f?.puerta;
  salida.push({ nombre: 'Puerta', estado: !puerta ? 'dim' : puerta.ok ? 'ok' : 'bad',
    texto: !puerta ? 'sin probar' : puerta.ok ? 'abre' : 'no abre' });
  const buzon = f?.buzon;
  const pend = Number(buzon?.pendientes) || 0, com = Number(buzon?.comunicados) || 0;
  /* Sin última consulta no hay «al día» (2.9.0 · Bloque C):
     la misma fuente que el menú y el panel — si nunca se
     consultó, la fila lo dice, aunque no haya pendientes. */
  salida.push({ nombre: 'Buzón', estado: !buzon || !buzon.fecha ? 'dim' : (pend || com) ? 'warn' : 'ok',
    texto: !buzon || !buzon.fecha ? 'sin consultar' : (pend || com)
      ? (pend ? pend + ' por leer' : '') + (pend && com ? ' · ' : '') + (com ? com + ' comunicado(s)' : '')
      : 'al día' });
  const decl = f?.declaraciones;
  salida.push({ nombre: 'Declaraciones', estado: !decl ? 'dim' : decl.faltaMes ? 'warn' : 'ok',
    texto: !decl ? 'sin datos'
      : decl.faltaMes ? 'falta ' + (typeof declFaltaMes230 === 'function' ? declFaltaMes230(decl.faltaMes) : String(decl.faltaMes))
      : (Number(decl.conocidas) || 0) + ' de ' + (decl.ejercicio || '') + ' · al día' });
  const listas = f?.listas;
  const sen = Number(listas?.senaladas);
  const propias290 = Number(listas?.propias) || 0;
  /* El número es el del cruce (contrapartes señaladas, el de
     la pantalla de Listas); si el señalado es el PROPIO RFC,
     se dice primero y peor (2.9.0 · Bloque C). */
  salida.push({ nombre: 'Listas', estado: !listas || Number.isNaN(sen) ? 'dim' : (propias290 > 0 || sen > 0) ? 'bad' : 'ok',
    texto: !listas || Number.isNaN(sen) ? 'sin comprobar'
      : propias290 > 0 ? 'tu RFC en listados'
      : sen > 0 ? sen + ' señalada(s)' : 'sin señaladas' });
  return salida;
}
function fotoRfcPanel230() {
  const wrap = n('section', undefined, 'panel foto-rfc230');
  wrap.style.display = 'none';
  if (typeof satToken === 'undefined' || !satToken) return wrap;
  satApi('foto-rfc').then(data => {
    if (!wrap.isConnected) return;
    const rfcs = (data?.rfcs || []).filter(f => f && f.rfc);
    if (!rfcs.length) return;
    wrap.style.display = '';
    wrap.append(n('h3', 'Tus empresas'));
    for (const f of rfcs) {
      const fila = n('button', undefined, 'foto-rfc-fila230');
      fila.type = 'button';
      /* El color de la fila es el que trae la foto; si es una
         clave de la paleta cerrada, manda sobre el medallón. */
      const medallon = medallon200b(f.rfc, f.nombre || f.rfc);
      const paletaFoto = typeof rfcPaleta200b === 'function' ? rfcPaleta200b(f.color) : null;
      if (paletaFoto) { medallon.style.background = paletaFoto[1]; medallon.style.color = '#ffffff'; medallon.dataset.color = paletaFoto[0]; }
      fila.append(medallon);
      const txt = n('span', undefined, 'foto-rfc-txt230');
      txt.append(n('strong', (f.nombre || f.rfc) + (f.nombre ? ' · ' + f.rfc : '')));
      const semaforos = n('span', undefined, 'foto-rfc-semaforos230');
      /* La puerta sale de esta foto (2.3.2 · M-9): su línea
         vive en la barra lateral (la del menú, de la 2.0.2) y
         en el estado de Hoy; aquí se conservan SOLO los
         semáforos por-RFC y distintos (buzón, declaraciones
         y listas de cada empresa). fotoSemaforos230 sigue
         calculándola: lo que cambia es solo el pintado. */
      for (const s of fotoSemaforos230(f).filter(s => s.nombre !== 'Puerta'))
        semaforos.append(statusPill(s.estado, s.nombre + ': ' + s.texto, '', null, true));
      txt.append(semaforos);
      fila.append(txt);
      fila.onclick = () => {
        scope = f.rfc;
        const sel = $('scope'); if (sel) sel.value = scope;
        const selTop = $('scope-top'); if (selTop) selTop.value = scope;
        navigate('home');
      };
      wrap.append(fila);
    }
  }).catch(() => {});
  return wrap;
}
/* ===== Hoy, mando único y corto (2.0.1, orden directa de
   Paco: «sigo viendo algo enredado; podría ser más limpio y
   práctico») =====
   Hoy deja de ser un resumen largo con bloques repetidos y pasa
   a ser SOLO esto, en este orden:
   (a) una línea de estado por pieza — puerta, ejecutor, última
       descarga y listas — cada una con su fecha, salida del dato
       que el cliente ya tiene (satData y el resumen de listas);
   (b) «Lo que te necesita» (el panel de gestos, que sigue tras
       este bloque en home());
   (c) las 4 acciones grandes con su estado y su fecha, y su
       botón HACE la cosa desde Hoy: descargar despacha la
       descarga del mes, buzón despacha la consulta, declara-
       ciones despacha la recuperación del ejercicio y Documen-
       tos abre su pantalla en un toque. Nada de botones que
       llevan a otra pantalla con otro botón.
   Constancia y Opinión NO viven aquí: su único sitio es
   Documentos (cero duplicados entre pantallas). */
/* ===== Ejecutor verificable: su residencia (2.3.0 · pieza 5) =====
   /api/status gana ejecutor.residencia { registrada, protocolo,
   rechazada, instancias } cuando el ejecutor lo reporta. La
   línea se pinta igual en Hoy y en la tarjeta del ejecutor de
   Salud, desde esta única lectura: si el ejecutor aún no lo
   reporta, dice «sin reportar todavía» — no se finge un sí. */
function residenciaTexto230(ejecutor) {
  const residencia = ejecutor && typeof ejecutor === 'object' ? ejecutor.residencia : null;
  if (!residencia || typeof residencia !== 'object') return 'Residente: sin reportar todavía';
  return 'Residente: ' + (residencia.registrada ? 'sí' : 'no') +
    ' · Instancias: ' + (Number(residencia.instancias) || 0);
}
function hoyMando201(gestos232 = null) {
  const wrap = n('section', undefined, 'panel');
  const sd = typeof satData !== 'undefined' && satData ? satData : null;
  const rfc = scope;
  const perfil = (sd?.profiles || []).find(p => p.rfc === rfc) || null;
  /* Interruptor «Solo lo urgente» (nº 4): en ese modo no se
     pintan ni las líneas de estado ni las tarjetas de acción;
     quedan los gestos (tras este bloque) y la tira fiscal. */
  const filaModo = n('div', undefined, 'actions');
  const modoBtn = n('button', hoyUrgente201 ? 'Ver Hoy completo' : 'Solo lo urgente', 'soft small');
  modoBtn.type = 'button';
  modoBtn.onclick = () => {
    hoyUrgente201 = !hoyUrgente201;
    try { localStorage.setItem('pacosat-hoy-urgente201', hoyUrgente201 ? '1' : ''); } catch {}
    render();
  };
  filaModo.append(modoBtn);
  if (hoyUrgente201) filaModo.append(n('span', 'Solo tus gestos pendientes y los vencimientos del mes.', 'muted'));
  wrap.append(filaModo);
  /* (a) Estado de las piezas, una línea por pieza con su fecha. */
  const estado = n('div', undefined, 'hoy-estado201');
  const linea = (etiqueta, texto) => {
    const fila = n('div', undefined, 'cp-row');
    fila.append(n('strong', etiqueta), n('span', texto));
    estado.append(fila);
    return fila;
  };
  const puerta = rfc ? sd?.puerta?.[rfc] : null;
  /* (2.8.0 · diseño 12) Cada línea de estado lleva SU gesto a
     un toque: Hoy deja de ser un tablón y pasa a mando — ver y
     resolver en el mismo sitio. El gesto de la puerta es la
     prueba de siempre (salud/puerta): en sede remota se encola
     para tu equipo; en sede NAS corre desde casa, y el toast
     dice lo que el servidor responda, sin fingir la sede. */
  const gestoPuerta280 = rfc ? { texto: 'Probar la puerta', hacer: async btn => {
    btn.disabled = true;
    const textoOriginalBtn293 = btn.textContent;
    btn.textContent = 'Probando la puerta…';
    const probadaAntes293 = satData?.puerta?.[rfc]?.probada || 0;
    const pintarPuerta293 = p => {
      const span = filaPuerta280.querySelector('span');
      if (span && p) span.textContent = (p.ok ? 'abre' : 'no abre') + ' · probada el ' + fmtFechaHora(p.probada) +
        (p.ok ? '' : ' — ' + (p.error || 'sin motivo'));
    };
    try {
      /* La prueba corre y su resultado se PINTA (2.9.3 · F1):
         en sede NAS el servidor ahora sí la corre y responde
         con su veredicto; si la respuesta se pierde por el
         camino (la sesión fría puede tardar), manda la marca
         re-leída del estado — patrón de la skill de verdad de
         estado: una respuesta perdida no es un fallo. */
      const r = await satApiGuardar('salud/puerta', { rfc }, async () => {
        if (typeof pollSat === 'function') await pollSat().catch(() => {});
        return (satData?.puerta?.[rfc]?.probada || 0) > probadaAntes293;
      });
      if (r?.aplicadoTrasError) {
        const p = satData?.puerta?.[rfc];
        pintarPuerta293(p);
        toast('La prueba corrió y su respuesta se perdió por el camino: la puerta ' +
          (p?.ok ? 'abre' : 'NO abre') + ' (probada el ' + fmtFechaHora(p?.probada) + '), re-leído del estado.', p?.ok ? 'ok' : 'error');
      } else if (r?.probada) {
        const p = { ok: Boolean(r.ok), probada: r.probadaEn, error: r.ok ? '' : (r.error || '') };
        if (satData?.puerta) satData.puerta[rfc] = { ...p, errorKind: r.errorKind || '' };
        pintarPuerta293(p);
        toast(r.ok ? 'La puerta abre: la e.firma entró al portal (probada ahora mismo).'
          : 'La puerta NO abre: ' + (r.error || 'sin motivo'), r.ok ? 'ok' : 'error');
      } else if (r?.encolado) {
        toast('Prueba de la puerta pedida: tu equipo la corre al recogerla.', 'ok');
      } else {
        toast(r?.motivo || 'La prueba no se encoló.', 'error');
      }
    } catch (error) { toast(error.message, 'error'); }
    /* (2.9.13 · A3) La foto nueva llega también al encabezado
       y al selector en el sitio, sin cambiar de panel. */
    if (typeof puertaRefrescarEnSitio2913 === 'function')
      await puertaRefrescarEnSitio2913(rfc).catch(() => {});
    btn.disabled = false;
    btn.textContent = textoOriginalBtn293;
  } } : null;
  const filaPuerta280 = linea('Puerta del SAT', !puerta ? 'sin probar todavía'
    : (puerta.ok ? 'abre' : 'no abre') + ' · probada el ' + fmtFechaHora(puerta.probada));
  if (gestoPuerta280) {
    const actosPuerta280 = n('div', undefined, 'actions');
    const botonPuerta280 = n('button', gestoPuerta280.texto, 'soft small');
    botonPuerta280.type = 'button';
    botonPuerta280.onclick = () => gestoPuerta280.hacer(botonPuerta280);
    actosPuerta280.append(botonPuerta280);
    filaPuerta280.append(actosPuerta280);
  }
  const ej = sd?.ejecutor;
  if (sd?.paseo === 'nas') {
    /* Sede NAS (2.8.0): la línea del ejecutor no es un paso de
       ningún paseo — la línea dice dónde corre el paseo y su
       gesto es el de la puerta, que es lo que el paseo usa. */
    const filaPaseo280 = linea('Paseo en casa', 'el Buzón y las Declaraciones se pasean desde tu NAS, con tu e.firma guardada; tu ejecutor queda como reserva');
    /* Sin segundo «Probar la puerta» (2.9.0 · Bloque C): el
       gesto vive en la línea de la Puerta, justo encima; aquí
       se repetía el mismo botón en la misma tarjeta. */
  } else {
    /* La residencia del ejecutor viaja en la misma línea (2.3.0 ·
       pieza 5): «Residente: sí/no · Instancias: n» si el ejecutor
       lo reporta; «sin reportar todavía» si aún no. Su gesto
       (2.8.0 · diseño 12): emparejar si no hay ninguno,
       despertarlo si está dormido, abrirlo si está en línea. */
    const filaEj280 = linea('Tu ejecutor', (!ej?.emparejado ? 'sin emparejar todavía'
      : (ej.enLinea ? 'en línea' : 'sin señal') + (ej.ultimoVisto ? ' · última señal el ' + fmtFechaHora(ej.ultimoVisto) : '')) +
      ' · ' + residenciaTexto230(ej));
    const actosEj280 = n('div', undefined, 'actions');
    let hayGestoEj280 = false;
    if (!ej?.emparejado) {
      const emparejar280 = n('button', 'Emparejar', 'soft small');
      emparejar280.type = 'button';
      emparejar280.onclick = () => navigate('ejecutor');
      actosEj280.append(emparejar280);
      hayGestoEj280 = true;
    } else if (!ej.enLinea && typeof ejecutarAqui201 === 'function') { actosEj280.append(ejecutarAqui201(true)); hayGestoEj280 = true; }
    /* En línea no hay nada que resolver: la línea informa y
       no lleva gesto (el botón «Abrir ejecutor» duplicaría el
       destino del menú; M-9 lo prohíbe en las tarjetas y aquí
       se aplica la misma vara). */
    if (hayGestoEj280) filaEj280.append(actosEj280);
  }
  /* Trabajos esperando con el ejecutor dormido (nº 27, con la
     jerarquía de la nº 31): el dato reunido del servidor
     (ejecutorEspera201 en el estado) y el gesto EN LA PROPIA
     línea: «Ejecutar aquí». El paso de arrancar.bat ya no es
     el texto del aviso: queda como reserva discreta junto al
     botón, por si el enlace no responde. Sin emparejar, el
     gesto es otro (emparejar) y la línea lo dice con el paso
     del servidor. Solo si hay trabajos y el ejecutor no está
     en línea: si no, la línea no existe. */
  const esp201 = sd?.ejecutorEspera201;
  /* En sede NAS esta línea no existe (2.9.0 · Bloque C): los
     trabajos no esperan a ningún ejecutor de PC. */
  if (sd?.paseo !== 'nas' && esp201 && esp201.esperando > 0 && !esp201.enLinea) {
    if (esp201.emparejado) {
      const filaEspera = linea('Trabajos esperando', number.format(esp201.esperando) +
        ' trabajo(s) en cola · tu ejecutor está dormido' +
        (esp201.ultimoVisto ? ' (sin señal desde el ' + fmtFechaHora(esp201.ultimoVisto) + ')' : '') +
        ': pulsa «Ejecutar aquí» para despertarlo.');
      const actosEspera = n('div', undefined, 'actions');
      actosEspera.append(ejecutarAqui201(true),
        n('span', 'Si el botón no responde, ábrelo con arrancar.bat en tu equipo.', 'muted'));
      filaEspera.append(actosEspera);
    } else linea('Trabajos esperando', number.format(esp201.esperando) + ' trabajo(s) en cola' +
      (esp201.paso ? ' — ' + esp201.paso : ''));
  }
  const filaDescarga280 = linea('Última descarga', perfil?.lastSatSuccess
    ? 'el ' + fmtFechaHora(perfil.lastSatSuccess) : 'sin descargas registradas todavía');
  /* Sin botón propio en esta línea (2.9.0 · Bloque C): Hoy
     enseñaba «Descargar del SAT» tres veces (el principal de
     la pantalla, el paso protagonista y esta línea). La línea
     conserva su dato — la última descarga — y el gesto vive
     en el botón principal de Hoy y en Facturas. */
  const filaListas = linea('Listas negras', 'leyendo su última comprobación…');
  /* Foto de ejercicio cerrado tocada (nº 23): la línea solo
     aparece si el servidor marca un ejercicio sellado de este
     RFC como tocado (o sellado y en orden, en su versión
     tranquila). No se afirma qué cambió: eso no lo trae el
     dato; el detalle vive en Salud. */
  const filaFoto201 = linea('Ejercicio cerrado', '');
  if (typeof satToken !== 'undefined' && satToken && rfc) {
    satApi('ejercicios200g').then(data => {
      if (!wrap.isConnected) return;
      const sellados = (data?.ejercicios || []).filter(e => e.rfc === rfc && e.foto201);
      const tocada = sellados.find(e => e.fotoTocada201);
      if (tocada) filaFoto201.lastChild.textContent = 'el ejercicio ' + tocada.year +
        ' cambió después de su cierre (foto sellada el ' + fmtFechaHora(tocada.foto201.selladaAt) +
        '): algo lo tocó; el detalle está en Salud.';
      else if (sellados.length) filaFoto201.lastChild.textContent = 'sellado y sin cambios tras su cierre';
      else filaFoto201.remove();
    }).catch(() => filaFoto201.remove());
  } else filaFoto201.remove();
  if (!hoyUrgente201) wrap.append(estado);
  /* La tira fiscal va en los dos modos (nº 15): en el urgente
     es, con los gestos, lo único que queda. */
  wrap.append(hoyFiscalTira201());
  if (typeof satToken !== 'undefined' && satToken && typeof listsResumen201 === 'function') {
    satApi('lists').then(data => {
      if (!wrap.isConnected) return;
      const r = listsResumen201(data);
      filaListas.lastChild.textContent = r.texto;
      const menuTxt = document.getElementById('lists-menu-estado201');
      if (menuTxt) menuTxt.textContent = r.corto;
    }).catch(() => { if (wrap.isConnected) filaListas.lastChild.textContent = 'sin comprobar todavía'; });
  } else filaListas.lastChild.textContent = 'sin comprobar todavía';
  /* (c) Las 4 acciones grandes. */
  const grid = n('div', undefined, 'cmd-grid');
  const tarjeta = (titulo, estadoTxt, botonTxt, hacer, primario) => {
    const card = n('div', undefined, 'cmd-card');
    const textos = n('div', undefined, 'cmd-texts');
    textos.append(n('strong', titulo, 'cmd-title'), n('span', estadoTxt, 'cmd-last'));
    const btn = n('button', botonTxt, primario ? 'primary' : 'soft');
    btn.type = 'button';
    btn.onclick = () => hacer(btn);
    const acts = n('div', undefined, 'cmd-actions');
    acts.append(btn);
    card.append(textos, acts);
    grid.append(card);
    return textos;
  };
  const hoy = new Date();
  const rango = typeof downloadShortcutRange === 'function'
    ? downloadShortcutRange('mes', hoy.toISOString().slice(0, 10))
    : { start: hoy.toISOString().slice(0, 7) + '-01', end: hoy.toISOString().slice(0, 10) };
  tarjeta('Descargar facturas',
    /* La fecha de la última descarga vive UNA vez: en la línea
       de estado de arriba (2.3.2 · M-9). La tarjeta enseña su
       propio dato: el periodo que su botón va a descargar. */
    'El periodo de este mes: del ' + dateLabel(rango.start) + ' al ' + dateLabel(rango.end),
    'Descargar este mes',
    () => { if (scope && typeof downloadSheet === 'function') downloadSheet(scope, { start: rango.start, end: rango.end }); else showSatDownload(); }, true);
  const textosBuzon = tarjeta('Buzón Tributario', 'Leyendo su última consulta…', 'Consultar el buzón',
    btn => {
      if (!rfc) { navigate('tributario'); return; }
      /* Confirmación con pre-vuelo (nº 5 + nº 21): el resumen
         y el estado de la puerta ANTES de despachar. */
      confirmarDespacho201({
        titulo: 'Consultar el Buzón Tributario',
        lineas: ['Se listarán las notificaciones del Buzón Tributario de ' + rfc +
          ' desde tu equipo, con tu e.firma. No se abre ninguna notificación: abrirla es un gesto tuyo en el portal.'],
        rfc, boton: 'Consultar el buzón',
        alConfirmar: async () => {
          btn.disabled = true;
          try { await satApi('tributario/run', { rfc }); toast('Consulta del Buzón pedida: se corre en tu equipo con tu e.firma.', 'ok'); }
          catch (error) { toast(error.message, 'error'); }
          btn.disabled = false;
        } });
    });
  const textosDecl = tarjeta('Declaraciones', 'Leyendo el ejercicio ' + hoy.getFullYear() + '…', 'Recuperar declaraciones',
    btn => {
      if (typeof declRun !== 'function') { navigate('declaraciones'); return; }
      confirmarDespacho201({
        titulo: 'Recuperar declaraciones',
        lineas: ['Se recuperarán del portal las declaraciones del ejercicio ' + hoy.getFullYear() +
          ' de ' + rfc + ' con sus acuses, y quedarán archivadas en Documentos.'],
        rfc, boton: 'Recuperar declaraciones',
        alConfirmar: () => {
          declEjercicio = hoy.getFullYear();
          declRun('mensuales', () => { if (page === 'home') render(); }, btn);
        } });
    });
  /* El ejecutor se menciona UNA sola vez en Hoy (2.3.2 ·
     M-9): en su línea de estado, de arriba. Las tarjetas de
     Buzón y Declaraciones conservan su acción propia y su
     estado propio, sin repetir el del ejecutor ni su botón
     «Abrir ejecutor» (la pieza nº 31 queda absorbida por esta
     regla de un solo dato por pantalla; el botón sigue vivo
     en la línea «Trabajos esperando» cuando hay cola). */
  const docsRfc = documents.filter(doc => !doc.archived && (!rfc || doc.rfc === rfc));
  const ultimoDoc = docsRfc.map(d => d.date || '').sort().pop();
  tarjeta('Documentos',
    docsRfc.length ? number.format(docsRfc.length) + ' documento(s) en el expediente' + (ultimoDoc ? ' · el último, del ' + dateLabel(ultimoDoc) : '')
      : 'El expediente está vacío todavía',
    'Abrir Documentos', () => navigate('docs'));
  /* Los gestos, POR ENCIMA de las tarjetas de acción (2.3.2 ·
     M-8): «Lo que te necesita» es lo primero de Hoy tras el
     estado y la tira fiscal — nada se esconde ni se pliega:
     el panel entra aquí, dentro del mando, antes de la
     rejilla de las 4 tarjetas. En modo urgente es, con la
     tira, lo único que queda, como ya era. */
  if (gestos232) wrap.append(gestos232);
  if (!hoyUrgente201) wrap.append(grid);
  /* Estado vivo del Buzón y de Declaraciones: salen de las
     mismas lecturas que sus pantallas ya hacen (tributario y
     declaraciones del ejercicio en curso); si fallan, la
     tarjeta dice que no se pudo leer, sin inventar el dato. */
  if (typeof satToken !== 'undefined' && satToken && rfc) {
    satApi('tributario?rfc=' + encodeURIComponent(rfc)).then(data => {
      if (!wrap.isConnected) return;
      textosBuzon.lastChild.textContent = !data?.ultimaConsulta && !data?.total
        ? 'Sin consultar todavía'
        : (data.sinAbrir ? number.format(data.sinAbrir) + ' sin abrir' : 'Sin notificaciones pendientes') +
          (data.ultimaConsulta ? ' · consultado el ' + fmtFechaHora(data.ultimaConsulta) : '');
    }).catch(() => { if (wrap.isConnected) textosBuzon.lastChild.textContent = 'No se pudo leer su estado'; });
    satApi('declaraciones?rfc=' + encodeURIComponent(rfc) + '&ejercicio=' + hoy.getFullYear()).then(data => {
      if (!wrap.isConnected) return;
      /* El MISMO cálculo reconciliado que el panel
         (2.9.5 · R6): el conteo vive en mapa.resumen — la
         tarjeta leía data.resumen, una ruta que el overview
         no sirve, y enseñaba «0 presentada(s)» con el panel
         diciendo 10. Y la última fecha se elige entre las
         ISO (el overview ya las sirve normalizadas), no por
         orden de texto sobre el formato crudo del portal,
         que además dateLabel troceaba en «26//2/16/1». */
      const res = data?.mapa?.resumen || data?.resumen || {};
      const fechas = (data?.documentos || []).map(d => d.fechaPresentacion || '')
        .filter(f => /^\d{4}-\d{2}-\d{2}/.test(f)).sort();
      textosDecl.lastChild.textContent = 'Ejercicio ' + hoy.getFullYear() + ': ' +
        number.format(res.presentadas || 0) + ' presentada(s) en el expediente' +
        (fechas.length ? ' · la última, del ' + dateLabel(fechas[fechas.length - 1]) : '');
    }).catch(() => { if (wrap.isConnected) textosDecl.lastChild.textContent = 'No se pudo leer su estado'; });
  }
  return wrap;
}
/* Panel general de contribuyentes (pieza 9): TODOS los RFC,
   ordenados por urgencia, cada fila SOLO con lo de su RFC
   (puerta, última descarga, avisos sin abrir de su Buzón y
   próximo vencimiento de su e.firma — cada dato, de su
   registro). Tocar una fila fija el ámbito y lleva a su Hoy. */
/* Ficha de UN contribuyente (2.9.0 · Bloque C): pulsar la
   fila abre SU ficha aquí mismo — salud con su porqué, última
   descarga, avisos sin abrir, vencimiento de la e.firma y los
   gestos de ese RFC — en vez de saltar a Hoy, que era el
   destino equivocado del clic. «Entrar a su Hoy» queda como
   gesto explícito dentro de la ficha. */
function contribFicha290(fila, perfil) {
  const sd = typeof satData !== 'undefined' && satData ? satData : null;
  const salud = saludRfc200b(fila.rfc);
  const ultima = perfil?.lastSatSuccess ? fmtFechaHora(perfil.lastSatSuccess) : 'sin descargas registradas';
  const sinAbrir = Number(sd?.tributario?.[fila.rfc]?.sinAbrir || 0);
  const sinLeer = typeof buzonUnreadFor === 'function' ? buzonUnreadFor(fila.rfc) : 0;
  const vence = perfil?.certExpires ? 'vence el ' + fmtFechaCorta(perfil.certExpires) : 'sin vencimiento a la vista';
  const controles = [
    n('p', 'Salud: ' + salud.porque + '.'),
    n('p', 'Última descarga del SAT: ' + ultima + '.'),
    n('p', 'Buzón Tributario: ' + number.format(sinAbrir) + ' sin abrir · Recibidos: ' + number.format(sinLeer) + ' sin leer.'),
    n('p', 'e.firma: ' + vence + '.')];
  const actos = n('div', undefined, 'actions');
  const entrar = n('button', 'Entrar a su Hoy', 'primary');
  entrar.type = 'button';
  entrar.onclick = () => { closeDialog(); navigate('home'); };
  const descargar = n('button', 'Descargar del SAT', 'soft');
  descargar.type = 'button';
  descargar.onclick = () => { closeDialog(); if (typeof downloadSheet === 'function') downloadSheet(fila.rfc); else navigate('descargar'); };
  actos.append(entrar, descargar);
  controles.push(actos);
  dialog('Ficha · ' + (fila.nombre || fila.rfc), controles);
  /* dialog() esconde el botón de guardar si no hay trabajo:
     la ficha es de lectura y gestos, no un formulario. */
}
function contribuyentesPanel200b() {
  const wrap = panel('Contribuyentes', 'Todos tus RFC de un vistazo, primero quien necesita un gesto. Toca uno para abrir su ficha.');
  wrap.dataset.bloque200b = 'panel-contribuyentes';
  const sd = typeof satData !== 'undefined' && satData ? satData : null;
  const perfiles = new Map((sd?.profiles || []).map(p => [p.rfc, p]));
  const filas = people.map(person => ({ rfc: person.id, nombre: person.name }));
  for (const p of sd?.profiles || [])
    if (!filas.some(f => f.rfc === p.rfc)) filas.push({ rfc: p.rfc, nombre: p.pending ? 'Alta preparada (faltan credenciales)' : 'Contribuyente' });
  filas.sort((a, b) => urgenciaRfc200b(b.rfc) - urgenciaRfc200b(a.rfc) || a.nombre.localeCompare(b.nombre, 'es-MX'));
  if (!filas.length) { wrap.append(n('p', 'Sin contribuyentes todavía.', 'empty')); return wrap; }
  /* Imprimir la lista tal cual se ve (2.0.1 · nº 2): el mismo
     patrón de Facturas/Dinero/Documentos, con membrete. */
  const filasImprimir201 = [];
  wrap.querySelector('.panel-head')?.append(action('Imprimir', () => imprimirVista201('Contribuyentes',
    'Todos tus RFC de un vistazo, en el orden de la pantalla.',
    ['Contribuyente', 'Puerta', 'Última descarga', 'Avisos sin abrir', 'e.firma'], filasImprimir201), 'metric-link', 'print'));
  for (const fila of filas) {
    const perfil = perfiles.get(fila.rfc);
    const salud = saludRfc200b(fila.rfc);
    const row = n('button', undefined, 'contrib-row200b');
    row.type = 'button';
    row.dataset.rfc = fila.rfc;
    const ultima = perfil?.lastSatSuccess ? fmtFechaHora(perfil.lastSatSuccess) : 'sin descargas registradas';
    const sinAbrir = Number(sd?.tributario?.[fila.rfc]?.sinAbrir || 0);
    const vence = perfil?.certExpires ? 'e.firma vence el ' + fmtFechaCorta(perfil.certExpires) : 'sin vencimiento a la vista';
    /* (2.9.9 · D6) La puerta de la fila sale de LA MISMA
       función y LA MISMA fuente que el lateral
       (puertaTexto299 sobre satData.puerta del RFC): el
       texto es idéntico en los dos sitios, estado a estado.
       La salud compuesta (salud.porque) sigue viviendo en
       su punto y en la ficha, que es otro hecho. */
    const puerta299 = puertaTexto299(sd?.puerta?.[fila.rfc], sd?.ejecutor).texto;
    filasImprimir201.push([fila.nombre + ' · ' + fila.rfc, puerta299, ultima, number.format(sinAbrir), vence]);
    const txt = n('span', undefined, 'contrib-txt200b');
    txt.append(n('strong', fila.nombre + ' · ' + fila.rfc),
      n('small', 'Puerta: ' + puerta299 + ' · Última descarga: ' + ultima +
        ' · Avisos sin abrir: ' + number.format(sinAbrir) + ' · ' + vence));
    const punto = n('span', undefined, 'salud-punto200b');
    punto.dataset.nivel = salud.nivel;
    punto.title = salud.porque;
    row.append(medallon200b(fila.rfc, fila.nombre), txt, punto);
    row.onclick = () => {
      scope = fila.rfc;
      const a1 = $('scope'); if (a1) a1.value = scope;
      const a2 = $('scope-top'); if (a2) a2.value = scope;
      /* La fila abre la FICHA del RFC (2.9.0 · Bloque C), no
         un salto a Hoy: el ámbito queda fijado y la ficha
         enseña lo de ese RFC con sus gestos. */
      contribFicha290(fila, perfil);
    };
    wrap.append(row);
  }
  return wrap;
}
/* Protagonista de Contribuyentes (2.8.0 · diseño 24): el RFC
   más urgente — el primero del mismo orden del panel — con
   su motivo y SU gesto directo; la lista pasa a ser el
   índice. El gesto sigue al estado servido (y a la sede: la
   salud por RFC ya ignora el ejecutor en sede NAS). */
function contribProtagonista280() {
  const sd = typeof satData !== 'undefined' && satData ? satData : null;
  const filas = people.map(person => ({ rfc: person.id, nombre: person.name }));
  for (const p of sd?.profiles || [])
    if (!filas.some(f => f.rfc === p.rfc)) filas.push({ rfc: p.rfc, nombre: p.pending ? 'Alta preparada (faltan credenciales)' : 'Contribuyente' });
  filas.sort((a, b) => urgenciaRfc200b(b.rfc) - urgenciaRfc200b(a.rfc) || a.nombre.localeCompare(b.nombre, 'es-MX'));
  if (!filas.length) return null;
  /* (2.9.13 · A8) El protagonista es quien de verdad necesita
     un gesto: el primero en orden de urgencia cuya salud no
     sea «ok». Antes salía el primero de la lista aunque su
     propia ficha dijera «puerta abierta y sin avisos sin
     abrir» — Mano Fil encabezaba «Quien necesita un gesto»
     sin necesitar ninguno. Si todos están «ok», la tarjeta lo
     dice en llano y no inventa un gesto (sinGesto). */
  let fila = null, salud = null;
  for (const candidata280 of filas) {
    const s280 = saludRfc200b(candidata280.rfc);
    if (s280.nivel !== 'ok') { fila = candidata280; salud = s280; break; }
  }
  if (!fila) return { ...filas[0], salud: saludRfc200b(filas[0].rfc), sinGesto: true, etiqueta: '', hacer: null };
  const elegir = () => {
    scope = fila.rfc;
    const a1 = $('scope'); if (a1) a1.value = scope;
    const a2 = $('scope-top'); if (a2) a2.value = scope;
  };
  let etiqueta = 'Descargar del SAT';
  let hacer = () => { elegir(); if (typeof downloadSheet === 'function') downloadSheet(fila.rfc); else navigate('descargar'); };
  if (salud.nivel === 'bad') {
    etiqueta = 'Probar la puerta';
    hacer = async () => {
      elegir();
      toast('Probando la puerta de ' + fila.rfc + '…');
      try {
        const r = await satApi('salud/puerta', { rfc: fila.rfc });
        toast(r && r.ok === false ? 'La puerta sigue sin abrir: ' + (r.motivo || 'el SAT no respondió.') : 'La puerta de ' + fila.rfc + ' responde.', r && r.ok === false ? 'error' : 'ok');
      } catch (error) { toast(error.message, 'error'); }
      /* (2.9.13 · A3) La foto nueva, al encabezado en el sitio. */
      if (typeof puertaRefrescarEnSitio2913 === 'function')
        await puertaRefrescarEnSitio2913(fila.rfc).catch(() => {});
      render();
    };
  } else if (/sin abrir/.test(salud.porque)) {
    etiqueta = 'Ver el Buzón del SAT';
    hacer = () => { elegir(); navigate('tributario'); };
  } else if (sd?.paseo !== 'nas' && /equipo no responde/.test(salud.porque) && typeof ejecutarAqui201 === 'function') {
    /* Solo en sede remota (2.9.0 · Bloque C): en sede NAS el
       gesto de despertar el ejecutor no existe en ningún
       sitio, tampoco como protagonista de Contribuyentes. */
    etiqueta = 'Despertar el ejecutor';
    hacer = () => { elegir(); ejecutarAqui201(true); };
  }
  return { ...fila, salud, etiqueta, hacer };
}
function contribuyentesScreen200b() {
  const parts = [];
  const prota = contribProtagonista280();
  if (prota) {
    const card = panel('Quien necesita un gesto');
    card.classList.add('protagonista280');
    card.dataset.protagonista280 = 'contribuyentes';
    if (prota.sinGesto) {
      /* (2.9.13 · A8) Nadie necesita un gesto: la tarjeta lo
         dice y no presenta a nadie como si lo necesitara. */
      card.append(n('p', 'Nadie ahora: todos tus contribuyentes tienen la puerta abierta y ningún aviso sin abrir.'));
    } else {
      card.append(n('p', prota.nombre + ' · ' + prota.rfc + ' — ' + prota.salud.porque + '.'));
      const boton = action(prota.etiqueta, prota.hacer, 'primary', 'check');
      boton.id = 'contrib-gesto280';
      card.append(boton);
    }
    parts.push(card);
  }
  parts.push(contribuyentesPanel200b());
  return parts;
}
/* Selector global desplegable (2.0 · pieza 8): el botón de la
   cabecera enseña el medallón y el nombre del contribuyente en
   ámbito; su panel trae buscador (visible desde 5 RFC: con
   1–2 sigue siendo un toque, como hoy), el punto de salud
   compuesto de cada RFC con su porqué en el título, y el
   «Ver todos» que abre el panel general. Elegir un RFC fija
   el ámbito y repinta, como hacía el selector de siempre. */
/* Toda luz con su palabra (2.9.0 · bloque B, pieza 2): la forma
   CORTA y VISIBLE del porqué de una salud por RFC — el punto de
   la cabecera ya no esconde su motivo en el title. Mapa cerrado
   sobre los porqués que saludRfc200b de verdad produce; lo que
   no casa cae a la palabra de su nivel, nunca a un texto técnico. */
function saludPalabraCorta290(salud) {
  if (!salud || salud.nivel === 'ok') return '';
  const p = String(salud.porque || '');
  if (/vieja/.test(p)) return 'puerta vieja';
  /* En sede NAS la palabra «sin equipo» no existe (2.9.0 ·
     Bloque C): aunque un porqué viejo la trajera, la palabra
     visible habla de la puerta, que es lo que la sede usa. */
  if (typeof satData !== 'undefined' && satData?.paseo === 'nas' && /no responde|equipo/.test(p))
    return salud.nivel === 'bad' ? 'puerta cerrada' : 'a vigilar';
  if (/no responde/.test(p)) return 'sin equipo';
  if (/no abre con su e\.firma/.test(p)) return 'puerta cerrada';
  if (/sin probar/.test(p)) return 'sin probar';
  const avisos = p.match(/(\d[\d.]*)\s*notificaci/);
  if (avisos) return avisos[1] + ' avisos';
  if (/sin datos/.test(p)) return 'sin comprobar';
  return salud.nivel === 'bad' ? 'algo falla' : salud.nivel === 'warn' ? 'a vigilar' : 'sin comprobar';
}
function pintarBotonScope200b() {
  const btn = $('scope-menu-btn200b');
  if (!btn || !btn.replaceChildren) return;
  const persona = people.find(p => p.id === scope);
  const salud = saludRfc200b(scope);
  const punto = n('span', undefined, 'salud-punto200b');
  punto.dataset.nivel = salud.nivel;
  punto.title = salud.porque;
  /* La palabra corta VISIBLE junto al punto cuando la salud no
     es «ok» (2.9.0 · pieza 2): en móvil se queda — lo que cede
     es el nombre, como hasta hoy. */
  const palabra290 = saludPalabraCorta290(salud);
  const tramoPalabra290 = palabra290 ? n('span', palabra290, 'salud-palabra290') : null;
  if (tramoPalabra290) tramoPalabra290.dataset.nivel = salud.nivel;
  /* Nombre y RFC en tramos propios (2.3.2 · M-10): en móvil el
     CSS enseña solo medallón + RFC y el nombre cede; el nombre
     COMPLETO queda siempre en el title del botón. */
  if (persona) btn.replaceChildren(medallon200b(scope, persona.name),
    n('span', persona.name, 'scope-nombre200b'),
    n('span', '·', 'scope-sep200b'),
    n('span', scope, 'scope-rfc200b'), punto, ...(tramoPalabra290 ? [tramoPalabra290] : []));
  else btn.replaceChildren(medallon200b(scope, scope),
    n('span', 'Sin contribuyente', 'scope-nombre200b'), punto, ...(tramoPalabra290 ? [tramoPalabra290] : []));
  btn.title = 'Contribuyente: ' + (persona?.name || scope || '—') + ' — ' + salud.porque;
  /* (2.9.13 · mejora 4) El medallón del RFC — su color y su
     inicial, en grande — vive también junto al título de la
     pantalla en la cabecera: en TODAS las pantallas se ve de
     quién son los datos sin abrir el selector. Se pinta aquí
     porque este es el repintado canónico del ámbito. */
  const crumbRfc2913 = $('crumb-rfc2913');
  if (crumbRfc2913) {
