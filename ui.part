}
async function pollMonitor() {
  if (typeof ensureLazyPart === 'function') {
    const ok = await ensureLazyPart('monitor');
    if (ok) return pollMonitor();
  }
}
/* ===== Puentes de las partes diferidas Descargas y
   Dinero (2.4.0 · W6b) =====
   Descargas (sat-ui.part) y Dinero (money-ui.part) viajan
   diferidas (/parte/descargas y /parte/dinero), pero su
   NÚCLEO lo usa el bloque principal desde el primer pintado:
   (a) NÚCLEO SAT EN EL PUENTE: el estado (satToken, guestMode,
       satData, satError/satPolling/cloudRevision, satStatus,
       directions, criteriaNotes), la API (satApi y sus
       variantes, friendlyError) y las ayudas puras que pintan
       Hoy, el Centro SAT y Facturas (localDateTime/localTime,
       causaP200/textoP200, vigil200, restSwitch, selectPerson,
       satQuickCuando con sus lets satQuickRfc/satQuickDocs,
       descargarSalida1310). Código idéntico, una sola copia:
       se BORRÓ de sat-ui.part.
   (a) DINERO EN EL PUENTE: el estado compartido
       (dineroMarcados, dineroServerInfo/dineroServerCargado/
       dineroCanceladasSrv — la ficha de Facturas los toca sin
       guarda), el cálculo de saldos paidByMap/balanceOf (lo
       pintan Facturas, Hoy y el visor sin guarda) y
       setInvoiceTerm (lo llaman Salud y Bancos con guarda).
       monthlyTotals NO se mueve: ya vive en ui.part y la
       parte de Dinero lo lee en tiempo de llamada.
   (b) LANZADORES QUE SE AUTO-CARGAN: pollSat, downloadSheet,
       requestDialog, unlockDialog y fillSat piden su parte y
       se re-invocan; la función real los sustituye al cargar.
       fillSat es además la pieza que la parte de Vigilancia
       envuelve (cuota + «Baja lo mismo»): el cargador garantiza
       el ORDEN — ensureLazyPart('monitor') carga ANTES
       'descargas', así la envoltura captura siempre el fillSat
       REAL, nunca este lanzador — y satDownloadScreen es el
       puente-pantalla de Descargas, como declaracionesScreen.
   La pantalla de Dinero no necesita puente-pantalla: la
   puerta de render() (lazyPartForView) la retiene hasta que
   su parte llega, y dineroView la llama ya cargada. */
let satToken = document.querySelector('meta[name="pacosat-token"]')?.content ||
  sessionStorage.getItem('pacosat-guest-token') || undefined;
/* Sesión con nombre propio (2.9.8): al entrar con un usuario
   propio, el diálogo de entrada guarda { nombre, rol } en
   'pacosat-user-session'. Un administrador con nombre NO es
   un invitado: trabaja con la interfaz completa (solo la
   gestión de usuarios y las llaves quedan fuera, y eso lo
   cierra el servidor y el montaje de Ajustes, no esta marca). */
function sesionNombrada298() {
  try { return JSON.parse(sessionStorage.getItem('pacosat-user-session')); }
  catch { return null; }
}
const guestMode = Boolean(document.querySelector('meta[name="pacosat-guest"]') ||
  sessionStorage.getItem('pacosat-guest-token')) && sesionNombrada298()?.rol !== 'administrador';
let satData = { profiles: [], jobs: [], inbox: [], mail: {} };
let satError = '', satPolling = false, cloudRevision;
const satStatus = { pending: 'En espera del SAT', finished: 'Paquetes recibidos', expired: 'Vencida', failed: 'Falló', rejected: 'Rechazada', covered: 'Cubierta por otra vía', rerouted: 'Re-rutada', uncovered: 'Pendiente nombrada del SAT' };
const directions = { received: 'Recibidos', issued: 'Emitidos', both: 'Emitidos y recibidos' };
const criteriaNotes = { disponible: 'Criterio sin usar', ultima: 'Criterio ya usado · no se repite', agotado: 'El SAT ya no acepta este criterio tal cual: hay que pedirlo con el cierre exacto', rescatado: 'Criterio rescatado por el portal' };

/* Errores del servidor en lenguaje claro (UX-20): cada mensaje críptico
   conocido se traduce a qué pasó y qué hacer. Los que ya vienen claros
   (la mayoría desde la 1.6.7) pasan tal cual. */
const FRIENDLY_ERRORS = [
  [/sesión local inválida/i, 'El servicio se reinició y la sesión caducó: pulsa «Actualizar estado» o recarga la página para reconectar.'],
  [/^host inválido/i, 'El servicio rechazó la dirección de acceso: entra por la dirección oficial de PacoSAT en tu NAS.'],
  [/^solicitud inválida/i, 'La solicitud no es válida tal como se envió: revisa el RFC y el periodo e inténtalo de nuevo.'],
  [/^cfdi de otro rfc/i, 'Ese CFDI es de otro RFC: cambia el contribuyente seleccionado o registra ese RFC en tu cartera.'],
  [/almacenamiento todavía no está disponible/i, 'El almacenamiento aún se está preparando: espera unos segundos y reintenta; si persiste, cierra las demás pestañas de PacoSAT.'],
  /* §6 (1.11.0): «perfil de PacoSAT» es lenguaje del sistema; en la
     superficie se dice qué falta y cómo se resuelve. */
  [/no es un perfil de PacoSAT|no tiene perfil en PacoSAT/i, 'Primero autoriza la e.firma de este RFC para que PacoSAT pueda trabajar con el SAT.']
];
function friendlyError(message) {
  for (const [pattern, text] of FRIENDLY_ERRORS) if (pattern.test(message)) return text;
  return message;
}
async function satApi(route, data) {
  const headers = { 'X-PacoSAT-Token': satToken };
  if (data !== undefined) headers['Content-Type'] = 'application/json';
  const response = await fetch('/api/' + route, {
    method: data === undefined ? 'GET' : 'POST', headers,
    body: data === undefined ? undefined : JSON.stringify(data)
  });
  if (!response.ok) {
    const failed = await response.json().catch(() => ({}));
    const error = new Error(friendlyError(failed.error || 'El servicio local no respondió.'));
    error.guard = failed.guard || null;
    throw error;
  }
  return response.headers.get('Content-Type') === 'application/zip' ? response.blob() : response.json();
}
/* Lecturas compartidas por pintado (1.24.0, punto 4a): Hoy pedía
   «reports/checklist» dos veces en el mismo pintado (el panel Hoy
   y el cierre guiado) y cada pantalla re-lanzaba lecturas que el
   pulso acababa de traer. satApiLectura comparte la promesa de
   las GET idénticas durante 5 s: mismo dato, una sola llamada
   por pintado. Solo lecturas — las mutaciones jamás se
   comparten — y un fallo no se cachea. */
const satLecturas = new Map();
function satApiLectura(route) {
  const hit = satLecturas.get(route);
  if (hit && Date.now() - hit.at < 5000) return hit.promise;
  const promise = satApi(route);
  satLecturas.set(route, { at: Date.now(), promise });
  promise.catch(() => { if (satLecturas.get(route)?.promise === promise) satLecturas.delete(route); });
  return promise;
}
/* Mutación con recomprobación (1.13.1, pieza H): si la respuesta de
   una acción de GUARDAR se pierde (red caída, 502 del proxy tras
   aplicar el cambio), la pantalla NUNCA declara el fallo sin
   recomprobar: re-lee el estado afectado y, si el cambio consta
   aplicado, devuelve { aplicadoTrasError: true } para que la
   pantalla enseñe el éxito real; solo si no consta, relanza el
   error. Es el criterio global para «Ya se pagó», marcar pagado
   y cualquier mutación equivalente. */
async function satApiGuardar(route, data, comprobar) {
  try { return await satApi(route, data); }
  catch (error) {
    let aplicado = false;
    try { aplicado = Boolean(await comprobar()); } catch { aplicado = false; }
    if (aplicado) return { aplicadoTrasError: true };
    throw error;
  }
}
/* satApiBlob(): como satApi(), pero la respuesta es siempre un Blob
   (el ZIP del paquete de defensa de Cumplimiento), sin pasar por el
   desvío JSON de satApi ni depender de su Content-Type exacto. Se
   llamaba desde la 1.6.18 y nunca se definió (hotfix 1.7.3). El error
   se traduce igual que en satApi(). */
async function satApiBlob(route, data) {
  const headers = { 'X-PacoSAT-Token': satToken };
  if (data !== undefined) headers['Content-Type'] = 'application/json';
  const response = await fetch('/api/' + route, {
    method: data === undefined ? 'GET' : 'POST', headers,
    body: data === undefined ? undefined : JSON.stringify(data)
  });
  if (!response.ok) {
    const failed = await response.json().catch(() => ({}));
    const error = new Error(friendlyError(failed.error || 'El servicio local no respondió.'));
    error.guard = failed.guard || null;
    throw error;
  }
  return response.blob();
}
/* ===== Ronda 2.9.7 · Cliente del Lector y del portal CFDI =====
   Contrato fijo del servidor: GET /api/cfdi/lectura?uuid=,
   POST /api/portal-cfdi/run, POST /api/portal-cfdi/cancel y
   GET /api/portal-cfdi/state?rfc=. A diferencia de satApi(),
   apiJson297 conserva el cuerpo del error (status y data):
   el Lector necesita distinguir el 404 con sinXml:true de
   cualquier otro fallo para ofrecer «Bajar ahora» solo cuando
   de verdad falta el XML, sin fingir en los demás casos. */
let portalPollMs297 = 2000;
async function apiJson297(route, data) {
  const headers = { 'X-PacoSAT-Token': satToken };
  if (data !== undefined) headers['Content-Type'] = 'application/json';
  const response = await fetch('/api/' + route, {
    method: data === undefined ? 'GET' : 'POST', headers,
    body: data === undefined ? undefined : JSON.stringify(data)
  });
  const payload = await response.json().catch(() => ({}));
  if (!response.ok) {
    const error = new Error(friendlyError(payload.error || 'El servicio local no respondió.'));
    error.status = response.status;
    error.data = payload;
    throw error;
  }
  return payload;
}
const portalRun297 = payload => apiJson297('portal-cfdi/run', payload);
const portalCancel297 = rfc => apiJson297('portal-cfdi/cancel', { rfc });
const portalState297 = rfc => apiJson297('portal-cfdi/state?rfc=' + encodeURIComponent(rfc));
const lectorLectura297 = uuid => apiJson297('cfdi/lectura?uuid=' + encodeURIComponent(uuid));
function portalMotivo297(state) {
  return state?.progress?.step || state?.runs?.[0]?.error || state?.runs?.[0]?.motivo ||
    state?.runs?.[0]?.step || 'la bajada no terminó';
}
/* El progreso vivo de una bajada por el portal, en el propio
   sitio que la pidió: sondeo a /api/portal-cfdi/state cada
   portalPollMs297 (2 s en producción), el paso vivo del
   servidor en la línea y su botón «Cancelar» (POST cancel).
   Al terminar llama a alTerminar(ok, state): ok sale de
   progress.ok / del último run, nunca se finge. Devuelve la
   función de parada del sondeo. */
function portalProgreso297(box, rfc, alTerminar) {
  if (!box) return () => {};
  box.replaceChildren();
  box.dataset.portal297 = '1';
  const linea = n('p', 'Bajando por el portal…', 'portal-progreso297');
  linea.dataset.portalStep297 = '1';
  const cancel = n('button', 'Cancelar', 'soft small');
  cancel.type = 'button';
  box.append(linea, cancel);
  let detenido = false, temporizador = null;
  const parar = () => { detenido = true; if (temporizador) clearTimeout(temporizador); };
  cancel.onclick = async () => {
    cancel.disabled = true; cancel.textContent = 'Cancelando…';
    try { await portalCancel297(rfc); linea.textContent = 'Cancelando la bajada…'; }
    catch (error) { linea.textContent = 'No se pudo cancelar: ' + error.message; cancel.disabled = false; cancel.textContent = 'Cancelar'; }
  };
  const tick = async () => {
    if (detenido) return;
    let state = null;
    try { state = await portalState297(rfc); }
    catch (error) { linea.textContent = 'Leyendo el progreso… ' + error.message; }
    if (detenido) return;
    const prog = state?.progress;
    if (prog?.step) linea.textContent = prog.step;
    if (state && prog && !prog.running) {
      parar();
      cancel.remove();
      const ok = prog.ok !== false && state.runs?.[0]?.ok !== false &&
        state.runs?.[0]?.status !== 'fallida' && state.runs?.[0]?.status !== 'error';
      if (typeof alTerminar === 'function') alTerminar(ok, state);
      return;
    }
    temporizador = setTimeout(tick, portalPollMs297);
  };
  temporizador = setTimeout(tick, portalPollMs297);
  return parar;
}
/* Lanzar la bajada y enseñar su progreso en `box`: un 409 solo
   dice que ya corre una para ese RFC — se sigue su progreso,
   no se declara fallo —; cualquier otro error de arranque se
   enseña tal cual y se reporta con alTerminar(false, null, e). */
async function portalLanzar297(box, payload, alTerminar) {
  if (box) box.replaceChildren(n('p', 'Pidiendo la bajada por el portal…', 'portal-progreso297'));
  try { await portalRun297(payload); }
  catch (error) {
    if (error.status !== 409) {
      if (box) box.replaceChildren(n('p', 'No se pudo pedir la bajada: ' + error.message, 'error-text'));
      if (typeof alTerminar === 'function') alTerminar(false, null, error);
      return () => {};
    }
  }
  return portalProgreso297(box, payload.rfc, alTerminar);
}
/* Descarga de salidas para las partes principales (1.31.0):
   copia del patrón de salidaDescargar de outputs-ui.part, pero
   con nombre propio — outputs-ui es una parte DIFERIDA que no
   siempre está cargada cuando el Centro SAT o Declaraciones
   pintan, y estas pantallas necesitan bajar su PDF/Excel/ZIP
   sin depender de ella. El servidor manda el artefacto en
   base64 con su nombre y su tipo; aquí solo se materializa. */
async function descargarSalida1310(ruta, payload, boton) {
  const texto = boton ? boton.textContent : '';
  if (boton) { boton.disabled = true; boton.textContent = 'Preparando…'; }
  try {
    const data = await satApi(ruta, payload);
    download(new Blob([decode64(data.content)], { type: data.type || 'application/octet-stream' }), data.name);
    toast('Salida lista: ' + data.name, 'ok');
  } catch (error) { toast(error.message, 'error'); }
  finally { if (boton) { boton.disabled = false; boton.textContent = texto; } }
}
/* Formato ÚNICO de fecha y hora de la casa (2.0, hallazgo 1.4):
   «14 nov, 17:02» en 24 h, el de fmtFechaHora — ningún bloque
   pinta ya su propio formato con hora suelta. localTime da
   solo la hora, con el mismo criterio. */
function localDateTime(value) {
  if (!value) return 'Al activar';
  const ms = +new Date(value);
  return Number.isFinite(ms) ? fmtFechaHora(ms) : String(value);
}
function localTime(value) { const s = localDateTime(value); return s.split(', ')[1] || s; }
/* ===== Puerta: causa viva y caducidad (2.0, M1 / hallazgo 2.1) =====
   El veredicto de sat_puerta es una FOTO: si el ejecutor no
   responde, la causa viva es el equipo apagado y ningún texto
   manda a la e.firma; si la prueba es vieja (>24 h, o anterior
   a la última señal con el equipo caído), se presenta como foto
   vieja. El gesto de la e.firma solo nace cuando la causa viva
   ES la e.firma y la prueba es fresca. Puro: Hoy, Centro SAT y
   la barra lateral componen con esto mismo. */
function causaP200(p, e, a = Date.now()) {
  if (!p?.probada) return { tipo: 'sin-probar', vieja: false, probadaMs: 0 };
  const probadaMs = +new Date(p.probada), visto = Number(e?.ultimoVisto) || 0;
  /* Paseo en casa (2.8.0): en sede NAS (satData.paseo === 'nas')
     la causa de la puerta NUNCA es el equipo — el paseo se hace
     desde casa, con la e.firma guardada en el NAS — así que el
     tipo se calcula sin mirar al ejecutor: ni «equipo» ni
     «sin-equipo» pueden salir, y ningún texto que cuelga de
     esta causa manda a despertar ni emparejar la PC. */
  const paseoNas250 = typeof satData !== 'undefined' && satData?.paseo === 'nas';
  const vieja = !(probadaMs > 0) || a - probadaMs > 86400000 ||
    (!paseoNas250 && e?.emparejado && !e?.enLinea && visto > probadaMs);
  const tipo = paseoNas250
    ? (p.ok ? 'abre'
      : /sin-efirma|credencial|e\.firma/i.test(String(p.errorKind || '') + ' ' + String(p.error || '')) && !vieja ? 'efirma'
      : vieja ? 'vieja' : 'puerta')
    : e?.emparejado && !e.enLinea ? 'equipo' : !e?.emparejado ? 'sin-equipo' : p.ok ? 'abre'
    : /sin-efirma|credencial|e\.firma/i.test(String(p.errorKind || '') + ' ' + String(p.error || '')) && !vieja ? 'efirma'
    : vieja ? 'vieja' : 'puerta';
  return { tipo, vieja, probadaMs };
}
function textoP200(p, e, a = Date.now()) {
  const causa = causaP200(p, e, a);
  if (causa.tipo === 'sin-probar') return '';
  const fecha = localDateTime(causa.probadaMs || p.probada);
  const noAbre = 'NO abre — ' + (p.error || 'sin motivo registrado');
  if (causa.tipo === 'equipo')
    return 'Tu equipo no responde desde el ' + localDateTime(e.ultimoVisto) +
      ': esa es la causa viva. La última prueba es del ' + fecha +
      (causa.vieja ? ' (foto vieja: puede estar desactualizada)' : '') +
      '; al volver tu equipo, la puerta se prueba sola antes que nada.';
  if (causa.tipo === 'vieja')
    return 'Esto se probó el ' + fecha + '; puede estar desactualizado: ' + (p.ok ? 'entonces abría.' : noAbre);
  return 'Puerta probada el ' + fecha + ': ' + (p.ok ? 'abre — la e.firma entra sola cada semana' : noAbre);
}
/* ===== Semáforo de vigilancia compuesto (2.0, M2 / 1.1) =====
   puerta (del RFC en ámbito) + ejecutor (última señal) + última
   descarga: verde SOLO si todo está sano; una pata caída baja a
   ámbar nombrándola, y la puerta cerrada por e.firma, a rojo.
   Puro a partir de satData: lo usan Hoy y el Centro SAT. */
function vigil200(ahora = Date.now()) {
  if (typeof satData === 'undefined' || !satData) return { nivel: 'dim', titulo: 'Vigilando', detalle: '' };
  if (satData.rest?.active) return { nivel: 'dim', titulo: 'Descansando', detalle: '' };
  const puerta = scope ? satData.puerta?.[scope] : null;
  const ejV = satData.ejecutor;
  const causa = causaP200(puerta, ejV, ahora);
  const mal = (nivel, pata, detalle) => ({ nivel, titulo: 'Vigilando con un problema: ' + pata, detalle });
  if (causa.tipo === 'efirma') return mal('bad', 'la puerta del SAT',
    'La puerta no abre con la e.firma de este RFC: revísala en Descargar del SAT.');
  if (causa.tipo === 'equipo') return mal('warn', 'tu equipo no responde',
    'Sin señal desde el ' + localDateTime(ejV.ultimoVisto) +
      ': las consultas esperan a que abras el ejecutor.');
  if (causa.tipo === 'sin-equipo') return mal('warn', 'falta tu equipo',
    'Sin equipo emparejado no hay Buzón ni Declaraciones.');
  if (causa.tipo === 'vieja' || (puerta?.probada && causa.vieja)) return mal('warn', 'la prueba de la puerta es vieja',
    'Se probó el ' + localDateTime(puerta.probada) + ' y puede estar desactualizada.');
  if (puerta?.probada && !puerta.ok) return mal('warn', 'la puerta del SAT',
    puerta.error || 'La última prueba de la puerta no abrió.');
  const perfil = (satData.profiles || []).find(p => p.rfc === scope);
  if (perfil?.lastSatSuccess && ahora - perfil.lastSatSuccess > 8 * 86400000)
    return mal('warn', 'la última descarga es vieja',
      'La última descarga con éxito fue el ' + localDateTime(perfil.lastSatSuccess) + '.');
  return { nivel: 'ok', titulo: 'Vigilando', detalle: 'Descarga y avisos automáticos activos' };
}
function selectPerson() {
  check(people.length, 'Agrega un contribuyente antes de configurar el SAT.');
  return select(people.map(person => [person.id, person.name + ' · ' + person.id]), scope || people[0].id);
}
/* Interruptor general de descanso (1.6.10, compartido en 1.6.11): la
   misma pieza vive en el Centro SAT y en la pantalla «Hoy en PacoSAT».
   Un toque para descansar o reactivar; la fecha se pide solo si se
   elige «Descansar hasta…». */
function restSwitch() {
  const wrap = n('div', undefined, 'rest-switch');
  const active = Boolean(satData.rest?.active);
  const label = n('span', undefined, 'rest-label');
  /* El rótulo es el semáforo COMPUESTO (2.0, M2): sin descanso,
     «Vigilando» solo sale en verde si puerta, ejecutor y última
     descarga están sanos; si no, nombra la pata que falla. */
  const vig = active ? null : vigil200();
  const tituloVig240 = n('strong', active ? 'Descansando' : vig.titulo);
  /* El nivel del semáforo compuesto pone su icono de la familia
     (2.4.0 · W5b3) en el rótulo, sin glifos en el título. */
  if (active) tituloVig240.dataset.estado = 'esperando';
  else if (vig) tituloVig240.dataset.estado =
    { ok: 'aldia', warn: 'atencion', bad: 'error', dim: 'sindatos' }[vig.nivel] || 'sindatos';
  label.append(tituloVig240,
    n('small', active ? 'Sin envíos al SAT ni avisos' + (satData.rest.until && satData.rest.until < Date.UTC(2099, 0, 1) ? ' hasta ' + localDateTime(satData.rest.until) : ' (sin fecha: se reactiva con este interruptor)') :
      vig.detalle));
  const toggle = n('button', active ? 'Reactivar' : 'Descansar', 'rest-toggle');
  toggle.type = 'button';
  toggle.setAttribute('aria-pressed', String(active));
  toggle.onclick = async () => {
    /* El clic se CONFIRMA contra el estado que devuelve el servidor
       (1.27.0): hasta la 1.26, si la petición caía (el servidor
       rechazaba el centinela «sin fecha»), el error se lo tragaba
       el await y el botón parecía muerto — el «Descansar no
       desactiva nada» de Paco. Ahora un fallo se anuncia en voz
       alta y el éxito solo se anuncia si el estado guardado dice
       que el descanso quedó como se pidió. */
    toggle.disabled = true;
    try {
      if (active) {
        satData = await satApi('rest', { until: 0 });
        if (satData.rest?.active) throw new Error('El servidor sigue mostrando el descanso activo.');
        announce('Descanso general terminado. PacoSAT se pone al día con la ventana pendiente.');
      } else {
        /* Un toque, sin formularios: descanso sin fecha (se reactiva
           con el mismo interruptor). La fecha se elige con «Descansar
           hasta…». */
        satData = await satApi('rest', { until: Date.UTC(2100, 0, 1) });
        if (!satData.rest?.active) throw new Error('El servidor no guardó el descanso.');
        announce('PacoSAT entra en descanso general: sin descargas ni avisos hasta que lo reactives.');
      }
    } catch (error) {
      announce('El descanso no se pudo cambiar: ' + (error?.message || error));
    }
    toggle.disabled = false;
    render();
  };
  wrap.append(label, toggle);
  if (!active) wrap.append(action('Descansar hasta…', restDialog, undefined, 'bell'));
  return wrap;
}
/* ===== Acciones directas de SAT (1.13.1) =====
   La pantalla SAT abre con el verbo, no con tarjetas que hay que
   abrir para encontrarlo: un selector compacto de RFC (por defecto
   el ámbito actual) y cuatro botones grandes que disparan su flujo
   al momento — Descargar CFDI abre el diálogo de periodo (o baja a
   la tarjeta CIEC si ese RFC entra con contraseña), Constancia y
   Opinión lanzan su descarga por el endpoint de siempre con su
   clase (kind) y enseñan el progreso en su propia línea, y
   Declaraciones abre su panel en Documentos. Debajo de cada verbo,
   su último resultado conocido, leído de los datos que la API ya
   expone (satdocs, declaraciones y las solicitudes de satData);
   sin dato, una línea corta de qué hace. Las tarjetas de «Qué
   quieres hacer» quedan debajo como consulta y navegación, y la
