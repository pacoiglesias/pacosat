   (≥5.43:1; la medición completa vive en ronda200b). El color
   es un ACENTO FINO — el medallón con la inicial —: nunca
   repinta la app ni sale en reportes, PDF o correos. Se guarda
   en el servidor (settings.rfcColors, vía /api/settings) y
   viaja en el estado que el cliente ya descarga (satData). */
const RFC_PALETA200B = [
  ['azul', '#175c9e', 'Azul'], ['verde', '#0e6b4f', 'Verde'], ['teal', '#0f766e', 'Turquesa'],
  ['violeta', '#6d28d9', 'Violeta'], ['burdeos', '#9f2436', 'Burdeos'], ['ambar', '#9a5b00', 'Ámbar'],
  ['grafito', '#3f5468', 'Grafito'], ['oliva', '#556b1f', 'Oliva'], ['ciruela', '#7a2e5e', 'Ciruela'],
  ['marron', '#7c4a1e', 'Marrón']];
const rfcPaleta200b = clave => RFC_PALETA200B.find(([k]) => k === clave) || null;
function rfcColorClave200b(rfc) {
  if (!rfc) return '';
  const delEstado = typeof satData !== 'undefined' && satData ? satData.settings?.rfcColors?.[rfc] : '';
  if (delEstado) return delEstado;
  const delPerfil = typeof satData !== 'undefined' && satData ?
    (satData.profiles || []).find(p => p.rfc === rfc)?.color : '';
  return delPerfil || (typeof appSettings !== 'undefined' ? appSettings.rfcColors?.[rfc] : '') || '';
}
/* Medallón con la inicial: con color asignado, su fondo; sin
