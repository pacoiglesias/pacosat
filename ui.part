   en ámbito, la causa viva de la puerta — y, en su defecto,
   la descarga de CFDI. Cada etiqueta tiene su rama en el
   despacho (workflows.part, page === 'home'). */
function pasoHoy200() {
  if (!satData) return 'Descargar CFDI del SAT';
  if (scope && (satData.pendingProfiles || []).includes(scope)) return 'Dar sus credenciales';
  const tipo = causaP200(scope ? satData.puerta?.[scope] : null, satData.ejecutor).tipo;
  return tipo === 'equipo' || tipo === 'sin-equipo' ? 'Ver tu ejecutor'
    : tipo === 'efirma' ? 'Revisar la e.firma' : 'Descargar CFDI del SAT';
}
/* ===== Tanda 2 · 2.0: identidad por RFC, destino exacto,
   acciones del día y panel general de contribuyentes =====
   Paleta cerrada y sobria (10 tonos apagados): cada fondo lleva
