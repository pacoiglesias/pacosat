   (saludRfc200b/causaP200), la misma del selector. */
const FOCO_ESTADO290 = { ok: 'Bien', warn: 'Falta atención', bad: 'Falla', dim: 'Sin comprobar' };
function focoFecha290(ms) {
  const t = Number(ms);
  if (!Number.isFinite(t) || t <= 0) return '';
  return new Date(t).toLocaleDateString('es-MX', { day: 'numeric', month: 'short', year: 'numeric' });
}
function focoSistema290(satData, salud, listas, cobertura, ahora = Date.now()) {
  const sd = satData || null;
  const rfc = (typeof scope !== 'undefined' && scope) || sd?.profiles?.[0]?.rfc || '';
  const piezas = [];
  const tarjeta = id => (salud?.tarjetas || []).find(t => t.id === id) || null;
  const nivelSalud = e => ({ bien: 'ok', vigilar: 'warn', mal: 'bad', 'sin-dato': 'dim' })[e] || 'dim';
  /* — Puerta del SAT (del RFC en ámbito) — */
  {
    const t = (salud?.tarjetas || []).find(x => x.id === 'puerta:' + rfc) ||
      (salud?.tarjetas || []).find(x => String(x.id).startsWith('puerta:')) || null;
    if (t) {
      const tipo = t.datos?.tipo || '';
      const deQuien = tipo === 'equipo' || tipo === 'sin-equipo' || tipo === 'efirma' || tipo === 'sin-probar' ? 'Paco'
        : tipo === 'puerta' ? 'el SAT' : tipo === 'vieja' ? 'el sistema' : 'nadie';
      const gesto = tipo === 'efirma' ? { texto: 'Revisar la e.firma', vista: 'settings', seccion: 'contribuyentes' }
        : tipo === 'equipo' || tipo === 'sin-equipo' ? { texto: 'Ver tu ejecutor', vista: 'ejecutor' }
        : tipo === 'vieja' || tipo === 'puerta' || tipo === 'sin-probar' ? { texto: 'Probar la puerta', accion: 'probar-puerta' }
        : { texto: 'Ver la puerta en Salud', vista: 'salud', destino: 'puerta:' + rfc };
      piezas.push({ nombre: 'Puerta del SAT' + (rfc ? ' · ' + rfc : ''), nivel: nivelSalud(t.estado),
        deQuien, motivo: t.porque || 'Sin motivo registrado.', gesto });
    } else if (sd && rfc && typeof saludRfc200b === 'function' && typeof causaP200 === 'function') {
      const s = saludRfc200b(rfc, ahora);
      const causa = causaP200(sd.puerta?.[rfc] || null, sd.ejecutor || null, ahora);
      const deQuien = causa.tipo === 'equipo' || causa.tipo === 'sin-equipo' || causa.tipo === 'efirma' || causa.tipo === 'sin-probar' ? 'Paco'
        : causa.tipo === 'puerta' ? 'el SAT' : causa.tipo === 'vieja' ? 'el sistema' : 'nadie';
      const gesto = causa.tipo === 'efirma' ? { texto: 'Revisar la e.firma', vista: 'settings', seccion: 'contribuyentes' }
        : causa.tipo === 'equipo' || causa.tipo === 'sin-equipo' ? { texto: 'Ver tu ejecutor', vista: 'ejecutor' }
        : s.nivel === 'ok' ? { texto: 'Ver la puerta en Salud', vista: 'salud', destino: 'puerta:' + rfc }
        : { texto: 'Probar la puerta', accion: 'probar-puerta' };
      piezas.push({ nombre: 'Puerta del SAT' + (rfc ? ' · ' + rfc : ''), nivel: s.nivel, deQuien, motivo: s.porque, gesto });
    } else {
      piezas.push({ nombre: 'Puerta del SAT' + (rfc ? ' · ' + rfc : ''), nivel: 'dim', deQuien: 'el sistema',
        motivo: 'Sin comprobar todavía: aún no se ha leído el estado de la puerta.',
        gesto: { texto: 'Ir a Salud', vista: 'salud' } });
    }
  }
  /* — Sede del paseo — */
  {
    const sede = sd?.paseo || salud?.paseo || '';
    if (sede === 'nas') piezas.push({ nombre: 'Sede del paseo', nivel: 'ok', deQuien: 'nadie',
      motivo: 'El paseo se hace desde casa (tu NAS): Buzón y Declaraciones no dependen de tu PC.',
      gesto: { texto: 'Ir al Buzón del SAT', vista: 'tributario' } });
    else if (sede) piezas.push({ nombre: 'Sede del paseo', nivel: 'warn', deQuien: 'Paco',
      motivo: 'El paseo depende de tu PC: el Buzón y las Declaraciones esperan a que tu equipo esté despierto.',
      gesto: { texto: 'Ver tu ejecutor', vista: 'ejecutor' } });
    else piezas.push({ nombre: 'Sede del paseo', nivel: 'dim', deQuien: 'el sistema',
      motivo: 'Sin comprobar todavía: no consta la sede del paseo de esta instalación.',
      gesto: { texto: 'Ir a Salud', vista: 'salud' } });
  }
  /* — Respaldo: contraseña puesta y copia fuera del NAS — */
  {
    const t = tarjeta('respaldo');
    const datos = t?.datos || {};
    const contrasena = datos.contrasenaPuesta !== undefined ? datos.contrasenaPuesta
      : sd?.scheduledBackup ? Boolean(sd.scheduledBackup.enabled) : undefined;
    const copiaFuera = datos.copiaFuera !== undefined ? datos.copiaFuera
      : sd?.scheduledBackup ? Boolean(sd.scheduledBackup.secondary) : undefined;
    const gesto = { texto: 'Ir a Respaldos', vista: 'settings', seccion: 'respaldos' };
    if (contrasena === undefined && copiaFuera === undefined && !t) piezas.push({ nombre: 'Respaldo', nivel: 'dim', deQuien: 'el sistema',
      motivo: 'Sin comprobar todavía: aún no se ha leído el estado del respaldo.', gesto });
    else if (contrasena === false) piezas.push({ nombre: 'Respaldo', nivel: 'warn', deQuien: 'Paco',
      motivo: 'Falta la contraseña del respaldo: sin ella no hay copia cifrada programada.', gesto });
    else if (t && t.estado === 'mal') piezas.push({ nombre: 'Respaldo', nivel: 'bad', deQuien: 'el sistema',
      motivo: t.porque || 'El último respaldo falló.', gesto });
    else if (copiaFuera === false) piezas.push({ nombre: 'Respaldo', nivel: 'warn', deQuien: 'Paco',
      motivo: 'Hay respaldo, pero sin copia fuera del NAS: si el NAS falla, la copia se va con él.', gesto });
    else if (t && t.estado === 'vigilar') piezas.push({ nombre: 'Respaldo', nivel: 'warn', deQuien: 'el sistema',
      motivo: t.porque || 'El respaldo está a vigilar.', gesto });
    else piezas.push({ nombre: 'Respaldo', nivel: 'ok', deQuien: 'nadie',
      motivo: t?.porque || 'Respaldo programado, con su contraseña y su copia fuera del NAS.', gesto });
  }
  /* — Correo de avisos — */
  {
    const t = tarjeta('correo');
    const configurado = t?.datos?.configurado !== undefined ? t.datos.configurado
      : sd?.mail ? Boolean(sd.mail.enabled) : undefined;
    const gesto = { texto: 'Ir a Ajustes › Correo', vista: 'settings', seccion: 'correo' };
    if (configurado === undefined) piezas.push({ nombre: 'Correo de avisos', nivel: 'dim', deQuien: 'el sistema',
      motivo: 'Sin comprobar todavía: aún no se ha leído si el correo está configurado.', gesto });
    else if (!configurado) piezas.push({ nombre: 'Correo de avisos', nivel: 'warn', deQuien: 'Paco',
      motivo: 'El correo de avisos no está configurado: los avisos importantes no salen de la app.', gesto });
    else if (t && t.estado === 'mal') piezas.push({ nombre: 'Correo de avisos', nivel: 'bad', deQuien: 'el sistema',
      motivo: t.porque || 'La última prueba del correo falló.', gesto });
    else piezas.push({ nombre: 'Correo de avisos', nivel: 'ok', deQuien: 'nadie',
      motivo: t?.porque || 'Configurado: los avisos salen a ' + (sd?.mail?.recipient || 'tu correo') + '.', gesto });
  }
  /* — Listas negras al día (umbral de la pantalla: 48 h) — */
  {
    const gesto = { texto: 'Ir a Listas negras', vista: 'lists' };
    const sources = listas?.sources || null;
    if (!sources || !sources.length) piezas.push({ nombre: 'Listas negras', nivel: 'dim', deQuien: 'el sistema',
      motivo: 'Sin comprobar todavía: aún no se ha leído la fecha de los listados.', gesto });
    else {
      const auto = sources.filter(s => !s.manual);
      const conFecha = auto.filter(s => Number(s.fetched) > 0);
      const ultima = conFecha.length ? Math.max(...conFecha.map(s => Number(s.fetched))) : 0;
      const viejas = auto.filter(s => !(Number(s.fetched) > 0) || ahora - Number(s.fetched) > 48 * 3600 * 1000);
      if (!ultima) piezas.push({ nombre: 'Listas negras', nivel: 'dim', deQuien: 'el sistema',
        motivo: 'Sin comprobar todavía: ningún listado automático trae fecha de descarga.', gesto });
      else if (viejas.length) piezas.push({ nombre: 'Listas negras', nivel: 'warn', deQuien: 'el sistema',
        motivo: 'Listas viejas: ' + viejas.length + ' listado(s) pasan de 48 horas; la última comprobación es del ' + focoFecha290(ultima) + '.', gesto });
      else piezas.push({ nombre: 'Listas negras', nivel: 'ok', deQuien: 'nadie',
        motivo: 'Al día: última comprobación el ' + focoFecha290(ultima) + '.', gesto });
    }
  }
  /* — Descargas al corriente (cobertura del RFC en ámbito) — */
  {
    const gesto = { texto: 'Ir a Descargar del SAT', vista: 'descargar' };
    /* 2.9.9 · B3. */
    const v299 = sd?.descargas299;
    if (v299?.texto) {
      const nom = v299.pendientesNombrados[0];
      const sat299 = v299.estado === 'sat-no-responde';
      piezas.push({ nombre: 'Descargas al corriente', gesto, motivo: nom?.porque || v299.texto,
        nivel: nom || sat299 ? 'warn' : 'ok', deQuien: nom?.deQuien || (sat299 ? 'el SAT' : 'nadie') });
    }
    else {
    const cov = cobertura || sd?.coverage || null;
    if (!cov) piezas.push({ nombre: 'Descargas al corriente', nivel: 'dim', deQuien: 'el sistema',
      motivo: 'Sin comprobar todavía: aún no se ha leído la cobertura de descargas.', gesto });
    else {
      const huecos = (cov.gaps || []).filter(g => !g.micro && (!rfc || g.rfc === rfc));
      const fallidos = (cov.groups || []).filter(g => !rfc || g.rfc === rfc)
        .reduce((sum, g) => sum + (Number(g.failed) || 0), 0);
      if (huecos.length) {
        const h = huecos[0];
        piezas.push({ nombre: 'Descargas al corriente', nivel: 'warn', deQuien: 'Paco',
          motivo: 'Hay ' + huecos.length + ' hueco(s) sin descargar de este RFC (el primero: del ' +
            String(h.from || '').slice(0, 10) + ' al ' + String(h.to || '').slice(0, 10) + ').', gesto });
      } else if (fallidos > 0) piezas.push({ nombre: 'Descargas al corriente', nivel: 'warn', deQuien: 'el sistema',
        motivo: 'Constan ' + fallidos + ' trabajo(s) de descarga fallidos en la cobertura de este RFC.', gesto });
      else piezas.push({ nombre: 'Descargas al corriente', nivel: 'ok', deQuien: 'nadie',
        motivo: 'Sin huecos: la cobertura de este RFC no enseña tramos sin descargar.', gesto });
    }
    }
  }
  const malas = piezas.filter(p => p.nivel === 'bad');
  const faltan = piezas.filter(p => p.nivel === 'warn');
  const sinComprobar = piezas.filter(p => p.nivel === 'dim');
  const nivel = malas.length ? 'bad' : faltan.length ? 'warn' : sinComprobar.length ? 'dim' : 'ok';
  const palabra = nivel === 'bad' ? 'Algo falla'
    : nivel === 'warn' ? (faltan.length === 1 ? 'Falta 1 cosa' : 'Faltan ' + faltan.length + ' cosas')
    : nivel === 'dim' ? 'Sin comprobar todavía' : 'Todo bien';
  return { nivel, palabra, piezas };
}
/* El foco se alimenta de dos lecturas que la casa ya hace (la
   salud de /api/salud y las listas de /api/lists): se piden al
   pintar la cabecera si la foto tiene más de un minuto, sin
   bloquear ningún pintado; sin servidor o sin permiso, la foto
   queda vacía y el foco dice «Sin comprobar todavía». */
let focoSalud290 = null, focoListas290 = null, focoFoto290 = 0, focoLeyendo290 = false;
function focoRefrescar290() {
  if (focoLeyendo290 || typeof satToken === 'undefined' || !satToken) return;
  if (Date.now() - focoFoto290 < 60000) return;
  focoLeyendo290 = true;
  Promise.all([satApi('salud').catch(() => null), satApi('lists').catch(() => null)])
    .then(([salud, listas]) => {
      if (salud) focoSalud290 = salud;
      if (listas) focoListas290 = listas;
      focoFoto290 = Date.now();
    }).catch(() => { /* sin foto nueva: manda la anterior */ })
    .finally(() => { focoLeyendo290 = false; try { pintarFoco290(); } catch { /* foco decorativo */ } });
}
function pintarFoco290() {
  const btn = $('foco-btn290');
  if (!btn) return;
  focoRefrescar290();
  const foco = focoSistema290(typeof satData !== 'undefined' ? satData : null,
    focoSalud290, focoListas290, typeof satData !== 'undefined' ? satData?.coverage : null);
  btn.dataset.nivel = foco.nivel;
  const luz = btn.querySelector('.foco-luz290');
  if (luz) luz.dataset.nivel = foco.nivel;
  const palabra = btn.querySelector('.foco-palabra290');
  if (palabra) palabra.textContent = foco.palabra;
  btn.title = 'El foco del sistema: ' + foco.palabra + '. Toca para ver lo vigilado y su arreglo.';
  const menu = $('foco-menu290');
  if (menu && !menu.hidden) pintarFocoMenu290(foco);
}
function pintarFocoMenu290(focoArg) {
  const menu = $('foco-menu290');
  if (!menu) return;
  const foco = focoArg || focoSistema290(typeof satData !== 'undefined' ? satData : null,
    focoSalud290, focoListas290, typeof satData !== 'undefined' ? satData?.coverage : null);
  menu.replaceChildren();
  menu.append(n('p', 'Lo vigilado ahora: ' + foco.palabra + '. Cada renglón dice de quién es y su arreglo lleva al punto exacto.', 'muted foco-menu-nota290'));
  for (const pieza of foco.piezas) {
    const row = n('div', undefined, 'foco-row290');
    row.dataset.nivel = pieza.nivel;
    const punto = n('span', undefined, 'salud-punto200b foco-punto290');
    punto.dataset.nivel = pieza.nivel;
    const txt = n('div', undefined, 'foco-txt290');
    txt.append(n('strong', pieza.nombre + ' — ' + (FOCO_ESTADO290[pieza.nivel] || pieza.nivel)),
      n('small', 'De quién: ' + pieza.deQuien + ' · ' + pieza.motivo, 'foco-motivo290'));
    row.append(punto, txt);
    if (pieza.gesto?.texto) {
      const b = n('button', pieza.gesto.texto, pieza.nivel === 'bad' ? 'primary small' : 'soft small');
      b.type = 'button';
      b.onclick = () => focoGesto290(pieza.gesto);
      row.append(b);
    }
    menu.append(row);
  }
}
async function focoGesto290(gesto) {
  const menu = $('foco-menu290');
  if (menu) menu.hidden = true;
  $('foco-btn290')?.setAttribute('aria-expanded', 'false');
  if (!gesto) return;
  if (gesto.accion === 'probar-puerta') {
    if (!scope) { toast('Elige un contribuyente para probar su puerta.', 'error'); return; }
    toast('Probando la puerta de ' + scope + '…');
    try {
      const r = await satApi('salud/puerta', { rfc: scope });
      toast(r && r.ok === false ? 'La puerta sigue sin abrir: ' + (r.motivo || 'el SAT no respondió.')
        : 'La puerta de ' + scope + ' responde.', r && r.ok === false ? 'error' : 'ok');
    } catch (error) { toast(error.message, 'error'); }
    /* (2.9.13 · A3) La foto nueva, al encabezado en el sitio. */
    if (typeof puertaRefrescarEnSitio2913 === 'function')
      await puertaRefrescarEnSitio2913(scope).catch(() => {});
    focoFoto290 = 0;
    render();
    return;
  }
  if (gesto.seccion) ajustesSection = gesto.seccion;
  if (gesto.destino) irDestino200b(gesto.vista, gesto.destino);
  else if (gesto.vista) navigate(gesto.vista);
}
(function cablearFoco290() {
  const btn = typeof document !== 'undefined' ? document.getElementById('foco-btn290') : null;
  if (!btn || !btn.addEventListener) return;
  btn.addEventListener('click', () => {
    const menu = $('foco-menu290');
    if (!menu) return;
    const abrir = menu.hidden;
    if (abrir) { focoFoto290 = 0; focoRefrescar290(); pintarFocoMenu290(); }
    menu.hidden = !abrir;
    btn.setAttribute('aria-expanded', String(abrir));
    if (abrir) { const scopeMenu = $('scope-menu200b'); if (scopeMenu) scopeMenu.hidden = true; }
  });
})();
/* El paso VIVO de un trabajo (2.9.0 · bloque B, pieza 3): la
   entrada del registro único de actividad de ese género y RFC
   — su detail es el último paso que el servidor narra, con sus
   reintentos — y el reloj honesto desde su since real, repintado
   cada segundo SOLO en su línea y limpio al desconectarse. */
function pasoVivo290(kind, rfc) {
  if (typeof activityView === 'undefined' || !activityView || !rfc) return null;
  const all = [...(activityView.running || []), ...(activityView.paused || [])];
  return all.find(e => e.kind === kind &&
    (e.rfc === rfc || String(e.key || '').endsWith(':' + rfc))) || null;
}
function relojTranscurrido290(el, since) {
  if (!el) return () => {};
  const pintar = () => { el.textContent = typeof fmtElapsed1312 === 'function' ? fmtElapsed1312(since) : ''; };
  pintar();
  const id = setInterval(() => {
    if (!el.isConnected) { clearInterval(id); return; }
    pintar();
  }, 1000);
  return () => clearInterval(id);
}
/* Asignar el color de un RFC (2.0 · pieza 7): en servidor va
   por /api/settings (mapa rfcColors) y el estado servido lo
   trae de vuelta; sin servidor, vive en este navegador con
   los demás ajustes de identidad. */
async function asignarColor200b(rfc, color) {
  if (typeof satToken !== 'undefined' && satToken) {
    const result = await satApi('settings', { installName: appSettings.installName, senderName: appSettings.senderName,
      accent: appSettings.accent, rfcColor: { rfc, color } });
    appSettings = { ...appSettings, ...result.settings, logoData: appSettings.logoData };
    if (typeof satData !== 'undefined' && satData) satData.settings = result.settings;
  } else {
    appSettings.rfcColors = { ...(appSettings.rfcColors || {}) };
    if (color) appSettings.rfcColors[rfc] = color; else delete appSettings.rfcColors[rfc];
    try {
      const previo = JSON.parse(localStorage.getItem('pacosat-settings') || '{}');
      localStorage.setItem('pacosat-settings', JSON.stringify({ ...previo, rfcColors: appSettings.rfcColors }));
    } catch { /* sin memoria local: vale por la sesión */ }
  }
  render();
}
function colorPicker200b() {
  const wrap = panel('Color de cada contribuyente',
    'Un color por RFC, de la paleta cerrada de la casa: se ve como un medallón fino junto a su nombre — en el selector, en Hoy y en el panel general. No cambia el color de la app ni sale en reportes o correos.');
  wrap.dataset.bloque200b = 'color-rfc';
  for (const persona of people) {
    const row = n('div', undefined, 'cp-row');
    row.append(medallon200b(persona.id, persona.name), n('span', persona.name + ' · ' + persona.id));
    const opciones = n('div', undefined, 'swatches');
    const actual = rfcColorClave200b(persona.id);
    const sinColor = n('button', 'Sin color', 'swatch');
    sinColor.type = 'button';
    sinColor.setAttribute('aria-pressed', String(!actual));
    sinColor.onclick = () => asignarColor200b(persona.id, '').catch(error => toast(error.message, 'error'));
    opciones.append(sinColor);
    for (const [clave, hex, etiqueta] of RFC_PALETA200B) {
      const b = n('button', undefined, 'swatch');
      b.type = 'button';
      b.title = etiqueta;
      b.setAttribute('aria-pressed', String(actual === clave));
      const dot = n('span', undefined, 'swatch-dot');
      dot.style.background = hex;
      b.append(dot, n('span', etiqueta));
      b.onclick = () => asignarColor200b(persona.id, clave).catch(error => toast(error.message, 'error'));
      opciones.append(b);
    }
    row.append(opciones);
    wrap.append(row);
  }
  if (!people.length) wrap.append(n('p', 'Sin contribuyentes todavía.', 'empty'));
  return wrap;
}

/* ===== Carga diferida de pantallas (1.24.0, punto 4b) =====
   Pagos, Bancos (dentro de Dinero) y Reportes (dentro de Cierre)
   viajan en partes que el servidor sirve en /parte/<nombre> y
   que la CSP autoriza por su huella. La primera entrada las
   pide, enseña su «cargando» honesto y pinta al llegar; en
   reposo se precargan solas. Si la parte no llega, la pantalla
   enseña el error con su reintento — nunca un hueco muerto. */
const lazyLoadedParts = new Set(), lazyPartPromises = new Map();
function ensureLazyPart(name) {
  /* Orden de carga Descargas→Vigilancia (2.4.0 · W6b): la parte
     de Vigilancia ENVUELVE fillSat al cargar (cuota + «Baja lo
     mismo»), así que su captura debe ser el fillSat REAL de la
     parte de Descargas, nunca el lanzador del puente: pedir
     Vigilancia carga primero Descargas, siempre. */
  if (name === 'monitor' && !lazyLoadedParts.has('monitor') && !lazyLoadedParts.has('descargas'))
    return ensureLazyPart('descargas').then(() => ensureLazyPart('monitor'));
  if (lazyLoadedParts.has(name)) return Promise.resolve(true);
  if (lazyPartPromises.has(name)) return lazyPartPromises.get(name);
  const url = typeof PACOSAT_LAZY !== 'undefined' ? PACOSAT_LAZY[name] : null;
  if (!url || typeof fetch !== 'function') return Promise.resolve(false);
  const promise = fetch(url).then(response => {
    if (!response.ok) throw new Error('HTTP ' + response.status);
    return response.text();
  }).then(code => {
    const el = document.createElement('script');
    el.textContent = code;
    document.head.appendChild(el);
    lazyLoadedParts.add(name);
    return true;
  }).catch(() => { lazyPartPromises.delete(name); return false; });
  lazyPartPromises.set(name, promise);
  return promise;
}
function lazyPartForView(view) {
  if (view === 'pagos') return 'pagos';
  if (view === 'registro') return 'registro';
  if (view === 'salud') return 'salud';
  /* Declaraciones y Vigilancia, diferidas en la 2.4.0 · W6:
     su pantalla no se pinta hasta que su parte llega (la
     puerta de render() enseña el esqueleto mientras tanto). */
  if (view === 'declaraciones') return 'declaraciones';
  if (view === 'monitor') return 'monitor';
  /* Descargas también espera a Vigilancia: su tarjeta de cuota
     y «Baja lo mismo» (2.4.0 · WC4b2) se anteponen envolviendo
     fillSat desde la parte de Vigilancia — sin ella, el primer
     pintado de Descargas saldría sin sus dos tarjetas. */
  if (view === 'descargar') return 'monitor';
  if (view === 'salidas' && cierreSection === 'reportes') return 'salidas';
  /* Reportes (2.0.1) vive en la parte de salidas: sus botones
     piden los artefactos que esa parte ya sabe descargar. */
  if (view === 'reportes') return 'salidas';
  /* Dinero diferido en la 2.4.0 · W6b: su pestaña propia espera
     a su parte; la de Bancos, a la suya, como hasta ahora. */
  if (view === 'dinero') return dineroTab === 'bancos' ? 'bancos' : 'dinero';
  /* El Buzón diferido en la 2.9.0 (Bloque D): Recibidos, el
     Buzón del SAT y el panel del ejecutor (su casa es
     tributario-ui.part) esperan a la parte 'buzon'; su estado
     y sus ayudas del primer pintado viven en el puente. */
  if (view === 'buzon' || view === 'tributario' || view === 'ejecutor') return 'buzon';
  return null;
}
function paintLazyState(name) {
  const [title, description] = screens[page];
  $('title').textContent = title;
  $('crumb').textContent = title;
  $('subtitle').textContent = description;
  const body = $('body');
  const wrap = panel(title);
  /* Esqueleto con la forma de la pantalla (2.4.0 · W5b2,
     pieza 4b) mientras la parte diferida llega; el texto
     «cargando» queda como palabra visible junto a la silueta. */
  const note = n('p', 'Cargando esta pantalla…', 'today-line');
  wrap.setAttribute('aria-busy', 'true');
  wrap.append(esqueletoPantalla240(2), note);
  body.replaceChildren(wrap);
  ensureLazyPart(name).then(ok => {
    if (lazyPartForView(page) !== name) return;
    if (ok) { render(); return; }
    /* La pantalla ya no está cargando: enseña el fallo y su
       reintento, así que el esqueleto sale del estado ocupado
       (corrección visual 2.4.0: ningún aria-busy residual). */
    wrap.removeAttribute('aria-busy');
    note.textContent = 'Esta pantalla no se pudo cargar (la parte no llegó del servidor).';
    const retry = n('button', 'Reintentar', 'primary small');
    retry.type = 'button';
    retry.onclick = () => render();
    wrap.append(retry);
  });
}
/* Precarga en reposo: tras el primer pintado, las partes llegan
   sin prisa para que la primera entrada real sea instantánea. */
function prefetchLazyParts() {
  try {
    if (typeof fetch !== 'function' || typeof PACOSAT_LAZY === 'undefined') return;
    const go = () => { for (const name of Object.keys(PACOSAT_LAZY)) ensureLazyPart(name); };
    if (typeof requestIdleCallback === 'function') requestIdleCallback(go, { timeout: 5000 });
    else if (typeof setTimeout === 'function') setTimeout(go, 3500);
  } catch { /* la precarga es un extra: jamás rompe el arranque */ }
}
/* ===== Puentes de las partes diferidas Declaraciones y
   Vigilancia (2.4.0 · W6) =====
   Declaraciones y Vigilancia viajan diferidas (/parte/…), pero
   piezas suyas las usa el bloque principal desde el primer
   pintado. Este puente es TODO lo que queda en el principal, y
   es diminuto al lado de las dos partes (se mide en la nota de
   la ronda):
   (a) ESTADO COMPARTIDO: fiscalResults (lo leen Facturas, Hoy,
       Problemas y Operaciones para pintar estados) y
       monitorFilter (Operaciones lo fija antes de navegar).
   (a) AYUDAS PURAS que pintan pantallas principales:
       monitorStateInfo y statusCell (detalle de Facturas,
       Problemas, el visor) y las fechas/textos de Declaraciones
       (declFechaLarga/Corta para el Buzón Tributario y Hoy,
       DECL_MESES, DECL_ESTADO_TEXTO —que también lee la parte
       de Reportes—, declFaltaMes230 para la foto por RFC y
       declEjercicio, que fijan lanzadores principales).
   (b) LANZADORES QUE SE AUTO-CARGAN: cada función de aquí con
       el nombre de una real pide su parte con ensureLazyPart y,
       cuando llega, se llama a sí misma — para entonces el
       nombre ya resuelve a la función REAL de la parte, que
       sustituye a este puente (declaración de función contra
       declaración de función). Si la parte no llega, el
       lanzador no hace nada: nunca un gesto muerto que finja.
       declaracionesScreen y declaracionesGrupo201 son la
       excepción con cuerpo: la puerta de render() impide que
       la pantalla se pinte sin su parte, así que su puente solo
       enseña el «cargando» honesto y dispara la carga (y, en
       Documentos, el repintado al llegar). */
const DECL_MESES = ['Enero', 'Febrero', 'Marzo', 'Abril', 'Mayo', 'Junio',
  'Julio', 'Agosto', 'Septiembre', 'Octubre', 'Noviembre', 'Diciembre'];
const DECL_ESTADO_TEXTO = { presentada: 'Presentada', pendiente: 'Pendiente',
  'sin-recuperar': 'Sin recuperar · no consta en tu expediente',
  'pagada-sin-acuse': 'Pagada según la línea del despacho — falta bajar el acuse',
  'no-toca': 'Aún no toca' };
/* «2026-11-17» → «17 de noviembre de 2026»; lo que el portal no
   dio en ISO se enseña tal cual, como hace el resto de la app.
   (La misma regla de siempre, con los meses del puente.) */
function declFechaLarga(iso) {
  if (!/^\d{4}-\d{2}-\d{2}/.test(iso || '')) return iso || '';
  const [y, m, d] = iso.slice(0, 10).split('-').map(Number);
  return d + ' de ' + DECL_MESES[m - 1].toLowerCase() + ' de ' + y;
}
function declFechaCorta(iso) {
  if (!/^\d{4}-\d{2}-\d{2}/.test(iso || '')) return iso || '';
  const [y, m, d] = iso.slice(0, 10).split('-').map(Number);
  return d + ' ' + DECL_MESES[m - 1].toLowerCase().slice(0, 3) + ' ' + y;
}
function declFaltaMes230(faltaMes) {
  const texto = String(faltaMes || '').trim();
  const periodo = texto.match(/^\d{4}-(\d{2})/);
  if (periodo) {
    const nombre = (typeof DECL_MESES !== 'undefined' ? DECL_MESES : [])[Number(periodo[1]) - 1];
    if (nombre) return nombre.toLowerCase();
  }
  return texto;
}
let declEjercicio = new Date().getFullYear();
const fiscalResults = new Map();
let monitorFilter = 'all';
/* El estado de un CFDI con el modelo único de problema (1.13.0):
   la insignia corta se queda, y la frase sale de problemSpec —
   qué significa y qué pasa ahora— para que Vigilancia, el Centro
   de mando y los correos cuenten lo mismo. */
function monitorStateInfo(row) {
  const item = fiscalResults.get(row.id);
  const spec = problemSpec('vigilancia', {
    efos: item?.efos || [], state: item?.sat?.state || '', error: item?.error || '' });
  const badge = item?.efos?.length ? 'En el listado 69-B' :
    item?.sat?.state === 'Vigente' ? 'Vigente' :
    item?.sat?.state === 'Cancelado' ? 'Cancelado' :
    item?.sat?.state === 'No encontrado' ? 'No localizado' :
    /* Lenguaje llano (1.18.0): el estado crudo del SAT («Formato
       rechazado») ya no se enseña como pastilla; queda solo en el
       detalle técnico del comprobante. */
    item?.sat?.state === 'Formato rechazado' ? 'El SAT no aceptó el formato' :
    item?.sat ? item.sat.state :
    item?.error ? 'No se pudo consultar' : 'Sin revisar todavía';
  const state = item?.efos?.length ? '69-B' : item?.sat?.state || (item?.error ? 'Error' : 'Sin consulta');
  let text = spec.significa;
  if (state === 'Cancelado' && item.sat.cancellation) text += ' (' + item.sat.cancellation + ')';
  if (state === 'Vigente' && item.checked) text += ' Revisado el ' + localDateTime(item.checked) + '.';
  else if (item?.sat && !item?.efos?.length &&
    !['Vigente', 'Cancelado', 'No encontrado', 'Formato rechazado'].includes(state))
    text = 'El SAT respondió: ' + state + '.';
  else if (state !== 'Vigente' && spec.ahora) text += ' ' + spec.ahora;
  return { badge, state, text, level: spec.level, titulo: spec.titulo };
}
function statusCell(id) {
  const row = invoices.find(candidate => candidate.id === id);
  const info = monitorStateInfo(row || { id });
  const item = fiscalResults.get(id);
  const wrap = n('div', undefined, 'fiscal-state');
  /* Marca por UUID (1.13.1): «Revisar ahora» repinta SOLO esta
     celda cuando vuelve la respuesta, sin recargar la lista. */
  wrap.dataset.monitorState = id;
  const badge = n('span', info.badge, 'fiscal-badge');
  badge.dataset.state = info.state;
  wrap.append(badge, n('small', info.text));
  if (item?.sat?.efos === '100') wrap.append(n('small', 'El SAT señaló una coincidencia EFOS en este comprobante.'));
  return wrap;
}
function declaracionesScreen() {
  if (typeof ensureLazyPart === 'function') ensureLazyPart('declaraciones');
  const wrap = panel('Declaraciones', 'Cargando esta pantalla…');
