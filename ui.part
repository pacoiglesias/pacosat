/* Mapa ÚNICO de pantallas (1.11.0): los 9 destinos del menú más
   Preguntas (vive en la barra superior). Título, frase de para qué
   (la tarea, no el sistema) y acción principal con verbo + objeto.
   Las vistas absorbidas no tienen entrada: navigate() las traduce
   al destino y la pestaña/sección que les corresponde (VIEW_ALIASES),
   así ningún enlace interno viejo se rompe y ninguna función se
   pierde (tabla de correspondencia de flujos.md §1). */
const screens = {
  home: ['Hoy', 'Cómo amanece todo: qué hizo el sistema, qué falta y qué vence.', 'Descargar CFDI del SAT'],
  avisos: ['Avisos', 'Lo que está mal, lo que falta y lo que el sistema necesita de ti.', 'Revisar avisos ahora'],
  buzon: ['Recibidos', 'Lo nuevo que llegó a tu expediente: CFDI y documentos recientes, leídos y sin leer.', 'Marcar todo leído'],
  tributario: ['Buzón Tributario', 'Las notificaciones del SAT para este RFC: PacoSAT las lista sin abrir ninguna.', 'Consultar ahora'],
  invoices: ['Facturas', 'Todos tus CFDI: emitidos y recibidos, su estado en el SAT y su PDF, en una sola tabla.', 'Descargar del SAT'],
  docs: ['Documentos', 'Tu expediente por RFC: constancia, opinión, declaraciones, acuses y PDF archivados, con «Ver» de un clic.', 'Subir PDF'],
  declaraciones: ['Declaraciones', 'El mapa de tus declaraciones por año y mes: qué consta, qué falta y cómo se descarga del SAT.', 'Descargar declaraciones del SAT'],
  registro: ['Registro', 'Todo lo que el sistema hizo, intentó y no pudo: conexiones, acciones y fallos en lenguaje llano.', 'Exportar CSV'],
  salud: ['Salud', 'El Centro de salud: cada pieza del sistema con su semáforo, su porqué y su arreglo en un toque.', 'Revisar ahora la salud'],
  archivo: ['Archivo', 'Lo que guardaste fuera de las vistas de trabajo: CFDI y documentos archivados, recuperables con un toque.', 'Ir a Facturas'],
  dinero: ['Dinero', 'Cuánto debes, cuánto te deben y qué ya se movió.', 'Descargar Excel de saldos'],
  pagos: ['Pagos al banco', 'Prepara los pagos del mes en tres pasos y llévate las tablas para el banco.', 'Armar la lista del mes'],
  sat: ['Descargar del SAT', 'Descarga tus facturas del SAT por periodo: el sistema pide, espera y archiva solo.', 'Importar paquete'],
  lists: ['Listas del SAT', 'Las listas negras del SAT (69-B y demás): quién de tus contrapartes aparece y cuándo se comprobó.', 'Actualizar listados'],
  reportes: ['Reportes', 'Los reportes del sistema en un solo sitio: totales, contrapartes, declaraciones y bancos, en PDF, Excel o impresos.', 'Exportación completa'],
  monitor: ['Vigilancia de CFDI', 'El estado de tus comprobantes en el SAT: vigentes, cancelados y por revisar.', 'Revisar mis CFDI ahora'],
  coverage: ['Descargados del SAT', 'Qué periodos ya bajaron del SAT y qué falta por bajar, RFC por RFC.', 'Actualizar estado'],
  ejecutor: ['Tu ejecutor', 'El programa que corre en tu equipo y entra al SAT por ti: emparejamiento, estado y diagnóstico.', 'Emparejar un ejecutor en mi equipo'],
  descargar: ['Descargar del SAT', 'Baja tus comprobantes del SAT por periodo: el sistema pide, espera y archiva solo.', 'Descargar CFDI del SAT'],
  salidas: ['Cierre y reportes', 'Cierra el mes paso a paso, mira qué vence y prepara lo de tu contadora.', 'Exportación completa'],
  settings: ['Ajustes', 'Contribuyentes y e.firma, correo, respaldos, sin conexión, estado del sistema y acerca de.', 'Guardar ajustes'],
  preguntas: ['Preguntas', 'Pregunta en lenguaje normal y la respuesta sale de tus datos locales, sin enviar nada fuera.', 'Escribir tu pregunta'],
  contribuyentes: ['Contribuyentes', 'Todos tus RFC ordenados por urgencia: puerta, última descarga, avisos y vencimientos de cada uno.', 'Ir a Hoy']
};
/* Vistas de la 1.10.x → destino nuevo (y su pestaña o sección). */
const VIEW_ALIASES = {
