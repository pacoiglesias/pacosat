function buzonEstado290(data) {
  if (!data || !data.ultimaConsulta)
    return { consultado: false, texto: 'Sin consultar todavía' };
  if (Number(data.sinAbrir) > 0)
    return { consultado: true, texto: Number(data.sinAbrir) + ' sin abrir' };
  if (Number(data.comunicadosNoLeidos) > 0)
    return { consultado: true, texto: Number(data.comunicadosNoLeidos) + ' comunicados sin leer' +
      (data.comunicadosFecha ? ' · ' + fechaCortaMenu202(data.comunicadosFecha) : '') };
  return { consultado: Boolean(data.ultimaConsulta), texto: 'Sin pendientes' +
