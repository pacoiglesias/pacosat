   quedan vacías: no se finge un estado que no se pudo leer. */
let menuEstados202Cache = { rfc: '', at: 0 };
function refrescarEstadosMenu202() {
  if (typeof satToken === 'undefined' || !satToken || !scope) return;
  const ahora = Date.now();
  if (menuEstados202Cache.rfc === scope && ahora - menuEstados202Cache.at < 60000) return;
  menuEstados202Cache = { rfc: scope, at: ahora };
  if (typeof pintarBuzonMenu202 === 'function') pintarBuzonMenu202();
  if (typeof pintarDeclMenu202 === 'function') pintarDeclMenu202();
  if (typeof pintarEjecutorMenu250 === 'function') pintarEjecutorMenu250();
}
function render() {
  const lazyName = lazyPartForView(page);
  if (lazyName && !lazyLoadedParts.has(lazyName)) { paintLazyState(lazyName); return; }
  const [title, description] = screens[page];
  $('title').textContent = title;
  $('crumb').textContent = title;
  $('subtitle').textContent = description;
  /* (2.8.0 · diseño 17) La ceja ya NO repite el RFC (el chip
     del contribuyente ya lo dice en la misma cabecera): nombra
     la SECCIÓN de la pantalla, que es lo que la ceja puede
     aportar. Un dato, una vez por pantalla. */
  $('eyebrow').textContent = ({ home: 'La mañana', avisos: 'La mañana', buzon: 'La mañana', contribuyentes: 'La mañana',
    invoices: 'Expediente', docs: 'Expediente', declaraciones: 'Expediente', tributario: 'Expediente', archivo: 'Expediente',
    dinero: 'Dinero y cierre', pagos: 'Dinero y cierre', reportes: 'Dinero y cierre', salidas: 'Dinero y cierre',
    descargar: 'El SAT', sat: 'El SAT', monitor: 'El SAT', coverage: 'El SAT', lists: 'El SAT', ejecutor: 'El SAT',
    registro: 'Sistema', salud: 'Sistema', preguntas: 'Sistema', settings: 'Sistema' })[page] || 'La mañana';
  /* Contadores fuera de la cabecera (1.32.1, G3): «N CFDI ·
     N PDF · N RFC» se repetía en TODAS las pantallas y en Hoy
     duplicaba sus propias métricas. Los conteos viven donde se
     trabaja con ellos (Hoy y Facturas); la cabecera queda limpia. */
  const headerCounts = $('counters');
  if (headerCounts) headerCounts.textContent = '';
  /* Importar vive en Hoy y en Facturas: fuera de ahí, la cabecera no
     lleva «Abrir XML / Factura PDF» (sistema visual §4). */
  const importingHere = page === 'home' || page === 'invoices';
  if ($('inspect')) $('inspect').hidden = !importingHere;
  if ($('pdf-import')) $('pdf-import').hidden = !importingHere;
  $('primary').replaceChildren(icon(page === 'settings' && ajustesSection === 'respaldos' ? 'lock' : page === 'salidas' && cierreSection === 'diot' ? 'down' : 'up'), n('span', primaryLabel()));
  $('primary').disabled = !ready || importing;
  /* El mapa se resuelve con typeof para las pantallas de las
     partes diferidas: nombrar pagosScreen antes de que su parte
     cargue lanzaría ReferenceError incluso pintando otra
     pantalla; la puerta de arriba garantiza que, cuando la
     vista es la suya, la función ya existe. */
  const content = ({ home, contribuyentes: contribuyentesScreen200b, avisos: avisosScreen, buzon: buzonScreen, tributario: tributarioScreen, invoices: invoiceScreen, docs: docsView, dinero: dineroView,
    declaraciones: declaracionesScreen,
    lists: typeof listsScreen === 'function' ? listsScreen : null,
    reportes: typeof reportesScreen201 === 'function' ? reportesScreen201 : null,
    monitor: typeof monitorScreen === 'function' ? monitorScreen : null,
    coverage: typeof coverageScreen === 'function' ? coverageScreen : null,
    ejecutor: typeof executorPanel === 'function' ? () => [executorPanel()] : null,
    descargar: typeof satDownloadScreen === 'function' ? satDownloadScreen : null,
    registro: typeof registroScreen === 'function' ? registroScreen : null,
    salud: typeof saludScreen200d === 'function' ? saludScreen200d : null,
    archivo: typeof archivoScreen1311 === 'function' ? archivoScreen1311 : null,
    pagos: typeof pagosScreen === 'function' ? pagosScreen : null,
    sat: satView, salidas: cierreView, settings: ajustesView, preguntas: preguntasScreen })[page]();
  for (const el of content) el.classList?.add('view-in');
  /* Pintado progresivo (2.0 · tanda 2, O2): el primer
     pantallazo (en Hoy: semáforo + gestos) pinta sin esperar
     al resto — los bloques bajo el pliegue llevan la clase
     .pintado-progresivo200b (content-visibility: auto con su
     hueco honesto de tamaño): el navegador los pinta al
     acercarse y, en reposo, la precarga de partes diferidas
     (prefetchLazyParts) ya usa requestIdleCallback. El DOM y
     su texto están completos desde el primer momento: las
     pruebas que leen el texto entero de Hoy no esperan a
     ningún pintado, y el orden visual final no cambia. El
     modo síncrono para pruebas es el propio diseño: no hay
     contenido que nazca tarde en el DOM. */
  if (page === 'home') content.forEach((el, i) => {
    if (i >= 2) el.classList?.add('pintado-progresivo200b');
  });
  /* Señales de la barra (1.31.1): cada pintado refresca el
     punto de la puerta y la señal de gestos con el estado que
     el servidor ya trajo — sin llamadas nuevas. */
  if (typeof senalesBarra1311 === 'function') { try { senalesBarra1311(); } catch { /* señal decorativa */ } }
  /* El botón del selector global refleja el ámbito y su
     salud en cada pintado (2.0 · pieza 8). */
  try { pintarBotonScope200b(); } catch { /* selector decorativo */ }
  /* El foco del sistema, siempre visible en la cabecera (2.9.0). */
  try { pintarFoco290(); } catch { /* foco decorativo */ }
  /* Los estados del Buzón y de Declaraciones en el menú (2.0.2):
     con el RFC en curso, sin esperar a que se abran sus vistas. */
  try { refrescarEstadosMenu202(); } catch { /* estado decorativo del menú */ }
  $('body').replaceChildren(...content);
  applySettings();
  /* La franja de actividad sigue a la página AL PINTAR
     (2.9.3 · O3): su supresión en las pantallas que ya enseñan
     el trabajo (Novedades entre ellas) solo se re-evaluaba en
     el pulso de 30 s, así que al ENTRAR en Novedades la franja
