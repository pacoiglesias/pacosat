   despliegue en cualquier vista y conserva el estado entre
   pintados si se le da una clave. */
const plegables290 = new Map();
function plegable290(titulo, contenido, clave = '') {
  const wrap = n('div', undefined, 'plegable290');
  const abierto = clave ? Boolean(plegables290.get(clave)) : false;
  const boton = n('button', (abierto ? '▾ ' : '▸ ') + titulo, 'soft small plegable-btn290');
  boton.type = 'button';
  boton.setAttribute('aria-expanded', String(abierto));
  const region = n('div', undefined, 'plegable-region290');
  region.hidden = !abierto;
  if (contenido) region.append(contenido);
  boton.onclick = () => {
    const abre = region.hidden;
    region.hidden = !abre;
    boton.setAttribute('aria-expanded', String(abre));
    boton.textContent = (abre ? '▾ ' : '▸ ') + titulo;
    if (clave) plegables290.set(clave, abre);
  };
  wrap.append(boton, region);
  return wrap;
}
