/* Componentes */.metric strong,.kpi strong,.total-hero strong,td.num,.activity-count,.header-counters,.news-badge,.sat-step-time,.chart text,.invoice-summary h3{font-variant-numeric:tabular-nums}.metric strong,.kpi strong,.facts strong,.dashboard-hero h2,.xml-view,.seal-details pre,.print-seals,.invoice-summary,#fields p{overflow-wrap:anywhere}.metric,.panel,.guide,.kpi{background:var(--surface);border:var(--bd);border-radius:var(--r-l)}.metric,.kpi{padding:16px;display:grid;gap:4px;min-width:0}.metric{grid-template-columns:1fr auto;align-items:center}.cards,.kpis{display:grid;gap:12px;margin-bottom:16px}.cards{grid-template-columns:repeat(3,minmax(0,1fr))}.kpis{grid-template-columns:repeat(auto-fit,minmax(180px,1fr))}.kpi-label{display:flex;gap:8px;align-items:center;color:var(--muted);font-weight:600;font-size:var(--fs-m)}.kpi-label svg{color:var(--green)}.metric strong,.kpi strong{font-size:26px;font-weight:700}.kpi small{color:var(--muted);font-size:var(--fs-m)}.kpi.split strong{font-size:20px}.kpi.ok strong{color:var(--ok-ink)}.kpi.bad strong{color:var(--danger)}.kpi.warn strong{color:var(--warn-ink)}.total-hero{display:grid;gap:4px;justify-items:center;text-align:center;padding:20px 16px}.total-hero strong{font-size:34px;font-weight:700}.panel{min-width:0;overflow:hidden;margin-bottom:16px}.panel>p{padding:12px 16px}.panel-head,.filters,.table-foot,.guide,.modal-head,.modal-actions,.aviso-head,.activity-dock-head,.activity-result-head{display:flex;align-items:center;justify-content:space-between;gap:10px;padding:12px 16px;flex-wrap:wrap}.filters,.guide{justify-content:flex-start}.guide{background:var(--info-bg);margin-bottom:16px}.filters{background:var(--surface)}.filters input[type=search]{flex:1 1 200px}.filters button{margin-left:auto}.table-foot{color:var(--muted);font-size:var(--fs-m)}.actions,.hero-actions{display:flex;gap:8px;align-items:center;flex-wrap:wrap}.modal-head{padding:0}.modal-actions{justify-content:flex-end;margin-top:16px;padding:0}.dashboard-hero{display:flex;align-items:center;justify-content:space-between;gap:22px;flex-wrap:wrap;margin-bottom:16px;padding:24px;border-radius:var(--r-l);background:light-dark(#152c4e,#132a44);color:#fff}.dashboard-hero h2{font-size:clamp(23px,3.1vw,34px);line-height:1.13;margin:5px 0 6px}.dashboard-hero p{color:light-dark(#cfe5ee,#b7d3de)}.hero-kicker{font-size:var(--fs-xs);font-weight:700;color:#a7edda}.table-wrap{overflow-x:auto}::selection{background:light-dark(#bfe3d2,#17573f)}table,.grid-table{width:100%;border-collapse:collapse}th,td{padding:11px 13px;border-top:var(--bd)}th{font-size:var(--fs-s);color:var(--muted);background:var(--surface-2)}td small{display:block;color:var(--muted);margin-top:3px}td.num{white-space:nowrap;text-align:right}td button{font-size:var(--fs-m);padding:7px 10px;white-space:nowrap;min-height:40px}.tabs,.tabbar{display:flex;gap:4px;flex-wrap:wrap;padding:9px 12px;border-bottom:var(--bd)}.tabs button,.tabbar button{border-color:transparent}.tabs button[aria-pressed=true],.tabbar button[aria-selected=true]{background:var(--tint);color:var(--accent-ink)}.status-pill{gap:7px;border-radius:100px;padding:6px 12px;font-size:var(--fs-m);font-weight:650;border-color:transparent}.status-pill .pill-dot{width:9px;height:9px;border-radius:50%;background:currentColor;flex:none}.status-pill[data-state="warn"]{background:var(--warn-bg);color:var(--warn-ink)}.status-pill[data-state="bad"]{background:var(--danger-bg);color:var(--danger)}.status-pill[data-state="dim"]{background:var(--info-bg);color:var(--info-ink)}
.status-pill[data-state="work"]{background:var(--tint);color:var(--accent-ink)}.fiscal-state{display:grid;gap:2px;justify-items:start}.fiscal-badge{display:inline-block;padding:3px 8px;border-radius:100px;color:var(--info-ink);background:var(--info-bg);font-size:var(--fs-s);font-weight:700}.status-pill[data-state="ok"],.fiscal-badge[data-state=Vigente]{background:var(--ok-bg);color:var(--ok-ink)}.fiscal-badge[data-state=Cancelado],.fiscal-badge[data-state=Error]{color:var(--danger);background:var(--danger-bg)}.fiscal-badge[data-state^="No"],.fiscal-badge[data-state^="Formato"],.fiscal-badge[data-state^="Sin"]{color:var(--warn-ink);background:var(--warn-bg)}.fiscal-badge[data-state="69-B"]{color:#fff;background:var(--danger)}.empty{padding:36px 20px;text-align:center;display:grid;gap:6px;justify-items:center}.empty h3{font-size:var(--fs-xl);font-weight:700;letter-spacing:-.01em;color:var(--ink)}.empty p{margin:0;max-width:54ch;line-height:1.55}.empty button{margin-top:8px}p.empty{display:block;font-size:var(--fs-l);color:var(--muted);line-height:1.55}.empty.error-text{color:var(--danger)}.skel{display:grid;gap:12px}.skel-block{min-height:86px;border-radius:var(--r-l);background:linear-gradient(100deg,var(--surface-2) 40%,var(--surface) 50%,var(--surface-2) 60%);background-size:200% 100%;animation:skel-pulse 1.2s ease-in-out infinite}@keyframes skel-pulse{from{background-position:180% 0}to{background-position:-20% 0}}.steps{display:grid;gap:12px}.step{display:grid;gap:8px;padding:16px;border:var(--bd);border-radius:var(--r-l);background:var(--surface)}.step-head{display:flex;gap:10px;align-items:center}.step-num{width:28px;height:28px;border-radius:50%;background:var(--tint);color:var(--accent-ink);display:grid;place-items:center;font-weight:700;flex:none}.step-body{display:grid;gap:8px;min-width:0}.bottombar{display:none}.muted{color:var(--muted)}dialog{width:min(520px,calc(100% - 26px));border:var(--bd);border-radius:var(--r-l);padding:20px;background:var(--surface);box-shadow:var(--shadow-1)}dialog::backdrop{background:light-dark(#0d1b2e8c,#040a14d9)}.wide-dialog{width:min(990px,calc(100% - 24px));max-height:94vh}#fields{display:grid;gap:12px;margin-top:14px}#fields label{display:grid;gap:5px;font-weight:600}#formError{color:var(--danger);margin-top:9px}.portal{display:grid;gap:8px;padding:14px 16px}.xml-view{margin:0;padding:12px;max-height:45vh;overflow:auto;white-space:pre-wrap;border:var(--bd);background:var(--surface-2);font:13px/1.55 Consolas,monospace}.pdf-preview{display:block;width:100%;height:min(62vh,650px);background:var(--surface-2);border:var(--bd)}.activity-dock{position:static;background:var(--surface);border-radius:var(--r-l);padding:12px 16px;margin-bottom:16px}.activity-jobs290{position:static;background:var(--surface);border:var(--bd);border-radius:var(--r-l);padding:12px 16px;margin-bottom:16px}.etiqueta290{display:inline-flex;align-items:center;cursor:default}
.periodo290{display:inline-flex;align-items:center;gap:7px;font-size:var(--fs-m);color:var(--muted)}
.periodo290>span{font-weight:600;white-space:nowrap}.plegable290{display:grid;gap:8px}.plegable-region290{display:grid;gap:8px}.activity-dock-head,.activity-result-head{padding:0}.activity-spinner{width:16px;height:16px;border-radius:50%;border:2px solid var(--line);border-top-color:var(--green);animation:pacosat-spin .8s linear infinite;flex:none}@keyframes pacosat-spin{to{transform:rotate(360deg)}}.activity-count{color:var(--muted)}.activity-detail{margin:6px 0 0;color:var(--muted);font-size:var(--fs-m);word-break:break-all}.activity-result{background:var(--ok-bg);border-radius:var(--r-l);padding:12px 16px;margin-bottom:16px}.activity-result p{margin:6px 0}.activity-list{display:grid;padding:6px 16px 10px}.activity-item{display:flex;gap:11px;align-items:flex-start;padding:10px 0;border-top:var(--bd)}.activity-item:first-child{border-top:none}.activity-body{display:grid;gap:2px;min-width:0}.activity-body strong{font-size:var(--fs-m)}.activity-body small{color:var(--muted)}.activity-body .metric-link{justify-self:start}.aviso-card{border:var(--bd);border-radius:var(--r-l);padding:12px 16px;margin-bottom:10px}.aviso-head{padding:0;margin-bottom:4px}.aviso-card p{margin:4px 0}.aviso-next{font-weight:600;color:var(--ink)}.ok-note{color:var(--ok-ink)}.ok-note{font-weight:600}.panel:has(.chart-wrap){overflow:visible}.chart-wrap{padding:8px 16px 16px;overflow:visible}/* Sin trazo heredado (2.9.8 · R): la regla global de iconos svg{stroke:currentColor;stroke-width:1.65} de style.part se heredaba a TODO el gráfico y cada cifra se pintaba con un contorno de tinta de 1,65 px sobre su relleno — el efecto sombra/duplicado que emborronaba las cifras de las barras (verificado con render real: stroke computado rgb(23,41,63) 1.65px en cada <text>). El gráfico no es un icono: su único trazo es el de .grid-line, que declara el suyo. */.chart{width:100%;height:auto;display:block;overflow:visible;stroke:none}.chart text{fill:var(--muted);font-size:var(--fs-xs);stroke:none}.chart .bar-issued{fill:var(--green)}.chart .bar-received{fill:var(--chart-2)}.chart .grid-line{stroke:var(--line);stroke-width:1}.chart-legend{display:flex;gap:16px;flex-wrap:wrap;padding:0 16px 16px;color:var(--muted);font-size:var(--fs-m)}.chart-legend span,.legend-item{display:inline-flex;gap:6px;align-items:center}.chart-legend i{width:11px;height:11px;display:inline-block}.chart-legend .sw-issued{background:var(--green)}.chart-legend .sw-received,.chart-legend .sw-hm2{background:var(--chart-2)}#print-report{display:none}.report-head{border-bottom:3px solid var(--green);padding-bottom:10px;margin-bottom:14px}.report-head h1{font-size:var(--fs-4xl);margin:2px 0}.report-logo{max-height:54px;max-width:190px;object-fit:contain}.report-meta,.report-note{color:var(--muted);font-size:var(--fs-m)}.report-note{margin-top:12px}.view-in{animation:view-in .22s ease}@keyframes view-in{from{opacity:0;transform:translateY(4px)}to{opacity:1;transform:none}}.error-text{color:var(--danger)}.danger-soft{color:var(--danger);background:var(--danger-bg)}.small{font-size:var(--fs-m)}
/* La línea de Actividad envuelve, no se corta (2.3.2 · H6-2):
   su fila flexible puede encoger (min-width:0) y su cuerpo
   parte las palabras largas en vez de chocar con el borde del
   panel (que lleva overflow:hidden). */
.activity-item{min-width:0}.activity-body{overflow-wrap:anywhere}.activity-body small{overflow-wrap:anywhere}
.visor-previa297{display:block;width:100%;height:auto;max-height:62vh;object-fit:contain;background:var(--surface-2);border:var(--bd)}

/* ── (3.2.0 · pieza 8) Cifras tabulares en TODA tabla y en las clases
   de cifra/importe que la primera pasada (cabecera de este archivo)
   no cubría: con tabular-nums los decimales se alinean en columna y
   las cifras no bailan al refrescarse. */
table td,table th,.pagos-table td,.visor-table td,.tot-suma,.tot-anio-sum,.saldo-line,.graf-cifra2913,.facturas-totales2913,.dl-summary strong,.invoice-summary strong,.cifra320{font-variant-numeric:tabular-nums}
/* ── (3.2.0 · pieza 10) Anatomía única de tarjeta (ayudantes ADITIVOS,
   no renombran nada): veredicto arriba (.tarjeta320-cab), cifra
   protagonista (.cifra320) y acción a la derecha (.tarjeta320-accion).
   Una pantalla adopta la anatomía envolviendo su tarjeta en
   .tarjeta320; las tarjetas de siempre (.panel, .metric, .kpi) no
   cambian. */
.tarjeta320{background:var(--surface);border:var(--bd);border-radius:var(--r-l);box-shadow:var(--card-sh);padding:16px;display:grid;gap:10px;min-width:0;margin-bottom:16px}
.tarjeta320-cab{display:flex;align-items:flex-start;justify-content:space-between;gap:12px;flex-wrap:wrap}
.tarjeta320-cab p{margin:0}
.cifra320{font-size:var(--fs-4xl);font-weight:700;line-height:1.15;letter-spacing:-.01em;color:var(--ink)}
.tarjeta320-accion{display:flex;gap:8px;align-items:center;flex-wrap:wrap;justify-content:flex-end}
/* ── (3.2.0 · pieza 5) Esqueleto de carga con la forma de su tarjeta:
   .skel320 es el contenedor (tarjeta por defecto; .skel320-fila, una
   fila de lista/tabla) y cada hijo directo es un bloque con el mismo
   shimmer de .skel-block. Sin movimiento si el sistema lo pide. */
.skel320{display:grid;gap:10px;background:var(--surface);border:var(--bd);border-radius:var(--r-l);padding:16px;margin-bottom:16px}
.skel320>*{height:14px;border-radius:6px;background:linear-gradient(100deg,var(--surface-2) 40%,var(--surface) 50%,var(--surface-2) 60%);background-size:200% 100%;animation:skel-pulse 1.2s ease-in-out infinite}
.skel320>.skel320-titulo{height:22px;width:55%}
.skel320>.skel320-cifra{height:30px;width:38%}
.skel320-fila{padding:10px 16px;gap:0}
.skel320-fila>*{height:12px}
@media (prefers-reduced-motion:reduce){.skel320>*{animation:none}}
/* ── (3.2.0 · pieza 6) Estado vacío diseñado: icono grande y suave,
   la frase llana y la única acción que toca, centrados — compañero
   de .empty para las pantallas nuevas de la ronda. */
.vacio320{padding:40px 20px;text-align:center;display:grid;gap:8px;justify-items:center;color:var(--muted)}
.vacio320 svg{width:44px;height:44px;opacity:.5}
.vacio320 strong{color:var(--ink);font-size:var(--fs-xl);font-weight:700;letter-spacing:-.01em}
.vacio320 p{margin:0;max-width:54ch;line-height:1.55}
.vacio320 button{margin-top:8px}
