:root{--ink:#142338;--muted:#53647b;--border:#e1e8f0;--surface:#fff;--bg:#edf2f8;--green:#17635f;--green-hover:#114b48;--tint:#e4f2ef;--nav:#101d31;--nav-text:#dce8f6;--focus:#257879}body{background:radial-gradient(ellipse at 85% 0%,#e2ecf7 0,transparent 52%),var(--bg)}.sidebar{background:linear-gradient(165deg,#182b47 0,#101d31 62%,#14243a 100%);border-right:1px solid #304565;padding:26px 18px}.logo{background:linear-gradient(140deg,#e4f7ee,#8adbc3);color:#143643;box-shadow:0 8px 22px #0003}.brand{font-size:22px}.brand small{color:#a9bdcf}.switcher select,.sidebar nav button[aria-current]{background:#223a55;border-color:#3f5c7a;color:#ddf5ef}.sidebar nav button{padding:11px 10px}.sidebar nav button:hover,.sidebar .quiet:hover{background:#23384f}.top{min-height:60px;border-color:#e5ebf4;background:#ffffffeb}.badge{border:1px solid #cce7df;color:#154d47}.heading{align-items:center}.heading h1{font-size:clamp(30px,4vw,48px)}.heading p{font-size:14px}.dashboard-hero{display:flex;align-items:center;justify-content:space-between;gap:22px;flex-wrap:wrap;margin-bottom:18px;padding:23px 27px;border-radius:17px;background:radial-gradient(ellipse at 92% 7%,#236a78 0,transparent 54%),linear-gradient(122deg,#162a47,#1f4660);color:#fff;box-shadow:0 12px 30px #1c3d632b}.dashboard-hero h2{font-size:clamp(23px,3.1vw,34px);line-height:1.13;margin:5px 0 6px;overflow-wrap:anywhere}.dashboard-hero p{color:#d4e8ef}.hero-kicker{font-size:11px;letter-spacing:.16em;font-weight:700;color:#a7edda}.hero-actions{display:flex;flex-wrap:wrap;gap:8px}.hero-actions button{border-color:#7196a6;color:#f1fbff;background:#294d65}.hero-actions button:hover{background:#356680}.metric,.panel{border-radius:13px;box-shadow:0 2px 5px #2742640b}.metric{padding:17px}.metric strong{font-size:30px}.metric-label svg{box-sizing:content-box;padding:6px;border-radius:8px;background:#e9f2f9;color:#29597a}.metric:nth-child(2) .metric-label svg{background:#e5f4ed;color:#236c54}.metric:nth-child(3) .metric-label svg{background:#eef0fa;color:#514c83}.dashboard-grid{display:grid;grid-template-columns:minmax(0,1.35fr) minmax(0,1fr);gap:14px;align-items:start}.panel-head{padding:16px 17px}.panel-head h2{font-size:18px}.panel th{background:#f5f8fc}.panel tbody tr:hover{background:#f8fbfe}.panel td:first-child{min-width:120px}.guide{background:#e9f3f6;border-color:#ccdee6}.filters{background:#fbfcff}.filters button{margin-left:auto}.wide-dialog{width:min(990px,calc(100% - 24px));max-height:94vh}.pdf-preview{display:block;width:100%;height:min(62vh,650px);background:#eef2f7;border:1px solid #d7e1eb;border-radius:9px}.xml-view{background:#f2f6fb}.actions{flex-wrap:wrap}#form{max-height:inherit}.dialog-actions{position:sticky;bottom:0;background:#fff;padding-top:6px}@media(max-width:1080px){.dashboard-grid{grid-template-columns:1fr}}@media(max-width:780px){.sidebar{padding:15px}.dashboard-hero{padding:18px}.heading .actions{width:100%}.heading .actions button{flex:0 1 auto}.heading .actions .primary{width:auto}.filters button{margin-left:0}}
