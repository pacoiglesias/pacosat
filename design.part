/* Componentes */.metric strong,.kpi strong,.total-hero strong,td.num,.activity-count,.header-counters,.news-badge,.sat-step-time,.chart text,.invoice-summary h3{font-variant-numeric:tabular-nums}.metric strong,.kpi strong,.facts strong,.dashboard-hero h2,.xml-view,.seal-details pre,.print-seals,.invoice-summary,#fields p{overflow-wrap:anywhere}.metric,.panel,.guide,.kpi{background:var(--surface);border:var(--bd);border-radius:var(--r-l)}.metric,.kpi{padding:16px;display:grid;gap:4px;min-width:0}.metric{grid-template-columns:1fr auto;align-items:center}.cards,.kpis{display:grid;gap:12px;margin-bottom:16px}.cards{grid-template-columns:repeat(3,minmax(0,1fr))}.kpis{grid-template-columns:repeat(auto-fit,minmax(180px,1fr))}.metric-label,.kpi-label{display:flex;gap:8px;align-items:center;color:var(--muted);font-weight:600;font-size:13px}.metric-label{grid-column:1/-1}.metric-label svg{color:var(--green)}.kpi-label svg{color:var(--green)}.metric strong,.kpi strong{font-size:26px;font-weight:700}.kpi small{color:var(--muted);font-size:13px}.kpi.split strong{font-size:20px}.kpi.ok strong{color:var(--ok-ink)}.kpi.bad strong{color:var(--danger)}.kpi.warn strong{color:var(--warn-ink)}.total-hero{display:grid;gap:4px;justify-items:center;text-align:center;padding:20px 16px}.total-hero strong{font-size:34px;font-weight:700}.panel{min-width:0;overflow:hidden;margin-bottom:16px}.panel>p{padding:12px 16px}.panel-head,.filters,.table-foot,.guide,.modal-head,.modal-actions,.aviso-head,.activity-dock-head,.activity-result-head{display:flex;align-items:center;justify-content:space-between;gap:10px;padding:12px 16px;flex-wrap:wrap}.filters,.guide{justify-content:flex-start}.guide{background:var(--info-bg);margin-bottom:16px}.filters{background:var(--surface)}.filters input[type=search]{flex:1 1 200px}.filters button{margin-left:auto}.table-foot{color:var(--muted);font-size:13px}.actions,.hero-actions{display:flex;gap:8px;align-items:center;flex-wrap:wrap}.modal-head{padding:0}.modal-actions{justify-content:flex-end;margin-top:16px;padding:0}.dashboard-grid{display:grid;grid-template-columns:minmax(0,1.35fr) minmax(0,1fr);gap:16px}.dashboard-hero{display:flex;align-items:center;justify-content:space-between;gap:22px;flex-wrap:wrap;margin-bottom:16px;padding:24px;border-radius:var(--r-l);background:light-dark(#152c4e,#132a44);color:#fff}.dashboard-hero h2{font-size:clamp(23px,3.1vw,34px);line-height:1.13;margin:5px 0 6px}.dashboard-hero p{color:light-dark(#cfe5ee,#b7d3de)}.hero-kicker{font-size:11px;font-weight:700;color:#a7edda}.table-wrap{overflow-x:auto}::selection{background:light-dark(#bfe3d2,#17573f)}table,.grid-table{width:100%;border-collapse:collapse}th,td{padding:11px 13px;border-top:var(--bd)}th{font-size:12px;color:var(--muted);background:var(--surface-2)}td small{display:block;color:var(--muted);margin-top:3px}td.num{white-space:nowrap;text-align:right}td button{font-size:13px;padding:7px 10px;white-space:nowrap;min-height:40px}.tabs,.tabbar{display:flex;gap:4px;flex-wrap:wrap;padding:9px 12px;border-bottom:var(--bd)}.tabs button,.tabbar button{border-color:transparent}.tabs button[aria-pressed=true],.tabbar button[aria-selected=true]{background:var(--tint);color:var(--accent-ink)}.status-pill{gap:7px;border-radius:100px;padding:6px 12px;font-size:13px;font-weight:650;border-color:transparent}.status-pill .pill-dot{width:9px;height:9px;border-radius:50%;background:currentColor;flex:none}.status-pill[data-state="warn"]{background:var(--warn-bg);color:var(--warn-ink)}.status-pill[data-state="bad"]{background:var(--danger-bg);color:var(--danger)}.status-pill[data-state="dim"]{background:var(--info-bg);color:var(--info-ink)}.fiscal-state{display:grid;gap:2px;justify-items:start}.fiscal-badge{display:inline-block;padding:3px 8px;border-radius:100px;color:var(--info-ink);background:var(--info-bg);font-size:12px;font-weight:700}.status-pill[data-state="ok"],.fiscal-badge[data-state=Vigente]{background:var(--ok-bg);color:var(--ok-ink)}.fiscal-badge[data-state=Cancelado],.fiscal-badge[data-state=Error]{color:var(--danger);background:var(--danger-bg)}.fiscal-badge[data-state^="No"],.fiscal-badge[data-state^="Formato"],.fiscal-badge[data-state^="Sin"]{color:var(--warn-ink);background:var(--warn-bg)}.fiscal-badge[data-state="69-B"]{color:#fff;background:var(--danger)}.empty{padding:30px 16px;text-align:center}.empty p{margin:6px 0 12px}.skel{display:grid;gap:12px}.skel-block{min-height:86px;border-radius:var(--r-l);background:linear-gradient(100deg,var(--surface-2) 40%,var(--surface) 50%,var(--surface-2) 60%);background-size:200% 100%;animation:skel-pulse 1.2s ease-in-out infinite}@keyframes skel-pulse{from{background-position:180% 0}to{background-position:-20% 0}}.steps{display:grid;gap:12px}.step{display:grid;gap:8px;padding:16px;border:var(--bd);border-radius:var(--r-l);background:var(--surface)}.step-head{display:flex;gap:10px;align-items:center}.step-num{width:28px;height:28px;border-radius:50%;background:var(--tint);color:var(--accent-ink);display:grid;place-items:center;font-weight:700;flex:none}.step-body{display:grid;gap:8px;min-width:0}.bottombar{display:none}.muted{color:var(--muted)}dialog{width:min(520px,calc(100% - 26px));border:var(--bd);border-radius:var(--r-l);padding:20px;background:var(--surface);box-shadow:var(--shadow-1)}dialog::backdrop{background:light-dark(#0d1b2e8c,#040a14d9)}.wide-dialog{width:min(990px,calc(100% - 24px));max-height:94vh}#fields{display:grid;gap:12px;margin-top:14px}#fields label{display:grid;gap:5px;font-weight:600}#formError{color:var(--danger);margin-top:9px}.portal{display:grid;gap:8px;padding:14px 16px}.xml-view{margin:0;padding:12px;max-height:45vh;overflow:auto;white-space:pre-wrap;border:var(--bd);background:var(--surface-2);font:13px/1.55 Consolas,monospace}.pdf-preview{display:block;width:100%;height:min(62vh,650px);background:var(--surface-2);border:var(--bd)}.activity-dock{position:sticky;top:8px;z-index:30;background:var(--surface);border-radius:var(--r-l);padding:12px 16px;margin-bottom:16px;}.activity-dock-head,.activity-result-head{padding:0}.activity-spinner{width:16px;height:16px;border-radius:50%;border:2px solid var(--line);border-top-color:var(--green);animation:pacosat-spin .8s linear infinite;flex:none}@keyframes pacosat-spin{to{transform:rotate(360deg)}}.activity-count{color:var(--muted)}.activity-detail{margin:6px 0 0;color:var(--muted);font-size:13px;word-break:break-all}.activity-result{background:var(--ok-bg);border-radius:var(--r-l);padding:12px 16px;margin-bottom:16px}.activity-result p{margin:6px 0}.activity-list{display:grid;padding:6px 16px 10px}.activity-item{display:flex;gap:11px;align-items:flex-start;padding:10px 0;border-top:var(--bd)}.activity-item:first-child{border-top:none}.activity-kind{flex:none;padding:3px 8px;border-radius:100px;font-size:11px;font-weight:750;background:var(--info-bg);color:var(--info-ink)}.activity-kind[data-kind=sat]{background:var(--tint);color:var(--accent-ink)}.activity-kind[data-kind=alert]{background:var(--danger-bg);color:var(--danger)}.activity-body{display:grid;gap:2px;min-width:0}.activity-body strong{font-size:13px}.activity-body small{color:var(--muted)}.activity-body .metric-link{justify-self:start}.activity-link{cursor:pointer}.aviso-card{border:var(--bd);border-radius:var(--r-l);padding:12px 16px;margin-bottom:10px}.aviso-head{padding:0;margin-bottom:4px}.aviso-card p{margin:4px 0}.aviso-next{font-weight:600;color:var(--ink)}.ok-note{color:var(--ok-ink)}.ok-note{font-weight:600}.panel:has(.chart-wrap){overflow:visible}.chart-wrap{padding:8px 16px 16px;overflow:visible}.chart{width:100%;height:auto;display:block;overflow:visible}.chart text{fill:var(--muted);font-size:11px}.chart .bar-issued{fill:var(--green)}.chart .bar-received{fill:var(--chart-2)}.chart .grid-line{stroke:var(--line);stroke-width:1}.chart-legend{display:flex;gap:16px;flex-wrap:wrap;padding:0 16px 16px;color:var(--muted);font-size:13px}.chart-legend span,.legend-item{display:inline-flex;gap:6px;align-items:center}.chart-legend i{width:11px;height:11px;display:inline-block}.chart-legend .sw-issued{background:var(--green)}.chart-legend .sw-received,.chart-legend .sw-hm2{background:var(--chart-2)}#print-report{display:none}.report-head{border-bottom:3px solid var(--green);padding-bottom:10px;margin-bottom:14px}.report-head h1{font-size:24px;margin:2px 0}.report-logo{max-height:54px;max-width:190px;object-fit:contain}.report-meta,.report-note{color:var(--muted);font-size:13px}.report-note{margin-top:12px}.view-in{animation:view-in .22s ease}@keyframes view-in{from{opacity:0}}.error-text{color:var(--danger)}.danger-soft{color:var(--danger);background:var(--danger-bg)}.small{font-size:13px}
