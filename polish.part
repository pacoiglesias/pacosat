/* Pantallas */.period-chip{display:inline-block;padding:5px 8px;border-radius:7px;background:var(--info-bg);color:var(--info-ink);font-size:12px}.activity-bars{display:grid;grid-template-columns:repeat(7,minmax(0,1fr));gap:12px;padding:4px 16px 16px}.activity-day{display:grid;gap:5px;min-width:0;color:var(--muted);font-size:12px}.activity-day strong{color:var(--ink)}.activity-day meter{width:100%;height:12px}.invoice-dialog{width:min(690px,calc(100% - 24px));max-height:94vh}.cfdi-dialog{width:min(940px,calc(100% - 24px));max-height:94vh}.invoice-summary{display:grid;gap:13px;background:var(--surface-2);border:var(--bd);padding:16px;border-radius:14px}.invoice-summary h3{font-size:26px}.invoice-summary small,.invoice-parties span{color:var(--muted)}.invoice-parties{display:grid;grid-template-columns:1fr 1fr;gap:8px}.invoice-parties>div,.facts>div{display:grid;gap:3px;padding:10px;background:var(--surface);border-radius:9px;min-width:0}.invoice-parties small,.facts small{font-size:11px;color:var(--muted);font-weight:700}.invoice-concepts,.seal-details{padding:11px 13px;border-radius:9px}.invoice-concepts ul{margin:6px 0 0}.facts{display:grid;grid-template-columns:repeat(auto-fit,minmax(170px,1fr));gap:9px;margin:10px 0}.facts>div{gap:2px;background:var(--surface-2)}.facts strong{font-size:13px}.seal-details{margin:8px 0}.seal-details summary{cursor:pointer;font-weight:650}.seal-details pre{white-space:pre-wrap;font-size:11px;max-height:130px;overflow:auto}.print-seals{font-size:10px}.print-seals p{margin:3px 0}.cap-row{display:flex;gap:9px;align-items:flex-start;padding:5px 0}.cap-row .tag{flex:none}.monitor-actions{display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:12px;padding:16px}.monitor-action{display:grid;gap:10px;align-content:start;background:var(--surface-2);border-radius:14px;padding:16px;min-width:0}.monitor-action p,.monitor-truth{font-size:13px}.monitor-dates{display:flex;gap:10px;flex-wrap:wrap}.monitor-dates label{display:grid;gap:5px;font-weight:600;font-size:13px}button.monitor-big{width:100%;padding:13px 15px;min-height:44px;justify-content:center}.monitor-truth{display:grid;gap:3px;padding:0 16px 16px;color:var(--muted)}.chart-legend .sw-hm0{background:var(--surface-2);border:var(--bd)}.chart-legend .sw-hm1{background:var(--chart-2);opacity:.5}.hm-scroll{overflow-x:auto;padding:2px 16px 6px}.hm{display:block;height:auto}.hm rect.hm-l0{fill:var(--surface-2);stroke:var(--line);stroke-width:.6}.hm rect.hm-l1{fill:var(--chart-2);opacity:.5}.hm rect.hm-l2{fill:var(--chart-2)}.hm text{fill:var(--muted);font-size:9px;font-weight:600}.hm-detail{padding:0 16px 13px;color:var(--muted)}.timeline-item{display:grid;padding:7px 0 7px 13px;border-left:2px solid var(--line)}.timeline-item small,.timeline-empty{color:var(--muted)}.timeline-empty{margin:4px 0}.traffic-strip{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:16px}.today-line{display:flex;gap:8px;align-items:baseline;flex-wrap:wrap;padding:0 16px 6px}.next-step{margin:6px 16px 16px;padding:13px 16px;border-radius:14px;background:var(--info-bg);display:grid;gap:6px;justify-items:start}.rest-switch{display:flex;gap:10px;align-items:center;flex-wrap:wrap}.rest-label{display:grid;gap:1px}.rest-label small{color:var(--muted);font-size:12px}.rest-toggle[aria-pressed="true"]{background:var(--warn-bg);color:var(--warn-ink);border-color:transparent}.filter-chips{display:flex;gap:7px;flex-wrap:wrap;align-items:center}.filter-chips:not(:empty){padding:10px 16px;border-top:var(--bd)}.filter-chip{border-radius:100px;padding:5px 11px;font-size:13px;background:var(--surface-2)}.pw-eye{padding:5px 8px;margin-top:4px;justify-self:start}.news-note{margin:10px 16px 0;padding:7px 10px;border:1px solid var(--warn-ink);border-radius:8px;background:var(--warn-bg);color:var(--warn-ink);font-size:13px;font-weight:700}.rfc-note{font-size:13px;font-weight:600;color:var(--muted)}.rfc-note[data-state=ok]{color:var(--ok-ink)}.rfc-note[data-state=warn]{color:var(--warn-ink);background:var(--warn-bg);border:1px solid var(--warn-ink);border-radius:8px;padding:7px 10px}.rfc-note[data-state=error]{color:var(--danger);background:var(--danger-bg);border:1px solid var(--danger);border-radius:8px;padding:7px 10px}.cp-row{display:flex;align-items:flex-start;gap:12px;padding:10px 4px;border-bottom:var(--bd)}.cp-row:last-child{border-bottom:0}.cp-main{display:flex;flex-direction:column;gap:2px;flex:1;min-width:0}.cp-hit{font-size:13px;font-weight:600}.cp-hit.sev-bad{color:var(--bad)}.cp-hit.sev-warn{color:var(--warn)}.cp-hit.sev-ok{color:var(--ok)}.satdoc-form{display:flex;flex-wrap:wrap;gap:10px;align-items:center}.satdoc-form input[type="text"]{flex:1}.switch-line{display:inline-flex;gap:8px;align-items:center}.rescue-folios{font-size:13px;word-break:break-all}.reconcile-candidate{border-radius:14px;padding:10px 12px;margin:8px 0;background:var(--surface-2)}.decl-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(120px,1fr));gap:8px;margin:12px 0}.decl-cell{border-radius:10px;padding:8px 10px;display:grid;gap:2px}.decl-recuperada{background:var(--tint)}.decl-sin-recuperar{background:var(--warn-bg)}.today-clarity{display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:12px}.today-col{border-radius:14px;padding:10px 12px}.today-col h3{margin:0 0 6px}.visor-table td:nth-child(3),.visor-table td:nth-child(4){white-space:nowrap}.pagos-table{margin:8px 0 4px;font-size:14px}.pagos-table th{padding:6px 8px;border-bottom:2px solid var(--line)}.pagos-table td{padding:6px 8px;border-bottom:var(--bd);vertical-align:middle}.pagos-cell{cursor:pointer}.pagos-over td{background:rgba(220,38,38,.07)}.pagos-total{font-weight:700;font-size:16px;margin:4px 0 10px}.pagos-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(230px,1fr));gap:10px 14px;margin:8px 0}.pagos-field{display:flex;flex-direction:column;gap:4px;font-size:13px}.pagos-field span{color:var(--muted)}.pagos-form{margin-top:16px;border-top:var(--bd);padding-top:10px}.pagos-form h3{margin-bottom:8px}.pagos-warn{border:1px solid rgba(217,119,6,.5);background:rgba(217,119,6,.08);border-radius:8px;padding:8px 12px;margin:10px 0}.pagos-seed{border:1px dashed rgba(37,99,235,.5);border-radius:8px;padding:10px 12px;margin:8px 0 12px}.pagos-actions{display:flex;gap:8px;flex-wrap:wrap}.pagos-lines th:nth-child(2),.pagos-lines td:nth-child(2){min-width:210px}.pagos-lines th:nth-child(3),.pagos-lines td:nth-child(3){white-space:nowrap}.pagos-lines th:nth-child(6),.pagos-lines td:nth-child(6){min-width:108px}.sat-meta{display:flex;gap:4px 14px;flex-wrap:wrap}.sat-progress{margin-top:10px;border-top:1px dashed var(--line);padding-top:8px}.sat-progress-head{margin:0 0 6px}.sat-progress-note{font-size:13px;margin:6px 0 0}.sat-steps{list-style:none;margin:0;padding:0;font-size:13px}.sat-steps li{display:flex;gap:8px;padding:2px 0;align-items:baseline}.sat-step-time{opacity:.6;white-space:nowrap}.sat-run{border-radius:8px;padding:6px 10px;margin:6px 0}.sat-run summary{cursor:pointer;font-size:13px;font-weight:600}.sat-run-files{display:flex;gap:8px;flex-wrap:wrap;margin-top:8px}.swatches{display:flex;gap:8px;flex-wrap:wrap}.swatch{padding:7px 10px}.swatch[aria-pressed="true"]{border-color:var(--green);background:var(--tint);color:var(--ok-ink)}.swatch-dot{width:15px;height:15px;border-radius:50%;display:inline-block}.logo-preview{width:52px;height:52px;object-fit:contain;border:var(--bd);border-radius:10px}/* Acentos (formato de verify.cjs). */:root[data-accent="azul"]{--green:#175c9e;--green-hover:#114a80;--on-accent:#ffffff;--tint:#e3edf8;--ok-ink:#175c9e;--nav-active-bg:#123c63;--nav-active-ink:#cfe2f5}:root[data-theme="dark"][data-accent="azul"]{--green:#6ea8dc;--green-hover:#8dbde8;--on-accent:#0a1c30;--tint:#17334f;--ok-ink:#6ea8dc;--nav-active-bg:#17334f;--nav-active-ink:#6ea8dc}:root[data-accent="teal"]{--green:#0f766e;--green-hover:#0b5a54;--on-accent:#ffffff;--tint:#dcf2ef;--ok-ink:#0f766e;--nav-active-bg:#0a3f3a;--nav-active-ink:#c4efe9}:root[data-theme="dark"][data-accent="teal"]{--green:#2dd4bf;--green-hover:#5eead4;--on-accent:#052e2a;--tint:#0f3532;--ok-ink:#2dd4bf;--nav-active-bg:#0f3532;--nav-active-ink:#2dd4bf}:root[data-accent="violeta"]{--green:#6d28d9;--green-hover:#571db0;--on-accent:#ffffff;--tint:#ece4fa;--ok-ink:#6d28d9;--nav-active-bg:#3d1478;--nav-active-ink:#ddd0fb}:root[data-theme="dark"][data-accent="violeta"]{--green:#a78bfa;--green-hover:#bfa8fc;--on-accent:#1d0b38;--tint:#2a1b4d;--ok-ink:#a78bfa;--nav-active-bg:#2a1b4d;--nav-active-ink:#a78bfa}:root[data-accent="burdeos"]{--green:#9f2436;--green-hover:#7f1b2b;--on-accent:#ffffff;--tint:#f9e3e6;--ok-ink:#9f2436;--nav-active-bg:#57101d;--nav-active-ink:#f6ccd2}:root[data-theme="dark"][data-accent="burdeos"]{--green:#f08a94;--green-hover:#f5a7ae;--on-accent:#330a10;--tint:#472028;--ok-ink:#f08a94;--nav-active-bg:#472028;--nav-active-ink:#f08a94}:root[data-accent="ambar"]{--green:#9a5b00;--green-hover:#7c4900;--on-accent:#ffffff;--tint:#f7ecd4;--ok-ink:#9a5b00;--nav-active-bg:#54350a;--nav-active-ink:#f3dfae}:root[data-theme="dark"][data-accent="ambar"]{--green:#f5b04c;--green-hover:#ffc46b;--on-accent:#2e1c02;--tint:#453310;--ok-ink:#f5b04c;--nav-active-bg:#453310;--nav-active-ink:#f5b04c}:root[data-accent="rosa"]{--green:#b01854;--green-hover:#8f1244;--on-accent:#ffffff;--tint:#f9e0ea;--ok-ink:#b01854;--nav-active-bg:#5c0d2f;--nav-active-ink:#f6c9da}:root[data-theme="dark"][data-accent="rosa"]{--green:#f78fb8;--green-hover:#faa9ca;--on-accent:#360a1c;--tint:#472031;--ok-ink:#f78fb8;--nav-active-bg:#472031;--nav-active-ink:#f78fb8}:root[data-accent="grafito"]{--green:#3f5468;--green-hover:#31424f;--on-accent:#ffffff;--tint:#e5ebf0;--ok-ink:#3f5468;--nav-active-bg:#22303f;--nav-active-ink:#d3dee8}:root[data-theme="dark"][data-accent="grafito"]{--green:#9db1c8;--green-hover:#b3c4d8;--on-accent:#101b26;--tint:#22303f;--ok-ink:#9db1c8;--nav-active-bg:#22303f;--nav-active-ink:#9db1c8}@media(max-width:1080px){.dashboard-grid{grid-template-columns:1fr}}@media(max-width:900px){.top-search input{min-width:120px;width:38vw}}@media(max-width:860px){.sidebar{display:none}.frame{grid-template-columns:1fr}.bottombar{display:grid;grid-template-columns:repeat(5,1fr);gap:4px;position:fixed;left:0;right:0;bottom:0;z-index:40;background:var(--surface);border-top:var(--bd);padding:6px 8px calc(6px + env(safe-area-inset-bottom))}.bottombar button{flex-direction:column;gap:2px;font-size:11px;padding:6px 2px;border-color:transparent;background:transparent}.bottombar button[aria-current]{background:var(--tint);color:var(--ok-ink)}.page{padding-bottom:84px}.total-hero strong{font-size:28px}.frame.sheet-open .sidebar{display:flex;position:fixed;inset:0 auto 0 0;width:min(300px,86vw);z-index:50;overflow-y:auto}.frame.sheet-open .sidebar nav{display:grid}.card-table .table-scroll,.card-table.table-scroll{overflow:visible}.card-table .grid-table{display:block}.card-table .grid-table thead{display:none}.card-table .grid-table tbody,.card-table .grid-table tr{display:block}.card-table .grid-table tr{border:var(--bd);border-radius:14px;padding:8px 12px;margin-bottom:12px}.card-table .grid-table td{display:flex;justify-content:space-between;gap:12px;border-top:0;padding:6px 0}.card-table .grid-table td::before{content:attr(data-label);color:var(--muted);font-weight:600}}@media(max-width:780px){.frame{grid-template-columns:1fr}.sidebar{padding:14px;gap:12px}.switcher{grid-template-columns:minmax(0,1fr) auto}.switcher label{grid-column:1/-1}.sidebar nav{display:flex;flex-wrap:wrap}.local{display:none}.top,.page{padding:14px}.nav-caption{width:100%;padding:3px 5px}.metric{min-height:0}.dashboard-hero{padding:18px}.heading .actions{width:100%}.header-counters{display:none}}@media(max-width:460px){.invoice-parties{grid-template-columns:1fr}.cards{grid-template-columns:1fr}.heading .primary{width:100%}.filters input,.filters select{flex:1 1 140px}.monitor-actions{padding:10px}.monitor-dates label{flex:1 1 130px}}@media(max-width:390px){.activity-bars{padding-inline:9px;gap:4px}}@media print{.frame{display:none!important}#print-report{display:block!important;color:#000;background:#fff}#print-report table{width:100%;border-collapse:collapse}#print-report th,#print-report td{border:1px solid #bbb;padding:6px 8px;font-size:12px}}@media (prefers-reduced-motion:reduce){*,*::before,*::after{transition:none!important;animation:none!important}}.timeline{display:grid}
