/* Pantallas */.period-chip{display:inline-block;padding:5px 8px;border-radius:7px;background:var(--info-bg);color:var(--info-ink);font-size:12px}.invoice-dialog{width:min(690px,calc(100% - 24px));max-height:94vh}.cfdi-dialog{width:min(940px,calc(100% - 24px));max-height:94vh}.invoice-summary{display:grid;gap:13px;background:var(--surface-2);border:var(--bd);padding:16px;border-radius:var(--r-l)}.invoice-summary h3{font-size:26px}.invoice-summary small,.invoice-parties span{color:var(--muted)}.invoice-parties{display:grid;grid-template-columns:1fr 1fr;gap:8px}.invoice-parties>div,.facts>div{display:grid;gap:3px;padding:10px;background:var(--surface);border-radius:9px;min-width:0}.invoice-parties small,.facts small{font-size:11px;color:var(--muted);font-weight:700}.invoice-concepts,.seal-details{padding:11px 13px;border-radius:9px}.invoice-concepts ul{margin:6px 0 0}.facts{display:grid;grid-template-columns:repeat(auto-fit,minmax(170px,1fr));gap:9px;margin:10px 0}.facts>div{gap:2px;background:var(--surface-2)}.facts strong{font-size:13px}.seal-details{margin:8px 0}.seal-details summary{cursor:pointer;font-weight:650}.seal-details pre{white-space:pre-wrap;font-size:11px;max-height:130px;overflow:auto}.print-seals{font-size:10px}.print-seals p{margin:3px 0}.cap-row{display:flex;gap:9px;align-items:flex-start;padding:5px 0}.cap-row .tag{flex:none}.monitor-actions{display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:12px;padding:16px}.monitor-action{display:grid;gap:10px;align-content:start;background:var(--surface-2);border-radius:var(--r-l);padding:16px;min-width:0}.monitor-action p,.monitor-truth{font-size:13px}button.monitor-big{width:100%;padding:13px 15px;min-height:44px;justify-content:center}.monitor-truth{display:grid;gap:3px;padding:0 16px 16px;color:var(--muted)}.chart-legend .sw-hm0{background:var(--surface-2);border:var(--bd)}.chart-legend .sw-hm1{background:var(--chart-2);opacity:.5}.hm-scroll{overflow-x:auto;padding:2px 16px 6px}.hm{display:block;height:auto}.hm rect.hm-l0{fill:var(--surface-2);stroke:var(--line);stroke-width:.6}.hm rect.hm-l1{fill:var(--chart-2);opacity:.5}.hm rect.hm-l2{fill:var(--chart-2)}.hm text{fill:var(--muted);font-size:11px;font-weight:600}.hm-detail{padding:0 16px 13px;color:var(--muted)}.timeline-item{display:grid;padding:7px 0 7px 13px;border-left:2px solid var(--line)}.timeline-item small,.timeline-empty{color:var(--muted)}.timeline-empty{margin:4px 0}.traffic-strip{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:16px}.today-line{display:flex;gap:8px;align-items:baseline;flex-wrap:wrap;padding:0 16px 6px}.next-step{margin:6px 16px 16px;padding:13px 16px;border-radius:var(--r-l);background:var(--info-bg);display:grid;gap:6px;justify-items:start}.rest-switch{display:flex;gap:10px;align-items:center;flex-wrap:wrap}.rest-label{display:grid;gap:1px}.rest-label small{color:var(--muted);font-size:12px}.rest-toggle[aria-pressed="true"]{background:var(--warn-bg);color:var(--warn-ink);border-color:transparent}.filter-chips{display:flex;gap:7px;flex-wrap:wrap;align-items:center}.filter-chips:not(:empty){padding:10px 16px;border-top:var(--bd)}.filter-chip{border-radius:100px;padding:5px 11px;font-size:13px;background:var(--surface-2)}.pw-eye{padding:5px 8px;margin-top:4px;justify-self:start}.news-note{margin:10px 16px 0;padding:7px 10px;border:1px solid var(--warn-ink);border-radius:8px;background:var(--warn-bg);color:var(--warn-ink);font-size:13px;font-weight:700}.rfc-note{font-size:13px;font-weight:600;color:var(--muted)}.rfc-note[data-state=ok]{color:var(--ok-ink)}.rfc-note[data-state=warn]{color:var(--warn-ink);background:var(--warn-bg);border:1px solid var(--warn-ink);border-radius:8px;padding:7px 10px}.rfc-note[data-state=error]{color:var(--danger);background:var(--danger-bg);border:1px solid var(--danger);border-radius:8px;padding:7px 10px}.cp-row{display:flex;align-items:flex-start;gap:12px;padding:10px 4px;border-bottom:var(--bd)}.cp-row:last-child{border-bottom:0}.cp-main{display:flex;flex-direction:column;gap:2px;flex:1;min-width:0}.cp-hit{font-size:13px;font-weight:600}.cp-hit.sev-warn{color:var(--warn)}.satdoc-form{display:flex;flex-wrap:wrap;gap:10px;align-items:center}.satdoc-form input[type="text"]{flex:1}.switch-line{display:inline-flex;gap:8px;align-items:center}.rescue-folios{font-size:13px;word-break:break-all}.reconcile-candidate{border-radius:var(--r-l);padding:10px 12px;margin:8px 0;background:var(--surface-2)}.decl-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(120px,1fr));gap:8px;margin:12px 0}.decl-cell{border-radius:var(--r-m);padding:10px 12px;display:grid;gap:2px}.today-clarity{display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:12px}.today-col{border-radius:var(--r-l);padding:10px 12px}.today-col h3{margin:0 0 6px}.visor-table td:nth-child(3),.visor-table td:nth-child(4){white-space:nowrap}.pagos-table{margin:8px 0 4px;font-size:14px}.pagos-table th{padding:6px 8px;border-bottom:2px solid var(--line)}.pagos-table td{padding:6px 8px;border-bottom:var(--bd);vertical-align:middle}.pagos-cell{cursor:pointer}.pagos-over td{background:color-mix(in srgb,var(--danger) 8%,transparent)}.pagos-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(230px,1fr));gap:10px 14px;margin:8px 0}.pagos-field{display:flex;flex-direction:column;gap:4px;font-size:13px}.pagos-field span{color:var(--muted)}.pagos-form{margin-top:16px;border-top:var(--bd);padding-top:10px}.pagos-form h3{margin-bottom:8px}.pagos-warn{border:1px solid color-mix(in srgb,var(--warn-ink) 55%,transparent);background:color-mix(in srgb,var(--warn-ink) 9%,transparent);border-radius:var(--r-s);padding:8px 12px;margin:10px 0}.pagos-seed{border:1px dashed color-mix(in srgb,var(--chart-2) 55%,transparent);border-radius:var(--r-s);padding:10px 12px;margin:8px 0 12px}.pagos-actions{display:flex;gap:8px;flex-wrap:wrap}.pagos-lines th:nth-child(2),.pagos-lines td:nth-child(2){min-width:210px}.pagos-lines th:nth-child(3),.pagos-lines td:nth-child(3){white-space:nowrap}.pagos-lines th:nth-child(6),.pagos-lines td:nth-child(6){min-width:108px}.sat-meta{display:flex;gap:4px 14px;flex-wrap:wrap}.sat-progress{margin-top:10px;border-top:1px dashed var(--line);padding-top:8px}.sat-progress-head{margin:0 0 6px}.sat-progress-note{font-size:13px;margin:6px 0 0}.sat-steps{list-style:none;margin:0;padding:0;font-size:13px}.sat-steps li{display:flex;gap:8px;padding:2px 0;align-items:baseline}.sat-step-time{opacity:.6;white-space:nowrap}.sat-run{border-radius:8px;padding:6px 10px;margin:6px 0}.sat-run summary{cursor:pointer;font-size:13px;font-weight:600}.swatches{display:flex;gap:8px;flex-wrap:wrap}.swatch{padding:7px 10px}.swatch[aria-pressed="true"]{border-color:var(--green);background:var(--tint);color:var(--accent-ink)}.swatch-dot{width:15px;height:15px;border-radius:50%;display:inline-block}.logo-preview{width:52px;height:52px;object-fit:contain;border:var(--bd);border-radius:10px}/* Acentos (formato de verify.cjs). */:root[data-accent="azul"]{--green:#175c9e;--green-hover:#114a80;--on-accent:#ffffff;--tint:#e3edf8;--accent-ink:#175c9e;--nav-active-bg:#123c63;--nav-active-ink:#cfe2f5}:root[data-theme="dark"][data-accent="azul"]{--green:#6ea8dc;--green-hover:#8dbde8;--on-accent:#0a1c30;--tint:#17334f;--accent-ink:#6ea8dc;--nav-active-bg:#17334f;--nav-active-ink:#6ea8dc}:root[data-accent="teal"]{--green:#0f766e;--green-hover:#0b5a54;--on-accent:#ffffff;--tint:#dcf2ef;--accent-ink:#0f766e;--nav-active-bg:#0a3f3a;--nav-active-ink:#c4efe9}:root[data-theme="dark"][data-accent="teal"]{--green:#2dd4bf;--green-hover:#5eead4;--on-accent:#052e2a;--tint:#0f3532;--accent-ink:#2dd4bf;--nav-active-bg:#0f3532;--nav-active-ink:#2dd4bf}:root[data-accent="violeta"]{--green:#6d28d9;--green-hover:#571db0;--on-accent:#ffffff;--tint:#ece4fa;--accent-ink:#6d28d9;--nav-active-bg:#3d1478;--nav-active-ink:#ddd0fb}:root[data-theme="dark"][data-accent="violeta"]{--green:#a78bfa;--green-hover:#bfa8fc;--on-accent:#1d0b38;--tint:#2a1b4d;--accent-ink:#a78bfa;--nav-active-bg:#2a1b4d;--nav-active-ink:#a78bfa}:root[data-accent="burdeos"]{--green:#9f2436;--green-hover:#7f1b2b;--on-accent:#ffffff;--tint:#f9e3e6;--accent-ink:#9f2436;--nav-active-bg:#57101d;--nav-active-ink:#f6ccd2}:root[data-theme="dark"][data-accent="burdeos"]{--green:#f08a94;--green-hover:#f5a7ae;--on-accent:#330a10;--tint:#472028;--accent-ink:#f08a94;--nav-active-bg:#472028;--nav-active-ink:#f08a94}:root[data-accent="ambar"]{--green:#9a5b00;--green-hover:#7c4900;--on-accent:#ffffff;--tint:#f7ecd4;--accent-ink:#9a5b00;--nav-active-bg:#54350a;--nav-active-ink:#f3dfae}:root[data-theme="dark"][data-accent="ambar"]{--green:#f5b04c;--green-hover:#ffc46b;--on-accent:#2e1c02;--tint:#453310;--accent-ink:#f5b04c;--nav-active-bg:#453310;--nav-active-ink:#f5b04c}:root[data-accent="rosa"]{--green:#b01854;--green-hover:#8f1244;--on-accent:#ffffff;--tint:#f9e0ea;--accent-ink:#b01854;--nav-active-bg:#5c0d2f;--nav-active-ink:#f6c9da}:root[data-theme="dark"][data-accent="rosa"]{--green:#f78fb8;--green-hover:#faa9ca;--on-accent:#360a1c;--tint:#472031;--accent-ink:#f78fb8;--nav-active-bg:#472031;--nav-active-ink:#f78fb8}:root[data-accent="grafito"]{--green:#3f5468;--green-hover:#31424f;--on-accent:#ffffff;--tint:#e5ebf0;--accent-ink:#3f5468;--nav-active-bg:#22303f;--nav-active-ink:#d3dee8}:root[data-theme="dark"][data-accent="grafito"]{--green:#9db1c8;--green-hover:#b3c4d8;--on-accent:#101b26;--tint:#22303f;--accent-ink:#9db1c8;--nav-active-bg:#22303f;--nav-active-ink:#9db1c8}@media(max-width:1080px){.dashboard-grid{grid-template-columns:1fr}}@media(max-width:900px){.top-search input{min-width:120px;width:38vw}}@media(max-width:860px){.sidebar{display:none}.frame{grid-template-columns:1fr}.bottombar{display:grid;grid-template-columns:repeat(5,1fr);gap:4px;position:fixed;left:0;right:0;bottom:0;z-index:40;background:var(--surface);border-top:var(--bd);padding:6px 8px calc(6px + env(safe-area-inset-bottom))}.bottombar button{flex-direction:column;gap:2px;font-size:11px;padding:6px 2px;border-color:transparent;background:transparent}.bottombar button[aria-current]{background:var(--tint);color:var(--accent-ink)}.page{padding-bottom:84px}.total-hero strong{font-size:28px}.frame.sheet-open .sidebar{display:flex;position:fixed;inset:0 auto 0 0;width:min(300px,86vw);z-index:50;overflow-y:auto}.frame.sheet-open .sidebar nav{display:grid}.card-table .table-scroll,.card-table.table-scroll{overflow:visible}.card-table .grid-table{display:block}.card-table .grid-table thead{display:none}.card-table .grid-table tbody,.card-table .grid-table tr{display:block}.card-table .grid-table tr{border:var(--bd);border-radius:var(--r-l);padding:8px 12px;margin-bottom:12px}.card-table .grid-table td{display:flex;justify-content:space-between;gap:12px;border-top:0;padding:6px 0}.card-table .grid-table td::before{content:attr(data-label);color:var(--muted);font-weight:600}}@media(max-width:780px){.frame{grid-template-columns:1fr}.sidebar{padding:14px;gap:12px}.switcher{grid-template-columns:minmax(0,1fr) auto}.switcher label{grid-column:1/-1}.sidebar nav{display:flex;flex-wrap:wrap}.local{display:none}.top,.page{padding:14px}.nav-caption{width:100%;padding:3px 5px}.metric{min-height:0}.dashboard-hero{padding:18px}.heading .actions{width:100%}.header-counters{display:none}}@media(max-width:460px){.invoice-parties{grid-template-columns:1fr}.heading .primary{width:100%}.filters input,.filters select{flex:1 1 140px}.monitor-actions{padding:10px}}@media print{.frame{display:none!important}#print-report{display:block!important;color:#000;background:#fff}#print-report table{width:100%;border-collapse:collapse}#print-report th,#print-report td{border:1px solid #bbb;padding:6px 8px;font-size:12px}}@media (prefers-reduced-motion:reduce){*,*::before,*::after{transition:none!important;animation:none!important}}.timeline{display:grid}
.ciec-captcha{border:var(--bd);border-radius:12px;padding:12px;margin-top:10px;background:var(--surface-2)}.ciec-captcha-img{display:block;max-width:100%;height:auto;border:var(--bd);border-radius:8px;background:#fff;margin:8px 0}
/* Problemas claros, corridas visuales, Centro de mando y salud (1.13.0) */.problem-card{border:var(--bd);border-left:5px solid var(--info-ink);border-radius:12px;padding:12px 14px;margin:10px 0;background:var(--surface-2);display:grid;gap:6px}.problem-card[data-level="rojo"]{border-left-color:var(--danger);background:var(--danger-bg)}.problem-card[data-level="ambar"]{border-left-color:var(--warn-ink);background:var(--warn-bg)}.problem-head{display:flex;gap:9px;align-items:center;flex-wrap:wrap}.problem-head strong{font-size:15px}.problem-means{color:var(--ink)}.problem-now{color:var(--ink)}.problem-detail summary{cursor:pointer;font-size:13px;color:var(--muted);font-weight:600}.problem-detail p{font-size:13px;margin-top:5px;overflow-wrap:anywhere}.problem-rows{display:grid;gap:7px;padding:2px 16px 16px}.problem-row{display:flex;gap:9px;align-items:baseline;flex-wrap:wrap;font-size:14px}.problem-dot{width:11px;height:11px;border-radius:50%;background:var(--info-ink);flex:none;align-self:center}.problem-row[data-level="rojo"] .problem-dot{background:var(--danger)}.problem-row[data-level="ambar"] .problem-dot{background:var(--warn-ink)}.problem-row-now{color:var(--muted)}.run-phases{list-style:none;margin:8px 0;padding:0;display:grid;gap:4px}.run-phase{display:flex;gap:9px;align-items:center;font-size:14px;color:var(--muted)}.run-phase-mark{width:22px;height:22px;border-radius:50%;display:grid;place-items:center;font-weight:700;font-size:13px;background:var(--surface);border:var(--bd);flex:none}.run-phase[data-state="done"]{color:var(--ink)}.run-phase[data-state="done"] .run-phase-mark{background:var(--ok-bg);color:var(--ok-ink);border-color:transparent}.run-phase[data-state="current"]{color:var(--ink);font-weight:650}.run-phase[data-state="current"] .run-phase-mark{background:var(--warn-bg);color:var(--warn-ink);border-color:transparent}.run-phase[data-state="failed"]{color:var(--danger);font-weight:650}.run-phase[data-state="failed"] .run-phase-mark{background:var(--danger-bg);color:var(--danger);border-color:transparent}.cmd-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(255px,1fr));gap:12px;padding:14px 16px 16px}.cmd-grid>div{display:grid}.cmd-grid>div:empty{display:none}.cmd-card{border:var(--bd);border-radius:var(--r-l);background:var(--surface-2);padding:12px;display:grid;gap:9px;align-content:start;min-width:0}.cmd-main{display:flex;gap:11px;align-items:flex-start;background:none;border:none;padding:0;text-align:left;cursor:pointer;width:100%;font:inherit;color:inherit}.cmd-main:hover{background:none}.cmd-dot{width:15px;height:15px;border-radius:50%;background:var(--green);flex:none;margin-top:4px}.cmd-card[data-level="rojo"] .cmd-dot{background:var(--danger)}.cmd-card[data-level="ambar"] .cmd-dot{background:var(--warn-ink)}.cmd-card[data-level="gris"] .cmd-dot{background:var(--info-ink)}.cmd-texts{display:grid;gap:2px;min-width:0}.cmd-title{font-size:15px}.cmd-big{font-size:14px;font-weight:650;color:var(--ink);overflow-wrap:anywhere}.cmd-last{color:var(--muted);font-size:13px;overflow-wrap:anywhere}.cmd-actions{display:flex;gap:8px;flex-wrap:wrap}.health-ok-row{display:flex;gap:8px;flex-wrap:wrap;padding:0 16px 14px}.health-chip{display:grid;gap:1px;background:var(--surface-2);border-radius:10px;padding:7px 10px;font-size:13px}.health-chip small{color:var(--muted)}.health-ok-line{padding:2px 16px;color:var(--muted);font-size:14px}

/* Acciones directas de SAT y significado en Listas (1.13.1) */.sat-quick-bar{display:flex;gap:10px;align-items:center;padding:12px 16px 2px;flex-wrap:wrap}.sat-quick-label{font-weight:700;font-size:13px;color:var(--muted)}.sat-quick-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(225px,1fr));gap:12px;padding:12px 16px 16px}.sat-quick-btn{flex-direction:column;align-items:flex-start;justify-content:flex-start;gap:7px;padding:15px 16px;min-height:102px;border-radius:var(--r-l);background:var(--surface-2);text-align:left}.sat-quick-btn strong{font-size:19px}.sat-quick-head{display:flex;gap:9px;align-items:center}.sat-quick-line{color:var(--muted);font-size:13px;overflow-wrap:anywhere}.cp-significado{margin-top:4px}.cp-significado>summary{cursor:pointer;font-weight:650;font-size:14px;color:var(--green)}

/* Impresión del comprobante (1.13.1): solo la representación, en retrato */@media print{@page{size:A4 portrait;margin:13mm 13mm 17mm;@bottom-left{content:"PacoSAT · Expediente fiscal";font-size:9px;color:#555}@bottom-right{content:"Página " counter(page) " de " counter(pages);font-size:9px;color:#555}}dialog{display:none!important}#print-report{font-size:12px;line-height:1.42}#print-report h1{font-size:19px}#print-report .print-parties{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin:10px 0}#print-report .print-party{border:1px solid #bbb;padding:8px 10px;display:grid;gap:2px}#print-report .print-party small{color:#444;font-weight:700;letter-spacing:.08em}#print-report .print-seals{font-size:9.5px;word-break:break-all;color:#222;margin-top:10px}#print-report .print-estado{border-top:2px solid #000;margin-top:14px;padding-top:8px;font-size:11.5px}}

/* Acciones largas (1.13.1, piezas E/F): la tarjeta de progreso vive
   junto al botón que la lanzó, con fase, barra medible y resultado
   persistente; y la hoja de descarga (C2) con su resumen previo. */
.run-status{margin-top:10px;display:grid;gap:6px;justify-items:start}
.run-status:empty{margin-top:0}
.run-phase{font-weight:600;margin:0}
.run-final{margin:0;font-weight:600}
.run-bar{width:100%;max-width:340px;height:8px;border-radius:99px;background:color-mix(in srgb,var(--ink) 14%,transparent);overflow:hidden}
.run-bar i{display:block;height:100%;background:var(--accent);border-radius:99px;transition:width .4s ease}
.dl-summary{font-weight:700;border:1px dashed color-mix(in srgb,var(--ink) 35%,transparent);border-radius:10px;padding:10px 12px}
.dl-status{display:grid;gap:6px}
.dl-status p{margin:0}

/* Mapa anual de declaraciones (1.17.0) */
.decl-mapa-resumen{display:flex;gap:6px 16px;flex-wrap:wrap;align-items:baseline;margin:10px 0 2px}
.decl-mapa-resumen strong{font-size:15px}
.decl-mapa-cuenta{font-weight:700;font-size:13px}
.decl-mapa-cuenta.warn{color:var(--warn-ink)}
.decl-mapa-cuenta.bad{color:var(--danger)}
.decl-alerta{border:1px solid var(--danger);background:var(--danger-bg);border-radius:10px;padding:9px 12px;margin:8px 0;font-weight:600}
button.decl-cell{font:inherit;color:inherit;text-align:left;cursor:pointer;border:1px solid var(--line);width:100%;min-height:48px}
.decl-mapa-presentada{background:var(--tint)}
.decl-mapa-pendiente{background:var(--warn-bg)}
.scope-top{max-width:220px;padding:4px 8px;border-radius:var(--r-s);border:1px solid var(--line);background:var(--surface);color:inherit;font:inherit;font-size:.85em}
.decl-progreso{display:flex;gap:10px;align-items:center;flex-wrap:wrap;margin:8px 0}
.sat-arranque{margin:8px 0;padding:8px 10px;border:1px dashed var(--line);border-radius:var(--r-s)}
.sat-arranque ul{margin:6px 0 0;padding-left:18px}
.decl-mapa-sin-recuperar{background:var(--danger-bg);border-color:var(--danger)}
.decl-mapa-pagada-sin-acuse{background:var(--warn-bg);border-color:var(--warn)}
.decl-mapa-no-toca{opacity:.6}
.decl-cell.decl-sel{outline:2px solid var(--green);outline-offset:1px;opacity:1}
.decl-grid>.decl-anual{grid-column:1/-1}
.decl-detalle{border:var(--bd);border-radius:12px;padding:12px 14px;margin:4px 0 12px;display:grid;gap:8px;background:var(--surface-2)}
.decl-detalle h4{margin:0;font-size:15px}
.decl-detalle p{margin:0}
/* Ronda Facilidad (1.18.0): botón «Deshacer» en la barra de estado
   y filtros de Facturas como panel plegable en móvil (en escritorio
   el botón no existe y los filtros van en su fila de siempre). */
.status-undo{padding:3px 10px;font-size:12px;margin-left:8px}
.filters-toggle,.filters-apply{display:none}
@media(max-width:860px){.filters-toggle{display:inline-flex;margin:0 12px 10px}.invoice-filters{display:none}.invoice-filters.open{display:grid;gap:8px}.filters-apply{display:inline-flex}}
.bottombar button{min-height:52px}.nav button{min-height:44px}.news-badge{font-weight:700}.cp-row .pill{flex:none}.cp-row>span,.cp-row>strong{min-width:0;overflow-wrap:anywhere}
@media(max-width:860px){.top{flex-wrap:wrap}.top-side{flex-wrap:wrap;min-width:0;max-width:100%}.scope-top{min-width:0;max-width:46vw}.top-search{flex:1;min-width:120px}.top-search input{width:100%}.frame{grid-template-columns:minmax(0,1fr)}main{min-width:0}.cp-row{flex-wrap:wrap}.cp-row button{min-height:44px}}
/* Clases que el código ya usaba y no existían (auditoría visual
   1.25.0): «soft» es el botón secundario de toda la app;
   «clickable», la fila que abre algo (cursor y realce al pasar);
   «inline-form», el formulario en una línea con sus controles. */
.soft{background:var(--surface-2)}
.clickable{cursor:pointer}
.clickable:hover{background:var(--surface-2)}
.inline-form{display:flex;gap:8px;align-items:center;flex-wrap:wrap}

/* Avisos flotantes, entrada diseñada y gráficas de Dinero
   (1.26.0, Ronda Visual): las confirmaciones viven junto al
   dedo y no solo en la barra lejana; la cara del login propio;
   la antigüedad y los saldos por mes, en barras; el pie de los
   documentos impresos. */
.toasts{position:fixed;right:16px;bottom:16px;z-index:90;display:grid;gap:8px;max-width:min(400px,calc(100vw - 24px))}
.toast-card{display:flex;align-items:flex-start;gap:10px;background:var(--surface);border:var(--bd);border-left:4px solid var(--green);border-radius:var(--r-m);box-shadow:var(--shadow-2);padding:12px 14px;animation:toast-in .18s ease}
.toast-card[data-kind=error]{border-left-color:var(--danger)}
.toast-card p{flex:1;min-width:0;margin:0;font-size:14px;overflow-wrap:anywhere}
.toast-card .toast-close{flex:none;padding:4px}
@keyframes toast-in{from{opacity:0;transform:translateY(8px)}}
@media (max-width:860px){.toasts{left:12px;right:12px;bottom:64px;max-width:none}}
dialog{animation:dialog-in .16s ease}
@keyframes dialog-in{from{opacity:0;transform:translateY(6px)}}
tbody tr{transition:background-color .12s ease}
tbody tr:hover{background:var(--surface-2)}
.entry{position:fixed;inset:0;z-index:120;display:grid;place-items:center;padding:18px;background:light-dark(#eef3f6,#060d18);overflow:auto}
.entry[hidden]{display:none}
.entry-card{width:min(400px,100%);background:var(--surface);border:var(--bd);border-radius:var(--r-l);box-shadow:var(--shadow-1);padding:30px 28px;display:grid;gap:12px;text-align:center}
.entry-logo{width:56px;height:56px;justify-self:center}
.entry-title{margin:0;font-size:30px}
.entry-sub{margin:0;color:var(--muted)}
.entry-form{display:grid;gap:10px;text-align:left}
.entry-form label{font-weight:650;font-size:14px}
.entry-form input{padding:12px;font-size:15px}
.entry-form .primary{justify-content:center;padding:12px}
.entry-skip{justify-self:center}
.entry-note{margin:0;color:var(--muted);font-size:13px}
.age-chart{display:grid;gap:5px;padding:2px 16px 14px}
.age-label{font-weight:700;font-size:13px;margin-top:6px}
.age-line{display:grid;grid-template-columns:74px 1fr auto;gap:10px;align-items:center;font-size:13px}
.age-kind{color:var(--muted)}
.age-track{height:10px;border-radius:var(--r-pill);background:var(--surface-2);overflow:hidden}
.age-fill{height:100%;border-radius:var(--r-pill)}
.age-fill.cobrar{background:var(--green)}
.age-fill.pagar{background:var(--chart-2)}
.age-num{font-variant-numeric:tabular-nums}
.bar-cobrar{fill:var(--green)}
.bar-pagar{fill:var(--chart-2)}
.sw-cobrar{background:var(--green)}
.sw-pagar{background:var(--chart-2)}
.report-foot{display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap;margin-top:14px;padding-top:8px;border-top:1px solid #999;font-size:10px;color:#333}
