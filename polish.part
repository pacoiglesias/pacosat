.nav-caption{display:block;color:var(--nav-muted);font-size:10px;font-weight:750;letter-spacing:.13em;padding:3px 10px 4px}.nav-divider{margin-top:13px}.sidebar{gap:24px}.dashboard-hero{position:relative;overflow:hidden;min-height:134px;isolation:isolate}.dashboard-hero::after{content:"";z-index:-1;position:absolute;width:285px;height:285px;right:-20px;top:-120px;border-radius:50%;border:1px solid #98c9ce50;box-shadow:0 0 0 25px #a5cbdd16,0 0 0 51px #a5cbdd15,0 0 0 80px #a5cbdd0b}.metric{grid-template-columns:1fr auto;align-items:center;min-height:105px}.metric-label{grid-column:1/-1}.metric-link{background:var(--chip-bg);border:1px solid var(--border);color:var(--chip-ink);padding:6px 8px;font-size:12px}.metric-link svg{width:14px;height:14px}.period-chip{display:inline-block;max-width:100%;padding:5px 8px;border:1px solid var(--border);border-radius:7px;background:var(--chip-bg);color:var(--chip-ink);font-size:12px;font-weight:700}.activity-bars{display:grid;grid-template-columns:repeat(7,minmax(0,1fr));gap:12px;padding:4px 17px 17px}.activity-day{display:grid;gap:5px;min-width:0;color:var(--muted);font-size:12px;font-variant-numeric:tabular-nums}.activity-day strong{color:var(--ink);font-size:14px}.activity-day meter{width:100%;height:12px}.activity-day meter::-webkit-meter-bar{background:var(--surface-2);border:none;border-radius:8px}.activity-day meter::-webkit-meter-optimum-value{background:linear-gradient(90deg,#237570,#478e9e);border-radius:8px}.invoice-dialog{width:min(690px,calc(100% - 24px));max-height:94vh}.invoice-summary{display:grid;gap:13px;background:var(--surface-2);border:1px solid var(--border);padding:15px;border-radius:12px;overflow-wrap:anywhere}.invoice-summary h3{font-size:27px;letter-spacing:-.04em;margin-top:5px}.invoice-parties{display:grid;grid-template-columns:1fr 1fr;gap:8px}.invoice-parties>div{display:grid;gap:3px;padding:10px;background:var(--surface);border:1px solid var(--border);border-radius:9px;min-width:0}.invoice-parties small{font-size:10px;color:var(--muted);letter-spacing:.1em;font-weight:700}.invoice-parties span,.invoice-summary small{color:var(--muted)}.invoice-concepts{padding:11px 13px;border:1px solid var(--border);border-radius:9px}.invoice-concepts ul{padding-left:21px;margin:6px 0 0}.invoice-concepts li{overflow-wrap:anywhere}.table-wrap td:last-child .actions{gap:5px}@media(max-width:780px){.nav-caption{width:100%;padding:3px 5px}.nav-divider{margin-top:5px}.metric{min-height:0}.dashboard-hero{min-height:0}.activity-bars{gap:6px}}@media(max-width:390px){.invoice-parties{grid-template-columns:1fr}.activity-bars{padding-inline:9px;gap:4px}.activity-day{font-size:10px}}
.fiscal-state{display:grid;gap:2px;justify-items:start}.fiscal-badge{display:inline-block;padding:3px 8px;border-radius:100px;color:var(--info-ink);background:var(--info-bg);font-size:12px;font-weight:700;white-space:nowrap}.fiscal-badge[data-state=Vigente]{color:var(--ok-ink);background:var(--ok-bg)}.fiscal-badge[data-state=Cancelado]{color:var(--danger);background:var(--danger-bg)}.fiscal-badge[data-state="No encontrado"]{color:var(--warn-ink);background:var(--warn-bg)}.fiscal-badge[data-state="Formato rechazado"]{color:var(--warn-ink);background:var(--warn-bg)}.fiscal-badge[data-state="69-B"]{color:#fff;background:var(--danger)}.fiscal-badge[data-state=Error]{color:var(--danger);background:var(--danger-bg)}.fiscal-badge[data-state="Sin consulta"]{color:var(--warn-ink);background:var(--warn-bg)}.fiscal-state small{font-size:11px}
/* Vigilancia SAT rediseñada: acciones grandes, tarjetas con semáforo
   y la línea de verdad de la revisión automática. */
.monitor-actions{display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:12px;padding:15px}
.monitor-action{display:grid;gap:10px;align-content:start;background:var(--surface-2);border:1px solid var(--border);border-radius:12px;padding:15px 17px;min-width:0}
.monitor-action h3{font-size:16px}
.monitor-action p{font-size:13.5px}
.monitor-dates{display:flex;gap:10px;flex-wrap:wrap}
.monitor-dates label{display:grid;gap:5px;font-weight:600;font-size:13px;color:var(--muted)}
button.monitor-big{width:100%;padding:13px 15px;font-size:15.5px;justify-content:center}
.monitor-link{font-size:13px}
.monitor-truth{display:grid;gap:3px;padding:0 17px 15px;color:var(--muted);font-size:13.5px}
.monitor-truth p{margin:0}
.kpi.ok strong{color:var(--ok-ink)}
.kpi.bad strong{color:var(--danger)}
.kpi.warn strong{color:var(--warn-ink)}
@media(max-width:460px){.monitor-actions{padding:10px}.monitor-dates label{flex:1 1 130px}}
body{-webkit-font-smoothing:antialiased;text-rendering:optimizeLegibility}button{transition:background .15s ease,border-color .15s ease,box-shadow .15s ease}.metric{transition:box-shadow .18s ease,transform .18s ease}.metric:hover{box-shadow:0 8px 22px #27426414;transform:translateY(-1px)}.top-side{display:inline-flex;align-items:center;gap:12px;min-width:0}.header-counters{color:var(--muted);font-size:12.5px;font-weight:600;font-variant-numeric:tabular-nums;white-space:nowrap}.activity-list{display:grid;padding:6px 15px 10px}.activity-item{display:flex;gap:11px;align-items:flex-start;padding:10px 0;border-top:1px solid var(--border)}.activity-item:first-child{border-top:none}.activity-kind{flex:none;margin-top:1px;padding:3px 8px;border-radius:100px;font-size:11px;font-weight:750;letter-spacing:.02em;background:var(--info-bg);color:var(--info-ink)}.activity-kind[data-kind=sat]{background:var(--tint);color:var(--ok-ink)}.activity-kind[data-kind=import]{background:var(--chip-bg);color:var(--chip-ink)}.activity-kind[data-kind=alert]{background:var(--danger-bg);color:var(--danger)}.activity-body{display:grid;gap:2px;min-width:0}.activity-body strong{font-size:13.5px;overflow-wrap:anywhere}.activity-body small{color:var(--muted);font-size:12px}.activity-body .metric-link{justify-self:start;margin-top:3px}.table-wrap::-webkit-scrollbar,.xml-view::-webkit-scrollbar{height:10px;width:10px}.table-wrap::-webkit-scrollbar-thumb,.xml-view::-webkit-scrollbar-thumb{background:var(--scroll);border-radius:8px}::selection{background:var(--selection)}@media(max-width:780px){.header-counters{display:none}}@media print{.sidebar,.top,.heading .actions,.hero-actions{display:none!important}.frame{display:block}.page{padding:0;max-width:none}}@media (prefers-reduced-motion: reduce){*,*::before,*::after{transition:none!important;animation:none!important}}
.news-badge{margin-left:2px;padding:1px 7px;border-radius:100px;background:#d9534f;color:#fff;font-size:11px;font-weight:750;font-variant-numeric:tabular-nums}.news-note{margin:10px 17px 0;padding:7px 10px;border:1px solid var(--warn-ink);border-radius:8px;background:var(--warn-bg);color:var(--warn-ink);font-size:12.5px;font-weight:700}
.rfc-note{font-size:12.5px;font-weight:600;color:var(--muted)}
.rfc-note[data-state=ok]{color:var(--ok-ink)}
.rfc-note[data-state=warn]{color:var(--warn-ink);background:var(--warn-bg);border:1px solid var(--warn-ink);border-radius:8px;padding:7px 10px}
.rfc-note[data-state=error]{color:var(--danger);background:var(--danger-bg);border:1px solid var(--danger);border-radius:8px;padding:7px 10px}
.kpi,.panel,.metric{transition:box-shadow .18s ease,transform .18s ease}.kpi:hover{box-shadow:0 8px 22px #27426414;transform:translateY(-1px)}.view-in{animation:view-in .22s ease}@keyframes view-in{from{opacity:0;transform:translateY(4px)}to{opacity:1;transform:none}}

/* Cobertura (1.6.4): mapa de calor anual de días cubiertos por RFC. */
.hm-scroll{overflow-x:auto;padding:2px 17px 6px}
.hm{display:block;height:auto}
.hm rect.hm-l0{fill:var(--surface-2);stroke:var(--border);stroke-width:.6}
.hm rect.hm-l1{fill:var(--chart-received);opacity:.5}
.hm rect.hm-l2{fill:var(--chart-received)}
.hm text{fill:var(--muted);font-size:9px;font-weight:600}
.chart-legend .sw-hm0{background:var(--surface-2);border:1px solid var(--border)}
.chart-legend .sw-hm1{background:var(--chart-received);opacity:.5}
.chart-legend .sw-hm2{background:var(--chart-received)}

/* Pulido 1.6.5: anillo de estados, esqueletos de carga, línea de tiempo
   del CFDI y buscador global. Todo con tokens del sistema de diseño; la
   regla global de reduced-motion ya anula la animación del esqueleto. */
.donut{display:block;margin:0 auto;max-width:190px;height:auto}
.donut-track{fill:none;stroke:var(--surface-2);stroke-width:13}
.donut-seg{fill:none;stroke-width:13}
.donut-vigente{stroke:var(--green)}
.donut-cancelado{stroke:var(--danger)}
.donut-efos{stroke:var(--warn-ink)}
.donut-sin{stroke:var(--border)}
.donut-total{fill:var(--ink);font-size:26px;font-weight:800;text-anchor:middle}
.donut-caption{fill:var(--muted);font-size:10px;font-weight:700;text-anchor:middle}
.chart-legend .sw-donut-vigente{background:var(--green)}
.chart-legend .sw-donut-cancelado{background:var(--danger)}
.chart-legend .sw-donut-efos{background:var(--warn-ink)}
.chart-legend .sw-donut-sin{background:var(--border)}
.skel{display:grid;gap:12px}
.skel-block{min-height:86px;border:1px solid var(--border);border-radius:12px;background:linear-gradient(100deg,var(--surface-2) 40%,var(--surface) 50%,var(--surface-2) 60%);background-size:200% 100%;animation:skel-pulse 1.2s ease-in-out infinite}
@keyframes skel-pulse{from{background-position:180% 0}to{background-position:-20% 0}}
.timeline{display:grid}
.timeline-item{display:grid;gap:1px;padding:7px 0 7px 13px;border-left:2px solid var(--border)}
.timeline-item strong{font-size:13.5px}
.timeline-item small{color:var(--muted)}
.timeline-empty{color:var(--muted);margin:4px 0}
.top-search input{background:var(--nav-field);border:1px solid var(--nav-border);color:var(--nav-text);border-radius:8px;padding:6px 10px;min-width:200px;font:inherit;font-size:13px}
.top-search input::placeholder{color:var(--nav-muted)}
@media(max-width:900px){.top-search input{min-width:120px;width:38vw}}

/* Personalización 1.6.6: paleta de acentos como tokens del sistema
   de diseño. Cada valor cumple contraste AA (texto sobre superficie,
   texto sobre el acento y tinte) en claro y en oscuro; verify.cjs lo
   comprueba recomputando los ratios desde esta misma hoja. */
:root[data-accent="azul"]{--green:#175c9e;--green-hover:#114a80;--on-accent:#ffffff;--tint:#e3edf8;--ok-bg:#e3edf8;--ok-ink:#175c9e;--focus:#175c9e;--nav-active-bg:#123c63;--nav-active-ink:#cfe2f5}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"])[data-accent="azul"]{--green:#6ea8dc;--green-hover:#8dbde8;--on-accent:#0a1c30;--tint:#17334f;--ok-bg:#17334f;--ok-ink:#6ea8dc;--focus:#6ea8dc;--nav-active-bg:#17334f;--nav-active-ink:#6ea8dc}}
:root[data-theme="dark"][data-accent="azul"]{--green:#6ea8dc;--green-hover:#8dbde8;--on-accent:#0a1c30;--tint:#17334f;--ok-bg:#17334f;--ok-ink:#6ea8dc;--focus:#6ea8dc;--nav-active-bg:#17334f;--nav-active-ink:#6ea8dc}
:root[data-accent="teal"]{--green:#0f766e;--green-hover:#0b5a54;--on-accent:#ffffff;--tint:#dcf2ef;--ok-bg:#dcf2ef;--ok-ink:#0f766e;--focus:#0f766e;--nav-active-bg:#0a3f3a;--nav-active-ink:#c4efe9}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"])[data-accent="teal"]{--green:#2dd4bf;--green-hover:#5eead4;--on-accent:#052e2a;--tint:#0f3532;--ok-bg:#0f3532;--ok-ink:#2dd4bf;--focus:#2dd4bf;--nav-active-bg:#0f3532;--nav-active-ink:#2dd4bf}}
:root[data-theme="dark"][data-accent="teal"]{--green:#2dd4bf;--green-hover:#5eead4;--on-accent:#052e2a;--tint:#0f3532;--ok-bg:#0f3532;--ok-ink:#2dd4bf;--focus:#2dd4bf;--nav-active-bg:#0f3532;--nav-active-ink:#2dd4bf}
:root[data-accent="violeta"]{--green:#6d28d9;--green-hover:#571db0;--on-accent:#ffffff;--tint:#ece4fa;--ok-bg:#ece4fa;--ok-ink:#6d28d9;--focus:#6d28d9;--nav-active-bg:#3d1478;--nav-active-ink:#ddd0fb}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"])[data-accent="violeta"]{--green:#a78bfa;--green-hover:#bfa8fc;--on-accent:#1d0b38;--tint:#2a1b4d;--ok-bg:#2a1b4d;--ok-ink:#a78bfa;--focus:#a78bfa;--nav-active-bg:#2a1b4d;--nav-active-ink:#a78bfa}}
:root[data-theme="dark"][data-accent="violeta"]{--green:#a78bfa;--green-hover:#bfa8fc;--on-accent:#1d0b38;--tint:#2a1b4d;--ok-bg:#2a1b4d;--ok-ink:#a78bfa;--focus:#a78bfa;--nav-active-bg:#2a1b4d;--nav-active-ink:#a78bfa}
:root[data-accent="burdeos"]{--green:#9f2436;--green-hover:#7f1b2b;--on-accent:#ffffff;--tint:#f9e3e6;--ok-bg:#f9e3e6;--ok-ink:#9f2436;--focus:#9f2436;--nav-active-bg:#57101d;--nav-active-ink:#f6ccd2}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"])[data-accent="burdeos"]{--green:#f08a94;--green-hover:#f5a7ae;--on-accent:#330a10;--tint:#472028;--ok-bg:#472028;--ok-ink:#f08a94;--focus:#f08a94;--nav-active-bg:#472028;--nav-active-ink:#f08a94}}
:root[data-theme="dark"][data-accent="burdeos"]{--green:#f08a94;--green-hover:#f5a7ae;--on-accent:#330a10;--tint:#472028;--ok-bg:#472028;--ok-ink:#f08a94;--focus:#f08a94;--nav-active-bg:#472028;--nav-active-ink:#f08a94}
:root[data-accent="ambar"]{--green:#9a5b00;--green-hover:#7c4900;--on-accent:#ffffff;--tint:#f7ecd4;--ok-bg:#f7ecd4;--ok-ink:#9a5b00;--focus:#9a5b00;--nav-active-bg:#54350a;--nav-active-ink:#f3dfae}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"])[data-accent="ambar"]{--green:#f5b04c;--green-hover:#ffc46b;--on-accent:#2e1c02;--tint:#453310;--ok-bg:#453310;--ok-ink:#f5b04c;--focus:#f5b04c;--nav-active-bg:#453310;--nav-active-ink:#f5b04c}}
:root[data-theme="dark"][data-accent="ambar"]{--green:#f5b04c;--green-hover:#ffc46b;--on-accent:#2e1c02;--tint:#453310;--ok-bg:#453310;--ok-ink:#f5b04c;--focus:#f5b04c;--nav-active-bg:#453310;--nav-active-ink:#f5b04c}
:root[data-accent="rosa"]{--green:#b01854;--green-hover:#8f1244;--on-accent:#ffffff;--tint:#f9e0ea;--ok-bg:#f9e0ea;--ok-ink:#b01854;--focus:#b01854;--nav-active-bg:#5c0d2f;--nav-active-ink:#f6c9da}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"])[data-accent="rosa"]{--green:#f78fb8;--green-hover:#faa9ca;--on-accent:#360a1c;--tint:#472031;--ok-bg:#472031;--ok-ink:#f78fb8;--focus:#f78fb8;--nav-active-bg:#472031;--nav-active-ink:#f78fb8}}
:root[data-theme="dark"][data-accent="rosa"]{--green:#f78fb8;--green-hover:#faa9ca;--on-accent:#360a1c;--tint:#472031;--ok-bg:#472031;--ok-ink:#f78fb8;--focus:#f78fb8;--nav-active-bg:#472031;--nav-active-ink:#f78fb8}
:root[data-accent="grafito"]{--green:#3f5468;--green-hover:#31424f;--on-accent:#ffffff;--tint:#e5ebf0;--ok-bg:#e5ebf0;--ok-ink:#3f5468;--focus:#3f5468;--nav-active-bg:#22303f;--nav-active-ink:#d3dee8}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"])[data-accent="grafito"]{--green:#9db1c8;--green-hover:#b3c4d8;--on-accent:#101b26;--tint:#22303f;--ok-bg:#22303f;--ok-ink:#9db1c8;--focus:#9db1c8;--nav-active-bg:#22303f;--nav-active-ink:#9db1c8}}
:root[data-theme="dark"][data-accent="grafito"]{--green:#9db1c8;--green-hover:#b3c4d8;--on-accent:#101b26;--tint:#22303f;--ok-bg:#22303f;--ok-ink:#9db1c8;--focus:#9db1c8;--nav-active-bg:#22303f;--nav-active-ink:#9db1c8}
.app-footer{margin-top:26px;padding-top:12px;border-top:1px solid var(--border);color:var(--muted);font-size:12px}
.brand .logo img{width:100%;height:100%;object-fit:contain;border-radius:12px}
.report-logo{max-height:54px;max-width:190px;object-fit:contain;margin-bottom:8px}
.swatches{display:flex;gap:8px;flex-wrap:wrap}
.swatch{display:inline-flex;gap:7px;align-items:center;padding:7px 10px}
.swatch[aria-pressed="true"]{border-color:var(--green);background:var(--tint);color:var(--ok-ink)}
.swatch-dot{width:15px;height:15px;border-radius:50%;display:inline-block;border:1px solid var(--border)}
.logo-preview{width:52px;height:52px;object-fit:contain;border:1px solid var(--border);border-radius:10px;background:var(--surface)}

/* Visor CFDI profesional (1.6.7) y datos «Acerca de» (1.6.6). */
.cfdi-dialog{width:min(940px,calc(100% - 24px))}
.facts{display:grid;grid-template-columns:repeat(auto-fit,minmax(170px,1fr));gap:9px;margin:10px 0}
.facts>div{display:grid;gap:2px;padding:9px 11px;background:var(--surface-2);border:1px solid var(--border);border-radius:9px;min-width:0}
.facts small{color:var(--muted);font-size:10.5px;font-weight:700;letter-spacing:.08em}
.facts strong{font-size:13.5px;overflow-wrap:anywhere}
.seal-details{margin:8px 0;border:1px solid var(--border);border-radius:9px;padding:9px 11px}
.seal-details summary{cursor:pointer;font-weight:650}
.seal-details pre{white-space:pre-wrap;overflow-wrap:anywhere;font-size:11px;max-height:130px;overflow:auto}
.print-seals{font-size:9.5px;overflow-wrap:anywhere}
.print-seals p{margin:3px 0}
.cap-row{display:flex;gap:9px;align-items:flex-start;padding:5px 0}
.cap-row .tag{flex:none;margin-top:1px}

/* ===== 1.6.11 · Semáforos, Hoy, un clic ===== */
:root{--pill-ok-bg:#e2f1e6;--pill-ok-ink:#14532d;--pill-warn-bg:#fdf0d2;--pill-warn-ink:#7a4a00;--pill-bad-bg:#fde3e0;--pill-bad-ink:#8f1d17;--pill-dim-bg:#eceff3;--pill-dim-ink:#4b5563}
@media (prefers-color-scheme:dark){html:not([data-theme="light"]){--pill-ok-bg:#173a26;--pill-ok-ink:#9fd8b0;--pill-warn-bg:#4a380f;--pill-warn-ink:#ffd88a;--pill-bad-bg:#4c1d1a;--pill-bad-ink:#ffb3ab;--pill-dim-bg:#2a2f36;--pill-dim-ink:#c3cad2}}
html[data-theme="dark"]{--pill-ok-bg:#173a26;--pill-ok-ink:#9fd8b0;--pill-warn-bg:#4a380f;--pill-warn-ink:#ffd88a;--pill-bad-bg:#4c1d1a;--pill-bad-ink:#ffb3ab;--pill-dim-bg:#2a2f36;--pill-dim-ink:#c3cad2}
.status-pill{display:inline-flex;align-items:center;gap:7px;border-radius:100px;padding:6px 12px;font-size:13px;font-weight:650;border:1px solid transparent;cursor:pointer}
.status-pill .pill-dot{width:9px;height:9px;border-radius:50%;background:currentColor;flex:none}
.status-pill[data-state="ok"]{background:var(--pill-ok-bg);color:var(--pill-ok-ink)}
.status-pill[data-state="warn"]{background:var(--pill-warn-bg);color:var(--pill-warn-ink)}
.status-pill[data-state="bad"]{background:var(--pill-bad-bg);color:var(--pill-bad-ink)}
.status-pill[data-state="dim"]{background:var(--pill-dim-bg);color:var(--pill-dim-ink)}
.traffic-strip{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:14px}
.today-line{padding:0 15px 6px}
.next-step{margin:6px 15px 15px;padding:13px 15px;border:1px solid var(--border);border-radius:11px;background:var(--guide-bg);display:grid;gap:6px;justify-items:start}
.rest-switch{display:flex;gap:10px;align-items:center;flex-wrap:wrap}
.rest-label{display:grid;gap:1px}
.rest-label small{color:var(--muted);font-size:12px}
.rest-toggle[aria-pressed="true"]{background:var(--pill-warn-bg);color:var(--pill-warn-ink);border-color:transparent}
.filter-chips{display:flex;gap:7px;flex-wrap:wrap;align-items:center;padding:0 15px}
.filter-chips:not(:empty){padding:10px 15px;border-top:1px solid var(--border)}
.filter-chip{border-radius:100px;padding:5px 11px;font-size:12.5px;background:var(--surface-2)}
.pw-eye{padding:5px 8px;margin-top:4px;justify-self:start}
.activity-link{cursor:pointer}
.activity-link:hover{background:var(--surface-2)}
.legend-item{background:none;border:none;padding:2px 4px;font:inherit;color:inherit;cursor:pointer;display:inline-flex;gap:6px;align-items:center}
.hm-detail{padding:0 15px 13px;color:var(--muted)}
.side-version{color:var(--nav-muted);font-size:12px;padding:0 4px}
body.drag-active::after{content:"Suelta los archivos para importar";position:fixed;inset:auto 0 22px 0;margin:0 auto;width:max-content;max-width:92vw;background:var(--green);color:var(--on-accent);padding:11px 18px;border-radius:100px;font-weight:700;z-index:60;box-shadow:0 10px 30px var(--shadow-color)}
td button{padding:7px 10px}
/* Listas negras (1.6.13) */
.cp-row{display:flex;align-items:flex-start;gap:12px;padding:10px 4px;border-bottom:1px solid var(--line)}
.cp-row:last-child{border-bottom:0}
.cp-main{display:flex;flex-direction:column;gap:2px;flex:1;min-width:0}
.cp-hit{font-size:12.5px;font-weight:600}
.cp-hit.sev-bad{color:var(--bad,#b3261e)}
.cp-hit.sev-warn{color:var(--warn,#9a6a00)}
.cp-hit.sev-ok{color:var(--ok,#1e7d32)}
.ok-note{color:var(--ok,#1e7d32);font-weight:600}
/* Constancias y opinión (1.6.14) */
.satdoc-form{display:flex;flex-wrap:wrap;gap:10px;align-items:center;margin-top:10px}
.satdoc-form input[type="number"]{width:64px}
.satdoc-form input[type="text"]{flex:1;min-width:220px}
.switch-line{display:inline-flex;gap:8px;align-items:center;font-weight:600}

/* Libro de criterios, planificador y rescate (ronda anti-5002) */
.plan-note{margin:0 0 8px;color:var(--muted,#666)}
.rescue-folios{margin:8px 0;padding-left:20px;font-size:.92em;word-break:break-all}
.rescue-steps{margin:8px 0;padding-left:20px}
.rescue-steps li{margin-bottom:6px}
.aviso-next{font-weight:600;color:var(--ink)}
.reconcile-candidate{border:1px solid var(--line);border-radius:12px;padding:10px 12px;margin:8px 0;background:var(--panel-2)}
.decl-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(120px,1fr));gap:8px;margin:12px 0}
.decl-cell{border:1px solid var(--line);border-radius:10px;padding:8px 10px;display:grid;gap:2px}
.decl-cell span{font-size:12px;color:var(--muted)}
.decl-recuperada{border-color:var(--ok);background:var(--tint)}
.decl-sin-recuperar{border-color:var(--warn)}
.today-clarity{display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:12px;margin-top:14px}
.today-col{border:1px solid var(--line);border-radius:12px;padding:10px 12px}
.today-col h3{margin:0 0 6px;font-size:14px}
.today-line{display:flex;gap:8px;align-items:baseline;flex-wrap:wrap}
.visor-table td:nth-child(3),.visor-table td:nth-child(4){white-space:nowrap}

/* ===== 1.10.0 · Pagos al banco (añadir al final de polish.part) ===== */
.pagos-table { border-collapse: collapse; width: 100%; margin: 8px 0 4px; font-size: 14px; }
.pagos-table th { text-align: left; padding: 6px 8px; border-bottom: 2px solid var(--line, #d8d8d8); font-weight: 600; }
.pagos-table td { padding: 6px 8px; border-bottom: 1px solid var(--line, #e3e3e3); vertical-align: middle; }
.pagos-cell { cursor: pointer; border-radius: 6px; }
.pagos-cell:hover { background: rgba(37, 99, 235, .08); }
.pagos-num { text-align: right; font-variant-numeric: tabular-nums; white-space: nowrap; }
.pagos-over td { background: rgba(220, 38, 38, .07); }
.pagos-total { font-weight: 700; font-size: 16px; margin: 4px 0 10px; }
.pagos-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(230px, 1fr)); gap: 10px 14px; margin: 8px 0; }
.pagos-field { display: flex; flex-direction: column; gap: 4px; font-size: 13px; }
.pagos-field span { opacity: .8; }
.pagos-form { margin-top: 16px; border-top: 1px solid var(--line, #e3e3e3); padding-top: 10px; }
.pagos-form h3 { margin: 4px 0 8px; }
.pagos-warn { border: 1px solid rgba(217, 119, 6, .5); background: rgba(217, 119, 6, .08); border-radius: 8px; padding: 8px 12px; margin: 10px 0; }
.pagos-seed { border: 1px dashed rgba(37, 99, 235, .5); border-radius: 8px; padding: 10px 12px; margin: 8px 0 12px; }
.pagos-actions { display: flex; gap: 8px; flex-wrap: wrap; margin-top: 10px; }
.pagos-lines th:nth-child(2), .pagos-lines td:nth-child(2) { min-width: 210px; }
.pagos-lines th:nth-child(3), .pagos-lines td:nth-child(3) { white-space: nowrap; }
.pagos-lines th:nth-child(6), .pagos-lines td:nth-child(6) { min-width: 108px; }

/* ===== 1.10.1 · Progreso visible y diario del descargador SAT ===== */
.sat-progress { margin-top: 10px; border-top: 1px dashed var(--line, #d8d8d8); padding-top: 8px; }
.sat-progress-head { margin: 0 0 6px; font-size: 14px; }
.sat-progress-note { font-size: 13px; opacity: .75; margin: 6px 0 0; }
.sat-steps { list-style: none; margin: 0; padding: 0; font-size: 13.5px; }
.sat-steps li { display: flex; gap: 8px; padding: 2.5px 0; align-items: baseline; }
.sat-step-time { font-variant-numeric: tabular-nums; opacity: .65; white-space: nowrap; }
.sat-runs { margin-top: 12px; }
.sat-runs-title { margin: 0 0 6px; font-size: 14.5px; }
.sat-run { border: 1px solid var(--line, #e3e3e3); border-radius: 8px; padding: 6px 10px; margin: 6px 0; }
.sat-run summary { cursor: pointer; font-size: 13.5px; font-weight: 600; }
.sat-run .sat-steps { margin-top: 6px; }
.sat-run-files { display: flex; gap: 8px; flex-wrap: wrap; margin-top: 8px; }
