/* Pantallas */.period-chip{display:inline-block;padding:5px 8px;border-radius:7px;background:var(--info-bg);color:var(--info-ink);font-size:12px}.invoice-dialog{width:min(690px,calc(100% - 24px));max-height:94vh}.cfdi-dialog{width:min(940px,calc(100% - 24px));max-height:94vh}.invoice-summary{display:grid;gap:13px;background:var(--surface-2);border:var(--bd);padding:16px;border-radius:var(--r-l)}.invoice-summary h3{font-size:26px}.invoice-summary small,.invoice-parties span{color:var(--muted)}.invoice-parties{display:grid;grid-template-columns:1fr 1fr;gap:8px}.invoice-parties>div,.facts>div{display:grid;gap:3px;padding:10px;background:var(--surface);border-radius:9px;min-width:0}.invoice-parties small,.facts small{font-size:11px;color:var(--muted);font-weight:700}.invoice-concepts,.seal-details{padding:11px 13px;border-radius:9px}.invoice-concepts ul{margin:6px 0 0}.facts{display:grid;grid-template-columns:repeat(auto-fit,minmax(170px,1fr));gap:9px;margin:10px 0}.facts>div{gap:2px;background:var(--surface-2)}.facts strong{font-size:13px}.seal-details{margin:8px 0}.seal-details summary{cursor:pointer;font-weight:650}.seal-details pre{white-space:pre-wrap;font-size:11px;max-height:130px;overflow:auto}.print-seals{font-size:10px}.print-seals p{margin:3px 0}.cap-row{display:flex;gap:9px;align-items:flex-start;padding:5px 0}.cap-row .tag{flex:none}.monitor-actions{display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:12px;padding:16px}.monitor-action{display:grid;gap:10px;align-content:start;background:var(--surface-2);border-radius:var(--r-l);padding:16px;min-width:0}.monitor-action p,.monitor-truth{font-size:13px}button.monitor-big{width:100%;padding:13px 15px;min-height:44px;justify-content:center}.monitor-truth{display:grid;gap:3px;padding:0 16px 16px;color:var(--muted)}.chart-legend .sw-hm0{background:var(--surface-2);border:var(--bd)}.chart-legend .sw-hm1{background:var(--chart-2);opacity:.5}.hm-scroll{overflow-x:auto;padding:2px 16px 6px}.hm{display:block;height:auto}.hm rect.hm-l0{fill:var(--surface-2);stroke:var(--line);stroke-width:.6}.hm rect.hm-l1{fill:var(--chart-2);opacity:.5}.hm rect.hm-l2{fill:var(--chart-2)}.hm text{fill:var(--muted);font-size:11px;font-weight:600}.hm-detail{padding:0 16px 13px;color:var(--muted)}.timeline-item{display:grid;padding:7px 0 7px 13px;border-left:2px solid var(--line)}.timeline-item small,.timeline-empty{color:var(--muted)}.timeline-empty{margin:4px 0}.traffic-strip{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:16px}.today-line{display:flex;gap:8px;align-items:baseline;flex-wrap:wrap;padding:0 16px 6px}.next-step{margin:6px 16px 16px;padding:13px 16px;border-radius:var(--r-l);background:var(--info-bg);display:grid;gap:6px;justify-items:start}.rest-switch{display:flex;gap:10px;align-items:center;flex-wrap:wrap}.rest-label{display:grid;gap:1px}.rest-label small{color:var(--muted);font-size:12px}.rest-toggle[aria-pressed="true"]{background:var(--warn-bg);color:var(--warn-ink);border-color:transparent}.filter-chips{display:flex;gap:7px;flex-wrap:wrap;align-items:center}.filter-chips:not(:empty){padding:10px 16px;border-top:var(--bd)}.filter-chip{border-radius:100px;padding:5px 11px;font-size:13px;background:var(--surface-2)}.pw-eye{padding:5px 8px;margin-top:4px;justify-self:start}.news-note{margin:10px 16px 0;padding:7px 10px;border:1px solid var(--warn-ink);border-radius:8px;background:var(--warn-bg);color:var(--warn-ink);font-size:13px;font-weight:700}.rfc-note{font-size:13px;font-weight:600;color:var(--muted)}.rfc-note[data-state=ok]{color:var(--ok-ink)}.rfc-note[data-state=warn]{color:var(--warn-ink);background:var(--warn-bg);border:1px solid var(--warn-ink);border-radius:8px;padding:7px 10px}.rfc-note[data-state=error]{color:var(--danger);background:var(--danger-bg);border:1px solid var(--danger);border-radius:8px;padding:7px 10px}.cp-row{display:flex;align-items:flex-start;gap:12px;padding:10px 4px;border-bottom:var(--bd)}.cp-row:last-child{border-bottom:0}.cp-main{display:flex;flex-direction:column;gap:2px;flex:1;min-width:0}.cp-hit{font-size:13px;font-weight:600}.cp-hit.sev-warn{color:var(--warn)}.satdoc-form{display:flex;flex-wrap:wrap;gap:10px;align-items:center}.satdoc-form input[type="text"]{flex:1}.switch-line{display:inline-flex;gap:8px;align-items:center}.rescue-folios{font-size:13px;word-break:break-all}.reconcile-candidate{border-radius:var(--r-l);padding:10px 12px;margin:8px 0;background:var(--surface-2)}.decl-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(min(150px,100%),1fr));gap:8px;margin:12px 0;min-width:0}.decl-cell{border-radius:var(--r-m);padding:10px 12px;display:grid;gap:2px}.today-clarity{display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:12px}.today-col{border-radius:var(--r-l);padding:10px 12px}.today-col h3{margin:0 0 6px}.visor-table td:nth-child(3),.visor-table td:nth-child(4){white-space:nowrap}.pagos-table{margin:8px 0 4px;font-size:14px}.pagos-table th{padding:6px 8px;border-bottom:2px solid var(--line)}.pagos-table td{padding:6px 8px;border-bottom:var(--bd);vertical-align:middle}.pagos-cell{cursor:pointer}.pagos-over td{background:color-mix(in srgb,var(--danger) 8%,transparent)}.pagos-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(230px,1fr));gap:10px 14px;margin:8px 0}.pagos-field{display:flex;flex-direction:column;gap:4px;font-size:13px}.pagos-field span{color:var(--muted)}.pagos-form{margin-top:16px;border-top:var(--bd);padding-top:10px}.pagos-form h3{margin-bottom:8px}.pagos-warn{border:1px solid color-mix(in srgb,var(--warn-ink) 55%,transparent);background:color-mix(in srgb,var(--warn-ink) 9%,transparent);border-radius:var(--r-s);padding:8px 12px;margin:10px 0}.pagos-seed{border:1px dashed color-mix(in srgb,var(--chart-2) 55%,transparent);border-radius:var(--r-s);padding:10px 12px;margin:8px 0 12px}.pagos-actions{display:flex;gap:8px;flex-wrap:wrap}.pagos-lines th:nth-child(2),.pagos-lines td:nth-child(2){min-width:210px}.pagos-lines th:nth-child(3),.pagos-lines td:nth-child(3){white-space:nowrap}.pagos-lines th:nth-child(6),.pagos-lines td:nth-child(6){min-width:108px}.sat-meta{display:flex;gap:4px 14px;flex-wrap:wrap}.sat-progress{margin-top:10px;border-top:1px dashed var(--line);padding-top:8px}.sat-progress-head{margin:0 0 6px}.sat-progress-note{font-size:13px;margin:6px 0 0}.sat-steps{list-style:none;margin:0;padding:0;font-size:13px}.sat-steps li{display:flex;gap:8px;padding:2px 0;align-items:baseline}.sat-step-time{opacity:.6;white-space:nowrap}.sat-run{border-radius:8px;padding:6px 10px;margin:6px 0}.sat-run summary{cursor:pointer;font-size:13px;font-weight:600}.swatches{display:flex;gap:8px;flex-wrap:wrap}.swatch{padding:7px 10px}.swatch[aria-pressed="true"]{border-color:var(--green);background:var(--tint);color:var(--accent-ink)}.swatch-dot{width:15px;height:15px;border-radius:50%;display:inline-block}.logo-preview{width:52px;height:52px;object-fit:contain;border:var(--bd);border-radius:10px}/* Acentos (formato de verify.cjs). */:root[data-accent="azul"]{--green:#175c9e;--green-hover:#114a80;--on-accent:#ffffff;--tint:#e3edf8;--accent-ink:#175c9e;--nav-active-bg:#123c63;--nav-active-ink:#cfe2f5}:root[data-theme="dark"][data-accent="azul"]{--green:#6ea8dc;--green-hover:#8dbde8;--on-accent:#0a1c30;--tint:#17334f;--accent-ink:#6ea8dc;--nav-active-bg:#17334f;--nav-active-ink:#6ea8dc}:root[data-accent="teal"]{--green:#0f766e;--green-hover:#0b5a54;--on-accent:#ffffff;--tint:#dcf2ef;--accent-ink:#0f766e;--nav-active-bg:#0a3f3a;--nav-active-ink:#c4efe9}:root[data-theme="dark"][data-accent="teal"]{--green:#2dd4bf;--green-hover:#5eead4;--on-accent:#052e2a;--tint:#0f3532;--accent-ink:#2dd4bf;--nav-active-bg:#0f3532;--nav-active-ink:#2dd4bf}:root[data-accent="violeta"]{--green:#6d28d9;--green-hover:#571db0;--on-accent:#ffffff;--tint:#ece4fa;--accent-ink:#6d28d9;--nav-active-bg:#3d1478;--nav-active-ink:#ddd0fb}:root[data-theme="dark"][data-accent="violeta"]{--green:#a78bfa;--green-hover:#bfa8fc;--on-accent:#1d0b38;--tint:#2a1b4d;--accent-ink:#a78bfa;--nav-active-bg:#2a1b4d;--nav-active-ink:#a78bfa}:root[data-accent="burdeos"]{--green:#9f2436;--green-hover:#7f1b2b;--on-accent:#ffffff;--tint:#f9e3e6;--accent-ink:#9f2436;--nav-active-bg:#57101d;--nav-active-ink:#f6ccd2}:root[data-theme="dark"][data-accent="burdeos"]{--green:#f08a94;--green-hover:#f5a7ae;--on-accent:#330a10;--tint:#472028;--accent-ink:#f08a94;--nav-active-bg:#472028;--nav-active-ink:#f08a94}:root[data-accent="ambar"]{--green:#9a5b00;--green-hover:#7c4900;--on-accent:#ffffff;--tint:#f7ecd4;--accent-ink:#9a5b00;--nav-active-bg:#54350a;--nav-active-ink:#f3dfae}:root[data-theme="dark"][data-accent="ambar"]{--green:#f5b04c;--green-hover:#ffc46b;--on-accent:#2e1c02;--tint:#453310;--accent-ink:#f5b04c;--nav-active-bg:#453310;--nav-active-ink:#f5b04c}:root[data-accent="rosa"]{--green:#b01854;--green-hover:#8f1244;--on-accent:#ffffff;--tint:#f9e0ea;--accent-ink:#b01854;--nav-active-bg:#5c0d2f;--nav-active-ink:#f6c9da}:root[data-theme="dark"][data-accent="rosa"]{--green:#f78fb8;--green-hover:#faa9ca;--on-accent:#360a1c;--tint:#472031;--accent-ink:#f78fb8;--nav-active-bg:#472031;--nav-active-ink:#f78fb8}:root[data-accent="grafito"]{--green:#3f5468;--green-hover:#31424f;--on-accent:#ffffff;--tint:#e5ebf0;--accent-ink:#3f5468;--nav-active-bg:#22303f;--nav-active-ink:#d3dee8}:root[data-theme="dark"][data-accent="grafito"]{--green:#9db1c8;--green-hover:#b3c4d8;--on-accent:#101b26;--tint:#22303f;--accent-ink:#9db1c8;--nav-active-bg:#22303f;--nav-active-ink:#9db1c8}:root[data-accent="verde"]{--green:#0e6b4f;--green-hover:#0a5741;--on-accent:#ffffff;--tint:#e1f1e9;--accent-ink:#125d44;--nav-active-bg:#14402f;--nav-active-ink:#a9ecc9}:root[data-theme="dark"][data-accent="verde"]{--green:#2fae83;--green-hover:#3cc398;--on-accent:#06231a;--tint:#14352b;--accent-ink:#9fe3c0;--nav-active-bg:#14352b;--nav-active-ink:#a9ecc9}@media(max-width:1080px){.dashboard-grid{grid-template-columns:1fr}}@media(max-width:900px){.top-search input{min-width:120px;width:38vw}}@media(max-width:860px){.sidebar{display:none}.frame{grid-template-columns:1fr}.bottombar{display:grid;grid-template-columns:repeat(5,1fr);gap:4px;position:fixed;left:0;right:0;bottom:0;z-index:40;background:var(--surface);border-top:var(--bd);padding:6px 8px calc(6px + env(safe-area-inset-bottom))}.bottombar button{flex-direction:column;gap:2px;font-size:11px;padding:6px 2px;border-color:transparent;background:transparent}.bottombar button[aria-current]{background:var(--tint);color:var(--accent-ink)}.page{padding-bottom:84px}.total-hero strong{font-size:28px}.frame.sheet-open .sidebar{display:flex;position:fixed;inset:0 auto 0 0;width:min(300px,86vw);z-index:50;overflow-y:auto}.frame.sheet-open .sidebar nav{display:grid}.card-table .table-scroll,.card-table.table-scroll{overflow:visible}.card-table .grid-table{display:block}.card-table .grid-table thead{display:none}.card-table .grid-table tbody,.card-table .grid-table tr{display:block}.card-table .grid-table tr{border:var(--bd);border-radius:var(--r-l);padding:8px 12px;margin-bottom:12px}.card-table .grid-table td{display:flex;justify-content:space-between;gap:12px;border-top:0;padding:6px 0}.card-table .grid-table td::before{content:attr(data-label);color:var(--muted);font-weight:600}}@media(max-width:780px){.frame{grid-template-columns:1fr}.sidebar{padding:14px;gap:12px}.switcher{grid-template-columns:minmax(0,1fr) auto}.switcher label{grid-column:1/-1}.sidebar nav{display:flex;flex-wrap:wrap}.local{display:none}.top,.page{padding:14px}.nav-caption{width:100%;padding:3px 5px}.metric{min-height:0}.dashboard-hero{padding:18px}.heading .actions{width:100%}.header-counters{display:none}}@media(max-width:460px){.invoice-parties{grid-template-columns:1fr}.heading .primary{width:100%}.filters input,.filters select{flex:1 1 140px}.monitor-actions{padding:10px}}@media print{.frame{display:none!important}#print-report{display:block!important;color:#000;background:#fff}#print-report table{width:100%;border-collapse:collapse}#print-report th,#print-report td{border:1px solid #bbb;padding:6px 8px;font-size:12px}}@media (prefers-reduced-motion:reduce){*,*::before,*::after{transition:none!important;animation:none!important}}.timeline{display:grid}
.ciec-captcha{border:var(--bd);border-radius:12px;padding:12px;margin-top:10px;background:var(--surface-2)}.ciec-captcha-img{display:block;max-width:100%;height:auto;border:var(--bd);border-radius:8px;background:#fff;margin:8px 0}
/* Problemas claros, corridas visuales, Centro de mando y salud (1.13.0) */.problem-card{border:var(--bd);border-left:5px solid var(--info-ink);border-radius:12px;padding:12px 14px;margin:10px 0;background:var(--surface-2);display:grid;gap:6px}.problem-card[data-level="rojo"]{border-left-color:var(--danger);background:var(--danger-bg)}.problem-card[data-level="ambar"]{border-left-color:var(--warn-ink);background:var(--warn-bg)}.problem-head{display:flex;gap:9px;align-items:center;flex-wrap:wrap}.problem-head strong{font-size:15px}.problem-means{color:var(--ink)}.problem-now{color:var(--ink)}.problem-detail summary{cursor:pointer;font-size:13px;color:var(--muted);font-weight:600}.problem-detail p{font-size:13px;margin-top:5px;overflow-wrap:anywhere}.problem-rows{display:grid;gap:7px;padding:2px 16px 16px}.problem-row{display:flex;gap:9px;align-items:baseline;flex-wrap:wrap;font-size:14px}.problem-dot{width:11px;height:11px;border-radius:50%;background:var(--info-ink);flex:none;align-self:center}.problem-row[data-level="rojo"] .problem-dot{background:var(--danger)}.problem-row[data-level="ambar"] .problem-dot{background:var(--warn-ink)}.problem-row-now{color:var(--muted)}.run-phases{list-style:none;margin:8px 0;padding:0;display:grid;gap:4px}.run-phase{display:flex;gap:9px;align-items:center;font-size:14px;color:var(--muted)}.run-phase-mark{width:22px;height:22px;border-radius:50%;display:grid;place-items:center;font-weight:700;font-size:13px;background:var(--surface);border:var(--bd);flex:none}.run-phase[data-state="done"]{color:var(--ink)}.run-phase[data-state="done"] .run-phase-mark{background:var(--ok-bg);color:var(--ok-ink);border-color:transparent}.run-phase[data-state="current"]{color:var(--ink);font-weight:650}.run-phase[data-state="current"] .run-phase-mark{background:var(--warn-bg);color:var(--warn-ink);border-color:transparent}.run-phase[data-state="failed"]{color:var(--danger);font-weight:650}.run-phase[data-state="failed"] .run-phase-mark{background:var(--danger-bg);color:var(--danger);border-color:transparent}.cmd-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(255px,1fr));gap:10px;padding:10px 12px 12px}.cmd-grid>div{display:grid}.cmd-grid>div:empty{display:none}.cmd-card{border:var(--bd);border-radius:var(--r-l);background:var(--surface-2);padding:10px;display:grid;gap:7px;align-content:start;min-width:0}.cmd-main{display:flex;gap:11px;align-items:flex-start;background:none;border:none;padding:0;text-align:left;cursor:pointer;width:100%;font:inherit;color:inherit}.cmd-main:hover{background:none}.cmd-dot{width:15px;height:15px;border-radius:50%;background:var(--green);flex:none;margin-top:4px}.cmd-card[data-level="rojo"] .cmd-dot{background:var(--danger)}.cmd-card[data-level="ambar"] .cmd-dot{background:var(--warn-ink)}.cmd-card[data-level="gris"] .cmd-dot{background:var(--info-ink)}.cmd-texts{display:grid;gap:2px;min-width:0}.cmd-title{font-size:15px}.cmd-big{font-size:14px;font-weight:650;color:var(--ink);overflow-wrap:anywhere}.cmd-last{color:var(--muted);font-size:13px;overflow-wrap:anywhere}.cmd-actions{display:flex;gap:8px;flex-wrap:wrap}.health-ok-row{display:flex;gap:8px;flex-wrap:wrap;padding:0 16px 14px}.health-chip{display:grid;gap:1px;background:var(--surface-2);border-radius:10px;padding:7px 10px;font-size:13px}.health-chip small{color:var(--muted)}.health-ok-line{padding:2px 16px;color:var(--muted);font-size:14px}

/* Acciones directas de SAT y significado en Listas (1.13.1) */.sat-quick-bar{display:flex;gap:10px;align-items:center;padding:12px 16px 2px;flex-wrap:wrap}.sat-quick-label{font-weight:700;font-size:13px;color:var(--muted)}.sat-quick-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(225px,1fr));gap:12px;padding:12px 16px 16px}.sat-quick-btn{flex-direction:column;align-items:flex-start;justify-content:flex-start;gap:7px;padding:15px 16px;min-height:102px;border-radius:var(--r-l);background:var(--surface-2);text-align:left}.sat-quick-btn strong{font-size:19px}.sat-quick-head{display:flex;gap:9px;align-items:center}.sat-quick-line{color:var(--muted);font-size:13px;overflow-wrap:anywhere}
/* Parrilla de trámites del Centro SAT y capa de atención (1.29.2) */
.tramite-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(262px,1fr));gap:12px;padding:12px 16px 16px}
.tramite-card{display:flex;flex-direction:column;gap:7px;padding:16px;border-radius:var(--r-l);background:var(--surface-2)}
.tramite-head{display:flex;gap:10px;align-items:center}
.tramite-head strong{font-size:20px}
.tramite-ultimo{font-size:14px;font-weight:600;overflow-wrap:anywhere}
.tramite-detalle{color:var(--muted);font-size:13px;overflow-wrap:anywhere}
.tramite-porque{color:var(--muted);font-size:13px;overflow-wrap:anywhere}
.tramite-acts{display:flex;gap:8px;margin-top:auto;padding-top:8px;flex-wrap:wrap}
.aviso-gesto{font-size:12px;font-weight:700;color:var(--muted);border:1px solid var(--line);border-radius:999px;padding:2px 9px;white-space:nowrap}
@media (max-width:640px){.tramite-grid{grid-template-columns:1fr}}
.cp-significado{margin-top:4px}.cp-significado>summary{cursor:pointer;font-weight:650;font-size:14px;color:var(--green)}

/* Impresión del comprobante (1.13.1): solo la representación, en retrato */@media print{@page{size:letter portrait;margin:13mm 13mm 17mm;@bottom-left{content:"PacoSAT · Expediente fiscal";font-size:9px;color:#555}@bottom-right{content:"Página " counter(page) " de " counter(pages);font-size:9px;color:#555}}dialog{display:none!important}#print-report{font-size:12px;line-height:1.42}#print-report h1{font-size:19px}#print-report .print-parties{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin:10px 0}#print-report .print-party{border:1px solid #bbb;padding:8px 10px;display:grid;gap:2px}#print-report .print-party small{color:#444;font-weight:700;letter-spacing:.08em}#print-report .print-seals{font-size:9.5px;word-break:break-all;color:#222;margin-top:10px}#print-report .print-estado{border-top:2px solid #000;margin-top:14px;padding-top:8px;font-size:11.5px}}

/* Acciones largas (1.13.1, piezas E/F): la tarjeta de progreso vive
   junto al botón que la lanzó, con fase, barra medible y resultado
   persistente; y la hoja de descarga (C2) con su resumen previo. */
.run-status{margin-top:10px;display:grid;gap:6px;justify-items:start}
.run-status:empty{margin-top:0}
.run-phase{font-weight:600;margin:0}
.run-final{margin:0;font-weight:600}
.run-bar{width:100%;max-width:340px;height:8px;border-radius:99px;background:color-mix(in srgb,var(--ink) 14%,transparent);overflow:hidden}
.run-bar i{display:block;height:100%;background:var(--accent);border-radius:99px;transition:width .4s ease}
.dl-summary{font-weight:700;border:1px dashed color-mix(in srgb,var(--ink) 35%,transparent);border-radius:10px;padding:10px 12px}
.dl-status{display:grid;gap:6px}
.dl-status p{margin:0}

/* Mapa anual de declaraciones (1.17.0) */
.decl-mapa-resumen{display:flex;gap:6px 16px;flex-wrap:wrap;align-items:baseline;margin:10px 0 2px}
.decl-mapa-resumen strong{font-size:15px}
.decl-mapa-cuenta{font-weight:700;font-size:13px}
.decl-mapa-cuenta.warn{color:var(--warn-ink)}
.decl-mapa-cuenta.bad{color:var(--danger)}
.reg-linea{display:flex;gap:8px;align-items:baseline;flex-wrap:wrap}.decl-alerta{border:1px solid var(--danger);background:var(--danger-bg);color:var(--danger);border-radius:10px;padding:9px 12px;margin:8px 0;font-weight:600}
button.decl-cell{font:inherit;color:inherit;text-align:left;cursor:pointer;border:1px solid var(--line);width:100%;min-height:48px;min-width:0;overflow:hidden}
.decl-mapa-presentada{background:var(--tint)}
.decl-mapa-pendiente{background:var(--warn-bg)}
.scope-top{max-width:220px;padding:4px 8px;border-radius:var(--r-s);border:1px solid var(--line);background:var(--surface);color:inherit;font:inherit;font-size:.85em}
.decl-progreso{display:flex;gap:10px;align-items:center;flex-wrap:wrap;margin:8px 0}
.sat-arranque{margin:8px 0;padding:8px 10px;border:1px dashed var(--line);border-radius:var(--r-s)}
.sat-arranque ul{margin:6px 0 0;padding-left:18px}
.decl-mapa-sin-recuperar{background:var(--danger-bg);border-color:var(--danger)}
.decl-mapa-pagada-sin-acuse{background:var(--warn-bg);border-color:var(--warn)}
.decl-mapa-no-toca{opacity:.6}
.decl-cell.decl-sel{outline:2px solid var(--green);outline-offset:1px;opacity:1}
.decl-grid>.decl-anual{grid-column:1/-1}
.decl-detalle{border:var(--bd);border-radius:12px;padding:12px 14px;margin:4px 0 12px;display:grid;gap:8px;background:var(--surface-2)}
.decl-detalle h4{margin:0;font-size:15px}
.decl-detalle p{margin:0}
/* Ronda Facilidad (1.18.0): botón «Deshacer» en la barra de estado
   y filtros de Facturas como panel plegable en móvil (en escritorio
   el botón no existe y los filtros van en su fila de siempre). */
.status-undo{padding:3px 10px;font-size:12px;margin-left:8px}
.filters-toggle,.filters-apply{display:none}
@media(max-width:860px){.filters-toggle{display:inline-flex;margin:0 12px 10px}.invoice-filters{display:none}.invoice-filters.open{display:grid;gap:8px}.filters-apply{display:inline-flex}}
.bottombar button{min-height:52px}.nav button{min-height:44px}.news-badge{font-weight:700}.cp-row .pill{flex:none}.cp-row>span,.cp-row>strong{min-width:0;overflow-wrap:anywhere}
@media(max-width:860px){.top{flex-wrap:wrap}.top-side{flex-wrap:wrap;min-width:0;max-width:100%}.scope-top{min-width:0;max-width:46vw}.top-search{flex:1;min-width:120px}.top-search input{width:100%}.frame{grid-template-columns:minmax(0,1fr)}main{min-width:0}.cp-row{flex-wrap:wrap}.cp-row button{min-height:44px}}
/* La cabecera también se recoge en la banda 861–1100
   (1.29.1, D3): sin esto no envolvía y TODA pantalla
   desbordaba en horizontal a ~900 px. */
@media(max-width:1100px){.top{flex-wrap:wrap}.top-side{flex-wrap:wrap;min-width:0;max-width:100%;flex:1 1 auto}.scope-top{min-width:0}.top-search{flex:1 1 140px;min-width:0}.top-search input{width:100%;min-width:0}}
/* Clases que el código ya usaba y no existían (auditoría visual
   1.25.0): «soft» es el botón secundario de toda la app;
   «clickable», la fila que abre algo (cursor y realce al pasar);
   «inline-form», el formulario en una línea con sus controles. */
.soft{background:var(--surface-2)}
.clickable{cursor:pointer}
.clickable:hover{background:var(--surface-2)}
.inline-form{display:flex;gap:8px;align-items:center;flex-wrap:wrap}

/* Avisos flotantes, entrada diseñada y gráficas de Dinero
   (1.26.0, Ronda Visual): las confirmaciones viven junto al
   dedo y no solo en la barra lejana; la cara del login propio;
   la antigüedad y los saldos por mes, en barras; el pie de los
   documentos impresos. */
.toasts{position:fixed;right:16px;bottom:16px;z-index:90;display:grid;gap:8px;max-width:min(400px,calc(100vw - 24px))}
.toast-card{display:flex;align-items:flex-start;gap:10px;background:var(--surface);border:var(--bd);border-left:4px solid var(--green);border-radius:var(--r-m);box-shadow:var(--shadow-2);padding:12px 14px;animation:toast-in .18s ease}
.toast-card[data-kind=error]{border-left-color:var(--danger)}
.toast-card p{flex:1;min-width:0;margin:0;font-size:14px;overflow-wrap:anywhere}
.toast-card .toast-close{flex:none;padding:4px}
@keyframes toast-in{from{opacity:0;transform:translateY(8px)}}
@media (max-width:860px){.toasts{left:12px;right:12px;bottom:64px;max-width:none}}
dialog{animation:dialog-in .16s ease}
@keyframes dialog-in{from{opacity:0;transform:translateY(6px)}}
tbody tr{transition:background-color .12s ease}
tbody tr:hover{background:var(--surface-2)}
.entry{position:fixed;inset:0;z-index:120;display:grid;place-items:center;padding:18px;background:light-dark(#eef3f6,#060d18);overflow:auto}
.entry[hidden]{display:none}
.entry-card{width:min(400px,100%);background:var(--surface);border:var(--bd);border-radius:var(--r-l);box-shadow:var(--shadow-1);padding:30px 28px;display:grid;gap:12px;text-align:center}
.entry-logo{width:56px;height:56px;justify-self:center}
.entry-title{margin:0;font-size:30px}
.entry-sub{margin:0;color:var(--muted)}
.entry-form{display:grid;gap:10px;text-align:left}
.entry-form label{font-weight:650;font-size:14px}
.entry-form input{padding:12px;font-size:15px}
.entry-form .primary{justify-content:center;padding:12px}
.entry-skip{justify-self:center}
.entry-note{margin:0;color:var(--muted);font-size:13px}
.age-chart{display:grid;gap:5px;padding:2px 16px 14px}
.age-label{font-weight:700;font-size:13px;margin-top:6px}
.age-line{display:grid;grid-template-columns:74px 1fr auto;gap:10px;align-items:center;font-size:13px}
.age-kind{color:var(--muted)}
.age-track{height:10px;border-radius:var(--r-pill);background:var(--surface-2);overflow:hidden}
.age-fill{height:100%;border-radius:var(--r-pill)}
.age-fill.cobrar{background:var(--green)}
.age-fill.pagar{background:var(--chart-2)}
.age-num{font-variant-numeric:tabular-nums}
.bar-cobrar{fill:var(--green)}
.bar-pagar{fill:var(--chart-2)}
.sw-cobrar{background:var(--green)}
.sw-pagar{background:var(--chart-2)}
.report-foot{display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap;margin-top:14px;padding-top:8px;border-top:1px solid #999;font-size:10px;color:#333}

/* ===== 1.29.0: gramática de la ronda ===== */
.entry-pass-row{display:flex;gap:8px;align-items:stretch}
.entry-pass-row input{flex:1;min-width:0}
.decl-cell-top{display:flex;gap:8px;align-items:center;justify-content:space-between;flex-wrap:wrap;min-width:0}
.decl-cell-top strong{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.decl-cell small{display:block;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.decl-pill{font-size:11px;font-weight:700;border-radius:var(--r-pill);padding:2px 8px;background:var(--surface-2);color:var(--muted);white-space:nowrap;max-width:100%;overflow:hidden;text-overflow:ellipsis}
.decl-pill-presentada{background:var(--tint);color:var(--accent-ink)}
.decl-pill-pendiente,.decl-pill-pagada-sin-acuse{background:var(--warn-bg);color:var(--warn-ink)}
.decl-pill-sin-recuperar{background:var(--danger-bg);color:var(--danger)}
.trib-gestos{display:flex;gap:6px;flex-wrap:wrap;flex:none}
.trib-plazo{height:6px;border-radius:var(--r-pill);background:var(--surface-2);overflow:hidden;margin-top:6px;max-width:420px}
.trib-plazo-fill{height:100%;background:var(--chart-2);border-radius:var(--r-pill)}
.trib-plazo-hot{background:var(--danger)}
.trib-papelera-row{opacity:.85}
.reg-dia{margin:16px 0 6px;font-size:13px;color:var(--muted);text-transform:capitalize}
.reg-fallo{border-left:3px solid var(--danger);padding-left:10px}
.reg-detalle{flex-basis:100%;margin-top:6px}
.reg-detalle summary{cursor:pointer;font-size:13px;font-weight:600;color:var(--accent-ink)}
.reg-traza{display:grid;gap:3px;padding:8px 0 2px;font-size:13px}
.reg-step{margin:0;color:var(--muted)}
.pagos-todo-pagado{border:1px solid color-mix(in srgb,var(--green) 45%,transparent);background:var(--tint);border-radius:var(--r-l);padding:14px 16px;display:grid;gap:4px}
.pagos-todo-pagado strong{font-size:17px;color:var(--accent-ink)}
.executor-token{border:var(--bd);border-radius:var(--r-l);padding:12px 16px;margin-top:10px;display:grid;gap:6px}
.executor-token code{font-size:13px;word-break:break-all;background:var(--surface-2);padding:8px 10px;border-radius:var(--r-s)}
@media(max-width:860px){
.today-clarity{display:flex;flex-direction:column}
.today-col-falta{order:1}.today-col-vence{order:2}.today-col-hizo{order:3}
.cp-row{flex-wrap:wrap}
}

.tot-rfc{margin:14px 16px 4px}
.tot-anio{margin:6px 16px;border:var(--bd);border-radius:var(--r-l);padding:6px 12px}
.tot-anio-sum{display:flex;gap:12px;align-items:baseline;flex-wrap:wrap;cursor:pointer;padding:6px 2px}
.tot-anio-sum strong{font-size:16px}
.tot-mes{display:flex;gap:10px;align-items:center;justify-content:space-between;width:100%;text-align:left;padding:10px 8px;border:0;border-top:var(--bd);background:transparent;font:inherit;color:inherit;cursor:pointer;flex-wrap:wrap}
.tot-mes:hover{background:var(--surface-2)}
.tot-mes-go{color:var(--accent-ink);font-weight:650;white-space:nowrap}
.tot-det-head{display:flex;gap:12px;align-items:center;flex-wrap:wrap;padding:0 16px}
.tot-det-sec{padding:0 16px}
.tot-suma{font-weight:650}
/* ===== 1.31.0: piezas de esta ronda ===== */
/* Fila de trabajos del menú (.nav-jobs): el frente SAT la pinta
   como un renglón más de la navegación cuando hay un trabajo
   vivo — misma ropa que los botones de .sidebar nav (fondo
   transparente, texto de navegación, 11px de aire vertical),
   para que no parezca un elemento de otra app. */
.nav-jobs{display:flex;align-items:center;gap:8px;width:100%;padding:11px 10px;background:transparent;border:1px solid transparent;border-radius:var(--r-s);color:var(--nav-text);font-weight:600;justify-content:flex-start;text-align:left;flex-wrap:wrap}
.nav-jobs:hover{background:light-dark(#1a3353,#16294a)}
/* La fila reparte su ancho: el destino cede y envuelve, y su
   Cancelar nunca sale del carril del menú (en la primera captura
   de la ronda se le cortaba la última letra contra el borde). */
.nav-jobs-main{flex:1 1 110px;min-width:0;display:flex;align-items:center;gap:8px;background:none;border:0;color:inherit;font:inherit;text-align:left;padding:0;cursor:pointer}
#nav-jobs-cancel button{background:transparent;border:1px solid currentColor;color:var(--nav-text);border-radius:var(--r-s);padding:4px 10px;font:inherit;font-weight:600;cursor:pointer}
/* V3 · Foco en la parrilla de trámites (1.31.1, corrección de
   diseño de Paco): NADA se atenúa — todas las tarjetas se leen a
   contraste pleno siempre. El foco se realza SOLO en su tarjeta:
   borde y fondo suave del verde de la casa y su pastilla en color
   pleno; el lavado de la 1.31.0 (opacity .55 sobre las demás)
   las dejaba como deshabilitadas e ilegibles: fuera. */
.tramite-grid.tiene-foco .tramite-card.tramite-foco{border:1px solid var(--green);
  box-shadow:inset 0 0 0 1px var(--green);background:var(--tint)}
.tramite-foco-tag{font-size:11px;font-weight:750;letter-spacing:.06em;
  color:var(--accent-ink);text-transform:uppercase}
/* El detalle técnico de una tarjeta de trámite vive plegado:
   la cara dice qué es, su estado y su último resultado. */
.tramite-fold summary{cursor:pointer;font-size:13px;color:var(--muted);font-weight:600}
.tramite-fold p{font-size:13px;color:var(--muted);margin-top:4px;overflow-wrap:anywhere}
/* Plazos del Buzón Tributario: la barra/etiqueta de plazo se
   tiñe según lo que queda — ámbar cuando aprieta, rojo cuando
   el plazo ya quema — con los tonos de aviso de la casa. */
.plazo-ambar{color:var(--warn-ink);background:var(--warn-bg)}
.plazo-rojo{color:var(--danger);background:var(--danger-bg)}
/* V8 · Dueño del aviso: pastilla pequeña con su punto de color
   (el icono es el ::before: cada dueño, su señal). */
.aviso-dueno{display:inline-flex;align-items:center;gap:5px;border-radius:999px;padding:2px 9px;font-size:12px;font-weight:700;border:1px solid var(--line);white-space:nowrap}
.aviso-dueno::before{content:"●";font-size:9px}
.aviso-dueno[data-dueno="tu"]{background:var(--warn-bg);color:var(--warn-ink)}
.aviso-dueno[data-dueno="sat"]{background:var(--danger-bg);color:var(--danger)}
.aviso-dueno[data-dueno="sistema"]{background:var(--info-bg);color:var(--info-ink)}
/* V1/V4 · Hoy: la pastilla del semáforo va grande dentro de su
   franja y la semana fiscal es una fila de siete días con su
   punto de aviso cuando algo vence o se espera. */
.traffic-strip[data-semaforo1310] .status-pill{font-size:15px;padding:9px 16px}
.semana-fiscal{display:flex;gap:6px;flex-wrap:wrap;padding:2px 16px 12px}
.semana-dia{display:grid;justify-items:center;gap:1px;min-width:36px;padding:6px 4px;border-radius:var(--r-s);background:var(--surface-2);font-size:13px}
.semana-dia[data-hoy="1"]{outline:2px solid var(--green);outline-offset:-2px}
.semana-dia small{color:var(--muted);font-size:11px}
.semana-punto{color:var(--warn-ink);font-size:15px;line-height:1}
/* F4 · La conciliación del detalle de Totales, en su línea. */
.tot-concilia{padding:2px 16px;font-weight:600}
/* V13 · Saldo vivo de Bancos: la línea del saldo en el tiempo. */
.saldo-line{fill:none;stroke:var(--green);stroke-width:2;stroke-linejoin:round;stroke-linecap:round}
.saldo-punto{fill:var(--green)}
/* F13 · Arrastrar y soltar: la cortina que cubre la ventana
   mientras se arrastran archivos sobre la app. */
.drop-overlay{position:fixed;inset:0;z-index:200;display:grid;place-items:center;background:light-dark(#0e2a47cc,#040a14d9);color:#fff;font-size:22px;font-weight:700;text-align:center;padding:20px}
.drop-overlay[hidden]{display:none}
/* V15 · Jerarquía de las tarjetas de trámite: el nombre manda
   menos que antes (17px, no 20) y «lo último» se lee en firme. */
.tramite-head strong{font-size:17px}
.tramite-ultimo{font-weight:600}
/* V10 · Móvil a pulgar: botones de 48px en la barra inferior y
   en la lámina lateral, y las listas un punto más grandes. */
@media (max-width:860px){
.bottombar button{min-height:48px}
.frame.sheet-open .sidebar button,.frame.sheet-open .sidebar nav button{min-height:48px}
.activity-item,.aviso-card,.card-table .grid-table td{font-size:14px}
.activity-body strong{font-size:14px}
}

/* ===== Vara de lujo sobrio (1.31.1, corrección de Paco) =====
   «Lo veo todo muy plain»: lo sobrio no es lo plano. Las
   tarjetas flotan sobre el fondo con sombra suave en capas y
   un filo de luz arriba; la tipografía manda (títulos con peso
   y tracking, el número importante en grande); el aire crece
   (radios amplios, aire generoso). El dorado apagado (--gold)
   aparece SOLO donde vale: la línea bajo el título de la
   pantalla, la del dato principal de Totales y el filo del
   sello de «Vigente». El verde de la casa sigue siendo EL
   acento; el azul noche manda en la barra lateral. */
.panel,.metric,.kpi,.tramite-card,.cmd-card,.aviso-card,.step,.problem-card{
  box-shadow:0 1px 2px rgba(16,34,25,.05),0 14px 34px -16px rgba(16,34,25,.20),
    inset 0 1px 0 rgba(255,255,255,.35)}
.tramite-card{background:linear-gradient(180deg,var(--surface),var(--surface-2))}
.tramite-grid.tiene-foco .tramite-card.tramite-foco{background:var(--tint)}
.panel h2{letter-spacing:-.01em;font-weight:700}
.heading h1{background:linear-gradient(var(--gold),var(--gold)) left bottom/46px 3px no-repeat;padding-bottom:9px}
.total-hero strong{background:linear-gradient(var(--gold),var(--gold)) center bottom/52px 3px no-repeat;padding-bottom:9px}
.metric strong,.kpi strong{font-size:28px;letter-spacing:-.01em}
.tramite-head>svg{width:40px;height:40px;padding:10px;border-radius:50%;flex:none;
  background:var(--tint);color:var(--green);
  box-shadow:inset 0 0 0 1px color-mix(in srgb,var(--green) 32%,transparent)}
.tramite-head strong{font-size:19px;letter-spacing:-.01em}
.status-pill{box-shadow:inset 0 0 0 1px color-mix(in srgb,currentColor 24%,transparent)}
.fiscal-badge[data-state=Vigente]{box-shadow:inset 0 0 0 1px color-mix(in srgb,var(--gold) 62%,transparent)}
button.primary{background:linear-gradient(180deg,color-mix(in srgb,var(--green) 86%,#ffffff),var(--green));
  box-shadow:0 8px 18px -8px color-mix(in srgb,var(--green) 65%,transparent)}
.cmd-card{transition:box-shadow .18s ease,transform .18s ease}
.cmd-card:hover{transform:translateY(-1px)}
.sidebar{background:linear-gradient(180deg,#0e1f36,#0a1728)}
.empty{padding:34px 18px}
.empty strong{font-size:15px;letter-spacing:-.01em}
/* Tu lista de gestos y Novedades (1.31.1): filas con su botón,
   en el mismo registro de tarjeta. */
.gestos-row{display:flex;gap:12px;align-items:center;padding:8px 16px;border-top:var(--bd)}
.gestos-row:first-of-type{border-top:none}
.gestos-row .gestos-txt{flex:1;min-width:0}
.gestos-row .gestos-txt strong{display:block;font-size:15px}
.gestos-row .gestos-txt p{font-size:13px}
.novedades-list{margin:4px 0 10px;padding-left:20px;display:grid;gap:5px}
.novedades-list li{font-size:14px}

/* ===== Efectos y barra lateral (1.31.1) =====
   La capa de MOVIMIENTO de la vara: el movimiento del lujo se
   nota sin verse. Transiciones de 150–300 ms en cambios de
   estado (las pastillas y el semáforo transicionan, no saltan),
   tarjetas que responden al tacto elevando su sombra, botones
   que confirman al instante con un asentamiento de 1 px, pulso
   suave SOLO donde hay un trabajo vivo que contar, y la entrada
   de cada pantalla con su fundido (view-in, en design.part).
   Prohibido y ausente a propósito: rebotes, giros nuevos, zooms
   y parpadeos; nada corre sin contar un estado. Con
   prefers-reduced-motion se apaga todo lo decorativo. */
.tramite-card,.cmd-card,.kpi,.metric{transition:box-shadow .22s ease,border-color .22s ease,background-color .22s ease}
.cmd-card:hover,.tramite-card:hover{box-shadow:0 2px 3px rgba(16,34,25,.06),0 20px 40px -16px rgba(16,34,25,.26),inset 0 1px 0 rgba(255,255,255,.35)}
.status-pill{transition:background-color .25s ease,color .25s ease,box-shadow .25s ease}
button{transition:background-color .18s ease,border-color .18s ease,box-shadow .18s ease,color .18s ease}
button:active{transform:translateY(1px)}
@keyframes paco-pulso{0%,100%{opacity:1}50%{opacity:.55}}
.nav-jobs:not(.nav-jobs-vacio) .nav-jobs-main svg{animation:paco-pulso 1.8s ease-in-out infinite}
.status-pill[data-state="work"]{animation:paco-pulso 2.2s ease-in-out infinite}
/* La fila de trabajos conserva su renglón: invisible e inerte
   sin trabajos, para que el menú nunca salte. */
.nav-jobs-vacio{visibility:hidden}
/* Barra con presencia: azul noche con profundidad y luz de
   borde; el contribuyente como cabecera; la fila activa con su
   acento verde y su filo dorado medido. */
.sidebar{background:linear-gradient(180deg,#112840,#0a1728 52%,#070f1d);box-shadow:inset -1px 0 0 rgba(255,255,255,.07),14px 0 34px -20px rgba(3,9,17,.55)}
.switcher{background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.10);border-radius:14px;padding:12px}
.sidebar nav button{border-radius:10px;position:relative}
.sidebar nav button[aria-current]{box-shadow:inset 3px 0 0 var(--gold),0 8px 16px -10px rgba(0,0,0,.6)}
.side-search{display:flex;align-items:center;gap:8px;width:100%;background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.13);color:#d7e4f2;border-radius:10px;padding:8px 11px;font-size:13px;font-weight:600;text-align:left}
.side-search:hover{background:rgba(255,255,255,.13)}
.side-search svg{width:16px;height:16px;flex:none}
.puerta-line{display:flex;align-items:center;gap:7px;margin-top:9px;font-size:11.5px;color:#bfcfe0}
.puerta-dot{width:9px;height:9px;border-radius:50%;background:#8fa3ba;flex:none}
.puerta-dot[data-state="ok"]{background:#3ecf7a;box-shadow:0 0 0 3px rgba(62,207,122,.20)}
.puerta-dot[data-state="mal"]{background:#e5533f;box-shadow:0 0 0 3px rgba(229,83,63,.20)}
.gestos-badge{background:var(--gold);color:#231a04}
.side-collapse{display:flex;align-items:center;gap:8px;background:none;border:none;color:#9db2c8;font-size:12px;font-weight:600;padding:8px 10px;border-radius:9px;text-align:left}
.side-collapse:hover{background:rgba(255,255,255,.07);color:#e6eef7}
.side-collapse svg{width:15px;height:15px;transform:rotate(180deg)}
/* Plegada a iconos (solo escritorio; en móvil manda la barra
   inferior y el cajón de siempre): la rejilla cede su columna
   y la barra enseña solo sus iconos, con las señales vivas. */
@media (min-width:861px){
  body.barra-plegada .frame{grid-template-columns:80px minmax(0,1fr)}
  body.barra-plegada .sidebar{padding:22px 12px;align-items:center}
  body.barra-plegada .sidebar nav button,body.barra-plegada .side-search{font-size:0;justify-content:center;padding-left:0;padding-right:0}
  body.barra-plegada .nav-caption,body.barra-plegada .brand span span,body.barra-plegada .brand small,
  body.barra-plegada .switcher label,body.barra-plegada .switcher select,
  body.barra-plegada .switcher #add,body.barra-plegada #puerta-txt,
  body.barra-plegada .local,body.barra-plegada .side-version,
  body.barra-plegada .side-collapse span,body.barra-plegada .side-search span{display:none}
  body.barra-plegada .switcher{background:none;border:none;padding:4px}
  body.barra-plegada .puerta-line{margin-top:2px;justify-content:center}
  body.barra-plegada .news-badge{position:absolute;top:2px;right:2px;font-size:10px}
  body.barra-plegada .side-collapse svg{transform:none}
  body.barra-plegada #nav-jobs-cancel{display:none}
}
@media (prefers-reduced-motion:reduce){
  *,*::before,*::after{animation:none!important;transition:none!important}
}

/* ===== 1.31.2 · Menú ⋯ de tarjeta, barra universal, iPhone y
   adaptativa =====
   El menú se ancla a su tarjeta (position relative en la
   tarjeta): panel a la derecha, con tope de ancho para que no
   se salga ni a 390 px. Botón y opciones de 44 px: pulgar,
   ratón y teclado en cualquier navegador (botones nativos). */
.tramite-card,.aviso-card,.cmd-card{position:relative}
.card-menu-wrap{position:relative;display:inline-flex;flex:none;margin-left:auto}
.card-menu-btn{min-width:44px;min-height:44px;padding:6px;font-size:20px;line-height:1;justify-content:center;border-color:transparent;background:transparent;border-radius:var(--r-m)}
.card-menu-btn:hover{background:var(--surface-2)}
.card-menu{position:absolute;right:0;top:calc(100% + 6px);z-index:70;min-width:216px;max-width:calc(100vw - 24px);background:var(--surface);border:var(--bd);border-radius:var(--r-l);box-shadow:var(--shadow-1);padding:6px;display:grid;gap:2px}
.card-menu-item{width:100%;min-height:44px;justify-content:flex-start;border-color:transparent;background:transparent;font-weight:600;padding:10px 12px}
.card-menu-item:hover{background:var(--surface-2)}
.card-menu-item.danger{color:var(--danger)}
/* Barra de progreso universal (trabajos y plazos): pista de la
   casa, relleno del acento; indeterminada con vaivén suave —
   con prefers-reduced-motion el vaivén se apaga por la regla
   global de la casa. Los tramos de plazo tiñen el relleno. */
.job-progress{display:grid;gap:6px;margin-top:10px}
.job-progress-line{display:flex;justify-content:space-between;gap:10px;font-size:12px;color:var(--muted)}
.job-progress-line span:first-child{font-weight:600;color:var(--ink)}
.job-progress-time{white-space:nowrap}
.job-bar{height:8px;border-radius:var(--r-pill);background:var(--surface-2);overflow:hidden}
.job-bar-fill{display:block;height:100%;background:var(--green);border-radius:var(--r-pill);transition:width .25s ease}
.job-bar-ind .job-bar-fill{width:38%;animation:job-slide-1312 1.5s ease-in-out infinite alternate}
@keyframes job-slide-1312{from{margin-left:0}to{margin-left:62%}}
.job-bar-fill.plazo-ok{background:var(--green)}
.job-bar-fill.plazo-warn{background:light-dark(#c07f10,#e8b93e)}
.job-bar-fill.plazo-bad{background:var(--danger)}
.trib-plazo-fill.plazo-ok{background:var(--green)}
.trib-plazo-fill.plazo-warn{background:light-dark(#c07f10,#e8b93e)}
.trib-plazo-fill.plazo-bad{background:var(--danger)}
/* Frescura de tarjeta: «última vez · próxima vez» en discreto. */
.tramite-frescura{font-size:12px;color:var(--muted)}
/* Filtro «Solo lo que me necesita»: en Hoy oculta las tarjetas
   en verde (data-level ok); en el Centro SAT manda el atributo
   hidden que pone el pintado por rango. */
.cmd-grid.solo-necesita .cmd-card[data-level="ok"]{display:none}
.filtro-necesita-btn[aria-pressed="true"]{background:var(--green);border-color:var(--green);color:light-dark(#fff,#06231a)}
/* Punto de salud del menú lateral: dorado medido, solo cuando
   un conteo veraz dice que algo espera a Paco en ese destino. */
.nav-dot{width:9px;height:9px;border-radius:50%;background:var(--gold);flex:none;margin-left:6px;box-shadow:0 0 0 3px rgba(201,168,106,.18)}
/* iPhone y cualquier navegador (con su reserva primero):
   la altura del marco usa vh y se refina a dvh donde el motor
   lo soporta; los avisos flotantes respetan el área segura que
   la barra inferior ya respetaba; y en móvil ningún campo baja
   de 16 px, para que iOS no haga zoom al enfocar. */
.frame{min-height:100vh;min-height:100dvh}
body.drag-active::after{bottom:max(22px,env(safe-area-inset-bottom))}
@media (max-width:860px){
  input,select,textarea{font-size:16px}
  .toasts{bottom:calc(64px + env(safe-area-inset-bottom))}
  .card-menu{min-width:200px}
}
@media (prefers-reduced-motion:reduce){
  .job-bar-ind .job-bar-fill{animation:none}
}

/* ===== 1.32.0 · Panel de la API =====
   Las llaves como tarjetas de la casa; la llave nueva, en una
   caja con el dorado medido de los sellos; los ejemplos en
   código legible que no desborda en móvil. */
.api-key-card{position:relative;border:var(--bd);border-radius:16px;background:var(--surface);padding:14px 16px;margin:10px 0;box-shadow:var(--sh-1)}
.api-key-meta{display:flex;flex-wrap:wrap;gap:4px 16px;color:var(--muted);font-size:13px;margin:6px 0 0}
.api-llave-nueva{border:1.5px solid var(--gold);border-radius:16px;padding:14px 16px;margin:12px 0;background:var(--surface)}
.api-recursos{display:grid;gap:6px;margin:10px 0}
.api-recurso{display:flex;flex-wrap:wrap;gap:4px 14px;align-items:baseline;border-bottom:1px solid var(--line);padding:6px 0}
.api-recurso code{color:var(--brand-ink);word-break:break-all}
.api-ejemplo{border:var(--bd);border-radius:12px;padding:10px 12px;margin:8px 0;background:var(--surface-2)}
.api-ejemplo-head{display:flex;justify-content:space-between;align-items:center;gap:10px;margin-bottom:6px}
.api-form{display:grid;gap:10px;margin:12px 0}
.api-llamadas{display:grid;gap:4px;margin:8px 0}
.api-llamada{display:flex;flex-wrap:wrap;gap:4px 12px;align-items:center;font-size:13px;border-bottom:1px solid var(--line);padding:5px 0}
.api-llamada code{word-break:break-all}

/* Cifras y folios clicables hasta su documento (1.32.1, F4/H4):
   el importe y el folio de la fila son el enlace a su detalle,
   con el mismo peso visual que el dato, no un botón disfrazado. */
.cell-link { background: none; border: 0; padding: 0; font: inherit; color: inherit;
  cursor: pointer; text-align: left; text-decoration: underline;
  text-decoration-color: color-mix(in srgb, currentColor 35%, transparent);
  text-underline-offset: 3px; }
.cell-link:hover { text-decoration-color: currentColor; }
.cell-link-total { font-weight: 650; }
/* «Más filtros» de Facturas (1.32.1, F2): la segunda fila de
   controles, plegada hasta que se pide. */
.filters-mas { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; padding: 4px 0 8px; }
.filters-mas[hidden] { display: none; }

/* La cifra de la métrica de Hoy es su propio enlace (1.32.1, H4). */
.metric-value-link { background: none; border: 0; padding: 0; font: inherit;
  font-size: 1.55rem; font-weight: 700; color: inherit; cursor: pointer;
  text-align: left; font-variant-numeric: tabular-nums; }
.metric-value-link:hover { text-decoration: underline; text-underline-offset: 4px; }

/* Centro SAT: la barra de pestañas como franja secundaria (1.32.1, S3) */
.tabbar-secundaria{padding:5px 12px;background:var(--surface-2)}
.tabbar-secundaria button{font-size:13px;min-height:36px;padding:5px 10px}

/* ===== Tanda 2 · 2.0: identidad por RFC, selector, panel
   general, pintado progresivo y cabecera móvil compacta ===== */
.rfc-medallon200b{display:inline-grid;place-items:center;width:30px;height:30px;border-radius:50%;background:var(--surface-2);color:var(--muted);border:var(--bd);font-weight:750;font-size:14px;flex:none}
.salud-punto200b{width:11px;height:11px;border-radius:50%;background:var(--muted);flex:none;display:inline-block}
.salud-punto200b[data-nivel="ok"]{background:#1d9e6c}
.salud-punto200b[data-nivel="warn"]{background:#d99a16}
.salud-punto200b[data-nivel="bad"]{background:#cf3a2e}
.scope-menu-btn200b{gap:8px;max-width:46vw;overflow:hidden;white-space:nowrap;justify-content:flex-start;min-width:0}
.scope-nombre200b{overflow:hidden;text-overflow:ellipsis;min-width:0}
.scope-menu200b{position:fixed;top:64px;right:14px;z-index:70;width:min(360px,92vw);background:var(--surface);border:var(--bd);border-radius:var(--r-l);box-shadow:var(--shadow-1);padding:10px;display:grid;gap:6px;max-height:70vh;overflow:auto}
.scope-menu200b input{width:100%;font-size:16px}
.scope-menu-row200b{display:flex;align-items:center;gap:9px;width:100%;min-height:44px}
.contrib-row200b{display:flex;align-items:center;gap:12px;width:100%;text-align:left;padding:10px 12px;margin:0 16px 8px;width:calc(100% - 32px)}
.contrib-txt200b{display:grid;gap:2px;flex:1;min-width:0}
.contrib-txt200b small{color:var(--muted)}
.hoy-acciones200b{display:flex;gap:8px;flex-wrap:wrap;padding:4px 16px 14px}
.hoy-acciones200b button{min-height:44px}
.pintado-progresivo200b{content-visibility:auto;contain-intrinsic-size:auto 320px}
.destino-realce200b{outline:3px solid var(--green);outline-offset:2px;transition:outline-color .4s ease}
.search-toggle200b{display:none}
@media(max-width:860px){
.top{flex-wrap:nowrap;padding:6px 10px;gap:6px}
.top>span:first-child .slash,.top #crumb{display:none}
.top .header-counters,.top .badge{display:none}
.top-side{flex-wrap:nowrap;gap:6px;min-width:0}
.top-search{display:none}
.top.busqueda200b .top-search{display:block;position:absolute;top:54px;left:8px;right:8px;z-index:65;background:var(--surface);padding:6px;border:var(--bd);border-radius:var(--r-m)}
.top.busqueda200b .top-search input{width:100%;min-width:0}
.top .icon-button{min-width:44px;min-height:44px}
.search-toggle200b{display:inline-flex}
.scope-menu-btn200b{min-height:44px}
.scope-menu200b{top:56px}
}
/* Salud y ayuda (2.0 · tanda 4) */
.salud-grid200d{display:grid;gap:12px;grid-template-columns:repeat(auto-fit,minmax(290px,1fr));padding:2px}
.salud-grid200d .panel{margin-bottom:0}
.ayuda-cajon200d{margin:0 0 0 auto;height:100%;max-height:100vh;width:min(430px,95vw);border-radius:0}
.ayuda-cajon200d h3{margin:14px 0 4px}

/* Tanda 7B (19 · V3): la tarjeta que pide el gesto de Paco gana
   presencia por REALCE propio (borde y sombra del acento de la
   casa); ninguna otra se atenúa. */
.cmd-card[data-level="rojo"]{border:2px solid var(--danger);box-shadow:var(--shadow-2)}
.cmd-card[data-level="ambar"]{border:2px solid var(--warn-ink);box-shadow:var(--shadow-2)}

/* Limpieza visible (2.0.1): las filas de estado de Hoy reusan
   .cp-row; aquí solo su marco y los retoques propios. */
.hoy-estado201{display:grid;padding:6px 16px 0}
.hoy-estado201 strong{min-width:150px}
.hoy-estado201 span{color:var(--muted)}
.nav-estado201{display:block;font-size:11px;color:var(--nav-muted);font-weight:600}
.decl-grupo201{border-top:1px dashed var(--line);padding-top:10px;margin-top:10px}
.canceladas-efecto201{padding:6px 16px 14px}
