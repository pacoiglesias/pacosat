PACOSAT_DOMAIN=sat.example.com
PACOSAT_LOGIN=operador
PACOSAT_PASSWORD_HASH='REEMPLAZAR_POR_HASH_CADDY'
PACOSAT_PROXY_KEY=REEMPLAZAR_POR_UN_VALOR_ALEATORIO_DE_64_HEX
# Paseo en casa (2.8.0): sede del paseo al portal del SAT (Buzón
# Tributario y Declaraciones) EN ESTA INSTALACIÓN.
#   Sin la variable (o con cualquier valor que no sea 'nas'):
#   sede REMOTA — el paseo lo hace el ejecutor residente en la
#   PC del usuario; es el defecto del producto y el modo de
#   los clientes.
#   PACOSAT_PASEO=nas: el paseo lo hace el servidor de la casa
#   (el NAS) con la e.firma que ya vive en su almacén
#   protegido. SOLO para la instalación propia de Paco en su
#   NAS; no se ofrece a clientes.
#PACOSAT_PASEO=nas
