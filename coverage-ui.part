/* Cobertura de descarga (1.6.4): qué periodos están descargados por RFC y
   sentido, hasta dónde llega la cadena continua («verificado hasta»), los
   huecos entre tramos —con las costuras de ±1 s del blindaje marcadas como
   micro-huecos— y el mapa de calor anual de días cubiertos. Todo sale del
   modelo que el servidor calcula desde las solicitudes y el libro de
   criterios; esta vista no pide nada al SAT. */
let coverageYear = '';
function coverageScreen() {
  if (typeof satToken === 'undefined' || !satToken) {
    const guide = n('section', undefined, 'guide');
    const info = n('div');
    info.append(n('h2', 'La cobertura se calcula en el servidor'),
      n('p', 'El mapa de periodos descargados sale de las solicitudes que guarda el servidor de PacoSAT. Abre la app desde el servidor (el NAS o Iniciar-PacoSAT.cmd) para verlo; en el modo de navegador no hay solicitudes que analizar.'));
    guide.append(info);
    return [guide];
  }
  if (satData.coverage === undefined && !satError) {
    /* Esqueleto mientras llega el primer estado del servidor (1.6.5). */
    const wrap = panel('Cobertura de descarga');
    const skel = n('div', undefined, 'skel');
    skel.setAttribute('aria-busy', 'true');
    skel.setAttribute('aria-label', 'Cargando la cobertura de descarga');
    for (let i = 0; i < 3; i++) skel.append(n('div', undefined, 'skel-block'));
    wrap.append(skel);
    return [wrap];
  }
  const coverage = satData.coverage || { groups: [], gaps: [], days: {} };
  const visible = coverage.groups.filter(group => !scope || group.rfc === scope);
  const screens = [];
  /* Resumen visible (1.11.0): la cobertura se cuenta como la pregunta
     de Paco — qué meses me faltan — desde los huecos que el servidor
     ya calcula, sin pedir nada nuevo al SAT. */
  const missingPanel = panel('Qué meses te faltan');
  const gapList = coverage.gaps.filter(gap => !scope || gap.rfc === scope);
  if (!visible.length && !gapList.length) missingPanel.append(empty('Aún no hay descargas', 'Cuando PacoSAT descargue periodos, aquí verás qué meses tienes y qué meses te faltan.'));
  else {
    const MESES = ['enero', 'febrero', 'marzo', 'abril', 'mayo', 'junio', 'julio', 'agosto', 'septiembre', 'octubre', 'noviembre', 'diciembre'];
    const monthLabel = key => MESES[Number(key.slice(5, 7)) - 1] + ' de ' + key.slice(0, 4);
    const missingByKey = new Map();
    for (const gap of gapList) {
      if (gap.micro) continue;
      const key = gap.rfc + '|' + gap.direction;
      if (!missingByKey.has(key)) missingByKey.set(key, new Set());
      const months = missingByKey.get(key);
      let cursor = gap.from.slice(0, 7), last = gap.to.slice(0, 7), guard = 0;
      while (cursor <= last && guard++ < 120) {
        months.add(cursor);
        const [y, m] = cursor.split('-').map(Number);
        cursor = m === 12 ? (y + 1) + '-01' : y + '-' + String(m + 1).padStart(2, '0');
      }
    }
    const keys = new Set([...visible.map(group => group.rfc + '|' + group.direction), ...missingByKey.keys()]);
    if (!keys.size) missingPanel.append(n('p', 'No te falta ningún mes: en cada RFC y sentido, lo descargado forma una cadena continua.'));
    for (const key of [...keys].sort()) {
      const [rfc, dir] = key.split('|');
      const months = [...(missingByKey.get(key) || [])].sort();
      missingPanel.append(n('p', rfc + ' · ' + (dir === 'received' ? 'Recibidos' : 'Emitidos') + ': ' +
        (months.length ? 'te faltan ' + months.slice(0, 12).map(monthLabel).join(', ') + (months.length > 12 ? '…' : '') + '.' :
          'no te falta ningún mes.')));
    }
  }
  screens.push(missingPanel);
  const table = panel('Qué tengo descargado · por RFC y sentido');
  if (!visible.length) table.append(empty('Sin solicitudes todavía', 'Cuando PacoSAT descargue periodos desde SAT, aquí verás hasta dónde está verificado cada RFC y qué sigue en curso o falló.'));
  else table.append(grid(['RFC', 'Sentido', 'Verificado hasta', 'Tramos cubiertos', 'En curso', 'Fallidos', 'Peticiones agotadas'],
    visible.map(group => [group.rfc, group.direction === 'received' ? 'Recibidos' : 'Emitidos',
      group.verifiedUntil ? group.verifiedUntil.slice(0, 16) : '—', String(group.covered.length),
      String(group.pending), String(group.failed), String(group.exhausted)])));
  screens.push(table);
  const gapsPanel = panel('Huecos sin descargar');
  const gaps = coverage.gaps.filter(gap => !scope || gap.rfc === scope);
  if (!gaps.length) gapsPanel.append(n('p', 'Sin huecos: en cada RFC y sentido, los tramos descargados forman una cadena continua.'));
  else {
    gapsPanel.append(n('p', 'PacoSAT no pide estos tramos por su cuenta: quedan anotados aquí. Con «Solicitar este hueco» el diálogo se abre ya rellenado con el RFC, el sentido y las fechas exactas; si ese periodo ya se pidió antes, PacoSAT ofrece una variante en vez de repetir la misma petición.'));
    const duration = seconds => seconds < 90 ? seconds + ' s' : seconds < 5400 ? Math.round(seconds / 60) + ' min' :
      seconds < 172800 ? (seconds / 3600).toFixed(1).replace('.', ',') + ' h' : Math.round(seconds / 86400) + ' días';
    gapsPanel.append(grid(['RFC', 'Sentido', 'Hueco', 'Duración', 'Tipo', 'Acción'], gaps.map(gap => [gap.rfc,
      gap.direction === 'received' ? 'Recibidos' : 'Emitidos',
      gap.from.slice(0, 10) === gap.to.slice(0, 10) ? gap.from.slice(0, 16) + ' → ' + gap.to.slice(11, 16) :
        gap.from.slice(0, 16) + ' → ' + gap.to.slice(0, 16),
      duration(gap.seconds), gap.micro ? 'Micro-hueco · costura de 1 segundo' : 'Hueco',
      /* El hueco se pide desde la propia pantalla (UX-05): el diálogo
         nace rellenado; los micro-huecos son costuras de ±1 s y no se
         piden (se cosen solos al mover un extremo). */
      gap.micro ? n('span', '—') : action('Solicitar este hueco', () => requestDialog({
        rfc: gap.rfc, direction: gap.direction, start: gap.from.slice(0, 10), end: gap.to.slice(0, 10) }))])));
  }
  screens.push(gapsPanel);
  /* Metadatos (1.6.10): lo que el SAT conoce según las solicitudes
     Metadata y todavía no está en XML — la reconciliación que encuentra
     CFDI perdidos sin gastar descargas completas. */
  const metaPanel = panel('Metadatos del SAT · CFDI sin descargar');
  const meta = satData.metadata || { records: 0, missing: [], lastSeen: null };
  const missing = (meta.missing || []).filter(row => !scope ||
    row.emitter === scope || row.receiver === scope);
  metaPanel.append(n('p', meta.records ?
    number.format(meta.records) + ' registros de metadatos guardados' + (meta.lastSeen ? ' · última lectura ' + localDateTime(meta.lastSeen) : '') +
    '. De ellos, ' + missing.length + ' CFDI constan en el SAT y aún no están en el expediente como XML.' :
    'Todavía no hay metadatos: PacoSAT pide una solicitud Metadata al día por RFC, y también puedes pedir un periodo como Metadatos desde la pestaña de descarga de SAT.'));
  if (missing.length) metaPanel.append(grid(['UUID', 'Emisor', 'Receptor', 'Fecha', 'Total', 'Estado en el SAT'],
    missing.slice(0, 100).map(row => [row.uuid, row.emitter, row.receiver, (row.issuedAt || '').slice(0, 10),
      row.total ? '$' + row.total : '—', row.status === '0' ? 'Cancelado' : 'Vigente'])));
  screens.push(metaPanel);
  const rfcs = [...new Set([...visible.map(group => group.rfc), ...Object.keys(coverage.days)])].filter(rfc => !scope || rfc === scope).sort();
  for (const rfc of rfcs) screens.push(coverageHeatmap(rfc, coverage.days[rfc] || { received: [], issued: [] }));
  return screens;
}
function coverageHeatmap(rfc, daysForRfc) {
  const wrap = panel('Mapa anual de días cubiertos · ' + rfc);
  const received = new Set(daysForRfc.received || []), issued = new Set(daysForRfc.issued || []);
  const years = [...new Set([...received, ...issued].map(date => date.slice(0, 4)))].sort();
  const year = years.includes(coverageYear) ? coverageYear : (years.length ? years[years.length - 1] : String(new Date().getFullYear()));
  if (years.length > 1) {
    const picker = n('div', undefined, 'actions');
    const select = n('select');
    for (const option of years) { const node = n('option', option); node.value = option; select.append(node); }
    select.value = year;
    select.onchange = () => { coverageYear = select.value; render(); };
    picker.append(n('label', 'Año'), select);
    wrap.append(picker);
  }
  if (!received.size && !issued.size) {
    wrap.append(empty('Sin días cubiertos', 'Cuando una solicitud de este RFC termine, sus días se pintan aquí.'));
    return wrap;
  }
  const NS = 'http://www.w3.org/2000/svg';
  const svg = document.createElementNS(NS, 'svg');
  const el = (tag, attrs, text) => {
    const node = document.createElementNS(NS, tag);
    for (const [name, value] of Object.entries(attrs || {})) node.setAttribute(name, value);
    if (text) node.textContent = text;
    return node;
  };
  const cell = 11, pitch = 14, top = 16;
  const jan1 = Date.UTC(Number(year), 0, 1);
  const firstSunday = jan1 - new Date(jan1).getUTCDay() * 86400000;
  const weeks = Math.ceil(((Date.UTC(Number(year), 11, 31) - firstSunday) / 86400000 + 1) / 7);
  svg.setAttribute('viewBox', '0 0 ' + (weeks * pitch + 2) + ' ' + (top + 7 * pitch));
  svg.setAttribute('class', 'hm'); svg.setAttribute('role', 'img');
  svg.setAttribute('aria-label', 'Mapa de calor de días con descarga cubierta en ' + year + ' para ' + rfc);
  svg.append(el('title', {}, 'Días cubiertos en ' + year + ' · ' + rfc));
  const months = ['ene', 'feb', 'mar', 'abr', 'may', 'jun', 'jul', 'ago', 'sep', 'oct', 'nov', 'dic'];
  for (let month = 0; month < 12; month++) {
    const first = Date.UTC(Number(year), month, 1);
    const week = Math.floor((first - firstSunday) / (7 * 86400000));
    svg.append(el('text', { x: week * pitch + 1, y: 10 }, months[month]));
  }
  const detail = n('p', 'Toca un día del mapa para ver su detalle aquí.', 'hm-detail');
  for (let offset = 0; offset < 371; offset++) {
    const date = new Date(firstSunday + offset * 86400000);
    if (date.getUTCFullYear() !== Number(year)) continue;
    const key = date.toISOString().slice(0, 10);
    const level = (received.has(key) ? 1 : 0) + (issued.has(key) ? 1 : 0);
    const rect = el('rect', { x: Math.floor(offset / 7) * pitch + 1, y: top + (offset % 7) * pitch + 1,
      width: cell, height: cell, rx: 2, class: 'hm-l' + level });
    rect.append(el('title', {}, key + ' · recibidos: ' + (received.has(key) ? 'cubierto' : 'sin cubrir') +
      ' · emitidos: ' + (issued.has(key) ? 'cubierto' : 'sin cubrir')));
    /* El detalle por día también con tacto y teclado (UX-26), no solo
       con el tooltip del ratón. */
    rect.style.cursor = 'pointer';
    rect.addEventListener('click', () => {
      detail.textContent = dateLabel(key) + ' · recibidos: ' + (received.has(key) ? 'cubierto' : 'sin cubrir') +
        ' · emitidos: ' + (issued.has(key) ? 'cubierto' : 'sin cubrir');
    });
    svg.append(rect);
  }
  const scroll = n('div', undefined, 'hm-scroll'); scroll.append(svg);
  const legend = n('div', undefined, 'chart-legend');
  const item = (cls, label) => { const span = n('span'); span.append(n('i', undefined, cls), document.createTextNode(label)); return span; };
  legend.append(item('sw-hm0', 'Sin cubrir'), item('sw-hm1', 'Un sentido'), item('sw-hm2', 'Recibidos y emitidos'));
  wrap.append(scroll, legend, detail);
  return wrap;
}
