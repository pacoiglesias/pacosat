/* ===== Lecturas de comunicados fijadas en el panel
   (2.9.14 · punto 6) =====
   Lo que «Leer» trae vive AQUÍ, por folio, fuera de cualquier
   pintado: la lectura tarda ~1 minuto (medido en vivo el 18
   nov: 68,4 s) y el resultado no puede depender de que Paco
   siga mirando esta pantalla cuando el paseo vuelve. Al
   volver, el cuerpo queda fijado en la tarjeta del propio
   comunicado — salir del panel y regresar lo vuelve a pintar
   desde este almacén, sin pedirlo otra vez — y si el paseo
   falla, el motivo queda escrito en la tarjeta, no solo en
   un aviso pasajero. Este almacén es la capa de SESIÓN; el
   respaldo durable es el del SERVIDOR (la tabla
   buzon_lecturas: la vista lo trae como lecturasAqui2914 y
   la tarjeta lo enseña como «Leído aquí» con su «Ver» sin
   paseo) — porque satApi no tiene timeout y la respuesta
   llega si la página sigue viva, pero una pestaña que iOS
   descarta durante el paseo no vuelve nunca: la copia que
   manda es la guardada en la casa. */
const buzonLecturas2914 = new Map();
/* ===== Buzón Tributario del SAT (1.24.0, punto 1) =====
   La bandeja de notificaciones de la AUTORIDAD para el
   contribuyente elegido: la consulta la corre el servidor con la
   e.firma del perfil y SOLO LISTA — fecha, asunto, remitente y
   estado — sin abrir ninguna notificación, porque abrirla puede
   darla por notificada e iniciar plazos. Lo listado queda
   guardado y se consulta aquí (GET /api/tributario?rfc=); lanzar
   es POST /api/tributario/run y cancelar POST
   /api/tributario/cancel, con el diario por pasos en la propia
   pantalla, como en Declaraciones. */
/* ===== Puente en ui.part (2.9.0 · Bloque D) =====
   Este fichero viaja DIFERIDO junto a buzon-ui.part en la
   parte 'buzon'. Su estado compartido (tribCache), sus ayudas
   del primer pintado (tribSinAbrirFor, tribConsultadoFor,
   tribTenidaFor), su talón de distintivo (paintTribBadge), el
   estado único del Buzón (buzonEstado290, buzonMenuTexto202,
   pintarBuzonMenu202, con MESES_MENU202 y fechaCortaMenu202),
   la sede (paseoNasCliente250) y la línea del ejecutor en el
   menú (pintarEjecutorMenu250) viven en el PUENTE de ui.part
   (sección «Puente de la parte diferida Buzón»), en una sola
   copia — aquí no se redeclaran. */
/* ===== Ejecutor local del SAT (1.29.0) =====
   La ejecución contra el portal corre en TU equipo (tu sesión,
   tu IP): PacoSAT encola los trabajos y este panel enseña si el
   ejecutor está en línea, qué espera y qué ya volvió. Emparejar
   crea un token que se enseña UNA vez: vive en tu ejecutor;
   aquí solo queda su huella. El acceso se REVOCA desde este
   panel (H-1.2): el token revocado deja de funcionar al
   instante y re-emparejar crea uno nuevo, nunca revive el
   viejo. Sin ejecutor en línea, los trabajos quedan «esperando
   tu equipo» — nunca un fallo en falso. */
/* Emparejar, en un solo sitio (1.29.1, D5): el botón crea la
   llave y enseña el token UNA vez, con su aviso. Lo usan el
   panel del ejecutor y la guía de Declaraciones. El servidor
   exige administrador: sin serlo, el error se enseña tal cual. */
function executorPairBoton(contenedor, alTerminar, etiqueta) {
  const boton = n('button', etiqueta || 'Emparejar un ejecutor en mi equipo', 'soft executor-pair');
  boton.type = 'button';
  boton.onclick = async () => {
    boton.disabled = true;
    try {
      const creada = await satApi('executor/pair', { nombre: 'Equipo de Paco' });
      const caja = n('div', undefined, 'executor-token');
      caja.append(n('p', 'Token del ejecutor (se enseña una sola vez: cópialo ahora al ejecutor de tu equipo; aquí no queda guardado en claro):', 'today-line'),
        n('code', creada.token));
      contenedor.append(caja);
      toast('Ejecutor emparejado: copia su token ahora, no se vuelve a enseñar.', 'ok');
      if (alTerminar) alTerminar();
    } catch (error) { toast(error.message, 'error'); boton.disabled = false; }
  };
  return boton;
}
/* Código corto para el instalador (1.30.0): 8 caracteres, 10
   minutos, un solo uso; el instalador guarda él solo la llave. */
function executorPairCodeBoton(contenedor) {
  const boton = n('button', 'Código corto para el instalador', 'soft executor-pair');
  boton.type = 'button';
  boton.onclick = async () => {
    boton.disabled = true;
    try {
      const creada = await satApi('executor/pair-code', {});
      const caja = n('div', undefined, 'executor-token');
      caja.append(n('p', 'Código de emparejamiento (caduca en 10 minutos y sirve una sola vez: teclealo en el instalador de tu equipo):', 'today-line'),
        n('code', creada.codigo, 'pair-code'));
      contenedor.append(caja);
      toast('Código creado: teclealo en el instalador de tu equipo antes de que caduque.', 'ok');
    } catch (error) { toast(error.message, 'error'); boton.disabled = false; }
  };
  return boton;
}
/* Guía de espera del ejecutor (1.29.1, D5): estado real y paso
   concreto, en tarjeta. Sin equipo: «Todavía no has emparejado
   ningún equipo», con el gesto de emparejar y qué es el
   ejecutor; emparejado sin latido: «Tu equipo no responde» con
   su última señal. En línea, sin tarjeta. La consume
   Declaraciones con view.ejecutor, de la propia vista. */
function executorGuiaCard(estado, alTerminar) {
  /* Paseo en casa (2.8.0): en sede NAS no hay guía de espera
     del ejecutor — el paseo corre desde casa, no espera a
     ningún equipo. */
  if (paseoNasCliente250()) return null;
  if (!estado || estado.enLinea) return null;
  const box = n('div', undefined, 'aviso-card executor-guia');
  if (!estado.emparejado) {
    box.append(n('strong', 'Todavía no has emparejado ningún equipo'),
      n('p', 'El ejecutor es el programa que corre en tu PC, junto a tu Chrome: PacoSAT le encarga las consultas del SAT y él las navega con tu sesión y tu e.firma. Sin un equipo emparejado, los trabajos del Buzón y de Declaraciones se quedan en cola.'));
    box.append(executorPairBoton(box, alTerminar, 'Emparejar mi equipo'));
    return box;
  }
  /* El estado manda (2.0.1 · nº 31): «está dormido», y el
     gesto de despertarlo EN ESTA tarjeta — «Ejecutar aquí»,
     el enlace local a su equipo. Lo normal es que esté
     despierto solo (residente, con arranque automático):
     esta tarjeta solo existe cuando no responde. */
  box.append(n('strong', 'Tu ejecutor está dormido'),
    n('p', estado.ultimoVisto
      ? 'El ejecutor' + (estado.nombre ? ' «' + estado.nombre + '»' : '') + ' dio señales por última vez el ' + fmtFechaHora(estado.ultimoVisto) + '. Despiértalo aquí y los trabajos en cola saldrán solos.'
      : 'Tu equipo está emparejado, pero el ejecutor aún no ha dado señales. Despiértalo aquí y los trabajos en cola saldrán solos.'));
  if (typeof ejecutarAqui201 === 'function') {
    const actos = n('div', undefined, 'actions');
    actos.append(ejecutarAqui201(true),
      n('span', 'Si el botón no responde, ábrelo con arrancar.bat en tu equipo.', 'muted'));
    box.append(actos);
  }
  return box;
}
/* Línea de estado del ejecutor para el Buzón (1.32.1, B2):
   una franja con su estado real y el salto a su casa. */
function executorStatusLine() {
  const bar = n('div', undefined, 'traffic-strip executor-status-line');
  bar.append(statusPill('dim', 'Ejecutor: leyendo su estado…'));
  const ir = n('button', 'Abrir el Ejecutor local', 'soft');
  ir.type = 'button';
  ir.onclick = () => { satTab = 'ejecutor'; navigate('sat'); };
  /* El botón NO se pinta hasta saber la sede (2.9.0 · Bloque
     C): pintarlo «mientras carga» lo enseñaba también en sede
     NAS, donde abrir el ejecutor no es ningún paso del Buzón.
     En sede remota entra con el resto de la línea al resolver. */
  (async () => {
    try {
      const data = await satApi('executor/overview');
      /* Paseo en casa (2.8.0): la sede viaja en esta misma
         vista (data.paseo) — en sede NAS la línea dice que el
         paseo se hace desde casa y no ofrece el ejecutor como
         paso: el Buzón no espera a ningún equipo. */
      if (data.paseo === 'nas' || paseoNasCliente250()) {
        bar.replaceChildren(statusPill('ok', 'El paseo se hace desde casa (tu NAS)'),
          n('span', 'El Buzón se consulta desde tu NAS, con tu e.firma guardada: tu ejecutor queda como reserva.', 'muted'));
        return;
      }
      const pill = bar.querySelector('.pill, span');
      const hijos = [statusPill(data.enLinea ? 'ok' : 'warn',
        data.enLinea ? 'Ejecutor despierto en tu equipo'
          : !(data.ejecutores || []).some(ex => !ex.revocado) ? 'Ejecutor sin emparejar: las consultas esperan tu equipo'
          : 'Tu ejecutor está dormido: las consultas quedan en cola'), ir];
      /* «Ejecutar aquí» en la misma línea (nº 31): discreto
         si está despierto; el gesto, si está dormido. */
      if (typeof ejecutarAqui201 === 'function' &&
          (data.enLinea || (data.ejecutores || []).some(ex => !ex.revocado)))
        hijos.push(ejecutarAqui201(!data.enLinea));
      bar.replaceChildren(...hijos);
    } catch { /* sin estado legible, la línea no finge nada */ }
  })();
  return bar;
}
function executorPanel() {
  const wrap = panel('Ejecutor local del SAT',
    /* Paseo en casa (2.8.0): el panel sigue entero (paridad:
       es la reserva y el modo de los clientes), pero en sede
       NAS su cabecera dice la verdad de esta instalación. */
    paseoNasCliente250()
      ? 'Tu ejecutor queda como reserva en esta instalación: el Buzón y las Declaraciones se pasean desde casa, desde tu NAS, con la e.firma guardada. PacoSAT ordena, registra y archiva lo que vuelve verificado.'
      : 'Las consultas del Buzón y de Declaraciones se navegan desde tu equipo, con tu sesión de e.firma por RFC. PacoSAT ordena, registra y archiva lo que vuelve verificado.');
  wrap.dataset.destino200b = 'ejecutor';
  const body = n('div');
  wrap.append(body);
  /* Sin servidor (1.29.1, D6 — su casa desde la 2.8.0 es ESTA
     pantalla, diseño 20): la entrada del ejecutor dice qué
     falta en vez de desaparecer. */
  if (typeof satToken === 'undefined' || !satToken) {
    body.append(n('p', 'El ejecutor se empareja y se consulta desde el servidor de tu casa (el NAS): abre PacoSAT desde el servidor para ver su estado, su cola y emparejar tu equipo.'));
    return wrap;
  }
  const pintar = data => {
    body.replaceChildren();
    const activos = (data.ejecutores || []).filter(ex => !ex.revocado);
    /* Verdad de sede (2.9.0 · Bloque C): en sede NAS este
       destino es una tarjeta INFORMATIVA — el paseo se hace
       desde casa y el ejecutor de PC no se usa: nada de
       «dormido», nada de despertar, ningún estado acusatorio.
       El emparejamiento sigue abajo, como reserva que es. */
    const sedeNas290 = data.paseo === 'nas' || paseoNasCliente250();
    const bar = n('div', undefined, 'traffic-strip');
    if (sedeNas290) {
      bar.append(statusPill('ok', 'El paseo se hace desde casa (tu NAS)'));
      body.append(bar);
      body.append(n('p', 'En esta instalación los paseos los hace el NAS desde casa; el ejecutor de PC no se usa. ' +
        'Su estado no detiene ningún paseo: el Buzón y las Declaraciones se consultan desde el NAS con la e.firma guardada. ' +
        'El ejecutor queda como reserva por si algún día cambias la sede.', 'muted'));
    } else {
      bar.append(statusPill(data.enLinea ? 'ok' : 'warn',
        data.enLinea ? 'Ejecutor despierto en tu equipo'
          : !activos.length ? 'Todavía no has emparejado ningún equipo'
          : 'Tu ejecutor está dormido'));
      if (data.enCola) bar.append(statusPill('warn', number.format(data.enCola) + ' en cola'));
      if (data.enCurso) bar.append(statusPill('dim', number.format(data.enCurso) + ' en curso'));
      /* Despierto: «Abrir ejecutor» discreto en la misma franja
         (nº 31). Dormido: el botón va con su explicación, abajo. */
      if (data.enLinea && typeof ejecutarAqui201 === 'function') bar.append(ejecutarAqui201(false));
      body.append(bar);
    }
    /* La guía de la espera, también en el panel (1.29.1, D5):
       qué es el ejecutor y qué paso toca, no solo la pastilla.
       En sede NAS no hay guía de espera: no se espera a nadie. */
    if (!sedeNas290 && !data.enLinea && !activos.length)
      body.append(n('p', 'El ejecutor es el programa que corre en tu PC, junto a tu Chrome: PacoSAT le encarga las consultas del SAT y él las navega con tu sesión y tu e.firma. Empareja tu equipo con el botón de abajo y los trabajos en cola saldrán solos.', 'muted'));
    else if (!sedeNas290 && !data.enLinea) {
      const ultimo = activos.reduce((max, ex) => Math.max(max, Number(ex.ultimoVisto) || 0), 0);
      body.append(n('p', ultimo
        ? 'Última señal de tu equipo: ' + fmtFechaHora(ultimo) + '. Lo normal es que esté despierto solo (arranca con tu equipo); si está cerrado, despiértalo aquí y los trabajos en cola saldrán solos.'
        : 'Tu equipo está emparejado, pero el ejecutor aún no ha dado señales: despiértalo aquí y los trabajos en cola saldrán solos.', 'muted'));
      /* El gesto de despertarlo, en su propia vista (nº 31). */
      if (typeof ejecutarAqui201 === 'function') {
        const actos = n('div', undefined, 'actions');
        actos.append(ejecutarAqui201(true),
          n('span', 'Si el botón no responde, ábrelo con arrancar.bat en tu equipo.', 'muted'));
        body.append(actos);
      }
    }
    /* Un equipo, una fila (2.9.0 · Bloque C dedup de
       revocados; 2.9.13 · A7 lo completa): TODOS los accesos
       del mismo equipo — vivos, dormidos y revocados — se
       enseñan en UNA fila con su cuenta («×N»), su estado más
       fresco y UN solo «Revocar acceso» que apaga todos sus
       accesos vivos. La auditoría en vivo vio el mismo equipo
       tres veces con dos botones de revocar. */
    const gruposEjecutor2913 = new Map();
    for (const ex of data.ejecutores || []) {
      const clave = ex.nombre || 'Ejecutor';
      const lista = gruposEjecutor2913.get(clave) || [];
      lista.push(ex);
      gruposEjecutor2913.set(clave, lista);
    }
    for (const [nombre2913, grupo2913] of gruposEjecutor2913) {
      const vivos2913 = grupo2913.filter(ex => !ex.revocado);
      const fresco2913 = grupo2913.reduce((a, b) =>
        (Number(b.ultimoVisto) || 0) > (Number(a.ultimoVisto) || 0) ? b : a, grupo2913[0]);
      const row = n('div', undefined, 'cp-row');
      row.append(n('span', nombre2913 + (grupo2913.length > 1 ? ' ×' + grupo2913.length : '') + ' · ' + (!vivos2913.length
        ? 'acceso REVOCADO: su token ya no funciona'
        : vivos2913.some(ex => ex.enLinea)
          ? 'en línea (visto ' + (typeof fmtFechaHora === 'function' ? fmtFechaHora(fresco2913.ultimoVisto) : '') + ')'
          : 'sin conexión desde ' + (fresco2913.ultimoVisto ? (typeof fmtFechaHora === 'function' ? fmtFechaHora(fresco2913.ultimoVisto) : '') : 'nunca'))));
      /* Revocar (1.29.0, H-1.2): si el equipo se pierde o el token
         se filtra, este gesto lo apaga al instante; los trabajos
         en curso vuelven a la cola y el gesto queda en el
         Registro. Re-emparejar crea un token nuevo. */
      if (vivos2913.length) {
        const revocar = n('button', 'Revocar acceso', 'soft small');
        revocar.type = 'button';
        revocar.onclick = async () => {
          /* Confirmación con el diálogo propio (2.9.7 · D4): el
             mismo patrón que la revocación de llaves API de la
             2.9.5 — fuera la confirmación nativa del navegador. */
          dialog('Revocar el acceso',
            [n('p', '¿Revocar el acceso de «' + nombre2913 + '»? Su token dejará de funcionar al instante y sus trabajos en curso volverán a la cola. Podrás emparejar el equipo de nuevo cuando quieras.')],
            async () => {
              revocar.disabled = true;
              try {
                for (const ex of vivos2913) await satApi('executor/revoke', { id: ex.id });
                toast('Acceso revocado: ese token ya no funciona.', 'ok');
                pintar(await satApi('executor/overview'));
              } catch (error) { toast(error.message, 'error'); revocar.disabled = false; }
            }, 'Revocar');
        };
        row.append(revocar);
      }
      body.append(row);
    }
    /* Un trabajo, un sitio (2.0 · tanda 2, corrección 3): la
       pestaña Ejecutor ya NO lista los trabajos como tercera
       copia accionable — enseña la cola como CONTEO y enlaza
       a las tarjetas, que son el sitio dueño de cada trabajo
       (su estado, su progreso y su Cancelar viven allí). */
    {
      const vivos = (data.trabajos || []).filter(j => ['en-cola', 'reclamado', 'en-curso'].includes(j.estado));
      const row = n('div', undefined, 'cp-row');
      /* Qué cuenta cada contador, dicho en su sitio (2.9.0 ·
         Bloque C): esta cola es SOLO la del ejecutor (trabajos
         que una PC recogería); la tarjeta de actividad cuenta
         las solicitudes en espera de TODO el sistema — no son
         el mismo número y ya no se contradicen en silencio. */
      row.append(n('span', 'Cola de trabajos: ' + number.format(vivos.length) +
        (vivos.length === 1 ? ' trabajo vivo' : ' trabajos vivos') +
        ' — es la cola del ejecutor: los trabajos que una PC recogería. La tarjeta de actividad cuenta aparte las solicitudes en espera de todo el sistema.'));
      /* Sin botón «Ver en su tarjeta» (2.3.2 · m-17): su único
         efecto era desplazar hasta la parrilla de trámites de
         esta misma pantalla. La parrilla y los trabajos quedan
         intactos; el conteo de la cola se queda como texto. */
      body.append(row);
    }
    /* Contextual (2.0, 2.6): con un equipo ya emparejado, el
       emparejar pasa a ser la acción secundaria «Emparejar otro
       equipo»; ofrecer «emparejar» a secas fingía que no hay
       ninguno. Sin ninguno, la oferta principal es la de siempre. */
    body.append(activos.length ? executorPairBoton(body, undefined, 'Emparejar otro equipo') : executorPairBoton(body));
    body.append(executorPairCodeBoton(body));
  };
  (async () => {
    try { pintar(await satApi('executor/overview')); }
    catch (error) { body.replaceChildren(n('p', error.message, 'error-text')); }
  })();
  return wrap;
}
/* (3.2.0 · pieza 42) Calendario de plazos del mes en curso
   (.cal320), con SOLO fechas que constan:
   (a) Buzón Tributario — por cada notificación viva sin abrir
   de ESTA vista, su plazo.tenida si cae en el mes en curso.
   El plazo lo calcula el servidor con la regla escrita de
   buzonPlazo (arts. 134-I y 135 del CFF); el color es la
   distancia a hoy con los umbrales de la pieza 22: rojo con
   1 día o menos (o ya vencida), ámbar con 3 o menos, verde
   más lejos.
   (b) Bancos — SOLO en la ventana de recordatorio (días
   1–10): el dato es satData.estadosPendientes, el mismo que
   alimentan Hoy y Administración, ya cercado por el
   servidor. El día de HOY se marca ámbar (rojo el día 10,
   último de la ventana) si falta algún estado del mes
   anterior de este RFC o sin dueño; verde si no falta
   ninguno. Fuera de la ventana, de Bancos no se marca nada.
   Cada marca nombra su origen en su título y en la leyenda
   de debajo del mes: nada se pinta sin decir de dónde sale. */
function tribCalendario320(data, rfc) {
  const MESES320 = ['enero', 'febrero', 'marzo', 'abril', 'mayo', 'junio', 'julio',
    'agosto', 'septiembre', 'octubre', 'noviembre', 'diciembre'];
  const mesLargo320 = key => {
    const m = /^(\d{4})-(\d{2})$/.exec(String(key || ''));
    return m ? MESES320[Number(m[2]) - 1] + ' de ' + m[1] : String(key || '');
  };
  const ahora = new Date();
  const anio = ahora.getFullYear(), mes = ahora.getMonth(), hoyDia = ahora.getDate();
  const hoyMed = new Date(anio, mes, hoyDia, 12).getTime();
  const marcas = new Map();
  const marcar = (dia, nivel, texto) => {
    const prev = marcas.get(dia);
    if (!prev) { marcas.set(dia, { nivel, textos: [texto] }); return; }
    prev.textos.push(texto);
    if (nivel === 'bad' || (nivel === 'warn' && prev.nivel === 'ok')) prev.nivel = nivel;
  };
  for (const item of data.notificaciones || []) {
    if (item.abierta || item.archivada || !item.plazo?.tenida) continue;
    const [ty, tm, td] = String(item.plazo.tenida).slice(0, 10).split('-').map(Number);
    if (ty !== anio || tm !== mes + 1) continue;
    const fin = Date.parse(String(item.plazo.tenida) + 'T12:00:00');
    const quedan = Number.isFinite(fin) ? Math.round((fin - hoyMed) / 86400000) : null;
    marcar(td, quedan !== null && quedan <= 1 ? 'bad' : quedan !== null && quedan <= 3 ? 'warn' : 'ok',
      'Buzón Tributario: «' + (item.asunto || 'Notificación del SAT') + '» se tiene por notificada el ' +
        declFechaLarga(item.plazo.tenida) + ' aunque nadie la abra (último día para abrirla: ' +
        declFechaLarga(item.plazo.limite) + ').');
  }
  const ep = typeof satData !== 'undefined' && satData ? satData.estadosPendientes : null;
  if (ep?.enVentana && ep.mesAnterior) {
    const faltan = (ep.faltantes || []).filter(f => !f.rfc || f.rfc === rfc);
    if (faltan.length)
      marcar(hoyDia, hoyDia >= 10 ? 'bad' : 'warn',
        'Bancos: falta el estado de ' + mesLargo320(ep.mesAnterior) + ' de ' +
          faltan.map(f => f.banco + ' · ' + f.nombre).join('; ') + ' — súbelo en Bancos.');
    else marcar(hoyDia, 'ok',
      'Bancos: los estados de ' + mesLargo320(ep.mesAnterior) + ' de este RFC ya constan.');
  }
  if (!marcas.size) return null;
  const box = panel('Calendario de plazos · ' + MESES320[mes] + ' de ' + anio);
  box.dataset.calendario320 = '1';
  const cal = n('div', undefined, 'cal320');
  for (const ini of ['L', 'M', 'X', 'J', 'V', 'S', 'D']) cal.append(n('span', ini, 'cal-cab320'));
  const primero = (new Date(anio, mes, 1).getDay() + 6) % 7;
  for (let i = 0; i < primero; i++) cal.append(n('span', '', 'dia cal-vacio320'));
  const diasMes = new Date(anio, mes + 1, 0).getDate();
  for (let d = 1; d <= diasMes; d++) {
    const celda = n('span', String(d), 'dia');
    const marca = marcas.get(d);
    if (marca) {
      celda.classList.add(marca.nivel === 'bad' ? 'con-rojo' : marca.nivel === 'warn' ? 'con-ambar' : 'con-verde');
      celda.title = marca.textos.join(' ');
    }
    if (d === hoyDia) celda.classList.add('cal-hoy320');
    cal.append(celda);
  }
  box.append(cal);
  const leyenda = n('div', undefined, 'cal-leyenda320');
  for (const [dia, marca] of [...marcas.entries()].sort((a, b) => a[0] - b[0]))
    for (const texto of marca.textos) leyenda.append(n('p', dia + ' · ' + texto, 'muted'));
  box.append(leyenda);
  return box;
}
function tributarioScreen() {
  const wrap = n('div');
  if (typeof satToken === 'undefined' || !satToken) {
    wrap.append(panel('Buzón Tributario', 'El Buzón Tributario se consulta desde el servidor de tu casa (el NAS): abre PacoSAT desde el servidor para ver las notificaciones del SAT.'));
    /* (2.8.0 · diseño 20) El panel del ejecutor sale del Buzón
       también sin servidor (antes, 1.29.1 D6, quedaba aquí una
       tarjeta suya): el ejecutor vive en su pantalla «Tu
       ejecutor» — entrada propia del menú — y su estado, en la
       línea de estado de Hoy. El Buzón es del Buzón. */
    return [wrap];
  }
  const head = panel('Buzón Tributario · ' + (scope || 'sin contribuyente'),
    'Las notificaciones que el SAT deja en su buzón oficial para este RFC. PacoSAT solo las LISTA: no abre ninguna, porque abrirla puede darla por notificada e iniciar plazos. Abrirlas es tu gesto, en el portal oficial.');
  head.dataset.destino200b = 'buzon';
  head.classList.add('protagonista280'); /* (2.8.0 · diseño 7) */
  const body = n('div');
  head.append(body);
  wrap.append(head);
  /* El ejecutor NO vive en esta pantalla (1.32.1, B2): su casa
     es Centro SAT › Ejecutor local. Aquí queda una línea de
     estado con su enlace — si el equipo no responde, la
     consulta lo nota y lo dice, sin apilar la sala de máquinas
     entera sobre el Buzón en cada visita. */
  wrap.append(executorStatusLine());
  if (!scope) {
    /* (3.2.0 · pieza 6) El vacío sin RFC, con su clase. */
    const vacioTrib320 = empty('Elige un contribuyente', 'El Buzón Tributario es por RFC: elige arriba el contribuyente cuyas notificaciones quieres consultar.');
    vacioTrib320.classList.add('vacio320');
    body.append(vacioTrib320);
    return [wrap];
  }
  const rfc = scope;
  let running = false;
  let verArchivadas = false;
  let verPapelera = false;
  let relojStop290 = null;
  let poller = null;
  const stopPoller = () => { if (poller) { clearInterval(poller); poller = null; } };
  const paint = data => {
    tribCache = data;
    if (typeof satData !== 'undefined' && satData) {
      satData.tributario = satData.tributario || {};
      if (data.total || data.ultimaConsulta) satData.tributario[rfc] = { total: data.total || 0, sinAbrir: data.sinAbrir || 0,
        ultimaConsulta: data.ultimaConsulta || null,
        proximaTenida: data.proximaTenida || null };
    }
    paintTribBadge();
    /* La entrada del menú enseña el mismo estado (2.0.2): se
       repinta con ESTA vista, sin otra lectura. 3.1.0: solo si
       el RFC de esta vista sigue siendo el de la pantalla — la
       insignia es del ámbito, no de la última vista abierta. */
    const menuBuzon202 = document.getElementById('buzon-menu-estado202');
    if (menuBuzon202 && (typeof scope === 'undefined' || !scope || scope === rfc))
      menuBuzon202.textContent = buzonMenuTexto202(data);
    body.replaceChildren();
    const progreso = data.progreso || {};
    const isRunning = running || Boolean(progreso.running);
    /* Semáforo y modelo único de problema: de quién es (del SAT),
       qué significa y el gesto único (Consultar / Abrir en el
       portal oficial). */
    const bar = n('div', undefined, 'traffic-strip');
    if (isRunning) bar.append(statusPill('warn', 'Consultando el buzón…'));
    else if (!data.ultimaConsulta && !data.total) bar.append(statusPill('dim', 'Sin consultar todavía'));
    else if (data.sinAbrir) bar.append(statusPill('warn', number.format(data.sinAbrir) + ' sin abrir'));
    else bar.append(statusPill('ok', 'Sin notificaciones pendientes'));
    const consultar = n('button', isRunning ? 'Consultando…' : 'Consultar ahora', 'primary trib-consultar');
    consultar.type = 'button';
    consultar.disabled = isRunning;
    consultar.onclick = () => run();
    bar.append(consultar);
    if (isRunning) {
      const cancelar = n('button', 'Cancelar', 'soft');
      cancelar.type = 'button';
      cancelar.onclick = async () => {
        cancelar.disabled = true;
        try { await satApi('tributario/cancel', { rfc }); toast('Cancelación pedida: la consulta se detiene en segundos, en el punto seguro en el que esté.', 'ok'); }
        catch (error) { toast(error.message, 'error'); cancelar.disabled = false; }
      };
      bar.append(cancelar);
    }
    body.append(bar);
    /* Paso VIVO y reloj honesto (2.9.0 · bloque B, pieza 3): el
       paso que se ve es el detail vivo de la entrada de actividad
       de este RFC — el último que el servidor narra, con sus
       reintentos — y junto a él, el tiempo transcurrido desde su
       since real, repintado cada segundo SOLO en esa línea. Sin
       entrada de actividad legible, manda el paso de la vista. */
    if (relojStop290) { relojStop290(); relojStop290 = null; }
    if (isRunning) {
      const vivo290 = typeof pasoVivo290 === 'function' ? pasoVivo290('tributario', rfc) : null;
      const paso290 = String(vivo290?.detail || progreso.step || 'Consultando el buzón…');
      const linea290 = n('p', undefined, 'today-line paso-vivo290');
      linea290.append(n('span', paso290, 'paso-vivo-texto290'));
      const reloj290 = n('span', '', 'foco-reloj290');
      reloj290.dataset.reloj290 = 'tributario';
      linea290.append(document.createTextNode(' · '), reloj290);
      body.append(linea290);
      const desde290 = Number(vivo290?.since) || Number(progreso.at) || 0;
      if (desde290 && typeof relojTranscurrido290 === 'function')
        relojStop290 = relojTranscurrido290(reloj290, desde290);
    }
    /* (2.9.9 · D5) Los párrafos explicativos del Buzón viven
       tras un «Ver más»: la lista manda en la cara y el texto
       íntegro queda a un toque, en este mismo desplegable. */
    let ayuda299 = null;
    const parrafoAyuda299 = texto => {
      if (!ayuda299) {
        ayuda299 = n('details', undefined, 'seal-details');
        ayuda299.append(n('summary', 'Ver más · Cómo funciona este buzón'));
        body.append(ayuda299);
      }
      ayuda299.append(n('p', texto, 'today-line'));
    };
    if (data.sinAbrir)
      parrafoAyuda299('Son notificaciones de la autoridad para ' + rfc + '. PacoSAT te las enseña en lista; ' +
        'para leer su contenido entra tú al portal oficial del SAT y ábrelas allí: ese gesto puede iniciar sus plazos.');
    /* El plazo corre aunque nadie abra (1.27.0): la fecha en que
       la más antigua se tiene por notificada va en voz alta —
       no abrir NO congela nada (arts. 134-I y 135 del CFF). */
    if (data.sinAbrir && data.proximaTenida)
      body.append(n('p', '⏰ No abrirlas no congela el plazo: la más antigua se tiene por notificada el ' +
        declFechaLarga(data.proximaTenida.tenida) + ' aunque nadie la abra' +
        ' (ábrela tú antes del ' + declFechaLarga(data.proximaTenida.limite) + '; efectos desde el ' +
        declFechaLarga(data.proximaTenida.efectos) + ').', 'today-line'));
    else if (data.ultimaConsulta)
      body.append(n('p', 'Última consulta: ' + buzonCuando(data.ultimaConsulta) + ' · ' +
        number.format(data.total || 0) + ' notificación(es) en la bandeja.', 'today-line'));
    /* Comunicados (2.0.1): el conteo de «Mis comunicados» sin
       leer que la última consulta buena leyó de los encabezados
       de grupo — sin abrir ningún mensaje —, con la fecha de
       esa consulta. Si ninguna corrida lo ha leído aún, no se
       pinta nada: no se inventa el dato. */
    if (data.comunicadosNoLeidos !== null && data.comunicadosNoLeidos !== undefined && data.comunicadosFecha)
      body.append(n('p', 'Comunicados: ' + (data.comunicadosNoLeidos === 0 ? 'ninguno sin leer' :
        number.format(data.comunicadosNoLeidos) + ' sin leer') +
        ' (contados en la consulta del ' + buzonCuando(data.comunicadosFecha) + ', sin abrir ninguno).', 'today-line'));
    /* (3.2.0 · pieza 42) El calendario de plazos del mes en
       curso, tras el resumen y antes de las bandejas. */
    const cal320 = tribCalendario320(data, rfc);
    if (cal320) body.append(cal320);
    /* Buzón completo, la lista (2.9.4): las secciones que la
       última consulta buena LISTÓ — «Mis comunicados» con
       cada mensaje (su asunto, su fecha y su folio, sin
       abrir ninguno) y «Mis documentos» con su lista — con
       la misma dignidad que la bandeja de notificaciones:
       lo que la consulta trajo se enseña aquí; la sección
       que no concluyó se dice con su motivo, no se esconde
       ni se finge vacía. */
    const completo294 = data.buzonCompleto240 || null;
    /* ===== Buzón rediseñado (2.9.13 · Bloque B): los
       comunicados sin leer son TARJETAS con su «Leer» — el
       gesto que Paco pidió: al tocarlo, el sistema va al
       Buzón, abre ESE comunicado y enseña su cuerpo como
       documento aquí dentro. Los leídos van agrupados por
       hilo (mismo folio: el «Registro…» con su «Respuesta…»),
       plegados. Las NOTIFICACIONES de abajo no cambian: se
       listan sin abrir, sin botón de abrir (reloj legal). El
       «leído» de cada tarjeta lo dice el SAT en la siguiente
       consulta: aquí no se finge ninguna marca local. */
    /* El documento de un comunicado abierto: su cabecera y su
       cuerpo como documento — y, si el cuerpo era un puntero
       y la visita siguió su enlace (2.9.14 · punto 7), el
       detalle enlazado debajo, con su nombre propio o con lo
       que el destino ES en palabras llanas —. Lo usan el
       diálogo del momento y la tarjeta fijada: un solo
       documento, dos sitios. */
    const comunicadoDoc2914 = (res, msg) => {
      const cab = n('div', undefined, 'trib-com-doc2913-cab');
      cab.append(n('strong', res.asunto || msg.asunto || 'Comunicado del SAT'));
      cab.append(n('p', (res.fecha || msg.fecha || '') +
        (res.folio ? ' · Folio ' + res.folio : '') + ' · Buzón Tributario del SAT', 'today-line'));
      const cuerpo = n('div', undefined, 'trib-com-doc2913');
      for (const linea of String(res.cuerpo || '').split(/\n+/))
        if (linea.trim()) cuerpo.append(n('p', linea.trim()));
      if (!cuerpo.childNodes.length) cuerpo.append(n('p', 'El SAT enseñó este comunicado sin texto.'));
      const det = res.detalleEnlace || null;
      if (det) {
        cuerpo.append(n('strong', 'El detalle que enlaza este comunicado:'));
        if (det.estado === 'texto') {
          const lineasDet = String(det.texto || '').split(/\n+/).filter(l => l.trim());
          for (const linea of lineasDet) cuerpo.append(n('p', linea.trim()));
          if (!lineasDet.length) cuerpo.append(n('p', 'La página enlazada no enseñó texto.'));
        } else if (det.estado === 'formulario')
          cuerpo.append(n('p', 'La página que enlaza es un formulario del portal: se rellena allí, con tu gesto — su contenido no se trae.'));
        else if (det.estado === 'descarga')
          cuerpo.append(n('p', 'El enlace de este comunicado descarga un archivo: no se trae su contenido.'));
        else
          cuerpo.append(n('p', 'La página que enlaza no cargó en esta visita: no consta su contenido.'));
      }
      return [cab, cuerpo];
    };
    /* La zona de la lectura DENTRO de la tarjeta (2.9.14 ·
       punto 6): la marcha con su fase y su reloj y el aviso
       llano de duración, el documento fijado con su «Cerrar»
       que lo repliega, o el motivo del fallo escrito. Se
       compone desde el almacén de la parte: cualquier
       repintado — salir del panel y volver incluidos — la
       recompone tal cual, sin pedir nada otra vez. */
    const lecturaZona2914 = (msg, lectura) => {
      const zona = n('div', undefined, 'trib-com-doc2913');
      zona.dataset.buzonLectura2914 = msg.folio;
      if (lectura.estado === 'guardada') {
        /* La copia del SERVIDOR (2.9.14 · punto 6, con
           respaldo): este comunicado ya se leyó aquí y su
           cuerpo vive en el almacén de la casa — la tarjeta
           lo nombra «Leído aquí» y su «Ver» lo despliega
           DESDE ESE ALMACÉN, sin paseo nuevo: instantáneo y
           a prueba de cortes. Su «leído» ante el SAT sigue
           siendo el que diga el SAT: la copia se nombra como
           lo que es, nunca como marca oficial. */
        const linea = n('p', undefined, 'today-line');
        linea.append(statusPill('ok', 'Leído aquí'));
        linea.append(n('span', 'Se leyó aquí' +
          (lectura.leidoAquiEn && typeof fmtFechaHora === 'function'
            ? ' el ' + fmtFechaHora(lectura.leidoAquiEn) : '') +
          ' y su texto quedó guardado en PacoSAT. Su «leído» ante el SAT lo dirá el SAT en la próxima consulta.'));
        zona.append(linea);
        const ver = n('button', 'Ver', 'soft small');
        ver.type = 'button';
        ver.dataset.buzonLecturaVer2914 = '1';
        ver.onclick = () => {
          buzonLecturas2914.set(msg.folio, { estado: 'ok', asunto: lectura.asunto || '',
            fecha: lectura.fecha || '', folio: msg.folio, cuerpo: lectura.cuerpo || '',
            detalleEnlace: lectura.detalleEnlace || null });
          if (body.isConnected) paint(data);
        };
        zona.append(ver);
      } else if (lectura.estado === 'leyendo') {
        const linea = n('p', undefined, 'today-line');
        linea.append(n('span', 'Leyendo en el Buzón…'));
        const reloj = n('span', '', 'foco-reloj290');
        linea.append(document.createTextNode(' · '), reloj);
        zona.append(linea);
        zona.append(n('p', 'Tarda alrededor de un minuto: PacoSAT está entrando al Buzón y abriendo este comunicado por ti. Puedes irte a otra pantalla: al volver, el comunicado quedará abierto aquí, en su tarjeta.', 'today-line'));
        if (typeof relojTranscurrido290 === 'function')
          relojTranscurrido290(reloj, lectura.since || Date.now());
      } else if (lectura.estado === 'ok') {
        for (const el of comunicadoDoc2914(lectura, msg)) zona.append(el);
        const cerrar = n('button', 'Cerrar', 'soft small');
        cerrar.type = 'button';
        cerrar.dataset.buzonLecturaCerrar2914 = '1';
        cerrar.onclick = () => { buzonLecturas2914.delete(msg.folio); if (body.isConnected) paint(data); };
        zona.append(cerrar);
      } else {
        zona.append(n('p', 'No se pudo leer este comunicado: ' + (lectura.error || 'sin detalle'), 'error-text'));
        const cerrar = n('button', 'Quitar aviso', 'soft small');
        cerrar.type = 'button';
        cerrar.dataset.buzonLecturaCerrar2914 = '1';
        cerrar.onclick = () => { buzonLecturas2914.delete(msg.folio); if (body.isConnected) paint(data); };
        zona.append(cerrar);
      }
      return zona;
    };
    const leerComunicado2913 = async (msg, boton) => {
      /* (2.9.14 · punto 6) La marcha se VE y el resultado no
         se pierde. El defecto en vivo (18 nov, 22:04): Paco
         tocó «Leer» y «no desplegó nada» — la ruta SÍ
         funcionaba (la misma llamada devolvió el cuerpo en
         68,4 s), pero durante ese minuto la única señal era
         el botón en «Leyendo…» y el cuerpo solo vivía en un
         diálogo del momento: si cambiaba de pantalla, la
         respuesta no se pintaba nunca y no quedaba rastro.
         Ahora el estado vive en el almacén de la parte y la
         tarjeta lo pinta: fase y reloj mientras lee, el
         documento fijado al volver — también tras salir y
         regresar — y el motivo escrito si el paseo falla.
         El diálogo del momento se conserva, pero ya no es el
         único sitio donde el cuerpo existe. */
      buzonLecturas2914.set(msg.folio, { estado: 'leyendo', since: Date.now() });
      if (body.isConnected) paint(data);
      try {
        const res = await satApi('buzon/comunicado', { rfc, folio: msg.folio });
        if (!res?.ok) throw new Error(res?.error || 'El SAT no enseñó el cuerpo de este comunicado.');
        buzonLecturas2914.set(msg.folio, { estado: 'ok', asunto: res.asunto || '',
          fecha: res.fecha || '', folio: res.folio || msg.folio, cuerpo: res.cuerpo || '',
          detalleEnlace: res.detalleEnlace || null });
        if (body.isConnected) {
          paint(data);
          /* El diálogo es la cortesía del momento: si algo
             fallara al enseñarlo, el documento ya quedó
             fijado en la tarjeta — no se marca error una
             lectura que sí llegó. */
          try {
            dialog('Comunicado del SAT', comunicadoDoc2914(res, msg), null);
            toast('Comunicado abierto: queda fijado en su tarjeta. En la lista seguirá «sin leer» hasta que la próxima consulta lo lea del SAT.', 'ok');
          } catch { /* el documento fijado en la tarjeta manda */ }
        }
      } catch (error) {
        buzonLecturas2914.set(msg.folio, { estado: 'error',
          error: String(error?.message || error || 'sin detalle') });
        if (body.isConnected) paint(data);
        toast(error.message, 'error');
      }
    };
    if (completo294?.comunicados) {
      const secCom294 = completo294.comunicados;
      const itemsCom2913 = secCom294.concluyente ? (secCom294.items || []) : [];
      const sinLeer2913 = itemsCom2913.filter(m => !m.leido);
      const leidos2913 = itemsCom2913.filter(m => m.leido);
      const headCom2913 = n('div', undefined, 'trib-sec-head2913');
      headCom2913.append(n('strong', 'Mis comunicados'));
      headCom2913.append(statusPill(sinLeer2913.length ? 'warn' : 'ok',
        secCom294.concluyente
          ? (sinLeer2913.length ? number.format(sinLeer2913.length) + ' sin leer' : 'Ninguno sin leer')
          : 'Sin constar en esta consulta'));
      body.append(headCom2913);
      if (secCom294.concluyente && itemsCom2913.length) {
        for (const msg294 of sinLeer2913) {
          const card294 = n('div', undefined, 'trib-com-card2913');
          const main294 = n('div', undefined, 'cp-main');
          main294.append(n('strong', msg294.asunto || 'Comunicado del SAT'));
          main294.append(n('p', (msg294.fecha || '') + (msg294.folio ? ' · Folio ' + msg294.folio : ''), 'today-line'));
          card294.append(main294);
          if (msg294.folio) {
            const leer294 = n('button', 'Leer', 'primary small trib-com-leer2913');
            leer294.type = 'button';
            leer294.onclick = () => leerComunicado2913(msg294, leer294);
            /* (2.9.14 · punto 6) La lectura de ESTE comunicado
               se pinta en su tarjeta: en marcha (botón en
               «Leyendo…» y la zona con su fase y su reloj),
               fijada al volver, con su motivo escrito si el
               paseo falló — o, si el SERVIDOR ya guarda su
               copia de una lectura anterior, como «Leído
               aquí» con su «Ver» sin paseo (el respaldo que
               sobrevive a pestañas muertas y páginas nuevas:
               el almacén de sesión solo no bastaba). */
            const lectura294 = buzonLecturas2914.get(msg294.folio) ||
              (data.lecturasAqui2914?.[msg294.folio]
                ? { estado: 'guardada', ...data.lecturasAqui2914[msg294.folio] } : null);
            if (lectura294?.estado === 'leyendo') {
              leer294.disabled = true;
              leer294.textContent = 'Leyendo…';
            }
            card294.append(leer294);
            if (lectura294) card294.append(lecturaZona2914(msg294, lectura294));
          }
          body.append(card294);
        }
        if (leidos2913.length) {
          const hilos2913 = new Map();
          for (const msg294 of leidos2913) {
            const clave = msg294.folio || ('sin-folio-' + (msg294.asunto || ''));
            const lista = hilos2913.get(clave) || [];
            lista.push(msg294);
            hilos2913.set(clave, lista);
          }
          for (const [clave2913, hilo2913] of hilos2913) {
            if (hilo2913.length === 1) {
              const msg294 = hilo2913[0];
              const row294 = n('div', undefined, 'cp-row trib-row');
              row294.append(statusPill('dim', 'Leído'));
              const main294 = n('div', undefined, 'cp-main');
              main294.append(n('span', (msg294.asunto || 'Comunicado del SAT') +
                (msg294.fecha ? ' · ' + msg294.fecha : '') + (msg294.folio ? ' · ' + msg294.folio : '')));
              row294.append(main294);
              body.append(row294);
            } else {
              const titular2913 = hilo2913.find(m => !/respuesta/i.test(m.asunto || '')) || hilo2913[0];
              const contenedor2913 = n('div');
              for (const msg294 of hilo2913) {
                const row294 = n('div', undefined, 'cp-row trib-row');
                row294.append(statusPill('dim', 'Leído'));
                const main294 = n('div', undefined, 'cp-main');
                main294.append(n('span', (msg294.asunto || 'Comunicado del SAT') +
                  (msg294.fecha ? ' · ' + msg294.fecha : '')));
                row294.append(main294);
                contenedor2913.append(row294);
              }
              body.append(plegable290('Hilo · ' + (titular2913.asunto || 'Comunicado del SAT') +
                (clave2913.startsWith('sin-folio-') ? '' : ' · ' + clave2913) +
                ' · ' + hilo2913.length + ' mensajes leídos', contenedor2913));
            }
          }
        }
      } else if (secCom294.concluyente) {
        body.append(empty('Sin comunicados', secCom294.soloConteos
          ? 'La última consulta contó los comunicados sin traer su lista: cuando el SAT enseñe la lista, cada uno traerá su «Leer».'
          : 'La última consulta no trajo comunicados para este RFC.'));
      } else {
        body.append(empty('Los comunicados no constan en esta consulta',
          'El SAT no enseñó esta bandeja en esta consulta: no consta su contenido, no es un cero.'));
        const reintentar294 = n('button', 'Reintentar la consulta', 'soft trib-reintentar2913');
        reintentar294.type = 'button';
        reintentar294.onclick = () => run();
        body.append(reintentar294);
      }
    }
    if (completo294?.documentos) {
      const secDoc294 = completo294.documentos;
      const headDoc2913 = n('div', undefined, 'trib-sec-head2913');
      headDoc2913.append(n('strong', 'Mis documentos'));
      body.append(headDoc2913);
      if (secDoc294.concluyente && (secDoc294.items || []).length) {
        for (const doc294 of secDoc294.items) {
          const row294 = n('div', undefined, 'cp-row trib-row');
          const main294 = n('div', undefined, 'cp-main');
          main294.append(n('span',
            (doc294.nombre || 'Documento del SAT') +
            (doc294.fecha ? ' · ' + doc294.fecha : '') +
            (doc294.estado ? ' · ' + doc294.estado : '')));
          row294.append(main294);
          body.append(row294);
        }
      } else if (secDoc294.concluyente) {
        body.append(n('p', 'Sin documentos en la última consulta.', 'today-line'));
      } else {
        /* (2.9.13 · B12) La cara dice la frase llana y trae su
           reintento; el motivo técnico íntegro queda fuera de
           la cara (antes se volcaba el párrafo entero). */
        body.append(empty('Mis documentos no constan en esta consulta',
          'El SAT no enseñó esta bandeja en esta consulta: no consta su contenido, no es un cero.'));
        const reintentarDoc2913 = n('button', 'Reintentar la consulta', 'soft trib-reintentar2913');
        reintentarDoc2913.type = 'button';
        reintentarDoc2913.onclick = () => run();
        body.append(reintentarDoc2913);
      }
    }
    /* Consulta automática semanal (1.28.0, P3): la pantalla dice
       cuándo toca la siguiente sin que nadie pulse nada. Semanal
       porque la no abierta se tiene por notificada al 4.º día:
       una cadencia mayor podría descubrirla con los efectos ya
       corriendo. */
    parrafoAyuda299((data.proximaAuto
      ? 'Consulta automática: PacoSAT revisa este buzón solo, cada semana — la siguiente toca el ' +
        new Date(data.proximaAuto).toLocaleDateString('es-MX', { weekday: 'long', day: 'numeric', month: 'long' }) +
        '. El botón «Consultar ahora» sigue valiendo en cualquier momento.'
      : 'Consulta automática semanal activada: la primera revisión sola llega en el próximo ciclo del sistema; el botón «Consultar ahora» vale en cualquier momento.') +
      (data.archivadas ? ' En local hay ' + number.format(data.archivadas) + ' archivada(s) (opiniones e informativos): no vuelven a esta vista aunque el SAT las siga enseñando.' : ''));
    /* «Sin abrir» se dice UNA vez en esta pantalla (1.32.1,
       B4): en la pastilla de estado. La antigua línea
       «Vigilancia: N sin abrir…» repetía el conteo por tercera
       vez y salió de la cara. */
    const items = (data.notificaciones || []).filter(item => !item.archivada);
    const archivadasItems = (data.notificaciones || []).filter(item => item.archivada);
    if (!items.length && !archivadasItems.length) {
      body.append(data.ultimaConsulta
        ? empty('Bandeja vacía en la última consulta', 'El SAT no enseñó notificaciones para este RFC. Cuando deje una, la verás aquí en la siguiente consulta.')
        : empty('Todavía no consultas este buzón', 'Toca «Consultar ahora»: PacoSAT entra con la e.firma de este RFC y te trae la lista, sin abrir ninguna notificación.'));
    }
    const pintaItem = item => {
      const row = n('div', undefined, 'cp-row trib-row');
      row.append(statusPill(item.abierta ? 'dim' : 'warn', item.abierta ? 'Abierta' : 'Sin abrir'));
      if (item.categoria && item.categoria !== 'atencion')
        row.append(statusPill('ok', item.categoria === 'opinion' ? 'Opinión' : 'Informativo'));
      const main = n('div', undefined, 'cp-main');
      const texto = n('span',
        (item.asunto || 'Notificación del SAT') +
        (item.remitente ? ' · ' + item.remitente : '') +
        (item.fecha ? ' · ' + item.fecha : '') +
        (item.estado ? ' · ' + item.estado : ''));
      if (!item.abierta) { const strong = n('strong'); strong.append(texto); main.append(strong); }
      else main.append(texto);
      /* Barra de vencimiento por notificación sin abrir
         (1.29.0, peldaño 2): cuánto del plazo para abrirla ya
         corrió — el día en que se tiene por notificada manda. */
      if (!item.abierta && item.plazo?.tenida) {
        const inicio = Date.parse(String(item.fecha || '') + 'T12:00:00');
        const fin = Date.parse(String(item.plazo.tenida) + 'T12:00:00');
        const pct = Number.isFinite(inicio) && Number.isFinite(fin) && fin > inicio
          ? Math.max(0, Math.min(100, Math.round((Date.now() - inicio) / (fin - inicio) * 100))) : 0;
        const barra = n('div', undefined, 'trib-plazo');
        /* Urgencia por días que quedan (V9, 1.31.0): la barra
           se tiñe según la cuenta atrás hasta tenerse por
           notificada — ámbar con 3 días o menos, rojo con 1 día
           o menos (hoy incluido) — calculada por días de
           calendario desde plazo.tenida contra hoy, al mediodía
           para que el huso no mueva la cuenta. El CSS de
           'plazo-ambar' y 'plazo-rojo' lo pone otro frente;
           aquí solo se marca el elemento de la barra. */
        const ahora = new Date();
        const hoyMediodia = new Date(ahora.getFullYear(), ahora.getMonth(), ahora.getDate(), 12).getTime();
        const diasQuedan = Number.isFinite(fin) ? Math.round((fin - hoyMediodia) / 86400000) : null;
        if (diasQuedan !== null && diasQuedan <= 1) barra.classList.add('plazo-rojo');
        else if (diasQuedan !== null && diasQuedan <= 3) barra.classList.add('plazo-ambar');
        const cuentaAtras = diasQuedan === null ? '' : diasQuedan < 0
          ? ' · hace ' + Math.abs(diasQuedan) + (diasQuedan === -1 ? ' día' : ' días')
          : diasQuedan === 0 ? ' · hoy'
          : diasQuedan === 1 ? ' · mañana'
          : ' · en ' + diasQuedan + ' días';
        const relleno = n('div', undefined, 'trib-plazo-fill' + (pct >= 75 ? ' trib-plazo-hot' : ''));
        /* Tramos del componente universal de plazo (1.31.2):
           el relleno se tiñe por días que quedan — verde,
           ámbar con 3 o menos, rojo con 1 o menos — con las
           mismas clases que la barra de plazo de Avisos. */
        if (diasQuedan !== null) relleno.classList.add(diasQuedan <= 1 ? 'plazo-bad' : diasQuedan <= 3 ? 'plazo-warn' : 'plazo-ok');
        relleno.style.width = pct + '%';
        barra.append(relleno);
        main.append(barra, n('small', 'Se tiene por notificada el ' + declFechaLarga(item.plazo.tenida) + cuentaAtras +
          ' aunque nadie la abra · último día para abrirla: ' + declFechaLarga(item.plazo.limite) + '.', 'muted'));
        /* (3.2.0 · pieza 22) La cuenta atrás de ESTE plazo,
           como pastilla .pill320 con forma y color, dibujada
           SIN abrir el aviso: sale del mismo plazo.tenida que
           la fila ya trae del servidor (la regla escrita de
           buzonPlazo) y de los mismos días que la barra —
           un solo cálculo — con sus umbrales: rojo con 1 día
           o menos o ya vencida, ámbar con 3 o menos. */
        if (diasQuedan !== null) {
          const pastilla320 = n('span', diasQuedan < 0
            ? 'Se tuvo por notificada hace ' + Math.abs(diasQuedan) + (diasQuedan === -1 ? ' día' : ' días')
            : diasQuedan === 0 ? 'Hoy se tiene por notificada'
            : diasQuedan === 1 ? 'Queda 1 día para que se tenga por notificada'
            : 'Quedan ' + diasQuedan + ' días para que se tenga por notificada', 'pill320');
          pastilla320.dataset.nivel = diasQuedan <= 1 ? 'bad' : diasQuedan <= 3 ? 'warn' : 'ok';
          main.append(pastilla320);
        }
      }
      row.append(main);
      /* Archivar es LOCAL (1.29.0): no toca el SAT ni abre nada;
         solo saca la fila de la vista principal, y la
         sincronización no la devuelve. La papelera también es
         local: sale de TODAS las vistas en el acto, con deshacer;
         la purga definitiva es otro gesto, desde la Papelera. */
      const gestos = n('span', undefined, 'trib-gestos');
      const gesto = n('button', item.archivada ? 'Devolver a la vista' : 'Archivar en local', 'soft small');
      gesto.type = 'button';
      gesto.onclick = async () => {
        gesto.disabled = true;
        try {
          const result = await satApi('tributario/archive', { rfc, clave: item.clave, archivada: !item.archivada });
          toast(item.archivada ? 'De vuelta en la vista principal.' : 'Archivada en local: el SAT no se ha tocado.', 'ok');
          if (body.isConnected) paint({ ...data, ...result.view });
        } catch (error) { toast(error.message, 'error'); gesto.disabled = false; }
      };
      const basura = n('button', 'A la papelera', 'soft small');
      basura.type = 'button';
      basura.onclick = async () => {
        basura.disabled = true;
        try {
          const result = await satApi('tributario/trash', { rfc, clave: item.clave, papelera: true });
          toast('A la papelera local: desaparece de todas las vistas. Deshacer, en la Papelera de esta pantalla.', 'ok');
          if (body.isConnected) paint({ ...data, ...result.view });
        } catch (error) { toast(error.message, 'error'); basura.disabled = false; }
      };
      gestos.append(gesto, basura);
      row.append(gestos);
      return row;
    };
    for (const item of items) body.append(pintaItem(item));
    if (data.archivadas) {
      const ver = n('button', verArchivadas ? 'Ocultar las archivadas en local' : 'Ver las archivadas en local (' + number.format(data.archivadas) + ')', 'soft small');
      ver.type = 'button';
      ver.onclick = async () => { verArchivadas = !verArchivadas; try { await refresh(); } catch { /* se queda la vista */ } };
      body.append(ver);
      if (verArchivadas) for (const item of archivadasItems) body.append(pintaItem(item));
    }
    /* ===== Papelera local (1.29.0, adenda de Paco) =====
       Lo que cae aquí salió de todas las vistas. Deshacer lo
       devuelve; la purga definitiva es TU toque y queda trazada
       en el Registro, con su lápida para que la sincronización
       no lo resucite jamás. Y el límite honesto, en la cara: */
    const papHead = n('div', undefined, 'traffic-strip');
    papHead.append(statusPill(data.papeleraTotal ? 'warn' : 'dim',
      'Papelera: ' + number.format(data.papeleraTotal || 0) + ' en local'));
    const verPap = n('button', verPapelera ? 'Cerrar la papelera' : 'Abrir la papelera', 'soft small');
    verPap.type = 'button';
    verPap.onclick = async () => { verPapelera = !verPapelera; try { await refresh(); } catch { /* se queda la vista */ } };
    papHead.append(verPap);
    body.append(papHead);
    if (verPapelera) {
      body.append(n('p', 'Lo que se borra aquí es la copia y la presencia en PacoSAT: el registro original en el SAT ' +
        'no se puede borrar, es constancia oficial. El archivo fiscal con peso (tus CFDI y tus acuses) no se purga: ' +
        'para eso está «Archivar en local», que lo saca de la vista sin borrarlo. Purgar deja una lápida con el ' +
        'identificador, para que la sincronización no lo traiga de vuelta aunque el SAT lo siga listando.', 'today-line'));
      const enPapelera = data.papelera || [];
      if (!enPapelera.length) body.append(empty('Papelera vacía', 'Lo que mandes a la papelera desde la lista aparecerá aquí, con su deshacer.'));
      for (const item of enPapelera) {
        const row = n('div', undefined, 'cp-row trib-row trib-papelera-row');
        row.append(statusPill('dim', 'En papelera'));
        const main = n('div', undefined, 'cp-main');
        main.append(n('span', (item.asunto || 'Notificación del SAT') +
          (item.fecha ? ' · ' + item.fecha : '') +
          (item.papeleraEn ? ' · a la papelera el ' + (typeof fmtFechaHora === 'function' ? fmtFechaHora(item.papeleraEn) : '') : '')));
        row.append(main);
        const gestos = n('span', undefined, 'trib-gestos');
        const devolver = n('button', 'Deshacer', 'soft small');
        devolver.type = 'button';
        devolver.onclick = async () => {
          devolver.disabled = true;
          try {
            const result = await satApi('tributario/trash', { rfc, clave: item.clave, papelera: false });
            toast('De vuelta en el buzón local, como estaba.', 'ok');
            if (body.isConnected) paint({ ...data, ...result.view });
          } catch (error) { toast(error.message, 'error'); devolver.disabled = false; }
        };
        const purgar = n('button', 'Borrar definitivamente', 'soft small danger');
        purgar.type = 'button';
        purgar.onclick = async () => {
          if (purgar.dataset.confirmar !== '1') {
            purgar.dataset.confirmar = '1';
            purgar.textContent = 'Toca otra vez para purgar';
            return;
          }
          purgar.disabled = true;
          try {
            const result = await satApi('tributario/purge', { rfc, clave: item.clave });
            toast('Purgada de PacoSAT y trazado en el Registro: no volverá aunque el SAT la siga listando.', 'ok');
            if (body.isConnected) paint({ ...data, ...result.view });
          } catch (error) { toast(error.message, 'error'); purgar.disabled = false; }
        };
        gestos.append(devolver, purgar);
        row.append(gestos);
        body.append(row);
      }
    }
    /* Diario por pasos de las últimas consultas: la evidencia de
       qué hizo la máquina, plegada como detalle. */
    const runs = data.runs || [];
    if (runs.length) {
      /* Expandible con cableado propio (2.9.0 · Bloque C): el
         <details> nativo no desplegaba en producción (la
         auditoría lo probó muerto); plegable290 garantiza el
         despliegue con estado propio. */
      const diarioContenido290 = n('div', undefined, 'decl-diario');
      for (const run of runs) {
        const block = n('div', undefined, 'decl-diario-run');
        const lineaRun240 = n('p', buzonCuando(run.started) + ' · ' +
          (run.ok ? run.encontradas + ' en la bandeja, ' + run.sinAbrir + ' sin abrir'
            : (run.error || 'sin detalle')) +
          (run.attempts > 1 ? ' · ' + run.attempts + ' intentos' : ''), run.ok ? 'muted' : 'error-text');
        lineaRun240.dataset.estado = run.ok ? 'aldia' : 'error';
        block.append(lineaRun240);
        for (const step of run.steps || [])
          block.append(n('p', '· ' + (step.paso || step.text || '') + (step.detalle ? ' — ' + step.detalle : ''), 'muted'));
        if (!run.ok) {
          /* La página guardada del fallo (1.27.0): verla o
             bajarla sin repetir la consulta a ciegas. */
          const evidencia = evidenceButtons('tributario', run);
          if (evidencia) block.append(evidencia);
        }
        /* La evidencia por sección (2.9.3): la página de
           «Mis comunicados» / «Mis documentos» de ESTA
           corrida, concluyeran o no — se enseña en toda
           corrida que la guardó, también en las buenas: una
           sección que no concluye en una corrida buena es
           justo el caso que hay que poder mirar. */
        const evidenciaSeccion = typeof seccionEvidenceButtons293 === 'function'
          ? seccionEvidenceButtons293(run) : null;
        if (evidenciaSeccion) block.append(evidenciaSeccion);
        diarioContenido290.append(block);
      }
      body.append(typeof plegable290 === 'function'
        ? plegable290('Diario de consultas', diarioContenido290, 'buzon-diario')
        : diarioContenido290);
    }
    /* (3.2.0 · pieza 6) Todos los vacíos pintados en esta
       vista (bandeja, comunicados, documentos, papelera),
       con su clase de vacío diseñada. */
    body.querySelectorAll('.empty').forEach(el => el.classList.add('vacio320'));
  };
  const refresh = async () => {
    const data = await satApi('tributario?rfc=' + encodeURIComponent(rfc) +
      (verArchivadas ? '&archivadas=1' : '') + (verPapelera ? '&papelera=1' : ''));
    if (body.isConnected) paint(data);
    return data;
  };
  const run = async () => {
    if (running) return;
    running = true;
    try { await refresh(); } catch { /* el estado previo basta para pintar el «consultando» */ }
    poller = setInterval(() => { refresh().catch(() => {}); }, 2500);
    try {
      const outcome = await satApi('tributario/run', { rfc });
      stopPoller();
      running = false;
      const view = outcome.view || await refresh();
      if (body.isConnected) paint(view);
      if (outcome.result?.ok) toast('Buzón Tributario consultado: ' + (outcome.result.encontradas || 0) +
        ' en la bandeja, ' + (outcome.result.sinAbrir || 0) + ' sin abrir.', 'ok');
      /* Esperando tu equipo (1.29.0): la consulta quedó en cola
         para el ejecutor de tu equipo — no es un fallo. */
      else if (outcome.result?.waitingExecutor) toast(outcome.result.error, 'ok');
      else if (outcome.result?.yaEnCurso) toast(outcome.result.error, 'error');
      else if (!outcome.result?.cancelled) toast(outcome.result?.error || 'La consulta no terminó.', 'error');
    } catch (error) {
      stopPoller();
      running = false;
      /* Respuesta perdida tras una corrida larga: se re-lee el
         estado antes de declarar el error (regla de verdad de
         las acciones) — si la consulta consta terminada, manda
         su resultado, no el error de red. */
      try {
        const fresh = await refresh();
        if (fresh.ultimaConsulta && (!tribCache || fresh.ultimaConsulta !== tribCache.ultimaConsulta || !fresh.progreso?.running)) {
          toast('La consulta terminó: arriba está su resultado re-leído.', 'ok');
          return;
        }
      } catch { /* sin re-lectura: manda el error original */ }
      if (body.isConnected) refresh().catch(() => {});
      toast(error.message, 'error');
    }
  };
  /* Primero el estado GUARDADO (2.9.0 · Bloque C): si ya hay
     una vista de este RFC en la sesión, se pinta al instante
     y la lectura fresca la sustituye al llegar — la pantalla
     ya no pasa ~1 minuto en esqueleto esperando en serie. */
  if (tribCache && tribCache.rfc === rfc && (tribCache.ultimaConsulta || tribCache.total)) {
    paint(tribCache);
    body.append(n('p', 'Actualizando con la última lectura del servidor…', 'muted'));
  } else {
    /* Esqueleto de carga (1.25.0), como en el resto de pantallas. */
    const tribSkel = n('div', undefined, 'skel');
    tribSkel.setAttribute('aria-busy', 'true');
    tribSkel.setAttribute('aria-label', 'Cargando el Buzón Tributario');
    for (let i = 0; i < 3; i++) tribSkel.append(n('div', undefined, 'skel-block'));
    body.append(tribSkel);
  }
  (async () => {
    try { await refresh(); }
    catch (error) { if (body.isConnected && !tribCache) body.replaceChildren(n('p', error.message, 'error-text')); }
  })();
  return [wrap];
}
