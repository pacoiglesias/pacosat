/* ===== Buzón (1.23.0, frente B) — parte diferida 'buzon'
   (2.9.0 · Bloque D) =====
   Bandeja de entrada del contribuyente elegido: los CFDI recibidos
   y los documentos nuevos, lo nuevo primero, con leído/no leído.
   El servidor lleva la cuenta en GET /api/buzon?rfc= y en
   status.buzonUnread; marcar leído es POST /api/buzon/read.
   Abrir un CFDI salta a su ficha (invoiceDetail, el abridor de
   siempre) y un documento abre el mismo visor de Documentos
   (viewDocOnline). El Buzón Tributario del SAT no se promete
   automático: esto es lo que ya entró en tu expediente.
   Este fichero viaja DIFERIDO junto a tributario-ui.part en la
   parte 'buzon': su estado compartido (buzonCache), sus ayudas
   del primer pintado (buzonUnreadFor, buzonCuando) y su talón
   de distintivo (paintBuzonBadge) viven en el PUENTE de ui.part
   (sección «Puente de la parte diferida Buzón»), en una sola
   copia — aquí no se redeclaran. */
/* ===== Reenvío por correo (1.24.0, punto 11) =====
   Cada comprobante viaja en su propio correo, con el XML y el
   PDF adjuntos y los datos que lo prueban. El destino se
   recuerda por RFC y la regla automática («todo lo que llegue
   a este Buzón, a esta dirección») es opcional y nace apagada:
   se enciende solo desde este diálogo, marcándola. */
let buzonForwardCfg = { dests: [], autoTo: '', sugerencia: '' };
const buzonSeleccion = new Set();
let buzonSeleccionRfc = '';
async function forwardDialog(rfc, ids, onSent) {
  const lista = [...new Set((ids || []).map(String).filter(Boolean))];
  if (!rfc || !lista.length) { toast('Elige al menos un comprobante para reenviar.', 'error'); return; }
  let cfg = { dests: [], autoTo: '', sugerencia: '' };
  try { cfg = await satApi('buzon/forward-config?rfc=' + encodeURIComponent(rfc)); } catch { /* sin lectura: campo libre */ }
  const inicial = (cfg.dests || [])[0] || cfg.sugerencia || cfg.autoTo || '';
  const form = n('form', undefined, 'dialog-form');
  form.append(n('h3', 'Reenviar por correo · ' + rfc),
    n('p', (lista.length === 1 ? 'El comprobante viaja' : 'Cada uno de los ' + lista.length + ' comprobantes viaja') +
      ' en su propio correo, con el XML y el PDF adjuntos y los datos que lo prueban: emisor, serie y folio, fecha, total y UUID.', 'muted'));
  const destino = input('email', { value: inicial, placeholder: 'direccion@ejemplo.mx' });
  destino.setAttribute('list', 'fwd-dests');
  const dl = n('datalist'); dl.id = 'fwd-dests';
  for (const d of [...new Set([...(cfg.dests || []), cfg.sugerencia, cfg.autoTo].filter(Boolean))]) {
    const opt = n('option'); opt.value = d; dl.append(opt);
  }
  form.append(fieldWrap('Enviar a', destino), dl);
  if (cfg.sugerencia && !(cfg.dests || []).length)
    form.append(n('p', 'Sugerencia para este RFC: ' + cfg.sugerencia + ' — el buzón de recepción de tu facturador; consta en tus documentos y puedes cambiarla.', 'muted'));
  if (cfg.autoTo && cfg.autoTo !== inicial)
    form.append(n('p', 'Ya hay una regla automática activa hacia ' + cfg.autoTo + ': se gestiona desde Recibidos de este RFC.', 'muted'));
  const auto = input('checkbox', { checked: Boolean(cfg.autoTo) && cfg.autoTo === inicial });
  const autoLabel = n('label');
  autoLabel.append(auto, n('span', ' Reenviar automáticamente todo lo que llegue a Recibidos a esta dirección'));
  form.append(autoLabel);
  const send = n('button', 'Reenviar ahora', 'primary');
  send.type = 'submit';
  const cancel = n('button', 'Cancelar', 'soft');
  cancel.type = 'button';
  cancel.onclick = closeDialog;
  form.append(send, cancel);
  form.onsubmit = async event => {
    event.preventDefault();
    const to = destino.value.trim();
    if (!to) { toast('Escribe la dirección de destino.', 'error'); return; }
    send.disabled = true; send.textContent = 'Enviando…';
    try {
      const result = await satApi('buzon/forward', { rfc, ids: lista, to });
      /* La regla solo se toca si la casilla habla de ESTA
         dirección: encenderla la fija; apagarla la quita solo
         si apuntaba aquí. */
      const reglaPrevia = cfg.autoTo || '';
      let postCfg = null;
      if (auto.checked) postCfg = to;
      else if (reglaPrevia && reglaPrevia === to) postCfg = '';
      if (postCfg !== null && postCfg !== reglaPrevia)
        await satApi('buzon/forward-config', { rfc, autoTo: postCfg });
      const fallos = (result.resultados || []).filter(row => !row.ok);
      closeDialog();
      if (result.enviados && !fallos.length) announce('Reenviado: ' + result.enviados + ' comprobante(s) a ' + to + '.');
      else if (result.enviados) toast('Reenviados ' + result.enviados + '; sin enviar ' + fallos.length + ': ' + (fallos[0].error || 'revisa la bitácora de envíos.'), 'error');
      else toast(result.error || 'No se pudo reenviar.', 'error');
      if (onSent) onSent();
      render();
    } catch (error) {
      /* Respuesta perdida = resultado desconocido: antes de
         enseñar un error se comprueba la bitácora de envíos
         (el asunto lleva el UUID); si el reenvío consta, se
         dice que salió. */
      let enviado = false;
      try {
        const log = await satApi('mail/log');
        enviado = (log.sends || []).some(row => row.kind === 'reenvio' && row.ok &&
          lista.some(id => String(row.subject || '').includes(id)) && Date.now() - Number(row.at) < 5 * 60000);
      } catch { /* sin bitácora legible: manda el error original */ }
      if (enviado) { closeDialog(); announce('Reenviado: consta en la bitácora de envíos.'); if (onSent) onSent(); render(); return; }
      toast(error.message, 'error');
      send.disabled = false; send.textContent = 'Reenviar ahora';
    }
  };
  showDialog(form);
}
/* ===== Trabajo en curso FIJADO ARRIBA en Buzón (2.4.0 · W1, P3) =====
   «Que sepa lo que ocurre cada momento»: si para ESTE RFC hay un
   trabajo vivo en el registro único de actividad (una solicitud
   de descarga esperando al SAT, una consulta del Buzón
   Tributario, un trabajo del ejecutor o una descarga de
   documento/CIEC), esta vista lo abre FIJADO ARRIBA en su propia
   tarjeta — paso/detalle en vivo según el registro, su barra con
   el tiempo desde su inicio real y su Detener/Cancelar EN la
   tarjeta, con el mismo activityControlButton de la franja
   global (un solo gesto, el del registro). Si el trabajo espera
   el gesto de Paco (captcha, ejecutor dormido), la tarjeta enseña
   su nota, que nombra ese único gesto. Sin trabajo vivo para el
   RFC, no se pinta nada: no se finge actividad.
   Nota de territorio: la pantalla del Buzón Tributario vive en
   tributario-ui.part (fuera de esta tanda); allí su corrida YA
   abre la pantalla — pastilla «Consultando el buzón…», línea de
   paso y botón Cancelar en la primera franja — y queda
   declarada en la nota de la ronda, sin tocar ese archivo. */
function buzonTrabajoFijado240(rfc) {
  if (typeof activityView === 'undefined' || !activityView || !rfc) return null;
  const vivos = [...(activityView.running || []).map(e => ({ ...e, enPausa: false })),
    ...(activityView.paused || []).map(e => ({ ...e, enPausa: true }))];
  const propios = vivos.filter(entry => ['tributario', 'masiva', 'ejecutor', 'documentos', 'ciec'].includes(entry.kind) &&
    (entry.rfc === rfc || String(entry.key || '').endsWith(':' + rfc) || String(entry.label || '').includes(rfc)));
  if (!propios.length) return null;
  const card = n('section', undefined, 'activity-dock buzon-trabajo-fijado240');
  card.dataset.trabajoFijado240 = 'buzon';
  const head240 = n('div', undefined, 'activity-dock-head');
  head240.append(n('strong', 'Trabajo en curso'),
    n('span', propios.length === 1 ? '1 trabajo' : propios.length + ' trabajos', 'activity-count'));
  card.append(head240);
  /* Misma composición que la franja y Hoy (corrección visual
     2.4.0, arreglo unificado): la guía de detener una
     solicitud, una vez por tarjeta, y cada entrada con su
     línea única sin fase duplicada. */
  const guiaBuzon240 = typeof actividadGuia240 === 'function'
    ? propios.map(actividadGuia240).find(Boolean) : '';
  if (guiaBuzon240) card.append(n('p', guiaBuzon240, 'muted small actividad-guia240'));
  for (const entry of propios.slice(0, 3)) {
    const row = n('div');
    row.style.display = 'flex'; row.style.justifyContent = 'space-between';
    row.style.gap = '10px'; row.style.alignItems = 'center'; row.style.padding = '6px 0';
    const body240 = n('div');
    const detalle240 = typeof actividadLinea240 === 'function' ? actividadLinea240(entry)
      : typeof activityDetailText === 'function' ? activityDetailText(entry) : (entry.detail || '');
    body240.append(n('strong', String(entry.label || '')), n('small', detalle240 ? ' · ' + detalle240 : '', 'activity-detail'));
    row.append(body240);
    if (typeof activityControlButton === 'function') {
      const acts = n('div', undefined, 'actions');
      if (entry.canPause) acts.append(activityControlButton(entry, entry.enPausa ? 'Reanudar' : 'Pausar', entry.enPausa ? 'reanudar' : 'pausar'));
      if (entry.canResume && entry.enPausa) acts.append(activityControlButton(entry, 'Reanudar', 'reanudar'));
      if (entry.canStop) acts.append(activityControlButton(entry, entry.stopLabel || 'Cancelar', 'detener'));
      if (acts.childNodes.length) row.append(acts);
    }
    card.append(row);
    const progresoBuzon240 = typeof actividadProgreso240 === 'function'
      ? actividadProgreso240(entry, detalle240) : null;
    if (progresoBuzon240) card.append(progresoBuzon240);
  }
  /* Vigilancia diferida (2.4.0 · W6): sin su parte, la tarjeta
     se pinta sin el gesto de parada; se pide la parte y, al
     llegar, la pantalla se repinta con el botón real. */
  if (typeof activityControlButton !== 'function' && typeof ensureLazyPart === 'function')
    ensureLazyPart('monitor').then(ok => {
      if (ok && typeof page !== 'undefined' && page === 'buzon') render();
    });
  return card;
}
function buzonScreen() {
  const wrap = n('div');
  if (typeof satToken === 'undefined' || !satToken) {
    wrap.append(panel('Recibidos', 'Recibidos vive en el servidor de tu casa (el NAS): abre PacoSAT desde el servidor para ver lo que llegó.'));
    return [wrap];
  }
  const head = panel('Recibidos · ' + (scope || 'sin contribuyente'),
    'Lo nuevo que llegó a este RFC: CFDI recibidos y documentos del SAT, lo más reciente primero y lo sin leer destacado. Abrir un CFDI lleva a su ficha; un documento se abre en el visor.');
  const body = n('div');
  head.append(body);
  /* El trabajo vivo de este RFC, fijado ARRIBA del todo (2.4.0 · W1). */
  const fijado240 = scope ? buzonTrabajoFijado240(scope) : null;
  if (fijado240) wrap.append(fijado240);
  wrap.append(head);
  if (!scope) {
    body.append(empty('Elige un contribuyente', 'Recibidos va por RFC: elige arriba el contribuyente del que quieres ver lo que llegó.'));
    return [wrap];
  }
  const rfc = scope;
  const paint = data => {
    buzonCache = data;
    if (typeof satData !== 'undefined' && satData && satData.buzonUnread) satData.buzonUnread[rfc] = data.unread || 0;
    paintBuzonBadge();
    body.replaceChildren();
    const bar = n('div', undefined, 'traffic-strip');
    bar.append(statusPill(data.unread ? 'warn' : 'ok',
      data.unread ? number.format(data.unread) + ' sin leer' : 'Todo leído'));
    /* (2.9.13 · A7) «Marcar todo leído» vive UNA vez: en la
       acción de la cabecera de la pantalla (su dispatch llama
       a buzonMarcarTodoLeido2913). El botón duplicado que
       vivía en esta franja salió; la franja conserva el
       veredicto. */
    body.append(bar);
    /* Regla automática de reenvío (punto 11): si está activa se
       dice en la cara del Buzón, con su gesto para quitarla. */
    if (buzonForwardCfg.autoTo) {
      const autoBar = n('div', undefined, 'traffic-strip');
      autoBar.append(statusPill('ok', 'Reenvío automático activo'),
        n('span', 'Todo lo que llegue a Recibidos se reenvía a ' + buzonForwardCfg.autoTo + '.'));
      const quitar = n('button', 'Quitar la regla', 'soft small');
      quitar.type = 'button';
      quitar.onclick = async () => {
        quitar.disabled = true;
        try {
          await satApi('buzon/forward-config', { rfc, autoTo: '' });
          buzonForwardCfg.autoTo = '';
          paint(data);
          announce('Regla de reenvío automático retirada.');
        } catch (error) { toast(error.message, 'error'); quitar.disabled = false; }
      };
      autoBar.append(quitar);
      body.append(autoBar);
    }
    /* Selección múltiple para reenviar por lote (punto 11). */
    if (buzonSeleccion.size) {
      const selBar = n('div', undefined, 'traffic-strip');
      selBar.append(statusPill('warn', number.format(buzonSeleccion.size) + ' elegido(s) para reenviar'));
      const sendSel = n('button', 'Reenviar seleccionados', 'primary small');
      sendSel.type = 'button';
      sendSel.onclick = () => forwardDialog(rfc, [...buzonSeleccion], () => { buzonSeleccion.clear(); paint(data); });
      const clearSel = n('button', 'Limpiar', 'soft small');
      clearSel.type = 'button';
      clearSel.onclick = () => { buzonSeleccion.clear(); paint(data); };
      selBar.append(sendSel, clearSel);
      body.append(selBar);
    }
    /* (2.9.13 · A9) El mismo DOCUMENTO llegado varias veces
       (misma clase, mismo título y la misma fecha y hora —
       la constancia del 9 nov 14:32 salía repetida) se
       enseña UNA vez con su cuenta; marcarlo leído marca
       todas sus claves. Los CFDI no se agrupan: cada uno es
       su comprobante, con su UUID. */
    const itemsCrudos2913 = data.items || [];
    const items = [];
    {
      const gruposDoc2913 = new Map();
      for (const item of itemsCrudos2913) {
        if (item.kind === 'cfdi') { items.push(item); continue; }
        const clave = [item.kind, item.titulo || '', item.at || ''].join('|');
        const previo = gruposDoc2913.get(clave);
        if (previo) {
          previo._veces2913 = (previo._veces2913 || 1) + 1;
          (previo._keys2913 = previo._keys2913 || [previo.key]).push(item.key);
          if (item.read === false) previo.read = false;
          continue;
        }
        gruposDoc2913.set(clave, item);
        items.push(item);
      }
    }
    if (!items.length) {
      /* El vacío enseña el gesto (1.32.1, A4): lo que llena
         esta bandeja se descarga del SAT. */
      body.append(empty('Recibidos vacío', 'Cuando llegue un CFDI o un documento nuevo de este RFC, aparecerá aquí. Lo que lo trae es la descarga del SAT.',
        typeof downloadSheet === 'function'
          ? action('Descargar del SAT', () => downloadSheet(rfc), 'primary', 'down') : undefined));
      return;
    }
    for (const item of items) {
      const row = n('div', undefined, 'cp-row');
      if (item.kind === 'cfdi' && item.uuid) {
        const check = input('checkbox', { checked: buzonSeleccion.has(item.uuid),
          'aria-label': 'Elegir este comprobante para reenviar' });
        check.onchange = () => {
          if (check.checked) buzonSeleccion.add(item.uuid); else buzonSeleccion.delete(item.uuid);
          paint(data);
        };
        row.append(check);
      }
      row.append(statusPill(item.read ? 'dim' : 'warn',
        item.kind === 'cfdi' ? (item.read ? 'CFDI' : 'CFDI nuevo') : (item.read ? 'Documento' : 'Documento nuevo')));
      /* La fila en líneas (1.26.0, Ronda Visual): título,
         detalle y meta (importe · fecha) en su línea cada uno,
         con la pieza .cp-main de la casa — nada de la frase
         corrida «título · detalle · importe · fecha». Y el
         importe no se repite: el servidor lo trae crudo dentro
         del detalle y la meta lo enseña ya formateado, así que
         el segmento crudo sale de la línea de detalle (regla de
         Paco: el mismo dato dos veces en una pantalla es un
         error de diseño). */
      const main = n('div', undefined, 'cp-main');
      const titleText = (item.titulo || (item.kind === 'cfdi' ? 'CFDI recibido' : 'Documento')) +
        (item._veces2913 > 1 ? ' ×' + item._veces2913 : '');
      if (!item.read) main.append(n('strong', titleText));
      else main.append(n('span', titleText));
      const detalleSegs = (item.detalle || '').split(' · ')
        .filter(seg => seg && seg !== String(item.importe || ''));
      if (detalleSegs.length) main.append(n('span', detalleSegs.join(' · '), 'muted'));
      const meta = [item.importe ? '$' + money(item.importe) : '',
        item.at ? buzonCuando(item.at) : ''].filter(Boolean).join(' · ');
      if (meta) main.append(n('span', meta, 'muted bz-meta'));
      row.append(main);
      /* Sin archivo que resuelva, no hay botón que prometa un
         papel que no se abre (2.9.0 · Bloque C): el servidor
         ya resolvió la referencia (sinArchivo) y la fila lo
         dice con una etiqueta. */
      if (item.kind !== 'cfdi' && item.sinArchivo) {
        row.append(etiqueta290('dim', 'Sin archivo guardado', 'El documento consta en el buzón, pero su archivo no está guardado en el expediente.'));
        const filaMenuSinArchivo = [];
        if (!item.read) filaMenuSinArchivo.push(['Marcar leído', async () => {
          try {
            const result = await satApi('buzon/read', { rfc, keys: item._keys2913 || [item.key] });
            item.read = true;
            data.unread = result.unread;
            paint(data);
          } catch (error) { toast(error.message, 'error'); }
        }]);
        if (filaMenuSinArchivo.length) {
          const menuSin = cardMenu1312('Más opciones de esta novedad');
          menuSin._setItems1312(filaMenuSinArchivo.map(([label, fn]) => ({ label, fn })));
          row.append(menuSin);
        }
        body.append(row);
        continue;
      }
      const open = n('button', item.kind === 'cfdi' ? 'Abrir ficha' : 'Ver documento', 'soft');
      open.type = 'button';
      open.onclick = () => {
        if (item.kind === 'cfdi') {
          const found = (invoices || []).find(row => row.id === String(item.uuid || '').toUpperCase());
          if (found) { invoiceDetail(found); return; }
          if (item.uuid) { term = item.uuid; invoicePage = 0; navigate('invoices'); return; }
          navigate('invoices');
          return;
        }
        const docId = item.fileId || item.docId ||
          (String(item.key || '').includes(':') ? String(item.key).split(':').slice(1).join(':') : item.key);
        viewDocOnline({ id: docId, rfc, kind: item.titulo || 'Documento',
          name: (item.titulo || 'Documento') + ' · ' + rfc + '.pdf' })
          .catch(error => toast(error.message, 'error'));
      };
      row.append(open);
      /* El resto de gestos, al ⋯ de la fila (1.32.1, R1): la
         fila enseña su gesto principal — abrir — y nada más;
         reenviar y marcar leído viven a un toque, no apilados. */
      const filaMenu = [];
      if (item.kind === 'cfdi' && item.uuid)
        filaMenu.push(['Reenviar', () => forwardDialog(rfc, [item.uuid])]);
      if (!item.read) filaMenu.push(['Marcar leído', async () => {
        try {
          const result = await satApi('buzon/read', { rfc, keys: item._keys2913 || [item.key] });
          item.read = true;
          data.unread = result.unread;
          paint(data);
        } catch (error) {
          try {
            const fresh = await satApi('buzon?rfc=' + encodeURIComponent(rfc));
            if ((fresh.items || []).find(candidate => candidate.key === item.key)?.read) {
              paint(fresh);
              toast('Quedó marcado como leído.', 'ok');
              return;
            }
          } catch { /* sin re-lectura: manda el error original */ }
          toast(error.message, 'error');
        }
      }]);
      if (filaMenu.length && typeof cardMenu1312 === 'function') row.append(cardMenu1312(filaMenu));
      body.append(row);
    }
  };
  if (buzonSeleccionRfc !== rfc) { buzonSeleccion.clear(); buzonSeleccionRfc = rfc; }
  /* Esqueleto de carga (1.25.0): bloques con la forma de la
     bandeja mientras llega, no un párrafo suelto. */
  /* Primero lo guardado y las dos lecturas EN PARALELO
     (2.9.0 · Bloque C): la bandeja guardada de la sesión se
     pinta al instante y la fresca la sustituye; antes las
     llamadas iban en serie tras un esqueleto. */
  if (buzonCache && buzonCache.rfc === rfc) paint(buzonCache);
  else {
    const buzonSkel = n('div', undefined, 'skel');
    buzonSkel.setAttribute('aria-busy', 'true');
    buzonSkel.setAttribute('aria-label', 'Cargando los recibidos');
    for (let i = 0; i < 3; i++) buzonSkel.append(n('div', undefined, 'skel-block'));
    body.append(buzonSkel);
  }
  (async () => {
    try {
      const [data, cfg] = await Promise.all([
        satApi('buzon?rfc=' + encodeURIComponent(rfc)),
        satApi('buzon/forward-config?rfc=' + encodeURIComponent(rfc))
          .catch(() => ({ dests: [], autoTo: '', sugerencia: '' }))]);
      buzonForwardCfg = cfg;
      if (body.isConnected) paint(data);
    } catch (error) { if (body.isConnected && !buzonCache) body.replaceChildren(n('p', error.message, 'error-text')); }
  })();
  return [wrap];
}
/* (2.9.13 · A7) «Marcar todo leído» de Recibidos, en su único
   sitio: la acción de la cabecera de la pantalla. Vive aquí
   como función global porque la cabecera se despacha desde
   workflows sin conocer el cuerpo de la pantalla; trabaja
   sobre la bandeja cacheada y repinta con render(). Con la
   respuesta perdida se re-lee antes de declarar el error
   (la regla de verdad de las acciones, como el botón que
   sustituye). */
async function buzonMarcarTodoLeido2913() {
  const rfc = (buzonCache && buzonCache.rfc) || scope;
  if (!rfc) return;
  try {
    const result = await satApi('buzon/read', { rfc, all: true });
    if (buzonCache && buzonCache.rfc === rfc) {
      for (const item of buzonCache.items || []) item.read = true;
      buzonCache.unread = result.unread;
    }
    toast('Recibidos al día: todo marcado como leído.', 'ok');
    render();
  } catch (error) {
    try {
      const fresh = await satApi('buzon?rfc=' + encodeURIComponent(rfc));
      if (!fresh.unread) { buzonCache = fresh; toast('Quedó registrado: todo consta leído.', 'ok'); render(); return; }
    } catch { /* sin re-lectura: manda el error original */ }
    toast(error.message, 'error');
  }
}
