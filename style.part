/* PacoSAT 1.11 *//* Tokens: claro|oscuro con light-dark(); oscuro por color-scheme. */:root{color-scheme:light;font:15px/1.48 "Segoe UI",system-ui,sans-serif;color:var(--ink);background:var(--bg);--ink:light-dark(#17293f,#e7eff8);--muted:light-dark(#54687f,#9db1c8);--border:light-dark(#d9e3ee,#2b3e55);--surface:light-dark(#fffefb,#14243a);--surface-2:light-dark(#f3f7fb,#1a2c47);--bg:light-dark(#e8ece7,#0a1424);--green:light-dark(#0e6b4f,#2fae83);--gold:light-dark(#a07d2c,#c9a86a);--tint:light-dark(#e1f1e9,#14352b);--nav-text:#d9e8f7;--nav-muted:light-dark(#93a9c4,#93a9c4);--nav-border:light-dark(#33507a,#274268);--danger:light-dark(#a0281d,#f0a49c);--danger-bg:light-dark(#f6d7d1,#47231f);--warn-ink:light-dark(#6e4a06,#f2cf7e);--warn-bg:light-dark(#f7dd9a,#473a14);--ok-ink:light-dark(#125d44,#9fe3c0);--ok-bg:light-dark(#c9ecd9,#14352b);--info-ink:light-dark(#33475e,#b9cadd);--info-bg:light-dark(#d9e3ef,#1c3049);--chart-2:light-dark(#3d7ab8,#6ea8dc);--accent:var(--green);--brand:var(--green);--ok:var(--ok-ink);--warn:var(--warn-ink);--bad:var(--danger);--money:var(--ink);--line:var(--border);--bd:1px solid var(--border);--r-s:8px;--r-m:12px;--r-l:16px;--r-pill:100px;--sp-1:4px;--sp-2:8px;--sp-3:12px;--sp-4:16px;--sp-5:24px;--shadow-1:0 18px 55px light-dark(#12251d33,#00000073);--shadow-2:0 8px 28px light-dark(#12251d26,#00000059);--accent-ink:var(--ok-ink);--nav-active-bg:light-dark(#14402f,#14352b);--nav-active-ink:#a9ecc9;--fs-xs:11px;--fs-s:12px;--fs-b:15px;--fs-m:13px;--fs-l:14px;--fs-xl:16px;--fs-2xl:18px;--fs-4xl:24px;--fs-5xl:30px;--card-sh:0 1px 2px light-dark(#1022190d,#0000006b),0 14px 34px -16px light-dark(#10221933,#00000099),inset 0 1px 0 light-dark(#ffffff59,#ffffff0f)}@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){color-scheme:dark}}:root[data-theme="dark"]{color-scheme:dark}*{box-sizing:border-box}body{margin:0;-webkit-font-smoothing:antialiased;text-rendering:optimizeLegibility}svg{width:19px;height:19px;stroke:currentColor;stroke-width:1.65;stroke-linecap:round;stroke-linejoin:round;fill:none;flex:none}.symbols,[hidden]{display:none!important}button,input,select,textarea{font:inherit}button,a,input,select{border-radius:var(--r-s)}button{color:var(--ink);border:var(--bd);background:var(--surface);padding:9px 12px;font-weight:600;cursor:pointer;display:inline-flex;align-items:center;justify-content:center;gap:7px;text-align:left;transition:background-color .15s ease,border-color .15s ease}button:hover{background:var(--surface-2)}button:disabled{opacity:.5;cursor:default}button.primary{background:var(--green);border-color:var(--green);color:light-dark(#fff,#06231a);min-height:44px;padding:11px 15px}button.primary:hover:not(:disabled){background:light-dark(#0a5741,#3cc398)}button.quiet,.quiet{background:transparent;border-color:transparent}.metric-link{background:var(--info-bg);color:var(--info-ink);padding:6px 8px;font-size:var(--fs-s)}a{color:var(--green);font-weight:600;text-underline-offset:3px}input,select,textarea{border:1px solid light-dark(#bcccdc,#3a5578);background:var(--surface);color:var(--ink);padding:9px 11px;min-width:0;max-width:100%}:focus-visible{outline:3px solid light-dark(#1f7a6d,#57c7a3);outline-offset:2px}.sidebar :focus-visible{outline-color:#8fe3c0}.frame{min-height:100vh;display:grid;grid-template-columns:232px minmax(0,1fr)}.sidebar{padding:26px 18px;background:light-dark(#0c1a2d,#081120);color:var(--nav-text);display:flex;flex-direction:column;gap:24px}.brand{display:flex;align-items:center;gap:10px;color:#fff;font-weight:720;font-size:22px;letter-spacing:-.025em}.brand small,.local small{display:block;color:var(--nav-muted);font-size:var(--fs-xs);font-weight:650;letter-spacing:.11em}.brand .logo img{width:100%;height:100%;object-fit:contain}.logo{width:42px;height:42px;display:grid;place-items:center;color:var(--accent-ink);background:var(--tint);border-radius:var(--r-m)}.logo svg{width:25px;height:25px}.switcher{display:grid;gap:7px}.switcher label{color:var(--nav-muted);font-size:var(--fs-xs);font-weight:700}.switcher select{background:light-dark(#1a3353,#16294a);border-color:var(--nav-border);color:var(--nav-text)}.sidebar nav{display:grid;gap:4px}.sidebar button{background:transparent;border-color:transparent;color:var(--nav-text);justify-content:flex-start;padding:11px 10px}.sidebar button:hover{background:light-dark(#1a3353,#16294a)}.sidebar .quiet{font-size:var(--fs-m);padding:6px 4px}.sidebar nav button[aria-current]{background:var(--nav-active-bg);color:var(--nav-active-ink)}.nav-caption{display:block;color:var(--nav-muted);font-size:var(--fs-xs);font-weight:750;padding:3px 10px 4px}.local{display:flex;gap:10px;align-items:center;color:var(--nav-text);font-size:var(--fs-m);margin-top:auto}.top{background:var(--surface);border-bottom:var(--bd);padding:14px 28px;display:flex;align-items:center;justify-content:space-between;color:var(--muted);gap:10px;font-size:var(--fs-m)}.top strong{color:var(--ink)}.slash{margin:0 7px;color:var(--muted)}.top-side{display:inline-flex;align-items:center;gap:12px}.header-counters{color:var(--muted);font-size:var(--fs-m);font-weight:600}.top-tools{display:inline-flex;gap:6px;align-items:center}.icon-button{padding:6px;min-width:40px;min-height:40px}.top-tools .icon-button{color:var(--muted)}.top-tools .icon-button[aria-pressed="true"]{color:var(--green);border-color:var(--green)}.top-search input{background:light-dark(#1a3353,#16294a);border:1px solid var(--nav-border);color:var(--nav-text);border-radius:8px;padding:6px 10px;min-width:200px;font:inherit}.top-search input::placeholder{color:var(--nav-muted)}.badge,.tag{font-size:var(--fs-s);color:var(--accent-ink);background:var(--tint);display:inline-flex;align-items:center;padding:4px 8px;border-radius:var(--r-pill);font-weight:650;white-space:nowrap}.dot{width:7px;height:7px;border-radius:50%;background:var(--green)}.news-badge{padding:1px 7px;border-radius:var(--r-pill);background:var(--danger);color:light-dark(#fff,#471a14);font-size:var(--fs-xs);font-weight:750}.page{max-width:1340px;margin:auto;padding:28px}.app-footer{color:var(--muted);font-size:var(--fs-s)}.app-footer-row{display:flex;align-items:center;gap:7px;padding-top:12px;border-top:var(--bd);color:var(--muted)}.app-footer-row svg{width:15px;height:15px}.heading{display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;margin-bottom:24px}.heading p{font-size:var(--fs-m)}.eyebrow{font-weight:750;font-size:var(--fs-xs);letter-spacing:.14em;color:var(--green);overflow-wrap:anywhere}h1{font-size:var(--fs-5xl);font-weight:720;line-height:1.12;letter-spacing:-.02em;margin:6px 0}h2{font-size:var(--fs-2xl);font-weight:650;line-height:1.3;margin:0}h3{font-size:var(--fs-xl);line-height:1.35;margin:0}p{margin:0;color:var(--muted)}.offline-banner{margin:0;padding:10px 28px;background:var(--danger-bg);color:var(--danger)}#status{margin:0 0 12px;padding:11px 13px;background:var(--tint);white-space:pre-line;overflow-wrap:anywhere;color:var(--ink)}#status[data-error=true]{background:var(--danger-bg);color:var(--danger)}body.drag-active::after{content:"Suelta los archivos para importar";position:fixed;inset:auto 0 22px 0;margin:0 auto;width:max-content;max-width:92vw;background:var(--green);color:light-dark(#fff,#06231a);padding:11px 18px;border-radius:100px;font-weight:700;z-index:60}
/* La miga superior no se parte (2.3.2 · H6-3): su primer tramo
   («PacoSAT / Vista») va en una sola línea y no cede su ancho;
   quien cede es el selector de la derecha (polish.part). */
.top>span:first-child{flex:none;white-space:nowrap}

/* ── (3.2.0 · pieza 4) Modo oscuro explícito: :root ya resuelve el
   oscuro con light-dark() y color-scheme, pero el tema fijado a mano
   (data-theme="dark" en <html>) redefine AQUÍ, con el mismo valor,
   TODAS las variables de color — fondos, superficies, tinta, bordes,
   tinte, fondos de semáforo, barra lateral y sombras — con la misma
   paleta sobria y el MISMO acento (los acentos por nombre siguen en
   polish.part, que va después y manda sobre estos valores base).
   Las alias (--accent, --brand, --ok, --warn, --bad, --money, --line)
   son referencias var() y siguen solas a su variable. */
:root[data-theme="dark"]{--ink:#e7eff8;--muted:#9db1c8;--border:#2b3e55;--surface:#14243a;--surface-2:#1a2c47;--bg:#0a1424;--green:#2fae83;--gold:#c9a86a;--tint:#14352b;--nav-text:#d9e8f7;--nav-muted:#93a9c4;--nav-border:#274268;--danger:#f0a49c;--danger-bg:#47231f;--warn-ink:#f2cf7e;--warn-bg:#473a14;--ok-ink:#9fe3c0;--ok-bg:#14352b;--info-ink:#b9cadd;--info-bg:#1c3049;--chart-2:#6ea8dc;--accent-ink:#9fe3c0;--nav-active-bg:#14352b;--nav-active-ink:#a9ecc9;--shadow-1:0 18px 55px #00000073;--shadow-2:0 8px 28px #00000059;--card-sh:0 1px 2px #0000006b,0 14px 34px -16px #00000099,inset 0 1px 0 #ffffff0f}
/* ── (3.2.0 · pieza 33) Letra grande: html[data-letra="grande"]
   reescala TODA la escala --fs-* al alza (cada pantalla que usa la
   escala crece sin tocar su CSS) y da un interlineado cómodo para
   enseñar un saldo sin menús ni ruido. */
html[data-letra="grande"]{--fs-xs:13px;--fs-s:14px;--fs-m:15px;--fs-l:16px;--fs-b:17px;--fs-xl:19px;--fs-2xl:21px;--fs-4xl:28px;--fs-5xl:34px;line-height:1.62}
