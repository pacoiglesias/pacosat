/* PacoSAT 1.11 *//* Tokens: claro|oscuro con light-dark(); oscuro por color-scheme. */:root{color-scheme:light;font:15px/1.48 "Segoe UI",system-ui,sans-serif;color:var(--ink);background:var(--bg);--ink:light-dark(#17293f,#e7eff8);--muted:light-dark(#54687f,#9db1c8);--border:light-dark(#d9e3ee,#2b3e55);--surface:light-dark(#fff,#14243a);--surface-2:light-dark(#f3f7fb,#1a2c47);--bg:light-dark(#edf1f6,#0a1424);--green:light-dark(#0e6b4f,#2fae83);--tint:light-dark(#e1f1e9,#14352b);--nav-text:#d9e8f7;--nav-muted:light-dark(#93a9c4,#7e96b3);--nav-border:light-dark(#33507a,#274268);--danger:light-dark(#a0281d,#f0a49c);--danger-bg:light-dark(#fae9e6,#47231f);--warn-ink:light-dark(#755015,#f2cf7e);--warn-bg:light-dark(#fdf3d8,#473a14);--ok-ink:light-dark(#125d44,#9fe3c0);--ok-bg:light-dark(#dcf2e7,#14352b);--info-ink:light-dark(#435b74,#b9cadd);--info-bg:light-dark(#e8eef5,#1c3049);--chart-2:light-dark(#3d7ab8,#6ea8dc);--brand:var(--green);--ok:var(--ok-ink);--warn:var(--warn-ink);--bad:var(--danger);--money:var(--ink);--line:var(--border);--bd:1px solid var(--border)}@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){color-scheme:dark}}:root[data-theme="dark"]{color-scheme:dark}*{box-sizing:border-box}body{margin:0;-webkit-font-smoothing:antialiased;text-rendering:optimizeLegibility}svg{width:19px;height:19px;stroke:currentColor;stroke-width:1.65;stroke-linecap:round;stroke-linejoin:round;fill:none;flex:none}.symbols,[hidden]{display:none!important}button,input,select,textarea{font:inherit}button,a,input,select{border-radius:8px}button{color:var(--ink);border:var(--bd);background:var(--surface);padding:9px 12px;font-weight:600;cursor:pointer;display:inline-flex;align-items:center;justify-content:center;gap:7px;text-align:left}button:hover{background:var(--surface-2)}button:disabled{opacity:.5;cursor:default}button.primary{background:var(--green);border-color:var(--green);color:light-dark(#fff,#06231a);min-height:44px;padding:11px 15px}button.primary:hover:not(:disabled){background:light-dark(#0a5741,#3cc398)}button.quiet,.quiet{background:transparent;border-color:transparent}.metric-link{background:var(--info-bg);color:var(--info-ink);padding:6px 8px;font-size:12px}a{color:var(--green);font-weight:600;text-underline-offset:3px}input,select,textarea{border:1px solid light-dark(#bcccdc,#3a5578);background:var(--surface);color:var(--ink);padding:9px 11px;min-width:0;max-width:100%}:focus-visible{outline:3px solid light-dark(#1f7a6d,#57c7a3);outline-offset:2px}.frame{min-height:100vh;display:grid;grid-template-columns:232px minmax(0,1fr)}.sidebar{padding:26px 18px;background:light-dark(#0c1a2d,#081120);color:var(--nav-text);display:flex;flex-direction:column;gap:24px}.brand{display:flex;align-items:center;gap:10px;color:#fff;font-weight:720;font-size:22px;letter-spacing:-.025em}.brand small,.local small{display:block;color:var(--nav-muted);font-size:11px;font-weight:650;letter-spacing:.11em}.brand .logo img{width:100%;height:100%;object-fit:contain}.logo{width:42px;height:42px;display:grid;place-items:center;color:#143643;background:#e6f8ee;border-radius:12px}.logo svg{width:25px;height:25px}.switcher{display:grid;gap:7px}.switcher label{color:var(--nav-muted);font-size:11px;font-weight:700}.switcher select{background:light-dark(#1a3353,#16294a);border-color:var(--nav-border);color:var(--nav-text)}.sidebar nav{display:grid;gap:4px}.sidebar button{background:transparent;border-color:transparent;color:var(--nav-text);justify-content:flex-start;padding:11px 10px}.sidebar button:hover{background:light-dark(#1a3353,#16294a)}.sidebar .quiet{font-size:13px;padding:6px 4px}.sidebar nav button[aria-current]{background:light-dark(#14402f,#14352b);color:#a9ecc9}.nav-caption{display:block;color:var(--nav-muted);font-size:11px;font-weight:750;padding:3px 10px 4px}.local{display:flex;gap:10px;align-items:center;color:var(--nav-text);font-size:13px;margin-top:auto}.top{background:var(--surface);border-bottom:var(--bd);padding:14px 28px;display:flex;align-items:center;justify-content:space-between;color:var(--muted);gap:10px;font-size:13px}.top strong{color:var(--ink)}.slash{margin:0 7px;color:var(--muted)}.top-side{display:inline-flex;align-items:center;gap:12px}.header-counters{color:var(--muted);font-size:13px;font-weight:600}.top-tools{display:inline-flex;gap:6px;align-items:center}.icon-button{padding:6px}.top-tools .icon-button{color:var(--muted)}.top-tools .icon-button[aria-pressed="true"]{color:var(--green);border-color:var(--green)}.top-search input{background:light-dark(#1a3353,#16294a);border:1px solid var(--nav-border);color:var(--nav-text);border-radius:8px;padding:6px 10px;min-width:200px;font:inherit}.top-search input::placeholder{color:var(--nav-muted)}.badge,.tag{font-size:12px;color:var(--ok-ink);background:var(--tint);display:inline-flex;align-items:center;padding:4px 8px;border-radius:100px;font-weight:650;white-space:nowrap}.dot{width:7px;height:7px;border-radius:50%;background:var(--green)}.news-badge{padding:1px 7px;border-radius:100px;background:#d9534f;color:#fff;font-size:11px;font-weight:750}.page{max-width:1340px;margin:auto;padding:28px}.app-footer{padding-top:12px;border-top:var(--bd);color:var(--muted);font-size:12px}.heading{display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;margin-bottom:24px}.heading p{font-size:13px}.eyebrow{font-weight:750;font-size:11px;letter-spacing:.14em;color:var(--green);overflow-wrap:anywhere}h1{font-size:30px;font-weight:720;line-height:1.12;margin:6px 0}h2{font-size:17px;font-weight:650;margin:0}h3{font-size:16px;margin:0}p{margin:0;color:var(--muted)}.offline-banner{margin:0;padding:10px 28px;background:var(--danger-bg);color:var(--danger)}#status{margin:0 0 12px;padding:11px 13px;background:var(--tint);white-space:pre-line;overflow-wrap:anywhere;color:var(--ink)}#status[data-error=true]{background:var(--danger-bg);color:var(--danger)}body.drag-active::after{content:"Suelta los archivos para importar";position:fixed;inset:auto 0 22px 0;margin:0 auto;width:max-content;max-width:92vw;background:var(--green);color:light-dark(#fff,#06231a);padding:11px 18px;border-radius:100px;font-weight:700;z-index:60}
