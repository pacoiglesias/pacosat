/* ===== Declaraciones y acuses recuperados (1.9.0, punto 7) =====
   Sección del Centro SAT: con la misma sesión de e.firma del
   descargador, PacoSAT busca en el portal las declaraciones
   PRESENTADAS y baja la declaración y su acuse como documentos
   DISTINTOS (quedan así en Expedientes). La rejilla por ejercicio
   dice de un vistazo qué periodos ya están recuperados, cuáles
   faltan y cuáles aún no tocan. Dos conectores separados en el
   servidor: mensuales (búsqueda + acuses) y anual (su PDF).
   1.10.3: la pantalla consume el contrato REAL del servidor
   (declaracionesOverview): la rejilla sale de view.mensuales
   (periodo + estado), los documentos de view.documentos (label,
   fechaPresentacion, operacion, fileId) y la recuperación publica
   el campo tipo ('mensual' | 'anual'), que es el que el servidor
   espera. Antes leía claves que el servidor nunca emitió (la
   rejilla como «months», la fecha como «presentada») y publicaba
   el tipo como «kind»: con la respuesta real, la lista no se
   pintaba y la recuperación la rechazaba el servidor. */
const DECL_MESES = ['Enero', 'Febrero', 'Marzo', 'Abril', 'Mayo', 'Junio',
  'Julio', 'Agosto', 'Septiembre', 'Octubre', 'Noviembre', 'Diciembre'];
let declEjercicio = new Date().getFullYear();
let declCache = null;
function declaracionesSection() {
  const section = panel('Declaraciones y acuses',
    'Recupera del SAT las declaraciones que ya presentaste y sus acuses: la declaración y el acuse se guardan como documentos distintos en Expedientes, con su ejercicio, periodo y número de operación. Lo que falte se ve en la rejilla, en lenguaje llano.');
  const body = n('div');
  section.append(body);
  const fill = async data => {
    const view = data || (scope ? await satApi('declaraciones?rfc=' + encodeURIComponent(scope) + '&ejercicio=' + declEjercicio) : null);
    body.replaceChildren();
    if (!satToken) {
      body.append(n('p', 'La recuperación vive en el servidor de tu casa (el NAS): abre PacoSAT desde el servidor para usarla.', 'empty'));
      return;
    }
    if (!scope) {
      body.append(n('p', 'Elige arriba el RFC del que quieres ver y recuperar declaraciones.', 'empty'));
      return;
    }
    declCache = view;
    const head = n('div', undefined, 'sat-card-head');
    head.append(n('strong', 'RFC ' + scope));
    const yearPicker = select(
      [0, 1, 2, 3, 4].map(back => { const y = new Date().getFullYear() - back; return [String(y), 'Ejercicio ' + y]; }),
      String(declEjercicio), 'Ejercicio');
    yearPicker.onchange = () => { declEjercicio = Number(yearPicker.value); fill(); };
    head.append(yearPicker);
    const runMensuales = n('button', 'Recuperar mensuales del ejercicio', 'primary small');
    runMensuales.onclick = () => declRun('mensuales', fill, runMensuales);
    const runAnual = n('button', 'Recuperar la anual', 'soft small');
    runAnual.onclick = () => declRun('anual', fill, runAnual);
    head.append(runMensuales, runAnual);
    body.append(head);
    if (view.lastError) body.append(n('p', 'Último intento: ' + view.lastError.error, 'error-text'));
    /* Rejilla de periodos: recuperada / sin recuperar / aún no toca.
       El servidor la emite como view.mensuales: 12 entradas con
       periodo «AAAA-MM» y estado ya calculado. */
    const grid = n('div', undefined, 'decl-grid');
    for (const mes of view.mensuales) {
      const cell = n('div', undefined, 'decl-cell decl-' + mes.estado);
      cell.append(n('strong', DECL_MESES[Number(mes.periodo.slice(5, 7)) - 1] || mes.periodo),
        n('span', mes.estado === 'recuperada' ? '✓ recuperada' :
          mes.estado === 'sin-recuperar' ? 'sin recuperar' : 'aún no toca'));
      grid.append(cell);
    }
    body.append(grid);
    /* La anual del servidor es {declaracion, acuse, estado}; el
       número de operación vive en sus documentos, no en el resumen. */
    const anualOp = (view.documentos || []).find(doc => doc.tipo === 'anual' && doc.operacion);
    const anual = n('p', view.anual.estado === 'recuperada'
      ? 'Declaración anual ' + view.ejercicio + ': ✓ recuperada' + (anualOp ? ' (operación ' + anualOp.operacion + ')' : '') + '.'
      : 'Declaración anual ' + view.ejercicio + ': sin recuperar.', 'muted');
    body.append(anual);
    /* Documentos recuperados: declaración y acuse, distinguidos. */
    if (!view.documentos.length) {
      body.append(empty('Nada recuperado todavía para este ejercicio',
        'Pulsa «Recuperar mensuales del ejercicio» o «Recuperar la anual»: PacoSAT entra al portal con tu e.firma y archiva aquí lo que encuentre presentado.'));
      return;
    }
    const list = n('div');
    for (const doc of view.documentos) {
      const row = n('div', undefined, 'cp-row');
      row.append(statusPill(doc.clase === 'acuse' ? 'warn' : 'ok', doc.clase === 'acuse' ? 'Acuse' : 'Declaración'),
        n('span', doc.label + ' · ' + (doc.tipo === 'mensual' ? 'periodo ' + doc.periodo : 'ejercicio ' + doc.ejercicio) +
          (doc.fechaPresentacion ? ' · presentada el ' + (/^\d{4}-\d{2}-\d{2}/.test(doc.fechaPresentacion)
            ? doc.fechaPresentacion.slice(0, 10) : doc.fechaPresentacion) : '') +
          (doc.operacion ? ' · operación ' + doc.operacion : '')));
      /* Un clic en «Ver» abre el documento dentro de la app
         (1.10.2); sin fileId en la fila, queda el camino de siempre
         a Expedientes. */
      const open = n('button', doc.fileId ? 'Ver' : 'Ver en Expedientes', 'soft small');
      open.onclick = () => doc.fileId
        ? viewDocOnline({ id: doc.fileId, rfc: scope, kind: doc.label || 'Declaración',
            name: (doc.label || 'Declaración') + ' · ' + scope + '.pdf' })
        : navigate('docs');
      row.append(open);
      list.append(row);
    }
    body.append(list);
  };
  fill().catch(error => { body.replaceChildren(n('p', error.message, 'error-text')); });
  return section;
}
async function declRun(kind, fill, button) {
  button.disabled = true;
  const original = button.textContent;
  button.textContent = 'Entrando al portal con tu e.firma…';
  try {
    /* El servidor espera {tipo}: 'mensual' | 'anual' (1.10.3). Su
       respuesta es {result, view}: result.ok / result.saved /
       result.warnings, y view es el mismo overview que pinta fill. */
    const data = await satApi('declaraciones/run',
      { rfc: scope, ejercicio: declEjercicio, tipo: kind === 'anual' ? 'anual' : 'mensual' });
    const result = data.result || {};
    if (!result.ok) {
      toast(result.error || 'La recuperación no pudo completarse.', 'error');
      fill(data.view);
      return;
    }
    const saved = result.saved || 0;
    const warnings = (result.warnings || []).length;
    toast(saved
      ? 'Recuperados ' + saved + ' documento(s) del portal y archivados en Expedientes.'
      : 'El portal no devolvió documentos nuevos para este ejercicio' + (warnings ? ' (' + warnings + ' aviso(s) en el detalle).' : '.'),
      saved ? 'ok' : 'error');
    await refresh();
    fill(data.view);
  } catch (error) { toast(error.message, 'error'); fill(); }
  finally { button.disabled = false; button.textContent = original; }
}
