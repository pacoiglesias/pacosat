/* ===== Bancos (1.6.19) =====
   Archivo de estados de cuenta por banco/cuenta/mes: subida del PDF,
   lectura automática de saldos (lo no leído se confirma a mano, nunca
   se inventa), cadena de saldos entre meses, faltantes y posición
   total. Vive en el servidor (NAS); sus movimientos alimentan la
   conciliación de Dinero. */
const BANK_QUICK = [['BBVA', 'Cuenta Maestra Pyme', 'cuenta'], ['BBVA', 'Fondo', 'fondo'],
  ['BBVA', 'Tarjeta de crédito', 'tarjeta'],
  ['Santander', 'Cuenta de cheques', 'cuenta'], ['Santander', 'FONSER1', 'fondo'], ['Konfio', 'Cuenta', 'cuenta']];
function bancosScreen() {
  const wrap = n('div');
  if (!satToken) {
    const panelEl = panel('Bancos vive en tu servidor', 'Los estados de cuenta se archivan y se leen en el servidor de casa (el NAS), no en este navegador. Abre PacoSAT desde el servidor para usar esta pantalla.');
    wrap.append(panelEl);
    return [wrap];
  }
  const body = n('div');
  wrap.append(body);
  const draw = data => {
    body.replaceChildren();
    /* Posición */
    const position = panel('Posición total', 'La suma de los últimos saldos finales archivados, por banco y en total. Cada saldo enseña el mes de su estado: la suma nunca mezcla meses en silencio (1.28.0, P10).');
    const strip = n('div', undefined, 'traffic-strip');
    strip.append(statusPill('ok', 'Total: $' + data.position.total + (data.position.asOf ? ' · a ' + data.position.asOf : '')));
    for (const [bank, total] of Object.entries(data.position.byBank))
      strip.append(statusPill('dim', bank + ': $' + total));
    position.append(strip);
    /* El mes de CADA cuenta que compone la suma, y el aviso si
       no coinciden: antes el total podía mezclar octubre de una
       cuenta con septiembre de otra sin decirlo. */
    const cuentas = data.position.cuentas || [];
    if (cuentas.length) {
      const meses = new Set(cuentas.map(cuenta => cuenta.mes));
      for (const cuenta of cuentas)
        position.append(n('p', cuenta.banco + (cuenta.nombre ? ' · ' + cuenta.nombre : '') +
          ': $' + cuenta.saldo + ' — saldo de ' + cuenta.mes + '.', 'today-line'));
      if (meses.size > 1) {
        const avisoMeses240 = n('p', 'Ojo: el total suma saldos de meses distintos (' + [...meses].sort().join(', ') +
          '): cada cuenta aporta su último estado archivado. Sube el estado que falta y la posición queda de un solo mes.', 'today-line');
        avisoMeses240.dataset.estado = 'atencion';
        position.append(avisoMeses240);
      }
    }
    body.append(position);
    /* Tanda 6: el botón único protagonista y las vistas nuevas. */
    body.append(bancosAutoPanel200f(draw, data));
    body.append(bancosConciliacionPanel200f());
    /* (2.8.0 · diseño 9) La conciliación asistida/CSV que
       vivía en Dinero se muda aquí: la conciliación vive
       solo en Bancos y Dinero enlaza. */
    if (typeof reconcilePanel === 'function')
      body.append(reconcilePanel(typeof paidByMap === 'function' ? paidByMap() : new Map()));
    body.append(bancosReglasPanel240());
    body.append(bancosSinRastroPanel201());
    body.append(bancosContrapartesPanel200f());
    if (!data.accounts.length) {
      const empty = panel('Tus cuentas', 'Da de alta la primera cuenta con un toque o con el formulario. Después sube el PDF de cada mes y PacoSAT lee los saldos.');
      const chips = n('div', undefined, 'traffic-strip');
      for (const [bank, name, kind] of BANK_QUICK) {
        const chip = n('button', bank + ' · ' + name, 'soft small');
        chip.onclick = async () => { await satApi('banks/accounts', { bank, name, kind }); announce('Cuenta creada.'); refresh(); };
        chips.append(chip);
      }
      empty.append(chips);
      body.append(empty);
    }
    /* M1 (1.22.0): con un contribuyente elegido, se enseñan sus
       cuentas y las que aún no tienen dueño (marcadas); con
       «Todos», todas con su dueño a la vista. */
    for (const account of data.accounts) {
      if (scope && account.rfc && account.rfc !== scope) continue;
      body.append(bankAccountPanel(account, draw));
    }
    body.append(bankAccountForm(draw));
  };
  satApi('banks').then(draw).catch(error => { body.append(panel('Bancos', 'No se pudo cargar: ' + error.message)); });
  return [wrap];
}
function bankAccountPanel(account, draw) {
  const title = account.bank + ' · ' + account.name + (account.last4 ? ' ····' + account.last4 : '') +
    (account.rfc ? ' · de ' + account.rfc : ' · sin RFC dueño');
  const panelEl = panel(title, account.position ? 'Último saldo: $' + account.position.closing + ' (' + account.position.month + ').' : 'Aún sin estados archivados.');
  const strip = n('div', undefined, 'traffic-strip');
  strip.append(statusPill(account.missing.length ? 'warn' : 'ok',
    account.missing.length ? 'Faltan ' + account.missing.length + ' meses: ' + account.missing.slice(0, 4).join(', ') + (account.missing.length > 4 ? '…' : '') : 'Sin meses faltantes'));
  strip.append(statusPill(account.chainBroken ? 'bad' : 'ok', account.chainBroken ? 'Cadena de saldos ROTA (ver el mes marcado)' : 'Cadena de saldos continua'));
  panelEl.append(strip);
  /* (2.9.13 · mejora 17) El saldo de la cuenta, EN GRANDE, y
     el mes que falta con su botón de subirlo A LA VISTA: el
     botón deja el formulario de subida de abajo con ese mes
     puesto y lleva hasta él — el estado que falta no se
     queda en una pastilla sin gesto. El gráfico de
     movimientos es el saldo vivo de debajo (90 días). */
  if (account.position) {
    const heroSaldo2913 = n('div', undefined, 'total-hero');
    heroSaldo2913.append(n('span', 'Saldo al cierre de ' + mesTexto200f(account.position.month), 'tramite-detalle'),
      n('strong', '$' + account.position.closing, 'banco-saldo2913'));
    panelEl.append(heroSaldo2913);
  }
  let subirFalta2913 = null;
  if (account.missing.length) {
    const filaFalta2913 = n('div', undefined, 'cp-row');
    filaFalta2913.append(n('span', 'Falta el estado de ' + mesTexto200f(account.missing[0]) +
      (account.missing.length > 1 ? ' (y ' + (account.missing.length - 1) + ' más)' : '') + '.'));
    subirFalta2913 = n('button', 'Subir el estado de ' + mesTexto200f(account.missing[0]), 'primary small');
    subirFalta2913.type = 'button';
    filaFalta2913.append(subirFalta2913);
    panelEl.append(filaFalta2913);
  }
  /* Asignar el RFC dueño a la cuenta EXISTENTE (el servidor lo
     acepta desde la 1.22.0 — M1 —; el control llega en la
     1.27.0): una cuenta sin dueño, o con el dueño equivocado,
     se asigna aquí sin borrarla ni recrearla — es la pasada de
     datos previa a dar de alta un segundo contribuyente. */
  const ownerForm = n('div', undefined, 'sat-form');
  const ownerSel = select([['', 'Sin RFC dueño (se ve en todos)'],
    ...people.map(p => [p.id, (p.name || p.id) + ' · ' + p.id])], account.rfc || '', 'RFC dueño');
  const assignBtn = n('button', 'Asignar dueño', 'soft small');
  assignBtn.onclick = async () => {
    try { const data = await satApi('banks/accounts', { id: account.id, rfc: ownerSel.value });
      announce(ownerSel.value ? 'Cuenta asignada a ' + ownerSel.value + '.' : 'Cuenta sin RFC dueño: se ve en todos.'); draw(data); }
    catch (error) { toast(error.message, 'error'); }
  };
  ownerForm.append(fieldWrap('RFC dueño de esta cuenta', ownerSel), assignBtn);
  panelEl.append(ownerForm);
  for (const statement of account.statements) {
    const row = n('div', undefined, 'cp-row');
    /* Marca del mes en la fila (1.31.0): el saldo vivo salta
       hasta AQUÍ, a su estado de cuenta, al tocar su línea. */
    row.dataset.statementMonth = statement.month;
    row.append(statusPill(statement.chain === 'broken' ? 'bad' : statement.state === 'ok' ? 'ok' : statement.state === 'manual' ? 'ok' : 'warn', statement.month),
      n('span', (statement.detected ? statement.detected + ' · ' : '') + 'inicial ' + (statement.opening ?? '¿?') +
        ' → final ' + (statement.closing ?? '¿?') + ' · ' + statement.movements + ' movimientos' +
        (statement.state === 'review' ? ' · A REVISAR: confirma los saldos' : statement.state === 'manual' ? ' · confirmado a mano' : '')));
    if (statement.chainDetail) row.title = statement.chainDetail;
    if (statement.state === 'review') {
      const confirmBtn = n('button', 'Confirmar saldos', 'soft small');
      confirmBtn.onclick = () => bankConfirmDialog(statement, draw);
      row.append(confirmBtn);
    }
    const del = n('button', 'Quitar', 'soft small');
    /* Confirmación con el diálogo propio (1.18.0): borrar un estado
       ya no es un clic sin red. */
    del.onclick = () => dialog('Quitar este estado de cuenta',
      [n('p', 'Se elimina el estado de ' + statement.month + ' de esta cuenta, con su lectura de saldos y movimientos. La cuenta y los demás estados quedan como están.')],
      async () => { await satApi('banks/statements/delete', { id: statement.id }); announce('Estado eliminado.'); refresh(); }, 'Quitar estado');
    row.append(del);
    panelEl.append(row);
    if (statement.chainDetail) {
      const cadena240 = n('p', statement.chainDetail, 'error-text');
      cadena240.dataset.estado = 'atencion';
      panelEl.append(cadena240);
    }
  }
  /* V13 · Saldo vivo (1.31.0): la línea del saldo de esta
     cuenta en los últimos 90 días, bajo sus estados. */
  const saldoBox = n('div');
  panelEl.append(saldoBox);
  bancosSaldoVivo1310(saldoBox, account, panelEl);
  /* Subida */
  const form = n('div', undefined, 'sat-form');
  const month = input('month', { value: previousMonthKey() });
  const file = input('file', { accept: 'application/pdf' });
  const upload = n('button', 'Subir y leer el estado', 'soft');
  upload.onclick = async () => {
    try {
      check(file.files?.[0], 'Elige el PDF del estado de cuenta.');
      check(/^\d{4}-\d{2}$/.test(month.value), 'Elige el mes del estado.');
      const content = encode64(new Uint8Array(await file.files[0].arrayBuffer()));
      const data = await satApi('banks/statements', { accountId: account.id, month: month.value, content });
      announce('Estado archivado y leído. Revisa sus saldos en la lista.');
      soundCue('success');
      draw(data);
    } catch (error) { toast(error.message, 'error'); }
  };
  form.append(fieldWrap('Mes del estado', month), fieldWrap('PDF', file), upload);
  /* El botón del mes que falta (mejora 17) aterriza aquí:
     pone su mes en este formulario y trae la vista hasta él. */
  if (subirFalta2913) subirFalta2913.onclick = () => {
    month.value = account.missing[0];
    form.scrollIntoView({ behavior: 'smooth', block: 'center' });
    file.focus();
  };
  const delAccount = n('button', 'Eliminar esta cuenta y sus estados', 'soft');
  delAccount.onclick = () => dialog('Eliminar esta cuenta y sus estados',
    [n('p', 'Se elimina la cuenta completa con TODOS sus estados archivados y su conciliación. No hay deshacer: si solo sobra un estado, quítalo a él desde su fila.')],
    async () => { await satApi('banks/accounts', { delete: account.id }); announce('Cuenta eliminada.'); refresh(); }, 'Eliminar cuenta');
  panelEl.append(form, delAccount);
  return panelEl;
}
function bankConfirmDialog(statement, draw) {
  const form = n('form', undefined, 'dialog-form');
  form.append(n('h3', 'Confirmar saldos · ' + statement.month),
    n('p', 'La lectura automática no pudo asegurar estas cifras. Escríbelas tal como vienen en el estado: PacoSAT no inventa importes.', 'muted'));
  const opening = input('text', { value: statement.opening || '', inputmode: 'decimal' });
  const closing = input('text', { value: statement.closing || '', inputmode: 'decimal' });
  const credits = input('text', { value: statement.credits || '', inputmode: 'decimal' });
  const charges = input('text', { value: statement.charges || '', inputmode: 'decimal' });
  form.append(fieldWrap('Saldo inicial', opening), fieldWrap('Saldo final', closing),
    fieldWrap('Total de abonos (opcional)', credits), fieldWrap('Total de cargos (opcional)', charges));
  const save = n('button', 'Guardar cifras confirmadas', 'primary');
  save.type = 'submit';
  form.onsubmit = async event => {
    event.preventDefault();
    try {
      const data = await satApi('banks/statements/confirm', { id: statement.id, opening: opening.value, closing: closing.value, credits: credits.value, charges: charges.value });
      closeDialog(); announce('Saldos confirmados.'); draw(data);
    } catch (error) { toast(error.message, 'error'); }
  };
  const cancel = n('button', 'Cancelar', 'soft');
  cancel.type = 'button';
  cancel.onclick = closeDialog;
  form.append(save, cancel);
  showDialog(form);
}
function bankAccountForm(draw) {
  const panelEl = panel('Añadir otra cuenta', 'Banco y nombre libres: sirve para cualquier banco, cuenta o fondo.');
  const form = n('div', undefined, 'sat-form');
  const bank = input('text', { placeholder: 'BBVA, Santander, Konfio…' });
  const name = input('text', { placeholder: 'Cuenta principal, Fondo…' });
  const last4 = input('text', { placeholder: 'Últimos 4 (opcional)', maxlength: '4' });
  /* M1: la cuenta nace con su RFC dueño (el elegido arriba o el
     que se seleccione aquí). */
  const owner = select([['', 'Sin RFC dueño (se ve en todos)'],
    ...people.map(p => [p.id, (p.name || p.id) + ' · ' + p.id])], scope || '', 'RFC dueño');
  const numero = input('text', { placeholder: 'Número o CLABE completo (opcional)', inputmode: 'numeric' });
  const add = n('button', 'Crear cuenta', 'soft');
  add.onclick = async () => {
    try { const data = await satApi('banks/accounts', { bank: bank.value, name: name.value, last4: last4.value, numero: numero.value, rfc: owner.value }); announce('Cuenta creada.'); draw(data); }
    catch (error) { toast(error.message, 'error'); }
  };
  form.append(fieldWrap('Banco', bank), fieldWrap('Nombre', name), fieldWrap('Terminación', last4), fieldWrap('Número o CLABE', numero), fieldWrap('RFC dueño', owner), add);
  panelEl.append(form);
  return panelEl;
}
/* V13 · Saldo vivo (1.31.0): por cuenta, la línea del saldo en
   los últimos 90 días de movimientos leídos. El saldo inicial
   es el del estado del mes en que empieza el periodo SI CONSTA
   (su «opening»); si no consta, la línea es el acumulado desde
   el movimiento más antiguo del periodo y se dice así — no se
   le inventa un saldo de partida a ninguna cuenta. La ventana
   se ancla en el último movimiento leído: con estados viejos,
   la línea enseña sus 90 días, no un hueco hasta hoy. Tocar la
   línea lleva a la fila de su estado de cuenta en este panel. */
let bancosMovsCache1310 = null;
function bancosMovimientos1310() {
  if (!bancosMovsCache1310)
    bancosMovsCache1310 = satApi('banks/movements').then(data => data.movements || []).catch(() => []);
  return bancosMovsCache1310;
}
async function bancosSaldoVivo1310(box, account, panelEl) {
  try {
    const todos = await bancosMovimientos1310();
    if (!box.isConnected) return;
    const movs = todos.filter(mv => mv.accountId === account.id)
      .slice().sort((a, b) => String(a.date).localeCompare(String(b.date)));
    if (!movs.length) {
      box.append(n('p', 'Saldo vivo: aún no hay movimientos leídos de esta cuenta.', 'muted'));
      return;
    }
    const centsDe = mv => mv.amountCents !== undefined ? Number(mv.amountCents) : Number(moneyCents(mv.amount || '0'));
    const ultimoMs = Date.parse(movs[movs.length - 1].date + 'T12:00:00');
    const periodo = movs.filter(mv => Date.parse(mv.date + 'T12:00:00') >= ultimoMs - 90 * 86400000);
    const mesInicio = periodo[0].date.slice(0, 7);
    const estadoBase = (account.statements || []).find(st => st.month === mesInicio) ||
      (account.statements || []).filter(st => st.month < mesInicio)
        .sort((a, b) => String(a.month).localeCompare(String(b.month))).pop() || null;
    let base = estadoBase && estadoBase.opening !== null && estadoBase.opening !== undefined && estadoBase.opening !== ''
      ? Number(moneyCents(estadoBase.opening)) : null;
    const baseNota = base !== null
      ? 'desde el saldo inicial del estado de ' + estadoBase.month
      : 'acumulado desde el movimiento más antiguo del periodo (no consta saldo inicial del estado)';
    if (base === null) base = 0;
    let saldo = base;
    const puntos = periodo.map(mv => { saldo += centsDe(mv); return { date: mv.date, saldo }; });
    const NS = 'http://www.w3.org/2000/svg';
    const el = (tag, attrs, text) => {
      const node = document.createElementNS(NS, tag);
      for (const [name, value] of Object.entries(attrs || {})) node.setAttribute(name, value);
      if (text) node.textContent = text;
      return node;
    };
    const W = 320, H = 92, pad = 8;
    let min = Math.min(base, ...puntos.map(p => p.saldo)), max = Math.max(base, ...puntos.map(p => p.saldo));
    if (min === max) { min -= 100; max += 100; }
    const xDe = i => puntos.length === 1 ? W / 2 : pad + i * (W - 2 * pad) / (puntos.length - 1);
    const yDe = valor => H - pad - (valor - min) / (max - min) * (H - 2 * pad);
    const svg = el('svg', { viewBox: '0 0 ' + W + ' ' + H, class: 'chart', role: 'img',
      'aria-label': 'Saldo vivo de la cuenta en los últimos 90 días de movimientos' });
    svg.append(el('title', {}, 'Saldo vivo · último saldo: $' + centsLabel(BigInt(Math.round(saldo)))));
    const linea = el('polyline', { class: 'saldo-line',
      points: puntos.map((p, i) => xDe(i).toFixed(1) + ',' + yDe(p.saldo).toFixed(1)).join(' ') });
    svg.append(linea);
    const ultimoPunto = puntos[puntos.length - 1];
    svg.append(el('circle', { cx: xDe(puntos.length - 1), cy: yDe(ultimoPunto.saldo), r: 3.5, class: 'saldo-punto' }));
    svg.style.cursor = 'pointer';
    /* Clicable hasta su estado de cuenta: la fila del estado
       del mes del último movimiento, en este mismo panel. */
    svg.addEventListener('click', () => {
      const fila = panelEl.querySelector('[data-statement-month="' + ultimoPunto.date.slice(0, 7) + '"]') ||
        panelEl.querySelector('[data-statement-month]');
      if (fila) fila.scrollIntoView({ behavior: 'smooth', block: 'center' });
    });
    box.append(n('p', 'Saldo vivo (90 días): $' + centsLabel(BigInt(Math.round(saldo))) + ' · ' + baseNota +
      '. Toca la línea para ir a su estado de cuenta.', 'today-line'), svg);
  } catch { /* el saldo vivo es un extra: sin él, la cuenta sigue en su panel */ }
}

/* ===== Tanda 6 (2.0) · Bancos: subida única, conciliación y
   contrapartes =====
   Pieza 1: UN botón «Subir estado de cuenta» — eliges el archivo
   (en el móvil, también foto con la cámara) y el servidor detecta
   del propio documento el banco, la cuenta y el periodo. La
   tarjeta de confirmación ES la confirmación: al aplicar, el
   estado queda archivado en su cuenta, los movimientos se
   aplican, corre la conciliación y queda el Deshacer. Si la
   detección no es segura, se enseña la lista de cuentas con su
   identidad y el alta en el acto con lo detectado precargado. */
const MESES200F = ['enero', 'febrero', 'marzo', 'abril', 'mayo', 'junio', 'julio', 'agosto', 'septiembre', 'octubre', 'noviembre', 'diciembre'];
const mesTexto200f = key => /^\d{4}-\d{2}$/.test(key || '') ? MESES200F[Number(key.slice(5, 7)) - 1] + ' de ' + key.slice(0, 4) : (key || '');
function bancosAutoPanel200f(draw, data) {
  const panelEl = panel('Subir estado de cuenta', 'Un solo botón: eliges el PDF (o lo capturas con la cámara) y PacoSAT detecta el banco, la cuenta y el periodo del propio documento, te lo enseña y, con tu toque, lo archiva en su cuenta, aplica los movimientos y corre la conciliación. En escritorio también puedes arrastrar el archivo sobre este panel o pegarlo.');
  const file = input('file', { accept: 'application/pdf,image/*' });
  file.setAttribute('capture', 'environment');
  file.hidden = true;
  const btn = n('button', 'Subir estado de cuenta', 'primary');
  btn.onclick = () => file.click();
  const box = n('div');
  panelEl.append(btn, file, box);
  /* UN solo camino de entrada (2.0.1 · nº 25): el botón, el
     arrastre y el pegado pasan por la MISMA lectura y la
     MISMA tarjeta de confirmación (bancosAutoTarjeta200f).
     Nada se archiva sin esa confirmación, venga de donde
     venga el archivo. */
  const procesarArchivo = async archivo => {
    if (!archivo) return;
    box.replaceChildren(n('p', 'Leyendo el documento…', 'muted'));
    try {
      const content = encode64(new Uint8Array(await archivo.arrayBuffer()));
      const r = await satApi('banks/detect', { content });
      bancosAutoTarjeta200f(box, content, r.deteccion, draw, data);
    } catch (error) { box.replaceChildren(n('p', 'No se pudo leer el documento: ' + error.message, 'error-text')); }
  };
  file.onchange = async () => {
    if (!file.files?.[0]) return;
    await procesarArchivo(file.files[0]);
    file.value = '';
  };
  panelEl.addEventListener('dragover', event => { event.preventDefault(); });
  panelEl.addEventListener('drop', event => {
    event.preventDefault();
    const archivo = event.dataTransfer?.files?.[0];
    if (archivo) procesarArchivo(archivo);
  });
  /* El pegado, por instancia VIVA (integración 2.3.2, hallazgo
     de camino de B5): el oyente de `paste` vive en document y
     se registra UNA sola vez (window.__bancosPegar201), pero
     ya no queda ligado a la primera instancia del panel —
     cada instancia nueva se anuncia como la actual en
     window.__bancosPegarActual201 y el oyente delega en ESA:
     su panel (isConnected), su caja y su procesarArchivo.
     Antes, al salir de Bancos y volver, el panel nuevo no
     tenía oyente y el viejo comprobaba su propio isConnected
     (ya falso): el pegado quedaba mudo. Así no se duplica
     ningún oyente por muchas veces que se entre en Bancos,
     y una instancia muerta nunca procesa: la actual es la
     conectada o el gesto se ignora, como el drop, que se
     liga a cada panel y muere con él. */
  if (typeof window !== 'undefined')
    window.__bancosPegarActual201 = { panelEl, procesarArchivo };
  if (typeof document !== 'undefined' && !window.__bancosPegar201) {
    window.__bancosPegar201 = true;
    document.addEventListener('paste', event => {
      const actual = window.__bancosPegarActual201;
      if (!actual || !actual.panelEl.isConnected || typeof page === 'undefined' || page !== 'dinero' ||
          typeof dineroTab === 'undefined' || dineroTab !== 'bancos') return;
      if (document.querySelector('dialog[open]')) return;
      const archivo = [...(event.clipboardData?.files || [])][0];
      if (archivo) { event.preventDefault(); actual.procesarArchivo(archivo); }
    });
  }
  return panelEl;
}
/* ===== «Sin rastro» (2.0.1 · nº 30) =====
   Las facturas del periodo sin movimiento que las respalde,
   desde facturasSinPagoVisto de la conciliación del servidor.
   SOLO LECTURA: una lista de revisión — no enlaza, no marca,
   no toca el cálculo ni la conciliación; su único gesto es
   abrir la factura para mirarla. */
function bancosSinRastroPanel201() {
  const panelEl = panel('Sin rastro', 'Facturas del periodo sin ningún movimiento que las respalde en sus cuentas. Solo revisión: esta lista no cambia la conciliación.');
  const mes = input('month', { value: previousMonthKey() });
  const out = n('div');
  const cargar = n('button', 'Ver las facturas sin rastro', 'soft');
  cargar.type = 'button';
  cargar.onclick = async () => {
    out.replaceChildren(n('p', 'Buscando facturas sin rastro…', 'muted'));
    try {
      const data = await satApi('banks/conciliacion?month=' + encodeURIComponent(mes.value));
      out.replaceChildren();
      let total = 0;
      for (const vista of data.porCuenta || []) {
        const sinRastro = vista.facturasSinPagoVisto || [];
        if (!sinRastro.length) continue;
        total += sinRastro.length;
        out.append(n('h3', vista.account.banco + ' · ' + vista.account.nombre +
          (vista.account.last4 ? ' ····' + vista.account.last4 : '')));
        for (const inv of sinRastro) {
          const row = n('div', undefined, 'cp-row');
          row.append(statusPill('warn', 'Sin rastro'),
            n('span', (typeof localDate === 'function' ? localDate(inv.date) : inv.date) + ' · ' + (inv.from?.name || inv.from?.rfc || '') + ' · $' + inv.total +
              ' · ' + inv.uuid.slice(0, 8) + '…'));
          const ver = n('button', 'Ver factura', 'soft small');
          ver.type = 'button';
          ver.onclick = () => { const target = invoices.find(r => r.id === inv.uuid); if (target) invoiceDetail(target); };
          row.append(ver);
          out.append(row);
        }
      }
      if (!total) out.append(n('p', 'Sin facturas sin rastro en ' + mesTexto200f(mes.value) +
        ': toda factura del periodo tiene su movimiento, o no hay facturas del periodo en las cuentas.', 'muted'));
    } catch (error) { out.replaceChildren(n('p', 'No se pudo leer: ' + error.message, 'error-text')); }
  };
  panelEl.append(fieldWrap('Periodo', mes), cargar, out);
  return panelEl;
}
function bancosAutoTarjeta200f(box, content, det, draw, data) {
  box.replaceChildren();
  const cuentas = det.cuentas || (data && data.accounts) || [];
  const elegida = det.accountId ? cuentas.find(c => c.id === det.accountId) : null;
  const titular = (det.banco || 'Banco no nombrado en el estado') +
    (elegida ? ' · ' + elegida.nombre + (elegida.last4 ? ' ····' + elegida.last4 : '') : '') +
    ' · ' + (det.periodo ? mesTexto200f(det.periodo) : 'periodo sin detectar') +
    ' · ' + det.movimientos + ' movimientos · Saldo final $' + (det.saldoFinal ?? '¿?') + ' según el estado';
  box.append(n('p', titular + (det.segura ? ' — ¿Lo archivo y lo aplico?' : ''), 'strong-line'));
  if (det.via) box.append(n('p', 'Cuenta detectada por ' + det.via + '.', 'muted'));
  if (!det.segura && det.motivo) box.append(n('p', det.motivo + ' Señala la cuenta:', 'muted'));
  const fila = n('div', undefined, 'actions');
  const aplicarCon = async (accountId, month) => {
    try {
      const r = await satApi('banks/statements/auto', { content, accountId: accountId || undefined, month: month || undefined });
      box.replaceChildren();
      box.append(n('p', 'Aplicado: ' + r.aplicados + ' movimiento(s) en su cuenta' +
        (r.duplicadosOmitidos ? ' · ' + r.duplicadosOmitidos + ' duplicado(s) omitido(s)' : '') +
        '. La conciliación corrió: mira la vista «Conciliación» de esta pantalla.', 'strong-line'));
      const deshacer = n('button', 'Deshacer', 'soft');
      deshacer.onclick = async () => {
        try { const d2 = await satApi('banks/statements/delete', { id: r.statementId });
          announce('Estado retirado: el Deshacer quedó asentado en el Registro.'); draw(d2); }
        catch (error) { toast(error.message, 'error'); }
      };
      box.append(deshacer);
      soundCue('success');
      draw(r);
    } catch (error) { toast(error.message || 'No se pudo aplicar.', 'error'); }
  };
  if (det.segura) {
    const aplicar = n('button', 'Aplicar', 'primary');
    aplicar.onclick = () => aplicarCon(det.accountId, det.periodo);
    fila.append(aplicar);
  }
  const otra = n('button', det.segura ? 'Elegir otra cuenta' : 'Elegir la cuenta', 'soft');
  otra.onclick = () => {
    box.replaceChildren(n('p', titular, 'strong-line'), n('p', 'Toca la cuenta de este estado:', 'muted'));
    const lista = n('div');
    for (const cuenta of cuentas) {
      const b = n('button', cuenta.banco + ' · ' + cuenta.nombre + (cuenta.last4 ? ' ····' + cuenta.last4 : '') +
        (cuenta.rfc ? ' · de ' + cuenta.rfc : ' · sin RFC dueño'), 'soft small');
      b.onclick = () => {
        if (det.periodo) return aplicarCon(cuenta.id, det.periodo);
        const mes = input('month', { value: previousMonthKey() });
        box.replaceChildren(n('p', 'El estado no trae periodo legible. Elige su mes:', 'muted'), mes);
        const ok = n('button', 'Aplicar en esta cuenta', 'primary');
        ok.onclick = () => aplicarCon(cuenta.id, mes.value);
        box.append(ok);
      };
      lista.append(b);
    }
    box.append(lista);
    /* Alta en el acto, con lo detectado precargado. */
    const alta = n('details', undefined, 'seal-details');
    alta.append(n('summary', '¿No está dada de alta? Darla de alta con lo detectado'));
    const fBanco = input('text', { value: det.precarga?.bank || det.banco || '' });
    const fNombre = input('text', { placeholder: 'Nombre de la cuenta' });
    const fNumero = input('text', { value: det.precarga?.numero || '', inputmode: 'numeric' });
    const fOwner = select([['', 'Sin RFC dueño (se ve en todos)'],
      ...people.map(p => [p.id, (p.name || p.id) + ' · ' + p.id])], scope || '', 'RFC dueño');
    const crear = n('button', 'Crear la cuenta y aplicar el estado', 'primary');
    crear.onclick = async () => {
      try {
        const creada = await satApi('banks/accounts', { bank: fBanco.value, name: fNombre.value || 'Cuenta',
          numero: fNumero.value, last4: det.precarga?.last4 || '', rfc: fOwner.value });
        const nueva = creada.accounts[creada.accounts.length - 1];
        await aplicarCon(nueva.id, det.periodo);
      } catch (error) { toast(error.message, 'error'); }
    };
    alta.append(fieldWrap('Banco', fBanco), fieldWrap('Nombre', fNombre),
      fieldWrap('Número o CLABE detectado', fNumero), fieldWrap('RFC dueño', fOwner), crear);
    box.append(alta);
  };
  fila.append(otra);
  const cancelar = n('button', 'Cancelar', 'soft');
  cancelar.onclick = () => box.replaceChildren();
  fila.append(cancelar);
  box.append(fila);
}
/* Pieza 3 · Conciliación por cuenta y periodo, con la frase
   exacta «sin pago visto en esta cuenta» y enlace en un toque. */
function bancosConciliacionPanel200f() {
  const panelEl = panel('Conciliación', 'Por cuenta y periodo: las facturas sin pago visto en esta cuenta y los pagos sin factura de esa cuenta. Nada se afirma pagado sin enlace; enlazar y desenlazar queda en el Registro.');
  const out = n('div');
  const cargar = n('button', 'Ver la conciliación de este mes', 'soft');
  const mes = input('month', { value: previousMonthKey() });
  /* Imprimir la conciliación tal cual se ve (2.0.1, auditoría
     de salida): la vista de Bancos no tenía ningún «Imprimir»
     visible. Este imprime las filas de la conciliación cargada
     —cuenta, periodo, movimiento y su estado— por el ayudante
     único imprimirVista201; si aún no se ha cargado, la carga
     primero con el mismo cruce de siempre. */
  let vista201 = null, vista201Mes = '';
  const imprimir = n('button', 'Imprimir conciliación', 'soft');
  imprimir.type = 'button';
  imprimir.onclick = async () => {
    if (!vista201 || vista201Mes !== mes.value) await cargar.onclick();
    if (!vista201) return;
    const filas = [];
    for (const vista of vista201.porCuenta || []) {
      const cuenta = vista.account.banco + ' · ' + vista.account.nombre +
        (vista.account.last4 ? ' ····' + vista.account.last4 : '');
      for (const inv of vista.facturasSinPagoVisto || [])
        filas.push([cuenta, mes.value, (inv.date || '') + ' · ' + (inv.from?.name || inv.from?.rfc || '') +
          ' · ' + String(inv.uuid || '').slice(0, 8) + '…', '$' + inv.total, 'Sin pago visto en esta cuenta']);
      for (const pago of vista.pagosSinFactura || [])
        filas.push([cuenta, mes.value, (pago.movement?.date || '') + ' · ' + (pago.movement?.concept || ''),
          '$' + (pago.movement?.amount || ''), 'Pago sin factura']);
      for (const link of vista.enlazados || [])
        filas.push([cuenta, mes.value, (link.movement?.date || '') + ' · factura ' +
          String(link.uuid || '').slice(0, 8) + '…', '$' + (link.movement?.amount || ''), 'Enlazado']);
    }
    if (typeof imprimirVista201 === 'function')
      imprimirVista201('Conciliación de Bancos · ' + mes.value,
        (vista201.regla || '') + ' ' + number.format(filas.length) + ' fila(s) tal cual se ven en pantalla.',
        ['Cuenta', 'Periodo', 'Movimiento', 'Importe', 'Estado de conciliación'], filas);
    else window.print();
  };
  cargar.onclick = async () => {
    out.replaceChildren(n('p', 'Cruzando movimientos y facturas…', 'muted'));
    try {
      const data = await satApi('banks/conciliacion?month=' + encodeURIComponent(mes.value));
      vista201 = data; vista201Mes = mes.value;
      out.replaceChildren();
      out.append(n('p', data.regla, 'muted'));
      for (const vista of data.porCuenta) {
        out.append(n('h3', vista.account.banco + ' · ' + vista.account.nombre +
          (vista.account.last4 ? ' ····' + vista.account.last4 : '')));
        out.append(n('p', vista.conteos.facturasSinPagoVisto + ' factura(s) sin pago visto en esta cuenta · ' +
          vista.conteos.pagosSinFactura + ' pago(s) sin factura · ' + vista.conteos.enlazados + ' enlazado(s).', 'muted'));
        for (const inv of vista.facturasSinPagoVisto) {
          const row = n('div', undefined, 'cp-row');
          row.append(statusPill('warn', 'Sin pago visto en esta cuenta'),
            n('span', inv.date + ' · ' + (inv.from?.name || inv.from?.rfc || '') + ' · $' + inv.total +
              ' · ' + inv.uuid.slice(0, 8) + '…'));
          const ver = n('button', 'Ver factura', 'soft small');
          ver.onclick = () => { const target = invoices.find(r => r.id === inv.uuid); if (target) invoiceDetail(target); };
          const pagado = n('button', 'Ya se pagó', 'soft small');
          pagado.onclick = async () => {
            try {
              const sug = await satApi('banks/sugerencia-pago?uuid=' + encodeURIComponent(inv.uuid));
              if (sug.candidato) {
                row.replaceChildren(statusPill('warn', '¿Fue este?'),
                  n('span', sug.candidato.banco + ' · ' + sug.candidato.date + ' · $' +
                    (sug.candidato.amount || '').replace('-', '') + ' — ' + (sug.candidato.concept || '')));
                const enlazar = n('button', 'Enlazar este movimiento', 'primary small');
                enlazar.onclick = async () => {
                  await satApi('banks/marcar-pagado', { uuid: inv.uuid, movementId: sug.candidato.movementId });
                  toast('Enlazado: la factura y el movimiento quedan amarrados.');
                  cargar.onclick();
                };
                const manual = n('button', 'No: marcar sin movimiento', 'soft small');
                manual.onclick = async () => {
                  await satApi('banks/marcar-pagado', { uuid: inv.uuid });
                  toast('Marcado como pagado, sin movimiento enlazado.');
                  cargar.onclick();
                };
                row.append(enlazar, manual);
              } else {
                await satApi('banks/marcar-pagado', { uuid: inv.uuid });
                toast('Marcado como pagado (sin movimiento candidato: no se inventó ninguno).');
                cargar.onclick();
              }
            } catch (error) { toast(error.message, 'error'); }
          };
          row.append(ver, pagado);
          out.append(row);
        }
        for (const pago of vista.pagosSinFactura) {
          const row = n('div', undefined, 'cp-row');
          row.append(statusPill('dim', 'Pago sin factura'),
            n('span', pago.movement.date + ' · ' + (pago.movement.concept || '') + ' · $' + pago.movement.amount +
              (pago.sugerencia ? ' → sugiere: ' + (pago.sugerencia.from?.name || '') + ' $' + pago.sugerencia.total : '')));
          if (pago.sugerencia) {
            const enlazar = n('button', 'Enlazar en un toque', 'soft small');
            enlazar.onclick = async () => {
              try { await satApi('banks/conciliar/link', { movementId: pago.movement.id, uuid: pago.sugerencia.uuid, month: mes.value });
                toast('Enlazado: ambos salen de sus listas.'); cargar.onclick(); }
              catch (error) { toast(error.message, 'error'); }
            };
            row.append(enlazar);
          }
          out.append(row);
        }
        for (const link of vista.enlazados) {
          const row = n('div', undefined, 'cp-row');
          row.append(statusPill('ok', 'Enlazado'),
            n('span', (link.movement?.date || '') + ' · $' + (link.movement?.amount || '') + ' ↔ factura ' +
              link.uuid.slice(0, 8) + '…'));
          const des = n('button', 'Desenlazar', 'soft small');
          des.onclick = async () => {
            try { await satApi('banks/conciliar/unlink', { matchId: link.matchId, month: mes.value });
              toast('Desenlazado: vuelve a las listas.'); cargar.onclick(); }
            catch (error) { toast(error.message, 'error'); }
          };
          row.append(des);
          out.append(row);
        }
      }
    } catch (error) { out.replaceChildren(n('p', 'No se pudo cruzar: ' + error.message, 'error-text')); }
  };
  panelEl.append(fieldWrap('Periodo', mes), cargar, imprimir, out);
  return panelEl;
}
/* Pieza 5 · Contrapartes: totales reales por empresa, con su
   periodo elegible; tocar una filtra Facturas por ella. */
function bancosContrapartesPanel200f() {
  const panelEl = panel('Contrapartes', 'Las empresas con las que opera cada contribuyente: total emitido y recibido de sus CFDI, su última operación y su estado en listas 69-B si consta. Toca una para ver sus comprobantes.');
  const rfcSel = select(people.map(p => [p.id, (p.name || p.id) + ' · ' + p.id]), scope || people[0]?.id || '', 'Contribuyente');
  const perSel = select([['todo', 'Todo'], ['anio', 'Este año'], ['pasado', 'Año pasado']], 'todo', 'Periodo');
  const out = n('div');
  const ver = n('button', 'Ver contrapartes', 'soft');
  ver.onclick = async () => {
    out.replaceChildren(n('p', 'Sumando sus CFDI…', 'muted'));
    try {
      const data = await satApi('banks/contrapartes?rfc=' + encodeURIComponent(rfcSel.value) +
        '&periodo=' + encodeURIComponent(perSel.value));
      out.replaceChildren();
      if (!data.contrapartes.length) out.append(n('p', 'Sin operaciones con contrapartes en este periodo.', 'muted'));
      for (const cp of data.contrapartes) {
        const row = n('div', undefined, 'cp-row');
        row.append(statusPill('dim', '$' + cp.total),
          n('span', cp.nombre + ' · ' + cp.rfc + ' · emitido $' + cp.totalEmitido + ' · recibido $' +
            cp.totalRecibido + ' · ' + cp.comprobantes + ' comprobante(s) · última: ' + cp.ultima +
            ' · 69-B: ' + cp.estado69b));
        row.style.cursor = 'pointer';
        row.onclick = () => { if (typeof setInvoiceTerm === 'function') setInvoiceTerm(cp.rfc); navigate('invoices'); };
        /* Descarga por contraparte (tanda 7A, 20#11): su ZIP con
           XML + PDF si consta y su índice CSV que suma SOLO lo
           listado. Nombre: RFCcontraparte-año. */
        const dlZip = n('button', 'Descargar todo (ZIP)', 'soft');
        dlZip.type = 'button';
        dlZip.onclick = async ev => {
          ev.stopPropagation();
          dlZip.disabled = true; dlZip.textContent = 'Preparando…';
          try {
            const d = await satApi('salidas200g/contraparte-zip', { rfc: rfcSel.value, contraparte: cp.rfc,
              year: String(cp.ultima || '').slice(0, 4) || String(new Date().getFullYear()) });
            download(new Blob([decode64(d.content)], { type: 'application/zip' }), d.name);
            toast('ZIP listo: ' + d.name + ' (' + d.comprobantes + ' comprobante(s), suma listada $' + d.sumaListada + ')', 'ok');
          } catch (error) { toast(error.message, 'error'); }
          finally { dlZip.disabled = false; dlZip.textContent = 'Descargar todo (ZIP)'; }
        };
        row.append(dlZip);
        out.append(row);
      }
    } catch (error) { out.replaceChildren(n('p', 'No se pudo sumar: ' + error.message, 'error-text')); }
  };
  panelEl.append(fieldWrap('Contribuyente', rfcSel), fieldWrap('Periodo', perSel), ver, out);
  return panelEl;
}

/* ===== Reglas de clasificación de gastos sin factura
   (2.4.0 · WServ2, ítem 11) =====
   El editor vive AQUÍ, en Bancos, junto a la conciliación que
   lista los pagos sin factura: es su sitio natural. Las reglas
   (patrón de concepto → categoría llana) viven en el servidor
   y se APLICAN AL SERVIR: en cuanto se guarda una regla, los
   movimientos que ya hay salen clasificados — por eso el
   panel lo dice en pantalla y no hay botón de «aplicar».
   Clasificar NUNCA concilia ni mueve dinero: el movimiento
   sigue sin factura y contando como tal en los totales. Las
   tres reglas de ejemplo llegan como SUGERIDAS: no clasifican
   nada hasta que se añaden con un toque. */
function bancosReglasPanel240() {
  const panelEl = panel('Gastos sin factura: clasificación por concepto',
    'Tus reglas dicen qué es cada gasto sin factura según el texto de su concepto bancario (sin distinguir acentos ni mayúsculas). La categoría se aplica al servir: en cuanto guardas una regla, los movimientos que ya hay quedan clasificados en el acto, sin tocar nada más. Clasificar no concilia ni mueve dinero: el movimiento sigue sin factura.');
  const box = n('div');
  panelEl.append(box);
  let reglas = [];
  let editandoId = null;
  const pintar = async () => {
    box.replaceChildren(n('p', 'Leyendo tus reglas y los movimientos sin factura…', 'muted'));
    try {
      const [datosReglas, datosMovs] = await Promise.all([
        satApi('banks/reglas240'), satApi('banks/movements')]);
      reglas = datosReglas.reglas || [];
      box.replaceChildren();
      /* Los sin factura, con su categoría y la regla que la puso. */
      const sinFactura = (datosMovs.movements || []).filter(mv => mv.sinFactura);
      box.append(n('h3', 'Movimientos sin factura (' + sinFactura.length + ')'));
      if (!sinFactura.length) box.append(n('p', 'No hay movimientos marcados sin factura todavía.', 'muted'));
      for (const mv of sinFactura.slice(0, 30)) {
        const row = n('div', undefined, 'cp-row');
        row.append(statusPill(mv.categoria ? 'ok' : 'dim', mv.categoria || 'Sin categoría'),
          n('span', mv.date + ' · ' + (mv.concept || '') + ' · $' + mv.amount +
            (mv.reglaCategoria ? ' · por tu regla «' + mv.reglaCategoria.patron + '»' : '')));
        box.append(row);
      }
      if (sinFactura.length > 30) box.append(n('p', '…y ' + (sinFactura.length - 30) + ' más (se enseñan los 30 primeros).', 'muted'));
      /* Las reglas, con crear / editar / quitar. */
      box.append(n('h3', 'Tus reglas'));
      if (!reglas.length) box.append(n('p', 'Todavía no tienes reglas: sin regla no se inventa ninguna categoría.', 'muted'));
      for (const regla of reglas) {
        const row = n('div', undefined, 'cp-row');
        row.append(statusPill('dim', regla.categoria),
          n('span', 'si el concepto contiene «' + regla.patron + '» → ' + regla.categoria));
        const editar = n('button', 'Editar', 'soft small');
        editar.type = 'button';
        editar.onclick = () => { editandoId = regla.id; patronIn.value = regla.patron; categoriaIn.value = regla.categoria; guardarBtn.textContent = 'Guardar la regla editada'; patronIn.focus(); };
        const quitar = n('button', 'Quitar', 'soft small');
        quitar.type = 'button';
        quitar.onclick = async () => {
          try {
            const r = await satApi('banks/reglas240', { reglas: reglas.filter(x => x.id !== regla.id) });
            reglas = r.reglas || [];
            toast('Regla quitada: sus movimientos quedan sin categoría, como antes de la regla.', 'ok');
            pintar();
          } catch (error) { toast(error.message, 'error'); }
        };
        row.append(editar, quitar);
        box.append(row);
      }
      /* Sugeridas: un toque las convierte en reglas tuyas. */
      const sugeridas = (datosReglas.sugeridas || [])
        .filter(s => !reglas.some(r => r.patron === s.patron && r.categoria === s.categoria));
      if (sugeridas.length) {
        box.append(n('h3', 'Sugeridas (no se aplican hasta que las añadas)'));
        for (const s of sugeridas) {
          const row = n('div', undefined, 'cp-row');
          row.append(statusPill('dim', s.categoria),
            n('span', 'si el concepto contiene «' + s.patron + '» → ' + s.categoria));
          const anadir = n('button', 'Añadir esta regla', 'soft small');
          anadir.type = 'button';
          anadir.onclick = async () => {
            try {
              const r = await satApi('banks/reglas240', { reglas: [...reglas, { patron: s.patron, categoria: s.categoria }] });
              reglas = r.reglas || [];
              toast('Regla añadida: ya clasifica los movimientos que casan, también los que ya había.', 'ok');
              pintar();
            } catch (error) { toast(error.message, 'error'); }
          };
          row.append(anadir);
          box.append(row);
        }
      }
      /* El formulario de crear / editar. */
      const form = n('div', undefined, 'sat-form');
      form.append(fieldWrap('El concepto bancario contiene…', patronIn),
        fieldWrap('Categoría (texto llano)', categoriaIn), guardarBtn);
      if (editandoId) {
        const cancelar = n('button', 'Cancelar la edición', 'soft small');
        cancelar.type = 'button';
        cancelar.onclick = () => { editandoId = null; patronIn.value = ''; categoriaIn.value = ''; guardarBtn.textContent = 'Crear la regla'; pintar(); };
        form.append(cancelar);
      }
      box.append(form);
    } catch (error) { box.replaceChildren(n('p', 'No se pudieron leer las reglas: ' + error.message, 'error-text')); }
  };
  const patronIn = input('text', { placeholder: 'comisión, impuesto, nómina…', maxlength: '80' });
  const categoriaIn = input('text', { placeholder: 'Comisiones, Impuestos en ventanilla…', maxlength: '60' });
  const guardarBtn = n('button', 'Crear la regla', 'primary');
  guardarBtn.type = 'button';
  guardarBtn.onclick = async () => {
    const patron = patronIn.value.trim(), categoria = categoriaIn.value.trim();
    if (!patron || !categoria) { toast('Escribe el texto del concepto y su categoría.', 'error'); return; }
    try {
      const lista = editandoId
        ? reglas.map(r => r.id === editandoId ? { ...r, patron, categoria } : r)
        : [...reglas, { patron, categoria }];
      const r = await satApi('banks/reglas240', { reglas: lista });
      reglas = r.reglas || [];
      editandoId = null; patronIn.value = ''; categoriaIn.value = ''; guardarBtn.textContent = 'Crear la regla';
      toast('Regla guardada: ya clasifica en el acto los movimientos que casan, también los que ya había.', 'ok');
      pintar();
    } catch (error) { toast(error.message, 'error'); }
  };
  pintar();
  return panelEl;
}
