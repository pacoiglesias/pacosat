/* ===== Final 1.7.0: PWA, modo offline, preguntas, invitado =====
   La copia offline cubre los ÚLTIMOS 3 MESES (CFDI con desglose,
   saldos, esperadas, listados y posición bancaria) más los informes
   clave pregenerados en cada sincronización. Viaja CIFRADA con una
   clave del propio dispositivo (AES-GCM) y es de solo lectura; el
   sello «datos de las HH:MM» acompaña siempre a la consulta. */
function offlineDb() {
  return new Promise((resolve, reject) => {
    const request = indexedDB.open('pacosat-offline', 1);
    request.onupgradeneeded = () => request.result.createObjectStore('kv');
    request.onsuccess = () => resolve(request.result);
    request.onerror = () => reject(request.error);
  });
}
async function kvGet(key) {
  const db = await offlineDb();
  return new Promise((resolve, reject) => {
    const request = db.transaction('kv').objectStore('kv').get(key);
    request.onsuccess = () => resolve(request.result);
    request.onerror = () => reject(request.error);
  });
}
async function kvSet(key, value) {
  const db = await offlineDb();
  return new Promise((resolve, reject) => {
    const request = db.transaction('kv', 'readwrite').objectStore('kv').put(value, key);
    request.onsuccess = () => resolve();
    request.onerror = () => reject(request.error);
  });
}
async function offlineKey() {
  let jwk = await kvGet('key');
  if (!jwk) {
    const key = await crypto.subtle.generateKey({ name: 'AES-GCM', length: 256 }, true, ['encrypt', 'decrypt']);
    jwk = await crypto.subtle.exportKey('jwk', key);
    await kvSet('key', jwk);
  }
  return crypto.subtle.importKey('jwk', jwk, { name: 'AES-GCM' }, false, ['encrypt', 'decrypt']);
}
let offlineBundleCache = null;
async function syncOfflineBundle() {
  check(satToken, 'El paquete sin conexión se prepara desde el servidor.');
  const bundle = await satApi('offline-bundle');
  const key = await offlineKey();
  const iv = crypto.getRandomValues(new Uint8Array(12));
  const cipher = await crypto.subtle.encrypt({ name: 'AES-GCM', iv }, key, new TextEncoder().encode(JSON.stringify(bundle)));
  await kvSet('bundle', { iv: encode64(iv), data: encode64(new Uint8Array(cipher)), at: bundle.generatedAt });
  offlineBundleCache = bundle;
  return bundle;
}
async function loadOfflineBundle() {
  if (offlineBundleCache) return offlineBundleCache;
  const stored = await kvGet('bundle');
  if (!stored) return null;
  const key = await offlineKey();
  const plain = await crypto.subtle.decrypt({ name: 'AES-GCM', iv: decode64(stored.iv) }, key, decode64(stored.data));
  offlineBundleCache = JSON.parse(new TextDecoder().decode(plain));
  return offlineBundleCache;
}
/* Cola de acciones sin conexión: la solicitud al SAT queda registrada
   como INTENCIÓN (disciplina 5002: al volver la red se envía una
   sola vez; el servidor además la trata como solicitud en curso). */
async function enqueueOfflineAction(actionItem) {
  const queue = (await kvGet('queue')) || [];
  if (!queue.some(item => item.type === actionItem.type && item.rfc === actionItem.rfc)) queue.push(actionItem);
  await kvSet('queue', queue);
}
async function requestRunNow(rfc) {
  if (!navigator.onLine) {
    await enqueueOfflineAction({ type: 'run-now', rfc, at: Date.now() });
    announce('Sin conexión: la descarga de ' + rfc + ' queda EN COLA y se pedirá al volver internet. Registrada como intención; no se enviará dos veces.');
    soundCue('notice');
    return null;
  }
  return satApi('run-now', { rfc });
}
async function flushOfflineQueue() {
  if (!navigator.onLine || !satToken) return;
  const queue = (await kvGet('queue')) || [];
  if (!queue.length) return;
  const remaining = [];
  for (const item of queue) {
    try { if (item.type === 'run-now') await satApi('run-now', { rfc: item.rfc }); }
    catch { remaining.push(item); }
  }
  await kvSet('queue', remaining);
  if (remaining.length < queue.length) { logEvent('Cola sin conexión ejecutada al recuperar la red.'); announce('La cola sin conexión se ejecutó al volver la conexión.'); }
}
function offlineStamp(bundle) {
  return 'Estás viendo datos del ' + localDateTime(bundle.generatedAt);
}
function offlineScreen() {
  const wrap = n('div');
  const head = panel('Sin conexión · consulta de los últimos 3 meses', 'PacoSAT guarda en este dispositivo una copia CIFRADA y de solo lectura de los últimos 3 meses (CFDI con desglose, saldos por cobrar/pagar, facturas esperadas, listados y posición bancaria) y deja pregenerados los informes clave de esos meses. El XML/PDF individual solo está si quedó en la caché reciente del navegador.');
  const syncBtn = n('button', 'Sincronizar ahora la copia sin conexión', 'soft');
  const body = n('div');
  syncBtn.onclick = async () => {
    try { const bundle = await syncOfflineBundle(); announce('Copia sin conexión actualizada.'); draw(bundle); }
    catch (error) { toast(error.message, 'error'); }
  };
  head.append(syncBtn);
  wrap.append(head, body);
  const draw = bundle => {
    body.replaceChildren();
    if (!bundle) { body.append(n('p', 'Aún no hay copia en este dispositivo. Con conexión, pulsa «Sincronizar ahora» y quedará lista para cuando falte la red.', 'empty')); return; }
    body.append(statusPill('warn', offlineStamp(bundle)));
    for (const report of bundle.reports) {
      const reportPanel = panel('Informe pregenerado · ' + report.month, 'Resumen del mes, IVA estimado y actividad. Se regenera en cada sincronización.');
      reportPanel.append(n('p', 'Emitidos: ' + report.totals.issuedCount + ' por $' + report.totals.issuedTotal +
        ' · Recibidos: ' + report.totals.receivedCount + ' por $' + report.totals.receivedTotal +
        (report.withoutFiscal ? ' · ' + report.withoutFiscal + ' CFDI sin desglose (su IVA no entra en la estimación)' : '')));
      for (const row of report.iva)
        reportPanel.append(n('p', row.rfc + ' · IVA trasladado $' + row.payable + ' · acreditable $' + row.creditable + ' · a cargo $' + row.balance));
      body.append(reportPanel);
    }
    const balances = panel('Por cobrar y por pagar (a la hora de la copia)', 'Saldos abiertos calculados desde los complementos de pago que había al sincronizar.');
    if (!bundle.balances.length) balances.append(n('p', 'Sin saldos abiertos en la copia.', 'empty'));
    for (const item of bundle.balances.slice(0, 60)) {
      const row = n('div', undefined, 'cp-row');
      row.append(statusPill(item.receivable ? 'warn' : 'dim', item.receivable ? 'Por cobrar' : 'Por pagar'),
        n('span', item.date + ' · ' + (item.receivable ? item.to.name : item.from.name) + ' · saldo $' + item.balance));
      balances.append(row);
    }
    body.append(balances);
    const lists = panel('Listados oficiales (antigüedad a la hora de la copia)', 'Si un listado lleva más de 48 horas en la copia, trátalo como orientativo y valida en línea al volver la red.');
    for (const source of bundle.listsSources)
      lists.append(n('p', source.label + ': ' + (source.fetched ? Math.round((Date.now() - source.fetched) / 3600000) + ' h de antigüedad al copiar' : 'sin cargar') + (source.error ? ' · con error' : ''), 'muted'));
    body.append(lists);
    body.append(n('p', 'CFDI en la copia: ' + bundle.invoices.length + ' · Posición bancaria al copiar: $' + bundle.bankPosition.total + '.', 'muted'));
  };
  loadOfflineBundle().then(draw).catch(() => draw(null));
  return [wrap];
}
/* ===== Preguntas en lenguaje normal (100 % local) =====
   Nada sale del dispositivo: reglas fijas sobre los datos locales. */
const MONTH_NAMES = { enero: '01', febrero: '02', marzo: '03', abril: '04', mayo: '05', junio: '06', julio: '07', agosto: '08', septiembre: '09', octubre: '10', noviembre: '11', diciembre: '12' };
function questionPeriod(text) {
  const nowDate = new Date();
  if (/mes pasado/.test(text)) { const date = new Date(nowDate.getFullYear(), nowDate.getMonth() - 1, 1); return date.toISOString().slice(0, 7); }
  if (/este mes/.test(text)) return nowDate.toISOString().slice(0, 7);
  for (const [name, number] of Object.entries(MONTH_NAMES))
    if (text.includes(name)) return nowDate.getFullYear() + '-' + number;
  const match = text.match(/(20\d{2})-(\d{2})/);
  return match ? match[0] : null;
}
function answerQuestion(raw) {
  const text = raw.toLocaleLowerCase('es-MX');
  const period = questionPeriod(text);
  const sumWhere = predicate => invoices.filter(predicate).reduce((acc, row) => acc + Number(totalCents(row)), 0) / 100;
  /* Por pagar / por cobrar: LA CIFRA CANÓNICA (2.9.0 · Bloque
     C) — la misma función que Dinero y Cierre, sobre la foto
     del servidor cuando está cargada. Antes Preguntas sumaba
     su propio cálculo local (sin marcas a mano, sin excluir
     archivadas) y daba una tercera cifra distinta. El mayor
     se busca sobre la misma foto para que la respuesta y su
     comprobante cuadren con el total. */
  const mayorCanonico290 = sentido => {
    let mayor = null;
    if (typeof dineroServerInfo !== 'undefined' && dineroServerInfo.size) {
      for (const e of dineroServerInfo.values()) {
        if (sentido === 'cobrar' ? !e.receivable : !e.payable) continue;
        const b = moneyCents(e.balance || '0');
        if (b > 0n && (!mayor || b > mayor.balance)) {
          const row = invoices.find(r => r.id === e.id);
          if (row) mayor = { row, balance: b };
        }
      }
      return mayor;
    }
    const paidBy = paidByMap();
    for (const row of invoices) {
      if (row.kind !== 'I' || row.archived) continue;
      if (sentido === 'cobrar' ? !people.some(person => person.id === row.from.rfc)
        : !people.some(person => person.id === row.to.rfc)) continue;
      if (invoiceStateOf(row) === 'Cancelado') continue;
      const balance = balanceOf(row, paidBy).balance;
      if (balance > 0n && (!mayor || balance > mayor.balance)) mayor = { row, balance };
    }
    return mayor;
  };
  if (/cu[aá]nto debo/.test(text)) {
    const total = porPagarCanonico290().cents;
    const mayor = mayorCanonico290('pagar');
    /* La respuesta lleva el documento en la mano (1.25.0,
       mejora nº 7): la cifra y el comprobante mayor, en el
       mismo toque. */
    return { text: 'Por PAGAR tienes abiertos $' + centsLabel(total) +
        (mayor ? '. El mayor es de ' + (mayor.row.from.name || mayor.row.from.rfc) + ' por $' + centsLabel(mayor.balance) + ': ábrelo aquí mismo.' : '.'),
      invoice: mayor?.row };
  }
  if (/cu[aá]nto me deben/.test(text)) {
    const total = porCobrarCanonico290().cents;
    const mayor = mayorCanonico290('cobrar');
    return { text: 'Por COBRAR tienes abiertos $' + centsLabel(total) +
        (mayor ? '. El mayor es de ' + (mayor.row.to.name || mayor.row.to.rfc) + ' por $' + centsLabel(mayor.balance) + ': ábrelo aquí mismo.' : '.'),
      invoice: mayor?.row };
  }
  if (/iva/.test(text) && period) {
    let payable = 0n, creditable = 0n;
    for (const row of invoices) {
      if (!row.date.startsWith(period) || !row.fiscal) continue;
      const issued = people.some(p => p.id === row.from.rfc);
      for (const tax of row.fiscal.transferred || []) if (tax.tax === '002') {
        if (issued) payable += moneyCents(tax.amount); else creditable += moneyCents(tax.amount);
      }
    }
    return 'IVA estimado de ' + period + ' (desde el desglose guardado): trasladado $' + centsLabel(payable) + ', acreditable $' + centsLabel(creditable) + ', a cargo $' + centsLabel(payable - creditable) + '. Es una estimación: la cifra oficial la cierra tu contadora.';
  }
  if (/qu[eé] vence|vencimientos/.test(text)) {
    const events = fiscalLocalEvents().filter(event => event.daysLeft <= 7);
    if (!events.length) return 'En los próximos 7 días no vence nada del calendario fiscal que conozco. El calendario completo está en Cumplimiento.';
    return 'Vence pronto: ' + events.map(event => event.title + ' (' + event.date + ', ' + (event.rfc || 'general') + ')').join(' · ') + '.';
  }
  /* Ventas = solo EMITIDOS (2.9.3 · F10): «¿cuánto vendí?»,
     «¿cuánto facturé?», «¿cuánto ingresé?» preguntan por lo
     que TÚ emitiste. La rama genérica de abajo sumaba también
     los recibidos y daba una cifra mezclada (en vivo: «vendí
     en octubre» $551,423.63 = 2 emitidos de $343,539.11 + 21
     recibidos de $207,884.52). «Me facturaron / me facturó»
     NO es una venta: queda fuera y lo cuenta la rama genérica
     como conteo del expediente, no como venta. */
  if (/(vend|factur|ingres)/.test(text) && !/me factur/.test(text)) {
    const party = findPartyInQuestion(text);
    const ventas = invoices.filter(row => row.kind === 'I' && (!period || row.date.startsWith(period)) &&
      people.some(p => p.id === row.from.rfc) && (!party || row.to.rfc === party));
    const total = ventas.reduce((acc, row) => acc + Number(totalCents(row)), 0) / 100;
    const mayor = ventas.slice().sort((a, b) => (totalCents(b) > totalCents(a) ? 1 : -1))[0];
    return { text: 'Vendiste ' + ventas.length + ' CFDI' + (period ? ' de ' + period : '') + (party ? ' a ' + party : '') +
        ' por $' + total.toLocaleString('es-MX', { minimumFractionDigits: 2 }) +
        ' (solo emitidos: lo que tú facturaste; los recibidos no son ventas)' +
        (mayor ? '. El mayor, $' + centsLabel(totalCents(mayor)) + ', se abre aquí mismo.' : '.'),
      invoice: mayor };
  }
  if (/(factur|gast|compr|vend)/.test(text)) {
    const party = findPartyInQuestion(text);
    const base = invoices.filter(row => row.kind === 'I' && (!period || row.date.startsWith(period)) &&
      (!party || row.from.rfc === party || row.to.rfc === party));
    if (party || period) {
      const total = base.reduce((acc, row) => acc + Number(totalCents(row)), 0) / 100;
      const mayor = base.slice().sort((a, b) => (totalCents(b) > totalCents(a) ? 1 : -1))[0];
      return { text: 'Hay ' + base.length + ' CFDI' + (period ? ' de ' + period : '') + (party ? ' relacionados con ' + party : '') +
          ' por un total de $' + total.toLocaleString('es-MX', { minimumFractionDigits: 2 }) +
          (mayor ? '. El mayor, $' + centsLabel(totalCents(mayor)) + ', se abre aquí mismo.' : '.'),
        invoice: mayor };
    }
  }
  return 'Puedo responder con tus datos locales, sin salir de aquí: «¿cuánto me deben?», «¿cuánto debo?», «¿cuánto IVA tengo en octubre?», «¿qué vence esta semana?» o «¿cuánto facturó [RFC] este mes?».';
}
function findPartyInQuestion(text) {
  const upper = text.toUpperCase();
  const known = new Set();
  for (const row of invoices) { known.add(row.from.rfc); known.add(row.to.rfc); }
  for (const person of people) known.add(person.id);
  for (const rfc of known) if (upper.includes(rfc)) return rfc;
  return null;
}
function preguntasScreen() {
  const wrap = n('div');
  /* Ayuda unificada (2.8.0 · diseño 26): si se llegó por el
     «?», la ayuda de la pantalla de origen va PRIMERO y el
     preguntar debajo; los atajos cierran la pantalla como
     una sección más. Una sola puerta de ayuda. */
  if (typeof ayudaContexto280 !== 'undefined' && ayudaContexto280) {
    const ctx280 = ayudaContexto280;
    const ayudaPanel = panel('Ayuda · ' + ctx280.nombre,
      'La ayuda de la pantalla donde estabas, aquí mismo: debajo puedes preguntar con tus datos.');
    ayudaPanel.dataset.ayuda280 = '1';
    const bloque280 = (titulo, texto) => {
      const s = n('section');
      s.append(n('h3', titulo), n('p', texto));
      return s;
    };
    if (ctx280.t) ayudaPanel.append(bloque280('Qué es', ctx280.t.q), bloque280('Para qué sirve', ctx280.t.p), bloque280('Qué hacer', ctx280.t.h));
    else ayudaPanel.append(bloque280('Qué es', (typeof screens !== 'undefined' && screens[ctx280.clave]?.[1]) || 'Esta pantalla.'),
      n('p', 'La ayuda detallada de esta pantalla no llegó: puedes preguntar con tus datos aquí debajo.'));
    if (typeof satToken !== 'undefined' && satToken)
      satApi('ayuda-ejemplo200h' + (scope ? '?rfc=' + encodeURIComponent(scope) : '')).then(r => {
        if (r?.ejemplo && ayudaPanel.isConnected) ayudaPanel.append(bloque280('Ejemplo de tu expediente', r.ejemplo.texto));
      }).catch(() => {});
    wrap.append(ayudaPanel);
  }
  const panelEl = panel('Pregunta en lenguaje normal', 'Respuestas calculadas AQUÍ, con tus datos locales: nada se envía a ningún servicio externo. Sirve también sin conexión sobre los datos ya sincronizados.');
  const form = n('div', undefined, 'sat-form');
  const question = input('text', { placeholder: '¿Cuánto IVA tengo en octubre?' });
  const ask = n('button', 'Preguntar', 'soft');
  /* Estado vacío de la respuesta, diseñado (2.3.2 · m-26):
     antes de preguntar, la zona de respuesta dice qué es y qué
     hacer — no un hueco en blanco. Al responder, la sustituye
     el texto de la respuesta. */
  const answer = n('div', undefined, 'empty preg-respuesta232');
  answer.append(n('h3', 'Tu respuesta aparecerá aquí'),
    n('p', 'Escribe tu pregunta arriba o toca un ejemplo: la respuesta se calcula en este momento con los comprobantes que ya tienes guardados.'));
  const answerActions = n('div', undefined, 'sat-actions');
  const run = async () => {
    /* La foto de saldos del servidor se pide ANTES de responder
       (2.9.0 · Bloque C): sin ella, «¿cuánto me deben?» caía al
       cálculo local y daba otra cifra que Dinero. */
    if (typeof cargarSaldosServidor290 === 'function') await cargarSaldosServidor290();
    try {
      /* Cifra + comprobante en el mismo toque (1.25.0, mejora
         nº 7): algunas respuestas traen la factura a la que se
         refieren y la pantalla ofrece abrirla sin salir. */
      const resultado = answerQuestion(question.value);
      answer.classList.remove('empty');
      answer.replaceChildren(n('p', typeof resultado === 'string' ? resultado : resultado.text));
      answerActions.replaceChildren();
      if (typeof resultado !== 'string' && resultado.invoice) {
        const abrir = n('button', 'Abrir el comprobante', 'primary small');
        abrir.onclick = () => invoiceDetail(resultado.invoice);
        answerActions.append(abrir);
      }
      announce('Respuesta lista.');
    } catch (error) {
      answer.classList.remove('empty');
      answer.replaceChildren(n('p', error.message, 'error-text'));
      answerActions.replaceChildren();
    }
  };
  ask.onclick = run;
  question.onkeydown = event => { if (event.key === 'Enter') run(); };
  form.append(fieldWrap('Tu pregunta', question), ask);
  /* Ejemplos tocables (2.3.2 · m-26): rellenan el campo con la
     pregunta tal cual; «Preguntar» (o Enter) la responde. Son
     las mismas preguntas que el propio respondedor anuncia. */
  const ejemplos = n('div', undefined, 'preg-ejemplos232');
  ejemplos.append(n('span', 'Ejemplos:'));
  for (const texto of ['¿Cuánto me deben?', '¿Cuánto debo?', '¿Cuánto IVA tengo en octubre?', '¿Qué vence esta semana?']) {
    const ejemplo = n('button', texto, 'soft small');
    ejemplo.type = 'button';
    ejemplo.onclick = () => { question.value = texto; question.focus(); };
    ejemplos.append(ejemplo);
  }
  panelEl.append(form, ejemplos, answer, answerActions);
  wrap.append(panelEl);
  if (typeof atajosLista240 === 'function') {
    const atajosPanel = panel('Atajos de teclado', 'Moverte sin ratón, desde cualquier pantalla.');
    atajosPanel.dataset.atajos280 = '1';
    atajosPanel.append(atajosLista240());
    wrap.append(atajosPanel);
  }
  return [wrap];
}
/* ===== «Probar todo» (autodiagnóstico) ===== */
function selfTestPanel() {
  const panelEl = panel('Probar todo', 'Autodiagnóstico en un clic: base de datos, correo, listados al día, respaldo y copia externa, y la caducidad de cada e.firma. No gasta solicitudes al SAT.');
  const out = n('div');
  const btn = n('button', 'Ejecutar el diagnóstico', 'soft');
  btn.onclick = async () => {
    out.replaceChildren(n('p', 'Probando…', 'muted'));
    try {
      const data = await satApi('selftest');
      out.replaceChildren();
      for (const checkItem of data.checks) {
        const row = n('div', undefined, 'cp-row');
        row.append(statusPill(checkItem.state === 'ok' ? 'ok' : checkItem.state === 'warn' ? 'warn' : checkItem.state === 'bad' ? 'bad' : 'dim', checkItem.label),
          n('span', checkItem.detail));
        out.append(row);
      }
      soundCue('success');
    } catch (error) { out.replaceChildren(n('p', error.message, 'error-text')); }
  };
  panelEl.append(btn, out);
  return panelEl;
}
/* ===== CSV de la bitácora (2.4.0 · W4d) =====
   UNA sola composición para los dos botones «Exportar bitácora
   (CSV)» del sistema: este panel (Ajustes › Sistema) y la tarjeta
   de Salud de WC4a. La composición es EXACTAMENTE la de la
   tarjeta de Salud (salud-ui.part): cabecera fecha,nombre,evento,
   cada valor entre comillas con la comilla doblada, filas unidas
   con \r\n — el mismo bitacora-pacosat.csv de siempre. El helper
   vive en el artefacto principal, alcanzable también desde la
   parte diferida de Salud en tiempo de ejecución; la tarjeta de
   Salud conserva su copia en línea idéntica porque salud-ui.part
   queda fuera del territorio de esta tanda (declarado en la
   nota). Lo que este helper NO es: el csvText de workflows.part,
   que es el CSV de FACTURAS (espera filas CFDI con from/to) —
   llamarlo con filas de bitácora lanzaba un TypeError en vivo,
   el hallazgo de WC4a que esta pieza corrige. */
function bitacoraCsv240(filas) {
  const esc = v => '"' + String(v ?? '').replaceAll('"', '""') + '"';
  return [['fecha', 'nombre', 'evento'], ...(filas || []).map(row => [row.date, row.name, row.event || ''])]
    .map(row => row.map(esc).join(',')).join('\r\n');
}
/* ===== Bitácora reforzada: filtros y resumen de actividad ===== */
function activityPanel() {
  const panelEl = panel('Bitácora y resumen de actividad', 'Qué hizo PacoSAT solo y qué se hizo desde la app: filtros por tipo y el resumen por día y por semana. La exportación vive en Registro. Cada entrada de la actividad reciente (en Resumen) abre su objeto.');
  const controls = n('div', undefined, 'sat-form');
  const kindSel = n('select');
  for (const [value, label] of [['', 'Todos los tipos'], ['sat', 'SAT'], ['import', 'Importaciones'], ['event', 'Eventos'], ['alert', 'Alertas']]) {
    const option = n('option', label); option.value = value; kindSel.append(option);
  }
  const textFilter = input('text', { placeholder: 'Buscar texto o RFC…' });
  const out = n('div');
  const classify = row => row.event ? (row.event.startsWith('Cancelación') ? 'alert' : 'event') : (row.name.startsWith('SAT') ? 'sat' : 'import');
  const draw = () => {
    const kind = kindSel.value, needle = textFilter.value.trim().toLocaleLowerCase('es-MX');
    const filtered = activity.filter(row => (!kind || classify(row) === kind) &&
      (!needle || (row.name + ' ' + (row.event || '')).toLocaleLowerCase('es-MX').includes(needle)));
    out.replaceChildren();
    const dayKey = row => row.date.slice(0, 10);
    const todayKey = new Date().toISOString().slice(0, 10);
    const weekAgo = new Date(Date.now() - 7 * 86400000).toISOString().slice(0, 10);
    const todayCount = filtered.filter(row => dayKey(row) === todayKey).length;
    const weekCount = filtered.filter(row => dayKey(row) >= weekAgo).length;
    out.append(n('p', 'Coincidencias: ' + filtered.length + ' · hoy: ' + todayCount + ' · últimos 7 días: ' + weekCount));
    for (const row of filtered.slice(0, 40)) {
      const item = n('div', undefined, 'cp-row');
      item.append(statusPill(classify(row) === 'alert' ? 'bad' : classify(row) === 'sat' ? 'ok' : 'dim', classify(row)),
        n('span', row.date.slice(0, 10) + ' · ' + (row.event || row.name)));
      out.append(item);
    }
  };
  kindSel.onchange = draw;
  textFilter.oninput = draw;
  /* (2.8.0 · diseño 10) Sin botón de exportar: la exportación
     de la bitácora vive solo en Registro. Este panel conserva
     sus filtros y su resumen, que es su trabajo técnico. */
  controls.append(fieldWrap('Tipo', kindSel), fieldWrap('Texto', textFilter));
  panelEl.append(controls, out);
  draw();
  return panelEl;
}
/* ===== Acceso invitado (Ajustes) ===== */
/* Vista Nora (1.25.0, AGREGAR 3): la contadora entra como
   invitada y su pantalla inicial es ESTA — la lista del mes con
   su estado, de solo lectura: qué consta y qué falta, sin un
   solo control que cambie nada. La marca «contadora» la pone
   Paco en el panel de invitado; el servidor la expone como
   sesionContadora a quien pregunta con esa sesión. */
let noraSesionCache = null;
function noraVistaPanel() {
  const panelEl = panel('Tu lista del mes', 'Solo lectura: el estado del cierre de cada RFC, tal como consta en PacoSAT. Lo que falte se lo prepara Paco; tú solo consultas.');
  const monthInput = input('month', { value: new Date().toISOString().slice(0, 7), 'aria-label': 'Mes' });
  const body = n('div');
  body.append(n('p', 'Consultando la lista del mes…', 'muted'));
  const paint = async () => {
    try {
      const data = await satApi('reports/checklist?month=' + monthInput.value);
      body.replaceChildren();
      const hechos = (data.items || []).filter(item => item.level === 'ok').length;
      body.append(n('p', 'Van ' + hechos + ' de ' + (data.items || []).length + ' pasos del cierre de ' + data.month + ' en verde.'));
      for (const item of data.items || []) {
        const row = n('div', undefined, 'cp-row');
        row.append(statusPill(item.level === 'ok' ? 'ok' : item.level === 'bad' ? 'bad' : 'warn',
            item.level === 'ok' ? 'Hecho' : 'Falta'),
          n('span', item.label), n('span', item.detail || '', 'muted'));
        body.append(row);
      }
      if (!data.items?.length) body.append(n('p', 'Sin pasos para ese mes.', 'empty'));
    } catch (error) { body.replaceChildren(n('p', error.message, 'error-text')); }
  };
  monthInput.onchange = paint;
  panelEl.append(fieldWrap('Mes', monthInput), body);
  paint();
  return panelEl;
}
function guestPanel() {
  const panelEl = panel('Acceso invitado de solo lectura', 'Una credencial SEPARADA para que otra persona (tu contadora, por ejemplo) consulte sin poder cambiar nada. Está desactivado por defecto; cada entrada y cada intento quedan en la bitácora de accesos. La dirección de entrada es la misma app con /invitado al final.');
  const body = n('div');
  panelEl.append(body);
  const draw = async () => {
    body.replaceChildren();
    try {
      const config = await satApi('guest/config');
      const strip = n('div', undefined, 'traffic-strip');
      strip.append(statusPill(config.enabled ? 'warn' : 'ok', config.enabled ? 'Invitado ACTIVADO' : 'Invitado desactivado'),
        statusPill(config.hasPassword ? 'ok' : 'bad', config.hasPassword ? 'Contraseña fijada' : 'Sin contraseña'));
      body.append(strip);
      const form = n('div', undefined, 'sat-form');
      const password = input('password', { placeholder: 'Nueva contraseña del invitado (mín. 8)', autocomplete: 'new-password' });
      const toggle = n('button', config.enabled ? 'Desactivar invitado' : 'Activar invitado', 'soft');
      toggle.onclick = async () => {
        try { await satApi('guest/config', { enabled: !config.enabled }); announce('Acceso de invitado actualizado.'); draw(); }
        catch (error) { toast(error.message, 'error'); }
      };
      const save = n('button', 'Guardar contraseña', 'soft');
      save.onclick = async () => {
        try { check(password.value.length >= 8, 'La contraseña debe tener al menos 8 caracteres.'); await satApi('guest/config', { password: password.value }); password.value = ''; announce('Contraseña del invitado guardada.'); draw(); }
        catch (error) { toast(error.message, 'error'); }
      };
      form.append(fieldWrap('Contraseña', password), save, toggle);
      body.append(form);
      /* Alcance por RFC (1.9.0): sin marcar ninguno, el invitado ve
         todos los RFC (como antes); marcando, SOLO ve esos RFC —
         el filtro se aplica en el servidor, no en la pantalla. Con
         alcance, Bancos y el paquete sin conexión quedan fuera. */
      const scopeBox = n('div', undefined, 'sat-form');
      scopeBox.append(n('strong', 'Alcance por RFC'));
      scopeBox.append(n('p', config.rfcs?.length
        ? 'Este acceso solo ve: ' + config.rfcs.join(', ') + '. Bancos y el paquete sin conexión quedan fuera de su alcance.'
        : 'Sin límite: este acceso ve TODOS los RFC. Marca abajo los que quieras permitir y guarda.', 'muted'));
      const checks = new Map();
      for (const person of people) {
        const label = n('label', undefined, 'switch-line');
        const box = input('checkbox', { checked: (config.rfcs || []).includes(person.id) });
        checks.set(person.id, box);
        label.append(box, n('span', person.name + ' · ' + person.id));
        scopeBox.append(label);
      }
      const saveScope = n('button', 'Guardar alcance', 'soft');
      saveScope.onclick = async () => {
        try {
          const rfcs = [...checks.entries()].filter(([, box]) => box.checked).map(([rfc]) => rfc);
          await satApi('guest/config', { rfcs });
          announce(rfcs.length ? 'Alcance guardado: el invitado solo verá ' + rfcs.join(', ') + '.' : 'Alcance guardado: sin límite por RFC.');
          draw();
        } catch (error) { toast(error.message, 'error'); }
      };
      scopeBox.append(saveScope);
      body.append(scopeBox);
      /* Vista de la contadora (1.25.0, AGREGAR 3): con esta marca,
         la sesión invitada abre en su lista del mes (solo
         lectura) en vez del Resumen general. */
      const noraBox = n('div', undefined, 'sat-form');
      noraBox.append(n('strong', 'Vista de la contadora'));
      noraBox.append(n('p', 'Si este acceso es el de tu contadora, márcalo: al entrar verá primero su lista del mes con el estado de cada paso, siempre en solo lectura.', 'muted'));
      const noraLabel = n('label', undefined, 'switch-line');
      const noraCheck = input('checkbox', { checked: Boolean(config.contadora) });
      noraCheck.onchange = async () => {
        try {
          await satApi('guest/config', { contadora: noraCheck.checked });
          announce(noraCheck.checked ? 'Vista de la contadora activada para el acceso invitado.' : 'Vista de la contadora desactivada.');
        } catch (error) { toast(error.message, 'error'); noraCheck.checked = !noraCheck.checked; }
      };
      noraLabel.append(noraCheck, n('span', 'Este acceso es el de la contadora'));
      noraBox.append(noraLabel);
      body.append(noraBox);
      const log = await satApi('access-log');
      if (log.entries.length) {
        body.append(n('h4', 'Bitácora de accesos'));
        for (const entry of log.entries.slice(0, 30))
          body.append(n('p', localDateTime(entry.at) + ' · ' + entry.kind + ' · ' + entry.detail, 'muted'));
      }
    } catch (error) { body.append(n('p', error.message, 'error-text')); }
  };
  if (satToken) draw();
  else body.append(n('p', 'Solo en modo servidor.', 'empty'));
  return panelEl;
}
/* Usuarios con nombre propio (2.9.8): talón del panel de
   Ajustes. El panel de verdad viaja DIFERIDO en la parte
   'usuarios' (usuarios-ui.part) — el artefacto principal está
   a un palmo de su techo y esta pantalla se visita rara vez —:
   el talón enseña su «cargando» honesto, pide la parte y, al
   llegar, le entrega el panel y su cuerpo a usersPanelReal298.
   Si la parte no llega, el error se dice en el propio panel,
   nunca un hueco muerto. Solo lo monta Ajustes para el
   principal (ni invitados ni administradores con nombre). */
function usersPanel298() {
  const panelEl = panel('Usuarios con nombre propio', 'Cada persona entra con su usuario y su contraseña, y ve solo los RFC que tú marques. Quién entra y cuándo queda en la bitácora de accesos.');
  const body = n('div');
  body.append(n('p', 'Cargando los usuarios…', 'muted'));
  panelEl.append(body);
  const fallo = () => body.replaceChildren(n('p', 'No se pudo cargar: su parte no llegó del servidor. Vuelve a abrir Ajustes para intentarlo.', 'error-text'));
  if (typeof ensureLazyPart === 'function')
    ensureLazyPart('usuarios').then(ok => ok && typeof usersPanelReal298 === 'function' ? usersPanelReal298(panelEl, body) : fallo());
  else fallo();
  return panelEl;
}
/* Arranque de la 1.7.0: service worker, aviso sin conexión, cola y
   login del invitado. */
if ('serviceWorker' in navigator && typeof satToken !== 'undefined' && satToken) {
  navigator.serviceWorker.register('/sw.js').catch(() => {});
}
function updateConnectivityBanner() {
  const banner = $('offline-banner');
  if (!banner) return;
  if (navigator.onLine) { banner.hidden = true; return; }
  banner.hidden = false;
  banner.textContent = 'Sin conexión: estás en modo de solo lectura con la copia local. Sincroniza la copia en la pantalla «Sin conexión» cuando vuelva la red.';
  loadOfflineBundle().then(bundle => { if (bundle) banner.textContent = 'Sin conexión · ' + offlineStamp(bundle); }).catch(() => {});
}
window.addEventListener('online', () => { updateConnectivityBanner(); flushOfflineQueue(); });
window.addEventListener('offline', updateConnectivityBanner);
document.addEventListener('DOMContentLoaded', updateConnectivityBanner);

/* Entrada a PacoSAT (2.9.8): sin token de sesión en el
   almacenamiento, la pantalla pide la credencial y recarga ya
   identificado. Con usuario propio relleno entra por
   /api/users/login y guarda su { nombre, rol } en
   'pacosat-user-session' (el puente de ui.part lo lee para que
   un administrador con nombre no sea guestMode); con el
   usuario vacío entra con la contraseña de invitado de
   siempre, por /api/guest/login, y borra cualquier sesión con
   nombre que quedara de antes. El token viaja en la misma
   llave de siempre, 'pacosat-guest-token'. */
function showGuestLogin() {
  const form = n('form', undefined, 'dialog-form');
  form.append(n('h3', 'Entrar a PacoSAT'),
    n('p', 'Si tienes usuario propio, escríbelo con tu contraseña. Si entras con la contraseña de invitado de siempre, deja el usuario vacío: entrarás en solo lectura, como hasta ahora.', 'muted'));
  const usuario = input('text', { autocomplete: 'username' });
  const password = input('password', { autocomplete: 'current-password' });
  form.append(fieldWrap('Tu usuario', usuario), fieldWrap('Contraseña', password));
  form.append(Object.assign(n('button', 'Entrar', 'primary'), { type: 'submit' }));
  form.onsubmit = async event => {
    event.preventDefault();
    try {
      const u = usuario.value.trim();
      const response = await fetch('/api/' + (u ? 'users' : 'guest') + '/login', { method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ ...(u ? { usuario: u } : {}), password: password.value }) });
      const data = await response.json().catch(() => ({}));
      check(response.ok, data.error || 'No se pudo entrar.');
      sessionStorage.setItem('pacosat-guest-token', data.token);
      if (u) sessionStorage.setItem('pacosat-user-session', JSON.stringify({ nombre: data.nombre, rol: data.rol }));
      else sessionStorage.removeItem('pacosat-user-session');
      location.reload();
    } catch (error) { toast(error.message, 'error'); }
  };
  showDialog(form);
}
if (typeof guestMode !== 'undefined' && guestMode && !sessionStorage.getItem('pacosat-guest-token')) showGuestLogin();
/* ===== Respaldo partido (mejora nº 8, reconstruido en la 2.9.10) =====
   La versión anterior generaba UN .faro por cada combinación
   RFC·año contando cada factura DOS veces (bajo el RFC del emisor
   y bajo el del receptor): con el expediente real de Paco salieron
   338 archivos en su iPhone (18 nov 2026). Estaba mal diseñada, no
   era un texto. La reconstrucción es el espejo del backupSets del
   servidor, con las reglas de la casa:
   · Reparto por dueño (ownerOf): el RFC de perfil presente como
     emisor o receptor manda; si ninguno es de perfil, el del
     emisor. Cada factura queda en UN SOLO grupo RFC·año — se acabó
     el doble conteo. Los documentos viajan con el grupo de su RFC
     y del año de su fecha, cada uno en una sola parte también.
   · Empaquetado voraz bajo el techo del formato (100 MB): los
     grupos vecinos comparten parte mientras quepan; un grupo que
     solo ya supera el techo viaja solo (su XML manda, no se puede
     partir un comprobante).
   · Cada parte es un respaldo v2 completo de su conjunto (las
     personas de sus grupos, sus facturas, sus documentos, sus
     archivos; la actividad entera viaja en la primera parte) y se
     restaura por separado con el restaurador de siempre.
   Resultado: un expediente normal = UN archivo; uno gigante =
   total ÷ 100 MB partes, no cientos. */
function splitBackupParts(full, ceiling = 100 * MB) {
  const size = value => new TextEncoder().encode(JSON.stringify(value)).length;
  const profileRfcs = new Set((full.people || []).map(person => person.id));
  const ownerOf = invoice => profileRfcs.has(invoice?.from?.rfc) ? invoice.from.rfc
    : profileRfcs.has(invoice?.to?.rfc) ? invoice.to.rfc : (invoice?.from?.rfc || invoice?.to?.rfc || 'SIN-RFC');
  const groups = new Map();
  const groupOf = key => { if (!groups.has(key)) groups.set(key, { invoices: [], documents: [] }); return groups.get(key); };
  for (const invoice of full.invoices || [])
    groupOf(ownerOf(invoice) + '|' + String(invoice?.date || '').slice(0, 4)).invoices.push(invoice);
  for (const doc of full.documents || [])
    groupOf(doc.rfc + '|' + String(doc.date || '').slice(0, 4)).documents.push(doc);
  const fileById = new Map((full.files || []).map(file => [file.id, file]));
  const usedFiles = new Set();
  const slices = [];
  for (const [key, group] of [...groups.entries()].sort()) {
    const files = [];
    const take = id => { const file = fileById.get(id); if (file && !usedFiles.has(file.id)) { usedFiles.add(file.id); files.push(file); } };
    for (const invoice of group.invoices) take('xml:' + invoice.id);
    for (const doc of group.documents) take(doc.id);
    slices.push({ key, invoices: group.invoices, documents: group.documents, files });
  }
  const build = (list, activity) => {
    const ids = new Set();
    for (const slice of list) {
      ids.add(slice.key.split('|')[0]);
      for (const invoice of slice.invoices) {
        if (invoice?.from?.rfc) ids.add(invoice.from.rfc);
        if (invoice?.to?.rfc) ids.add(invoice.to.rfc);
      }
      for (const doc of slice.documents) ids.add(doc.rfc);
    }
    return { version: 2,
      people: (full.people || []).filter(person => ids.has(person.id)),
      invoices: list.flatMap(slice => slice.invoices),
      documents: list.flatMap(slice => slice.documents),
      files: list.flatMap(slice => slice.files),
      activity };
  };
  const parts = [];
  let current = [], currentData = null;
  for (const slice of slices) {
    /* La actividad entera viaja en la PRIMERA parte: acompaña a
       la parte mientras se llena, no solo a su primera rodaja. */
    const activity = parts.length === 0 ? (full.activity || []) : [];
    const candidate = build([...current, slice], activity);
    if (current.length && size(candidate) > ceiling) {
      parts.push(currentData);
      current = [slice];
      currentData = build(current, []);
    } else { current = [...current, slice]; currentData = candidate; }
  }
  if (current.length) parts.push(currentData);
  return parts;
}
function splitBackupFileName(stamp, index, total) {
  return 'PacoSAT-' + stamp + (total > 1 ? '-p' + (index + 1) + 'de' + total : '') + '.faro';
}
async function splitBackupDialog() {
  await requireStorage();
  check(!importing && crypto.subtle, 'El respaldo no está disponible en este navegador o hay una importación activa.');
  const password = input('password', { required: true, minLength: 12, autocomplete: 'new-password' });
  const repeat = input('password', { required: true, minLength: 12, autocomplete: 'new-password' });
  dialog('Respaldo partido', [n('p', 'Normalmente sale UN solo archivo. Solo si el conjunto pasa de 100 MB se parte en trozos de hasta 100 MB, agrupando las facturas por RFC y año dentro de cada trozo. Cada parte se restaura por separado con la misma contraseña. Sin la contraseña ningún archivo se puede abrir.', 'news-note'),
    field('Contraseña de al menos 12 caracteres', password), field('Confirma la contraseña', repeat)], async () => {
    check(password.value.length >= 12 && password.value === repeat.value, 'Revisa que las contraseñas coincidan.');
    const full = await snapshot(true);
    const parts = splitBackupParts(full);
    check(parts.length, 'No hay facturas para partir el respaldo.');
    const stamp = new Date().toISOString().slice(0, 10);
    for (let i = 0; i < parts.length; i++)
      download(await encryptBackup(parts[i], password.value), splitBackupFileName(stamp, i, parts.length));
    await logEvent('Respaldo partido creado (' + parts.length + ' archivos)');
    announce(parts.length === 1 ? 'Respaldo partido generado: un solo archivo.'
      : 'Respaldo partido generado: ' + parts.length + ' archivos.');
    soundCue('success');
  }, 'Crear respaldo partido');
}
/* F8 · Deshacer universal (1.31.0): ayudante global para los
   gestos que mueven datos — ejecuta hacer(), enseña el toast
   con botón «Deshacer» durante 10 segundos y, si se pulsa,
   ejecuta deshacer() una sola vez. La tarjeta es la de
   floatToast; su vida (15 s) se acorta aquí a 10 s retirando
   la tarjeta al cumplirse el plazo, porque el contrato de este
   gesto son 10 s y no los 15 del resto de avisos con deshacer. */
async function conDeshacer1310(texto, hacer, deshacer) {
  await hacer();
  let deshecho = false;
  const limpiar = floatToast(texto, 'ok', async () => {
    if (deshecho) return;
    deshecho = true;
    await deshacer();
  });
  setTimeout(() => { if (!deshecho) limpiar?.(); }, 10000);
}
/* F13 · Arrastrar y soltar (1.31.0): al arrastrar archivos
   sobre la ventana, un overlay a pantalla completa dice
   «Suelta para importar»; al soltar, los .xml/.zip entran por
   el flujo de importación de siempre (el input #incoming, el
   mismo que usa el botón «Importar») y los .pdf por el de
   «Factura PDF» (el input #invoice-pdf). Se reutilizan los
   handlers existentes asignando los archivos al input y
   despachando su change — ningún camino nuevo.
   Los oyentes van en fase de CAPTURA: los de workflows.part
   corren en burbuja y abrirían la pantalla XML además; aquí se
   intercepta antes y el soltar no les llega (stopPropagation).
   Si hay un diálogo abierto, no se intercepta nada: soltar
   dentro de un diálogo es asunto del diálogo. */
(function pacosatDrop1310() {
  let cuentaDrag1310 = 0;
  const traeArchivos1310 = event => Boolean(event.dataTransfer &&
    [...(event.dataTransfer.types || [])].includes('Files'));
  const overlay1310 = () => {
    let capa = document.getElementById('drop-overlay-1310');
    if (!capa) {
      capa = n('div', 'Suelta para importar', 'drop-overlay');
      capa.id = 'drop-overlay-1310';
      capa.hidden = true;
      document.body.append(capa);
    }
    return capa;
  };
  const ocultar1310 = () => {
    cuentaDrag1310 = 0;
    const capa = document.getElementById('drop-overlay-1310');
    if (capa) capa.hidden = true;
  };
  const dialogoAbierto1310 = () => Boolean(document.querySelector('dialog[open]'));
  window.addEventListener('dragenter', event => {
    if (!traeArchivos1310(event) || dialogoAbierto1310()) return;
    cuentaDrag1310++;
    overlay1310().hidden = false;
  }, true);
  window.addEventListener('dragover', event => {
    if (!traeArchivos1310(event) || dialogoAbierto1310()) return;
    event.preventDefault();
    overlay1310().hidden = false;
  }, true);
  window.addEventListener('dragleave', event => {
    if (!traeArchivos1310(event)) return;
    cuentaDrag1310 = Math.max(0, cuentaDrag1310 - 1);
    if (cuentaDrag1310 === 0) ocultar1310();
  }, true);
  window.addEventListener('drop', event => {
    if (!traeArchivos1310(event)) return;
    /* Documentos y Bancos tienen su propio camino (2.0.1 ·
       nº 25): en Documentos manda la tarjeta de clasificación
       del papel (el oyente de la parte de Salidas) y en Bancos
       la detección del estado con su confirmación. Aquí no se
       intercepta en esas pantallas: el soltar llega a su
       dueño, con la misma confirmación que su botón. */
    if (typeof page !== 'undefined' &&
        (page === 'docs' || (page === 'dinero' && typeof dineroTab !== 'undefined' && dineroTab === 'bancos'))) { ocultar1310(); return; }
    const archivos = [...(event.dataTransfer.files || [])];
    const habiaDialogo = dialogoAbierto1310();
    ocultar1310();
    if (!archivos.length || habiaDialogo) return;
    event.preventDefault();
    event.stopPropagation();
    const lote = new DataTransfer();
    for (const archivo of archivos)
      if (/\.(xml|zip)$/i.test(archivo.name)) lote.items.add(archivo);
    let enrutados = 0;
    /* Un lote solo puede vivir en un input: si vienen XML/ZIP y
       un PDF juntos, el PDF se manda también en solitario. */
    if (lote.files.length) {
      const incoming = document.getElementById('incoming');
      if (incoming) { incoming.files = lote.files; incoming.dispatchEvent(new Event('change')); enrutados++; }
    }
    const primerPdf = archivos.find(archivo => /\.pdf$/i.test(archivo.name));
    if (primerPdf) {
      const lotePdf = new DataTransfer();
      lotePdf.items.add(primerPdf);
      const pdfInput = document.getElementById('invoice-pdf');
      if (pdfInput) { pdfInput.files = lotePdf.files; pdfInput.dispatchEvent(new Event('change')); enrutados++; }
    }
    if (!enrutados) toast('Ese tipo de archivo no se importa aquí: manda XML o ZIP (facturas) o un PDF (factura en PDF).', 'error');
  }, true);
})();

/* ===== Tu lista de gestos (1.31.1) =====
   Un solo sitio con TODO lo que solo Paco puede hacer y antes
   vivía repartido (la contraseña del respaldo, la e.firma de un
   RFC pendiente, el emparejamiento, la puerta que no abre, el
   acceso con contraseña). Sale del estado REAL del servidor
   (satData): cada gesto existe solo si su condición consta; lo
   que no se puede constatar no se lista. Sin gestos, la tarjeta
   dice «Nada espera tu mano» y no estorba. */
function gestosLista1311() {
  const lista = [];
  if (typeof satToken === 'undefined' || !satToken ||
    typeof satData === 'undefined' || !satData) return lista;
  for (const rfc of satData.pendingProfiles || []) lista.push({
    titulo: 'Sube la e.firma de ' + rfc,
    detalle: 'Su alta está preparada: sin su e.firma (o su CIEC) PacoSAT no puede descargar nada de este RFC.',
    boton: 'Dar sus credenciales', ir: () => navigate('sat') });
  const ex = satData.ejecutor;
  const irEjecutor200 = () => { satTab = 'ejecutor'; navigate('sat'); };
  /* Paseo en casa (2.8.0): en sede NAS (satData.paseo === 'nas')
     este gesto NO existe — el Buzón y las Declaraciones entran
     al portal desde casa, desde tu NAS, sin emparejar nada.
     Y la causa de la puerta (causaP200) tampoco puede salir
     «equipo» ni «sin-equipo» en esta sede, así que los gestos
     de puerta de abajo nunca apuntan a tu PC aquí. */
  if (ex && !ex.emparejado && satData.paseo !== 'nas') lista.push({
    titulo: 'Empareja tu equipo',
    detalle: 'Sin el ejecutor en tu PC, el Buzón Tributario y las Declaraciones no pueden entrar al portal del SAT.',
    boton: 'Emparejar', ir: irEjecutor200 });
  const puerta = scope ? satData.puerta?.[scope] : null;
  if (puerta && puerta.probada && puerta.ok === false) {
    /* Causa viva primero (2.0, M1 / 2.1): si el ejecutor no
       responde, el gesto es el equipo — jamás la e.firma; si
       la foto es vieja, se dice vieja; la e.firma solo es el
       gesto cuando ES la causa y la prueba es fresca. */
    const causaP = causaP200(puerta, ex);
    const irSat = () => navigate('sat');
    const errP = puerta.error ? ' (' + puerta.error + ')' : '';
    const gestoP = (titulo, detalle, boton, ir) => lista.push({ titulo, detalle, boton, ir });
    if (causaP.tipo === 'equipo') gestoP('Tu equipo no responde',
      'Sin señal desde el ' + localDateTime(ex.ultimoVisto) +
        ': la puerta no se puede probar. Al abrir el ejecutor, se prueba sola antes que nada.',
      'Ver tu ejecutor', irEjecutor200);
    else if (causaP.tipo === 'sin-equipo') gestoP('La puerta del SAT espera tu equipo',
      'Sin equipo emparejado la puerta no se puede probar: la última foto es del ' +
        localDateTime(puerta.probada) + ' y no manda hoy.',
      'Emparejar tu equipo', irEjecutor200);
    else if (causaP.tipo === 'vieja') gestoP('La puerta del SAT: foto vieja',
      'La última prueba es del ' + localDateTime(puerta.probada) +
        ' y puede estar desactualizada' + errP + ': no es una sentencia de hoy.',
      'Ver la puerta', irSat);
    else if (causaP.tipo === 'puerta') gestoP('La puerta del SAT no abre',
      'La última prueba automática no pudo entrar' + errP + ': mírala en su tarjeta.',
      'Ver la puerta', irSat);
    else gestoP('La puerta del SAT no abre',
      'La última prueba automática no pudo entrar con la e.firma de ' + scope +
        errP + ': el gesto es revisarla.',
      'Revisar la e.firma', irSat);
  }
  if (satData.adminLogin && !satData.adminLogin.configurado) lista.push({
    titulo: 'Activa tu acceso con contraseña',
    detalle: 'Sin él entras con el acceso de siempre del navegador; con tu contraseña, la app pide la suya y recuerda tu equipo de confianza.',
    boton: 'Activarlo', ir: () => { ajustesSection = 'sistema'; navigate('settings'); } });
  if (satData.scheduledBackup && !satData.scheduledBackup.enabled) lista.push({
    titulo: 'Define la contraseña del respaldo',
    detalle: 'Sin ella no hay respaldo programado ni su copia automática fuera del NAS. Se define una sola vez.',
    boton: 'Ir a Respaldos', ir: () => { ajustesSection = 'respaldos'; navigate('settings'); } });
  return lista;
}
/* «Lo que te necesita» ya no es panel propio: sus filas
   viven dentro de «Tus tareas» (hoyTareas2916, 2.9.16 · P2),
   en el piso de los gestos. gestosLista1311 sigue siendo la
   única fuente de los gestos (también alimenta la insignia
   del menú). */
/* El gesto CIEC llega con los datos del mes (Hoy los carga
   detrás): si la descarga automática quedó esperando a Paco,
   su fila se suma a la lista sin repintar Hoy entero. */
function gestosPintarCiec1311(monthly) {
  /* (2.9.16 · P2/P7) La fila CIEC entra en «Tus tareas» con el
     formato de sus filas; en una sesión de solo lectura no
     entra: no es un gesto suyo. */
  if (typeof guestMode !== 'undefined' && guestMode) return;
  const wrap = document.querySelector('[data-gestos1311]');
  if (!wrap || wrap.dataset.ciec1311) return;
  const run = (monthly?.runs || []).find(r =>
    Object.values(r.perRfc || {}).some(e => e.status === 'esperando-gesto'));
  if (!run) return;
  wrap.dataset.ciec1311 = '1';
  gestosCiecExtra1311 = 1;
  if (typeof senalesBarra1311 === 'function') senalesBarra1311();
  for (const p of wrap.querySelectorAll('.tareas-vacio2916')) p.remove();
  const row = n('div', undefined, 'atencion-fila2915 tarea-fila2916');
  const btn = n('button', 'Ir a la descarga', 'primary small');
  btn.type = 'button';
  btn.onclick = () => { satTab = 'descargar'; navigate('sat'); };
  row.append(estadoChip2915('pendiente', 'Pendiente'),
    cell('Termina la descarga con CIEC',
      'La descarga automática quedó esperando tu gesto: la CIEC y el captcha se teclean en su tarjeta, en tu equipo.'),
    btn);
  wrap.append(row);
}

/* ===== Novedades de la versión (1.31.1) =====
   Tras un montaje, la primera apertura enseña «Esto es lo
   nuevo» en palabras llanas: una nota por versión que viaja
   con el build (se redacta desde el informe de la ronda). Se
   cierra con un toque y no vuelve a salir hasta la siguiente
   versión: la marca es la propia versión, en la memoria del
   equipo. Si la versión de la app no es la de la nota, la
   tarjeta no existe (nada de notas viejas recicladas). */
const NOVEDADES_1311 = {
  version: '3.0.0',
  fecha: '20 de noviembre de 2026',
  puntos: [
    '«Ponerme al día»: un solo botón en Hoy y en Descargar que lo hace todo — revisa los metadatos, baja por el portal lo que falte y pide por la vía del SAT solo lo que el portal no pueda — y al terminar dice en palabras llanas si ya estás al día o qué falta.',
    'Descargar ya no pregunta el cómo: la tarjeta del caminante vive siempre a la vista con la puerta del SAT, el cupo del día y lo traído hoy, y la cobertura se ve como una rejilla del año que se toca mes a mes.',
    'En el iPhone, la barra inferior lleva las acciones del día al alcance del pulgar, las facturas se bajan y se envían a un toque desde su tarjeta, y Hoy abre al instante con lo último conocido.',
    'Aviso al iPhone cuando el SAT cancela una factura, con su folio y su importe; tocarlo abre esa factura. Y cada factura enseña su prueba de origen: por qué vía entró y cuándo.'
  ]
};
function novedadesCard1311() {
  if (typeof PACOSAT_META === 'undefined' || PACOSAT_META.version !== NOVEDADES_1311.version) return null;
  let vista = '';
  try { vista = localStorage.getItem('pacosat-novedades-vista') || ''; } catch { /* sin memoria local: se enseña */ }
  if (vista === NOVEDADES_1311.version) return null;
  /* (2.9.13 · mejora 30) La nota es una TARJETA DE VERSIÓN:
     su versión y su fecha en la cabecera, sus puntos dentro. */
  const card = panel('Esto es lo nuevo', 'PacoSAT ' + NOVEDADES_1311.version +
    (NOVEDADES_1311.fecha ? ' · ' + NOVEDADES_1311.fecha : '') + ', en palabras llanas.');
  card.classList.add('novedades-card2913');
  card.dataset.version2913 = NOVEDADES_1311.version;
  const lista = n('ul', undefined, 'novedades-list');
  for (const punto of NOVEDADES_1311.puntos) lista.append(n('li', punto));
  const acts = n('div', undefined, 'actions');
  const cerrar = n('button', 'Entendido', 'primary small');
  cerrar.type = 'button';
  cerrar.onclick = () => {
    try { localStorage.setItem('pacosat-novedades-vista', NOVEDADES_1311.version); } catch { /* sin memoria: se volverá a enseñar */ }
    card.remove();
  };
  acts.append(cerrar);
  card.append(lista, acts);
  return card;
}

/* ===== Archivo (1.31.1): guardar fuera de las vistas de trabajo =====
   El gesto que Paco pidió («no llenarme de basura»): cada CFDI
   y cada documento salen de las pantallas de trabajo con
   «Archivar» y su «Deshacer», y viven en la vista Archivo,
   recuperables. Un CFDI NUNCA se borra desde la app: su marca
   es records.archived en el servidor (la misma del cierre de
   línea base) y el cliente la separa al entrar (refresh). El
   documento lleva su marca en su propio registro y sale de
   Documentos y de las tarjetas de vigencia. */
async function cfdiArchivar1311(row, archivar = true) {
  if (!archivar) {
    await satApi('cfdi/archivar', { uuid: row.id, archivar: false });
    await refresh();
    toast('Comprobante restaurado: vuelve a Facturas y a los totales.', 'ok');
    render();
    return;
  }
  await conDeshacer1310('Comprobante archivado: sale de Facturas y de los totales; vive en Archivo.',
    async () => { await satApi('cfdi/archivar', { uuid: row.id, archivar: true }); await refresh(); },
    async () => { await satApi('cfdi/archivar', { uuid: row.id, archivar: false }); await refresh(); render(); });
}
async function docArchivar1311(doc, archivar = true) {
  const aplicar = async poner => {
    const copia = { ...doc };
    if (poner) copia.archived = true; else delete copia.archived;
    await writeBatch({ documents: [copia] });
    documents = documents.map(d => d.id === doc.id ? copia : d);
  };
  if (!archivar) {
    await aplicar(false);
    toast('Documento restaurado: vuelve a Documentos.', 'ok');
    render();
    return;
  }
  await conDeshacer1310('Documento archivado: sale de Documentos; vive en Archivo.',
    async () => { await aplicar(true); render(); },
    async () => { await aplicar(false); render(); });
}
/* ===== Archivar en lote con UN solo Deshacer (2.4.0 · WC4b2, pieza 25) =====
   Elección, declarada: la pieza vive en FACTURAS. Es la vista que
   YA tiene selección múltiple (las casillas y invoiceSelection, las
   mismas del ZIP y de «Imprimir seleccionados») y cuyo archivado de
   uno en uno (cfdiArchivar1311, aquí arriba) ya trae su Deshacer.
   Documentos no tiene selección múltiple hoy — su archivado es de
   tarjeta en tarjeta —, así que el lote nace donde la selección y
   el gesto ya existen, sin inventar otra selección paralela.
   El lote se archiva comprobante a comprobante por la MISMA ruta
   del gesto individual (cfdi/archivar); si uno falla a mitad, el
   lote dice cuáles entraron y cuáles no, y el Deshacer restaura
   EL LOTE ENTERO (solo lo que sí se archivó) con un solo gesto.
   El asiento en el Registro es UN solo hecho con su conteo. El
   aviso con «Deshacer» usa floatToast como conDeshacer1310, pero
   el texto se compone DESPUÉS de archivar — conDeshacer1310 fija
   su texto antes de saber si el lote entró entero — para no
   anunciar un éxito que el lote no tuvo (regla de estados). */
async function cfdiArchivarLote240(rows) {
  const lista = [...new Map((rows || []).filter(row => row && row.id).map(row => [row.id, row])).values()];
  if (!lista.length) {
    toast('Selecciona al menos un comprobante para archivar varios.', 'error');
    return { archivados: [], fallidos: [] };
  }
  const hechas = [], fallidas = [];
  for (const row of lista) {
    try { await satApi('cfdi/archivar', { uuid: row.id, archivar: true }); hechas.push(row.id); }
    catch { fallidas.push(row.id); }
  }
  if (typeof invoiceSelection !== 'undefined') for (const id of hechas) invoiceSelection.delete(id);
  await refresh();
  await logEvent('Archivados en lote: ' + hechas.length + ' comprobante(s)' +
    (fallidas.length ? ' · sin archivar ' + fallidas.length + ' (su archivado falló)' : '') +
    (hechas.length ? ' · ' + hechas.join(', ') : ''));
  if (!hechas.length) {
    announce('No se pudo archivar ninguno de los ' + lista.length + ' seleccionados: siguen en Facturas.', true);
    return { archivados: hechas, fallidos: fallidas };
  }
  if (fallidas.length)
    announce('Lote parcial: se archivaron ' + hechas.length + ' de ' + lista.length + '; ' +
      fallidas.length + ' no se pudieron archivar y siguen en Facturas.', true);
  let deshecho = false;
  const deshacerLote = async () => {
    const noRestauradas = [];
    for (const id of hechas) {
      try { await satApi('cfdi/archivar', { uuid: id, archivar: false }); }
      catch { noRestauradas.push(id); }
    }
    await refresh();
    await logEvent('Deshecho el lote de archivado: ' + (hechas.length - noRestauradas.length) +
      ' comprobante(s) restaurados de ' + hechas.length + '.');
    if (noRestauradas.length)
      announce('El lote se deshizo salvo ' + noRestauradas.length +
        ' comprobante(s), que siguen archivados: se restauran desde Archivo.', true);
    else toast('Lote deshecho: los ' + hechas.length + ' comprobantes vuelven a Facturas.', 'ok');
  };
  const limpiar = floatToast('Lote archivado: ' + hechas.length + ' comprobante(s) salen de Facturas ' +
    'y de los totales; viven en Archivo.', 'ok', async () => {
    if (deshecho) return;
    deshecho = true;
    await deshacerLote();
  });
  setTimeout(() => { if (!deshecho) limpiar?.(); }, 10000);
  return { archivados: hechas, fallidos: fallidas };
}
/* La barra del lote en Facturas: nace tras cada pintado de la
   vista (render envuelto aquí, como fillSat en Descargas: la
   vista vive en ui.part, fuera del territorio de esta tanda) y
   solo cuando hay selección viva — sin selección no hay barra,
   como las demás acciones de seleccionados de la vista. El
   invitado no la ve: archivar no es gesto suyo. */
function loteBarra240() {
  if (typeof page === 'undefined' || page !== 'invoices') return;
  if (typeof guestMode !== 'undefined' && guestMode) return;
  if (typeof invoiceSelection === 'undefined' || !invoiceSelection.size) return;
  const body = $('body');
  if (!body || !body.children) return;
  if ([...body.children].some(el => el?.dataset?.lote240)) return;
  const seleccionados = invoices.filter(row => invoiceSelection.has(row.id));
  if (!seleccionados.length) return;
  const barra = panel('Comprobantes seleccionados');
  barra.dataset.lote240 = '1';
  barra.append(n('p', number.format(seleccionados.length) + ' comprobante(s) con la casilla marcada. ' +
    'Puedes archivarlos todos de una vez: salen de Facturas y de los totales, viven en Archivo, ' +
    'y el lote entero se deshace con un solo gesto.'));
  const boton = action('Archivar varios', () => cfdiArchivarLote240(seleccionados), 'primary', 'box');
  boton.dataset.lote240Btn = '1';
  barra.append(boton);
  body.prepend(barra);
}
const renderCasa240 = render;
render = function render240() {
  renderCasa240();
  try { loteBarra240(); } catch { /* Pieza aditiva: la vista de siempre queda intacta. */ }
};
function archivoScreen1311() {
  const blocks = [];
  const delAlcance = invoicesArchivo.filter(row => row.from?.rfc === scope || row.to?.rfc === scope);
  /* Protagonista del Archivo (2.8.0 · diseño 25): cuántos
     papeles duermen aquí, por clase y desde cuándo, y el
     gesto propio de la pantalla — recuperar el más antiguo —
     como acción principal (antes el primario era «Ir a
     Facturas», un destino ajeno). */
  {
    const docsArc0 = documents.filter(doc => doc.archived && (!scope || doc.rfc === scope));
    const fechas = [...delAlcance.map(r => r.date), ...docsArc0.map(d => d.date)].filter(Boolean).sort();
    const prota = panel('Lo que duerme en el archivo');
    prota.append(n('p', delAlcance.length + ' comprobante(s) y ' + docsArc0.length + ' documento(s) archivados' +
      (fechas.length ? '; lo más antiguo es del ' + dateLabel(fechas[0]) + '.' : '.')));
    prota.classList.add('protagonista280');
    prota.dataset.protagonista280 = 'archivo';
    if (fechas.length) {
      const masAntiguo280 = fechas[0];
      const cfdiViejo = delAlcance.find(r => r.date === masAntiguo280);
      const docViejo = cfdiViejo ? null : docsArc0.find(d => d.date === masAntiguo280);
      const botonRec = action('Recuperar el más antiguo', () => {
        if (cfdiViejo) cfdiArchivar1311(cfdiViejo, false);
        else if (docViejo) docArchivar1311(docViejo, false);
      }, 'primary', 'check');
      botonRec.id = 'archivo-recuperar280';
      prota.append(botonRec);
    }
    blocks.push(prota);
  }
  const cfdiPanel = panel('Comprobantes archivados',
    'Fuera de Facturas, de Totales y de los reportes. Un CFDI nunca se borra desde la app: archivar es su único gesto, y es reversible.');
  if (delAlcance.length) {
    cfdiPanel.append(grid(['Comprobante', 'Fecha', 'Total', 'Acción'],
      delAlcance.slice(0, 100).map(row => {
        const cp = row.from?.rfc === scope ? row.to : row.from;
        const acts = n('div', undefined, 'actions');
        acts.append(action('Recuperar', () => cfdiArchivar1311(row, false)));
        return [cell(folioLabel(row), (cp?.name || cp?.rfc || '') + ' · ' + String(row.id).slice(0, 8) + '…'),
          dateLabel(row.date), amount(row), acts];
      })));
    if (delAlcance.length > 100) cfdiPanel.append(n('p', 'Se enseñan los 100 más recientes.', 'muted'));
  } else cfdiPanel.append(empty('Nada archivado', 'Cuando archives un comprobante desde Facturas, aparecerá aquí.'));
  blocks.push(cfdiPanel);
  const docsArc = documents.filter(doc => doc.archived && !doc.papelera && (!scope || doc.rfc === scope));
  const docPanel = panel('Documentos archivados',
    'Fuera de Documentos. «Eliminar definitivo» borra el PDF del expediente y pide confirmación.');
  if (docsArc.length) {
    docPanel.append(grid(['Documento', 'RFC', 'Fecha', 'Acción'], docsArc.map(doc => {
      const acts = n('div', undefined, 'actions');
      acts.append(action('Ver', () => viewDocOnline(doc)),
        action('Recuperar', () => docArchivar1311(doc, false)),
        action('Eliminar definitivo', () => deleteDocument(doc)));
      return [cell(doc.kind, doc.name), doc.rfc, dateLabel(doc.date), acts];
    })));
  } else docPanel.append(empty('Ningún documento archivado', 'El «Archivar» de Documentos guarda aquí lo que ya no quieres ver cada día.'));
  blocks.push(docPanel);
  /* Papelera de documentos (2.9.0 · Bloque C): lo que salió
     de Documentos con «Papelera» vive aquí, recuperable; el
     único borrado de verdad de un documento vive en este
     panel, con su nombre completo. */
  const docsPapelera290 = documents.filter(doc => doc.papelera && (!scope || doc.rfc === scope));
  const papeleraPanel290 = panel('Papelera de documentos',
    'Lo que moviste a la papelera desde Documentos. Restaurar lo devuelve a su sitio; «Eliminar definitivo» es el único borrado de verdad y pide confirmación.');
  if (docsPapelera290.length) {
    papeleraPanel290.append(grid(['Documento', 'RFC', 'Fecha', 'Acción'], docsPapelera290.map(doc => {
      const acts = n('div', undefined, 'actions');
      acts.append(action('Restaurar', async () => {
          await writeBatch({ documents: [{ ...doc, papelera: 0 }] });
          await logEvent('Documento restaurado de la papelera: ' + doc.name);
          await refresh(); announce('Documento restaurado.');
        }),
        action('Eliminar definitivo', () => deleteDocument(doc)));
      return [cell(doc.kind, doc.name), doc.rfc, dateLabel(doc.date), acts];
    })));
  } else papeleraPanel290.append(empty('Papelera vacía', 'El botón «Papelera» de Documentos manda aquí lo que ya no quieres ver, sin borrarlo.'));
  blocks.push(papeleraPanel290);
  const otros = panel('También vive archivado',
    'Cada cosa conserva su casa: los avisos en su pestaña de Archivadas y las notificaciones del SAT en la papelera de su Buzón.');
  const links = n('div', undefined, 'actions');
  const aAvisos = n('button', 'Avisos archivados', 'soft');
  aAvisos.type = 'button';
  aAvisos.onclick = () => {
    avisosVista = 'archivadas';
    if (typeof avisosGuardarFiltros1310 === 'function') avisosGuardarFiltros1310();
    navigate('avisos');
  };
  const aBuzon = n('button', 'Buzón Tributario', 'soft');
  aBuzon.type = 'button';
  aBuzon.onclick = () => navigate('tributario');
  links.append(aAvisos, aBuzon);
  otros.append(links);
  blocks.push(otros);
  /* (2.9.9 · D5) Con todo vacío, las tres tarjetas de contenido
     decían «nada» cada una: queda UNA sola tarjeta con el cero
     — la protagonista — y las demás viven tras un «Ver más»,
     con la Papelera y sus acciones intactas dentro. En cuanto
     hay algo archivado, la pantalla vuelve a su forma entera. */
  if (!delAlcance.length && !docsArc.length && !docsPapelera290.length) {
    const mas299 = n('details', undefined, 'seal-details');
    mas299.append(n('summary', 'Ver más'), ...blocks.slice(1, 4));
    return [blocks[0], mas299, blocks[4]];
  }
  return blocks;
}

/* ===== Señales de la barra lateral (1.31.1) =====
   Sin entrar a ningún sitio: el bloque del contribuyente lleva
   el punto veraz de la puerta del SAT (el registro sat_puerta
   del servidor) y el botón Hoy lleva la señal de los gestos que
   esperan la mano de Paco (la misma lista de «Tu lista de
   gestos»: lo que no consta no se señala). Se repinta en cada
   render, con el estado ya cargado — ninguna llamada nueva. */
let gestosCiecExtra1311 = 0;
/* La línea de la puerta del menú, con su frescura (2.3.0 ·
   pieza 12): estado + de cuándo es la foto, como las demás
   líneas del menú — «abre · foto de hoy», «no abre · foto del
   {fecha}», «sin probar todavía». Pura: «hoy» es el día de
   calendario de la prueba, no «hace menos de 24 h». */
function puertaLinea230(puerta, ahora = Date.now()) {
  if (!puerta || !puerta.probada) return { estado: 'sin-dato', texto: 'sin probar todavía' };
  const foto = new Date(puerta.probada), hoy = new Date(ahora);
  const esHoy = foto.getFullYear() === hoy.getFullYear() && foto.getMonth() === hoy.getMonth() &&
    foto.getDate() === hoy.getDate();
  const cuando = esHoy ? 'foto de hoy'
    : 'foto del ' + (typeof fechaCortaMenu202 === 'function' ? fechaCortaMenu202(puerta.probada)
      : foto.toLocaleDateString('es-MX', { day: 'numeric', month: 'short' }));
  return { estado: puerta.ok ? 'ok' : 'mal', texto: (puerta.ok ? 'abre' : 'no abre') + ' · ' + cuando };
}
/* ===== La puerta, UNA sola fuente de estado (2.9.9 · D6) =====
   El texto de la puerta sale SOLO de aquí: del registro de
   puerta del RFC que sirve el servidor (satData.puerta) y de
   su ejecutor, con causaP200 y puertaLinea230. Lo consumen
   IGUAL el lateral (senalesBarra1311: #puerta-txt/#puerta-dot)
   y la fila de Contribuyentes (contribuyentesPanel200b): el
   mismo hecho jamás se dice de dos maneras en la misma
   pantalla (la auditoría cazó «no abre» en el lateral contra
   «sin probar todavía» en la fila). Estados: sin probar;
   probada y abre; probada y no abre, con su clase — portal
   caído, e.firma u otro — nombrada en el propio texto. */
function puertaTexto299(puerta, ejecutor) {
  if (!puerta?.probada) return { estado: 'sin-dato', texto: 'sin probar todavía' };
  const causa = causaP200(puerta, ejecutor), linea = puertaLinea230(puerta);
  if (causa.tipo.includes('equipo'))
    return { estado: 'mal', texto: causa.tipo === 'equipo'
      ? 'sin señal de tu equipo desde el ' + localDateTime(ejecutor.ultimoVisto) : 'falta emparejar tu equipo' };
  if (causa.vieja) return { estado: puerta.ok ? 'vigilar' : 'mal',
    texto: linea.texto.replace(/^(no )?abre/, '$1abría') + ' (foto vieja)' };
  if (puerta.ok) return linea;
  const clase = causa.tipo === 'efirma' ? 'e.firma no entra'
    : /portal|ruta|respuesta/i.test(puerta.errorKind || '') ? 'portal caído' : '';
  /* La clase se inserta en la línea canónica: «no abre ·
     {clase} · {foto}» — un solo texto para los dos sitios. */
  return { estado: linea.estado, texto: clase ? linea.texto.replace(' · ', ' · ' + clase + ' · ') : linea.texto };
}
/* ===== Refresco de la puerta EN EL SITIO (2.9.13 · A3) =====
   Tras «Probar la puerta» con éxito (y tras cualquier acceso
   real que el servidor registra), el encabezado y la ficha del
   contribuyente seguían enseñando la foto vieja («no abre ·
   portal caído · foto de hoy», «sin probar») hasta cambiar de
   panel: la prueba repintaba su pantalla con render(), pero el
   estado global de la puerta (satData.puerta) no se re-leía.
   Este ayudante re-lee SOLO el estado, funde la puerta nueva
   en satData y repinta las señales de la barra en el sitio —
   sin cambiar de panel ni perder lo que el usuario mira. */
async function puertaRefrescarEnSitio2913(rfc) {
  try {
    const fresco = await satApi('status');
    if (fresco && typeof satData !== 'undefined' && satData) {
      if (fresco.puerta) satData.puerta = fresco.puerta;
      if (fresco.ejecutor) satData.ejecutor = fresco.ejecutor;
    }
  } catch { /* sin re-lectura: las señales pintan lo que haya */ }
  try { senalesBarra1311(); } catch { /* señal decorativa */ }
  try { pintarBotonScope200b(); } catch { /* selector decorativo */ }
  return rfc ? satData?.puerta?.[rfc] : null;
}
function senalesBarra1311() {
  const dot = document.getElementById('puerta-dot');
  const txt = document.getElementById('puerta-txt');
  /* (2.9.9 · D4b) En Hoy, puerta, buzón y declaraciones se
     pintan UNA vez — en sus tarjetas de Hoy —: el lateral no
     repite esos tres chips en esa pantalla (la línea de la
     puerta y las líneas de estado del menú se ocultan, no se
     borran: fuera de Hoy vuelven tal cual). Las entradas de
     navegación se quedan siempre. */
  for (const c of document.querySelectorAll('.puerta-line>span, #buzon-menu-estado202, #decl-menu-estado202'))
    c.hidden = page === 'home';
  if (dot && txt && page !== 'home') {
    const linea299 = puertaTexto299(satData?.puerta?.[scope], satData?.ejecutor);
    dot.dataset.state = linea299.estado;
    txt.textContent = 'Puerta del SAT: ' + linea299.texto;
  }
  const badge = document.getElementById('gestos-badge');
  if (badge) {
    /* (2.9.16 · P7) En solo lectura los gestos de
       administración no cuentan: no son de esta sesión. */
    const n = ((typeof guestMode !== 'undefined' && guestMode) ? 0 : gestosLista1311().length) + gestosCiecExtra1311;
    badge.hidden = !n;
    badge.textContent = n ? number.format(n) : '';
    badge.title = n ? n + (n === 1 ? ' gesto espera tu mano (en Hoy)' : ' gestos esperan tu mano (en Hoy)') : '';
  }
}
/* Cableado de la barra: el plegado a iconos se recuerda en
   este equipo. (2.8.0 · diseño 18: el botón de búsqueda de la
   barra ya no existe — buscar vive en la cabecera y en
   Ctrl+K — y con él se va su cableado.) */
(function barraCableado1311() {
  const plegar = document.getElementById('side-collapse');
  let plegada = false;
  try { plegada = localStorage.getItem('pacosat-barra-plegada') === '1'; } catch { /* sin memoria: desplegada */ }
  document.body.classList.toggle('barra-plegada', plegada);
  if (plegar) plegar.addEventListener('click', () => {
    const ahora = document.body.classList.toggle('barra-plegada');
    try { localStorage.setItem('pacosat-barra-plegada', ahora ? '1' : '0'); } catch { /* sin memoria: vale por la sesión */ }
    plegar.setAttribute('aria-label', ahora ? 'Expandir la barra lateral' : 'Plegar la barra lateral');
  });
})();

/* (2.9.16 · P1) El grupo «Más» del menú: se pliega al
   arrancar (los destinos menos frecuentes no ocupan el
   primer vistazo), el estado se recuerda en este equipo y
   navegar a un destino suyo lo abre solo — nadie aterriza
   en un destino invisible. En la barra plegada a iconos
   todos los destinos se enseñan (la CSS lo resuelve):
   plegar el grupo no esconde nada ahí. La etiqueta <nav>
   conserva su forma histórica, sin clase: el pliegue lo
   pone este cableado, que corre antes de pintar la vista. */
function navMasFijar2916(abierto, guardar = true) {
  const nav = document.querySelector('.sidebar nav');
  const btn = document.getElementById('nav-mas-btn2916');
  if (!nav || !btn) return;
  nav.classList.toggle('nav-mas-cerrado2916', !abierto);
  btn.setAttribute('aria-expanded', String(abierto));
  const flecha = btn.querySelector('.nav-mas-flecha2916');
  if (flecha) flecha.textContent = abierto ? '▾' : '▸';
  if (guardar) { try { localStorage.setItem('pacosat-nav-mas2916', abierto ? 'abierto' : 'cerrado'); } catch { /* sin memoria: vale por la sesión */ } }
}
function navMasAbrir2916() { navMasFijar2916(true, false); }
(function navMasCableado2916() {
  const btn = document.getElementById('nav-mas-btn2916');
  if (!btn) return;
  let abierto = false;
  try { abierto = localStorage.getItem('pacosat-nav-mas2916') === 'abierto'; } catch { /* sin memoria: plegado */ }
  navMasFijar2916(abierto, false);
  btn.addEventListener('click', () => navMasFijar2916(btn.getAttribute('aria-expanded') !== 'true'));
})();
/* (3.0 · mejora 21) El botón «Al día» de la barra de
   pulgar: lanza la puesta al día del RFC en ámbito y lleva
   a Descargar, donde su tarjeta enseña el avance. Sin RFC
   en ámbito, lleva a Descargar, donde la tarjeta enseña el
   paso que falta. */
(function aldiaBarCableado30() {
  const btn = document.getElementById('aldia30-bar');
  if (!btn) return;
  btn.addEventListener('click', async () => {
    const rfcBar30 = typeof scope !== 'undefined' ? scope : '';
    if (rfcBar30) {
      try { await aldiaRun30(rfcBar30); toast('Poniéndote al día…', 'ok'); }
      catch (error) { if (error.status !== 409) toast(error.message, 'error'); }
    }
    navigate('descargar');
  });
})();
