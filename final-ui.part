/* ===== Final 1.7.0: PWA, modo offline, preguntas, invitado =====
   La copia offline cubre los ÚLTIMOS 3 MESES (CFDI con desglose,
   saldos, esperadas, listados y posición bancaria) más los informes
   clave pregenerados en cada sincronización. Viaja CIFRADA con una
   clave del propio dispositivo (AES-GCM) y es de solo lectura; el
   sello «datos de las HH:MM» acompaña siempre a la consulta. */
function offlineDb() {
  return new Promise((resolve, reject) => {
    const request = indexedDB.open('pacosat-offline', 1);
    request.onupgradeneeded = () => request.result.createObjectStore('kv');
    request.onsuccess = () => resolve(request.result);
    request.onerror = () => reject(request.error);
  });
}
async function kvGet(key) {
  const db = await offlineDb();
  return new Promise((resolve, reject) => {
    const request = db.transaction('kv').objectStore('kv').get(key);
    request.onsuccess = () => resolve(request.result);
    request.onerror = () => reject(request.error);
  });
}
async function kvSet(key, value) {
  const db = await offlineDb();
  return new Promise((resolve, reject) => {
    const request = db.transaction('kv', 'readwrite').objectStore('kv').put(value, key);
    request.onsuccess = () => resolve();
    request.onerror = () => reject(request.error);
  });
}
async function offlineKey() {
  let jwk = await kvGet('key');
  if (!jwk) {
    const key = await crypto.subtle.generateKey({ name: 'AES-GCM', length: 256 }, true, ['encrypt', 'decrypt']);
    jwk = await crypto.subtle.exportKey('jwk', key);
    await kvSet('key', jwk);
  }
  return crypto.subtle.importKey('jwk', jwk, { name: 'AES-GCM' }, false, ['encrypt', 'decrypt']);
}
let offlineBundleCache = null;
async function syncOfflineBundle() {
  check(satToken, 'El paquete sin conexión se prepara desde el servidor.');
  const bundle = await satApi('offline-bundle');
  const key = await offlineKey();
  const iv = crypto.getRandomValues(new Uint8Array(12));
  const cipher = await crypto.subtle.encrypt({ name: 'AES-GCM', iv }, key, new TextEncoder().encode(JSON.stringify(bundle)));
  await kvSet('bundle', { iv: encode64(iv), data: encode64(new Uint8Array(cipher)), at: bundle.generatedAt });
  offlineBundleCache = bundle;
  return bundle;
}
async function loadOfflineBundle() {
  if (offlineBundleCache) return offlineBundleCache;
  const stored = await kvGet('bundle');
  if (!stored) return null;
  const key = await offlineKey();
  const plain = await crypto.subtle.decrypt({ name: 'AES-GCM', iv: decode64(stored.iv) }, key, decode64(stored.data));
  offlineBundleCache = JSON.parse(new TextDecoder().decode(plain));
  return offlineBundleCache;
}
/* Cola de acciones sin conexión: la solicitud al SAT queda registrada
   como INTENCIÓN (disciplina 5002: al volver la red se envía una
   sola vez; el servidor además la trata como solicitud en curso). */
async function enqueueOfflineAction(actionItem) {
  const queue = (await kvGet('queue')) || [];
  if (!queue.some(item => item.type === actionItem.type && item.rfc === actionItem.rfc)) queue.push(actionItem);
  await kvSet('queue', queue);
}
async function requestRunNow(rfc) {
  if (!navigator.onLine) {
    await enqueueOfflineAction({ type: 'run-now', rfc, at: Date.now() });
    announce('Sin conexión: la descarga de ' + rfc + ' queda EN COLA y se pedirá al volver internet. Registrada como intención; no se enviará dos veces.');
    soundCue('notice');
    return null;
  }
  return satApi('run-now', { rfc });
}
async function flushOfflineQueue() {
  if (!navigator.onLine || !satToken) return;
  const queue = (await kvGet('queue')) || [];
  if (!queue.length) return;
  const remaining = [];
  for (const item of queue) {
    try { if (item.type === 'run-now') await satApi('run-now', { rfc: item.rfc }); }
    catch { remaining.push(item); }
  }
  await kvSet('queue', remaining);
  if (remaining.length < queue.length) { logEvent('Cola sin conexión ejecutada al recuperar la red.'); announce('La cola sin conexión se ejecutó al volver la conexión.'); }
}
function offlineStamp(bundle) {
  return 'Estás viendo datos de las ' + new Intl.DateTimeFormat('es-MX', { hour: '2-digit', minute: '2-digit' }).format(bundle.generatedAt) +
    ' del ' + new Intl.DateTimeFormat('es-MX', { dateStyle: 'medium' }).format(bundle.generatedAt);
}
function offlineScreen() {
  const wrap = n('div');
  const head = panel('Sin conexión · consulta de los últimos 3 meses', 'PacoSAT guarda en este dispositivo una copia CIFRADA y de solo lectura de los últimos 3 meses (CFDI con desglose, saldos por cobrar/pagar, facturas esperadas, listados y posición bancaria) y deja pregenerados los informes clave de esos meses. El XML/PDF individual solo está si quedó en la caché reciente del navegador.');
  const syncBtn = n('button', 'Sincronizar ahora la copia sin conexión', 'soft');
  const body = n('div');
  syncBtn.onclick = async () => {
    try { const bundle = await syncOfflineBundle(); announce('Copia sin conexión actualizada.'); draw(bundle); }
    catch (error) { toast(error.message, 'error'); }
  };
  head.append(syncBtn);
  wrap.append(head, body);
  const draw = bundle => {
    body.replaceChildren();
    if (!bundle) { body.append(n('p', 'Aún no hay copia en este dispositivo. Con conexión, pulsa «Sincronizar ahora» y quedará lista para cuando falte la red.', 'empty')); return; }
    body.append(statusPill('warn', offlineStamp(bundle)));
    for (const report of bundle.reports) {
      const reportPanel = panel('Informe pregenerado · ' + report.month, 'Resumen del mes, IVA estimado y actividad. Se regenera en cada sincronización.');
      reportPanel.append(n('p', 'Emitidos: ' + report.totals.issuedCount + ' por $' + report.totals.issuedTotal +
        ' · Recibidos: ' + report.totals.receivedCount + ' por $' + report.totals.receivedTotal +
        (report.withoutFiscal ? ' · ' + report.withoutFiscal + ' CFDI sin desglose (su IVA no entra en la estimación)' : '')));
      for (const row of report.iva)
        reportPanel.append(n('p', row.rfc + ' · IVA trasladado $' + row.payable + ' · acreditable $' + row.creditable + ' · a cargo $' + row.balance));
      body.append(reportPanel);
    }
    const balances = panel('Por cobrar y por pagar (a la hora de la copia)', 'Saldos abiertos calculados desde los complementos de pago que había al sincronizar.');
    if (!bundle.balances.length) balances.append(n('p', 'Sin saldos abiertos en la copia.', 'empty'));
    for (const item of bundle.balances.slice(0, 60)) {
      const row = n('div', undefined, 'cp-row');
      row.append(statusPill(item.receivable ? 'warn' : 'dim', item.receivable ? 'Por cobrar' : 'Por pagar'),
        n('span', item.date + ' · ' + (item.receivable ? item.to.name : item.from.name) + ' · saldo $' + item.balance));
      balances.append(row);
    }
    body.append(balances);
    const lists = panel('Listados oficiales (antigüedad a la hora de la copia)', 'Si un listado lleva más de 48 horas en la copia, trátalo como orientativo y valida en línea al volver la red.');
    for (const source of bundle.listsSources)
      lists.append(n('p', source.label + ': ' + (source.fetched ? Math.round((Date.now() - source.fetched) / 3600000) + ' h de antigüedad al copiar' : 'sin cargar') + (source.error ? ' · con error' : ''), 'muted'));
    body.append(lists);
    body.append(n('p', 'CFDI en la copia: ' + bundle.invoices.length + ' · Posición bancaria al copiar: $' + bundle.bankPosition.total + '.', 'muted'));
  };
  loadOfflineBundle().then(draw).catch(() => draw(null));
  return [wrap];
}
/* ===== Preguntas en lenguaje normal (100 % local) =====
   Nada sale del dispositivo: reglas fijas sobre los datos locales. */
const MONTH_NAMES = { enero: '01', febrero: '02', marzo: '03', abril: '04', mayo: '05', junio: '06', julio: '07', agosto: '08', septiembre: '09', octubre: '10', noviembre: '11', diciembre: '12' };
function questionPeriod(text) {
  const nowDate = new Date();
  if (/mes pasado/.test(text)) { const date = new Date(nowDate.getFullYear(), nowDate.getMonth() - 1, 1); return date.toISOString().slice(0, 7); }
  if (/este mes/.test(text)) return nowDate.toISOString().slice(0, 7);
  for (const [name, number] of Object.entries(MONTH_NAMES))
    if (text.includes(name)) return nowDate.getFullYear() + '-' + number;
  const match = text.match(/(20\d{2})-(\d{2})/);
  return match ? match[0] : null;
}
function answerQuestion(raw) {
  const text = raw.toLocaleLowerCase('es-MX');
  const period = questionPeriod(text);
  const sumWhere = predicate => invoices.filter(predicate).reduce((acc, row) => acc + Number(totalCents(row)), 0) / 100;
  if (/cu[aá]nto debo/.test(text)) {
    const paidBy = paidByMap();
    let total = 0n, mayor = null;
    for (const row of invoices) {
      if (row.kind !== 'I' || !people.some(person => person.id === row.to.rfc)) continue;
      if (invoiceStateOf(row) === 'Cancelado') continue; /* criterio único (1.20.0): la cancelada no se debe */
      const balance = balanceOf(row, paidBy).balance;
      if (balance > 0n) { total += balance; if (!mayor || balance > mayor.balance) mayor = { row, balance }; }
    }
    /* La respuesta lleva el documento en la mano (1.25.0,
       mejora nº 7): la cifra y el comprobante mayor, en el
       mismo toque. */
    return { text: 'Por PAGAR tienes abiertos $' + centsLabel(total) +
        (mayor ? '. El mayor es de ' + (mayor.row.from.name || mayor.row.from.rfc) + ' por $' + centsLabel(mayor.balance) + ': ábrelo aquí mismo.' : '.'),
      invoice: mayor?.row };
  }
  if (/cu[aá]nto me deben/.test(text)) {
    const paidBy = paidByMap();
    let total = 0n, mayor = null;
    for (const row of invoices) {
      if (row.kind !== 'I' || !people.some(person => person.id === row.from.rfc)) continue;
      if (invoiceStateOf(row) === 'Cancelado') continue; /* criterio único (1.20.0): la cancelada no se cobra */
      const balance = balanceOf(row, paidBy).balance;
      if (balance > 0n) { total += balance; if (!mayor || balance > mayor.balance) mayor = { row, balance }; }
    }
    return { text: 'Por COBRAR tienes abiertos $' + centsLabel(total) +
        (mayor ? '. El mayor es de ' + (mayor.row.to.name || mayor.row.to.rfc) + ' por $' + centsLabel(mayor.balance) + ': ábrelo aquí mismo.' : '.'),
      invoice: mayor?.row };
  }
  if (/iva/.test(text) && period) {
    let payable = 0n, creditable = 0n;
    for (const row of invoices) {
      if (!row.date.startsWith(period) || !row.fiscal) continue;
      const issued = people.some(p => p.id === row.from.rfc);
      for (const tax of row.fiscal.transferred || []) if (tax.tax === '002') {
        if (issued) payable += moneyCents(tax.amount); else creditable += moneyCents(tax.amount);
      }
    }
    return 'IVA estimado de ' + period + ' (desde el desglose guardado): trasladado $' + centsLabel(payable) + ', acreditable $' + centsLabel(creditable) + ', a cargo $' + centsLabel(payable - creditable) + '. Es una estimación: la cifra oficial la cierra tu contadora.';
  }
  if (/qu[eé] vence|vencimientos/.test(text)) {
    const events = fiscalLocalEvents().filter(event => event.daysLeft <= 7);
    if (!events.length) return 'En los próximos 7 días no vence nada del calendario fiscal que conozco. El calendario completo está en Cumplimiento.';
    return 'Vence pronto: ' + events.map(event => event.title + ' (' + event.date + ', ' + (event.rfc || 'general') + ')').join(' · ') + '.';
  }
  if (/(factur|gast|compr|vend)/.test(text)) {
    const party = findPartyInQuestion(text);
    const base = invoices.filter(row => row.kind === 'I' && (!period || row.date.startsWith(period)) &&
      (!party || row.from.rfc === party || row.to.rfc === party));
    if (party || period) {
      const total = base.reduce((acc, row) => acc + Number(totalCents(row)), 0) / 100;
      const mayor = base.slice().sort((a, b) => (totalCents(b) > totalCents(a) ? 1 : -1))[0];
      return { text: 'Hay ' + base.length + ' CFDI' + (period ? ' de ' + period : '') + (party ? ' relacionados con ' + party : '') +
          ' por un total de $' + total.toLocaleString('es-MX', { minimumFractionDigits: 2 }) +
          (mayor ? '. El mayor, $' + centsLabel(totalCents(mayor)) + ', se abre aquí mismo.' : '.'),
        invoice: mayor };
    }
  }
  return 'Puedo responder con tus datos locales, sin salir de aquí: «¿cuánto me deben?», «¿cuánto debo?», «¿cuánto IVA tengo en octubre?», «¿qué vence esta semana?» o «¿cuánto facturó [RFC] este mes?».';
}
function findPartyInQuestion(text) {
  const upper = text.toUpperCase();
  const known = new Set();
  for (const row of invoices) { known.add(row.from.rfc); known.add(row.to.rfc); }
  for (const person of people) known.add(person.id);
  for (const rfc of known) if (upper.includes(rfc)) return rfc;
  return null;
}
function preguntasScreen() {
  const wrap = n('div');
  const panelEl = panel('Pregunta en lenguaje normal', 'Respuestas calculadas AQUÍ, con tus datos locales: nada se envía a ningún servicio externo. Sirve también sin conexión sobre los datos ya sincronizados.');
  const form = n('div', undefined, 'sat-form');
  const question = input('text', { placeholder: '¿Cuánto IVA tengo en octubre?' });
  const ask = n('button', 'Preguntar', 'soft');
  const answer = n('p', '', 'empty');
  const answerActions = n('div', undefined, 'sat-actions');
  const run = () => {
    try {
      /* Cifra + comprobante en el mismo toque (1.25.0, mejora
         nº 7): algunas respuestas traen la factura a la que se
         refieren y la pantalla ofrece abrirla sin salir. */
      const resultado = answerQuestion(question.value);
      answer.textContent = typeof resultado === 'string' ? resultado : resultado.text;
      answerActions.replaceChildren();
      if (typeof resultado !== 'string' && resultado.invoice) {
        const abrir = n('button', 'Abrir el comprobante', 'primary small');
        abrir.onclick = () => invoiceDetail(resultado.invoice);
        answerActions.append(abrir);
      }
      announce('Respuesta lista.');
    } catch (error) { answer.textContent = error.message; answerActions.replaceChildren(); }
  };
  ask.onclick = run;
  question.onkeydown = event => { if (event.key === 'Enter') run(); };
  form.append(fieldWrap('Tu pregunta', question), ask);
  panelEl.append(form, answer, answerActions);
  wrap.append(panelEl);
  return [wrap];
}
/* ===== «Probar todo» (autodiagnóstico) ===== */
function selfTestPanel() {
  const panelEl = panel('Probar todo', 'Autodiagnóstico en un clic: base de datos, correo, listados al día, respaldo y copia externa, y la caducidad de cada e.firma. No gasta solicitudes al SAT.');
  const out = n('div');
  const btn = n('button', 'Ejecutar el diagnóstico', 'soft');
  btn.onclick = async () => {
    out.replaceChildren(n('p', 'Probando…', 'muted'));
    try {
      const data = await satApi('selftest');
      out.replaceChildren();
      for (const checkItem of data.checks) {
        const row = n('div', undefined, 'cp-row');
        row.append(statusPill(checkItem.state === 'ok' ? 'ok' : checkItem.state === 'warn' ? 'warn' : checkItem.state === 'bad' ? 'bad' : 'dim', checkItem.label),
          n('span', checkItem.detail));
        out.append(row);
      }
      soundCue('success');
    } catch (error) { out.replaceChildren(n('p', error.message, 'error-text')); }
  };
  panelEl.append(btn, out);
  return panelEl;
}
/* ===== Bitácora reforzada: filtros y resumen de actividad ===== */
function activityPanel() {
  const panelEl = panel('Bitácora y resumen de actividad', 'Qué hizo PacoSAT solo y qué se hizo desde la app: filtros por tipo y el resumen por día y por semana, exportable. Cada entrada de la actividad reciente (en Resumen) abre su objeto.');
  const controls = n('div', undefined, 'sat-form');
  const kindSel = n('select');
  for (const [value, label] of [['', 'Todos los tipos'], ['sat', 'SAT'], ['import', 'Importaciones'], ['event', 'Eventos'], ['alert', 'Alertas']]) {
    const option = n('option', label); option.value = value; kindSel.append(option);
  }
  const textFilter = input('text', { placeholder: 'Buscar texto o RFC…' });
  const out = n('div');
  const classify = row => row.event ? (row.event.startsWith('Cancelación') ? 'alert' : 'event') : (row.name.startsWith('SAT') ? 'sat' : 'import');
  const draw = () => {
    const kind = kindSel.value, needle = textFilter.value.trim().toLocaleLowerCase('es-MX');
    const filtered = activity.filter(row => (!kind || classify(row) === kind) &&
      (!needle || (row.name + ' ' + (row.event || '')).toLocaleLowerCase('es-MX').includes(needle)));
    out.replaceChildren();
    const dayKey = row => row.date.slice(0, 10);
    const todayKey = new Date().toISOString().slice(0, 10);
    const weekAgo = new Date(Date.now() - 7 * 86400000).toISOString().slice(0, 10);
    const todayCount = filtered.filter(row => dayKey(row) === todayKey).length;
    const weekCount = filtered.filter(row => dayKey(row) >= weekAgo).length;
    out.append(n('p', 'Coincidencias: ' + filtered.length + ' · hoy: ' + todayCount + ' · últimos 7 días: ' + weekCount));
    for (const row of filtered.slice(0, 40)) {
      const item = n('div', undefined, 'cp-row');
      item.append(statusPill(classify(row) === 'alert' ? 'bad' : classify(row) === 'sat' ? 'ok' : 'dim', classify(row)),
        n('span', row.date.slice(0, 10) + ' · ' + (row.event || row.name)));
      out.append(item);
    }
  };
  kindSel.onchange = draw;
  textFilter.oninput = draw;
  const exportBtn = n('button', 'Exportar bitácora (CSV)', 'soft');
  exportBtn.onclick = async () => {
    const rows = [['fecha', 'nombre', 'evento'], ...activity.map(row => [row.date, row.name, row.event || ''])];
    await download('bitacora-pacosat.csv', new TextEncoder().encode(csvText(rows)), 'text/csv');
    announce('Bitácora exportada.');
  };
  controls.append(fieldWrap('Tipo', kindSel), fieldWrap('Texto', textFilter), exportBtn);
  panelEl.append(controls, out);
  draw();
  return panelEl;
}
/* ===== Acceso invitado (Ajustes) ===== */
/* Vista Nora (1.25.0, AGREGAR 3): la contadora entra como
   invitada y su pantalla inicial es ESTA — la lista del mes con
   su estado, de solo lectura: qué consta y qué falta, sin un
   solo control que cambie nada. La marca «contadora» la pone
   Paco en el panel de invitado; el servidor la expone como
   sesionContadora a quien pregunta con esa sesión. */
let noraSesionCache = null;
function noraVistaPanel() {
  const panelEl = panel('Tu lista del mes', 'Solo lectura: el estado del cierre de cada RFC, tal como consta en PacoSAT. Lo que falte se lo prepara Paco; tú solo consultas.');
  const monthInput = input('month', { value: new Date().toISOString().slice(0, 7), 'aria-label': 'Mes' });
  const body = n('div');
  body.append(n('p', 'Consultando la lista del mes…', 'muted'));
  const paint = async () => {
    try {
      const data = await satApi('reports/checklist?month=' + monthInput.value);
      body.replaceChildren();
      const hechos = (data.items || []).filter(item => item.level === 'ok').length;
      body.append(n('p', 'Van ' + hechos + ' de ' + (data.items || []).length + ' pasos del cierre de ' + data.month + ' en verde.'));
      for (const item of data.items || []) {
        const row = n('div', undefined, 'cp-row');
        row.append(statusPill(item.level === 'ok' ? 'ok' : item.level === 'bad' ? 'bad' : 'warn',
            item.level === 'ok' ? '✓ Hecho' : 'Falta'),
          n('span', item.label), n('span', item.detail || '', 'muted'));
        body.append(row);
      }
      if (!data.items?.length) body.append(n('p', 'Sin pasos para ese mes.', 'empty'));
    } catch (error) { body.replaceChildren(n('p', error.message, 'error-text')); }
  };
  monthInput.onchange = paint;
  panelEl.append(fieldWrap('Mes', monthInput), body);
  paint();
  return panelEl;
}
function guestPanel() {
  const panelEl = panel('Acceso invitado de solo lectura', 'Una credencial SEPARADA para que otra persona (tu contadora, por ejemplo) consulte sin poder cambiar nada. Está desactivado por defecto; cada entrada y cada intento quedan en la bitácora de accesos. La dirección de entrada es la misma app con /invitado al final.');
  const body = n('div');
  panelEl.append(body);
  const draw = async () => {
    body.replaceChildren();
    try {
      const config = await satApi('guest/config');
      const strip = n('div', undefined, 'traffic-strip');
      strip.append(statusPill(config.enabled ? 'warn' : 'ok', config.enabled ? 'Invitado ACTIVADO' : 'Invitado desactivado'),
        statusPill(config.hasPassword ? 'ok' : 'bad', config.hasPassword ? 'Contraseña fijada' : 'Sin contraseña'));
      body.append(strip);
      const form = n('div', undefined, 'sat-form');
      const password = input('password', { placeholder: 'Nueva contraseña del invitado (mín. 8)', autocomplete: 'new-password' });
      const toggle = n('button', config.enabled ? 'Desactivar invitado' : 'Activar invitado', 'soft');
      toggle.onclick = async () => {
        try { await satApi('guest/config', { enabled: !config.enabled }); announce('Acceso de invitado actualizado.'); draw(); }
        catch (error) { toast(error.message, 'error'); }
      };
      const save = n('button', 'Guardar contraseña', 'soft');
      save.onclick = async () => {
        try { check(password.value.length >= 8, 'La contraseña debe tener al menos 8 caracteres.'); await satApi('guest/config', { password: password.value }); password.value = ''; announce('Contraseña del invitado guardada.'); draw(); }
        catch (error) { toast(error.message, 'error'); }
      };
      form.append(fieldWrap('Contraseña', password), save, toggle);
      body.append(form);
      /* Alcance por RFC (1.9.0): sin marcar ninguno, el invitado ve
         todos los RFC (como antes); marcando, SOLO ve esos RFC —
         el filtro se aplica en el servidor, no en la pantalla. Con
         alcance, Bancos y el paquete sin conexión quedan fuera. */
      const scopeBox = n('div', undefined, 'sat-form');
      scopeBox.append(n('strong', 'Alcance por RFC'));
      scopeBox.append(n('p', config.rfcs?.length
        ? 'Este acceso solo ve: ' + config.rfcs.join(', ') + '. Bancos y el paquete sin conexión quedan fuera de su alcance.'
        : 'Sin límite: este acceso ve TODOS los RFC. Marca abajo los que quieras permitir y guarda.', 'muted'));
      const checks = new Map();
      for (const person of people) {
        const label = n('label', undefined, 'switch-line');
        const box = input('checkbox', { checked: (config.rfcs || []).includes(person.id) });
        checks.set(person.id, box);
        label.append(box, n('span', person.name + ' · ' + person.id));
        scopeBox.append(label);
      }
      const saveScope = n('button', 'Guardar alcance', 'soft');
      saveScope.onclick = async () => {
        try {
          const rfcs = [...checks.entries()].filter(([, box]) => box.checked).map(([rfc]) => rfc);
          await satApi('guest/config', { rfcs });
          announce(rfcs.length ? 'Alcance guardado: el invitado solo verá ' + rfcs.join(', ') + '.' : 'Alcance guardado: sin límite por RFC.');
          draw();
        } catch (error) { toast(error.message, 'error'); }
      };
      scopeBox.append(saveScope);
      body.append(scopeBox);
      /* Vista de la contadora (1.25.0, AGREGAR 3): con esta marca,
         la sesión invitada abre en su lista del mes (solo
         lectura) en vez del Resumen general. */
      const noraBox = n('div', undefined, 'sat-form');
      noraBox.append(n('strong', 'Vista de la contadora'));
      noraBox.append(n('p', 'Si este acceso es el de tu contadora, márcalo: al entrar verá primero su lista del mes con el estado de cada paso, siempre en solo lectura.', 'muted'));
      const noraLabel = n('label', undefined, 'switch-line');
      const noraCheck = input('checkbox', { checked: Boolean(config.contadora) });
      noraCheck.onchange = async () => {
        try {
          await satApi('guest/config', { contadora: noraCheck.checked });
          announce(noraCheck.checked ? 'Vista de la contadora activada para el acceso invitado.' : 'Vista de la contadora desactivada.');
        } catch (error) { toast(error.message, 'error'); noraCheck.checked = !noraCheck.checked; }
      };
      noraLabel.append(noraCheck, n('span', 'Este acceso es el de la contadora'));
      noraBox.append(noraLabel);
      body.append(noraBox);
      const log = await satApi('access-log');
      if (log.entries.length) {
        body.append(n('h4', 'Bitácora de accesos'));
        for (const entry of log.entries.slice(0, 30))
          body.append(n('p', new Date(entry.at).toLocaleString('es-MX') + ' · ' + entry.kind + ' · ' + entry.detail, 'muted'));
      }
    } catch (error) { body.append(n('p', error.message, 'error-text')); }
  };
  if (satToken) draw();
  else body.append(n('p', 'Solo en modo servidor.', 'empty'));
  return panelEl;
}
/* Arranque de la 1.7.0: service worker, aviso sin conexión, cola y
   login del invitado. */
if ('serviceWorker' in navigator && typeof satToken !== 'undefined' && satToken) {
  navigator.serviceWorker.register('/sw.js').catch(() => {});
}
function updateConnectivityBanner() {
  const banner = $('offline-banner');
  if (!banner) return;
  if (navigator.onLine) { banner.hidden = true; return; }
  banner.hidden = false;
  banner.textContent = 'Sin conexión: estás en modo de solo lectura con la copia local. Sincroniza la copia en la pantalla «Sin conexión» cuando vuelva la red.';
  loadOfflineBundle().then(bundle => { if (bundle) banner.textContent = 'Sin conexión · ' + offlineStamp(bundle); }).catch(() => {});
}
window.addEventListener('online', () => { updateConnectivityBanner(); flushOfflineQueue(); });
window.addEventListener('offline', updateConnectivityBanner);
document.addEventListener('DOMContentLoaded', updateConnectivityBanner);

/* Login del invitado: sin token de sesión en el almacenamiento, la
   pantalla pide la credencial separada y recarga ya identificado. */
function showGuestLogin() {
  const form = n('form', undefined, 'dialog-form');
  form.append(n('h3', 'Acceso de invitado · solo lectura'),
    n('p', 'Escribe la contraseña de invitado. Podrás consultar, pero no cambiar nada.', 'muted'));
  const password = input('password', { autocomplete: 'current-password' });
  form.append(fieldWrap('Contraseña de invitado', password));
  const enter = n('button', 'Entrar como invitado', 'primary');
  enter.type = 'submit';
  form.append(enter);
  form.onsubmit = async event => {
    event.preventDefault();
    try {
      const response = await fetch('/api/guest/login', { method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ password: password.value }) });
      const data = await response.json().catch(() => ({}));
      check(response.ok, data.error || 'No se pudo entrar.');
      sessionStorage.setItem('pacosat-guest-token', data.token);
      location.reload();
    } catch (error) { toast(error.message, 'error'); }
  };
  showDialog(form);
}
if (typeof guestMode !== 'undefined' && guestMode && !sessionStorage.getItem('pacosat-guest-token')) showGuestLogin();
/* ===== Respaldo partido por RFC y año (mejora nº 8) =====
   Un .faro por cada combinación RFC/año presente en los CFDI, con el
   mismo formato del respaldo completo: cada parte se restaura sola
   con el restaurador de siempre. */
async function splitBackupDialog() {
  await requireStorage();
  check(!importing && crypto.subtle, 'El respaldo no está disponible en este navegador o hay una importación activa.');
  const password = input('password', { required: true, minLength: 12, autocomplete: 'new-password' });
  const repeat = input('password', { required: true, minLength: 12, autocomplete: 'new-password' });
  dialog('Respaldo partido por RFC y año', [n('p', 'Se genera un archivo .faro por cada RFC y año con facturas: más cómodo para archivar por ejercicios. Cada parte se restaura por separado con la misma contraseña. Sin la contraseña ningún archivo se puede abrir.', 'news-note'),
    field('Contraseña de al menos 12 caracteres', password), field('Confirma la contraseña', repeat)], async () => {
    check(password.value.length >= 12 && password.value === repeat.value, 'Revisa que las contraseñas coincidan.');
    const full = await snapshot();
    const combos = new Map();
    for (const row of full.invoices) {
      for (const rfc of new Set([row.from?.rfc, row.to?.rfc])) {
        if (!rfc) continue;
        const key = rfc + '|' + String(row.date || '').slice(0, 4);
        if (!combos.has(key)) combos.set(key, []);
        combos.get(key).push(row);
      }
    }
    check(combos.size, 'No hay facturas para partir el respaldo.');
    let made = 0;
    for (const [key, rows] of combos) {
      const [rfc, year] = key.split('|');
      const ids = new Set(rows.map(row => row.id));
      const docs = full.documents.filter(doc => doc.rfc === rfc);
      const docIds = new Set(docs.map(doc => doc.id));
      const part = { version: 2,
        people: full.people.filter(person => person.id === rfc),
        invoices: rows,
        documents: docs,
        files: full.files.filter(file => docIds.has(file.id) ||
          (file.id.startsWith('xml:') && ids.has(file.id.slice(4))) ||
          (file.id.startsWith('pdf:') && ids.has(file.id.slice(4)))),
        activity: [] };
      download(await encryptBackup(part, password.value), 'PacoSAT-' + rfc + '-' + year + '.faro');
      made++;
    }
    await logEvent('Respaldo partido creado (' + made + ' archivos por RFC y año)');
    announce(made + ' archivos de respaldo generados, uno por RFC y año.');
    soundCue('success');
  }, 'Crear respaldo partido');
}
/* F8 · Deshacer universal (1.31.0): ayudante global para los
   gestos que mueven datos — ejecuta hacer(), enseña el toast
   con botón «Deshacer» durante 10 segundos y, si se pulsa,
   ejecuta deshacer() una sola vez. La tarjeta es la de
   floatToast; su vida (15 s) se acorta aquí a 10 s retirando
   la tarjeta al cumplirse el plazo, porque el contrato de este
   gesto son 10 s y no los 15 del resto de avisos con deshacer. */
async function conDeshacer1310(texto, hacer, deshacer) {
  await hacer();
  let deshecho = false;
  const limpiar = floatToast(texto, 'ok', async () => {
    if (deshecho) return;
    deshecho = true;
    await deshacer();
  });
  setTimeout(() => { if (!deshecho) limpiar?.(); }, 10000);
}
/* F13 · Arrastrar y soltar (1.31.0): al arrastrar archivos
   sobre la ventana, un overlay a pantalla completa dice
   «Suelta para importar»; al soltar, los .xml/.zip entran por
   el flujo de importación de siempre (el input #incoming, el
   mismo que usa el botón «Importar») y los .pdf por el de
   «Factura PDF» (el input #invoice-pdf). Se reutilizan los
   handlers existentes asignando los archivos al input y
   despachando su change — ningún camino nuevo.
   Los oyentes van en fase de CAPTURA: los de workflows.part
   corren en burbuja y abrirían la pantalla XML además; aquí se
   intercepta antes y el soltar no les llega (stopPropagation).
   Si hay un diálogo abierto, no se intercepta nada: soltar
   dentro de un diálogo es asunto del diálogo. */
(function pacosatDrop1310() {
  let cuentaDrag1310 = 0;
  const traeArchivos1310 = event => Boolean(event.dataTransfer &&
    [...(event.dataTransfer.types || [])].includes('Files'));
  const overlay1310 = () => {
    let capa = document.getElementById('drop-overlay-1310');
    if (!capa) {
      capa = n('div', 'Suelta para importar', 'drop-overlay');
      capa.id = 'drop-overlay-1310';
      capa.hidden = true;
      document.body.append(capa);
    }
    return capa;
  };
  const ocultar1310 = () => {
    cuentaDrag1310 = 0;
    const capa = document.getElementById('drop-overlay-1310');
    if (capa) capa.hidden = true;
  };
  const dialogoAbierto1310 = () => Boolean(document.querySelector('dialog[open]'));
  window.addEventListener('dragenter', event => {
    if (!traeArchivos1310(event) || dialogoAbierto1310()) return;
    cuentaDrag1310++;
    overlay1310().hidden = false;
  }, true);
  window.addEventListener('dragover', event => {
    if (!traeArchivos1310(event) || dialogoAbierto1310()) return;
    event.preventDefault();
    overlay1310().hidden = false;
  }, true);
  window.addEventListener('dragleave', event => {
    if (!traeArchivos1310(event)) return;
    cuentaDrag1310 = Math.max(0, cuentaDrag1310 - 1);
    if (cuentaDrag1310 === 0) ocultar1310();
  }, true);
  window.addEventListener('drop', event => {
    if (!traeArchivos1310(event)) return;
    const archivos = [...(event.dataTransfer.files || [])];
    const habiaDialogo = dialogoAbierto1310();
    ocultar1310();
    if (!archivos.length || habiaDialogo) return;
    event.preventDefault();
    event.stopPropagation();
    const lote = new DataTransfer();
    for (const archivo of archivos)
      if (/\.(xml|zip)$/i.test(archivo.name)) lote.items.add(archivo);
    let enrutados = 0;
    /* Un lote solo puede vivir en un input: si vienen XML/ZIP y
       un PDF juntos, el PDF se manda también en solitario. */
    if (lote.files.length) {
      const incoming = document.getElementById('incoming');
      if (incoming) { incoming.files = lote.files; incoming.dispatchEvent(new Event('change')); enrutados++; }
    }
    const primerPdf = archivos.find(archivo => /\.pdf$/i.test(archivo.name));
    if (primerPdf) {
      const lotePdf = new DataTransfer();
      lotePdf.items.add(primerPdf);
      const pdfInput = document.getElementById('invoice-pdf');
      if (pdfInput) { pdfInput.files = lotePdf.files; pdfInput.dispatchEvent(new Event('change')); enrutados++; }
    }
    if (!enrutados) toast('Ese tipo de archivo no se importa aquí: manda XML o ZIP (facturas) o un PDF (factura en PDF).', 'error');
  }, true);
})();

/* ===== Tu lista de gestos (1.31.1) =====
   Un solo sitio con TODO lo que solo Paco puede hacer y antes
   vivía repartido (la contraseña del respaldo, la e.firma de un
   RFC pendiente, el emparejamiento, la puerta que no abre, el
   acceso con contraseña). Sale del estado REAL del servidor
   (satData): cada gesto existe solo si su condición consta; lo
   que no se puede constatar no se lista. Sin gestos, la tarjeta
   dice «Nada espera tu mano» y no estorba. */
function gestosLista1311() {
  const lista = [];
  if (typeof satToken === 'undefined' || !satToken ||
    typeof satData === 'undefined' || !satData) return lista;
  for (const rfc of satData.pendingProfiles || []) lista.push({
    titulo: 'Sube la e.firma de ' + rfc,
    detalle: 'Su alta está preparada: sin su e.firma (o su CIEC) PacoSAT no puede descargar nada de este RFC.',
    boton: 'Dar sus credenciales', ir: () => navigate('sat') });
  const ex = satData.ejecutor;
  if (ex && !ex.emparejado) lista.push({
    titulo: 'Empareja tu equipo',
    detalle: 'Sin el ejecutor en tu PC, el Buzón Tributario y las Declaraciones no pueden entrar al portal del SAT.',
    boton: 'Emparejar', ir: () => { satTab = 'ejecutor'; navigate('sat'); } });
  const puerta = scope ? satData.puerta?.[scope] : null;
  if (puerta && puerta.probada && puerta.ok === false) lista.push({
    titulo: 'La puerta del SAT no abre',
    detalle: 'La última prueba automática no pudo entrar con la e.firma de ' + scope +
      (puerta.error ? ' (' + puerta.error + ')' : '') + ': el gesto es revisarla.',
    boton: 'Revisar la e.firma', ir: () => navigate('sat') });
  if (satData.adminLogin && !satData.adminLogin.configurado) lista.push({
    titulo: 'Activa tu acceso con contraseña',
    detalle: 'Sin él entras con el acceso de siempre del navegador; con tu contraseña, la app pide la suya y recuerda tu equipo de confianza.',
    boton: 'Activarlo', ir: () => { ajustesSection = 'sistema'; navigate('settings'); } });
  if (satData.scheduledBackup && !satData.scheduledBackup.enabled) lista.push({
    titulo: 'Define la contraseña del respaldo',
    detalle: 'Sin ella no hay respaldo programado ni su copia automática fuera del NAS. Se define una sola vez.',
    boton: 'Ir a Respaldos', ir: () => { ajustesSection = 'respaldos'; navigate('settings'); } });
  return lista;
}
function gestosPanel1311() {
  const lista = gestosLista1311();
  const wrap = panel('Tu lista de gestos', lista.length
    ? 'Todo lo que solo tú puedes hacer: junto, con su botón. El sistema no puede hacerlo por ti.'
    : '');
  wrap.dataset.gestos1311 = '1';
  if (!lista.length) {
    wrap.append(n('p', 'Nada espera tu mano: el sistema no necesita ningún gesto tuyo ahora.', 'today-line'));
    return wrap;
  }
  for (const g of lista) {
    const row = n('div', undefined, 'gestos-row');
    const txt = n('div', undefined, 'gestos-txt');
    txt.append(n('strong', g.titulo), n('p', g.detalle));
    const btn = n('button', g.boton, 'primary small');
    btn.type = 'button';
    btn.onclick = g.ir;
    row.append(txt, btn);
    wrap.append(row);
  }
  return wrap;
}
/* El gesto CIEC llega con los datos del mes (Hoy los carga
   detrás): si la descarga automática quedó esperando a Paco,
   su fila se suma a la lista sin repintar Hoy entero. */
function gestosPintarCiec1311(monthly) {
  const wrap = document.querySelector('[data-gestos1311]');
  if (!wrap || wrap.dataset.ciec1311) return;
  const run = (monthly?.runs || []).find(r =>
    Object.values(r.perRfc || {}).some(e => e.status === 'esperando-gesto'));
  if (!run) return;
  wrap.dataset.ciec1311 = '1';
  gestosCiecExtra1311 = 1;
  if (typeof senalesBarra1311 === 'function') senalesBarra1311();
  for (const p of wrap.querySelectorAll('p.today-line'))
    if (p.textContent.startsWith('Nada espera tu mano')) p.remove();
  const row = n('div', undefined, 'gestos-row');
  const txt = n('div', undefined, 'gestos-txt');
  txt.append(n('strong', 'Termina la descarga con CIEC'),
    n('p', 'La descarga automática quedó esperando tu gesto: la CIEC y el captcha se teclean en su tarjeta, en tu equipo.'));
  const btn = n('button', 'Ir a la descarga', 'primary small');
  btn.type = 'button';
  btn.onclick = () => { satTab = 'descargar'; navigate('sat'); };
  row.append(txt, btn);
  wrap.append(row);
}

/* ===== Novedades de la versión (1.31.1) =====
   Tras un montaje, la primera apertura enseña «Esto es lo
   nuevo» en palabras llanas: una nota por versión que viaja
   con el build (se redacta desde el informe de la ronda). Se
   cierra con un toque y no vuelve a salir hasta la siguiente
   versión: la marca es la propia versión, en la memoria del
   equipo. Si la versión de la app no es la de la nota, la
   tarjeta no existe (nada de notas viejas recicladas). */
const NOVEDADES_1311 = {
  version: '1.32.2',
  puntos: [
    'El color de la casa ahora es el azul: botones, marcas y estados visten el azul en claro y en oscuro. El verde de antes sigue en Ajustes › Color de acento, como una muestra más, por si lo quieres de vuelta.',
    'Modo oscuro pulido y medido: los rótulos de la barra lateral y la alerta de meses vencidos de Declaraciones ya cumplen el mismo contraste que el resto del sistema, en las doce pantallas.',
    'Marca propia: PacoSAT estrena su faro — el mismo dibujo en la barra lateral, en el pie y en el icono de la app — y el medallón ya vira con el tema y el acento en vez de quedarse en su verde fijo de antes.',
    'Los reportes imprimen en tamaño carta (antes A4): el PDF de las salidas y la representación impresa de los comprobantes salen en el papel que se usa aquí.',
    'En Hoy manda el día: la tarjeta «Hoy en PacoSAT», con lo que te toca, va primero y «Esto es lo nuevo» queda debajo, sin taparla.',
    'El Registro respira: la hora y el texto de cada suceso ya no van pegados.'
  ]
};
function novedadesCard1311() {
  if (typeof PACOSAT_META === 'undefined' || PACOSAT_META.version !== NOVEDADES_1311.version) return null;
  let vista = '';
  try { vista = localStorage.getItem('pacosat-novedades-vista') || ''; } catch { /* sin memoria local: se enseña */ }
  if (vista === NOVEDADES_1311.version) return null;
  const card = panel('Esto es lo nuevo', 'PacoSAT ' + NOVEDADES_1311.version + ', en palabras llanas.');
  const lista = n('ul', undefined, 'novedades-list');
  for (const punto of NOVEDADES_1311.puntos) lista.append(n('li', punto));
  const acts = n('div', undefined, 'actions');
  const cerrar = n('button', 'Entendido', 'primary small');
  cerrar.type = 'button';
  cerrar.onclick = () => {
    try { localStorage.setItem('pacosat-novedades-vista', NOVEDADES_1311.version); } catch { /* sin memoria: se volverá a enseñar */ }
    card.remove();
  };
  acts.append(cerrar);
  card.append(lista, acts);
  return card;
}

/* ===== Archivo (1.31.1): guardar fuera de las vistas de trabajo =====
   El gesto que Paco pidió («no llenarme de basura»): cada CFDI
   y cada documento salen de las pantallas de trabajo con
   «Archivar» y su «Deshacer», y viven en la vista Archivo,
   recuperables. Un CFDI NUNCA se borra desde la app: su marca
   es records.archived en el servidor (la misma del cierre de
   línea base) y el cliente la separa al entrar (refresh). El
   documento lleva su marca en su propio registro y sale de
   Documentos y de las tarjetas de vigencia. */
async function cfdiArchivar1311(row, archivar = true) {
  if (!archivar) {
    await satApi('cfdi/archivar', { uuid: row.id, archivar: false });
    await refresh();
    toast('Comprobante restaurado: vuelve a Facturas y a los totales.', 'ok');
    render();
    return;
  }
  await conDeshacer1310('Comprobante archivado: sale de Facturas y de los totales; vive en Archivo.',
    async () => { await satApi('cfdi/archivar', { uuid: row.id, archivar: true }); await refresh(); },
    async () => { await satApi('cfdi/archivar', { uuid: row.id, archivar: false }); await refresh(); render(); });
}
async function docArchivar1311(doc, archivar = true) {
  const aplicar = async poner => {
    const copia = { ...doc };
    if (poner) copia.archived = true; else delete copia.archived;
    await writeBatch({ documents: [copia] });
    documents = documents.map(d => d.id === doc.id ? copia : d);
  };
  if (!archivar) {
    await aplicar(false);
    toast('Documento restaurado: vuelve a Documentos.', 'ok');
    render();
    return;
  }
  await conDeshacer1310('Documento archivado: sale de Documentos; vive en Archivo.',
    async () => { await aplicar(true); render(); },
    async () => { await aplicar(false); render(); });
}
function archivoScreen1311() {
  const blocks = [];
  const delAlcance = invoicesArchivo.filter(row => row.from?.rfc === scope || row.to?.rfc === scope);
  const cfdiPanel = panel('Comprobantes archivados',
    'Fuera de Facturas, de Totales y de los reportes. Un CFDI nunca se borra desde la app: archivar es su único gesto, y es reversible.');
  if (delAlcance.length) {
    cfdiPanel.append(grid(['Comprobante', 'Fecha', 'Total', 'Acción'],
      delAlcance.slice(0, 100).map(row => {
        const cp = row.from?.rfc === scope ? row.to : row.from;
        const acts = n('div', undefined, 'actions');
        acts.append(action('Restaurar', () => cfdiArchivar1311(row, false)));
        return [cell(folioLabel(row), (cp?.name || cp?.rfc || '') + ' · ' + String(row.id).slice(0, 8) + '…'),
          dateLabel(row.date), amount(row), acts];
      })));
    if (delAlcance.length > 100) cfdiPanel.append(n('p', 'Se enseñan los 100 más recientes.', 'muted'));
  } else cfdiPanel.append(empty('Nada archivado', 'Cuando archives un comprobante desde Facturas, aparecerá aquí.'));
  blocks.push(cfdiPanel);
  const docsArc = documents.filter(doc => doc.archived && (!scope || doc.rfc === scope));
  const docPanel = panel('Documentos archivados',
    'Fuera de Documentos. «Eliminar definitivo» borra el PDF del expediente y pide confirmación.');
  if (docsArc.length) {
    docPanel.append(grid(['Documento', 'RFC', 'Fecha', 'Acción'], docsArc.map(doc => {
      const acts = n('div', undefined, 'actions');
      acts.append(action('Ver', () => viewDocOnline(doc)),
        action('Restaurar', () => docArchivar1311(doc, false)),
        action('Eliminar definitivo', () => deleteDocument(doc)));
      return [cell(doc.kind, doc.name), doc.rfc, dateLabel(doc.date), acts];
    })));
  } else docPanel.append(empty('Ningún documento archivado', 'El «Archivar» de Documentos guarda aquí lo que ya no quieres ver cada día.'));
  blocks.push(docPanel);
  const otros = panel('También vive archivado',
    'Cada cosa conserva su casa: los avisos en su pestaña de Archivadas y las notificaciones del SAT en la papelera de su Buzón.');
  const links = n('div', undefined, 'actions');
  const aAvisos = n('button', 'Avisos archivadas', 'soft');
  aAvisos.type = 'button';
  aAvisos.onclick = () => {
    avisosVista = 'archivadas';
    if (typeof avisosGuardarFiltros1310 === 'function') avisosGuardarFiltros1310();
    navigate('avisos');
  };
  const aBuzon = n('button', 'Buzón Tributario', 'soft');
  aBuzon.type = 'button';
  aBuzon.onclick = () => navigate('tributario');
  links.append(aAvisos, aBuzon);
  otros.append(links);
  blocks.push(otros);
  return blocks;
}

/* ===== Señales de la barra lateral (1.31.1) =====
   Sin entrar a ningún sitio: el bloque del contribuyente lleva
   el punto veraz de la puerta del SAT (el registro sat_puerta
   del servidor) y el botón Hoy lleva la señal de los gestos que
   esperan la mano de Paco (la misma lista de «Tu lista de
   gestos»: lo que no consta no se señala). Se repinta en cada
   render, con el estado ya cargado — ninguna llamada nueva. */
let gestosCiecExtra1311 = 0;
function senalesBarra1311() {
  const dot = document.getElementById('puerta-dot');
  const txt = document.getElementById('puerta-txt');
  if (dot && txt) {
    const puerta = (typeof satData !== 'undefined' && scope) ? satData?.puerta?.[scope] : null;
    if (!puerta || !puerta.probada) {
      dot.dataset.state = 'sin-dato';
      txt.textContent = 'Puerta del SAT: sin probar todavía';
    } else if (puerta.ok) {
      dot.dataset.state = 'ok';
      txt.textContent = 'Puerta del SAT: abre';
    } else {
      dot.dataset.state = 'mal';
      txt.textContent = 'Puerta del SAT: no abre — revísala en Hoy';
    }
  }
  const badge = document.getElementById('gestos-badge');
  if (badge) {
    const n = gestosLista1311().length + gestosCiecExtra1311;
    badge.hidden = !n;
    badge.textContent = n ? number.format(n) : '';
    badge.title = n ? n + (n === 1 ? ' gesto espera tu mano (en Hoy)' : ' gestos esperan tu mano (en Hoy)') : '';
  }
}
/* Cableado de la barra: la búsqueda de arriba ES la búsqueda
   global de siempre (su puerta en la barra, no otro buscador)
   y el plegado a iconos se recuerda en este equipo. */
(function barraCableado1311() {
  const buscar = document.getElementById('side-search');
  if (buscar) buscar.addEventListener('click', () => {
    const input = document.getElementById('global-search');
    if (input) { input.scrollIntoView({ block: 'nearest' }); input.focus(); input.select?.(); }
  });
  const plegar = document.getElementById('side-collapse');
  let plegada = false;
  try { plegada = localStorage.getItem('pacosat-barra-plegada') === '1'; } catch { /* sin memoria: desplegada */ }
  document.body.classList.toggle('barra-plegada', plegada);
  if (plegar) plegar.addEventListener('click', () => {
    const ahora = document.body.classList.toggle('barra-plegada');
    try { localStorage.setItem('pacosat-barra-plegada', ahora ? '1' : '0'); } catch { /* sin memoria: vale por la sesión */ }
    plegar.setAttribute('aria-label', ahora ? 'Expandir la barra lateral' : 'Plegar la barra lateral');
  });
})();
