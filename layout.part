<!doctype html>
<html lang="es"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><meta name="referrer" content="no-referrer"><meta http-equiv="Content-Security-Policy" content="default-src 'none'; style-src 'unsafe-inline'; script-src 'unsafe-inline'; img-src data:; base-uri 'none'; form-action 'none'"><title>PacoSAT</title><link rel="manifest" href="/manifest.webmanifest"><meta name="theme-color" id="theme-color-meta" content="#0e2a47">
<style>/*STYLES*/</style></head>
<body>
<svg class="symbols" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
<symbol id="i-logo" viewBox="0 0 24 24"><path d="M4 19 12 4l8 15M8 14h8m-5 5h2"/></symbol>
<symbol id="i-home" viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></symbol>
<symbol id="i-file" viewBox="0 0 24 24"><path d="M6 3h8l4 4v14H6zm8 0v5h4M9 12h6m-6 4h6"/></symbol>
<symbol id="i-folder" viewBox="0 0 24 24"><path d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/></symbol>
<symbol id="i-sync" viewBox="0 0 24 24"><path d="M20 7v5h-5M4 17v-5h5m-4-3a8 8 0 0 1 13-3l2 3M4 15l2 3a8 8 0 0 0 13-3"/></symbol>
<symbol id="i-box" viewBox="0 0 24 24"><path d="M3 5h18v5H3zm2 5v10h14V10m-9 4h4"/></symbol>
<symbol id="i-up" viewBox="0 0 24 24"><path d="M12 16V4m-5 5 5-5 5 5M4 16v4h16v-4"/></symbol>
<symbol id="i-down" viewBox="0 0 24 24"><path d="M12 4v12m-5-5 5 5 5-5M4 17v3h16v-3"/></symbol>
<symbol id="i-arrow" viewBox="0 0 24 24"><path d="M5 12h14m-6-6 6 6-6 6"/></symbol>
<symbol id="i-search" viewBox="0 0 24 24"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 4 4"/></symbol>
<symbol id="i-plus" viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></symbol>
<symbol id="i-lock" viewBox="0 0 24 24"><rect x="5" y="10" width="14" height="11" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3m-4 4v3"/></symbol>
<symbol id="i-close" viewBox="0 0 24 24"><path d="m6 6 12 12M6 18 18 6"/></symbol>
<symbol id="i-bell" viewBox="0 0 24 24"><path d="M6 9.5a6 6 0 0 1 12 0c0 4.5 2 5.5 2 5.5H4s2-1 2-5.5M10 19a2.2 2.2 0 0 0 4 0"/></symbol>
<symbol id="i-shield" viewBox="0 0 24 24"><path d="M12 3l7 2.8V11c0 4.8-2.9 7.9-7 9.5C7.9 18.9 5 15.8 5 11V5.8z"/><path d="m9 11.6 2.1 2.1 3.9-4.2"/></symbol>
<symbol id="i-key" viewBox="0 0 24 24"><circle cx="8" cy="15.5" r="4.3"/><path d="M11.1 12.4 20 3.5m-3.4 3.4 2.7 2.7M14.5 7.9l2.2 2.2"/></symbol>
<symbol id="i-chart" viewBox="0 0 24 24"><path d="M4 4v15.5h16"/><path d="M8.5 16.5v-4m4.5 4v-8.5m4.5 8.5V10"/></symbol>
<symbol id="i-bank" viewBox="0 0 24 24"><path d="M3.5 9.5 12 4l8.5 5.5M5 9.5V19m4.7-9.5V19m4.6-9.5V19M19 9.5V19M3.5 19h17"/></symbol>
<symbol id="i-print" viewBox="0 0 24 24"><path d="M7 8V3.5h10V8"/><rect x="4" y="8" width="16" height="7.5" rx="2"/><path d="M7 12.5h10V20H7z"/></symbol>
<symbol id="i-help" viewBox="0 0 24 24"><circle cx="12" cy="12" r="8.8"/><path d="M9.6 9.4A2.5 2.5 0 1 1 12 12.4v1.1m0 2.9v.3"/></symbol>
<symbol id="i-dots" viewBox="0 0 24 24"><circle cx="5" cy="12" r="1.8"/><circle cx="12" cy="12" r="1.8"/><circle cx="19" cy="12" r="1.8"/></symbol>
<symbol id="i-sun" viewBox="0 0 24 24"><circle cx="12" cy="12" r="3.8"/><path d="M12 2.8v2m0 14.4v2M2.8 12h2m14.4 0h2M5.2 5.2l1.4 1.4m10.8 10.8 1.4 1.4m0-13.6-1.4 1.4M6.6 17.4l-1.4 1.4"/></symbol>
<symbol id="i-moon" viewBox="0 0 24 24"><path d="M20 13.6A8.2 8.2 0 1 1 10.4 4 6.6 6.6 0 0 0 20 13.6z"/></symbol>
<symbol id="i-volume" viewBox="0 0 24 24"><path d="M4 9.5v5h3.8L13 19V5L7.8 9.5H4z"/><path d="M16 9.2a4 4 0 0 1 0 5.6m2.4-8.3a8 8 0 0 1 0 11"/></symbol>
<symbol id="i-mute" viewBox="0 0 24 24"><path d="M4 9.5v5h3.8L13 19V5L7.8 9.5H4z"/><path d="m16.2 9.7 5.3 5.3m0-5.3-5.3 5.3"/></symbol>
<symbol id="i-check" viewBox="0 0 24 24"><path d="m4.5 12.6 5 5L19.5 6.4"/></symbol>
<symbol id="i-alert" viewBox="0 0 24 24"><path d="M12 3.5 2.8 19.5h18.4z"/><path d="M12 9.8v4.2m0 2.8v.4"/></symbol>
<symbol id="i-clock" viewBox="0 0 24 24"><circle cx="12" cy="12" r="8.5"/><path d="M12 7.5V12l3 2"/></symbol>
<symbol id="i-eye" viewBox="0 0 24 24"><path d="M2.8 12S6.2 5.4 12 5.4 21.2 12 21.2 12 17.8 18.6 12 18.6 2.8 12 2.8 12z"/><circle cx="12" cy="12" r="3"/></symbol>
<symbol id="i-gear" viewBox="0 0 24 24"><circle cx="12" cy="12" r="3.4"/><path d="M12 2.9v3.1m0 12v3.1M2.9 12h3.1m12 0h3.1M5.3 5.3l2.2 2.2m9 9 2.2 2.2m0-13.4-2.2 2.2m-9 9-2.2 2.2"/></symbol>
<symbol id="i-inbox" viewBox="0 0 24 24"><path d="M3 13.5 5.6 4.8A2 2 0 0 1 7.5 3.5h9a2 2 0 0 1 1.9 1.3L21 13.5V19a1.6 1.6 0 0 1-1.6 1.6H4.6A1.6 1.6 0 0 1 3 19z"/><path d="M3 13.5h5.2l1.3 2.4a1.6 1.6 0 0 0 1.4.9h2.2a1.6 1.6 0 0 0 1.4-.9l1.3-2.4H21"/></symbol>
<symbol id="i-mail" viewBox="0 0 24 24"><rect x="3" y="5.5" width="18" height="13" rx="2"/><path d="m3.5 7 8.5 6 8.5-6"/></symbol>
<symbol id="i-code" viewBox="0 0 24 24"><path d="m8.5 8-4 4 4 4m7-8 4 4-4 4M13.5 5.5l-3 13"/></symbol>
<symbol id="i-pdf" viewBox="0 0 24 24"><path d="M6 3h8l4 4v14H6zm8 0v5h4"/><path d="M6.5 15.5h11"/></symbol>
</svg>
<div class="frame">
<aside class="sidebar">
  <div class="brand"><span class="logo"><svg id="brand-mark"><use href="#i-logo"/></svg><img id="brand-logo" alt="" hidden src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7"></span><span><span id="brand-name">PacoSAT</span><small>ESPACIO DE TRABAJO</small></span></div>
  <div class="switcher"><label for="scope">CONTRIBUYENTE</label><select id="scope"></select><button id="add" class="quiet"><svg><use href="#i-plus"/></svg> Agregar RFC</button></div>
  <!-- Menú por tarea (1.18.0): lo de cada día arriba —Hoy, Dinero,
       Facturas, Documentos—, el trabajo en medio y lo técnico
       agrupado como Sistema. Documentos tiene entrada propia y
       visible; ningún destino lleva a otra pantalla disfrazado. -->
  <nav aria-label="Navegación principal">
    <span class="nav-caption">CADA DÍA</span>
    <button data-view="home" aria-current="page"><svg><use href="#i-home"/></svg> Hoy <span id="news-badge" class="news-badge" hidden></span></button>
    <button data-view="dinero"><svg><use href="#i-chart"/></svg> Dinero <span id="dinero-badge" class="news-badge" hidden></span></button>
    <button data-view="invoices"><svg><use href="#i-file"/></svg> Facturas</button>
    <button data-view="docs"><svg><use href="#i-folder"/></svg> Documentos</button>
    <span class="nav-caption nav-divider">EL TRABAJO</span>
    <button data-view="avisos"><svg><use href="#i-bell"/></svg> Avisos <span id="avisos-badge" class="news-badge" hidden></span></button>
    <button data-view="buzon"><svg><use href="#i-inbox"/></svg> Buzón <span id="buzon-badge" class="news-badge" hidden></span></button>
    <button data-view="tributario"><svg><use href="#i-mail"/></svg> Buzón Tributario <span id="tributario-badge" class="news-badge" hidden></span></button>
    <button data-view="pagos"><svg><use href="#i-bank"/></svg> Pagos al banco</button>
    <button data-view="salidas"><svg><use href="#i-check"/></svg> Cierre y reportes</button>
    <span class="nav-caption nav-divider">SISTEMA</span>
    <button data-view="sat"><svg><use href="#i-shield"/></svg> SAT</button>
    <button data-view="settings"><svg><use href="#i-gear"/></svg> Ajustes</button>
  </nav>
  <!-- Actividad del sistema en el propio menú (1.18.0): el punto y
       la línea los pinta el pulso de actividad; sin trabajos dice
       cuándo es la próxima revisión automática. -->
  <div class="local" id="side-activity" style="margin-top:0" hidden><span class="dot" id="side-activity-dot" aria-hidden="true"></span><span id="side-activity-text">Sin trabajos en curso</span></div>
  <div class="local"><svg><use href="#i-lock"/></svg><span id="storage-mode">Guardado en este equipo</span></div>
  <div class="side-version" id="side-version"></div>
</aside>
<div id="offline-banner" class="offline-banner" hidden></div>
<main>
  <header class="top"><span>PacoSAT <span class="slash">/</span> <strong id="crumb">Resumen</strong></span><span class="top-side"><!-- F5 (1.22.0): el contribuyente también arriba, visible sin abrir la barra lateral — pensado para el día del segundo RFC. Espejo del selector lateral: cambiar uno cambia el otro. --><select id="scope-top" class="scope-top" aria-label="Contribuyente" title="Contribuyente"></select><span class="top-search"><input id="global-search" type="search" placeholder="Buscar UUID, folio fiscal o RFC…" aria-label="Buscador global de CFDI" title="Buscador global (Ctrl+K)"></span><span id="counters" class="header-counters"></span><span class="top-tools"><button id="ask-button" class="icon-button" type="button" aria-label="Preguntas: pregunta en lenguaje normal" title="Preguntas"><svg><use href="#i-help"/></svg></button><button id="sound-toggle" class="icon-button" type="button" aria-pressed="true" aria-label="Sonidos de la interfaz" title="Sonidos de la interfaz"><svg><use href="#i-volume"/></svg></button><button id="theme-toggle" class="icon-button" type="button" aria-label="Cambiar entre tema claro y oscuro" title="Tema claro u oscuro"><svg><use href="#i-moon"/></svg></button></span><span class="badge"><span class="dot"></span> <span id="mode">Modo local</span></span></span></header>
  <div class="page">
    <header class="heading">
      <div><div class="eyebrow" id="eyebrow">ESPACIO FISCAL</div><h1 id="title">Resumen fiscal</h1><p id="subtitle">Facturas y documentos de tus contribuyentes en un solo lugar.</p></div>
      <div class="actions"><button id="inspect"><svg><use href="#i-code"/></svg> Abrir XML</button><button id="pdf-import"><svg><use href="#i-pdf"/></svg> Factura PDF</button><button id="primary" class="primary"><svg><use href="#i-up"/></svg><span>Importar XML / ZIP</span></button></div>
    </header>
    <p id="status" role="status" hidden></p>
    <section id="activity-dock" class="activity-dock" hidden aria-live="polite">
      <div class="activity-dock-head"><span class="activity-spinner" aria-hidden="true"></span><strong id="activity-label">Trabajando…</strong><span id="activity-count" class="activity-count"></span></div>
      <meter id="activity-bar" min="0" max="100" value="0"></meter>
      <p id="activity-detail" class="activity-detail"></p>
    </section>
    <section id="activity-result" class="activity-result" hidden>
      <div class="activity-result-head"><strong id="activity-result-title">✓ Procesado</strong><button type="button" id="activity-result-close" class="icon-button" aria-label="Cerrar el resumen"><svg><use href="#i-close"/></svg></button></div>
      <div id="activity-result-text"></div>
    </section>
    <section id="body" aria-label="Contenido"></section>
    <footer class="app-footer" id="app-footer"></footer>
  </div>
</main>
<nav class="bottombar" aria-label="Navegación rápida">
  <button data-view="home" aria-current="page"><svg><use href="#i-home"/></svg> Hoy</button>
  <button data-view="avisos"><svg><use href="#i-bell"/></svg> Avisos</button>
  <button data-view="invoices"><svg><use href="#i-file"/></svg> Facturas</button>
  <button data-view="pagos"><svg><use href="#i-bank"/></svg> Pagos</button>
  <button id="more-button" type="button"><svg><use href="#i-dots"/></svg> Más</button>
</nav>
</div>
<section id="print-report" aria-hidden="true"></section>
<!-- Pantalla de entrada diseñada (1.26.0): la cara del login
     propio. Vive oculta; la enseña maybeShowEntry() cuando el
     login propio está configurado y no hay sesión suya activa.
     Convive con la puerta vigente: «Entrar con mi acceso de
     siempre» la aparta por la sesión del navegador. -->
<section id="entry" class="entry" hidden aria-label="Entrada a PacoSAT">
  <div class="entry-card">
    <span class="logo entry-logo"><svg><use href="#i-logo"/></svg></span>
    <h1 class="entry-title">PacoSAT</h1>
    <p class="entry-sub">Tu espacio fiscal, guardado en tu propio servidor.</p>
    <form id="entry-form" class="entry-form">
      <label for="entry-pass">Tu contraseña de administrador</label>
      <input id="entry-pass" type="password" autocomplete="current-password" placeholder="Contraseña">
      <p id="entry-error" class="error-text" role="alert" hidden></p>
      <button id="entry-go" class="primary" type="submit">Entrar</button>
    </form>
    <button id="entry-skip" type="button" class="quiet entry-skip">Entrar con mi acceso de siempre</button>
    <p class="entry-note">Este login es tuyo y convive con tu acceso de siempre: ninguno sustituye al otro en esta versión.</p>
  </div>
</section>
<!-- Avisos flotantes (1.26.0): las confirmaciones se ven donde
     está el dedo; la barra #status sigue siendo el registro. -->
<div id="toasts" class="toasts" aria-live="polite"></div>
<input id="incoming" type="file" accept=".xml,.zip" multiple hidden>
<input id="inspectFile" type="file" accept=".xml,text/xml,application/xml" hidden>
<input id="invoice-pdf" type="file" accept=".pdf,application/pdf" hidden>
<input id="folder" type="file" webkitdirectory multiple hidden>
<input id="restore" type="file" accept=".faro,application/json" hidden>
<dialog id="dialog" aria-labelledby="dialogTitle">
  <form id="form"><div class="modal-head"><h2 id="dialogTitle"></h2><button type="button" class="icon-button" id="close" aria-label="Cerrar"><svg><use href="#i-close"/></svg></button></div>
  <div id="fields"></div><p id="formError" role="alert" hidden></p>
  <div class="modal-actions"><button type="button" id="cancel">Cerrar</button><button class="primary" id="save" type="submit">Guardar</button></div></form>
</dialog>
<script>/*SCRIPT*/</script>
</body></html>
