<!doctype html>
<html lang="es"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><meta name="referrer" content="no-referrer"><meta http-equiv="Content-Security-Policy" content="default-src 'none'; style-src 'unsafe-inline'; script-src 'unsafe-inline'; img-src data:; base-uri 'none'; form-action 'none'"><title>PacoSAT</title><link rel="manifest" href="/manifest.webmanifest"><link rel="apple-touch-icon" href="/apple-touch-icon.png"><meta name="apple-mobile-web-app-capable" content="yes"><meta name="mobile-web-app-capable" content="yes"><meta name="apple-mobile-web-app-title" content="PacoSAT"><meta name="apple-mobile-web-app-status-bar-style" content="black-translucent"><link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='14' fill='%230e2a47'/%3E%3Cg transform='translate(8 8) scale(2)' fill='none' stroke='%23f4b942' stroke-width='1.65' stroke-linecap='round' stroke-linejoin='round'%3E%3Cpath d='M12 2.6v1.5M11 4.1h2l.9 4.3M10.1 8.4 11 4.1M6.9 6.2 3.8 4.6M17.1 6.2l3.1-1.6M8.6 20.6 10.1 8.4h3.8l1.5 12.2M10.4 14.6h3.2M6.4 20.6h11.2'/%3E%3C/g%3E%3C/svg%3E"><meta name="theme-color" id="theme-color-meta" content="#0e2a47">
<script data-320-tema>/* (3.2.0 · piezas 4/33) Tema oscuro y letra grande, aplicados
   en <html> antes del primer pintado desde su preferencia. */
try{var d320=document.documentElement;if(localStorage.getItem('pacosat-tema')==='oscuro')d320.dataset.theme='dark';if(localStorage.getItem('pacosat-letra')==='grande')d320.dataset.letra='grande';}catch(e){}</script>
<style>/*STYLES*/</style>
<style data-320>/* (3.2.0) CSS propio mínimo del frente principal; el de la
   paleta, el papel y las líneas de vida viaja con la parte
   perezosa visual320, que es quien los pinta. */
.fila-cancelada320 td:first-child{box-shadow:inset 4px 0 0 #b3261e}
.aviso-importe320{font-size:23px;font-weight:700;margin:2px 0}
</style></head>
<body>
<svg class="symbols" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
<symbol id="i-logo" viewBox="0 0 24 24"><path d="M12 2.6v1.5M11 4.1h2l.9 4.3M10.1 8.4 11 4.1M6.9 6.2 3.8 4.6M17.1 6.2l3.1-1.6M8.6 20.6 10.1 8.4h3.8l1.5 12.2M10.4 14.6h3.2M6.4 20.6h11.2"/></symbol>
<symbol id="i-home" viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></symbol>
<symbol id="i-file" viewBox="0 0 24 24"><path d="M6 3h8l4 4v14H6zm8 0v5h4M9 12h6m-6 4h6"/></symbol>
<symbol id="i-folder" viewBox="0 0 24 24"><path d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/></symbol>
<symbol id="i-sync" viewBox="0 0 24 24"><path d="M20 7v5h-5M4 17v-5h5m-4-3a8 8 0 0 1 13-3l2 3M4 15l2 3a8 8 0 0 0 13-3"/></symbol>
<symbol id="i-box" viewBox="0 0 24 24"><path d="M3 5h18v5H3zm2 5v10h14V10m-9 4h4"/></symbol>
<symbol id="i-up" viewBox="0 0 24 24"><path d="M12 16V4m-5 5 5-5 5 5M4 16v4h16v-4"/></symbol>
<symbol id="i-down" viewBox="0 0 24 24"><path d="M12 4v12m-5-5 5 5 5-5M4 17v3h16v-3"/></symbol>
<symbol id="i-arrow" viewBox="0 0 24 24"><path d="M5 12h14m-6-6 6 6-6 6"/></symbol>
<symbol id="i-search" viewBox="0 0 24 24"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 4 4"/></symbol>
<symbol id="i-plus" viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></symbol>
<symbol id="i-lock" viewBox="0 0 24 24"><rect x="5" y="10" width="14" height="11" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3m-4 4v3"/></symbol>
<symbol id="i-close" viewBox="0 0 24 24"><path d="m6 6 12 12M6 18 18 6"/></symbol>
<symbol id="i-bell" viewBox="0 0 24 24"><path d="M6 9.5a6 6 0 0 1 12 0c0 4.5 2 5.5 2 5.5H4s2-1 2-5.5M10 19a2.2 2.2 0 0 0 4 0"/></symbol>
<symbol id="i-shield" viewBox="0 0 24 24"><path d="M12 3l7 2.8V11c0 4.8-2.9 7.9-7 9.5C7.9 18.9 5 15.8 5 11V5.8z"/><path d="m9 11.6 2.1 2.1 3.9-4.2"/></symbol>
<symbol id="i-key" viewBox="0 0 24 24"><circle cx="8" cy="15.5" r="4.3"/><path d="M11.1 12.4 20 3.5m-3.4 3.4 2.7 2.7M14.5 7.9l2.2 2.2"/></symbol>
<symbol id="i-chart" viewBox="0 0 24 24"><path d="M4 4v15.5h16"/><path d="M8.5 16.5v-4m4.5 4v-8.5m4.5 8.5V10"/></symbol>
<symbol id="i-bank" viewBox="0 0 24 24"><path d="M3.5 9.5 12 4l8.5 5.5M5 9.5V19m4.7-9.5V19m4.6-9.5V19M19 9.5V19M3.5 19h17"/></symbol>
<symbol id="i-print" viewBox="0 0 24 24"><path d="M7 8V3.5h10V8"/><rect x="4" y="8" width="16" height="7.5" rx="2"/><path d="M7 12.5h10V20H7z"/></symbol>
<symbol id="i-help" viewBox="0 0 24 24"><circle cx="12" cy="12" r="8.8"/><path d="M9.6 9.4A2.5 2.5 0 1 1 12 12.4v1.1m0 2.9v.3"/></symbol>
<symbol id="i-dots" viewBox="0 0 24 24"><circle cx="5" cy="12" r="1.8"/><circle cx="12" cy="12" r="1.8"/><circle cx="19" cy="12" r="1.8"/></symbol>
<symbol id="i-sun" viewBox="0 0 24 24"><circle cx="12" cy="12" r="3.8"/><path d="M12 2.8v2m0 14.4v2M2.8 12h2m14.4 0h2M5.2 5.2l1.4 1.4m10.8 10.8 1.4 1.4m0-13.6-1.4 1.4M6.6 17.4l-1.4 1.4"/></symbol>
<symbol id="i-moon" viewBox="0 0 24 24"><path d="M20 13.6A8.2 8.2 0 1 1 10.4 4 6.6 6.6 0 0 0 20 13.6z"/></symbol>
<symbol id="i-volume" viewBox="0 0 24 24"><path d="M4 9.5v5h3.8L13 19V5L7.8 9.5H4z"/><path d="M16 9.2a4 4 0 0 1 0 5.6m2.4-8.3a8 8 0 0 1 0 11"/></symbol>
<symbol id="i-mute" viewBox="0 0 24 24"><path d="M4 9.5v5h3.8L13 19V5L7.8 9.5H4z"/><path d="m16.2 9.7 5.3 5.3m0-5.3-5.3 5.3"/></symbol>
<symbol id="i-check" viewBox="0 0 24 24"><path d="m4.5 12.6 5 5L19.5 6.4"/></symbol>
<symbol id="i-alert" viewBox="0 0 24 24"><path d="M12 3.5 2.8 19.5h18.4z"/><path d="M12 9.8v4.2m0 2.8v.4"/></symbol>
<symbol id="i-clock" viewBox="0 0 24 24"><circle cx="12" cy="12" r="8.5"/><path d="M12 7.5V12l3 2"/></symbol>
<symbol id="i-eye" viewBox="0 0 24 24"><path d="M2.8 12S6.2 5.4 12 5.4 21.2 12 21.2 12 17.8 18.6 12 18.6 2.8 12 2.8 12z"/><circle cx="12" cy="12" r="3"/></symbol>
<symbol id="i-gear" viewBox="0 0 24 24"><circle cx="12" cy="12" r="3.4"/><path d="M12 2.9v3.1m0 12v3.1M2.9 12h3.1m12 0h3.1M5.3 5.3l2.2 2.2m9 9 2.2 2.2m0-13.4-2.2 2.2m-9 9-2.2 2.2"/></symbol>
<symbol id="i-inbox" viewBox="0 0 24 24"><path d="M3 13.5 5.6 4.8A2 2 0 0 1 7.5 3.5h9a2 2 0 0 1 1.9 1.3L21 13.5V19a1.6 1.6 0 0 1-1.6 1.6H4.6A1.6 1.6 0 0 1 3 19z"/><path d="M3 13.5h5.2l1.3 2.4a1.6 1.6 0 0 0 1.4.9h2.2a1.6 1.6 0 0 0 1.4-.9l1.3-2.4H21"/></symbol>
<symbol id="i-mail" viewBox="0 0 24 24"><rect x="3" y="5.5" width="18" height="13" rx="2"/><path d="m3.5 7 8.5 6 8.5-6"/></symbol>
<symbol id="i-code" viewBox="0 0 24 24"><path d="m8.5 8-4 4 4 4m7-8 4 4-4 4M13.5 5.5l-3 13"/></symbol>
<symbol id="i-pdf" viewBox="0 0 24 24"><path d="M6 3h8l4 4v14H6zm8 0v5h4"/><path d="M6.5 15.5h11"/></symbol>
<!-- Iconos propios por trámite (V14, 1.31.0): cada trámite del
     Centro SAT se reconoce por su dibujo, no por un genérico
     reutilizado — la constancia lleva su sello, la opinión su
     escudo con el visto, el buzón su banderita levantada y
     declaraciones su tabla con su total. Mismo trazo que el
     resto del sprite (viewBox 24, stroke por CSS). -->
<symbol id="i-constancia" viewBox="0 0 24 24"><path d="M6 3h8l4 4v14H6zm8 0v5h4M9 10h5M9 13.5h3"/><circle cx="16.8" cy="17.2" r="3"/><path d="m15.6 17.2.9.9 1.6-1.9"/></symbol>
<symbol id="i-opinion" viewBox="0 0 24 24"><path d="M12 3l7 2.8V11c0 4.8-2.9 7.9-7 9.5C7.9 18.9 5 15.8 5 11V5.8z"/><path d="m8.3 11.7 2.5 2.5 4.9-5.4"/></symbol>
<symbol id="i-buzontrib" viewBox="0 0 24 24"><path d="M3 20.5h18M4.5 20.5v-5.2a7 7 0 0 1 14 0v5.2M4.5 15.3h14M8 15.3h.01"/><path d="M15.8 8.3V3.6h4.4l-1.5 1.9 1.5 1.9h-4.4"/></symbol>
<symbol id="i-decl" viewBox="0 0 24 24"><path d="M6 3h8l4 4v14H6zm8 0v5h4"/><path d="M9 12h6M9 15h6M12 12v6M9 18h6"/></symbol>
<symbol id="i-calendar" viewBox="0 0 24 24"><rect x="3.5" y="5" width="17" height="16" rx="2"/><path d="M3.5 9.5h17M8 3v4m8-4v4"/></symbol>
<symbol id="i-share" viewBox="0 0 24 24"><circle cx="6" cy="12" r="2.6"/><circle cx="17.5" cy="5.5" r="2.6"/><circle cx="17.5" cy="18.5" r="2.6"/><path d="m8.3 10.8 6.9-4m-6.9 6.4 6.9 4"/></symbol>
<symbol id="i-send" viewBox="0 0 24 24"><path d="M20.5 3.5 10 14M20.5 3.5 14 20.5l-4-6.5-6.5-4z"/></symbol>
<symbol id="i-list" viewBox="0 0 24 24"><path d="M9 6h11M9 12h11M9 18h11M4.5 6h.01M4.5 12h.01M4.5 18h.01"/></symbol>
<!-- (3.2.0 · pieza 9) Del mismo juego de trazo: el acuse de
     cancelación (documento con su equis), hermano de la
     constancia y la opinión. -->
<symbol id="i-acuse" viewBox="0 0 24 24"><path d="M6 3h8l4 4v14H6zm8 0v5h4"/><path d="m9.2 12.2 5.6 5.6m0-5.6-5.6 5.6"/></symbol>
</svg>
<div class="frame">
<aside class="sidebar">
  <div class="brand"><span class="logo"><svg id="brand-mark"><use href="#i-logo"/></svg><img id="brand-logo" alt="" hidden src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7"></span><span><span id="brand-name">PacoSAT</span><small>ESPACIO DE TRABAJO</small></span></div>
  <!-- (2.8.0 · diseño 18) Fuera el botón «Buscar en todo
       PacoSAT» de la barra: buscar vive en la cabecera (y en
       Ctrl+K), una sola puerta. La barra gana aire. -->
  <div class="switcher"><label for="scope">CONTRIBUYENTE</label><select id="scope"></select><button id="add" class="quiet"><svg><use href="#i-plus"/></svg> Agregar RFC </button><div class="puerta-line"><span id="puerta-dot" class="puerta-dot" data-state="sin-dato" aria-hidden="true"></span><span id="puerta-txt">Puerta del SAT: sin probar todavía</span></div></div>
  <div class="sesion-line2916" id="sesion-line2916" hidden></div>
  <!-- Menú COMPLETO y llano (2.4.0 · W4d, orden directa de Paco
       del 17 nov 15:25: «mejora los menus laterales, no escondas
       nada, debe ser facil de encontrar todo dentro del sistema»):
       TODOS los destinos del inventario de vistas (screens, en
       ui.part) tienen su entrada a la vista. La única vista de
       screens sin entrada es «sat», que no es una pantalla:
       navigate() la traduce a Descargar/Vigilancia/Listas/
       Descargados/Ejecutor, y las cinco tienen su propia entrada
       aquí. Cada botón lleva title con su nombre y su para qué
       (nombre accesible con la barra plegada). Los puntos
       grises decorativos junto a cada destino salieron en la
       2.9.0 (Bloque C): no afirmaban ningún estado y eran
       ruido; el estado vive en la línea de estado y en las
       insignias, que la barra plegada SÍ conserva. La segunda
       línea (nav-estado201) queda SOLO donde trae estado vivo
       (2.8.0 · diseño 6, ver el comentario dentro de la nav). -->
  <nav aria-label="Navegación principal">
    <!-- (2.8.0 · diseño 6) La segunda línea de cada destino
         SOLO existe cuando trae estado vivo (Listas, Buzón del
         SAT, Declaraciones y Tu ejecutor, con sus spans
         pintados por su pantalla): la descripción estática
         truncada desaparece y el destino va solo con su nombre
         — la descripción vive en el title y en el subtítulo de
         su pantalla, una sola vez. (2.8.0 · diseño 19)
         «Recibidos» pasa a llamarse «Novedades» y «Buzón» pasa
         a «Buzón del SAT»: los dos nombres ya no se pisan. -->
    <span class="nav-caption">TRABAJO DIARIO</span>
    <button data-view="home" aria-current="page" title="Hoy — Cómo amanece todo: qué hizo el sistema, qué falta y qué vence"><svg><use href="#i-home"/></svg> Hoy <span id="news-badge" class="news-badge" hidden></span><span id="gestos-badge" class="news-badge gestos-badge" hidden></span></button>
    <button data-view="avisos" title="Avisos — Lo que está mal, lo que falta y lo que el sistema necesita de ti"><svg><use href="#i-bell"/></svg> Avisos <span id="avisos-badge" class="news-badge" hidden></span></button>
    <button data-view="invoices" title="Facturas — Todos tus CFDI: emitidos y recibidos, su estado en el SAT y su PDF"><svg><use href="#i-file"/></svg> Facturas </button>
    <button data-view="descargar" title="Descargar del SAT — Baja tus comprobantes del SAT por periodo: el sistema pide, espera y archiva solo"><svg><use href="#i-down"/></svg> Descargar del SAT </button>
    <button data-view="tributario" title="Buzón del SAT — Las notificaciones del SAT para este RFC, sin abrir ninguna: PacoSAT las lista por ti"><svg><use href="#i-buzontrib"/></svg> Buzón del SAT <span id="buzon-menu-estado202" class="nav-estado201"></span></button>
    <span class="nav-caption">SAT</span>
    <button data-view="monitor" title="Vigilancia de CFDI — El estado de tus comprobantes en el SAT: vigentes, cancelados y por revisar"><svg><use href="#i-sync"/></svg> Vigilancia </button>
    <button data-view="lists" title="Listas negras — Las listas negras del SAT (69-B y demás): quién de tus contrapartes aparece y cuándo se comprobó"><svg><use href="#i-shield"/></svg> Listas negras <span id="lists-menu-estado201" class="nav-estado201"></span></button>
    <button data-view="declaraciones" title="Declaraciones — El mapa de tus declaraciones por año y mes: qué consta, qué falta y cómo se descarga"><svg><use href="#i-decl"/></svg> Declaraciones <span id="decl-menu-estado202" class="nav-estado201"></span></button>
    <span class="nav-caption">EXPEDIENTE</span>
    <button data-view="buzon" title="Novedades — Lo nuevo que llegó a tu expediente: CFDI y documentos recientes, leídos y sin leer"><svg><use href="#i-inbox"/></svg> Novedades <span id="buzon-badge" class="news-badge" hidden></span></button>
    <button data-view="contribuyentes" title="Contribuyentes — Todos tus RFC ordenados por urgencia: puerta, última descarga, avisos y vencimientos"><svg><use href="#i-eye"/></svg> Contribuyentes </button>
    <button data-view="admin" title="Administración — El puesto de triage de todos tus RFC: qué necesita atención, de quién es y dónde se resuelve"><svg><use href="#i-shield"/></svg> Administración <span id="admin-badge310" class="news-badge" hidden></span></button>
    <button data-view="docs" title="Documentos — Tu expediente por RFC: constancia, opinión, declaraciones, acuses y PDF archivados"><svg><use href="#i-folder"/></svg> Documentos </button>
    <button data-view="registro" title="Registro — Todo lo que el sistema hizo, intentó y no pudo, en lenguaje llano"><svg><use href="#i-list"/></svg> Registro </button>
    <span class="nav-caption">ADMINISTRACIÓN</span>
    <button data-view="dinero" title="Dinero — Cuánto debes, cuánto te deben y qué ya se movió"><svg><use href="#i-chart"/></svg> Dinero </button>
    <button data-view="pagos" title="Pagos al banco — Prepara los pagos del mes y llévate las tablas para el banco"><svg><use href="#i-bank"/></svg> Pagos al banco </button>
    <button data-view="salud" title="Salud — El Centro de salud: cada pieza del sistema con su semáforo, su porqué y su arreglo en un toque"><svg><use href="#i-shield"/></svg> Salud </button>
    <button data-view="settings" title="Ajustes — Contribuyentes y e.firma, correo, respaldos, sin conexión, estado del sistema y acerca de"><svg><use href="#i-gear"/></svg> Ajustes </button>
    <button type="button" id="nav-mas-btn2916" class="nav-caption nav-mas-btn2916" aria-expanded="false" title="Más destinos: los menos frecuentes, a un toque">MÁS <span class="nav-mas-flecha2916" aria-hidden="true">▸</span></button>
    <button data-view="ejecutor" class="nav-mas-item2916" title="Tu ejecutor — El programa que corre en tu equipo y entra al SAT por ti: emparejamiento, estado y diagnóstico"><svg><use href="#i-key"/></svg> Tu ejecutor <span id="ejecutor-menu-estado250" class="nav-estado201">El programa que entra al SAT desde tu equipo</span></button>
    <button data-view="archivo" class="nav-mas-item2916" title="Archivo — Lo que guardaste fuera de las vistas de trabajo: CFDI y documentos archivados, recuperables con un toque"><svg><use href="#i-box"/></svg> Archivo </button>
    <button data-view="reportes" class="nav-mas-item2916" title="Reportes — Totales, contrapartes, declaraciones y bancos, en PDF, Excel o impresos"><svg><use href="#i-print"/></svg> Reportes </button>
    <button data-view="salidas" class="nav-mas-item2916" title="Cierre y reportes — Cierra el mes paso a paso, mira qué vence y prepara lo de tu contadora"><svg><use href="#i-calendar"/></svg> Cierre y reportes </button>
    <button data-view="preguntas" class="nav-mas-item2916" title="Preguntas — Pregunta en lenguaje normal y la respuesta sale de tus datos locales"><svg><use href="#i-help"/></svg> Preguntas </button>
    <!-- (2.8.0 · diseño 11) Fuera el renglón «Trabajos en
         curso» del menú: la actividad en curso se anuncia en
         DOS sitios — la tarjeta de actividad de la pantalla
         (con su Detener) y el punto/contador del menú —, no en
         cuatro. Su función (avisar y llevar al control) la
         cumplen la tarjeta y Vigilancia. -->
    <!-- (2.4.0 · W4d) Ya no hay «resto de vistas» escondido:
         el inventario entero de screens está arriba, a la vista.
         (2.9.16 · P1) Orden de Paco (19 nov): cuatro bloques —
         Trabajo diario, SAT, Expediente y Administración — y
         los destinos menos frecuentes dentro de «Más», plegado
         que se recuerda y se abre solo al navegar a uno de los
         suyos. El inventario sigue completo: 21 destinos. -->
  </nav>
  <button id="side-collapse" class="side-collapse" type="button" aria-label="Plegar la barra lateral"><svg><use href="#i-arrow"/></svg> <span>Plegar barra</span></button>
  <!-- Atajos de teclado (2.4.0 · WC4b1, castigo 22): la
       entrada visible del menú a la tarjeta de atajos; su
       clic lo cablea ui.part (atajosAbrir240) y la tecla
       «?» abre la misma tarjeta desde cualquier pantalla. -->
  <button id="atajos-btn240" class="side-collapse" type="button" title="Atajos de teclado (tecla ?): moverte sin ratón"><svg><use href="#i-help"/></svg> <span>Atajos de teclado (?)</span></button>
  <!-- (2.8.0 · diseño 11) Fuera también la línea de actividad
       al pie del menú: mismo hecho, cuarto anuncio. Quedan la
       tarjeta en la pantalla y el punto/contador del menú. -->
  <div class="local"><svg><use href="#i-lock"/></svg><span id="storage-mode">Guardado en este equipo</span></div>
  <div class="side-version" id="side-version"></div>
</aside>
<div id="offline-banner" class="offline-banner" hidden></div>
<main>
  <header class="top"><span>PacoSAT <span class="slash">/</span> <strong id="crumb">Resumen</strong></span><span id="crumb-rfc2913" class="crumb-rfc2913" aria-label="Contribuyente en pantalla"></span><span class="top-side"><!-- Selector global (2.0 · tanda 2, pieza 8): desplegable propio con medallón de color, buscador (desde 5 RFC) y punto de salud por contribuyente; el <select> espejo queda oculto y sigue siendo el valor que el resto del código sincroniza. --><button id="scope-menu-btn200b" class="scope-menu-btn200b" type="button" aria-haspopup="true" aria-expanded="false" title="Cambiar de contribuyente">Contribuyente </button><select id="scope-top" class="scope-top" aria-label="Contribuyente" title="Contribuyente" hidden></select><div id="scope-menu200b" class="scope-menu200b" hidden></div><!-- El foco del sistema (2.9.0): semáforo grande y siempre visible junto al selector, con su palabra al lado; su panel lista lo vigilado con su arreglo. --><button id="foco-btn290" class="foco-btn290" type="button" aria-haspopup="true" aria-expanded="false" title="El foco del sistema"><span class="foco-luz290" data-nivel="dim"></span><span class="foco-palabra290">Sin comprobar todavía</span></button><div id="foco-menu290" class="scope-menu200b foco-menu290" hidden></div><span class="top-search"><input id="global-search" type="search" placeholder="Buscar UUID, RFC o una función…" aria-label="Buscador global: CFDI, documentos y funciones" title="Buscador global (Ctrl+K): también encuentra funciones por su nombre"></span><span id="counters" class="header-counters"></span><span id="frescura30" class="frescura30" title="La hora a la que el servidor entregó los datos que estás viendo; se refresca solo con cada sondeo"></span><span class="top-tools"><button id="cmdk-btn320" class="icon-button" type="button" aria-label="Buscar en todo PacoSAT" title="Buscar en todo PacoSAT (Ctrl+K)"><svg><use href="#i-search"/></svg></button><button id="search-toggle200b" class="icon-button search-toggle200b" type="button" aria-label="Buscar" title="Buscar"><svg><use href="#i-search"/></svg></button><button id="ask-button" class="icon-button" type="button" aria-label="Ayuda de esta pantalla" title="Ayuda"><svg><use href="#i-help"/></svg></button><!-- (2.8.0 · diseño 27) El interruptor de sonidos sale de la cabecera: es un ajuste de una vez al año y vive en Ajustes › General. La cabecera se queda con buscar, ayuda y tema. --><button id="theme-toggle" class="icon-button" type="button" aria-label="Cambiar entre tema claro y oscuro" title="Tema claro u oscuro"><svg><use href="#i-moon"/></svg></button></span><span class="badge"><span class="dot"></span> <span id="mode">Modo local</span></span></span></header>
  <!-- Sugerencia de FUNCIÓN del buscador global (2.4.0 · W4d):
       cuando lo tecleado casa con una función del catálogo del
       cliente (ui.part), esta franja la nombra como FUNCIÓN —
       distinta de cualquier resultado de documento — y su botón
       lleva a su pantalla y a su tarjeta o botón exactos. -->
  <section id="funcion-sugerida240" class="activity-result" hidden>
    <div class="activity-result-head"><strong id="funcion-sugerida240-titulo">Función</strong><button type="button" id="funcion-sugerida240-ir" class="primary small">Ir a la función </button></div>
    <div id="funcion-sugerida240-texto"></div>
  </section>
  <!-- (3.2.0 · piezas 20 y 41) Barra global y banda de puerta. -->
  <div id="barra320" class="barra320" hidden></div>
  <div id="banda-puerta320" class="banda-puerta320" hidden></div>
  <div class="page">
    <header class="heading">
      <div><div class="eyebrow" id="eyebrow">La mañana</div><h1 id="title">Resumen fiscal</h1><p id="subtitle">Facturas y documentos de tus contribuyentes en un solo lugar.</p></div>
      <div class="actions"><button id="inspect"><svg><use href="#i-code"/></svg> Abrir XML </button><button id="pdf-import"><svg><use href="#i-pdf"/></svg> Factura PDF </button><button id="primary" class="primary"><svg><use href="#i-up"/></svg><span>Importar XML / ZIP</span></button></div>
    </header>
    <div id="rfc-banda310" class="rfc-banda310" aria-hidden="true"></div>
    <p id="status" role="status" hidden></p>
    <section id="activity-dock" class="activity-dock" hidden aria-live="polite">
      <div class="activity-dock-head"><span class="activity-spinner" aria-hidden="true"></span><strong id="activity-label">Trabajando…</strong><span id="activity-count" class="activity-count"></span></div>
      <meter id="activity-bar" min="0" max="100" value="0"></meter>
      <p id="activity-detail" class="activity-detail"></p>
    </section>
    <section id="activity-result" class="activity-result" hidden>
      <div class="activity-result-head"><strong id="activity-result-title">Procesado</strong><button type="button" id="activity-result-close" class="icon-button" aria-label="Cerrar el resumen"><svg><use href="#i-close"/></svg></button></div>
      <div id="activity-result-text"></div>
    </section>
    <section id="body" aria-label="Contenido"></section>
    <div class="app-footer-row"><svg aria-hidden="true"><use href="#i-logo"/></svg><footer class="app-footer" id="app-footer"></footer></div>
  </div>
</main>
<!-- (2.8.0 · diseño 30) La barra inferior del móvil lleva las
     ACCIONES diarias: Hoy, Avisos, Descargar, Buzón (del SAT) y
     Más. Dinero —una consulta— queda dentro de Más, a dos
     toques como todo lo demás. -->
<nav class="bottombar" aria-label="Navegación rápida">
  <!-- (3.0 · mejora 21) La barra de pulgar lleva la puesta
       al día como primer gesto: «Al día» la lanza para el
       RFC en ámbito y lleva a Descargar a ver el avance.
       Buzón sale de la barra — sigue a un toque en el menú
       lateral y en «Más», con su estado — y Avisos entra,
       como pide la ronda. -->
  <button id="aldia30-bar" type="button" title="Ponerme al día: revisión de listados, portal y lo que falte, con un toque"><svg><use href="#i-sync"/></svg> Al día </button>
  <button data-view="home" aria-current="page"><svg><use href="#i-home"/></svg> Hoy </button>
  <button data-view="descargar"><svg><use href="#i-down"/></svg> Descargar </button>
  <button data-view="avisos"><svg><use href="#i-bell"/></svg> Avisos </button>
  <button id="more-button" type="button" title="Más: abre el menú completo, con todos los destinos y sus estados"><svg><use href="#i-dots"/></svg> Más </button>
</nav>
</div>
<section id="print-report" aria-hidden="true"></section>
<!-- (3.2.0) Membrete de impresión fuera de .frame. -->
<div id="cabecera-impresion320" class="cabecera-impresion320" aria-hidden="true"></div>
<!-- Pantalla de entrada diseñada (1.26.0): la cara del login
     propio. Vive oculta; la enseña maybeShowEntry() cuando el
     login propio está configurado y no hay sesión suya activa.
     Convive con la puerta vigente: «Entrar con mi acceso de
     siempre» la aparta por la sesión del navegador. -->
<section id="entry" class="entry" hidden aria-label="Entrada a PacoSAT">
  <div class="entry-card">
    <span class="logo entry-logo"><svg><use href="#i-logo"/></svg></span>
    <h1 class="entry-title">PacoSAT</h1>
    <p class="entry-sub">Tu espacio fiscal, guardado en tu propio servidor.</p>
    <!-- Estado del sistema ANTES de entrar (2.4.0 · W5b2,
         pieza 10): lo pinta showEntry (ui.part) desde la
         lectura sin sesión de /healthz (W2). Nace en
         «Comprobando…»: si la lectura no es posible, la
         palabra honesta la sustituye — nunca un «en línea»
         fingido. El nombre de la instalación, si el servidor
         ya lo expuso en el estado de arranque, lo refleja
         showEntry en el título sin tocar el flujo. -->
    <p class="entry-estado240"><span id="entry-estado240" class="estado240" data-estado="esperando">Comprobando el estado del sistema…</span></p>
    <form id="entry-form" class="entry-form">
      <label for="entry-pass">Tu contraseña de administrador</label>
      <div class="entry-pass-row">
        <input id="entry-pass" type="password" autocomplete="current-password" placeholder="Contraseña">
        <button id="entry-show" type="button" class="quiet" aria-label="Mostrar u ocultar la contraseña">Ver </button>
      </div>
      <p id="entry-error" class="error-text" role="alert" hidden></p>
      <button id="entry-go" class="primary" type="submit">Entrar </button>
    </form>
    <!-- (2.8.0 · diseño 28) Una sola puerta visible: la
         contraseña de la app. La otra queda como enlace
         discreto al pie, con la palabra de cuándo usarla. -->
    <button id="entry-skip" type="button" class="quiet entry-skip">¿Problemas para entrar? Usa tu acceso de siempre </button>
  </div>
</section>
<!-- Avisos flotantes (1.26.0): las confirmaciones se ven donde
     está el dedo; la barra #status sigue siendo el registro. -->
<div id="toasts" class="toasts" aria-live="polite"></div>
<!-- (3.2.0 · pieza 28) Barra de deshacer inferior. -->
<div id="deshacer320" class="deshacer320" hidden></div>
<input id="incoming" type="file" accept=".xml,.zip" multiple hidden>
<input id="inspectFile" type="file" accept=".xml,text/xml,application/xml" hidden>
<input id="invoice-pdf" type="file" accept=".pdf,application/pdf" hidden>
<input id="folder" type="file" webkitdirectory multiple hidden>
<input id="restore" type="file" accept=".faro,application/json" hidden>
<dialog id="dialog" aria-labelledby="dialogTitle">
  <form id="form"><div class="modal-head"><h2 id="dialogTitle"></h2><button type="button" class="icon-button" id="close" aria-label="Cerrar"><svg><use href="#i-close"/></svg></button></div>
  <div id="fields"></div><p id="formError" role="alert" hidden></p>
  <div class="modal-actions"><button type="button" id="cancel">Cerrar </button><button class="primary" id="save" type="submit">Guardar </button></div></form>
</dialog>
<script>/*SCRIPT*/</script>
</body></html>
